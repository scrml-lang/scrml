// =============================================================================
// self-host-v2 / print.scrml — Core → JS tree + HTML tree → text (slice M1).
//
// dpa-051 §3.3 / §3.6 / §5:
//   - Emitted text is WRITE-ONLY. This module builds JsStmt / HNode trees and
//     prints each once (js.scrml / html.scrml). No step reads emitted text; no
//     step calls a parser. Every decision comes from a Core fact.
//   - Names come from ONE NameSupply (names.scrml), planned before printing.
//     Printer-internal locals contain `$` and are derived from tree position.
//   - Per declaration (§5.2): a descriptor, edge tables (§5.4), a FACTORY
//     `mk_<decl>(inst$, …attrs)` that seeds an instance record, a RENDER
//     `render_<decl>(inst$, scope$, anchor$, slot$)` that registers every
//     effect/listener into the scope it is given, and a SHARED getter emitted
//     only if `.Shared(decl)` appears in Core.
//   - A field with a write capability (Field.wcap) becomes a writable Cell; a
//     field without one becomes a read-only Derived. The runtime shadow of the
//     Core fact: a locked/derived field has no setter to call.
//
// Views print as <template> content (compact HTML) + client code that clones a
// template, looks up every hole by child-index path FIRST (from the HNode tree
// this module built), then wires holes. Nested arms / rows / slots are their own
// templates, rendered into their own child scopes by the runtime.
//
// impl#1 workaround: F11 (named payload binding everywhere). (F12 — a non-first
// `|` alternation arm — and F13 — a ≥5-field payload arm — are fixed in impl#1
// by #1119; Stmt.Write / View.Each are bound in one arm again, S440.)
// =============================================================================
${
    import { OuterCell, Sym, Type, DeclKind, TypeDef, FieldDef, VariantDef, TransitionGraph, FieldRef, InstRef, Place, Literal, PrimOp, Pattern, Expr, MatchArm,
             HostCall, SeqFn, BindKind,
             EditKind, Check, Stmt, Block, Attr, ConstructAttr, CondArm, View, EffectDep, RequestState, ReqClass, FieldRole, Field,
             Decl, Fn, HostFn, HostBind, HostSrc, HostArg, HostProp, CoreProgram, CapOwner, SurfaceProp, ValidityOf, Validator, Persist, PersistStore, Timing, IdleWatch,
             Failable, OkArm, ErrArm, ServerFn, SqlQuery, SqlMode, Param, LoopHead, EachHead, RangeHead, CssUnit, CoreCss, CssVar,
             Gather, Lifted, GatherRow, PathStep, CoreConst, HeadTitle, CoreMeta, ForeignSlice, CoreChannel, DbLoad,
             findDecl, findTypeDef, typeDefSym, capOwner, findFn, findServerFn, mountedInstances, block, mkSym } from "./core.scrml";
    import { Node, nodeKids, allNodes, sharedRefs, sharedRefOf, boundSyms, assignedSyms, requestHandles, requestStateDeps } from "./walk.scrml";
    import { JsOp, JsUnOp, JsExpr, JsProp, JsStmt, JsLoopHead, JsForInit,
             jid, jstr, jnum, jmember, jcall, jmcall, jthunk, sexpr, printModule } from "./js.scrml";
    import { HAttr, HNode, Page, printPage, isVoid, dropsLeadingLf, cutNewline } from "./html.scrml";
    import { NameKey, NameTable, emptyNames, mint, nameOf } from "./names.scrml";
    import { WireTable, wireBuild, wireTableJs, typesReached } from "./codec.scrml";
    import { emitCss } from "./css.scrml";
    import { checkCore, writtenCaps } from "./check.scrml";
    import { isSurfaceIface } from "./host-surface.scrml";
    import { htmlNs, childNs, isHtmlInNs } from "./elements.scrml";

    // s474 (boot-gate-await-mathml): `ns` — the parse context the template's
    // content is inserted in (`htmlNs()`, or a foreign one, `childNs`); a
    // foreign template is printed inside that context's wrapper (`wrapNs`).
    export type Template:struct = { id: string, nodes: HNode[], ns: string }
    // s451 (U1a): `refused` — why the printer emitted NOTHING (empty `js` /
    // `html`); empty when it printed.
    // s454 (U1b): the printer emits the CLIENT artifact of a program with server
    // functions (design Item 4: "print the CLIENT artifact + manifest only");
    // `routes` is the manifest — every server function the client calls, by
    // name, the route path its client call POSTs to, and whether it answers with a
    // value (`value: false` — the 204 no-value contract). The server artifact
    // (the route handlers, the server half of the §57 codec) is print-server.scrml's
    // (s468, U1c) — whose manifest is this same list.
    export type RouteOut:struct = { fn: string, path: string, value: boolean }
    export type Output:struct = { js: string, html: string, refused: string[], routes: RouteOut[] }

    type HandleLoc:struct = { sym: int, js: JsExpr }
    type SharedLoc:struct = { decl: int, js: JsExpr }

    // The print environment: how each InstRef / local / handle is reached from
    // the code being printed. A value, extended by copy — never mutated.
    export type Ctx:struct = {
        p: CoreProgram,
        // s477 (s477-boot-compile-perf): facts about `p` read in one walk (printIx)
        pix: PrintIx,
        names: NameTable,
        lexical: JsExpr[],
        handles: HandleLoc[],
        shared: SharedLoc[],
        rows: int[],
        slot: JsExpr,
        prebuilt: boolean,
        // s454 (U1b): "" — ordinary code; else the name of the RESOLVE function a
        // waiting function's body returns through (`return ret$(v)`, below).
        ret: string,
        // s468 (U1c): printing the SERVER artifact (print-server.scrml). A Suspend
        // prints as `const b = await on;` followed by its `then` (the server has no
        // task, no batch, no cell — design §3(a) "ServerFn bodies print as native
        // `async function` with `await` in place"); a Join's body follows its If and
        // a Jump prints nothing; a waiting function takes no task.
        server: boolean,
        // s469 (§17.4): printing the loop of a Tier-0 View.Gather — `rows` holds
        // each row template's render thunk (index order), which a row Lift
        // appends; a value Lift appends a text row. `not` everywhere else (a
        // Stmt.Gather's Lift appends its value).
        tier0: Tier0Rows | not,
        // s471 (§49.12.7): the enclosing loops that WAIT, printed in explicit
        // continuations (cycleJs) — a Break of one is `return <exit>()`, a
        // Continue `return <next>(…)`, from anywhere inside its iteration.
        cycles: CycleJs[],
        // s474 (boot-gate-await-mathml): the parse context of the markup being
        // printed — the context the template now rendered is inserted in
        // (renderViews), and, for a hole being wired, the context AT the hole
        // (wireHole): `htmlNs()`, or "svg" / "math" / "math-text" / "annot".
        ns: string,
        // s476 (s476-boot-tape-inplace): the locals of the function being printed
        // that own their value (ownedLocals) — their edits are made in place.
        // Empty outside a function body.
        owned: OwnedLocal[],
    }

    // s474: `key` — a KEYED loop's (§17.4b) iteration-key local (its name and
    // Sym id; "" / -1 unkeyed): its Let prints `rt.loopKey(…)`, and a value
    // Lift appends a keyed text row.
    type Tier0Rows:struct = { rows: JsExpr[], key: string, keyId: int }
    // s471 — a waiting loop's two ways out of an iteration: `exit` (the Join of
    // what follows the loop) and `next` (the next iteration, its bindings
    // carried forward — §49.3.7).
    type CycleJs:struct = { label: int, exit: JsExpr, next: JsExpr }

    type Rendered:struct = { stmts: JsStmt[], templates: Template[] }
    // s474: `ns` — the parse context at the hole (the context its parent element's children parse in)
    type Hole:struct = { path: int[], v: View, ns: string }
    type Built:struct = { nodes: HNode[], holes: Hole[] }

    // -------------------------------------------------------------------------
    // Naming.
    // -------------------------------------------------------------------------
    fn planNames(p: CoreProgram) -> NameTable {
        let t: NameTable = mint(emptyNames(), NameKey.Runtime, "rt");
        // s472: the file-scope constants first, so each keeps its author name where it can
        // (two files' private constants of one name get distinct names — one module-level
        // binding each; a local of the name inside a function is minted apart, so it shadows nothing)
        for (const k of p.consts) { t = mint(t, NameKey.OfSym(k.sym.id), k.sym.hint); }
        for (const d of p.decls) {
            // s474 (door 3): a declaration's module-level names carry its per-file output name
            // (core.scrml Decl.key: `card~<16 hex>` → `mk_card_<16 hex>`), always
            const h: string = d.key.replaceAll("~", "_");
            t = mint(t, NameKey.DeclInfo(d.sym.id), "decl_" + h);
            t = mint(t, NameKey.Factory(d.sym.id), "mk_" + h);
            t = mint(t, NameKey.Render(d.sym.id), "render_" + h);
            t = mint(t, NameKey.SharedGet(d.sym.id), "shared_" + h);
            let i = 0;
            for (const f of d.fields) {
                if (f.graph is given) t = mint(t, NameKey.Edges(d.sym.id, i), h + "_" + f.sym.hint + "_edges");
                i = i + 1;
            }
        }
        for (const f of p.fns) { t = mint(t, NameKey.OfSym(f.sym.id), f.sym.hint); }
        // s473: each `<db>` cell's loaded value (a module-level const its field's init reads)
        for (const ld of p.loads) { t = mint(t, NameKey.OfSym(ld.val.id), ld.val.hint); }
        for (const s of boundSyms(Node.NProgram(p))) { t = mint(t, NameKey.OfSym(s.id), s.hint); }
        return t;
    }

    fn symName(ctx: Ctx, s: Sym) -> string { return nameOf(ctx.names, NameKey.OfSym(s.id)); }

    // s472 — the file-scope constants the code under `roots` reads, with every
    // constant their initializers read, in Core order (dependency order: an
    // initializer reads only earlier constants). An artifact carries exactly
    // these — a constant no code of the artifact reads is not in it (a value
    // read only by server code never reaches the client artifact).
    export fn constsReadIn(p: CoreProgram, roots: Node[]) -> CoreConst[] {
        if (p.consts.length == 0) return [];
        let want: int[] = [];
        for (const r of roots) { want = constReads(p, r, want); }
        // s483 (lane s483-component-attr-server-only): Core order makes one pass a fixed point — an
        // initializer names only earlier bindings. The classification's COMPONENT bindings
        // (bodyAsConsts, `fin` false) need not keep it: an attribute's binding stands for its use-site
        // values too, which may read a cell of a declaration put after it, and a program cell's seed
        // may read a component field. So the pass repeats while a binding it found was passed before
        // it was found (wanted, not walked) — once, as before, when Core order holds.
        let walked: int[] = [];
        let more = true;
        for (; more; ) {
            let i: int = p.consts.length - 1;
            for (; i >= 0; ) {
                const id: int = p.consts[i].sym.id;
                if (hasInt(want, id) && !hasInt(walked, id)) {
                    want = constReads(p, Node.NExpr(p.consts[i].init), want);
                    walked = walked.concat([id]);
                }
                i = i - 1;
            }
            more = false;
            for (const w of want) { if (!hasInt(walked, w) && isConstSym(p, w)) more = true; }
        }
        let out: CoreConst[] = [];
        for (const k of p.consts) { if (hasInt(want, k.sym.id)) out = out.concat([k]); }
        return out;
    }

    // s479: a READ (`Local(sym)`, a place rooted at it) or a WRITE (a file-scope `let`'s
    // `Assign`) — an artifact that only writes the binding still declares it.
    // s482 r2 (#2113 r1 review MED-A): a kept condition-head assignment (`if ((x = v) == …)`,
    // Expr.Assigned, §50) is a write too, exactly as `x = v` is. A server-run initializer may call a
    // function that writes a file-scope `let` this way (rule (c) exempts writes made at module
    // initialization), so the server artifact must declare that binding — without it the module
    // threw `ReferenceError` at load (probes q76 / q77 / q78).
    // s483 (lane s483-body-cell-server-only; ruling:user-voice-scrml.md-S482-body-cell-server-only): a
    // reference to a cell of the program BODY that bodyPlaced classifies as a binding (bodyCellsOf) —
    // a read, a write, or any other reference to it — uses that binding, as for a cell declared
    // outside the body.
    fn constReads(p: CoreProgram, root: Node, acc: int[]) -> int[] {
        let out: int[] = acc;
        const bc: BodyCells = bodyCellsOf(p);
        const ns: Node[] = allNodes(root);
        if (bodyAny(bc)) {
            const bu: ConstUse = bodyUseAll(p, bc, ns);
            for (const b of bu.reads.concat(bu.writes)) { if (!hasInt(out, b)) out = out.concat([b]); }
        }
        for (const n of ns) {
            let id: int = localReadOf(n);
            if (id < 0) id = assignedLocalOf(n);
            if (id < 0) id = assignedExprLocalOf(n);
            // s482 r1 (#2105 review HIGH-1): a reference to the shared instance of a cell declared
            // outside the body that outerPlaced classifies as a binding (its id is then a constant's
            // — never otherwise: a declaration's Sym is not a constant's) reads that binding
            if (id < 0) {
                const sr: Sym | not = sharedRefOf(n);
                if (sr is given) id = sr.id;
            }
            if (id >= 0 && !hasInt(out, id) && isConstSym(p, id)) out = out.concat([id]);
        }
        return out;
    }

    // =========================================================================
    // s482 (lane s482-write-only-secret) — READS apart from WRITES. §7.6 rule (b) S481 makes a
    // binding server-only *"when only server code reads it, or when no code reads it and its
    // initializer reaches … another server-only binding"*: a write is not a read. constReads counts
    // a client write as a use (an artifact that writes a binding must declare it), and serverInitsRound
    // judged "the client reads" from it — so a binding the client only WROTE kept its initializer
    // in the client, and with it the server-only value that initializer reached (probes o9 / o9-let:
    // `const API_KEY = "zz-sk-live-123"` in program.client.js).
    //
    // `reads`: the bindings the code under the roots reads — a `Local`, a place rooted at one, a
    // PART write (`Assign` with a path: the new value is a copy of the old one, §66.10), and a
    // reference to the shared instance of a cell declared outside the body that outerPlaced made a
    // binding — except the instance a whole-value write addresses. `writes`: the bindings it
    // OVERWRITES whole — `Assign` with no path (`x = v`), or a `Write` of such a cell's shared
    // instance that replaces its value with no run-time check (`@c = v`: EditKind.Replace,
    // Check.Static — any other edit or check reads the old value, so it is a read). A binding both
    // read and written is in `reads` (and may be in `writes`). Closed through initializers as
    // constsReadIn is (Core order: an initializer names only earlier bindings): the initializer of
    // each binding read, and of each binding written that is NOT in `noInit` — the bindings whose
    // initializer this artifact does not run (it gets a shell, clientConsts); a written binding of
    // `noInit` names nothing through its initializer. s482 r1 (#2113 review HIGH-1): and the
    // initializer of every binding OUTSIDE `noInit` — this artifact runs it whether or not its code
    // uses the binding, so it is a root (constUse).
    // With every binding in `noInit` (constsOnlyRead), `reads` is constsReadIn's set less the
    // bindings that are only overwritten whole (and those only their initializers name); a kept
    // condition-head assignment (Expr.Assigned) is a whole-value write here (#2113 review PRE-2),
    // and constReads counts it as the write it is (#2113 r1 review MED-A).
    // =========================================================================
    type ConstUse:struct = { reads: int[], writes: int[] }

    fn constUse(p: CoreProgram, roots: Node[], noInit: int[]) -> ConstUse {
        let u: ConstUse = { reads: [], writes: [] };
        if (p.consts.length == 0) return u;
        for (const r of roots) { u = constUseIn(p, r, u); }
        // s483 (lane s483-component-attr-server-only): repeated while a binding read was passed before it
        // was found — the classification's component bindings need not keep Core order (constsReadIn)
        let walked: int[] = [];
        let more = true;
        for (; more; ) {
            let i: int = p.consts.length - 1;
            for (; i >= 0; ) {
                const id: int = p.consts[i].sym.id;
                // s482 r1 (#2113 review HIGH-1 / PRE-1): a binding OUTSIDE `noInit` has its initializer run by
                // this artifact whether or not its code uses the binding (clientConsts: one that acts, that
                // server code does not read and that is not server-only runs in the client alone) — so
                // that initializer is this artifact's code, a root like the others, and what it reads is
                // READ (`let z = rec(lit)`, nothing reads z: `lit` is client-read, held with its
                // initializer — never a shell, never left out). (A binding only overwritten, in `noInit`,
                // names nothing through its initializer — the shell.) Core order makes this one pass a fixed
                // point: an initializer names only earlier bindings, and whether a binding is in `noInit`
                // does not depend on what this walk finds.
                if ((hasInt(u.reads, id) || !hasInt(noInit, id)) && !hasInt(walked, id)) {
                    u = constUseIn(p, Node.NExpr(p.consts[i].init), u);
                    walked = walked.concat([id]);
                }
                i = i - 1;
            }
            more = false;
            for (const r2 of u.reads) { if (!hasInt(walked, r2) && isConstSym(p, r2)) more = true; }
        }
        return u;
    }

    fn constUseIn(p: CoreProgram, root: Node, acc: ConstUse) -> ConstUse {
        let reads: int[] = acc.reads;
        let writes: int[] = acc.writes;
        // shared-instance references, with multiplicity: every one (`refs`), and those a whole-value
        // write addresses (`over`) — a reference is a read unless it is one of the latter
        let refs: int[] = [];
        let over: int[] = [];
        // s483 (lane s483-body-cell-server-only): a cell of the program body bodyPlaced classifies as a
        // binding — a whole-value, statically checked write of it (`@c = v`) is a write; every other
        // reference reads it (bodyUseOf; an invariant guard reads what bodyUseAll says)
        const bc: BodyCells = bodyCellsOf(p);
        const ns: Node[] = allNodes(root);
        if (bodyAny(bc)) {
            const bu: ConstUse = bodyUseAll(p, bc, ns);
            for (const br of bu.reads) { if (!hasInt(reads, br)) reads = reads.concat([br]); }
            for (const bw of bu.writes) { if (!hasInt(writes, bw)) writes = writes.concat([bw]); }
        }
        for (const n of ns) {
            const id: int = localReadOf(n);
            if (id >= 0 && isConstSym(p, id) && !hasInt(reads, id)) reads = reads.concat([id]);
            let wl: int = assignedLocalOf(n);
            // s482 r1 (#2113 review PRE-2): the kept condition-head assignment (`if ((x = v) == …)`,
            // Expr.Assigned, §50) rebinds the whole local too — a whole-value write. Its value is
            // `v`'s (walked on its own as the child it is), never the old value, so it reads nothing
            // of the binding
            if (wl < 0) wl = assignedExprLocalOf(n);
            if (wl >= 0 && isConstSym(p, wl)) {
                if (assignsWhole(n)) {
                    if (!hasInt(writes, wl)) writes = writes.concat([wl]);
                } else if (!hasInt(reads, wl)) {
                    reads = reads.concat([wl]);
                }
            }
            const sr: Sym | not = sharedRefOf(n);
            if (sr is given) { if (isConstSym(p, sr.id)) refs = refs.concat([sr.id]); }
            const ow: int = overwrittenSharedOf(n);
            if (ow >= 0 && isConstSym(p, ow)) over = over.concat([ow]);
        }
        for (const s of refs) {
            if (countInt(refs, s) > countInt(over, s)) {
                if (!hasInt(reads, s)) reads = reads.concat([s]);
            } else if (!hasInt(writes, s)) {
                writes = writes.concat([s]);
            }
        }
        return { reads: reads, writes: writes };
    }

    fn countInt(xs: int[], x: int) -> int {
        let c: int = 0;
        for (const y of xs) { if (y == x) c = c + 1; }
        return c;
    }

    // s482 r1 (#2113 review PRE-2) — the local a kept condition-head assignment (Expr.Assigned)
    // rebinds whole, else -1
    fn assignedExprLocalOf(n: Node) -> int {
        return match n {
            .NExpr(e: e) :> exprAssignedLocal(e),
            // no-default-arm: one question of a node — is it a condition-head assignment
            _ :> -1
        };
    }

    fn exprAssignedLocal(e: Expr) -> int {
        return match e {
            .Assigned(local: l) :> l.id,
            // no-default-arm: one question of an expression — is it a condition-head assignment
            _ :> -1
        };
    }

    // an `Assign` that rebinds the whole local (no path), or a condition-head assignment
    // (Expr.Assigned, which has no path)
    fn assignsWhole(n: Node) -> boolean {
        if (assignedExprLocalOf(n) >= 0) return true;
        return match n {
            .NStmt(s: s) :> stmtAssignsWhole(s),
            // no-default-arm: one question of a node — is it a statement that rebinds a whole local
            _ :> false
        };
    }

    fn stmtAssignsWhole(s: Stmt) -> boolean {
        return match s {
            .Assign(path: path) :> path.length == 0,
            // no-default-arm: one question of a statement — is it a whole-local Assign
            _ :> false
        };
    }

    // the declaration whose SHARED instance a whole-value, statically checked `Write` overwrites
    // (`@c = v`), else -1
    fn overwrittenSharedOf(n: Node) -> int {
        return match n {
            .NStmt(s: s) :> stmtOverwrittenShared(s),
            // no-default-arm: one question of a node — is it a whole-value write of a shared instance
            _ :> -1
        };
    }

    fn stmtOverwrittenShared(s: Stmt) -> int {
        return match s {
            .Write(inst: i, edit: e, check: c) :> overwriteTarget(i, e, c),
            // no-default-arm: one question of a statement — is it a whole-value Write
            _ :> -1
        };
    }

    fn overwriteTarget(i: InstRef, e: EditKind, c: Check) -> int {
        if (!isReplaceEdit(e) || !isStaticCheck(c)) return -1;
        return match i {
            .Shared(decl: d) :> d.id,
            // no-default-arm: one question of an instance reference — is it a declaration's shared instance itself
            _ :> -1
        };
    }

    fn isReplaceEdit(e: EditKind) -> boolean {
        return match e {
            .Replace :> true,
            // no-default-arm: one question of an edit — does it replace the whole value
            _ :> false
        };
    }

    fn isStaticCheck(c: Check) -> boolean {
        return match c {
            .Static :> true,
            // no-default-arm: one question of a check — is it decided at compile time
            _ :> false
        };
    }

    // s482 (lane s482-write-only-secret) — the bindings the code under `roots` READS, closed through
    // the initializers of those it reads only (constUse with every binding in `noInit`).
    fn constsOnlyRead(p: CoreProgram, roots: Node[]) -> int[] {
        return constUse(p, roots, allConstIds(p)).reads;
    }

    // s482 (lane s482-write-only-secret) — fnClosureThroughConsts, closed through the initializers of
    // the bindings the code READS only: a binding it only overwrites runs its initializer here only
    // when the client runs it (clientLiveFns roots those initializers by itself), so what that
    // initializer calls is not client code because of the write.
    fn fnClosureThroughReads(p: CoreProgram, roots: Node[]) -> int[] {
        let start: int[] = [];
        for (const r of roots) { start = start.concat(fnCalleesIn(p, r)); }
        let fns: int[] = fnClosure(p, start);
        if (p.consts.length == 0) return fns;
        let more = true;
        for (; more; ) {
            more = false;
            let rs: Node[] = roots;
            for (const f of p.fns) { if (hasInt(fns, f.sym.id)) rs = rs.concat([Node.NFn(f)]); }
            let add: int[] = [];
            for (const kid of constsOnlyRead(p, rs)) {
                const k: CoreConst | not = findConst(p, kid);
                if (k is given) {
                    for (const c of fnCalleesIn(p, Node.NExpr(k.init))) {
                        if (!hasInt(fns, c) && !hasInt(add, c)) add = add.concat([c]);
                    }
                }
            }
            if (add.length > 0) {
                fns = fnClosure(p, fns.concat(add));
                more = true;
            }
        }
        return fns;
    }

    // s482 (lane s482-write-only-secret) — the bindings the client does NOT run the initializer of:
    // all but those clientConsts gives the client for running alone (no code reads it, server code
    // does not read it, it acts, and it is not server-only — S481 "every file-scope initializer
    // runs", in the client). A binding the client READS is held whatever this says (constUse); one it
    // only overwrites and that is in this set gets a shell.
    fn clientNoInit(p: CoreProgram, sread: int[], si: int[]) -> int[] {
        let out: int[] = [];
        for (const k of p.consts) {
            if (!(initActs(k.init) && !hasInt(sread, k.sym.id) && !hasInt(si, k.sym.id))) out = out.concat([k.sym.id]);
        }
        return out;
    }

    // reads ∪ the written bindings outside `noInit`: the bindings the client holds WITH their
    // initializer because its code uses them
    fn clientHeld(u: ConstUse, noInit: int[]) -> int[] {
        let out: int[] = u.reads;
        for (const w of u.writes) { if (!hasInt(noInit, w) && !hasInt(out, w)) out = out.concat([w]); }
        return out;
    }

    fn assignedLocalOf(n: Node) -> int {
        return match n {
            .NStmt(s: s) :> stmtAssignedLocal(s),
            .NExpr(e: x) :> -1,
            .NPlace(pl: x) :> -1,
            .NProgram(p: x) :> -1,
            .NDecl(d: x) :> -1,
            .NField(f: x) :> -1,
            .NFn(f: x) :> -1,
            .NServerFn(f: x) :> -1,
            .NBlock(b: x) :> -1,
            .NInst(i: x) :> -1,
            .NPattern(pat: x) :> -1,
            .NEdit(k: x) :> -1,
            .NView(v: x) :> -1,
            .NAttr(a: x) :> -1
        };
    }

    fn stmtAssignedLocal(s: Stmt) -> int {
        return match s {
            .Assign(local: l) :> l.id,
            .Let(sym: x) :> -1,
            .Write(cap: x) :> -1,
            .Commit(writes: x) :> -1,
            .If(cond: x) :> -1,
            .Return(e: x) :> -1,
            .Eval(e: x) :> -1,
            .Suspend(bind: x) :> -1,
            .ResetSurface(of: x) :> -1,
            .Defer(body: x) :> -1,
            .Unpersist(decl: x) :> -1,
            .Attempt(result: x) :> -1,
            .Fail(err: x) :> -1,
            .Join(k: x) :> -1,
            .Jump(k: x) :> -1,
            .Loop(label: x) :> -1,
            .Break(target: x) :> -1,
            .Continue(target: x) :> -1,
            .Gather(g: x) :> -1,
            .Lift(into: x) :> -1,
            .LocalFn(f: x) :> -1
        };
    }

    // s479 — `roots`' functions, closed over calls AND over the file-scope bindings they
    // read: a binding an artifact carries evaluates its initializer there at module
    // initialization (§7.6 S478 rule (b)), so the functions that initializer calls are that
    // artifact's code too.
    export fn fnClosureThroughConsts(p: CoreProgram, roots: Node[]) -> int[] {
        let start: int[] = [];
        for (const r of roots) { start = start.concat(fnCalleesIn(p, r)); }
        let fns: int[] = fnClosure(p, start);
        if (p.consts.length == 0) return fns;
        let more = true;
        for (; more; ) {
            more = false;
            let rs: Node[] = roots;
            for (const f of p.fns) { if (hasInt(fns, f.sym.id)) rs = rs.concat([Node.NFn(f)]); }
            let add: int[] = [];
            for (const k of constsReadIn(p, rs)) {
                for (const c of fnCalleesIn(p, Node.NExpr(k.init))) {
                    if (!hasInt(fns, c) && !hasInt(add, c)) add = add.concat([c]);
                }
            }
            if (add.length > 0) {
                fns = fnClosure(p, fns.concat(add));
                more = true;
            }
        }
        return fns;
    }

    fn isConstSym(p: CoreProgram, id: int) -> boolean {
        for (const k of p.consts) { if (k.sym.id == id) return true; }
        return false;
    }

    // One module-level binding per file-scope `const` / `let`, in order (printed before any
    // code that reads one): its initializer runs here, once, at module initialization
    // (§7.6 S478 rule (b) — this artifact's own copy). A `let` is printed `let` (rule (c):
    // per-artifact state).
    export fn constStmts(ctx: Ctx, ks: CoreConst[]) -> JsStmt[] {
        return seqConstStmts(ctx, ks, []);
    }

    // s481 — `seq`: the bindings whose initializer runs in its PLACE in the program body
    // (§7.6 S481; bodyInits): declared here, assigned where their `${ }` stood.
    // s482 (lane s482-seed-timing; ruling:user-voice-scrml.md-S482-outside-cell-seed-time: *"before the
    // body, in link order"* — the same as the library's plain `let` / `const` initializers, even when
    // nothing reads the cell) — the file-scope section (seqConstStmts) with each cell declared outside
    // the body (`outs`, outerLive) printed at its place among the constants (OuterCell.at): its
    // declaration, then `shared_<decl>()`, which constructs its shared instance and runs its seed there.
    // A cell nothing reads is constructed all the same.
    // The declarations of the cells declared outside the body (every one, live or not) are printed
    // AHEAD of the section (a seed may read a cell declared after it in link order — its shared
    // instance is then constructed on demand, which needs its declaration), except one carrying a
    // validator, whose arguments may read a file-scope constant: that one is printed at its place.
    fn constsWithOuter(ctx: Ctx, ks: CoreConst[], seq: int[], outs: OuterCell[], sharedUsed: Sym[], uses: DeclNs[]) -> JsStmt[] {
        let ahead: JsStmt[] = [];
        let atPlace: int[] = [];
        for (const oc0 of ctx.p.outer) {
            const d0: Decl | not = findDecl(ctx.p, oc0.decl);
            if (d0 is given) {
                if (declHasValidators(d0)) {
                    atPlace = atPlace.concat([d0.sym.id]);
                } else {
                    ahead = ahead.concat(declJs(ctx, d0, sharedUsed, uses).stmts);
                }
            }
        }
        if (outs.length == 0 && atPlace.length == 0) return ahead.concat(seqConstStmts(ctx, ks, seq));
        let out: JsStmt[] = seqConstStmts(ctx, ks, seq);
        if (out.length == 0) out = [JsStmt.SBlank, JsStmt.SComment("file-scope bindings (§7.6)")];
        // out = [blank, comment, one statement per constant of `ks`, in order]
        let res: JsStmt[] = ahead.concat(out.slice(0, 2));
        // a validator-carrying outer cell that is not live: its declaration at its place too
        let places: OuterCell[] = outs;
        for (const oc3 of ctx.p.outer) {
            if (hasInt(atPlace, oc3.decl.id) && !outerIn(outs, oc3.decl.id)) places = places.concat([{ decl: oc3.decl, at: oc3.at }]);
        }
        let done: int[] = [];
        let i: int = 0;
        for (const k of ks) {
            const j: int = constIndex(ctx.p, k.sym.id);
            for (const oc of places) {
                if (oc.at <= j && !hasInt(done, oc.decl.id)) {
                    done = done.concat([oc.decl.id]);
                    res = res.concat(outerCellJs(ctx, oc, sharedUsed, uses, hasInt(atPlace, oc.decl.id), outerIn(outs, oc.decl.id)));
                }
            }
            res = res.concat([out[2 + i]]);
            i = i + 1;
        }
        for (const oc2 of places) {
            if (!hasInt(done, oc2.decl.id)) res = res.concat(outerCellJs(ctx, oc2, sharedUsed, uses, hasInt(atPlace, oc2.decl.id), outerIn(outs, oc2.decl.id)));
        }
        return res;
    }

    fn outerIn(xs: OuterCell[], id: int) -> boolean {
        for (const x of xs) { if (x.decl.id == id) return true; }
        return false;
    }

    fn declHasValidators(d: Decl) -> boolean {
        for (const f of d.fields) { if (f.vals.length > 0) return true; }
        return false;
    }

    fn constIndex(p: CoreProgram, id: int) -> int {
        let j: int = 0;
        for (const k of p.consts) {
            if (k.sym.id == id) return j;
            j = j + 1;
        }
        return -1;
    }

    fn outerCellJs(ctx: Ctx, oc: OuterCell, sharedUsed: Sym[], uses: DeclNs[], withDecl: boolean, live: boolean) -> JsStmt[] {
        const d: Decl | not = findDecl(ctx.p, oc.decl);
        if (d is not) return [];
        let pre: JsStmt[] = [];
        if (withDecl) pre = declJs(ctx, d, sharedUsed, uses).stmts;
        if (!live) return pre;
        return pre.concat([
            JsStmt.SComment("a cell declared outside the program body: its seed runs here, before the body, in link order (§7.6 R1 Load, S482)"),
            sexpr(jcall(jid(nameOf(ctx.names, NameKey.SharedGet(d.sym.id))), [])),
        ]);
    }

    // s482 (lane s482-seed-timing, Q12) — the cells declared outside the body (CoreProgram.outer) whose
    // seed is live (it calls something or reads a binding or a cell, so where it runs can be observed):
    // a writable cell's seed, or a locked constant's (constSeedField). Any other runs as before, at its
    // first reference — a literal computes the same value wherever it runs, a derived cell when read.
    fn outerLive(p: CoreProgram) -> OuterCell[] {
        let out: OuterCell[] = [];
        for (const oc of p.outer) {
            const d: Decl | not = findDecl(p, oc.decl);
            if (d is given && outerSeeded(p, d)) out = out.concat([oc]);
        }
        return out;
    }

    fn outerSeeded(p: CoreProgram, d: Decl) -> boolean {
        if (d.renders is given || d.fields.length != 1) return false;
        const f: Field = d.fields[0];
        const init: Expr | not = f.init;
        if (init is not) return false;
        if (f.wcap is given) return f.persist is not && seedLive(init);
        return constSeedField(p, f);
    }

    fn seqConstStmts(ctx: Ctx, ks: CoreConst[], seq: int[]) -> JsStmt[] {
        if (ks.length == 0) return [];
        let note: string = "file-scope bindings (§7.6) — evaluated once, at module initialization, in this artifact";
        if (seq.length > 0) note = "file-scope bindings (§7.6) — each evaluated once: here, or (declared only) in its place in the program body (§7.6 S481)";
        let out: JsStmt[] = [JsStmt.SBlank, JsStmt.SComment(note)];
        for (const k of ks) {
            if (hasInt(seq, k.sym.id)) {
                out = out.concat([JsStmt.SDecl(symName(ctx, k.sym))]);
            } else if (k.mutable) {
                out = out.concat([JsStmt.SLet(symName(ctx, k.sym), exprJs(ctx, k.init))]);
            } else {
                out = out.concat([JsStmt.SConst(symName(ctx, k.sym), exprJs(ctx, k.init))]);
            }
        }
        return out;
    }
    export fn symNameOf(ctx: Ctx, s: Sym) -> string { return symName(ctx, s); }
    fn rtName(ctx: Ctx) -> string { return nameOf(ctx.names, NameKey.Runtime); }
    fn rtCall(ctx: Ctx, f: string, args: JsExpr[]) -> JsExpr { return jcall(jmember(jid(rtName(ctx)), f), args); }

    fn pathText(path: int[]) -> string {
        const s: string = path.join("_");
        return s;
    }
    fn nodeVar(path: int[]) -> string { return "n$" + pathText(path); }

    fn hasInt(xs: int[], x: int) -> boolean {
        for (const y of xs) { if (y == x) return true; }
        return false;
    }

    // -------------------------------------------------------------------------
    // Type-directed names read from Core (never re-derived from text).
    // -------------------------------------------------------------------------
    fn fieldHint(d: Decl, idx: int) -> string {
        if (idx < d.fields.length) return d.fields[idx].sym.hint;
        return "field" + idx;
    }

    // The property name of field `idx` of `owner` (a struct type or a declaration).
    fn memberName(ctx: Ctx, owner: Sym, idx: int) -> string {
        const t: TypeDef | not = findTypeDef(ctx.p, owner);
        if (t is given) return typeDefMember(t, idx);
        const d: Decl | not = findDecl(ctx.p, owner);
        if (d is given) return fieldHint(d, idx);
        return "field" + idx;
    }

    fn typeDefMember(t: TypeDef, idx: int) -> string {
        return match t {
            .StructDef(fields: fs) :> memberAt(fs, idx),
            .EnumDef :> "field" + idx,
            .HostDef :> "field" + idx
        };
    }

    fn memberAt(fs: FieldDef[], idx: int) -> string {
        if (idx < fs.length) return fs[idx].sym.hint;
        return "field" + idx;
    }

    // The runtime tag of a variant (its declared name — data layout, not a minted name).
    fn variantTag(ctx: Ctx, enumSym: Sym, idx: int) -> string {
        const t: TypeDef | not = findTypeDef(ctx.p, enumSym);
        if (t is not) return "variant" + idx;
        return enumVariantTag(t, idx);
    }

    fn enumVariantTag(t: TypeDef, idx: int) -> string {
        return match t {
            .EnumDef(variants: vs) :> variantAt(vs, idx),
            .StructDef :> "variant" + idx,
            .HostDef :> "variant" + idx
        };
    }

    fn variantAt(vs: VariantDef[], idx: int) -> string {
        if (idx < vs.length) return vs[idx].sym.hint;
        return "variant" + idx;
    }

    fn variantHasFields(ctx: Ctx, enumSym: Sym, idx: int) -> boolean {
        const t: TypeDef | not = findTypeDef(ctx.p, enumSym);
        if (t is not) return false;
        return enumVariantArity(t, idx) > 0;
    }

    fn enumVariantArity(t: TypeDef, idx: int) -> int {
        return match t {
            .EnumDef(variants: vs) :> variantArity(vs, idx),
            .StructDef :> 0,
            .HostDef :> 0
        };
    }

    fn variantArity(vs: VariantDef[], idx: int) -> int {
        if (idx < vs.length) return vs[idx].fields.length;
        return 0;
    }

    fn variantFieldName(ctx: Ctx, enumSym: Sym, idx: int, j: int) -> string {
        const t: TypeDef | not = findTypeDef(ctx.p, enumSym);
        if (t is not) return "field" + j;
        return enumVariantField(t, idx, j);
    }

    fn enumVariantField(t: TypeDef, idx: int, j: int) -> string {
        return match t {
            .EnumDef(variants: vs) :> variantFieldAt(vs, idx, j),
            .StructDef :> "field" + j,
            .HostDef :> "field" + j
        };
    }

    fn variantFieldAt(vs: VariantDef[], idx: int, j: int) -> string {
        if (idx < vs.length) return memberAt(vs[idx].fields, j);
        return "field" + j;
    }

    // -------------------------------------------------------------------------
    // Instances, handles, places.
    // -------------------------------------------------------------------------
    fn instJs(ctx: Ctx, i: InstRef) -> JsExpr {
        return match i {
            .Shared(decl: d) :> sharedJs(ctx, d),
            .Lexical(depth: k) :> lexicalJs(ctx, k),
            .Alias(sym: s) :> jmcall(handleJs(ctx, s), "get", []),
            .Narrowed(sym: s) :> jid(symName(ctx, s)),
            .Kid(of: o, idx: k, decl: d) :> JsExpr.JIndex(jmember(instJs(ctx, o), "kids"), JsExpr.JAnnot(jnum(k), d.hint)),
            .HandleOf(of: o, sym: s) :> jmcall(handleOfJs(ctx, instJs(ctx, o), s), "get", [])
        };
    }

    // s472 — `of`'s `as=` handle `s` (InstRef.HandleOf): its cell on `of`'s record.
    fn handleOfJs(ctx: Ctx, of: JsExpr, s: Sym) -> JsExpr {
        for (const d of ctx.p.decls) {
            let k = 0;
            for (const hs of d.handles) {
                if (hs.id == s.id) return handleSlot(of, k, hs.hint);
                k = k + 1;
            }
        }
        return jid("unboundHandle$" + s.id);
    }

    fn lexicalJs(ctx: Ctx, k: int) -> JsExpr {
        if (k < ctx.lexical.length) return ctx.lexical[k];
        return jid("unboundLexical$" + k);
    }

    fn sharedJs(ctx: Ctx, d: Sym) -> JsExpr {
        for (const s of ctx.shared) {
            if (s.decl == d.id) return s.js;
        }
        return jcall(jid(nameOf(ctx.names, NameKey.SharedGet(d.id))), []);
    }

    // Where the cell of `as=` handle `s` lives: the enclosing row / renders
    // environment, else the owning `single` declaration's shared instance.
    fn handleJs(ctx: Ctx, s: Sym) -> JsExpr {
        for (const h of ctx.handles) {
            if (h.sym == s.id) return h.js;
        }
        for (const d of ctx.p.decls) {
            let k = 0;
            for (const hs of d.handles) {
                if (hs.id == s.id) return handleSlot(sharedJs(ctx, d.sym), k, hs.hint);
                k = k + 1;
            }
        }
        return jid("unboundHandle$" + s.id);
    }

    fn handleSlot(inst: JsExpr, k: int, hint: string) -> JsExpr {
        return JsExpr.JIndex(jmember(inst, "handles"), JsExpr.JAnnot(jnum(k), hint));
    }

    // `inst.fields[i /* name */]` — the field's signal.
    fn fieldCell(inst: JsExpr, d: Decl, idx: int) -> JsExpr {
        return JsExpr.JIndex(jmember(inst, "fields"), JsExpr.JAnnot(jnum(idx), fieldHint(d, idx)));
    }

    fn localRead(ctx: Ctx, s: Sym) -> JsExpr {
        if (hasInt(ctx.rows, s.id)) return jmcall(jid(symName(ctx, s)), "get", []);
        return jid(symName(ctx, s));
    }

    fn pathMembers(ctx: Ctx, base: JsExpr, path: FieldRef[], from: int) -> JsExpr {
        let e: JsExpr = base;
        let i: int = from;
        for (; i < path.length; ) {
            e = jmember(e, memberName(ctx, path[i].owner, path[i].idx));
            i = i + 1;
        }
        return e;
    }

    fn placeJs(ctx: Ctx, pl: Place) -> JsExpr {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> cellReadJs(ctx, d, i, path),
            .LocalPath(sym: s, path: path) :> pathMembers(ctx, localRead(ctx, s), path, 0)
        };
    }

    fn cellReadJs(ctx: Ctx, dsym: Sym, i: InstRef, path: FieldRef[]) -> JsExpr {
        if (path.length == 0) return rtCall(ctx, "snapshot", [instJs(ctx, i)]);
        const d: Decl | not = findDecl(ctx.p, dsym);
        if (d is not) return jid("unboundDecl$" + dsym.id);
        const sig: JsExpr = fieldCell(instJs(ctx, i), d, path[0].idx);
        return pathMembers(ctx, jmcall(sig, "get", []), path, 1);
    }

    // -------------------------------------------------------------------------
    // Expressions.
    // -------------------------------------------------------------------------
    fn exprsJs(ctx: Ctx, es: Expr[]) -> JsExpr[] {
        let out: JsExpr[] = [];
        for (const e of es) { out = out.concat([exprJs(ctx, e)]); }
        return out;
    }

    fn exprJs(ctx: Ctx, e: Expr) -> JsExpr {
        return match e {
            .Lit(lit: l) :> litJs(ctx, l),
            .Local(sym: s) :> localRead(ctx, s),
            .Read(place: pl) :> placeJs(ctx, pl),
            .Call(callee: f, args: args) :> callJs(ctx, f, args),
            .FnRef(fn: f) :> jid(symName(ctx, f)),      // s478 (s478-boot-fn-type): the function itself (never a waiting one, check.scrml C-FV2)
            .CallV(f: f, args: args) :> jcall(exprJs(ctx, f), exprsJs(ctx, args)),   // s478: a synchronous call through a function value
            .Prim(op: op, args: args) :> primJs(ctx, op, exprsJs(ctx, regArgs(ctx, op, args))),
            .Match(scrut: s, arms: arms) :> matchJs(ctx, s, arms),
            .ArrayOf(elems: es) :> JsExpr.JArray(exprsJs(ctx, es)),
            .StructOf(ty: ty, fields: fs) :> structJs(ctx, ty, fs),
            .VariantOf(enumSym: es, idx: vi, args: va) :> variantValueJs(ctx, es, vi, va),   // s472: THE ENUM VALUE SHAPE, as a `fail` builds it
            .Handle(inst: i) :> instJs(ctx, i),
            .Assigned(local: l, value: v) :> JsExpr.JAssignE(symName(ctx, l), exprJs(ctx, v)),   // s474 (§50, D10): the kept condition-head assignment
            .InitOf(decl: d, inst: i, idx: x) :> initOfJs(ctx, d, i, x),
            .Host(call: c) :> hostJs(c),
            .Lambda(params: ps, body: b) :> JsExpr.JArrowE(symNames(ctx, ps), exprJs(ctx, b)),
            .BlockLambda(params: ps, body: b) :> JsExpr.JArrow(symNames(ctx, ps), blockJs(lambdaCtx(ctx, b), b)),   // s478
            .SeqCall(op: o, seq: sq, f: f) :> seqCallJs(ctx, o, exprJs(ctx, sq), exprJs(ctx, f)),
            .Refetch(req: rf0) :> refetchJs(ctx, rf0),
            .Validity(of: v, prop: pr) :> jmcall(surfaceJs(ctx, v), surfaceMethod(pr), []),
            .ServerCall(fn: f, args: args) :> rtCall(ctx, "call", [jid(routeName(ctx.p, f)), JsExpr.JArray(exprsJs(ctx, args)), jid("task$")]),
            .Query(q: q) :> queryJs(ctx, q),
            .Foreign(slice: fsl0, args: args) :> foreignJs(ctx, fsl0, args)      // s477: a sealed foreign slice (§23.2.4a)
        };
    }

    // D15: a reset's value — the field's own initializer, re-run (`rt.initial`: the thunk the
    // instance was constructed with, kept on its record — reinitUsed).
    // s483 (lane s483-component-cell-server-only; #2121 review MED-1): a reset of a PROGRAM cell is
    // InitOf too (lower.scrml resetStmt / resetWrite). The program has no use site, so its
    // initializer is the declared one: through the enclosing program instance (`Lexical(0)`) it is
    // printed where it stands — the declared initializer, as the copied expression was before — and
    // a cell §7.6 rule (b) made server-only has the shell's `not` as its declared initializer
    // (bodyAsConsts), so its reset writes `null`, never the seed. Through any other reference the
    // program instance's kept thunk is re-run (rt.initial).
    fn initOfJs(ctx: Ctx, d: Sym, i: InstRef, x: int) -> JsExpr {
        const init: Expr | not = programInitInline(ctx.p, d, i, x);
        if (init is given) return exprJs(ctx, init);
        return rtCall(ctx, "initial", [instJs(ctx, i), JsExpr.JAnnot(jnum(x), memberName(ctx, d, x))]);
    }

    // the declared initializer of program field `x`, when an InitOf of it through `i` prints it
    // where it stands (initOfJs), else `not`
    fn programInitInline(p: CoreProgram, d: Sym, i: InstRef, x: int) -> Expr | not {
        if (d.id != p.program.id) return not;
        const pd: Decl | not = programDeclOf(p);
        if (pd is not || x < 0 || x >= pd.fields.length) return not;
        const init: Expr | not = pd.fields[x].init;
        if (init is not) return not;
        // through another reference (a function's `Shared`), the declared initializer prints the same
        // only when it names no instance lexically (lower substituted the reset's target for Lexical(0))
        if (!isLexical0(i) && namesLexical(init)) return not;
        return init;
    }

    fn namesLexical(e: Expr) -> boolean {
        for (const n of allNodes(Node.NExpr(e))) {
            if (nodeLexical(n)) return true;
        }
        return false;
    }

    fn nodeLexical(n: Node) -> boolean {
        return match n {
            .NInst(i: i) :> instLexical(i),
            // no-default-arm: one question of a node — is it a lexical instance reference
            _ :> false
        };
    }

    fn instLexical(i: InstRef) -> boolean {
        return match i {
            .Lexical(depth: k) :> true,
            // no-default-arm: one question of an instance reference — is it lexical
            _ :> false
        };
    }

    fn isLexical0(i: InstRef) -> boolean {
        return match i {
            .Lexical(depth: k) :> k == 0,
            // no-default-arm: one question of an instance reference — is it the nearest enclosing instance
            _ :> false
        };
    }

    // s468 (U1c) — a `?{}` query (§8), on the SERVER: `rt.query(db$<id>, "<mode>",
    // sql$<site>, [v0, …], [slot0, …])`. The text is the site's frozen literal
    // runs (print-server.scrml prints `const sql$<site> = rt.sqlText([…])`); each
    // DISTINCT value is evaluated ONCE, in order (§8.2 "a single positional
    // parameter slot"), and `slots` maps the template's i-th `${}` to its value —
    // the driver receives values only as bound parameters (§8.1). It stands only
    // as a Suspend's `on` (check.scrml C-SQL2), so it is always awaited.
    // s475: a query handled at its site (SqlQuery.handled) gets a sixth argument,
    // `true /* handled at its site */`: inside an open transaction the runtime
    // runs it under a statement savepoint of its own (SPEC §8.9.2 "Amendment
    // S474" item 4). Any other query is printed with five, as before.
    fn queryJs(ctx: Ctx, q: SqlQuery) -> JsExpr {
        let slots: JsExpr[] = [];
        for (const i of q.slots) { slots = slots.concat([jnum(i)]); }
        let args: JsExpr[] = [jid(dbVarName(q.db)), jstr(sqlModeName(q.mode)), jid(sqlTextName(q.site.n)), JsExpr.JArray(exprsJs(ctx, q.params)), JsExpr.JArray(slots)];
        const rt: Type | not = q.row;
        let rowWire: JsExpr | not = not;
        if (rt is given) {
            // S478 (§14.8.3 "A typed row is checked as it is read", INTERIM): the row type's §57
            // descriptor — the runtime checks each row against it (server-runtime.js checkRows)
            const wt: WireTable | not = wireBuild(ctx.p, rt).table;
            if (wt is given) rowWire = wireTableJs(wt);
        }
        if (q.handled) {
            args = args.concat([JsExpr.JAnnot(JsExpr.JBool(true), "handled at its site")]);
        } else if (rowWire is given) {
            args = args.concat([JsExpr.JBool(false)]);
        }
        if (rowWire is given) args = args.concat([JsExpr.JAnnot(rowWire, "the row type, checked as each row is read (§14.8.3)")]);
        return rtCall(ctx, "query", args);
    }

    fn sqlModeName(m: SqlMode) -> string {
        return match m {
            .All :> "all",
            .Get :> "get",
            .Run :> "run"
        };
    }

    // The printer-reserved names (`$` never survives NameSupply's sanitize, so no
    // program name collides): a database's connection, a query site's text.
    export fn dbVarName(db: Sym) -> string { return "db$" + db.id; }
    export fn sqlTextName(site: int) -> string { return "sql$" + site; }
    // s477 — the module-level sealed function of a foreign slice (print-server.scrml printTool)
    export fn sliceName(site: int) -> string { return "slice$" + site; }

    // s477 — a §23.2.4a foreign slice, called with its crossings' values, in
    // `in:{}` order: `slice$<site>(a, b)`. `slice$<site>` is the sealed function
    // the tool module builds once at load (print-server.scrml printTool,
    // server-runtime.js foreignSeal). It stands only as a Suspend's `on`
    // (check.scrml C-F1), so the call is always awaited — the boundary `await`.
    fn foreignJs(ctx: Ctx, s: ForeignSlice, args: Expr[]) -> JsExpr {
        return jcall(jid(sliceName(s.site.n)), exprsJs(ctx, args));
    }

    // s454 (U1b) — a call of a WAITING client function (Fn.waits, §13.2 async
    // colour) hands it the caller's task first: its continuations run in that
    // task, so a cancelled caller cancels them too (design §2.3 "an
    // async-colored Fn invocation (inherits its caller's task)"). It stands only
    // as a Suspend's `on` (check.scrml C-S7 / C12), so `task$` is bound there.
    fn callJs(ctx: Ctx, f: Sym, args: Expr[]) -> JsExpr {
        const fd: Fn | not = findFn(ctx.p, f);
        if (fd is given && !ctx.server) {
            if (fd.waits) return jcall(jid(symName(ctx, f)), [jid("task$")].concat(exprsJs(ctx, args)));
        }
        return jcall(jid(symName(ctx, f)), exprsJs(ctx, args));
    }

    // s454 (U1b) — the module constant describing server function `f`'s route
    // (path + the §57 wire tables its client call encodes / decodes with).
    // s472: two files may each declare a server function of one name (file
    // scope — analyze.scrml scopeFrom), so the constant is `route$<name>` for
    // the first server function of that name in `p.server` and `route$<name>$<k>`
    // for the k-th after it — one constant per route, the same in the client and
    // the server artifact (both print from the same Core).
    export fn routeName(p: CoreProgram, f: Sym) -> string {
        const base: string = "route$" + f.hint.replaceAll("$", "_").replaceAll("#", "_");   // s474 r1: `book#batch`
        let k = 0;
        for (const sf of p.server) {
            if (sf.sym.id == f.id) {
                if (k == 0) return base;
                return base + "$" + k;
            }
            // s473 r1 (F1): compared AFTER `$` becomes `_` — `load$rows` (a `<db>` cell's load) and an
            // author's `load_rows` would otherwise share one index and declare `route$load_rows` twice
            if (sf.sym.hint.replaceAll("$", "_").replaceAll("#", "_") == f.hint.replaceAll("$", "_").replaceAll("#", "_")) k = k + 1;
        }
        return base;
    }

    // Review #1911 MED-1 — a ROUTED server function's parameter refinements, judged in
    // its route's entry (print-server.scrml routeEntry) before the function is called:
    // `rt.refineEntry(args$[i], …)` — the SAME check as the body's prelude
    // (lower.scrml paramRefineChecks: its leading `Eval(RefineCheck(Local(param), …))`
    // statements, read here and nowhere decided anew), marked as the ROUTE's own. A
    // value the client sent that fails it is the caller's error — "the §53.9.4
    // `E-CONTRACT-001-RT` 400" (§52.13 limb rule) — and nothing of the body ran: §53.9.4
    // "server-side validation code that runs before any database write or business
    // logic". The body's prelude still runs (it holds for a value the entry admitted),
    // so a call of the function from other server code is checked as before (a trap
    // there is the server's own — 500).
    export fn routeEntryChecks(ctx: Ctx, sf: ServerFn) -> JsStmt[] {
        let out: JsStmt[] = [];
        for (const s of sf.body.stmts) {
            const j: JsStmt | not = entryCheckStmt(ctx, sf.params, s);
            if (j is not) return out;
            out = out.concat([j]);
        }
        return out;
    }

    fn entryCheckStmt(ctx: Ctx, ps: Param[], s: Stmt) -> JsStmt | not {
        return match s {
            .Eval(e: e) :> entryCheckExpr(ctx, ps, e),
            // no-default-arm: one question of a statement — is it the prelude's `Eval(RefineCheck(…))`; every other form ends the prelude
            _ :> not
        };
    }

    fn entryCheckExpr(ctx: Ctx, ps: Param[], e: Expr) -> JsStmt | not {
        return match e {
            .Prim(op: o, args: a) :> entryCheckPrim(ctx, ps, o, a),
            // no-default-arm: one question of an expression — is it a RefineCheck primitive; every other form ends the prelude
            _ :> not
        };
    }

    fn isRefineCheckOp(o: PrimOp) -> boolean {
        return match o {
            .RefineCheck :> true,
            // no-default-arm: one question of a primitive — is it RefineCheck; every other one ends the prelude
            _ :> false
        };
    }

    fn entryCheckPrim(ctx: Ctx, ps: Param[], o: PrimOp, a: Expr[]) -> JsStmt | not {
        if (!isRefineCheckOp(o) || a.length != 6) return not;
        const i: int = paramIndexOf(ps, a[0]);
        if (i < 0) return not;
        return JsStmt.SExpr(rtCall(ctx, "refineEntry", [JsExpr.JIndex(jid("args$"), jnum(i))].concat(exprsJs(ctx, a.slice(1)))));
    }

    fn paramIndexOf(ps: Param[], e: Expr) -> int {
        return match e {
            .Local(sym: s) :> paramPos(ps, s),
            // no-default-arm: one question of an expression — is it a parameter's read; every other form is no parameter
            _ :> -1
        };
    }

    fn paramPos(ps: Param[], s: Sym) -> int {
        let i: int = 0;
        for (const p of ps) {
            if (p.sym.id == s.id) return i;
            i = i + 1;
        }
        return -1;
    }

    // s449 — the validity surface (§55.5 / §55.6): `rt.validity(inst, i)` is
    // field i's record, `rt.compound(inst)` the declaration's; a property is
    // a tracked read (`.isValid()`, `.errors()`, `.touched()`, `.submitted()`).
    fn surfaceJs(ctx: Ctx, v: ValidityOf) -> JsExpr {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> rtCall(ctx, "validity", [instJs(ctx, i), JsExpr.JAnnot(jnum(x), memberName(ctx, d, x))]),
            .OfDecl(decl: d, inst: i) :> rtCall(ctx, "compound", [instJs(ctx, i)])
        };
    }

    fn surfacesJs(ctx: Ctx, fs: ValidityOf[]) -> JsExpr[] {
        let out: JsExpr[] = [];
        for (const f of fs) { out = out.concat([surfaceJs(ctx, f)]); }
        return out;
    }

    fn surfaceMethod(pr: SurfaceProp) -> string {
        return match pr {
            .IsValid :> "isValid",
            .Errors :> "errors",
            .Touched :> "touched",
            .Submitted :> "submitted"
        };
    }

    // s444 — the host calls Core admits, printed as the host spells them
    // (`Date` is a reserved name: no minted name shadows it, names.scrml).
    fn hostJs(c: HostCall) -> JsExpr {
        return match c {
            .DateNow :> jcall(jmember(jid("Date"), "now"), []),
            // s478 (s478-boot-fn-values) — the listener's event argument (handlerParams)
            .EventRead(member: m) :> eventPath(m),
            .EventCall(member: m) :> jcall(jmember(jid(eventVar()), m), []),
            // unreachable (checkCore C-R1 refuses it before printing); if ever printed
            // it fails loudly (a ReferenceError), never as a silent value
            .Unreadable :> jcall(jid("scrml$unreadableExpression"), [])
        };
    }

    // `filter` / `map` / `some` / `every` are the host's (they never mutate); `sortBy` is the
    // runtime's (the host `sort` sorts in place — a scrml sort returns a new tape).
    fn seqCallJs(ctx: Ctx, o: SeqFn, sq: JsExpr, f: JsExpr) -> JsExpr {
        if (o == SeqFn.SortBy) return rtCall(ctx, "sortBy", [sq, f]);
        return jmcall(sq, seqFnName(o), [f]);
    }

    fn seqFnName(o: SeqFn) -> string {
        return match o {
            .Filter :> "filter",
            .Map :> "map",
            .SortBy :> "sortBy",
            .Some :> "some",
            .Every :> "every"
        };
    }

    fn symNames(ctx: Ctx, ss: Sym[]) -> string[] {
        let out: string[] = [];
        for (const s of ss) { out = out.concat([symName(ctx, s)]); }
        return out;
    }

    fn litJs(ctx: Ctx, l: Literal) -> JsExpr {
        return match l {
            .Int(v: v) :> jnum(v),
            .Num(v: v) :> JsExpr.JNum("" + v),
            .Str(v: v) :> jstr(v),
            .Bool(v: v) :> JsExpr.JBool(v),
            .Variant(enumSym: es, idx: idx) :> jstr(variantTag(ctx, es, idx)),
            .Absent :> JsExpr.JNull
        };
    }

    fn bin(op: JsOp, a: JsExpr[]) -> JsExpr { return JsExpr.JBin(op, a[0], a[1]); }

    fn primJs(ctx: Ctx, op: PrimOp, a: JsExpr[]) -> JsExpr {
        return match op {
            .Add :> bin(JsOp.Plus, a),
            .Sub :> bin(JsOp.Minus, a),
            .Mul :> bin(JsOp.Times, a),
            .Div :> bin(JsOp.Div, a),
            .Mod :> bin(JsOp.Mod, a),
            .Neg :> JsExpr.JUn(JsUnOp.Neg, a[0]),
            .Not :> JsExpr.JUn(JsUnOp.Not, a[0]),
            .And :> bin(JsOp.And, a),
            .Or :> bin(JsOp.Or, a),
            .Lt :> bin(JsOp.Lt, a),
            .Le :> bin(JsOp.Le, a),
            .Gt :> bin(JsOp.Gt, a),
            .Ge :> bin(JsOp.Ge, a),
            .EqPrim :> bin(JsOp.StrictEq, a),
            .NeqPrim :> bin(JsOp.StrictNe, a),
            .EqStruct :> rtCall(ctx, "eq", a),
            .NeqStruct :> JsExpr.JUn(JsUnOp.Not, rtCall(ctx, "eq", a)),
            .IsSome :> JsExpr.JBin(JsOp.LooseNe, a[0], JsExpr.JNull),
            .IsNot :> JsExpr.JBin(JsOp.LooseEq, a[0], JsExpr.JNull),
            .Concat :> bin(JsOp.Plus, a),
            .Coalesce :> bin(JsOp.Nullish, a),
            .Length :> jmember(a[0], "length"),
            // s469 — the typed built-in methods. Case and whitespace are the
            // host's own (they change no position). Everything that counts or
            // matches positions — `.length`, `slice`, `charAt`, `includes`,
            // `startsWith`, `endsWith`, `split` — is by CODE POINT (bryan,
            // S469: "code points everywhere"), so those are runtime helpers,
            // as are the tape functions (each returns a NEW tape)
            .StrUpper :> jmcall(a[0], "toUpperCase", []),
            .StrLower :> jmcall(a[0], "toLowerCase", []),
            .StrTrim :> jmcall(a[0], "trim", []),
            .StrIncludes :> rtCall(ctx, "strIncludes", a),
            .StrStartsWith :> rtCall(ctx, "strStartsWith", a),
            .StrEndsWith :> rtCall(ctx, "strEndsWith", a),
            .StrSlice :> rtCall(ctx, "strSlice", a),
            .StrCharAt :> rtCall(ctx, "strCharAt", a),
            .StrLength :> rtCall(ctx, "strLength", a),
            .StrSplit :> rtCall(ctx, "strSplit", a),
            .SortNum :> rtCall(ctx, "sortNum", a),
            .SortStr :> rtCall(ctx, "sortStr", a),
            .Reverse :> rtCall(ctx, "reversed", a),
            .Join :> rtCall(ctx, "joinStr", a),
            .IndexRead :> rtCall(ctx, "indexRead", a),  // s469 (§49.13): the element, or the E-INDEX-OUT-OF-RANGE-RT trap
            .AtRead :> rtCall(ctx, "atRead", a),        // s469 (§49.13): the element, or `not`
            // s469 — the admitted additions (S469 "more string methods admitted"): positions,
            // widths and matches by code point, so runtime helpers; trimStart / trimEnd are the
            // host's (no position). The parses (§14.13.4) are strict, whole-string, `T | not`.
            .StrIndexOf :> rtCall(ctx, "strIndexOf", a),
            .StrLastIndexOf :> rtCall(ctx, "strLastIndexOf", a),
            .StrReplace :> rtCall(ctx, "strReplace", a),
            .StrReplaceAll :> rtCall(ctx, "strReplaceAll", a),
            .StrPadStart :> rtCall(ctx, "strPadStart", a),
            .StrPadEnd :> rtCall(ctx, "strPadEnd", a),
            .StrRepeat :> rtCall(ctx, "strRepeat", a),
            .StrTrimStart :> jmcall(a[0], "trimStart", []),
            .StrTrimEnd :> jmcall(a[0], "trimEnd", []),
            .ParseInt :> rtCall(ctx, "parseIntText", a),
            .ParseNum :> rtCall(ctx, "parseNumText", a),
            .ParseBool :> rtCall(ctx, "parseBoolText", a),
            // s469: a primitive's text (§20.7.2) — JavaScript's String() of an
            // int / number (Number::toString), a bool, a unit variant's tag
            .Text :> rtCall(ctx, "textOf", a),
            // s475 — the tape edits as values (a granted edit of a local rebinds it to one), each a NEW tape
            .TapeAppend :> rtCall(ctx, "tapeAppend", a),
            .TapePrepend :> rtCall(ctx, "tapePrepend", a),
            .TapeDropEnd :> rtCall(ctx, "tapeDropEnd", a),
            .TapeDropFront :> rtCall(ctx, "tapeDropFront", a),
            .TapeRemoveAt :> rtCall(ctx, "tapeRemoveAt", a),
            .TapeConcat :> rtCall(ctx, "tapeConcat", a),
            .TapeIncludes :> rtCall(ctx, "tapeIncludes", a),
            // s477 (O36 RULED S477) — a bounded tape's runtime length check; a local `insert`
            .LengthCheck :> rtCall(ctx, "lengthCheck", a),
            // s478 (§53.4.5) — a boundary-zone refinement's runtime check (the E-CONTRACT-001-RT trap)
            .RefineCheck :> rtCall(ctx, "refineCheck", a),
            // s483 (Q21 lane 2, §66.13.5) — a declaration invariant on the candidate value (the
            // E-WRITE-INVARIANT-RT trap before the write)
            .InvariantGuard :> rtCall(ctx, "invariantGuard", a),
            .InvariantValue :> rtCall(ctx, "invariantValue", a),
            .TapeInsert :> rtCall(ctx, "tapeInsert", a),
            // s478 (§20.7) — raw stdout (server-runtime.js printOut; server code only, check.scrml C-P1)
            .Print :> rtCall(ctx, "printOut", a),
            // s482 (§22.5.1) — a runtime `^{}` block's calls, on its per-run `meta` object (metaJs);
            // a dependency read is a thunk the runtime runs with tracking on
            .MetaGet :> jmcall(jid(metaVar()), "get", [jthunk(a[0])]),
            .MetaEmit :> jmcall(jid(metaVar()), "emit", a),
            .MetaCleanup :> jmcall(jid(metaVar()), "cleanup", a),
            .MetaInterval :> jmcall(jid(metaVar()), "interval", a),
            .MetaTimeout :> jmcall(jid(metaVar()), "timeout", a),
            .MetaClearInterval :> jmcall(jid(metaVar()), "clearInterval", a),
            .MetaClearTimeout :> jmcall(jid(metaVar()), "clearTimeout", a),
            // s482 (s482-meta-phase3) — the §22.5.4 registry lookup; a subscription (its cell read a thunk)
            .MetaReflect :> jmcall(jmember(jid(metaVar()), "types"), "reflect", a),
            .MetaSubscribe :> jmcall(jid(metaVar()), "subscribe", [jthunk(a[0]), a[1]])
        };
    }

    fn structJs(ctx: Ctx, ty: Sym, fs: Expr[]) -> JsExpr {
        let props: JsProp[] = [];
        let i = 0;
        for (const f of fs) {
            props = props.concat([{ key: memberName(ctx, ty, i), value: exprJs(ctx, f) }]);
            i = i + 1;
        }
        return JsExpr.JObject(props);
    }

    // 1 = `true` literal pattern, 0 = `false`, -1 = anything else.
    fn patBool(p: Pattern) -> int {
        return match p {
            .PLit(lit: l) :> litBool(l),
            .PVariant :> -1,
            .PWild :> -1,
            .PAlt :> -1
        };
    }

    fn litBool(l: Literal) -> int {
        return match l {
            .Bool(v: v) :> boolInt(v),
            .Int :> -1,
            .Num :> -1,
            .Str :> -1,
            .Variant :> -1,
            .Absent :> -1
        };
    }

    fn boolInt(b: boolean) -> int {
        if (b) return 1;
        return 0;
    }

    // A match over a boolean with exactly a `true` and a `false` arm is a JS
    // conditional (the lowering of `c ? a : b` / if-as-expression). Any other
    // match is an arrow applied to the scrutinee, one `if` per arm, the last
    // arm unconditional (Core matches are exhaustive).
    fn matchJs(ctx: Ctx, scrut: Expr, arms: MatchArm[]) -> JsExpr {
        if (arms.length == 2) {
            const a: int = patBool(arms[0].pat);
            const b: int = patBool(arms[1].pat);
            if (a == 1 && b == 0) return JsExpr.JCond(exprJs(ctx, scrut), exprJs(ctx, arms[0].body), exprJs(ctx, arms[1].body));
            if (a == 0 && b == 1) return JsExpr.JCond(exprJs(ctx, scrut), exprJs(ctx, arms[1].body), exprJs(ctx, arms[0].body));
        }
        let body: JsStmt[] = [];
        let i = 0;
        for (const arm of arms) {
            const ret: JsStmt[] = patBinds(ctx, arm.pat, jid("m$")).concat([JsStmt.SReturn(exprJs(ctx, arm.body))]);
            if (i == arms.length - 1) {
                body = body.concat(ret);
            } else {
                body = body.concat([JsStmt.SIf(patTest(ctx, arm.pat, jid("m$")), ret, [])]);
            }
            i = i + 1;
        }
        return jcall(JsExpr.JArrow(["m$"], body), [exprJs(ctx, scrut)]);
    }

    // A pattern's test / binders against the scrutinee `on` (`m$` in a match
    // arrow; `<raw>.error` in an Attempt — s451 Ue).
    fn patTest(ctx: Ctx, p: Pattern, on: JsExpr) -> JsExpr {
        return match p {
            .PVariant(enumSym: es, idx: idx) :> variantTest(ctx, es, idx, on),
            .PLit(lit: l) :> litTest(ctx, l, on),
            .PWild :> JsExpr.JBool(true),
            .PAlt(pats: ps) :> altTest(ctx, ps, on)
        };
    }

    // s482 (s482-match-alternation) — an alternation arm (§18.2 `.A | .B :> r`): one test
    // per alternate, in written order, joined by `||` (`m$ === "A" || m$ === "B"`).
    fn altTest(ctx: Ctx, ps: Pattern[], on: JsExpr) -> JsExpr {
        if (ps.length == 0) return JsExpr.JBool(false);
        let t: JsExpr = patTest(ctx, ps[0], on);
        let i: int = 1;
        for (; i < ps.length; ) {
            t = JsExpr.JBin(JsOp.Or, t, patTest(ctx, ps[i], on));
            i = i + 1;
        }
        return t;
    }

    // s469 (review HIGH-1) — the ABSENCE pattern tests `== null`, as `is not`
    // does (IsNot): absence is `null` AND `undefined` (§42.5) — a value from the
    // host (or any `undefined` that reaches a match) takes the `not` arm, never
    // the present arm. Every other literal compares by `===`.
    fn litTest(ctx: Ctx, l: Literal, on: JsExpr) -> JsExpr {
        return match l {
            .Absent :> JsExpr.JBin(JsOp.LooseEq, on, JsExpr.JNull),
            .Int(v: x) :> JsExpr.JBin(JsOp.StrictEq, on, litJs(ctx, l)),
            .Num(v: x) :> JsExpr.JBin(JsOp.StrictEq, on, litJs(ctx, l)),
            .Str(v: x) :> JsExpr.JBin(JsOp.StrictEq, on, litJs(ctx, l)),
            .Bool(v: x) :> JsExpr.JBin(JsOp.StrictEq, on, litJs(ctx, l)),
            .Variant(enumSym: x) :> JsExpr.JBin(JsOp.StrictEq, on, litJs(ctx, l))
        };
    }

    // s451 (Ue, review HIGH-1) — THE ENUM VALUE SHAPE. A nullary variant is its
    // name (a string); a payload variant is `{ variant: "V", data: [v0, v1, …] }`
    // — the payload POSITIONAL, in declared field order. No field name ever
    // becomes a key next to the discriminant (a field named `tag`, `variant`,
    // `data` or `__proto__` cannot overwrite or reroute anything): the shape
    // holds by construction. The R8 wire form (§19.9.1 / §57.8) is
    // `{"variant": "V", "data": {<field>: …}}` — the same discriminant key; the
    // codec maps `data` index i ↔ declared field i (s454: runtime.js
    // `encEnum` / `decEnum`, against codec.scrml's `WireVariant` field list). (The runtime's own ValidationError records — §55, read
    // only by the runtime — keep their `{ tag, … }` shape; no Core pattern
    // reads them.)
    fn variantTest(ctx: Ctx, es: Sym, idx: int, on: JsExpr) -> JsExpr {
        const tag: JsExpr = jstr(variantTag(ctx, es, idx));
        if (variantHasFields(ctx, es, idx)) return JsExpr.JBin(JsOp.StrictEq, jmember(on, "variant"), tag);
        return JsExpr.JBin(JsOp.StrictEq, on, tag);
    }

    fn patBinds(ctx: Ctx, p: Pattern, on: JsExpr) -> JsStmt[] {
        return match p {
            .PVariant(enumSym: es, idx: idx, binds: binds) :> variantBinds(ctx, es, idx, binds, on),
            .PLit :> [],
            .PWild :> [],
            .PAlt :> []
        };
    }

    fn variantBinds(ctx: Ctx, es: Sym, idx: int, binds: Sym[], on: JsExpr) -> JsStmt[] {
        let out: JsStmt[] = [];
        let j = 0;
        for (const b of binds) {
            out = out.concat([JsStmt.SConst(symName(ctx, b), JsExpr.JIndex(jmember(on, "data"), JsExpr.JAnnot(jnum(j), variantFieldName(ctx, es, idx, j))))]);
            j = j + 1;
        }
        return out;
    }

    // -------------------------------------------------------------------------
    // Statements.
    // -------------------------------------------------------------------------
    fn blockJs(ctx: Ctx, b: Block) -> JsStmt[] {
        const assigned: int[] = assignedSyms(Node.NBlock(b));
        let out: JsStmt[] = [];
        if (ctx.server) {
            out = serverStmtsJs(ctx, b.stmts, assigned);
        } else {
            // s471: a loop that waits stands right after the Join of its exit (C12)
            let exit: Sym | not = not;
            for (const s of b.stmts) {
                const cp: CycleParts | not = waitingLoopOf(s);
                const k: Sym | not = exit;
                if (cp is given && k is given) {
                    out = out.concat(cycleJs(ctx, cp, k, assigned));
                } else {
                    out = out.concat(stmtJs(ctx, s, assigned));
                }
                exit = joinSymOf(s);
            }
        }
        if (holdsDefer(b)) return deferBlockJs(ctx, out);    // s451
        return out;
    }

    // -------------------------------------------------------------------------
    // s471 — a loop that WAITS (§49.12.7: "A server call in a loop body of a
    // function is awaited once per iteration (§13) … Per-iteration binding
    // (§49.3.7) holds across every suspension"), on the client, where a wait is
    // an explicit continuation (`rt.suspend`). Each iteration is ONE call of an
    // arrow whose parameters are the iteration's own bindings — the iterate
    // head's position, the range's counter, the counted head's `let`s — so a
    // continuation that resumes after a wait reads its own iteration's values
    // (§49.3.7). `rt.cycle(iterate)` returns the loop's `next`: a Continue (and
    // falling off the body — lower's continuation pass ends every path in one)
    // is `return L(…)`; a Break, and a head that is done, `return exit()` — the
    // Join of what follows the loop. `next` never recurses (runtime `cycle`).
    // The counted head's step runs on a COPY (`L$step`'s parameters), as
    // JavaScript's `for (let …)` copies the bindings before the step, so an
    // earlier iteration's closure never sees a later step. The server prints
    // the same Core as a native loop (its waits are `await`, serverStmtsJs).
    // -------------------------------------------------------------------------
    type CycleParts:struct = { label: Sym, head: LoopHead, body: Block }

    fn waitingLoopOf(s: Stmt) -> CycleParts | not {
        const cp: CycleParts | not = match s {
            .Loop(label: l, head: h, body: b) :> { label: l, head: h, body: b },
            .Let(sym: x) :> not,
            .Assign(local: x) :> not,
            .Write(cap: x) :> not,
            .Commit(writes: x) :> not,
            .If(cond: x) :> not,
            .Return(e: x) :> not,
            .Eval(e: x) :> not,
            .Suspend(bind: x) :> not,
            .ResetSurface(of: x) :> not,
            .Defer(body: x) :> not,
            .Unpersist(decl: x) :> not,
            .Attempt(result: x) :> not,
            .Fail(err: x) :> not,
            .Join(k: x) :> not,
            .Jump(k: x) :> not,
            .Break(target: x) :> not,
            .Continue(target: x) :> not,
            .Gather(g: x) :> not,
            .Lift(into: x) :> not,
            .LocalFn(f: x) :> not
        };
        if (cp is not) return not;
        if (!cycleWaits(cp.body)) return not;
        return cp;
    }

    fn cycleWaits(b: Block) -> boolean {
        for (const n of allNodes(Node.NBlock(b))) {
            if (nodeSuspendParts(n) is given) return true;
        }
        return false;
    }

    fn nodeSuspendParts(n: Node) -> SuspendParts | not {
        return match n {
            .NStmt(s: s) :> suspendPartsOf(s),
            .NProgram(p: x) :> not,
            .NDecl(d: x) :> not,
            .NField(f: x) :> not,
            .NFn(f: x) :> not,
            .NServerFn(f: x) :> not,
            .NBlock(b: x) :> not,
            .NExpr(e: x) :> not,
            .NPlace(pl: x) :> not,
            .NInst(i: x) :> not,
            .NPattern(pat: x) :> not,
            .NEdit(k: x) :> not,
            .NView(v: x) :> not,
            .NAttr(a: x) :> not
        };
    }

    fn joinSymOf(s: Stmt) -> Sym | not {
        return match s {
            .Join(k: k) :> k,
            .Let(sym: x) :> not,
            .Assign(local: x) :> not,
            .Write(cap: x) :> not,
            .Commit(writes: x) :> not,
            .If(cond: x) :> not,
            .Return(e: x) :> not,
            .Eval(e: x) :> not,
            .Suspend(bind: x) :> not,
            .ResetSurface(of: x) :> not,
            .Defer(body: x) :> not,
            .Unpersist(decl: x) :> not,
            .Attempt(result: x) :> not,
            .Fail(err: x) :> not,
            .Jump(k: x) :> not,
            .Loop(label: x) :> not,
            .Break(target: x) :> not,
            .Continue(target: x) :> not,
            .Gather(g: x) :> not,
            .Lift(into: x) :> not,
            .LocalFn(f: x) :> not
        };
    }

    fn withCycle(ctx: Ctx, c: CycleJs) -> Ctx {
        return { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared,
                 rows: ctx.rows, slot: ctx.slot, prebuilt: ctx.prebuilt, ret: ctx.ret, server: ctx.server, tier0: ctx.tier0,
                 cycles: ctx.cycles.concat([c]), ns: ctx.ns, owned: ctx.owned };
    }

    fn cycleOf(ctx: Ctx, t: Sym) -> CycleJs | not {
        for (const c of ctx.cycles) {
            if (c.label == t.id) return c;
        }
        return not;
    }

    fn breakJs(ctx: Ctx, t: Sym) -> JsStmt[] {
        const c: CycleJs | not = cycleOf(ctx, t);
        if (c is given) return [JsStmt.SReturn(c.exit)];
        return [JsStmt.SBreak(symName(ctx, t))];
    }

    fn continueJs(ctx: Ctx, t: Sym) -> JsStmt[] {
        const c: CycleJs | not = cycleOf(ctx, t);
        if (c is given) return [JsStmt.SReturn(c.next)];
        return [JsStmt.SContinue(symName(ctx, t))];
    }

    fn cycleJs(ctx: Ctx, cp: CycleParts, exitK: Sym, assigned: int[]) -> JsStmt[] {
        const l: string = symName(ctx, cp.label);
        const exit: JsExpr = jcall(jid(symName(ctx, exitK)), []);
        const done: JsStmt = JsStmt.SReturn(exit);
        const h: LoopHead = cp.head;
        return match h {
            .Forever :> cycleOut(ctx, l, [], [], [], exit, jcall(jid(l), []), [], jcall(jid(l), []), cp, []),
            .While(cond: c) :> cycleOut(ctx, l, [], [], [JsStmt.SIf(JsExpr.JUn(JsUnOp.Not, exprJs(ctx, c)), [done], [])], exit, jcall(jid(l), []), [], jcall(jid(l), []), cp, []),
            .Each(h: eh) :> cycleEach(ctx, l, eh, exit, done, cp, assigned),
            .Range(h: rh) :> cycleRange(ctx, l, rh, exit, done, cp),
            .Counted(init: i, cond: c, step: sp) :> cycleCounted(ctx, l, i, c, sp, exit, done, cp, assigned)
        };
    }

    // `pre` (before the loop) · `const L = rt.cycle((params) => { guard; binds; body });` · `post` · `start;`
    fn cycleOut(ctx: Ctx, l: string, pre: JsStmt[], params: string[], guard: JsStmt[], exit: JsExpr, next: JsExpr,
                binds: JsStmt[], start: JsExpr, cp: CycleParts, post: JsStmt[]) -> JsStmt[] {
        const ictx: Ctx = withCycle(ctx, { label: cp.label.id, exit: exit, next: next });
        const iterate: JsExpr = JsExpr.JArrow(params, guard.concat(binds).concat(blockJs(ictx, cp.body)));
        return pre.concat([JsStmt.SConst(l, rtCall(ctx, "cycle", [iterate]))]).concat(post).concat([sexpr(start)]);
    }

    // `for (x of xs)`: the iterable once, its elements (a string's code points) by position.
    fn cycleEach(ctx: Ctx, l: string, eh: EachHead, exit: JsExpr, done: JsStmt, cp: CycleParts, assigned: int[]) -> JsStmt[] {
        const items: string = l + "$items";
        const i: string = l + "$i";
        const pre: JsStmt[] = [JsStmt.SConst(items, jmcall(jid("Array"), "from", [exprJs(ctx, eh.src)]))];
        const guard: JsStmt[] = [JsStmt.SIf(JsExpr.JBin(JsOp.Ge, jid(i), jmember(jid(items), "length")), [done], [])];
        const elem: JsExpr = JsExpr.JIndex(jid(items), jid(i));
        let bind: JsStmt = JsStmt.SConst(symName(ctx, eh.bind), elem);
        if (hasInt(assigned, eh.bind.id)) bind = JsStmt.SLet(symName(ctx, eh.bind), elem);
        const next: JsExpr = jcall(jid(l), [JsExpr.JBin(JsOp.Plus, jid(i), jnum(1))]);
        return cycleOut(ctx, l, pre, [i], guard, exit, next, [bind], jcall(jid(l), [jnum(0)]), cp, []);
    }

    // `for (i of lo..hi)`: both bounds once, `lo` first; the counter is the parameter.
    fn cycleRange(ctx: Ctx, l: string, rh: RangeHead, exit: JsExpr, done: JsStmt, cp: CycleParts) -> JsStmt[] {
        let iv: Sym = rh.bind;
        let binds: JsStmt[] = [];
        const counter: Sym | not = rh.counter;
        if (counter is given) {
            iv = counter;
            binds = [JsStmt.SLet(symName(ctx, rh.bind), jid(symName(ctx, counter)))];
        }
        const i: string = symName(ctx, iv);
        const e: string = symName(ctx, rh.end);
        const lo: string = l + "$lo";
        let op: JsOp = JsOp.Ge;
        if (rh.inclusive) op = JsOp.Gt;
        const pre: JsStmt[] = [JsStmt.SConst(lo, exprJs(ctx, rh.lo)), JsStmt.SConst(e, exprJs(ctx, rh.hi))];
        const guard: JsStmt[] = [JsStmt.SIf(JsExpr.JBin(op, jid(i), jid(e)), [done], [])];
        const next: JsExpr = jcall(jid(l), [JsExpr.JBin(JsOp.Plus, jid(i), jnum(1))]);
        return cycleOut(ctx, l, pre, [i], guard, exit, next, binds, jcall(jid(l), [jid(lo)]), cp, []);
    }

    // `for (init; cond; step)`: `init` once; its `let`s are the parameters; a
    // Continue runs the step on a copy (`L$step`) and starts the next iteration.
    fn cycleCounted(ctx: Ctx, l: string, init: Stmt[], cond: Expr | not, step: Stmt[], exit: JsExpr, done: JsStmt,
                    cp: CycleParts, assigned: int[]) -> JsStmt[] {
        let pre: JsStmt[] = [];
        let names: string[] = [];
        for (const s of init) {
            pre = pre.concat(stmtJs(ctx, s, assigned));
            for (const p of assignItem(ctx, s)) {
                if (stmtIsLet(s)) names = names.concat([p.key]);
            }
        }
        let args: JsExpr[] = [];
        for (const n of names) { args = args.concat([jid(n)]); }
        let guard: JsStmt[] = [];
        if (cond is given) guard = [JsStmt.SIf(JsExpr.JUn(JsUnOp.Not, exprJs(ctx, cond)), [done], [])];
        const stepName: string = l + "$step";
        let stepBody: JsStmt[] = [];
        for (const s of step) { stepBody = stepBody.concat(stmtJs(ctx, s, assigned)); }
        stepBody = stepBody.concat([JsStmt.SReturn(jcall(jid(l), args))]);
        const post: JsStmt[] = [JsStmt.SConst(stepName, JsExpr.JArrow(names, stepBody))];
        return cycleOut(ctx, l, pre, names, guard, exit, jcall(jid(stepName), args), [], jcall(jid(l), args), cp, post);
    }

    // s468 (U1c) — a block in SERVER mode: the explicit continuations of Core
    // print as straight-line async JavaScript. `Suspend(b, on, then)` is
    // `const b = await on;` then `then`'s statements (they are the rest of the
    // block, C12); `Join(k, body)` + the If it precedes is the If, then `body`
    // (every path through the If that does not leave ends in Jump(k) — C12 — so
    // falling off the If IS the jump); `Jump(k)` prints nothing. THE ONE `await`
    // RULE (S467 §13 gate): `await` is printed here, at a Suspend, and nowhere
    // else. The `then` is printed as its own block (its own `defer` stack, if it
    // holds one) flattened in place — its statements run in this function.
    fn serverStmtsJs(ctx: Ctx, ss: Stmt[], assigned: int[]) -> JsStmt[] {
        let out: JsStmt[] = [];
        let pendingJoin: Block | not = not;
        for (const s of ss) {
            const sp: SuspendParts | not = suspendPartsOf(s);
            const jb: Block | not = joinBodyOf(s);
            if (sp is given) {
                out = out.concat([JsStmt.SConst(symName(ctx, sp.bind), JsExpr.JAwait(exprJs(ctx, sp.on)))]);
                out = out.concat(blockJs(ctx, sp.then));
            } else if (jb is given) {
                pendingJoin = jb;
            } else if (!isJump(s)) {
                out = out.concat(stmtJs(ctx, s, assigned));
                const k: Block | not = pendingJoin;
                if (k is given) {
                    out = out.concat(blockJs(ctx, k));
                    pendingJoin = not;
                }
            }
        }
        return out;
    }

    type SuspendParts:struct = { bind: Sym, on: Expr, then: Block }

    fn suspendPartsOf(s: Stmt) -> SuspendParts | not {
        return match s {
            .Suspend(bind: b, on: on, then: t) :> { bind: b, on: on, then: t },
            .Let(sym: x) :> not,
            .Assign(local: x) :> not,
            .Write(cap: x) :> not,
            .Commit(writes: x) :> not,
            .If(cond: x) :> not,
            .Return(e: x) :> not,
            .Eval(e: x) :> not,
            .ResetSurface(of: x) :> not,
            .Defer(body: x) :> not,
            .Unpersist(decl: x) :> not,
            .Attempt(result: x) :> not,
            .Fail(err: x) :> not,
            .Join(k: x) :> not,
            .Jump(k: x) :> not,
            .Loop(label: x) :> not,
            .Break(target: x) :> not,
            .Continue(target: x) :> not,
            .Gather(g: x) :> not,
            .Lift(into: x) :> not,
            .LocalFn(f: x) :> not
        };
    }

    fn joinBodyOf(s: Stmt) -> Block | not {
        return match s {
            .Join(k: k, body: b) :> b,
            .Suspend(bind: x) :> not,
            .Let(sym: x) :> not,
            .Assign(local: x) :> not,
            .Write(cap: x) :> not,
            .Commit(writes: x) :> not,
            .If(cond: x) :> not,
            .Return(e: x) :> not,
            .Eval(e: x) :> not,
            .ResetSurface(of: x) :> not,
            .Defer(body: x) :> not,
            .Unpersist(decl: x) :> not,
            .Attempt(result: x) :> not,
            .Fail(err: x) :> not,
            .Jump(k: x) :> not,
            .Loop(label: x) :> not,
            .Break(target: x) :> not,
            .Continue(target: x) :> not,
            .Gather(g: x) :> not,
            .Lift(into: x) :> not,
            .LocalFn(f: x) :> not
        };
    }

    fn isJump(s: Stmt) -> boolean {
        return match s {
            .Jump(k: x) :> true,
            .Loop(label: x) :> false,
            .Break(target: x) :> false,
            .Continue(target: x) :> false,
            .Gather(g: x) :> false,
            .Lift(into: x) :> false,
            .LocalFn(f: x) :> false,
            .Join(k: x) :> false,
            .Suspend(bind: x) :> false,
            .Let(sym: x) :> false,
            .Assign(local: x) :> false,
            .Write(cap: x) :> false,
            .Commit(writes: x) :> false,
            .If(cond: x) :> false,
            .Return(e: x) :> false,
            .Eval(e: x) :> false,
            .ResetSurface(of: x) :> false,
            .Defer(body: x) :> false,
            .Unpersist(decl: x) :> false,
            .Attempt(result: x) :> false,
            .Fail(err: x) :> false
        };
    }

    // s451 — `defer` (§19.16.6, the informative shape): a block that holds a
    // Defer gets its own stack and is wrapped — whole, in place — in a
    // `try { … } finally { rt.runDefers(defers$) }`. Each Defer pushes its
    // body as a closure where it stands, so a Defer never reached registers
    // nothing; the closure is evaluated at exit and sees the bindings in scope
    // at the `defer`; a `return`'s value is computed before the `finally`
    // runs; the runtime runs the stack last-first and rethrows the first host
    // error after all have run (§19.16.2). An inner block's `defers$` shadows
    // the outer one — a deferred body holds no Defer (C16), so no closure
    // ever needs the outer stack from inside an inner block.
    fn holdsDefer(b: Block) -> boolean {
        for (const s of b.stmts) {
            if (isDefer(s)) return true;
        }
        return false;
    }

    fn isDefer(s: Stmt) -> boolean {
        return match s {
            .Defer(body: x) :> true,
            .Let(sym: x) :> false,
            .Assign(local: x) :> false,
            .Write(cap: x) :> false,
            .Commit(writes: x) :> false,
            .If(cond: x) :> false,
            .Return(e: x) :> false,
            .Eval(e: x) :> false,
            .Suspend(bind: x) :> false,
            .ResetSurface(of: x) :> false,
            .Unpersist(decl: x) :> false,
            .Attempt(result: x) :> false,
            .Fail(err: x) :> false,
            .Join(k: x) :> false,
            .Jump(k: x) :> false,
            .Loop(label: x) :> false,
            .Break(target: x) :> false,
            .Continue(target: x) :> false,
            .Gather(g: x) :> false,
            .Lift(into: x) :> false,
            .LocalFn(f: x) :> false
        };
    }

    fn deferBlockJs(ctx: Ctx, body: JsStmt[]) -> JsStmt[] {
        return [
            JsStmt.SConst("defers$", JsExpr.JArray([])),
            JsStmt.STry(body, [sexpr(rtCall(ctx, "runDefers", [jid("defers$")]))]),
        ];
    }

    fn deferJs(ctx: Ctx, body: Block) -> JsStmt {
        return sexpr(jmcall(jid("defers$"), "push", [JsExpr.JArrow([], blockJs(ctx, body))]));
    }

    // s478 (s478-boot-syntax-batch) — an `if`; a bare block (its test the literal `true`); or a
    // `transaction { … }` block (`tx`, core.scrml): its statements run under a savepoint of the
    // function's envelope on `tx` (server-runtime.js `txBlock` / `txEnd`, §19.10.3) —
    //   if (true) {
    //     const tx$ = await rt.txBlock(db$N);
    //     let txOk$ = false;
    //     try { … ; txOk$ = true; } finally { await rt.txEnd(tx$, txOk$); }
    //   }
    // `txOk$` is set only after the block's last statement, so normal completion alone releases
    // the savepoint; a `fail` / `return` / `break` / `continue` out of it, or a host error, reaches
    // the `finally` with it false and rolls the savepoint back before the exit proceeds (a
    // `return`'s value is computed first — §19.10.3 "the return expression SHALL be evaluated
    // before the rollback"). A `defer` in the block runs in the block's own `finally`, inside it,
    // before the release or rollback (§19.10.3, `defer` × `transaction`). Printed only in a SERVER
    // body (printProgram refuses a client function holding one; check.scrml C-TX4).
    fn ifStmtJs(ctx: Ctx, c: Expr, t: Block, e: Block | not, tx: Sym | not) -> JsStmt[] {
        if (tx is not) return [JsStmt.SIf(exprJs(ctx, c), blockJs(ctx, t), elseJs(ctx, e))];
        const open: JsStmt = JsStmt.SConst("tx$", JsExpr.JAwait(rtCall(ctx, "txBlock", [jid(dbVarName(tx))])));
        const flag: JsStmt = JsStmt.SLet("txOk$", JsExpr.JBool(false));
        const done: JsStmt = JsStmt.SAssign(jid("txOk$"), JsExpr.JBool(true));
        const end: JsStmt = sexpr(JsExpr.JAwait(rtCall(ctx, "txEnd", [jid("tx$"), jid("txOk$")])));
        return [JsStmt.SIf(JsExpr.JBool(true), [open, flag, JsStmt.STry(blockJs(ctx, t).concat([done]), [end])], [])];
    }

    fn stmtJs(ctx: Ctx, s: Stmt, assigned: int[]) -> JsStmt[] {
        return match s {
            .Let(sym: sym, init: init) :> letStmtsJs(ctx, sym, init, assigned),                 // s476: + an owned local's flag
            .Assign(local: l, value: v, path: pa) :> assignStmtsJs(ctx, l, v, pa),            // s476: an owned local's edit in place
            .Write(cap: cap, inst: inst, edit: edit, value: v, check: ck) :> [writeJs(ctx, cap, inst, edit, v, ck)],
            .Commit(writes: ws) :> commitJs(ctx, ws),
            .If(cond: c, thenB: t, elseB: e, tx: tx) :> ifStmtJs(ctx, c, t, e, tx),
            .Return(e: e) :> [returnJs(ctx, exprJs(ctx, e))],
            .Eval(e: e) :> [sexpr(exprJs(ctx, e))],
            .Suspend(bind: b, on: on, then: t) :> [suspendJs(ctx, b, on, t)],
            .ResetSurface(of: v) :> [sexpr(jmcall(surfaceJs(ctx, v), "reset", []))],
            .Defer(body: d) :> [deferJs(ctx, d)],
            .Unpersist(decl: d, inst: i, idx: x) :> [unpersistJs(ctx, d, i, x)],
            .Attempt(result: r, call: c, err: e, ok: ok, arms: arms) :> attemptJs(ctx, r, c, e, ok, arms, assigned),
            .Fail(err: e, idx: i, args: args) :> [returnJs(ctx, rtCall(ctx, "failure", [variantValueJs(ctx, e, i, args)]))],
            .Join(k: k, body: b) :> [JsStmt.SConst(symName(ctx, k), JsExpr.JArrow([], blockJs(ctx, b)))],
            .Jump(k: k) :> [sexpr(jcall(jid(symName(ctx, k)), []))],
            .Loop(label: l, head: h, body: lb) :> loopJs(ctx, l, h, lb, assigned),   // s469 (§49)
            .Break(target: t) :> breakJs(ctx, t),
            .Continue(target: t) :> continueJs(ctx, t),
            .Gather(g: g) :> stmtGatherJs(ctx, g, assigned),                     // s469 (§49.6)
            .Lift(into: i, what: w) :> [liftJs(ctx, i, w)],
            .LocalFn(f: f) :> [localFnJs(ctx, f)]                             // s477 (§7.3.1)
        };
    }

    // -------------------------------------------------------------------------
    // s469 — a loop bound as a value (§49.6): `const xs = [];` then the loop,
    // each Lift `xs.push(v)`. The tape is fresh (nothing else holds it) and is
    // complete when the loop ends — by its head, a `break` (the prefix, rule 5)
    // or never; `return` / `fail` leave the function as from any loop (rule 6).
    // Nothing reads `xs` inside its own loop (it is in scope after it).
    // -------------------------------------------------------------------------
    fn stmtGatherJs(ctx: Ctx, g: Gather, assigned: int[]) -> JsStmt[] {
        const name: string = symName(ctx, g.bind);
        let decl: JsStmt = JsStmt.SConst(name, JsExpr.JArray([]));
        if (hasInt(assigned, g.bind.id)) decl = JsStmt.SLet(name, JsExpr.JArray([]));
        return [decl].concat(loopJs(withTier0(ctx, not), g.label, g.head, g.body, assigned));
    }

    fn withTier0(ctx: Ctx, t: Tier0Rows | not) -> Ctx {
        return { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared,
                 rows: ctx.rows, slot: ctx.slot, prebuilt: ctx.prebuilt, ret: ctx.ret, server: ctx.server, tier0: t, cycles: ctx.cycles, ns: ctx.ns, owned: ctx.owned };
    }

    fn withNs(ctx: Ctx, ns: string) -> Ctx {
        return { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared,
                 rows: ctx.rows, slot: ctx.slot, prebuilt: ctx.prebuilt, ret: ctx.ret, server: ctx.server, tier0: ctx.tier0, cycles: ctx.cycles, ns: ns, owned: ctx.owned };
    }

    // -------------------------------------------------------------------------
    // s474 (boot-gate-await-mathml) — FOREIGN CONTENT. A template's content is
    // parsed where the page holds it: a `<template>` in the head, an HTML
    // context. Content that is INSERTED into an `<svg>` or a `<math>` — an
    // `if=` arm (`<svg><text if=…>`), an `<each>` / `${ for … lift }` row, a
    // component's renders, slot content — parsed there is HTML (`<text>` /
    // `<mi>` an HTMLUnknownElement) and never renders: measured in Chromium, a
    // gate whose test is true showed nothing. So every template records the
    // context it is inserted in, and a foreign one is printed INSIDE the
    // elements that make the browser's own parser build it in that context
    // (`wrapNs`); the runtime's `template()` unwraps the clone. The parser is
    // still the only reader of the markup — the same one that reads the
    // program's main template, where the same markup sits inline.
    //
    // The contexts and the one function that computes them, `childNs`, live in
    // elements.scrml (the analyzer reads the same one, to refuse markup the
    // parser restructures — SPEC §24.5). Only a STATIC `encoding` decides: a
    // bound one is set after the parse.
    // -------------------------------------------------------------------------

    /** The context the children of a Core element `<tag attrs>`, itself in context `ns`, parse in. */
    fn elChildNs(ns: string, tag: string, attrs: Attr[]) -> string {
        return childNs(ns, tag, staticAttrValue(attrs, "encoding"));
    }

    fn staticAttrValue(attrs: Attr[], name: string) -> string {
        for (const a of attrs) {
            const v: string = staticValueIf(a, name);
            if (v != "") return v;
        }
        return "";
    }

    fn staticValueIf(a: Attr, name: string) -> string {
        return match a {
            .Static(name: n, value: x) :> staticValueNamed(n, x, name),
            .Bound :> "",
            .Show :> "",
            .ClassOn :> "",
            .On :> "",
            .Bind :> "",
            .Gate :> ""
        };
    }

    fn staticValueNamed(n: string, x: string, name: string) -> string {
        if (n.toLowerCase() == name) return x;
        return "";
    }

    /** `nodes`, inside the elements that make an HTML-context parse build them in context `ns`. */
    fn wrapNs(ns: string, nodes: HNode[]) -> HNode[] {
        if (ns == "svg") return [HNode.HElem("svg", [], nodes)];
        if (ns == "math") return [HNode.HElem("math", [], nodes)];
        if (ns == "math-text") return [HNode.HElem("math", [], [HNode.HElem("mi", [], nodes)])];
        if (ns == "annot") return [HNode.HElem("math", [], [HNode.HElem("annotation-xml", [], nodes)])];
        return nodes;
    }

    /** A template's page element: `<template id>` — and, foreign, its context marker + wrapper. */
    fn templateElem(t: Template) -> HNode {
        const shape: HAttr = { name: "data-scrml-shape", value: shapeHash(t.ns, t.nodes) };
        if (t.ns == htmlNs()) return HNode.HElem("template", [{ name: "id", value: t.id }, shape], t.nodes);
        return HNode.HElem("template", [{ name: "id", value: t.id }, { name: "data-scrml-ns", value: t.ns }, shape], wrapNs(t.ns, t.nodes));
    }

    // s474 r1 (review of #1727, F3 defence in depth) — THE SHAPE OF A TEMPLATE.
    // Holes are addressed by child-index path over the tree as WRITTEN. The
    // analyzer refuses the markup the HTML parser is known to restructure (SPEC
    // §24.5, analyze.scrml markupParseDiags); this is the backstop for any rule
    // it does not model. The printer writes a hash of the content's element /
    // comment structure (preorder `depth:name;`, text excluded — a hole marker
    // is a comment, a `show=` / bound element an element), and the runtime's
    // `template()` hashes what the browser actually built, once per template,
    // and throws on a mismatch — so a restructured template never mounts with
    // its holes on the wrong nodes (runtime.js `shapeHash`, the same function).
    // Not walked, on either side: a void element's children (never printed),
    // an HTML `<template>`'s (its content is not its children), and the text
    // of a raw-text / RCDATA element (`<textarea>`, `<title>`, …: no elements).
    fn shapeHash(ns: string, nodes: HNode[]) -> string {
        const s: string = shapeOf(nodes, ns, 0);
        let h: int = 7;
        let i: int = 0;
        for (; i < s.length; ) {
            h = (h * 31 + s.charCodeAt(i)) % 2147483647;
            i = i + 1;
        }
        return "" + h;
    }

    // s474 r2 (re-review R1): hole paths are `childNodes` indices, which count TEXT nodes — so the shape
    // records each run of adjacent text (the browser merges adjacent text into one node; an empty text
    // makes none) as `depth:t;`: that the node exists, never its content. A parser change that only
    // drops or merges a text node (the line feed after `<listing>`, a NUL-only text) is then a mismatch.
    fn shapeOf(nodes: HNode[], ns: string, depth: int) -> string {
        let out: string = "";
        let inText: boolean = false;
        for (const n of nodes) {
            const tx: string = shapeTextOf(n);
            if (tx == "~") {
                inText = false;
                out = out + shapeNode(n, ns, depth);
            } else if (tx != "" && !inText) {
                out = out + depth + ":t;";
                inText = true;
            }
        }
        return out;
    }

    // A text node's text ("" when empty), or "~" for a node that is not text.
    fn shapeTextOf(n: HNode) -> string {
        return match n {
            .HElem(tag: t) :> "~",
            .HComment(text: x) :> "~",
            .HText(text: x) :> shapeNonEmpty(x),
            .HRawText(text: x) :> shapeNonEmpty(x),
            .HStyle(text: x) :> shapeNonEmpty(x)
        };
    }

    fn shapeNonEmpty(x: string) -> string {
        if (x == "") return "";
        return "t";
    }

    fn shapeNode(n: HNode, ns: string, depth: int) -> string {
        return match n {
            .HElem(tag: t, attrs: attrs, kids: ks) :> shapeElem(t, attrs, ks, ns, depth),
            .HText(text: x) :> "",
            .HRawText(text: x) :> "",
            .HComment(text: x) :> "" + depth + ":#;",
            .HStyle(text: x) :> ""
        };
    }

    fn shapeElem(tag: string, attrs: HAttr[], kids: HNode[], ns: string, depth: int) -> string {
        const t: string = tag.toLowerCase();
        let name: string = t;
        if (t == "image" && isHtmlInNs(ns, t)) name = "img";   // the "in body" rule renames it
        const own: string = "" + depth + ":" + name + ";";
        if (isVoid(tag)) return own;
        if (isHtmlInNs(ns, t) && shapeOpaque(t)) return own;
        // s474 r3: the kids are already the page's (buildEl cut the line ending the parser drops)
        return own + shapeOf(kids, childNs(ns, t, hattrValue(attrs, "encoding")), depth + 1);
    }

    fn shapeOpaque(t: string) -> boolean {
        return ["template", "script", "style", "textarea", "title", "xmp", "iframe", "noembed", "noframes", "noscript", "plaintext"].indexOf(t) >= 0;
    }

    fn hattrValue(attrs: HAttr[], name: string) -> string {
        for (const a of attrs) { if (a.name.toLowerCase() == name) return a.value; }
        return "";
    }

    // A declaration's renders are ONE template per context it is used in (a
    // `<g>`-rooted icon used in an `<svg>`, a `<span>` label used in a `<p>`):
    // its render function for "html" keeps its name and template id; another
    // context's carries the context (`render_icon$svg`, `scrml:icon~…@svg`).
    // A minted name never holds `$` (names.scrml sanitize), so none collides.
    fn nsSuffix(ns: string) -> string {
        if (ns == htmlNs()) return "";
        return "$" + ns.replaceAll("-", "_");
    }

    fn renderName(ctx: Ctx, d: Sym, ns: string) -> string {
        return nameOf(ctx.names, NameKey.Render(d.id)) + nsSuffix(ns);
    }

    // The contexts each declaration is used in: the program's renders are
    // mounted in `<body>` ("html"); a use (`<x/>`) or a Star (`<*x/>`) in a
    // renders walked in context C uses x in the context AT that site. A least
    // fixed point (each list only grows, by at most the five contexts per
    // declaration, so it terminates); a declaration no site uses keeps "html".
    type DeclNs:struct = { decl: int, ns: string[] }
    // A use site (`decl` ≥ 0) or a `<slot/>` site (`decl` == -1), with its context.
    type NsSite:struct = { decl: int, ns: string }

    fn nsOfDecl(uses: DeclNs[], id: int) -> string[] {
        for (const u of uses) { if (u.decl == id) return u.ns; }
        return [];
    }

    fn addUse(uses: DeclNs[], id: int, ns: string) -> DeclNs[] {
        let out: DeclNs[] = [];
        let found = false;
        for (const u of uses) {
            if (u.decl == id) {
                found = true;
                if (u.ns.indexOf(ns) >= 0) return uses;
                out = out.concat([{ decl: id, ns: u.ns.concat([ns]) }]);
            } else {
                out = out.concat([u]);
            }
        }
        if (!found) out = out.concat([{ decl: id, ns: [ns] }]);
        return out;
    }

    export fn declNsUses(p: CoreProgram) -> DeclNs[] {
        let uses: DeclNs[] = [{ decl: p.program.id, ns: [htmlNs()] }];
        let changed = true;
        let rounds = 0;
        for (; changed && rounds <= p.decls.length * 5 + 1; ) {
            changed = false;
            rounds = rounds + 1;
            for (const d of p.decls) {
                const views: View[] | not = d.renders;
                if (views is given) {
                    for (const ns of nsOfDecl(uses, d.sym.id)) {
                        for (const site of nsSites(p, views, ns, 0)) {
                            if (site.decl >= 0) {
                                const next: DeclNs[] = addUse(uses, site.decl, site.ns);
                                if (next.length != uses.length || nsOfDecl(next, site.decl).length != nsOfDecl(uses, site.decl).length) changed = true;
                                uses = next;
                            }
                        }
                    }
                }
            }
        }
        return uses;
    }

    /** The contexts a declaration's renders are printed in (never empty). */
    fn declNsList(uses: DeclNs[], d: Decl) -> string[] {
        const ns: string[] = nsOfDecl(uses, d.sym.id);
        if (ns.length == 0) return [htmlNs()];
        return ns;
    }

    // The use / Star / `<slot/>` sites of `views` walked in context `ns` — the
    // same descent buildNodes makes (an element's children in `childNs`; a
    // Cond arm, an `<each>` row, a Tier-0 row in the hole's own context), and a
    // use's slot content in the context of the used declaration's `<slot/>`.
    // `depth` bounds the slot descent through declarations that pass a slot on.
    fn nsSites(p: CoreProgram, views: View[], ns: string, depth: int) -> NsSite[] {
        let out: NsSite[] = [];
        for (const v of views) { out = out.concat(nsSitesOf(p, v, ns, depth)); }
        return out;
    }

    fn nsSitesOf(p: CoreProgram, v: View, ns: string, depth: int) -> NsSite[] {
        return match v {
            .El(tag: tag, attrs: attrs, kids: ks) :> nsSites(p, ks, elChildNs(ns, tag, attrs), depth),
            .Cond(arms: arms) :> nsSitesArms(p, arms, ns, depth),
            .Each(row: row) :> nsSites(p, row, ns, depth),
            .Gather(rows: rows) :> nsSitesRows(p, rows, ns, depth),
            .Instance(decl: d, slot: slot) :> [{ decl: d.id, ns: ns }].concat(nsSites(p, slot, slotNsOf(p, d, ns, depth + 1), depth + 1)),
            .Star(decl: d) :> [{ decl: d.id, ns: ns }],
            .Slot :> [{ decl: -1, ns: ns }],
            .Text :> [],
            .RawText :> [],
            .Dyn :> [],
            .Effect :> [],
            .Run :> [],
            .Init :> [],
            .Request :> [],
            .ResetOn :> [],
            .Errors :> [],
            .Reach :> []
        };
    }

    fn nsSitesArms(p: CoreProgram, arms: CondArm[], ns: string, depth: int) -> NsSite[] {
        let out: NsSite[] = [];
        for (const a of arms) { out = out.concat(nsSites(p, a.body, ns, depth)); }
        return out;
    }

    fn nsSitesRows(p: CoreProgram, rows: GatherRow[], ns: string, depth: int) -> NsSite[] {
        let out: NsSite[] = [];
        for (const r of rows) { out = out.concat(nsSites(p, r.views, ns, depth)); }
        return out;
    }

    /** The context `d`'s `<slot/>` sits in when `d`'s renders are in context `ns` (`ns` when it has none). */
    fn slotNsOf(p: CoreProgram, dsym: Sym, ns: string, depth: int) -> string {
        if (depth > 32) return ns;
        const d: Decl | not = findDecl(p, dsym);
        if (d is not) return ns;
        const views: View[] | not = d.renders;
        if (views is not) return ns;
        for (const site of nsSites(p, views, ns, depth)) {
            if (site.decl == -1) return site.ns;
        }
        return ns;
    }

    // `into.push(v)`; in a Tier-0 loop a value is a text row (`rt.textRow(v)`)
    // and a row Lift pushes its row's render thunk.
    fn liftJs(ctx: Ctx, into: Sym, w: Lifted) -> JsStmt {
        const acc: JsExpr = jid(symName(ctx, into));
        const t0: Tier0Rows | not = ctx.tier0;
        return match w {
            .LValue(e: e) :> sexpr(jmcall(acc, "push", [tier0Value(ctx, t0, exprJs(ctx, e))])),
            .LRow(idx: k) :> sexpr(jmcall(acc, "push", [tier0Row(t0, k)]))
        };
    }

    fn tier0Value(ctx: Ctx, t0: Tier0Rows | not, v: JsExpr) -> JsExpr {
        if (t0 is not) return v;
        if (t0.key != "") return rtCall(ctx, "keyTextRow", [jid(t0.key), v]);   // s474 (§17.4b)
        return rtCall(ctx, "textRow", [v]);
    }

    // (check.scrml C20: a row Lift stands only in a View.Gather and names one of its rows)
    fn tier0Row(t0: Tier0Rows | not, k: int) -> JsExpr {
        if (t0 is not) return jid("unboundRow$" + k);
        if (k < 0 || k >= t0.rows.length) return jid("unboundRow$" + k);
        return t0.rows[k];
    }

    // -------------------------------------------------------------------------
    // s469 — a loop (§49). Every Break / Continue names its loop, and a loop
    // prints its label exactly when a jump in its body names it — so a jump
    // always leaves the loop Core says, nested or not (check.scrml C19: the
    // loop encloses it). The heads print as the JavaScript loop of the same
    // meaning: `for (;;)`, `while (c)`, `for (init; c; step)`, and
    // `for (const x of xs)` — each binds per iteration (§49.3.7) as JavaScript's
    // `let` / `const` loop bindings do. A range evaluates both bounds once, in
    // order, into its counter and `end` (§49.2.5); a `let` binder is a copy of
    // the loop's own counter, so writing it never moves the loop.
    // -------------------------------------------------------------------------
    fn loopJs(ctx: Ctx, label: Sym, h: LoopHead, body: Block, assigned: int[]) -> JsStmt[] {
        let ln: string = "";
        if (loopIsJumped(label, body)) ln = symName(ctx, label);
        return match h {
            .Forever :> [JsStmt.SLoop(ln, JsLoopHead.JForever, blockJs(ctx, body))],
            .While(cond: c) :> [JsStmt.SLoop(ln, JsLoopHead.JWhile(exprJs(ctx, c)), blockJs(ctx, body))],
            .Counted(init: i, cond: c, step: sp) :> [JsStmt.SLoop(ln, JsLoopHead.JForC(forInitJs(ctx, i), maybeExprJs(ctx, c), assignItems(ctx, sp)), blockJs(ctx, body))],
            .Each(h: eh) :> [JsStmt.SLoop(ln, JsLoopHead.JForOf(symName(ctx, eh.bind), hasInt(assigned, eh.bind.id), exprJs(ctx, eh.src)), blockJs(ctx, body))],
            .Range(h: rh) :> [rangeJs(ctx, ln, rh, body)]
        };
    }

    fn maybeExprJs(ctx: Ctx, e: Expr | not) -> JsExpr | not {
        if (e is not) return not;
        return exprJs(ctx, e);
    }

    fn jsProp(k: string, v: JsExpr) -> JsProp { return { key: k, value: v }; }

    // s472 — the value an Assign gives its local: `value` itself (a rebinding),
    // or — a part write, `path` non-empty — a COPY of the local's value with
    // `value` at `path` (`p = rt.writePath(p, ["head"], v, "file:line")`): a
    // field step is the member's name, an index step the index; an index
    // outside its tape is the E-INDEX-OUT-OF-RANGE-RT trap, and the local is
    // then never rebound (values are immutable, §66.10 — no alias sees it).
    fn assignedJs(ctx: Ctx, l: Sym, v: Expr, path: PathStep[]) -> JsExpr {
        if (path.length == 0) return exprJs(ctx, v);
        return rtCall(ctx, "writePath", [jid(symName(ctx, l)), pathStepsJs(ctx, path), exprJs(ctx, v), jstr(pathLoc(path))]);
    }

    // s472: a part write's path as the runtime takes it (`["head"]`, `[i]`), and the
    // source location its trap reports (the first index step's)
    fn pathStepsJs(ctx: Ctx, path: PathStep[]) -> JsExpr {
        let steps: JsExpr[] = [];
        for (const st of path) { steps = steps.concat([pathStepJs(ctx, st)]); }
        return JsExpr.JArray(steps);
    }

    fn pathLoc(path: PathStep[]) -> string {
        let loc: string = "";
        for (const st of path) {
            const sl: string = pathStepLoc(st);
            if (loc == "") loc = sl;
        }
        return loc;
    }

    // -------------------------------------------------------------------------
    // s476 (s476-boot-tape-inplace) — an edit of a local IN PLACE when nothing
    // else can see its value. A granted edit of a local (`xs.append(v)` …
    // `xs.remove(i)`) and a part write (`xs[i] = v`, `p.f = v`) rebind the local
    // to a COPY with the edit (§66.10 item 1: "A binding, argument or field
    // initialized from a cell (or from any value) holds a snapshot of that
    // value"). When no other binding, cell, argument, field, element, iteration
    // or deferred body can ever hold the local's current value, the copy is
    // unobservable, and the edit is made in place (§66.10 item 5, non-normative:
    // "The copy strategy is not part of the contract") — so building a tape in a
    // loop is amortized O(1) per append, not O(n).
    //
    // The proof is over the WHOLE function body, in no order, so a read in one
    // loop iteration and a write in the next can never meet: a `let` local is
    // OWNED when every read of it is one that keeps no reference to its value —
    //   * the receiver of a built-in that yields a part or a NEW value
    //     (`.length`, `xs[i]`, `xs.at(i)`, `join`, `includes`, `is given`, `sort`,
    //     `reverse`, the Tape* edits; both sides of `==` (§45) and of a spread
    //     `[...a, ...b]`);
    //   * the receiver of `map` / `filter` / `some` / `every` / `sortBy` whose
    //     function is a lambda of at most two parameters (JavaScript hands the
    //     array itself to a third);
    //   * a field read `p.f` (a part);
    //   * `return x`, also as a field / element of a struct or tape literal the
    //     `return` builds (the frame ends; a `defer` that could still write is below).
    // ANY other read — a call argument, another binding's initializer, a cell
    // write, a struct or tape element, a `for … of` iterable, a `match`, a lambda
    // body that yields it, a `lift`, a `fail`, a server call — and any mention in
    // a `defer` body (it runs after `return` has evaluated its value, §19.16.2)
    // makes the local copy on EVERY write, as before. A local bound in a counted
    // loop's head or by a condition assignment (`for ((x = …))`) is not owned (those
    // print elsewhere). When unsure, it copies: the walk below reaches every
    // expression through walk.scrml `kids`, and every local it meets in a
    // position not listed above is disqualified.
    //
    // FRESH values — an array or struct literal, a Tape* / sort / reverse /
    // `map` / `filter` / `sortBy` result — are held by nobody else. A local only
    // ever bound to fresh values owns its value always (`fixed`: the edit is
    // `rt.tapeAppendOwned(true …)`). A local ever bound to a value someone else
    // may hold (a parameter, a field, a call's result) carries a flag `x$own`:
    // false after such a binding, true after an edit (whose result is new when it
    // copied) — so its FIRST edit copies and the rest are in place.
    // -------------------------------------------------------------------------
    type OwnedLocal:struct = { id: int, fixed: boolean }
    // `lets` the locals a statement Let binds; `stale` those ever bound to a value
    // someone else may hold; `edited` those an edit or a part write rebinds; `bad`
    // those read where the read may keep their value, or bound where no flag prints.
    type OwnScan:struct = { lets: int[], stale: int[], edited: int[], bad: int[] }
    // an edit of a local by itself (`xs = TapeAppend(xs, v)`): the runtime's owned
    // writer and the edit's other arguments
    type SelfEdit:struct = { fn: string, args: Expr[] }

    fn ownNone() -> OwnScan { return { lets: [], stale: [], edited: [], bad: [] }; }
    fn ownBad(ids: int[]) -> OwnScan { return { lets: [], stale: [], edited: [], bad: ids }; }
    fn ownJoin(a: OwnScan, b: OwnScan) -> OwnScan {
        return { lets: a.lets.concat(b.lets), stale: a.stale.concat(b.stale), edited: a.edited.concat(b.edited), bad: a.bad.concat(b.bad) };
    }

    // The locals of one function body that own their value (and are edited).
    export fn ownedLocals(b: Block) -> OwnedLocal[] {
        const s: OwnScan = ownScan(Node.NBlock(b));
        let out: OwnedLocal[] = [];
        let seen: int[] = [];
        for (const id of s.lets) {
            if (!hasInt(seen, id) && hasInt(s.edited, id) && !hasInt(s.bad, id)) {
                out = out.concat([{ id: id, fixed: !hasInt(s.stale, id) }]);
            }
            seen = seen.concat([id]);
        }
        return out;
    }

    fn ownScan(n: Node) -> OwnScan {
        return match n {
            .NStmt(s: s) :> ownStmt(s),
            .NExpr(e: e) :> ownExpr(e),
            .NInst(i: i) :> ownBad(instLocals(i)),
            .NProgram(p: x) :> ownKids(n),
            .NDecl(d: x) :> ownKids(n),
            .NField(f: x) :> ownKids(n),
            .NFn(f: x) :> ownKids(n),
            .NServerFn(f: x) :> ownKids(n),
            .NBlock(b: x) :> ownKids(n),
            .NPlace(pl: x) :> ownKids(n),
            .NPattern(pat: x) :> ownKids(n),
            .NEdit(k: x) :> ownKids(n),
            .NView(v: x) :> ownKids(n),
            .NAttr(a: x) :> ownKids(n)
        };
    }

    fn ownKids(n: Node) -> OwnScan {
        let out: OwnScan = ownNone();
        for (const k of nodeKids(n)) { out = ownJoin(out, ownScan(k)); }
        return out;
    }

    // a handle local an instance reference names (never a tape; disqualified all the same)
    fn instLocals(i: InstRef) -> int[] {
        return match i {
            .Alias(sym: s) :> [s.id],
            .Narrowed(sym: s) :> [s.id],
            .Kid(of: o) :> instLocals(o),
            .HandleOf(of: o, sym: s) :> instLocals(o).concat([s.id]),
            .Shared(decl: x) :> [],
            .Lexical(depth: x) :> []
        };
    }

    fn ownStmt(s: Stmt) -> OwnScan {
        return match s {
            .Let(sym: sym, init: init) :> ownLet(sym, init),
            .Assign(local: l, value: v, path: pa) :> ownAssign(l, v, pa),
            .Return(e: e) :> ownReturn(e),
            .Defer(body: b) :> ownBad(blockLocals(b)),
            .Loop(label: x, head: h) :> ownJoin(ownKids(Node.NStmt(s)), ownBad(headBound(h))),
            .Gather(g: g) :> ownJoin(ownKids(Node.NStmt(s)), ownBad(headBound(g.head))),
            .Write(cap: x) :> ownKids(Node.NStmt(s)),
            .Commit(writes: x) :> ownKids(Node.NStmt(s)),
            .If(cond: x) :> ownKids(Node.NStmt(s)),
            .Eval(e: x) :> ownKids(Node.NStmt(s)),
            .Suspend(bind: b) :> ownJoin(ownKids(Node.NStmt(s)), ownBad([b.id])),     // s478: the bind is a Sym (walk.kids carries no Node for it)
            .ResetSurface(of: x) :> ownKids(Node.NStmt(s)),
            .Unpersist(decl: x) :> ownKids(Node.NStmt(s)),
            .Attempt(result: r, call: c, ok: ok, arms: arms) :> ownJoin(ownKids(Node.NStmt(s)), ownBad(attemptSyms(r, c, ok, arms))),   // s478: see attemptSyms
            .Fail(err: x) :> ownKids(Node.NStmt(s)),
            .Join(k: x) :> ownKids(Node.NStmt(s)),
            .Jump(k: x) :> ownKids(Node.NStmt(s)),
            .Break(target: x) :> ownKids(Node.NStmt(s)),
            .Continue(target: x) :> ownKids(Node.NStmt(s)),
            .Lift(into: x) :> ownKids(Node.NStmt(s)),
            .LocalFn(f: f) :> ownBad(blockLocals(f.body))     // s477: a closure (§7.3.1) may see any local it names, whenever it runs — every write of one copies
        };
    }

    // s478 (s478-boot-ownership-hardening): the locals an Attempt names as Syms, not
    // as Nodes — walk.kids does not reach them (a Sym is a leaf of the walk), so the
    // scan above would not see them: its `result` (bound to the taken branch's value),
    // an FSettled call's `outcome` (a READ of the Suspend's bind), the success
    // binder and each failure arm's whole-error binder. Each is disqualified (fail
    // closed). Today every one is a binder analyze / lower mints fresh (never a Let),
    // so no owned local changes; a lowering that ever names a Let here copies.
    fn attemptSyms(result: Sym | not, call: Failable, ok: OkArm, arms: ErrArm[]) -> int[] {
        let out: int[] = [ok.bind.id];
        if (result is given) out = out.concat([result.id]);
        out = out.concat(failableSyms(call));
        for (const a of arms) {
            const w: Sym | not = a.whole;
            if (w is given) out = out.concat([w.id]);
        }
        return out;
    }

    fn failableSyms(c: Failable) -> int[] {
        return match c {
            .FSettled(outcome: o) :> [o.id],
            .FCall(fn: f) :> [],          // its arguments are Nodes (walk.kids); `fn` names a function, not a local
            .FParse(json: j) :> [],       // s478: its input is a Node (walk.kids); `en` / `err` name types
            .FCallV(f: x) :> []          // s478-ruled-fn-types: its callee Local and arguments are Nodes (walk.failableKids)
        };
    }

    fn ownLet(sym: Sym, init: Expr) -> OwnScan {
        let r: OwnScan = ownJoin(ownExpr(init), { lets: [sym.id], stale: [], edited: [], bad: [] });
        if (!ownFresh(init)) r = ownJoin(r, { lets: [], stale: [sym.id], edited: [], bad: [] });
        return r;
    }

    fn ownAssign(l: Sym, v: Expr, path: PathStep[]) -> OwnScan {
        let r: OwnScan = ownExpr(v);
        for (const st of path) { r = ownJoin(r, ownStep(st)); }
        if (path.length > 0) return ownJoin(r, { lets: [], stale: [], edited: [l.id], bad: [] });
        const se: SelfEdit | not = selfEdit(l, v);
        if (se is given) return ownJoin(r, { lets: [], stale: [], edited: [l.id], bad: [] });
        if (!ownFresh(v)) r = ownJoin(r, { lets: [], stale: [l.id], edited: [], bad: [] });
        return r;
    }

    fn ownStep(st: PathStep) -> OwnScan {
        return match st {
            .StepIndex(index: ix) :> ownExpr(ix),
            .StepField(ref: r) :> ownNone()
        };
    }

    // `return x`, and `return { a: x, b: [y] }`: the frame ends, so a local the
    // returned value holds — whole, or as a field / element of a struct or tape
    // literal built right there — is never written again (a `defer` that could is
    // disqualified above). What the caller gets is held by nobody else; the caller
    // binds it as a value someone else may hold all the same (a call's result is
    // not fresh), so its own first edit copies.
    fn ownReturn(e: Expr) -> OwnScan {
        if (exprLocalOf(e) >= 0) return ownNone();
        const parts: Expr[] | not = literalParts(e);
        if (parts is given) {
            let r: OwnScan = ownNone();
            for (const p of parts) { r = ownJoin(r, ownReturn(p)); }
            return r;
        }
        return ownExpr(e);
    }

    // the parts of a struct or tape literal; `not` for anything else
    fn literalParts(e: Expr) -> Expr[] | not {
        return match e {
            .ArrayOf(elems: es) :> es,
            .StructOf(ty: x, fields: fs) :> fs,
            .Lit(lit: x) :> not,
            .Local(sym: x) :> not,
            .Read(place: x) :> not,
            .Call(callee: x) :> not,
            .FnRef(fn: x) :> not,
            .CallV(f: x) :> not,
            .Prim(op: x) :> not,
            .Match(scrut: x) :> not,
            .VariantOf(enumSym: x) :> not,
            .Handle(inst: x) :> not,
            .Assigned(local: x) :> not,
            .InitOf(decl: x) :> not,
            .Host(call: x) :> not,
            .Lambda(params: x) :> not,
            .BlockLambda(params: x) :> not,
            .SeqCall(op: x) :> not,
            .Refetch(req: x) :> not,
            .Validity(of: x) :> not,
            .ServerCall(fn: x) :> not,
            .Query(q: x) :> not,
            .Foreign(slice: x) :> not
        };
    }

    fn ownExpr(e: Expr) -> OwnScan {
        return match e {
            .Local(sym: s) :> ownBad([s.id]),
            .Prim(op: op, args: args) :> ownPrim(op, args),
            .SeqCall(op: o, seq: sq, f: f) :> ownSeq(o, sq, f),
            .Assigned(local: l, value: v) :> ownJoin(ownBad([l.id]), ownExpr(v)),
            .Lit(lit: x) :> ownKids(Node.NExpr(e)),
            .Read(place: x) :> ownKids(Node.NExpr(e)),
            .Call(callee: x) :> ownKids(Node.NExpr(e)),
            .FnRef(fn: x) :> ownKids(Node.NExpr(e)),
            .CallV(f: x) :> ownKids(Node.NExpr(e)),
            .Match(scrut: x) :> ownKids(Node.NExpr(e)),
            .ArrayOf(elems: x) :> ownKids(Node.NExpr(e)),
            .StructOf(ty: x) :> ownKids(Node.NExpr(e)),
            .VariantOf(enumSym: x) :> ownKids(Node.NExpr(e)),
            .Handle(inst: x) :> ownKids(Node.NExpr(e)),
            .InitOf(decl: x) :> ownKids(Node.NExpr(e)),
            .Host(call: x) :> ownKids(Node.NExpr(e)),
            .Lambda(params: x) :> ownKids(Node.NExpr(e)),
            .BlockLambda(params: x) :> ownKids(Node.NExpr(e)),
            .Refetch(req: x) :> ownKids(Node.NExpr(e)),
            .Validity(of: x) :> ownKids(Node.NExpr(e)),
            .ServerCall(fn: x) :> ownKids(Node.NExpr(e)),
            .Query(q: x) :> ownKids(Node.NExpr(e)),
            .Foreign(slice: x) :> ownKids(Node.NExpr(e))     // s477: a crossing is an ordinary read — host code may keep it
        };
    }

    // A built-in's arguments: its first `wholeReads(op)` may be a bare local (the
    // built-in keeps no reference to it); every other argument is an ordinary read.
    fn ownPrim(op: PrimOp, args: Expr[]) -> OwnScan {
        const keep: int = wholeReads(op);
        let r: OwnScan = ownNone();
        let i: int = 0;
        for (const a of args) {
            if (i >= keep || exprLocalOf(a) < 0) r = ownJoin(r, ownExpr(a));
            i = i + 1;
        }
        return r;
    }

    // How many leading arguments of a built-in it reads without keeping: each
    // returns a scalar, an element (a part), or a NEW value (runtime.js). Not
    // listed: 0 — an ordinary read (fail closed).
    fn wholeReads(op: PrimOp) -> int {
        if (op == PrimOp.EqStruct || op == PrimOp.NeqStruct || op == PrimOp.TapeConcat) return 2;
        if (op == PrimOp.Length || op == PrimOp.IndexRead || op == PrimOp.AtRead || op == PrimOp.Join || op == PrimOp.TapeIncludes) return 1;
        if (op == PrimOp.IsSome || op == PrimOp.IsNot || op == PrimOp.SortNum || op == PrimOp.SortStr || op == PrimOp.Reverse) return 1;
        if (op == PrimOp.TapeAppend || op == PrimOp.TapePrepend || op == PrimOp.TapeDropEnd || op == PrimOp.TapeDropFront || op == PrimOp.TapeRemoveAt || op == PrimOp.TapeInsert) return 1;   // s477: TapeInsert builds its own tape; LengthCheck returns its argument — an ordinary read (0)
        return 0;
    }

    // `seq.map(f)` …: a bare-local receiver is read without keeping when the op is on
    // the allowlist below AND `f` is a lambda of at most two parameters (element,
    // position); otherwise an ordinary read (the receiver escapes: every write copies).
    fn ownSeq(o: SeqFn, sq: Expr, f: Expr) -> OwnScan {
        const n: int = lambdaArity(f);
        if (seqKeepsNoReceiver(o) && exprLocalOf(sq) >= 0 && n >= 0 && n <= 2) return ownExpr(f);
        return ownJoin(ownExpr(sq), ownExpr(f));
    }

    // s478 (s478-boot-ownership-hardening): the sequence functions PROVEN to keep no
    // reference to their receiver and hand it to no one (with a lambda of at most two
    // parameters, which never binds the host's third `array` argument):
    //   Filter — host `Array.prototype.filter`: a NEW array of the elements; the receiver is not kept
    //   Map    — host `Array.prototype.map`: a NEW array of the lambda's results; the receiver is not kept
    //   Some   — host `Array.prototype.some`: a boolean
    //   Every  — host `Array.prototype.every`: a boolean
    //   SortBy — runtime.js `sortBy`: sorts `copyOf(xs)` and calls the comparator as `cmp(a, b)` (two elements)
    // An op NOT listed here is an ordinary read of its receiver (fail closed): a new
    // SeqFn variant copies on every write of its receiver until it is proven and listed.
    fn receiverSafeSeqs() -> SeqFn[] {
        return [SeqFn.Filter, SeqFn.Map, SeqFn.Some, SeqFn.Every, SeqFn.SortBy];
    }

    fn seqKeepsNoReceiver(o: SeqFn) -> boolean {
        for (const s of receiverSafeSeqs()) {
            if (s == o) return true;
        }
        return false;
    }

    fn lambdaArity(e: Expr) -> int {
        return match e {
            .Lambda(params: ps) :> ps.length,
            .BlockLambda(params: ps) :> ps.length,
            .Lit(lit: x) :> -1,
            .Local(sym: x) :> -1,
            .Read(place: x) :> -1,
            .Call(callee: x) :> -1,
            .FnRef(fn: x) :> -1,
            .CallV(f: x) :> -1,
            .Prim(op: x) :> -1,
            .Match(scrut: x) :> -1,
            .ArrayOf(elems: x) :> -1,
            .StructOf(ty: x) :> -1,
            .VariantOf(enumSym: x) :> -1,
            .Handle(inst: x) :> -1,
            .Assigned(local: x) :> -1,
            .InitOf(decl: x) :> -1,
            .Host(call: x) :> -1,
            .SeqCall(op: x) :> -1,
            .Refetch(req: x) :> -1,
            .Validity(of: x) :> -1,
            .ServerCall(fn: x) :> -1,
            .Query(q: x) :> -1,
            .Foreign(slice: x) :> -1
        };
    }

    // A value no other binding holds: a NEW array or struct each time it is evaluated.
    fn ownFresh(e: Expr) -> boolean {
        return match e {
            .ArrayOf(elems: x) :> true,
            .StructOf(ty: x) :> true,
            .Prim(op: op) :> freshPrim(op),
            .SeqCall(op: o) :> o == SeqFn.Filter || o == SeqFn.Map || o == SeqFn.SortBy,
            .Lit(lit: x) :> false,
            .Local(sym: x) :> false,
            .Read(place: x) :> false,
            .Call(callee: x) :> false,
            .FnRef(fn: x) :> false,
            .CallV(f: x) :> false,
            .Match(scrut: x) :> false,
            .VariantOf(enumSym: x) :> false,
            .Handle(inst: x) :> false,
            .Assigned(local: x) :> false,
            .InitOf(decl: x) :> false,
            .Host(call: x) :> false,
            .Lambda(params: x) :> false,
            .BlockLambda(params: x) :> false,
            .Refetch(req: x) :> false,
            .Validity(of: x) :> false,
            .ServerCall(fn: x) :> false,
            .Query(q: x) :> false,
            .Foreign(slice: x) :> false     // s477: host code may hold what it returns
        };
    }

    // the built-ins whose result is a new tape (runtime.js: each builds its own)
    fn freshPrim(op: PrimOp) -> boolean {
        if (op == PrimOp.TapeAppend || op == PrimOp.TapePrepend || op == PrimOp.TapeDropEnd || op == PrimOp.TapeDropFront || op == PrimOp.TapeRemoveAt || op == PrimOp.TapeInsert) return true;
        return op == PrimOp.TapeConcat || op == PrimOp.SortNum || op == PrimOp.SortStr || op == PrimOp.Reverse;
    }

    // `l = TapeAppend(l, v)` …: the owned writer, and the edit's other arguments
    fn selfEdit(l: Sym, v: Expr) -> SelfEdit | not {
        return match v {
            .Prim(op: op, args: args) :> selfEditOf(l, op, args),
            .Lit(lit: x) :> not,
            .Local(sym: x) :> not,
            .Read(place: x) :> not,
            .Call(callee: x) :> not,
            .FnRef(fn: x) :> not,
            .CallV(f: x) :> not,
            .Match(scrut: x) :> not,
            .ArrayOf(elems: x) :> not,
            .StructOf(ty: x) :> not,
            .VariantOf(enumSym: x) :> not,
            .Handle(inst: x) :> not,
            .Assigned(local: x) :> not,
            .InitOf(decl: x) :> not,
            .Host(call: x) :> not,
            .Lambda(params: x) :> not,
            .BlockLambda(params: x) :> not,
            .SeqCall(op: x) :> not,
            .Refetch(req: x) :> not,
            .Validity(of: x) :> not,
            .ServerCall(fn: x) :> not,
            .Query(q: x) :> not,
            .Foreign(slice: x) :> not
        };
    }

    fn selfEditOf(l: Sym, op: PrimOp, args: Expr[]) -> SelfEdit | not {
        if (args.length == 0) return not;
        if (exprLocalOf(args[0]) != l.id) return not;
        let f: string = "";
        if (op == PrimOp.TapeAppend) f = "tapeAppendOwned";
        if (op == PrimOp.TapePrepend) f = "tapePrependOwned";
        if (op == PrimOp.TapeDropEnd) f = "tapeDropEndOwned";
        if (op == PrimOp.TapeDropFront) f = "tapeDropFrontOwned";
        if (op == PrimOp.TapeRemoveAt) f = "tapeRemoveAtOwned";
        if (f == "") return not;
        return { fn: f, args: args };
    }

    // every local a block mentions — read, part-read or assigned
    fn blockLocals(b: Block) -> int[] {
        let out: int[] = assignedSyms(Node.NBlock(b));
        for (const n of allNodes(Node.NBlock(b))) {
            const id: int = localReadOf(n);
            if (id >= 0) out = out.concat([id]);
        }
        return out;
    }

    // the locals a counted loop's head binds or assigns (printed by forInitJs / assignItems)
    fn headBound(h: LoopHead) -> int[] {
        return match h {
            .Counted(init: i, step: sp) :> headStmtsBound(i.concat(sp)),
            .Forever :> [],
            .While(cond: x) :> [],
            .Each(h: x) :> [],
            .Range(h: x) :> []
        };
    }

    fn headStmtsBound(ss: Stmt[]) -> int[] {
        const b: Block = { stmts: ss };
        let out: int[] = blockLocals(b);
        for (const s of boundSyms(Node.NBlock(b))) { out = out.concat([s.id]); }
        return out;
    }

    fn ownedOf(ctx: Ctx, id: int) -> OwnedLocal | not {
        for (const o of ctx.owned) {
            if (o.id == id) return o;
        }
        return not;
    }

    fn ownFlag(ctx: Ctx, l: Sym) -> string { return symName(ctx, l) + "$own"; }

    // what the owned writer is told: `true` (a `fixed` local always owns its value), else its flag
    fn ownedArg(ctx: Ctx, l: Sym, o: OwnedLocal) -> JsExpr {
        if (o.fixed) return JsExpr.JAnnot(JsExpr.JBool(true), symName(ctx, l) + " alone holds its value");
        return jid(ownFlag(ctx, l));
    }

    // A Let; an owned local that is not `fixed` gets its flag beside it — true when
    // the initializer is fresh.
    fn letStmtsJs(ctx: Ctx, sym: Sym, init: Expr, assigned: int[]) -> JsStmt[] {
        const one: JsStmt = letJs(ctx, sym, init, assigned);
        const o: OwnedLocal | not = ownedOf(ctx, sym.id);
        if (o is given && !o.fixed) return [one, JsStmt.SLet(ownFlag(ctx, sym), JsExpr.JBool(ownFresh(init)))];
        return [one];
    }

    // An Assign. An owned local's edit or part write goes through the runtime's
    // owned writer (in place when owned, else the copy — whose result it then owns);
    // a rebinding of a flagged local sets its flag to whether the new value is fresh.
    fn assignStmtsJs(ctx: Ctx, l: Sym, v: Expr, path: PathStep[]) -> JsStmt[] {
        const name: string = symName(ctx, l);
        const o: OwnedLocal | not = ownedOf(ctx, l.id);
        if (o is not) return [JsStmt.SAssign(jid(name), assignedJs(ctx, l, v, path))];
        const own: JsExpr = ownedArg(ctx, l, o);
        const se: SelfEdit | not = selfEdit(l, v);
        let value: JsExpr = exprJs(ctx, v);
        let owns: boolean = ownFresh(v);
        if (path.length > 0) {
            value = rtCall(ctx, "writePathOwned", [own, jid(name), pathStepsJs(ctx, path), exprJs(ctx, v), jstr(pathLoc(path))]);
            owns = true;
        } else if (se is given) {
            value = rtCall(ctx, se.fn, [own].concat(exprsJs(ctx, se.args)));
            owns = true;
        }
        const out: JsStmt[] = [JsStmt.SAssign(jid(name), value)];
        if (o.fixed) return out;
        return out.concat([JsStmt.SAssign(jid(ownFlag(ctx, l)), JsExpr.JBool(owns))]);
    }

    fn withOwned(ctx: Ctx, owned: OwnedLocal[]) -> Ctx {
        return { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared,
                 rows: ctx.rows, slot: ctx.slot, prebuilt: ctx.prebuilt, ret: ctx.ret, server: ctx.server, tier0: ctx.tier0, cycles: ctx.cycles, ns: ctx.ns, owned: owned };
    }

    fn pathStepJs(ctx: Ctx, st: PathStep) -> JsExpr {
        return match st {
            .StepField(ref: r) :> jstr(memberName(ctx, r.owner, r.idx)),
            .StepIndex(index: ix) :> exprJs(ctx, ix)
        };
    }

    fn pathStepLoc(st: PathStep) -> string {
        return match st {
            .StepField(ref: r) :> "",
            .StepIndex(index: ix, loc: lc) :> lc
        };
    }

    fn forInit(isLet: boolean, items: JsProp[]) -> JsForInit { return { isLet: isLet, items: items }; }

    // A Counted head's `init`: its Lets (`let a = v, …`) or its Assigns (`a = v, …`) — C19.
    fn forInitJs(ctx: Ctx, ss: Stmt[]) -> JsForInit {
        let isLet = false;
        for (const s of ss) {
            if (stmtIsLet(s)) isLet = true;
        }
        return forInit(isLet, assignItems(ctx, ss));
    }

    fn assignItems(ctx: Ctx, ss: Stmt[]) -> JsProp[] {
        let out: JsProp[] = [];
        for (const s of ss) { out = out.concat(assignItem(ctx, s)); }
        return out;
    }

    fn assignItem(ctx: Ctx, s: Stmt) -> JsProp[] {
        return match s {
            .Let(sym: sym, init: init) :> [jsProp(symName(ctx, sym), exprJs(ctx, init))],
            .Assign(local: l, value: v, path: pa) :> [jsProp(symName(ctx, l), assignedJs(ctx, l, v, pa))],
            .Write(cap: x) :> [],
            .Commit(writes: x) :> [],
            .If(cond: x) :> [],
            .Return(e: x) :> [],
            .Eval(e: x) :> [],
            .Suspend(bind: x) :> [],
            .ResetSurface(of: x) :> [],
            .Defer(body: x) :> [],
            .Unpersist(decl: x) :> [],
            .Attempt(result: x) :> [],
            .Fail(err: x) :> [],
            .Join(k: x) :> [],
            .Jump(k: x) :> [],
            .Loop(label: x) :> [],
            .Break(target: x) :> [],
            .Continue(target: x) :> [],
            .Gather(g: x) :> [],
            .Lift(into: x) :> [],
            .LocalFn(f: x) :> []
        };
    }

    fn stmtIsLet(s: Stmt) -> boolean {
        return match s {
            .Let(sym: x) :> true,
            .Assign(local: x) :> false,
            .Write(cap: x) :> false,
            .Commit(writes: x) :> false,
            .If(cond: x) :> false,
            .Return(e: x) :> false,
            .Eval(e: x) :> false,
            .Suspend(bind: x) :> false,
            .ResetSurface(of: x) :> false,
            .Defer(body: x) :> false,
            .Unpersist(decl: x) :> false,
            .Attempt(result: x) :> false,
            .Fail(err: x) :> false,
            .Join(k: x) :> false,
            .Jump(k: x) :> false,
            .Loop(label: x) :> false,
            .Break(target: x) :> false,
            .Continue(target: x) :> false,
            .Gather(g: x) :> false,
            .Lift(into: x) :> false,
            .LocalFn(f: x) :> false
        };
    }

    // `for (let i = lo, end = hi; i < end; i = i + 1)` (`<=` when inclusive);
    // with a `let` binder the counter is the loop's own and the binder a copy.
    fn rangeJs(ctx: Ctx, ln: string, rh: RangeHead, body: Block) -> JsStmt {
        let iv: Sym = rh.bind;
        let pre: JsStmt[] = [];
        const counter: Sym | not = rh.counter;
        if (counter is given) {
            iv = counter;
            pre = [JsStmt.SLet(symName(ctx, rh.bind), jid(symName(ctx, counter)))];
        }
        const i: string = symName(ctx, iv);
        const e: string = symName(ctx, rh.end);
        let op: JsOp = JsOp.Lt;
        if (rh.inclusive) op = JsOp.Le;
        const init: JsForInit = forInit(true, [jsProp(i, exprJs(ctx, rh.lo)), jsProp(e, exprJs(ctx, rh.hi))]);
        const step: JsProp[] = [jsProp(i, JsExpr.JBin(JsOp.Plus, jid(i), jnum(1)))];
        return JsStmt.SLoop(ln, JsLoopHead.JForC(init, JsExpr.JBin(op, jid(i), jid(e)), step), pre.concat(blockJs(ctx, body)));
    }

    // Does a Break / Continue in `body` name the loop `label`?
    fn loopIsJumped(label: Sym, body: Block) -> boolean {
        for (const n of allNodes(Node.NBlock(body))) {
            if (jumpTargetOf(n) == label.id) return true;
        }
        return false;
    }

    fn jumpTargetOf(n: Node) -> int {
        return match n {
            .NStmt(s: s) :> stmtJumpTarget(s),
            .NProgram(p: x) :> -1,
            .NDecl(d: x) :> -1,
            .NField(f: x) :> -1,
            .NFn(f: x) :> -1,
            .NServerFn(f: x) :> -1,
            .NBlock(b: x) :> -1,
            .NExpr(e: x) :> -1,
            .NPlace(pl: x) :> -1,
            .NInst(i: x) :> -1,
            .NPattern(pat: x) :> -1,
            .NEdit(k: x) :> -1,
            .NView(v: x) :> -1,
            .NAttr(a: x) :> -1
        };
    }

    fn stmtJumpTarget(s: Stmt) -> int {
        return match s {
            .Break(target: t) :> t.id,
            .Continue(target: t) :> t.id,
            .Gather(g: x) :> -1,
            .Lift(into: x) :> -1,
            .LocalFn(f: x) :> -1,
            .Loop(label: x) :> -1,
            .Let(sym: x) :> -1,
            .Assign(local: x) :> -1,
            .Write(cap: x) :> -1,
            .Commit(writes: x) :> -1,
            .If(cond: x) :> -1,
            .Return(e: x) :> -1,
            .Eval(e: x) :> -1,
            .Suspend(bind: x) :> -1,
            .ResetSurface(of: x) :> -1,
            .Defer(body: x) :> -1,
            .Unpersist(decl: x) :> -1,
            .Attempt(result: x) :> -1,
            .Fail(err: x) :> -1,
            .Join(k: x) :> -1,
            .Jump(k: x) :> -1
        };
    }

    // s454 (U1b) — `return v`. In a WAITING function (ctx.ret is its resolve
    // function) the value settles the function's Promise: `return ret$(v);` —
    // also from inside a continuation, where a plain `return` would only leave
    // the continuation.
    fn returnJs(ctx: Ctx, v: JsExpr) -> JsStmt {
        if (ctx.ret == "") return JsStmt.SReturn(v);
        return JsStmt.SReturn(jcall(jid(ctx.ret), [v]));
    }

    // -------------------------------------------------------------------------
    // s451 (Ue) — the error model (§19). A failure is a runtime-private
    // `Failure` object around the error value (`rt.failure(e)`); `rt.failed(r)`
    // tells it apart from ANY success value (no scrml value is one). An
    // Attempt binds the call's raw result to `ok.bind`:
    //   let result;                       // only when the Attempt has one
    //   const v = f(…);
    //   if (rt.failed(v)) { if (<arm 1 test on v.error>) { … } else … }
    //   else { <ok body>; result = <ok value>; }
    // A wildcard arm needs no test. Every variant arm is tested, the last one
    // too: the arms are total over the Attempt's enum (check.scrml C-E2), so
    // the fall-through after the last variant arm is unreachable. It prints
    // as `rt.unmatchedFailure(v.error, "<Enum>")`, which throws. s474 (defence
    // in depth, ruling user-voice-scrml.md S474 "⭐ RULED — `else` on a
    // failable match", PERMANENT security): a failure no arm names fails
    // CLOSED. It never runs another arm's body, and never a `match`'s `else`,
    // which lower.scrml errArms puts in the success branch only. The patterns
    // test `v.error` (the raw result's local is a minted, unique name), so an
    // Attempt nested in an arm never collides.
    // -------------------------------------------------------------------------
    fn attemptJs(ctx: Ctx, result: Sym | not, call: Failable, err: Sym, ok: OkArm, arms: ErrArm[], assigned: int[]) -> JsStmt[] {
        let out: JsStmt[] = [];
        if (result is given) out = out.concat([JsStmt.SDecl(symName(ctx, result))]);
        const raw: string = symName(ctx, ok.bind);
        out = out.concat([JsStmt.SConst(raw, failableJs(ctx, call))]);
        const errB: JsStmt[] = errArmsJs(ctx, jmember(jid(raw), "error"), err, arms, 0, result);
        const okB: JsStmt[] = blockJs(ctx, ok.body).concat(resultJs(ctx, result, ok.value));
        return out.concat([JsStmt.SIf(rtCall(ctx, "failed", [jid(raw)]), errB, okB)]);
    }

    fn failableJs(ctx: Ctx, c: Failable) -> JsExpr {
        return match c {
            .FCall(fn: f, args: args) :> jcall(jid(symName(ctx, f)), exprsJs(ctx, args)),
            .FSettled(outcome: o) :> localRead(ctx, o),   // s454 (U1b): the Suspend's settled outcome
            // s478 (s478-ruled-stdlib-data) — the §41.13 `parseVariant` intrinsic: `rt.parseVariant(<the
            // enum's §57 table>, <the ParseError table>, json)` — the decoded value, or `rt.failure(e)`
            // with `e` a value of the error enum (slice-m1/runtime/runtime.js parseVariant).
            .FParse(json: j, en: en, err: er) :> rtCall(ctx, "parseVariant", [wireOrNull(ctx.p, Type.Named(en)), wireOrNull(ctx.p, Type.Named(er)), exprJs(ctx, j)]),
            .FCallV(f: f, args: args) :> jcall(exprJs(ctx, f), exprsJs(ctx, args))   // s478-ruled-fn-types: a call through a failable function value
        };
    }

    fn errArmsJs(ctx: Ctx, err: JsExpr, en: Sym, arms: ErrArm[], i: int, result: Sym | not) -> JsStmt[] {
        if (i >= arms.length) return [sexpr(rtCall(ctx, "unmatchedFailure", [err, jstr(en.hint)]))];
        const a: ErrArm = arms[i];
        const body: JsStmt[] = wholeBind(ctx, a.whole, err).concat(patBinds(ctx, a.pat, err)).concat(blockJs(ctx, a.body)).concat(resultJs(ctx, result, a.value));
        if (isWildPat(a.pat)) return body;
        return [JsStmt.SIf(patTest(ctx, a.pat, err), body, errArmsJs(ctx, err, en, arms, i + 1, result))];
    }

    // s452 — the whole-error binder (`| _ err :>`, §18.6.1): the arm's local
    // holds the error value itself — the enum value, variant and payload.
    fn wholeBind(ctx: Ctx, whole: Sym | not, err: JsExpr) -> JsStmt[] {
        if (whole is not) return [];
        return [JsStmt.SConst(symName(ctx, whole), err)];
    }

    fn isWildPat(p: Pattern) -> boolean {
        return match p {
            .PWild :> true,
            .PVariant :> false,
            .PLit :> false,
            .PAlt :> false
        };
    }

    // s452 r2: a branch with a value never holds a `defer` (analyze refuses a
    // `defer` directly in a value-position arm — E-DEFER-UNSUPPORTED-SITE,
    // §19.16.2), so its block is never wrapped in a `try` and the result
    // assignment after it reads the block's locals in the same JS block.
    fn resultJs(ctx: Ctx, result: Sym | not, v: Expr | not) -> JsStmt[] {
        if (result is not) return [];
        if (v is not) return [];
        return [JsStmt.SAssign(jid(symName(ctx, result)), exprJs(ctx, v))];
    }

    // An enum value as the runtime holds it (THE ENUM VALUE SHAPE, above):
    // a nullary variant is its name; a payload variant `{ variant, data: […] }`.
    fn variantValueJs(ctx: Ctx, es: Sym, idx: int, args: Expr[]) -> JsExpr {
        const tag: JsExpr = jstr(variantTag(ctx, es, idx));
        if (!variantHasFields(ctx, es, idx)) return tag;
        let vals: JsExpr[] = [];
        let j = 0;
        for (const a of args) {
            vals = vals.concat([JsExpr.JAnnot(exprJs(ctx, a), variantFieldName(ctx, es, idx, j))]);
            j = j + 1;
        }
        return JsExpr.JObject([{ key: "variant", value: tag }, { key: "data", value: JsExpr.JArray(vals) }]);
    }

    // s449 — `rt.suspend(task$, <on>, (x) => { <then> })`: the CPS split
    // (§19.9.8). The continuation never runs if the effect that owns `task$`
    // was re-run (newest run wins) or torn down while the value was pending.
    // C12 puts a Suspend only at the tail of an effect body, whose arrow binds
    // `task$`.
    fn suspendJs(ctx: Ctx, b: Sym, on: Expr, t: Block) -> JsStmt {
        return sexpr(rtCall(ctx, "suspend", [jid("task$"), exprJs(ctx, on), JsExpr.JArrow([symName(ctx, b)], blockJs(ctx, t))]));
    }

    fn letJs(ctx: Ctx, sym: Sym, init: Expr, assigned: int[]) -> JsStmt {
        if (hasInt(assigned, sym.id)) return JsStmt.SLet(symName(ctx, sym), exprJs(ctx, init));
        // s474 — a keyed Tier-0 loop's iteration key (§17.4b): `rt.loopKey(v)`
        const t0: Tier0Rows | not = ctx.tier0;
        if (t0 is given && t0.keyId == sym.id) return JsStmt.SConst(symName(ctx, sym), rtCall(ctx, "loopKey", [exprJs(ctx, init)]));
        return JsStmt.SConst(symName(ctx, sym), exprJs(ctx, init));
    }

    fn elseJs(ctx: Ctx, e: Block | not) -> JsStmt[] {
        if (e is not) return [];
        return blockJs(ctx, e);
    }

    // A write through a capability: the capability names the declaration and
    // field; the instance reference says which instance's signal is set.
    fn writeJs(ctx: Ctx, cap: Sym, inst: InstRef, edit: EditKind, value: Expr, check: Check) -> JsStmt {
        const owner: CapOwner | not = capOwner(ctx.p, cap);
        if (owner is not) return sexpr(jid("danglingWriteCapability$" + cap.id));
        const target: JsExpr = fieldCell(instJs(ctx, inst), owner.decl, owner.idx);
        const v: JsExpr = guardedWriteJs(ctx, target, owner, edit, value, check);
        return sexpr(editJs(ctx, target, owner, edit, v, check));
    }

    // s483 (Q21 lane 2) — a lone write whose value passes through its declaration-invariant
    // check (an InvariantGuard) and whose field contract is ALSO checked at run time (a
    // RuntimeEdge transition, a RuntimeLength edit): the contract is judged first (§66.13.5
    // evaluation order — the field's own contract, then the invariants): the guard calls the
    // `pre` it is given with the write's value before it judges the candidate. The write
    // itself re-checks its contract afterwards, on the same state (nothing ran in between).
    fn guardedWriteJs(ctx: Ctx, target: JsExpr, owner: CapOwner, edit: EditKind, value: Expr, check: Check) -> JsExpr {
        const args: Expr[] | not = invGuardArgs(value);
        if (args is not) return exprJs(ctx, value);
        const pre: JsExpr | not = contractFirstJs(ctx, target, owner, edit, check);
        if (pre is not) return exprJs(ctx, value);
        return rtCall(ctx, "invariantGuard", exprsJs(ctx, args).concat([pre]));
    }

    fn invGuardArgs(e: Expr) -> Expr[] | not {
        return match e {
            .Prim(op: o, args: a) :> invGuardOp(o, a),
            // no-default-arm: one question of a write's value — is it an InvariantGuard primitive
            _ :> not
        };
    }

    fn invGuardOp(o: PrimOp, a: Expr[]) -> Expr[] | not {
        if (o == PrimOp.InvariantGuard) return a;
        return not;
    }

    fn contractFirstJs(ctx: Ctx, target: JsExpr, owner: CapOwner, edit: EditKind, check: Check) -> JsExpr | not {
        if (isTransitionEdit(edit) && isRuntimeEdge(check)) return rtCall(ctx, "edgeFirst", [target, jid(nameOf(ctx.names, NameKey.Edges(owner.decl.sym.id, owner.idx)))]);
        return match check {
            .RuntimeLength(min: a, max: b, loc: l) :> lengthFirstJs(ctx, target, edit, a, b, l),
            .Static :> not,
            .RuntimeEdge :> not
        };
    }

    fn lengthFirstJs(ctx: Ctx, target: JsExpr, edit: EditKind, a: int, b: int, l: string) -> JsExpr | not {
        if (edit == EditKind.Append || edit == EditKind.Prepend) return rtCall(ctx, "lengthFirst", [target, jnum(1), jnum(a), jnum(b), jstr(l)]);
        if (edit == EditKind.RemoveEnd || edit == EditKind.RemoveFront) return rtCall(ctx, "lengthFirst", [target, jnum(-1), jnum(a), jnum(b), jstr(l)]);
        return not;
    }

    // An all-or-nothing group of writes (Stmt.Commit, RULED S440): first every
    // runtime contract check (a RuntimeEdge transition's edge), then every
    // write. A refused check throws before anything is written. Each write's
    // edge is already proven by then, so it is emitted as a Static write.
    // The values are Locals (check.scrml C7): reading one twice is free.
    // The writes run inside ONE `rt.batch`: a `.set` outside a batch flushes
    // its observers synchronously (a Commit reached from a render hole or an
    // effect runs at batch depth 0), and an observer running between two
    // writes would see — and could act on — the half-applied value. In the
    // batch, observers run once, after the last write. The checks stay OUTSIDE
    // the batch: they are pure reads (`peek`), nothing can run between them and
    // the batch, and a refusal throws before any batch bookkeeping begins.
    // s483 (Q21 lane 2) — a Commit's declaration-invariant checks (its InvariantGuard
    // Evals, check.scrml C7) run after every write's own contract check and before the
    // batch: the §66.13.5 order — each field's contract, then the invariants on the
    // candidate, then the writes.
    fn commitJs(ctx: Ctx, ws: Stmt[]) -> JsStmt[] {
        let checks: JsStmt[] = [];
        let invs: JsStmt[] = [];
        let writes: JsStmt[] = [];
        let k: int = 0;
        for (const s of ws) {
            checks = checks.concat(commitCheckJs(ctx, s)).concat(commitLengthJs(ctx, ws, k));
            invs = invs.concat(commitInvJs(ctx, s));
            writes = writes.concat(commitWriteJs(ctx, s));
            k = k + 1;
        }
        return checks.concat(invs).concat([sexpr(rtCall(ctx, "batch", [JsExpr.JArrow([], writes)]))]);
    }

    fn commitInvJs(ctx: Ctx, s: Stmt) -> JsStmt[] {
        return match s {
            .Eval(e: e) :> [sexpr(exprJs(ctx, e))],
            // no-default-arm: one question of a Commit member — is it its invariant check (an Eval); every Write is printed by commitWriteJs
            _ :> []
        };
    }

    fn commitCheckJs(ctx: Ctx, s: Stmt) -> JsStmt[] {
        return match s {
            .Write(cap: cap, inst: inst, edit: edit, value: v, check: ck) :> edgeCheckJs(ctx, cap, inst, edit, v, ck),
            .Commit :> [],
            .Let :> [],
            .Assign :> [],
            .If :> [],
            .Return :> [],
            .Eval :> [],
            .Suspend :> [],
            .ResetSurface :> [],
            .Defer :> [],
            .Unpersist :> [],
            .Attempt :> [],
            .Fail :> [],
            .Join :> [],
            .Jump :> [],
            .Loop :> [],
            .Break :> [],
            .Continue :> [],
            .Gather :> [],
            .Lift :> [],
            .LocalFn :> []
        };
    }

    // s477 — the bound check of write `k` of a Commit (RuntimeLength), counting the
    // length changes of the writes before it to the same capability
    fn commitLengthJs(ctx: Ctx, ws: Stmt[], k: int) -> JsStmt[] {
        const w: Stmt = ws[k];
        return match w {
            .Write(cap: cap, inst: inst, edit: edit, value: v, check: ck) :> lengthGuardJs(ctx, cap, inst, commitDelta(ws, k, cap, inst), ck),
            .Commit :> [],
            .Let :> [],
            .Assign :> [],
            .If :> [],
            .Return :> [],
            .Eval :> [],
            .Suspend :> [],
            .ResetSurface :> [],
            .Defer :> [],
            .Unpersist :> [],
            .Attempt :> [],
            .Fail :> [],
            .Join :> [],
            .Jump :> [],
            .Loop :> [],
            .Break :> [],
            .Continue :> [],
            .Gather :> [],
            .Lift :> [],
            .LocalFn :> []
        };
    }

    // s477 r1 (review S1): the delta counts the writes to the same capability ON THE SAME
    // instance only — a Commit's writes all name one instance today (lower's editStmts /
    // spreadStmts), but two instances' fields are two tapes, so the sum keys on both.
    fn commitDelta(ws: Stmt[], k: int, cap: Sym, inst: InstRef) -> int {
        let d: int = 0;
        let i: int = 0;
        for (; i <= k; ) {
            d = d + writeDeltaFor(ws[i], cap, inst);
            i = i + 1;
        }
        return d;
    }

    fn writeDeltaFor(s: Stmt, cap: Sym, inst: InstRef) -> int {
        return match s {
            .Write(cap: c, inst: i, edit: edit, value: v) :> capDelta(c, cap, i, inst, edit, v),
            .Commit :> 0,
            .Let :> 0,
            .Assign :> 0,
            .If :> 0,
            .Return :> 0,
            .Eval :> 0,
            .Suspend :> 0,
            .ResetSurface :> 0,
            .Defer :> 0,
            .Unpersist :> 0,
            .Attempt :> 0,
            .Fail :> 0,
            .Join :> 0,
            .Jump :> 0,
            .Loop :> 0,
            .Break :> 0,
            .Continue :> 0,
            .Gather :> 0,
            .Lift :> 0,
            .LocalFn :> 0
        };
    }

    fn capDelta(c: Sym, cap: Sym, i: InstRef, inst: InstRef, edit: EditKind, v: Expr) -> int {
        if (c.id != cap.id) return 0;
        if (commitInstKey(i) != commitInstKey(inst)) return 0;
        return editDelta(edit, v);
    }

    // Two instance references name the same instance iff they are spelled the same
    // (lower.scrml instKey's reading).
    fn commitInstKey(i: InstRef) -> string {
        return match i {
            .Shared(decl: d) :> "S" + d.id,
            .Lexical(depth: k) :> "L" + k,
            .Alias(sym: s) :> "A" + s.id,
            .Narrowed(sym: s) :> "N" + s.id,
            .Kid(of: o, idx: k) :> "K(" + commitInstKey(o) + "," + k + ")",
            .HandleOf(of: o, sym: s) :> "H(" + commitInstKey(o) + "," + s.id + ")"
        };
    }

    fn commitWriteJs(ctx: Ctx, s: Stmt) -> JsStmt[] {
        return match s {
            .Write(cap: cap, inst: inst, edit: edit, value: v) :> [writeJs(ctx, cap, inst, edit, v, Check.Static)],
            .Commit :> [],
            .Let :> [],
            .Assign :> [],
            .If :> [],
            .Return :> [],
            .Eval :> [],
            .Suspend :> [],
            .ResetSurface :> [],
            .Defer :> [],
            .Unpersist :> [],
            .Attempt :> [],
            .Fail :> [],
            .Join :> [],
            .Jump :> [],
            .Loop :> [],
            .Break :> [],
            .Continue :> [],
            .Gather :> [],
            .Lift :> [],
            .LocalFn :> []
        };
    }

    // The edge check alone (no write) for a RuntimeEdge transition; nothing
    // for a write the Core already proves.
    fn edgeCheckJs(ctx: Ctx, cap: Sym, inst: InstRef, edit: EditKind, value: Expr, check: Check) -> JsStmt[] {
        if (!isTransitionEdit(edit) || !isRuntimeEdge(check)) return [];
        const owner: CapOwner | not = capOwner(ctx.p, cap);
        if (owner is not) return [sexpr(jid("danglingWriteCapability$" + cap.id))];
        const target: JsExpr = fieldCell(instJs(ctx, inst), owner.decl, owner.idx);
        const edges: JsExpr = jid(nameOf(ctx.names, NameKey.Edges(owner.decl.sym.id, owner.idx)));
        return [sexpr(rtCall(ctx, "checkEdge", [target, edges, exprJs(ctx, value)]))];
    }

    fn isTransitionEdit(k: EditKind) -> boolean {
        return match k {
            .Transition :> true,
            .Replace :> false,
            .Append :> false,
            .Prepend :> false,
            .Anywhere :> false,
            .PositionWrite :> false,
            .FieldAt :> false,
            .RemoveEnd :> false,
            .RemoveFront :> false,
            .RemoveAnywhere :> false,
            .ElemAt(index: x) :> false,
            .PositionAt(index: x) :> false
        };
    }

    fn isRuntimeEdge(c: Check) -> boolean {
        return match c {
            .RuntimeEdge :> true,
            .Static :> false,
            .RuntimeLength(min: a) :> false
        };
    }

    fn editJs(ctx: Ctx, target: JsExpr, owner: CapOwner, edit: EditKind, v: JsExpr, check: Check) -> JsExpr {
        return match edit {
            .Replace :> jmcall(target, "set", [v]),
            .Append :> lengthEditJs(ctx, "append", "appendWithin", target, v, check),
            .Prepend :> lengthEditJs(ctx, "prepend", "prependWithin", target, v, check),
            .Anywhere :> jmcall(target, "set", [v]),
            .PositionWrite :> jmcall(target, "set", [v]),
            .FieldAt(path: path) :> rtCall(ctx, "setIn", [target, fieldPathJs(ctx, path), v]),
            .Transition :> transitionJs(ctx, target, owner, v, check),
            .RemoveEnd :> lengthEditJs(ctx, "removeEnd", "removeEndWithin", target, v, check),
            .RemoveFront :> lengthEditJs(ctx, "removeFront", "removeFrontWithin", target, v, check),
            .RemoveAnywhere :> jmcall(target, "set", [v]),
            // s473: `@xs[i].f = v` — the element field, or the E-INDEX-OUT-OF-RANGE-RT trap (nothing written)
            .ElemAt(index: ix, path: path, loc: loc) :> rtCall(ctx, "setAt", [target, exprJs(ctx, ix), fieldPathJs(ctx, path), v, jstr(loc)]),
            // s472: `@xs[i] = v` — the element at `i`, or the E-INDEX-OUT-OF-RANGE-RT trap (nothing written)
            .PositionAt(index: ix, loc: loc) :> rtCall(ctx, "setPosition", [target, exprJs(ctx, ix), v, jstr(loc)])
        };
    }

    fn fieldPathJs(ctx: Ctx, path: FieldRef[]) -> JsExpr {
        let out: JsExpr[] = [];
        for (const r of path) { out = out.concat([jstr(memberName(ctx, r.owner, r.idx))]); }
        return JsExpr.JArray(out);
    }

    fn transitionJs(ctx: Ctx, target: JsExpr, owner: CapOwner, v: JsExpr, check: Check) -> JsExpr {
        return match check {
            .Static :> jmcall(target, "set", [v]),
            .RuntimeEdge :> rtCall(ctx, "transition", [target, jid(nameOf(ctx.names, NameKey.Edges(owner.decl.sym.id, owner.idx))), v]),
            .RuntimeLength(min: a) :> jmcall(target, "set", [v])        // never on a transition (check.scrml C6)
        };
    }

    // s477 (O36 RULED S477) — a length-changing edit of a cell whose tape type bounds
    // its length (`T[min..=max, …]`): with a RuntimeLength check the bound is checked
    // before the write (`rt.appendWithin` …; the E-WRITE-INVARIANT-RT trap, nothing
    // written); Static — proven — the plain edit, no check.
    fn lengthEditJs(ctx: Ctx, plain: string, within: string, target: JsExpr, v: JsExpr, check: Check) -> JsExpr {
        return match check {
            .RuntimeLength(min: a, max: b, loc: l) :> rtCall(ctx, within, [target, v, jnum(a), jnum(b), jstr(l)]),
            .Static :> rtCall(ctx, plain, [target, v]),
            .RuntimeEdge :> rtCall(ctx, plain, [target, v])
        };
    }

    // s477 — in a Commit, every RuntimeLength write's bound is checked before ANY write
    // (all-or-nothing, RULED S440): the length the commit leaves after this write —
    // `delta` counts this and every earlier length-changing write of the same capability.
    fn lengthGuardJs(ctx: Ctx, cap: Sym, inst: InstRef, delta: int, check: Check) -> JsStmt[] {
        return match check {
            .RuntimeLength(min: a, max: b, loc: l) :> lengthGuardOf(ctx, cap, inst, delta, a, b, l),
            .Static :> [],
            .RuntimeEdge :> []
        };
    }

    fn lengthGuardOf(ctx: Ctx, cap: Sym, inst: InstRef, delta: int, a: int, b: int, l: string) -> JsStmt[] {
        const owner: CapOwner | not = capOwner(ctx.p, cap);
        if (owner is not) return [sexpr(jid("danglingWriteCapability$" + cap.id))];
        const target: JsExpr = fieldCell(instJs(ctx, inst), owner.decl, owner.idx);
        return [sexpr(rtCall(ctx, "lengthGuard", [target, jnum(delta), jnum(a), jnum(b), jstr(l)]))];
    }

    // the length change of one edit in a Commit: +1 an append / prepend, -n a removal of n
    fn editDelta(edit: EditKind, value: Expr) -> int {
        if (edit == EditKind.Append || edit == EditKind.Prepend) return 1;
        if (edit == EditKind.RemoveEnd || edit == EditKind.RemoveFront) {
            return 0 - removedCount(value);
        }
        return 0;
    }

    // the count a RemoveEnd / RemoveFront removes: its Int literal (check.scrml: >= 1)
    fn removedCount(e: Expr) -> int {
        return match e {
            .Lit(lit: l) :> intLitValue(l),
            .Handle(inst: x) :> 1,
            .Assigned(local: x) :> 1,
            .InitOf(decl: x) :> 1,
            .Local(sym: x) :> 1,
            .Read(place: x) :> 1,
            .Call(callee: x) :> 1,
            .FnRef(fn: x) :> 1,
            .CallV(f: x) :> 1,
            .Prim(op: x) :> 1,
            .Match(scrut: x) :> 1,
            .ArrayOf(elems: x) :> 1,
            .StructOf(ty: x) :> 1,
            .VariantOf(enumSym: x) :> 1,
            .Host(call: x) :> 1,
            .Lambda(params: x) :> 1,
            .BlockLambda(params: x) :> 1,
            .SeqCall(op: x) :> 1,
            .Refetch(req: rf0) :> 1,
            .Validity(of: x) :> 1,
            .ServerCall(fn: x) :> 1,
            .Query(q: x) :> 1,
            .Foreign(slice: x) :> 1
        };
    }

    fn intLitValue(l: Literal) -> int {
        return match l {
            .Int(v: n) :> n,
            .Num(v: x) :> 1,
            .Str(v: x) :> 1,
            .Bool(v: x) :> 1,
            .Variant(enumSym: x) :> 1,
            .Absent :> 1
        };
    }

    // -------------------------------------------------------------------------
    // Views → template HNodes + holes.
    // -------------------------------------------------------------------------
    fn emptyBuilt() -> Built { return { nodes: [], holes: [] }; }

    fn joinBuilt(a: Built, b: Built) -> Built {
        return { nodes: a.nodes.concat(b.nodes), holes: a.holes.concat(b.holes) };
    }

    // s474: `ns` — the parse context `views` sit in (their parent's children's context)
    fn buildNodes(ctx: Ctx, views: View[], base: int[], ns: string) -> Built {
        let out: Built = emptyBuilt();
        let i = 0;
        for (const v of views) {
            out = joinBuilt(out, buildNode(ctx, v, base.concat([i]), ns));
            i = i + 1;
        }
        return out;
    }

    fn hole(n: HNode, path: int[], v: View, ns: string) -> Built {
        return { nodes: [n], holes: [{ path: path, v: v, ns: ns }] };
    }

    fn textBuilt(t: string) -> Built { return { nodes: [HNode.HText(t)], holes: [] }; }

    // s482 (s482-meta-runtime) — a runtime `^{}` block's PLACE: the element its `meta.emit`
    // output goes into (impl#1's placeholder, the one the verbatim gate looks up by its
    // `data-scrml-meta` id and whose `<form>` ancestry it judges, §22.12). A `span`, as
    // impl#1's (the gate parses emitted markup as that element's content). Body-top
    // statements render no DOM (a comment keeps the child-index paths positional).
    fn runHole(meta: string, path: int[], v: View, ns: string) -> Built {
        if (meta == "") return hole(HNode.HComment("run"), path, v, ns);
        return hole(HNode.HElem("span", [{ name: "data-scrml-meta", value: meta }], []), path, v, ns);
    }

    // s468 — a raw-content body's text (SPEC §4.17): `<` / `>` encoded, `&` kept.
    fn rawTextBuilt(t: string) -> Built { return { nodes: [HNode.HRawText(t)], holes: [] }; }

    fn buildNode(ctx: Ctx, v: View, path: int[], ns: string) -> Built {
        return match v {
            .El(tag: tag, attrs: attrs, kids: ks) :> buildEl(ctx, v, tag, attrs, ks, path, ns),
            .Text(text: t) :> textBuilt(t),
            .RawText(text: t) :> rawTextBuilt(t),
            .Dyn :> hole(HNode.HComment(""), path, v, ns),
            .Cond :> hole(HNode.HComment("if"), path, v, ns),
            .Each :> hole(HNode.HComment("each"), path, v, ns),
            .Instance(decl: d) :> hole(HNode.HComment(d.hint), path, v, ns),
            .Slot :> hole(HNode.HComment("slot"), path, v, ns),
            .Star(decl: d) :> hole(HNode.HComment("*" + d.hint), path, v, ns),
            // s449: an `<effect>` renders no DOM; its comment keeps child-index paths positional
            .Effect :> hole(HNode.HComment("effect"), path, v, ns),
            .Run(meta: mt) :> runHole(mt, path, v, ns),          // s478: body-top statements render no DOM; s482: a runtime `^{}` its placeholder
            .Init :> hole(HNode.HComment("init"), path, v, ns),        // s481: never reached — bodyInits rewrites every Init first
            // s475: a request renders no DOM either (its signals are read where the author reads them)
            .Request :> hole(HNode.HComment("request"), path, v, ns),
            .ResetOn :> hole(HNode.HComment("reset-on"), path, v, ns),
            .Errors :> hole(HNode.HComment("errors"), path, v, ns),
            .Reach :> hole(HNode.HComment("reach"), path, v, ns),
            .Gather :> hole(HNode.HComment("for"), path, v, ns)       // s469 (§17.4)
        };
    }

    fn buildEl(ctx: Ctx, v: View, tag: string, attrs: Attr[], ks: View[], path: int[], ns: string) -> Built {
        // s482: the content of a raw-text / RCDATA element holding a `${}` is one text value, set on the
        // element itself (wireHole → textContentJs): the element is printed empty and is its own hole
        if (textContentKids(ns, tag, ks) is given) {
            return { nodes: [HNode.HElem(tag, staticAttrs(attrs), [])], holes: [{ path: path, v: v, ns: ns }] };
        }
        let kids: View[] = ks;
        if (isHtmlInNs(ns, tag.toLowerCase()) && dropsLeadingLf(tag)) kids = cutLeadingNewline(ks);
        const inner: Built = buildNodes(ctx, kids, path, elChildNs(ns, tag, attrs));
        const node: HNode = HNode.HElem(tag, staticAttrs(attrs), inner.nodes);
        if (hasWiredAttr(attrs)) return { nodes: [node], holes: [{ path: path, v: v, ns: ns }].concat(inner.holes) };
        return { nodes: [node], holes: inner.holes };
    }

    // s474 r3 (re-review of #1727, S1 / S2; PA: match HTML and base). The HTML parser drops ONE line ending
    // (LF, CRLF or a lone CR — normalized to LF first) right after a `<pre>` / `<listing>` / `<textarea>`
    // start tag (HTML §13.2.6.4.7). So the children the page holds are the written ones with that line
    // ending cut — and the hole paths and the template's shape are computed over exactly those (a first
    // text that was only a line ending is no node at all). html.scrml `elemText` then prints them so the
    // browser builds that same text: when what is left still starts with a line ending, it prints one more
    // for the parser to drop. Net: `<pre>` + newline + code renders as HTML renders it, a `<textarea>`'s
    // value is unchanged, and LF / CRLF sources render alike.
    fn cutLeadingNewline(ks: View[]) -> View[] {
        if (ks.length == 0) return ks;
        const first: View = ks[0];
        const rest: View[] = ks.slice(1);
        return match first {
            .Text(text: t) :> cutTextView(View.Text(cutNewline(t)), cutNewline(t), rest),
            .RawText(text: t) :> cutTextView(View.RawText(cutNewline(t)), cutNewline(t), rest),
            .El :> ks,
            .Dyn :> ks,
            .Cond :> ks,
            .Each :> ks,
            .Instance :> ks,
            .Slot :> ks,
            .Star :> ks,
            .Effect :> ks,
            .Run :> ks,
            .Init :> ks,
            .Request :> ks,
            .ResetOn :> ks,
            .Errors :> ks,
            .Reach :> ks,
            .Gather :> ks
        };
    }

    // s482 (g-boot-rcdata-hole-anchor-s482) — the HTML parser reads the content of a raw-text / RCDATA
    // element (`<textarea>`, `<title>`, and `<xmp>` `<iframe>` `<noembed>` `<noframes>` `<noscript>`; HTML
    // §13.2.6.4.7) as ONE text node: a hole's `<!---->` anchor printed there is text, so the child-index
    // path to it names no node and the mount threw (`<textarea>a ${@x} b</textarea>` rendered nothing).
    // So when such an element (in the HTML namespace — an SVG `<title>` is markup) holds a `${}`, its
    // content is one text value: the concatenation of its text and its interpolated values, in order,
    // kept equal to that value by ONE hole on the element (rt.textContent). analyze mkRawNode refused
    // every other child, so these kids are text and `${}` values only — `not` (printed as written)
    // otherwise, and when there is no `${}`. `<textarea>`'s one dropped line ending is cut here, as the
    // parser would cut it (§24.5 item 2: "treat the body as the written one without that line ending").
    // `<plaintext>` is refused (analyze mkRepair); `<script>` / `<style>` are refused everywhere (§4.17).
    fn textContentKids(ns: string, tag: string, ks: View[]) -> View[] | not {
        const t: string = tag.toLowerCase();
        if (!isHtmlInNs(ns, t) || !isTextContentTag(t)) return not;
        let dyn: boolean = false;
        for (const k of ks) {
            const kind: int = textPartKind(k);
            if (kind < 0) return not;
            if (kind == 1) dyn = true;
        }
        if (!dyn) return not;
        if (dropsLeadingLf(tag)) return cutLeadingNewline(ks);
        return ks;
    }

    fn isTextContentTag(t: string) -> boolean {
        return ["textarea", "title", "xmp", "iframe", "noembed", "noframes", "noscript"].indexOf(t) >= 0;
    }

    // 0 a text, 1 an interpolated value, -1 anything else
    fn textPartKind(v: View) -> int {
        return match v {
            .Text(text: t) :> 0,
            .Dyn(e: e) :> 1,
            // no-default-arm: one question of a view — is it a part of a text value; every other form is not
            _ :> -1
        };
    }

    // The element's text value, wired on its hole: `rt.textContent(scope$, el, ["a ", () => x, " b"])` —
    // a static text as a string, each `${}` value as its own thunk, so a throwing value blanks only itself
    // (runtime.js textContent; s482, #2069 review LOW-3).
    // A `<textarea>` with `bind:value` gets none — §34 W-RCDATA-BIND-VALUE-CONTENT-CONFLICT: "`bind:value`
    // wins … and the reactive content interpolation is dropped" (analyze mkBindContent reports it).
    fn textContentJs(ctx: Ctx, tag: string, attrs: Attr[], ks: View[], node: JsExpr) -> JsStmt[] {
        const tc: View[] | not = textContentKids(ctx.ns, tag, ks);
        if (tc is not) return [];
        if (bindsValue(attrs)) return [];
        let parts: JsExpr[] = [];
        for (const k of tc) { parts = parts.concat(textPartJs(ctx, k)); }
        return [sexpr(rtCall(ctx, "textContent", [scopeVar(), node, JsExpr.JArray(parts)]))];
    }

    fn textPartJs(ctx: Ctx, v: View) -> JsExpr[] {
        return match v {
            .Text(text: t) :> [jstr(t)],
            .Dyn(e: e) :> [jthunk(exprJs(ctx, e))],
            // no-default-arm: textContentKids admitted only text and `${}` values
            _ :> []
        };
    }

    fn bindsValue(attrs: Attr[]) -> boolean {
        for (const a0 of attrs) {
            const a: Attr = a0;
            const b: boolean = match a {
                .Bind(kind: k) :> bindProp(k) == "value",
                // no-default-arm: one question of an attribute — is it a `bind:value`
                _ :> false
            };
            if (b) return true;
        }
        return false;
    }

    fn cutTextView(cut: View, left: string, rest: View[]) -> View[] {
        if (left == "") return rest;
        return [cut].concat(rest);
    }

    fn staticAttrs(attrs: Attr[]) -> HAttr[] {
        let out: HAttr[] = [];
        for (const a of attrs) { out = out.concat(staticAttr(a)); }
        return out;
    }

    fn staticAttr(a: Attr) -> HAttr[] {
        return match a {
            .Static(name: n, value: v) :> [{ name: n, value: v }],
            .Bound :> [],
            .Show :> [],
            .ClassOn :> [],
            .On :> [],
            .Bind :> [],
            .Gate(values: vs) :> gatedMarker(vs)
        };
    }

    // §55.17.6: `data-scrml-gated` on a GATED form only (a form whose listener
    // only records the submit, §55.7, gates nothing).
    fn gatedMarker(vs: string[]) -> HAttr[] {
        if (vs.length == 0) return [];
        return [{ name: "data-scrml-gated", value: vs.join(" ") }];
    }

    fn hasWiredAttr(attrs: Attr[]) -> boolean {
        for (const a of attrs) {
            if (isWired(a)) return true;
        }
        return false;
    }

    // F16: every arm binds a field — a match over an IMPORTED payload enum whose
    // arms bind nothing compiles to `a === "On"` and never matches.
    fn isWired(a: Attr) -> boolean {
        return match a {
            .Static(name: n) :> false,
            .Bound(name: n) :> true,
            .Show(test: t) :> true,
            .ClassOn(test: t) :> true,
            .On(event: ev) :> true,
            .Bind(kind: k) :> true,
            .Gate(values: vs) :> true
        };
    }

    // -------------------------------------------------------------------------
    // Views → client code.
    // -------------------------------------------------------------------------
    fn scopeVar() -> JsExpr { return jid("scope$"); }
    // s482 — a runtime `^{}` block's per-run `meta` object (metaJs; the Meta* PrimOps)
    fn metaVar() -> string { return "meta$"; }

    // s474: the template is the content of `ctx.ns` — the context it is inserted in.
    fn renderViews(ctx: Ctx, views: View[], tid: string) -> Rendered {
        const built: Built = buildNodes(ctx, views, [], ctx.ns);
        let stmts: JsStmt[] = [JsStmt.SConst("root$", rtCall(ctx, "template", [jstr(tid)]))];
        for (const h of built.holes) {
            if (holeNeedsNode(h.v)) {
                let args: JsExpr[] = [jid("root$")];
                for (const i of h.path) { args = args.concat([jnum(i)]); }
                stmts = stmts.concat([JsStmt.SConst(nodeVar(h.path), rtCall(ctx, "at", args))]);
            }
        }
        let templates: Template[] = [{ id: tid, nodes: built.nodes, ns: ctx.ns }];
        // Instance holes are numbered in document order — the order in which
        // the factory created them (mountedInstances) when this is a
        // declaration's own renders (ctx.prebuilt, L12 (b)).
        let kid = 0;
        for (const h of built.holes) {
            const w: Rendered = wireHole(withNs(ctx, h.ns), h, tid, kid);
            if (isInstanceView(h.v)) kid = kid + 1;
            stmts = stmts.concat(w.stmts);
            templates = templates.concat(w.templates);
        }
        stmts = stmts.concat([sexpr(rtCall(ctx, "insert", [scopeVar(), jid("root$"), jid("anchor$")]))]);
        return { stmts: stmts, templates: templates };
    }

    fn only(stmts: JsStmt[]) -> Rendered { return { stmts: stmts, templates: [] }; }

    // A nested region (a conditional arm, an <each> row, slot content) creates
    // its instances when it mounts: those are the conditional ones (§66.7.5).
    fn nested(ctx: Ctx) -> Ctx {
        return { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared,
                 rows: ctx.rows, slot: ctx.slot, prebuilt: false, ret: ctx.ret, server: ctx.server, tier0: ctx.tier0, cycles: ctx.cycles, ns: ctx.ns, owned: ctx.owned };
    }

    // F16: one arm binds a field (a match over an imported payload enum).
    fn isInstanceView(v: View) -> boolean {
        return match v {
            .Instance(decl: d) :> true,
            .El :> false,
            .Text :> false,
            .RawText :> false,
            .Dyn :> false,
            .Cond :> false,
            .Each :> false,
            .Slot :> false,
            .Star :> false,
            .Effect :> false,
            .Run :> false,
            .Init :> false,
            .Request :> false,
            .ResetOn :> false,
            .Errors :> false,
            .Reach :> false,
            .Gather :> false
        };
    }

    // s449: an `<effect>` hole is wired from its Core alone — it has no node to look up.
    fn holeNeedsNode(v: View) -> boolean {
        return match v {
            .Effect(deps: ds) :> false,
            .Run(meta: mt) :> mt != "",                 // s482: a runtime `^{}` block is wired to its placeholder
            .Init(k: x) :> false,
            .Request(deps: ds) :> false,
            .ResetOn(triggers: ds) :> false,
            .El(tag: t) :> true,
            .Text(text: t) :> true,
            .RawText(text: t) :> true,
            .Dyn(e: e) :> true,
            .Cond(arms: a) :> true,
            .Each(src: s) :> true,
            .Instance(decl: d) :> true,
            .Slot :> true,
            .Star(decl: d) :> true,
            .Errors(of: x) :> true,
            .Reach(fields: fs) :> true,
            .Gather(g: x) :> true
        };
    }

    // mountedInstances (core.scrml): the instances a renders mounts unconditionally,
    // in document order (the hole order of buildNodes) — L12 (b).

    fn wireHole(ctx: Ctx, h: Hole, tid: string, kid: int) -> Rendered {
        const node: JsExpr = jid(nodeVar(h.path));
        const v: View = h.v;
        return match v {
            .El(tag: t, attrs: attrs, kids: ks) :> only(attrsJs(ctx, attrs, node).concat(textContentJs(ctx, t, attrs, ks, node))),
            .Text :> only([]),
            .RawText :> only([]),
            .Dyn(e: e) :> only([sexpr(rtCall(ctx, "text", [scopeVar(), node, jthunk(exprJs(ctx, e))]))]),
            .Cond(arms: arms) :> condJs(nested(ctx), arms, node, tid + "/" + pathText(h.path)),
            .Each(src: src, bind: bind, key: key, handles: hs, row: row) :> eachJs(ctx, src, bind, key, hs, row, node, tid + "/" + pathText(h.path)),
            .Instance(decl: d, attrs: attrs, slot: slot, alias: alias) :> instanceJs(ctx, d, attrs, slot, alias, node, h.path, tid, kid),
            .Slot :> only([sexpr(rtCall(ctx, "slot", [scopeVar(), node, ctx.slot]))]),
            .Star(decl: d, inst: i) :> starJs(ctx, d, i, node),
            .Effect(deps: ds, body: b) :> effectJs(ctx, ds, b),
            .Run(body: b, hoist: hs, meta: mt) :> runOrMetaJs(ctx, b, hs, mt, node),
            .Init(k: x) :> only(seedPlaceJs(ctx, x)),                     // s482: a held cell's place (bodyInits keeps only those)
            .Request(target: t, deps: ds, body: b, mount: m, state: st, handle: h, cls: k) :> requestJs(ctx, t, ds, b, m, st, h, k),
            .ResetOn(triggers: ds, reset: b, rank: r) :> resetOnJs(ctx, ds, b, r),
            .Errors(of: x, all: a) :> only([sexpr(rtCall(ctx, "errors", [scopeVar(), node, jthunk(jmcall(surfaceJs(ctx, x), "messages", [])), JsExpr.JBool(a)]))]),
            .Reach(fields: fs) :> reachJs(ctx, fs, node),
            .Gather(g: g, rows: rows, key: gk) :> gatherJs(ctx, g, rows, gk, node, tid + "/" + pathText(h.path))
        };
    }

    // s469 — a Tier-0 `${ for … lift … }` (§17.4, §49.6.2): `rt.gather(scope$,
    // node, build)`. `build` runs the loop and returns its rows — each a
    // `(scope$, anchor$) => …` render thunk — which the runtime renders in order
    // before the marker, inside an effect: when a cell the loop (or a row's
    // value) read changes, every row is torn down and the loop re-runs (§6.15:
    // a render expression; there is no key — §17.4b is not built). A row thunk
    // is made WHEN its Lift runs and closes over a snapshot of the loop's locals
    // it reads (`((x, i) => (scope$, anchor$) => { … })(x, i)`), so a local the
    // loop rebinds later never changes a row already lifted (§49.6 rule 3).
    //
    // s474 — KEYED (§17.4b `for (x of xs key e)`; `key` the local the body's
    // first statement binds, `const key = rt.loopKey(e)`): `rt.gatherKeyed`.
    // A row Lift appends `rt.keyRow(key, idx, [x, i], (scope$, anchor$, x, i) =>
    // { … })` — the row's template index and its snapshot of the loop's
    // locals; the row's markup reads each of those locals through a CELL (`x`
    // is a cell there, read `x.get()`, as an `<each>` row reads its item), so a
    // row whose identity — key, template, place among the iteration's lifts of that template —
    // persists across a re-run keeps its DOM and its scope, and only the cells
    // are set to the iteration's new values (§17.4b: "preserving DOM state …
    // for elements whose key persists"). A value Lift appends `rt.keyTextRow(key, v)`.
    fn gatherJs(ctx: Ctx, g: Gather, rows: GatherRow[], key: Sym | not, node: JsExpr, tid: string) -> Rendered {
        const local: Sym[] = boundSyms(Node.NStmt(Stmt.Gather(g)));
        let thunks: JsExpr[] = [];
        let templates: Template[] = [];
        let keyName: string = "";
        let keyId: int = -1;
        if (key is given) {
            keyName = symName(ctx, key);
            keyId = key.id;
        }
        let k = 0;
        for (const row of rows) {
            const snapSyms: Sym[] = rowSnapshotSyms(ctx, local, row.views);
            let snap: string[] = [];
            let snapIds: int[] = [];
            let args: JsExpr[] = [];
            for (const sy of snapSyms) {
                snap = snap.concat([symName(ctx, sy)]);
                snapIds = snapIds.concat([sy.id]);
                args = args.concat([jid(symName(ctx, sy))]);
            }
            if (keyName != "") {
                const kr: Rendered = renderViews(withRowCells(withTier0(nested(ctx), not), snapIds), row.views, tid + "." + k);
                const krender: JsExpr = JsExpr.JArrow(["scope$", "anchor$"].concat(snap), kr.stmts);
                thunks = thunks.concat([rtCall(ctx, "keyRow", [jid(keyName), jnum(k), JsExpr.JArray(args), krender])]);
                templates = templates.concat(kr.templates);
            } else {
                const r: Rendered = renderViews(withTier0(nested(ctx), not), row.views, tid + "." + k);
                const render: JsExpr = JsExpr.JArrow(["scope$", "anchor$"], r.stmts);
                thunks = thunks.concat([jcall(JsExpr.JArrowE(snap, render), args)]);
                templates = templates.concat(r.templates);
            }
            k = k + 1;
        }
        const acc: string = symName(ctx, g.bind);
        const assigned: int[] = assignedSyms(Node.NStmt(Stmt.Gather(g)));
        const lctx: Ctx = withTier0(ctx, { rows: thunks, key: keyName, keyId: keyId });
        const body: JsStmt[] = [JsStmt.SConst(acc, JsExpr.JArray([]))]
            .concat(loopJs(lctx, g.label, g.head, g.body, assigned))
            .concat([JsStmt.SReturn(jid(acc))]);
        let entry: string = "gather";
        if (keyName != "") entry = "gatherKeyed";
        return { stmts: [sexpr(rtCall(ctx, entry, [scopeVar(), node, JsExpr.JArrow([], body)]))], templates: templates };
    }

    // s474 — a keyed row's snapshot locals are CELLS in its markup (`x.get()`).
    fn withRowCells(ctx: Ctx, ids: int[]) -> Ctx {
        return { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared,
                 rows: ctx.rows.concat(ids), slot: ctx.slot, prebuilt: ctx.prebuilt, ret: ctx.ret, server: ctx.server, tier0: ctx.tier0, cycles: ctx.cycles, ns: ctx.ns, owned: ctx.owned };
    }

    // The loop's locals (`local`: the Syms the Gather binds, at any depth of
    // its head and body, in walk order) that a row reads, by name.
    fn rowSnapshotSyms(ctx: Ctx, local: Sym[], views: View[]) -> Sym[] {
        let reads: int[] = [];
        for (const v of views) {
            for (const n of allNodes(Node.NView(v))) {
                const id: int = localReadOf(n);
                if (id >= 0 && !hasInt(reads, id)) reads = reads.concat([id]);
            }
        }
        let out: Sym[] = [];
        let names: string[] = [];
        for (const s of local) {
            if (hasInt(reads, s.id) && names.indexOf(symName(ctx, s)) < 0) {
                out = out.concat([s]);
                names = names.concat([symName(ctx, s)]);
            }
        }
        return out;
    }

    fn localReadOf(n: Node) -> int {
        return match n {
            .NExpr(e: e) :> exprLocalOf(e),
            .NPlace(pl: pl) :> placeLocalOf(pl),
            .NProgram(p: x) :> -1,
            .NDecl(d: x) :> -1,
            .NField(f: x) :> -1,
            .NFn(f: x) :> -1,
            .NServerFn(f: x) :> -1,
            .NBlock(b: x) :> -1,
            .NStmt(s: x) :> -1,
            .NInst(i: x) :> -1,
            .NPattern(pat: x) :> -1,
            .NEdit(k: x) :> -1,
            .NView(v: x) :> -1,
            .NAttr(a: x) :> -1
        };
    }

    fn exprLocalOf(e: Expr) -> int {
        return match e {
            .Local(sym: s) :> s.id,
            .Lit(lit: x) :> -1,
            .Read(place: x) :> -1,
            .Call(callee: x) :> -1,
            .FnRef(fn: x) :> -1,
            .CallV(f: x) :> -1,
            .Prim(op: x) :> -1,
            .Match(scrut: x) :> -1,
            .ArrayOf(elems: x) :> -1,
            .StructOf(ty: x) :> -1,
            .VariantOf(enumSym: x) :> -1,
            .Handle(inst: x) :> -1,
            .Assigned(local: x) :> -1,
            .InitOf(decl: x) :> -1,
            .Host(call: x) :> -1,
            .Lambda(params: x) :> -1,
            .BlockLambda(params: x) :> -1,
            .SeqCall(op: x) :> -1,
            .Refetch(req: rf0) :> -1,
            .Validity(of: x) :> -1,
            .ServerCall(fn: x) :> -1,
            .Query(q: x) :> -1,
            .Foreign(slice: fsl0) :> -1
        };
    }

    fn placeLocalOf(pl: Place) -> int {
        return match pl {
            .LocalPath(sym: s) :> s.id,
            .Cell(decl: x) :> -1
        };
    }

    // s449 — `rt.resetOn(scope$, [<trigger cells>], () => { <the reset write> }, rank)`
    // (§6.8.4): the cell resets itself in the flush of the triggering write,
    // a chain in rank order, before any render or effect reads it.
    fn resetOnJs(ctx: Ctx, triggers: EffectDep[], reset: Block, rank: int) -> Rendered {
        return only([sexpr(rtCall(ctx, "resetOn", [scopeVar(), JsExpr.JArray(depCells(ctx, triggers)), JsExpr.JArrow([], blockJs(ctx, reset)), jnum(rank)]))]);
    }

    fn depCells(ctx: Ctx, deps: EffectDep[]) -> JsExpr[] {
        let cells: JsExpr[] = [];
        for (const dep of deps) {
            const d: Decl | not = findDecl(ctx.p, dep.decl);
            if (d is given) {
                cells = cells.concat([fieldCell(instJs(ctx, dep.inst), d, dep.idx)]);
            } else {
                cells = cells.concat([jid("unboundDecl$" + dep.decl.id)]);
            }
        }
        return cells;
    }

    // s449 — `rt.effectOn(scope$, [<dependency cells>], (task$) => { <body> })`
    // (§6.7.4): registered into the scope this view list renders into, so it is
    // unregistered with that scope (teardown step 1). The dependencies are the
    // cells themselves — the effect subscribes to exactly those. `task$` is
    // bound only when the body suspends (C12).
    // s478 — body-top statements (View.Run; §40.8: "it runs once at mount in
    // source order"): `rt.run(scope$, (task$) => { … })` — run NOW, as the scope's
    // holes are wired in document order, in a task the scope owns (a Suspend in
    // the body is cancelled when the scope is destroyed), as a handler's body runs.
    // s478-boot-run-locals — `hoist`: the body's top-level locals (file-scope, §7.6; §35.2.2
    // "a single binding at the common ancestor scope"): `let name;` in the scope's render,
    // before the run — the body assigns each, and the later views read that binding.
    fn runJs(ctx: Ctx, body: Block, hoist: Sym[]) -> Rendered {
        let out: JsStmt[] = [];
        for (const h of hoist) { out = out.concat([JsStmt.SDecl(symName(ctx, h))]); }
        return only(out.concat([sexpr(rtCall(ctx, "run", [scopeVar(), JsExpr.JArrow(handlerParams(body), blockJs(ctx, body))]))]));
    }

    // s482 (s482-meta-runtime) — a runtime `^{}` block (View.Run with its `meta` id; SPEC §22.5):
    // `rt.metaEffect(scope$, <placeholder>, "<id>", (task$, meta$) => { … })`. The body runs as
    // a run does (a task the scope owns; it may write cells), first where it stands and again
    // when a cell it reads through `meta.get` changes (runtime.js MetaEffect); `meta$` is the
    // run's fresh `meta` object the Meta* PrimOps call (§22.5.1).
    fn runOrMetaJs(ctx: Ctx, body: Block, hoist: Sym[], meta: string, node: JsExpr) -> Rendered {
        if (meta == "") return runJs(ctx, body, hoist);
        return only([sexpr(rtCall(ctx, "metaEffect", [scopeVar(), node, jstr(meta), JsExpr.JArrow(["task$", metaVar()], blockJs(ctx, body))]))]);
    }

    fn effectJs(ctx: Ctx, deps: EffectDep[], body: Block) -> Rendered {
        let params: string[] = [];
        if (suspends(body)) params = ["task$"];
        return only([sexpr(rtCall(ctx, "effectOn", [scopeVar(), JsExpr.JArray(depCells(ctx, deps)), JsExpr.JArrow(params, blockJs(ctx, body))]))]);
    }

    // s475 — the request machine (§6.7.7 / §13.9.2), modelled on effectJs:
    //   rt.requestOn(scope$, <target cell>, [<dependency cells>],
    //     (task$) => { <Lets>; return { on: <the load>, then: (x) => { <then> } }; },
    //     { mount[, state: { loading, data, error, stale }][, slot: <handle>] })
    // The body's ONE Suspend (C-R1) is not printed as `rt.suspend`: the
    // runtime owns the load's suspension, so it knows the run (newest wins —
    // EC-2), drops a late settle after teardown (EC-3), sets the signals, and,
    // for a request WITH its state (r1: all four signals or none), takes a
    // failure itself (target unchanged, §6.7.7 "Settled state (failure)")
    // instead of running `then`. `then` closes over the Lets. Registered into
    // the scope this view list renders into (C12's owner rule, as an Effect).
    // r1 (F3) / s475 S3b: a `handle` is the request's program-level slot (below).
    // s475 (S5a): a READ request (§6.7.7.1) prints `read: true` — the runtime
    // then aborts its superseded / torn-down transport; a WRITE request prints
    // nothing (the runtime's default is discard, the fail-closed class).
    fn requestJs(ctx: Ctx, target: EffectDep, deps: EffectDep[], body: Block, mount: boolean, st: RequestState | not, handle: Sym | not, cls: ReqClass) -> Rendered {
        const n: int = body.stmts.length;
        if (n == 0) return only([sexpr(jid("malformedRequest$"))]);          // C-R1 refuses it first
        const sp: SuspendParts | not = suspendPartsOf(body.stmts[n - 1]);
        if (sp is not) return only([sexpr(jid("malformedRequest$"))]);       // C-R1 refuses it first
        const pre: Block = { stmts: body.stmts.slice(0, n - 1) };
        const cont: JsExpr = JsExpr.JArrow([symName(ctx, sp.bind)], blockJs(ctx, sp.then));
        const load: JsStmt[] = blockJs(ctx, pre).concat([JsStmt.SReturn(JsExpr.JObject([{ key: "on", value: exprJs(ctx, sp.on) }, { key: "then", value: cont }]))]);
        let opts: JsProp[] = [{ key: "mount", value: JsExpr.JBool(mount) }];
        if (cls == ReqClass.ReqRead) opts = opts.concat([{ key: "read", value: JsExpr.JBool(true) }]);
        if (st is given) {
            const sigs: JsExpr[] = depCells(ctx, [st.loading, st.data, st.error, st.stale]);
            const so: JsExpr = JsExpr.JObject([{ key: "loading", value: sigs[0] }, { key: "data", value: sigs[1] }, { key: "error", value: sigs[2] }, { key: "stale", value: sigs[3] }]);
            opts = opts.concat([{ key: "state", value: so }]);
        }
        // s475 (slice S3b): the handle names the request's PROGRAM-LEVEL slot (requestSlotStmts),
        // which requestOn fills while the request is mounted — so `<#id>.refetch()` (Core
        // Refetch) reaches it from a function or another scope, not only from this render scope
        if (handle is given) opts = opts.concat([{ key: "slot", value: jid(symName(ctx, handle)) }]);
        const args: JsExpr[] = [scopeVar(), depCells(ctx, [target])[0], JsExpr.JArray(depCells(ctx, deps)), JsExpr.JArrow(["task$"], load), JsExpr.JObject(opts)];
        return only([sexpr(rtCall(ctx, "requestOn", args))]);
    }

    // s475 (slice S3b) — `<#id>.refetch()` (§6.7.7 EC-4): `rt.refetch(<slot>)` —
    // a new run of the request mounted in the slot; nothing while none is.
    fn refetchJs(ctx: Ctx, s: Sym) -> JsExpr {
        return rtCall(ctx, "refetch", [jid(symName(ctx, s))]);
    }

    // s475 (slice S3b) — one module-level slot per request handle,
    // `const <handle> = rt.requestSlot();`, ahead of every reader (the render
    // functions and the program's functions; the boot runs after them).
    fn requestSlotStmts(ctx: Ctx, p: CoreProgram) -> JsStmt[] {
        const hs: Sym[] = requestHandles(p);
        if (hs.length == 0) return [];
        let out: JsStmt[] = [JsStmt.SBlank, JsStmt.SComment("request slots (§6.7.7 — filled while each request is mounted)")];
        for (const h of hs) { out = out.concat([JsStmt.SConst(symName(ctx, h), rtCall(ctx, "requestSlot", []))]); }
        return out;
    }

    // s454 (U1b): a Suspend at ANY depth (a Join body, an If branch after a
    // Join, a Suspend's continuation) — the body needs its task.
    fn suspends(b: Block) -> boolean {
        for (const n of allNodes(Node.NBlock(b))) {
            if (nodeIsSuspend(n)) return true;
        }
        return false;
    }

    fn nodeIsSuspend(n: Node) -> boolean {
        return match n {
            .NStmt(s: s) :> isSuspend(s),
            .NExpr(e: x) :> false,
            .NProgram(p: x) :> false,
            .NDecl(d: x) :> false,
            .NField(f: x) :> false,
            .NFn(f: x) :> false,
            .NServerFn(f: x) :> false,
            .NBlock(b: x) :> false,
            .NPlace(pl: x) :> false,
            .NInst(i: x) :> false,
            .NPattern(pat: x) :> false,
            .NEdit(k: x) :> false,
            .NView(v: x) :> false,
            .NAttr(a: x) :> false
        };
    }

    fn isSuspend(s: Stmt) -> boolean {
        return match s {
            .Suspend(bind: b) :> true,
            .Let(sym: x) :> false,
            .Assign(local: x) :> false,
            .Write(cap: x) :> false,
            .Commit(writes: x) :> false,
            .If(cond: x) :> false,
            .Return(e: x) :> false,
            .Eval(e: x) :> false,
            .ResetSurface(of: x) :> false,
            .Defer(body: x) :> false,
            .Unpersist(decl: x) :> false,
            .Attempt(result: x) :> false,
            .Fail(err: x) :> false,
            .Join(k: x) :> false,
            .Jump(k: x) :> false,
            .Loop(label: x) :> false,
            .Break(target: x) :> false,
            .Continue(target: x) :> false,
            .Gather(g: x) :> false,
            .Lift(into: x) :> false,
            .LocalFn(f: x) :> false
        };
    }

    // s444 — `<*x/>` (§66.6.2): the EXISTING instance, rendered with x's
    // renders into THIS scope (so its view effects are disposed with this
    // site, while the instance itself lives on). Nothing is constructed.
    fn starJs(ctx: Ctx, d: Sym, i: InstRef, node: JsExpr) -> Rendered {
        // s474: the renders printed for the context at this site (ctx.ns, wireHole)
        return only([sexpr(jcall(jid(renderName(ctx, d, ctx.ns)), [instJs(ctx, i), scopeVar(), node, JsExpr.JNull]))]);
    }

    // s449: a form's submit gate is registered BEFORE every other listener of
    // the element (§55.17.3: it runs before any author handler) — whatever the
    // attribute order.
    fn attrsJs(ctx: Ctx, attrs: Attr[], node: JsExpr) -> JsStmt[] {
        const fixed: string[] = staticClasses(attrs);
        let gates: JsStmt[] = [];
        let out: JsStmt[] = [];
        for (const a of attrs) {
            if (isGate(a)) {
                gates = gates.concat(attrJs(ctx, a, node, fixed));
            } else {
                out = out.concat(attrJs(ctx, a, node, fixed));
            }
        }
        return gates.concat(out);
    }

    // s480 (s480-static-class) — the class names the element's static `class="…"` names (§5.5.2:
    // "The static class is always present"). A `class:` directive naming one of them is printed
    // `fixed` (rt.classOn's last argument): its condition is still read (its dependencies, and a
    // trap holds the element out, §19.17), but the class is never removed — not on mount, not on a
    // re-run, not on a held element's restore. A static `hidden` stripped would REVEAL content.
    fn staticClasses(attrs: Attr[]) -> string[] {
        let out: string[] = [];
        for (const a of attrs) {
            const v: string = staticClassText(a);
            for (const t of v.split("\t").join(" ").split("\n").join(" ").split("\r").join(" ").split(" ")) {
                if (t != "") out = out.concat([t]);
            }
        }
        return out;
    }

    fn staticClassText(a: Attr) -> string {
        return match a {
            .Static(name: n, value: v) :> (n.toLowerCase() == "class" ? v : ""),
            .Bound(name: x) :> "",
            .Show(test: x) :> "",
            .ClassOn(test: x) :> "",
            .On(event: x) :> "",
            .Bind(kind: x) :> "",
            .Gate(values: x) :> ""
        };
    }

    fn isGate(a: Attr) -> boolean {
        return match a {
            .Gate(values: vs) :> true,
            .Static(name: n) :> false,
            .Bound(name: n) :> false,
            .Show(test: t) :> false,
            .ClassOn(test: t) :> false,
            .On(event: ev) :> false,
            .Bind(kind: k) :> false
        };
    }

    // s454 (U1b) — a handler whose body suspends runs in a TASK the runtime
    // makes for each invocation (rt.on passes it first): teardown of the
    // element's scope cancels it; a second event does not cancel the first
    // (design §2.3 reading — supersede is `<request>` semantics, not a handler's).
    fn handlerParams(body: Block) -> string[] {
        if (usesEvent(body)) return ["task$", eventVar()];
        if (suspends(body)) return ["task$"];
        return [];
    }

    // s478 (s478-boot-fn-values) — the listener's event argument: rt.on calls a handler
    // `(task, event)`. `$`-suffixed, so no minted name is it (names.scrml).
    fn eventVar() -> string { return "event$"; }

    // Does a handler body read or call the listener's event (HostCall EventRead / EventCall)?
    fn usesEvent(b: Block) -> boolean {
        for (const n of allNodes(Node.NBlock(b))) {
            if (nodeIsEventHost(n)) return true;
        }
        return false;
    }

    fn nodeIsEventHost(n: Node) -> boolean {
        return match n {
            .NExpr(e: x) :> exprIsEventHost(x),
            .NStmt(s: x) :> false,
            .NProgram(p: x) :> false,
            .NDecl(d: x) :> false,
            .NField(f: x) :> false,
            .NFn(f: x) :> false,
            .NServerFn(f: x) :> false,
            .NBlock(b: x) :> false,
            .NPlace(pl: x) :> false,
            .NInst(i: x) :> false,
            .NPattern(pat: x) :> false,
            .NEdit(k: x) :> false,
            .NView(v: x) :> false,
            .NAttr(a: x) :> false
        };
    }

    fn exprIsEventHost(e: Expr) -> boolean {
        return match e {
            .Host(call: c) :> isEventCall(c),
            .Lit(lit: x) :> false,
            .Local(sym: x) :> false,
            .Read(place: x) :> false,
            .Call(callee: x) :> false,
            .FnRef(fn: x) :> false,
            .CallV(f: x) :> false,
            .Prim(op: x) :> false,
            .Match(scrut: x) :> false,
            .ArrayOf(elems: x) :> false,
            .StructOf(ty: x) :> false,
            .VariantOf(enumSym: x) :> false,
            .Handle(inst: x) :> false,
            .InitOf(decl: x) :> false,
            .Lambda(params: x) :> false,
            .BlockLambda(params: x) :> false,
            .SeqCall(op: x) :> false,
            .Validity(of: x) :> false,
            .Refetch(req: x) :> false,
            .ServerCall(fn: x) :> false,
            .Query(q: x) :> false,
            .Assigned(local: x) :> false,
            .Foreign(slice: x) :> false
        };
    }

    // s478 (open-Qs ruling item 9) — an event read's member path (`type`, `target.value`) off the
    // listener's event argument, one `.` hop per segment
    fn eventPath(m: string) -> JsExpr {
        let x: JsExpr = jid(eventVar());
        for (const seg of m.split(".")) { x = jmember(x, seg); }
        return x;
    }

    fn isEventCall(c: HostCall) -> boolean {
        return match c {
            .EventRead(member: m) :> true,
            .EventCall(member: m) :> true,
            .DateNow :> false,
            .Unreadable :> false
        };
    }

    fn attrJs(ctx: Ctx, a: Attr, node: JsExpr, fixed: string[]) -> JsStmt[] {
        return match a {
            .Static :> [],
            .Bound(name: n, e: e) :> [sexpr(rtCall(ctx, "attr", [scopeVar(), node, jstr(n), jthunk(exprJs(ctx, e))]))],
            .Show(test: t) :> [sexpr(rtCall(ctx, "visibility", [scopeVar(), node, jthunk(exprJs(ctx, t))]))],
            .ClassOn(name: cn, test: t) :> [sexpr(rtCall(ctx, "classOn", [scopeVar(), node, jstr(cn), jthunk(exprJs(ctx, t))].concat(fixed.indexOf(cn) >= 0 ? [JsExpr.JAnnot(JsExpr.JBool(true), "also in the static class: never removed")] : [])))],
            .On(event: ev, body: body) :> [sexpr(rtCall(ctx, "on", [scopeVar(), node, jstr(ev), JsExpr.JArrow(handlerParams(body), blockJs(ctx, body))]))],
            .Bind(kind: k, read: r, sink: sk, write: w) :> [sexpr(rtCall(ctx, "bind", [scopeVar(), node, jstr(bindProp(k)), jthunk(exprJs(ctx, r)), JsExpr.JArrow([symName(ctx, sk)], blockJs(ctx, w))].concat(bindSurface(ctx, r))))],
            .Gate(values: vs, fields: fs) :> [sexpr(rtCall(ctx, "gate", [scopeVar(), node, JsExpr.JArrowE([], JsExpr.JArray(gateSurfacesJs(ctx, fs)))]))]
        };
    }

    // s472 — a View.Reach marker (§55.17.3): while its markup list is mounted
    // it registers the bound surfaced fields that list names, evaluated in the
    // list's own context; a gated form whose subtree holds the marker gates them.
    fn reachJs(ctx: Ctx, fs: ValidityOf[], node: JsExpr) -> Rendered {
        return only([sexpr(rtCall(ctx, "reach", [scopeVar(), node, JsExpr.JArrowE([], JsExpr.JArray(gateSurfacesJs(ctx, fs)))]))]);
    }

    // The records a gate (or a Reach) judges. A field reached through an `as=`
    // handle is read with a presence check: an absent handle names no instance,
    // so there is no value to gate (`validityIf` gives null, which the gate skips).
    fn gateSurfacesJs(ctx: Ctx, fs: ValidityOf[]) -> JsExpr[] {
        let out: JsExpr[] = [];
        for (const f of fs) { out = out.concat([gateSurfaceJs(ctx, f)]); }
        return out;
    }

    fn gateSurfaceJs(ctx: Ctx, v: ValidityOf) -> JsExpr {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> gateFieldJs(ctx, v, d, i, x),
            .OfDecl(decl: d, inst: i) :> surfaceJs(ctx, v)
        };
    }

    fn gateFieldJs(ctx: Ctx, v: ValidityOf, d: Sym, i: InstRef, x: int) -> JsExpr {
        return match i {
            .Alias(sym: s) :> rtCall(ctx, "validityIf", [instJs(ctx, i), JsExpr.JAnnot(jnum(x), memberName(ctx, d, x))]),
            .Shared(decl: y) :> surfaceJs(ctx, v),
            .Lexical(depth: k) :> surfaceJs(ctx, v),
            .Narrowed(sym: s) :> surfaceJs(ctx, v),
            .Kid(of: o) :> surfaceJs(ctx, v),
            .HandleOf(of: o) :> rtCall(ctx, "validityIf", [instJs(ctx, i), JsExpr.JAnnot(jnum(x), memberName(ctx, d, x))])
        };
    }

    // s449 — the validity record a bind marks `touched` and a gate reads
    // (§55.7, §55.17.3): a bind of a field's WHOLE value, when the field has a
    // surface — every field of a user declaration (§55.6), a top-level value
    // only when it carries validators (§55.5.1 rule 2).
    fn bindSurface(ctx: Ctx, read: Expr) -> JsExpr[] {
        return match read {
            .Read(place: pl) :> placeSurface(ctx, pl),
            .Lit(lit: x) :> [],
            .Local(sym: x) :> [],
            .Call(callee: x) :> [],
            .FnRef(fn: x) :> [],
            .CallV(f: x) :> [],
            .Prim(op: x) :> [],
            .Match(scrut: x) :> [],
            .ArrayOf(elems: x) :> [],
            .StructOf(ty: x) :> [],
            .VariantOf(enumSym: x) :> [],
            .Handle(inst: x) :> [],
            .Assigned(local: x) :> [],
            .InitOf(decl: x) :> [],
            .Host(call: x) :> [],
            .Lambda(params: x) :> [],
            .BlockLambda(params: x) :> [],
            .SeqCall(op: x) :> [],
            .Refetch(req: rf0) :> [],
            .Validity(of: x) :> [],
            .ServerCall(fn: x) :> [],
            .Query(q: x) :> [],
            .Foreign(slice: fsl0) :> []
        };
    }

    fn placeSurface(ctx: Ctx, pl: Place) -> JsExpr[] {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> cellSurface(ctx, d, i, path),
            .LocalPath(sym: s) :> []
        };
    }

    fn cellSurface(ctx: Ctx, dsym: Sym, i: InstRef, path: FieldRef[]) -> JsExpr[] {
        if (path.length != 1) return [];
        const d: Decl | not = findDecl(ctx.p, dsym);
        if (d is not) return [];
        const idx: int = path[0].idx;
        if (idx >= d.fields.length) return [];
        if (!hasSurface(d, d.fields[idx])) return [];
        return [rtCall(ctx, "validity", [instJs(ctx, i), JsExpr.JAnnot(jnum(idx), fieldHint(d, idx))])];
    }

    fn hasSurface(d: Decl, f: Field) -> boolean {
        const k: DeclKind = d.kind;
        return match k {
            .User :> true,
            .Program :> f.vals.length > 0,
            .Predefined :> false
        };
    }

    // s444 — the element property a bind shows and reads back (§5.4).
    fn bindProp(k: BindKind) -> string {
        return match k {
            .Value :> "value",
            .Checked :> "checked"
        };
    }

    fn condJs(ctx: Ctx, arms: CondArm[], node: JsExpr, tid: string) -> Rendered {
        let objs: JsExpr[] = [];
        let templates: Template[] = [];
        let k = 0;
        for (const arm of arms) {
            const r: Rendered = renderViews(ctx, arm.body, tid + "." + k);
            objs = objs.concat([JsExpr.JObject([
                { key: "test", value: jthunk(exprJs(ctx, arm.test)) },
                { key: "render", value: JsExpr.JArrow(["scope$", "anchor$"], r.stmts) },
            ])]);
            templates = templates.concat(r.templates);
            k = k + 1;
        }
        return { stmts: [sexpr(rtCall(ctx, "cond", [scopeVar(), node, JsExpr.JArray(objs)]))], templates: templates };
    }

    fn eachJs(ctx: Ctx, src: Expr, bind: Sym, key: Expr | not, handles: Sym[], row: View[], node: JsExpr, tid: string) -> Rendered {
        const bindName: string = symName(ctx, bind);
        let rowHandles: HandleLoc[] = ctx.handles;
        let decls: JsStmt[] = [];
        for (const h of handles) {
            rowHandles = rowHandles.concat([{ sym: h.id, js: jid(symName(ctx, h)) }]);
            decls = decls.concat([JsStmt.SConst(symName(ctx, h), rtCall(ctx, "handle", []))]);
        }
        const rowCtx: Ctx = {
            p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: ctx.lexical, handles: rowHandles,
            shared: ctx.shared, rows: ctx.rows.concat([bind.id]), slot: ctx.slot, prebuilt: false, ret: ctx.ret, server: ctx.server, tier0: ctx.tier0, cycles: ctx.cycles, ns: ctx.ns, owned: [],
        };
        const r: Rendered = renderViews(rowCtx, row, tid);
        const keyFn: JsExpr = keyJs(ctx, bindName, key);
        const render: JsExpr = JsExpr.JArrow(["scope$", bindName, "anchor$"], decls.concat(r.stmts));
        return {
            stmts: [sexpr(rtCall(ctx, "each", [scopeVar(), node, jthunk(exprJs(ctx, src)), keyFn, render]))],
            templates: r.templates,
        };
    }

    // The key function reads the row binding as the plain ITEM value (not the
    // row's cell); an unkeyed <each> keys by position (null → index).
    fn keyJs(ctx: Ctx, bindName: string, key: Expr | not) -> JsExpr {
        if (key is not) return JsExpr.JNull;
        return JsExpr.JArrowE([bindName], exprJs(ctx, key));
    }

    fn isAttribute(f: Field) -> boolean {
        const r: FieldRole = f.role;
        return match r {
            .Attribute :> true,
            .Child :> false
        };
    }

    // F16: the `.JId(name: n)` binding forces tag comparison (see isWired).
    fn isUndefined(e: JsExpr) -> boolean {
        return match e {
            .JUndefined :> true,
            .JId(name: n) :> false,
            .JNum :> false,
            .JStr :> false,
            .JBool :> false,
            .JNull :> false,
            .JMember :> false,
            .JIndex :> false,
            .JCall :> false,
            .JArrow :> false,
            .JArrowE :> false,
            .JBin :> false,
            .JUn :> false,
            .JCond :> false,
            .JArray :> false,
            .JObject :> false,
            .JAnnot :> false,
            .JAwait :> false,
            .JAssignE :> false,
            .JNew :> false,
            .JText :> false
        };
    }

    fn constructValue(attrs: ConstructAttr[], field: int) -> Expr | not {
        for (const a of attrs) {
            if (a.field == field) return a.value;
        }
        return not;
    }

    // A field the factory takes a parameter for: every ATTRIBUTE (use-site
    // construction, §66.14 rule 4), and a CHILD field some use constructs (the
    // ratified O60 example `<dropdown open=(@x)/>`; ⚑ O43). Decided from Core.
    fn isParam(ix: PrintIx, d: Decl, idx: int, f: Field) -> boolean {
        if (isAttribute(f)) return true;
        return ix.constructed.indexOf(fieldKey(d.sym, idx)) >= 0;
    }

    // s477 (s477-boot-compile-perf): what isParam and reinitUsed ask of the whole
    // program, read in ONE walk when the print context is made — each walked the
    // whole program per declared field (O(fields × program)). `constructed`: the
    // field of every attribute some View.Instance gives (constructsField);
    // `reinits`: the field of every InitOf (isInitOf). Keys are fieldKey's.
    // s482 (s482-registry-client): `reg` — the Sym ids of the types the CLIENT half uses
    // (clientRegistryIds; r1: by identity, never by name), set by printProgramExposing (withReg);
    // the only types a runtime `reflect` registry prints (regArgs). Empty elsewhere: no other
    // context prints one.
    // s482 r1 (#2105 review LOW-1): `gseeds` — the field of every LOCKED attribute some use site gives
    // a CONSTANT seed (givenSeedExpr) — §66.7.6 rule 5: a use-site value is a seed computed at the
    // instance's mount (fieldCtorGiven, createJs).
    type PrintIx:struct = { constructed: string[], reinits: string[], reg: int[], gseeds: string[] }

    fn fieldKey(d: Sym, idx: int) -> string {
        return d.id + ":" + idx;
    }

    fn printIx(p: CoreProgram) -> PrintIx {
        let constructed: string[] = [];
        let reinits: string[] = [];
        let gseeds: string[] = [];
        for (const n of allNodes(Node.NProgram(p))) {
            constructed = constructed.concat(nodeConstructs(n));
            // s483: a program-cell reset printed where it stands (initOfJs) keeps no thunk
            if (!inlineInitOf(p, n)) reinits = reinits.concat(nodeInitOfs(n));
            gseeds = gseeds.concat(nodeGivenSeeds(p, n));
        }
        return { constructed: constructed, reinits: reinits, reg: [], gseeds: gseeds };
    }

    // s482 r1 (#2105 review LOW-1; §66.7.6 rule 5 — a use-site value is a seed computed at the
    // instance's mount; ruling:user-voice-scrml.md-S482-locked-field-derived — derived only when it
    // reads a cell): the fields a use site (View.Instance) gives a CONSTANT seed — one that reads
    // no cell (readsCellReach, fail closed) and whose place can be observed (seedLive). A literal is
    // the same value wherever it runs; one that reads a cell stays derived.
    fn nodeGivenSeeds(p: CoreProgram, n: Node) -> string[] {
        const v: View | not = match n {
            .NView(v: x) :> x,
            // no-default-arm: one question — is it a view
            _ :> not
        };
        if (v is not) return [];
        const pair: GivenAt | not = match v {
            .Instance(decl: d, attrs: attrs) :> { decl: d, attrs: attrs },
            // no-default-arm: only an instance is given values
            _ :> not
        };
        if (pair is not) return [];
        let out: string[] = [];
        for (const a of pair.attrs) {
            if (givenSeedExpr(p, a.value)) out = out.concat([fieldKey(pair.decl, a.field)]);
        }
        return out;
    }

    type GivenAt:struct = { decl: Sym, attrs: ConstructAttr[] }

    fn givenSeedExpr(p: CoreProgram, e: Expr) -> boolean {
        return seedLive(e) && !readsCellReach(p, e);
    }

    // A locked attribute some use site gives a constant seed (PrintIx.gseeds).
    fn givenSeedField(ix: PrintIx, d: Decl, i: int, f: Field) -> boolean {
        return f.wcap is not && f.persist is not && f.init is given && ix.gseeds.indexOf(fieldKey(d.sym, i)) >= 0;
    }

    fn nodeConstructs(n: Node) -> string[] {
        return match n {
            .NView(v: v) :> viewConstructKeys(v),
            .NProgram(p: q) :> [],
            .NDecl(d: d) :> [],
            .NField(f: f) :> [],
            .NFn(f: f) :> [],
            .NServerFn(f: f) :> [],
            .NBlock(b: b) :> [],
            .NStmt(s: s) :> [],
            .NExpr(e: e) :> [],
            .NPlace(pl: pl) :> [],
            .NInst(i: i) :> [],
            .NPattern(pat: pat) :> [],
            .NEdit(k: k) :> [],
            .NAttr(a: a) :> []
        };
    }

    fn viewConstructKeys(v: View) -> string[] {
        return match v {
            .Instance(decl: d, attrs: attrs) :> constructKeys(d, attrs),
            .El(tag: t) :> [],
            .Text(text: t) :> [],
            .RawText(text: t) :> [],
            .Dyn(e: e) :> [],
            .Cond(arms: a) :> [],
            .Each(src: s) :> [],
            .Slot :> [],
            .Star(decl: d) :> [],
            .Effect(deps: ds) :> [],
            .Run(body: x) :> [],
            .Init(k: x) :> [],
            .Request(deps: ds) :> [],
            .ResetOn(triggers: ds) :> [],
            .Errors(of: x) :> [],
            .Reach(fields: fs) :> [],
            .Gather(g: x) :> []
        };
    }

    // the fields `attrs` constructs: viewConstructs' test, per attribute
    fn constructKeys(d: Sym, attrs: ConstructAttr[]) -> string[] {
        let out: string[] = [];
        for (const a of attrs) {
            if (constructValue(attrs, a.field) is given) out = out.concat([fieldKey(d, a.field)]);
        }
        return out;
    }

    fn nodeInitOfs(n: Node) -> string[] {
        return match n {
            .NExpr(e: e) :> exprInitOfKeys(e),
            .NProgram(p: q) :> [],
            .NDecl(d: x) :> [],
            .NField(f: f) :> [],
            .NFn(f: f) :> [],
            .NServerFn(f: f) :> [],
            .NBlock(b: b) :> [],
            .NStmt(s: s) :> [],
            .NPlace(pl: pl) :> [],
            .NInst(i: i) :> [],
            .NPattern(pat: pat) :> [],
            .NEdit(k: k) :> [],
            .NView(v: v) :> [],
            .NAttr(a: a) :> []
        };
    }

    fn inlineInitOf(p: CoreProgram, n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> exprInlineInitOf(p, e),
            // no-default-arm: one question of a node — is it an InitOf initOfJs prints where it stands
            _ :> false
        };
    }

    fn exprInlineInitOf(p: CoreProgram, e: Expr) -> boolean {
        return match e {
            .InitOf(decl: d, inst: i, idx: x) :> programInitInline(p, d, i, x) is given,
            // no-default-arm: one question of an expression — is it such an InitOf
            _ :> false
        };
    }

    fn exprInitOfKeys(e: Expr) -> string[] {
        return match e {
            .InitOf(decl: s, idx: x) :> [fieldKey(s, x)],
            .Lit(lit: l) :> [],
            .Local(sym: s) :> [],
            .Read(place: pl) :> [],
            .Call(callee: c) :> [],
            .FnRef(fn: x) :> [],
            .CallV(f: x) :> [],
            .Prim(op: o) :> [],
            .Match(scrut: s) :> [],
            .ArrayOf(elems: es) :> [],
            .StructOf(ty: t) :> [],
            .VariantOf(enumSym: t) :> [],
            .Handle(inst: i) :> [],
            .Assigned(local: x) :> [],
            .Host(call: c) :> [],
            .Lambda(params: ps) :> [],
            .BlockLambda(params: ps) :> [],
            .SeqCall(op: o) :> [],
            .Refetch(req: rf0) :> [],
            .Validity(of: x) :> [],
            .ServerCall(fn: x) :> [],
            .Query(q: x) :> [],
            .Foreign(slice: fsl0) :> []
        };
    }

    // `mk_<decl>(rt.instance(decl_<decl>, scope), …)` — a new instance of `d`
    // owned by `scope`: the new record, then one initializer thunk per factory
    // parameter (isParam) or `undefined` for its default.
    fn createJs(ctx: Ctx, d: Decl, attrs: ConstructAttr[], scope: JsExpr) -> JsExpr {
        let args: JsExpr[] = [rtCall(ctx, "instance", [jid(nameOf(ctx.names, NameKey.DeclInfo(d.sym.id))), scope])];
        let k = 0;
        for (const f of d.fields) {
            if (isParam(ctx.pix, d, k, f)) {
                const v: Expr | not = constructValue(attrs, k);
                if (v is given && givenSeedField(ctx.pix, d, k, f) && givenSeedExpr(ctx.p, v)) {
                    // s482 r1 (#2105 review LOW-1): a constant use-site value — a seed at the mount
                    args = args.concat([rtCall(ctx, "givenSeed", [jthunk(exprJs(ctx, v))])]);
                } else if (v is given) {
                    args = args.concat([jthunk(exprJs(ctx, v))]);
                } else {
                    args = args.concat([JsExpr.JUndefined]);
                }
            }
            k = k + 1;
        }
        for (; args.length > 1 && isUndefined(args[args.length - 1]); ) { args = args.slice(0, args.length - 1); }
        return jcall(jid(nameOf(ctx.names, NameKey.Factory(d.sym.id))), args);
    }

    // `inst$.kids[k /* decl */]` — an instance the factory already created.
    fn kidSlot(ctx: Ctx, k: int, hint: string) -> JsExpr {
        return JsExpr.JIndex(jmember(lexicalJs(ctx, 0), "kids"), JsExpr.JAnnot(jnum(k), hint));
    }

    // An instance hole. In a declaration's own renders (ctx.prebuilt) the
    // instance was created with the record (L12 (b)) and is only MOUNTED here;
    // in a nested region it is created now, as the region mounts.
    fn instanceJs(ctx: Ctx, dsym: Sym, attrs: ConstructAttr[], slot: View[], alias: Sym | not, node: JsExpr, path: int[], tid: string, kid: int) -> Rendered {
        const d: Decl | not = findDecl(ctx.p, dsym);
        if (d is not) return only([sexpr(jid("unboundDecl$" + dsym.id))]);
        const iv: string = "i$" + pathText(path);
        let stmts: JsStmt[] = [];
        if (ctx.prebuilt) {
            stmts = [JsStmt.SConst(iv, kidSlot(ctx, kid, dsym.hint))];
            // s482: an instance the program body mounts, holding a live seed (held by the
            // program's factory, holdJs): its seeds run here, at its place in the body's run
            if (isProgramTid(ctx.p, tid) && liveSeedDecl(ctx.p, ctx.pix, d)) stmts = stmts.concat([sexpr(rtCall(ctx, "seedAll", [jid(iv)]))]);
        } else {
            stmts = [JsStmt.SConst(iv, createJs(ctx, d, attrs, scopeVar()))];
            if (alias is given) {
                stmts = stmts.concat([sexpr(rtCall(ctx, "bindHandle", [handleJs(ctx, alias), jid(iv)]))]);
            }
        }
        let templates: Template[] = [];
        // s444: a prebuilt kid renders into the scope THIS render was given —
        // the parent instance's scope for a new instance (the same lifetime as
        // the kid's own), the `<*x/>` site's scope for a Star render (so the
        // view is disposed with the site, never left in the kid's scope).
        let renderScope: JsExpr = jmember(jid(iv), "scope");
        if (ctx.prebuilt) renderScope = scopeVar();
        if (d.renders is given) {
            let slotFn: JsExpr = JsExpr.JNull;
            if (slot.length > 0) {
                // s474: slot content is inserted at the declaration's `<slot/>` — its context
                const r: Rendered = renderViews(withNs(nested(ctx), slotNsOf(ctx.p, dsym, ctx.ns, 0)), slot, tid + "/" + pathText(path) + ".slot");
                slotFn = JsExpr.JArrow(["scope$", "anchor$"], r.stmts);
                templates = r.templates;
            }
            stmts = stmts.concat([sexpr(jcall(jid(renderName(ctx, dsym, ctx.ns)),
                [jid(iv), renderScope, node, slotFn]))]);
        }
        return { stmts: stmts, templates: templates };
    }

    // -------------------------------------------------------------------------
    // Declarations (§5.2).
    // -------------------------------------------------------------------------
    fn baseCtx(p: CoreProgram, names: NameTable) -> Ctx {
        return { p: p, pix: printIx(p), names: names, lexical: [], handles: [], shared: [], rows: [], slot: JsExpr.JNull, prebuilt: false, ret: "", server: false, tier0: not, cycles: [], ns: htmlNs(), owned: [] };
    }

    fn instCtx(ctx: Ctx, d: Decl) -> Ctx {
        let hs: HandleLoc[] = [];
        let k = 0;
        for (const h of d.handles) {
            hs = hs.concat([{ sym: h.id, js: handleSlot(jid("inst$"), k, h.hint) }]);
            k = k + 1;
        }
        return { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: [jid("inst$")], handles: hs, shared: [], rows: [], slot: jid("slot$"), prebuilt: true, ret: "", server: false, tier0: not, cycles: [], ns: ctx.ns, owned: [] };
    }

    // s474: `uses` — the contexts each declaration is used in (declNsUses); its
    // renders print once per context (renderName / the `@ns` template id).
    fn declJs(ctx: Ctx, d: Decl, sharedUsed: Sym[], uses: DeclNs[]) -> Rendered {
        const h: string = d.sym.hint;
        let stmts: JsStmt[] = [
            JsStmt.SBlank,
            JsStmt.SComment(declComment(d)),
            JsStmt.SConst(nameOf(ctx.names, NameKey.DeclInfo(d.sym.id)),
                rtCall(ctx, "declare", [jstr(h), JsExpr.JArray(fieldNamesJs(d))].concat(declOptsJs(ctx, d)))),
        ];
        stmts = stmts.concat(edgeTablesJs(ctx, d));
        stmts = stmts.concat([factoryJs(ctx, d)]);
        let templates: Template[] = [];
        const views: View[] | not = d.renders;
        if (views is given) {
            // s474 (door 3): the template id is the per-file output name (two files' `<card>`s, two templates)
            for (const ns of declNsList(uses, d)) {
                let tid: string = "scrml:" + d.key;
                if (ns != htmlNs()) tid = tid + "@" + ns;
                const r: Rendered = renderViews(withNs(instCtx(ctx, d), ns), views, tid);
                stmts = stmts.concat([JsStmt.SFunc(renderName(ctx, d.sym, ns),
                    ["inst$", "scope$", "anchor$", "slot$"], r.stmts)]);
                templates = templates.concat(r.templates);
            }
        }
        if (symIn(sharedUsed, d.sym)) {
            stmts = stmts.concat([JsStmt.SFunc(nameOf(ctx.names, NameKey.SharedGet(d.sym.id)), [], [
                JsStmt.SReturn(rtCall(ctx, "shared", [jid(nameOf(ctx.names, NameKey.DeclInfo(d.sym.id))),
                    jid(nameOf(ctx.names, NameKey.Factory(d.sym.id)))])),
            ])]);
        }
        return { stmts: stmts, templates: templates };
    }

    fn declComment(d: Decl) -> string {
        const k: DeclKind = d.kind;
        return match k {
            .Program :> "the program — a `single` declaration whose fields are the top-level cells",
            .User :> declUserComment(d),
            .Predefined :> "predefined declaration <" + d.sym.hint + ">"
        };
    }

    fn declUserComment(d: Decl) -> string {
        if (d.single) return "declaration <" + d.sym.hint + "> (single)";
        return "declaration <" + d.sym.hint + ">";
    }

    fn symIn(xs: Sym[], s: Sym) -> boolean {
        for (const x of xs) { if (x.id == s.id) return true; }
        return false;
    }

    // s449 — the validators of each field (§55.1), when any field carries one:
    // `{ checks: [[…], …] }`, plus `topLevel: true` for the program, whose
    // fields are top-level values with their own `submitted` (§55.5.1).
    fn declOptsJs(ctx: Ctx, d: Decl) -> JsExpr[] {
        let any = false;
        let perField: JsExpr[] = [];
        for (const f of d.fields) {
            if (f.vals.length > 0) any = true;
            perField = perField.concat([JsExpr.JArray(validatorsJs(ctx, f.vals))]);
        }
        if (!any) return [];
        let props: JsProp[] = [];
        if (isProgramDecl(d)) props = [{ key: "topLevel", value: JsExpr.JBool(true) }];
        props = props.concat([{ key: "checks", value: JsExpr.JArray(perField) }]);
        return [JsExpr.JObject(props)];
    }

    fn isProgramDecl(d: Decl) -> boolean {
        const k: DeclKind = d.kind;
        return match k {
            .Program :> true,
            .User :> false,
            .Predefined :> false
        };
    }

    fn validatorsJs(ctx: Ctx, vs: Validator[]) -> JsExpr[] {
        let out: JsExpr[] = [];
        for (const v of vs) { out = out.concat([validatorJs(ctx, v)]); }
        return out;
    }

    fn checkCall(ctx: Ctx, name: string, args: JsExpr[]) -> JsExpr {
        return jcall(jmember(jmember(jid(rtName(ctx)), "check"), name), args);
    }

    fn validatorJs(ctx: Ctx, v: Validator) -> JsExpr {
        return match v {
            .Req :> checkCall(ctx, "req", []),
            .LengthCmp(op: op, n: n) :> checkCall(ctx, "length", [jstr(op), jnum(n)]),
            .Min(n: n) :> checkCall(ctx, "min", [JsExpr.JNum("" + n)]),
            .Max(n: n) :> checkCall(ctx, "max", [JsExpr.JNum("" + n)]),
            .Pattern(source: src) :> checkCall(ctx, "pattern", [jstr(src)])
        };
    }

    fn fieldNamesJs(d: Decl) -> JsExpr[] {
        let out: JsExpr[] = [];
        for (const f of d.fields) { out = out.concat([jstr(f.sym.hint)]); }
        return out;
    }

    fn structFieldDefs(t: TypeDef) -> FieldDef[] {
        return match t {
            .StructDef(fields: fs) :> fs,
            .EnumDef(variants: vs) :> [],
            .HostDef(sym: x) :> []
        };
    }

    fn edgeTableJs(ctx: Ctx, g: TransitionGraph) -> JsExpr {
        let props: JsProp[] = [];
        for (const e of g.edges) {
            let targets: JsExpr[] = [];
            for (const t of e.targets) { targets = targets.concat([jstr(variantTag(ctx, g.enumSym, t))]); }
            props = props.concat([{ key: variantTag(ctx, g.enumSym, e.origin), value: JsExpr.JArray(targets) }]);
        }
        return rtCall(ctx, "edges", [JsExpr.JObject(props)]);
    }

    fn edgeTablesJs(ctx: Ctx, d: Decl) -> JsStmt[] {
        let out: JsStmt[] = [];
        let i = 0;
        for (const f of d.fields) {
            const g: TransitionGraph | not = f.graph;
            if (g is given) {
                let props: JsProp[] = [];
                for (const e of g.edges) {
                    let targets: JsExpr[] = [];
                    for (const t of e.targets) { targets = targets.concat([jstr(variantTag(ctx, g.enumSym, t))]); }
                    props = props.concat([{ key: variantTag(ctx, g.enumSym, e.origin), value: JsExpr.JArray(targets) }]);
                }
                out = out.concat([JsStmt.SConst(nameOf(ctx.names, NameKey.Edges(d.sym.id, i)),
                    rtCall(ctx, "edges", [JsExpr.JObject(props)]))]);
            }
            i = i + 1;
        }
        return out;
    }

    // mk_<decl>(inst$, <attr>$ …): seed every field of a fresh instance record.
    // A field with a write capability is a Cell seeded once (untracked); a
    // field without one is a Derived that recomputes (constant if its
    // initializer reads no cells).
    fn factoryJs(ctx: Ctx, d: Decl) -> JsStmt {
        const fctx: Ctx = instCtx(ctx, d);
        let params: string[] = ["inst$"];
        let body: JsStmt[] = [];
        let i = 0;
        for (const f of d.fields) {
            let init: JsExpr = defaultThunk(fctx, d, f);
            let usePn: string = "";
            if (isParam(ctx.pix, d, i, f)) {
                const pn: string = f.sym.hint.replaceAll("$", "_") + "$";
                params = params.concat([pn]);
                init = JsExpr.JBin(JsOp.Nullish, jid(pn), init);
                usePn = pn;
            }
            // D15: an initializer something re-evaluates (`InitOf`, a reset) is
            // kept on the record, so the instance's OWN initializer is re-run.
            if (reinitUsed(ctx.pix, d.sym, i)) {
                const slot: JsExpr = JsExpr.JIndex(jmember(jid("inst$"), "inits"), JsExpr.JAnnot(jnum(i), fieldHint(d, i)));
                body = body.concat([JsStmt.SAssign(slot, init)]);
                init = slot;
            }
            body = body.concat([JsStmt.SAssign(fieldCell(jid("inst$"), d, i), fieldCtorGiven(fctx, d, f, i, init, usePn, givenSeedField(ctx.pix, d, i, f)))]);
            body = body.concat(idleWatchJs(fctx, d, f, i));
            i = i + 1;
        }
        let k = 0;
        for (const h of d.handles) {
            body = body.concat([JsStmt.SAssign(handleSlot(jid("inst$"), k, h.hint), rtCall(ctx, "handle", []))]);
            k = k + 1;
        }
        // s483 (Q21 lane 2): the construction check of a declaration with invariants
        // (§66.13.5) — the fresh instance's seeded fields, before its children
        const ci: Expr | not = d.invs;
        if (ci is given) body = body.concat([sexpr(exprJs(fctx, ci))]);
        body = body.concat(kidsJs(fctx, d));
        if (d.sym.id == ctx.p.program.id) body = body.concat(holdJs(fctx, d));
        const run: JsExpr = rtCall(ctx, "construct", [jid("inst$"), JsExpr.JArrow([], body)]);
        return JsStmt.SFunc(nameOf(ctx.names, NameKey.Factory(d.sym.id)), params, [JsStmt.SReturn(run)]);
    }

    // s482 — §7.6 rule (b) S482 (ruling:user-voice-scrml.md-S481-run-order-followups item 1:
    // "each seed is computed at its place in the sequence; records are still created at
    // construction"): the program's factory HOLDS the seeds whose place matters —
    // `rt.hold(<cell>)` for each held program cell (bodyInits left its View.Init in the renders),
    // `rt.hold(inst$.kids[k])` for each instance the body mounts unconditionally whose record holds
    // a live seed (liveSeedDecl) — so the end of the construction leaves them owed; the render
    // runs each at its place (seedPlaceJs, instanceJs `rt.seedAll`).
    fn holdJs(fctx: Ctx, d: Decl) -> JsStmt[] {
        const views: View[] | not = d.renders;
        if (views is not) return [];
        let out: JsStmt[] = [];
        for (const id of initsIn(views)) {
            let i: int = 0;
            for (const f of d.fields) {
                if (f.sym.id == id) out = out.concat([sexpr(rtCall(fctx, "hold", [fieldCell(jid("inst$"), d, i)]))]);
                i = i + 1;
            }
        }
        let k: int = 0;
        for (const v of mountedInstances(views)) {
            const kd: Decl | not = kidDeclOf(fctx.p, v);
            if (kd is given && liveSeedDecl(fctx.p, fctx.pix, kd)) {
                out = out.concat([sexpr(rtCall(fctx, "hold", [JsExpr.JIndex(jmember(jid("inst$"), "kids"), JsExpr.JAnnot(jnum(k), kd.sym.hint))]))]);
            }
            k = k + 1;
        }
        return out;
    }

    // The program's own render (its template id, declJs: "scrml:" + the declaration's key).
    fn isProgramTid(p: CoreProgram, tid: string) -> boolean {
        for (const d of p.decls) {
            if (d.sym.id == p.program.id) return tid == "scrml:" + d.key;
        }
        return false;
    }

    fn kidDeclOf(p: CoreProgram, v: View) -> Decl | not {
        const id: int = viewInstanced(v);
        for (const d of p.decls) { if (d.sym.id == id) return d; }
        return not;
    }

    // s482 — a held program cell's place: `rt.seed(<cell>)` runs its seed now, unless a read or a
    // write before the place already ran it.
    fn seedPlaceJs(ctx: Ctx, k: Sym) -> JsStmt[] {
        for (const d of ctx.p.decls) {
            if (d.sym.id == ctx.p.program.id) {
                let i: int = 0;
                for (const f of d.fields) {
                    if (f.sym.id == k.id) return [sexpr(rtCall(ctx, "seed", [fieldCell(jid("inst$"), d, i)]))];
                    i = i + 1;
                }
            }
        }
        return [];
    }

    // s478 — a graph field's `<onIdle after= to=>` watchdog (§51.0.R):
    // `rt.idleWatch(inst$.scope, <cell>, <edges>, ms, "<to tag>")` — armed with the
    // record ("Armed at module-init alongside the engine variant cell"), owned by
    // the instance's scope. Only on a field with a write capability (analyze
    // refuses `<onIdle>` on a derived value).
    fn idleWatchJs(fctx: Ctx, d: Decl, f: Field, i: int) -> JsStmt[] {
        const g: TransitionGraph | not = f.graph;
        if (g is not || f.wcap is not) return [];
        const w: IdleWatch | not = g.idle;
        if (w is not) return [];
        const edges: JsExpr = jid(nameOf(fctx.names, NameKey.Edges(d.sym.id, i)));
        return [sexpr(rtCall(fctx, "idleWatch", [jmember(jid("inst$"), "scope"), fieldCell(jid("inst$"), d, i), edges, jnum(w.ms), jstr(variantTag(fctx, g.enumSym, w.to))]))];
    }

    // Does any `InitOf(d, _, idx)` appear in the program?
    fn reinitUsed(ix: PrintIx, d: Sym, idx: int) -> boolean {
        return ix.reinits.indexOf(fieldKey(d, idx)) >= 0;
    }

    // L12 (b): the instances d's renders mounts unconditionally are created
    // with d's record, in document order, and their `as=` handles bound — so an
    // unconditional handle names a live instance before any render or user code.
    fn kidsJs(fctx: Ctx, d: Decl) -> JsStmt[] {
        const views: View[] | not = d.renders;
        if (views is not) return [];
        if (!fctx.prebuilt) return [];
        let out: JsStmt[] = [];
        let k = 0;
        for (const v of mountedInstances(views)) {
            out = out.concat(kidJs(fctx, v, k));
            k = k + 1;
        }
        return out;
    }

    fn kidJs(fctx: Ctx, v: View, k: int) -> JsStmt[] {
        return match v {
            .Instance(decl: ds, attrs: attrs, alias: alias) :> kidCreate(fctx, ds, attrs, alias, k),
            .El :> [],
            .Text :> [],
            .RawText :> [],
            .Dyn :> [],
            .Cond :> [],
            .Each :> [],
            .Slot :> [],
            .Star :> [],
            .Effect :> [],
            .Run :> [],
            .Init :> [],
            .Request :> [],
            .ResetOn :> [],
            .Errors :> [],
            .Reach :> [],
            .Gather :> []
        };
    }

    fn kidCreate(fctx: Ctx, ds: Sym, attrs: ConstructAttr[], alias: Sym | not, k: int) -> JsStmt[] {
        const kd: Decl | not = findDecl(fctx.p, ds);
        if (kd is not) return [sexpr(jid("unboundDecl$" + ds.id))];
        const slotE: JsExpr = kidSlot(fctx, k, ds.hint);
        let out: JsStmt[] = [JsStmt.SAssign(slotE, createJs(fctx, kd, attrs, jmember(jid("inst$"), "scope")))];
        if (alias is given) out = out.concat([sexpr(rtCall(fctx, "bindHandle", [handleJs(fctx, alias), slotE]))]);
        return out;
    }

    fn defaultThunk(ctx: Ctx, d: Decl, f: Field) -> JsExpr {
        const init: Expr | not = f.init;
        if (init is given) return jthunk(exprJs(ctx, init));
        return jthunk(rtCall(ctx, "noDefault", [jstr("<" + d.sym.hint + "> attribute `" + f.sym.hint + "`")]));
    }

    // s478 — a `debounced=` / `throttled=` field (§6.13):
    // `rt.timed(inst$.scope, <cell>, "debounce" | "throttle", <ms>)` — the cell,
    // whose LOCAL writes now pass through the timing rule (runtime `timed`).
    // S479 (§6.13.5) — on a graph field (an engine) the field's edge table is passed
    // too: `rt.timed(…, <ms>, <edges>)`, and the runtime judges `rule=` when a held
    // write COMMITS ("A `debounced=` / `throttled=` engine cell transitions at commit").
    fn fieldCtor(ctx: Ctx, d: Decl, f: Field, i: int, init: JsExpr) -> JsExpr {
        const c: JsExpr = fieldCell0(ctx, f, init);
        const tm: Timing | not = f.timing;
        if (tm is given && f.wcap is given) {
            let kind: string = "debounce";
            if (tm.throttle) kind = "throttle";
            let args: JsExpr[] = [jmember(jid("inst$"), "scope"), c, jstr(kind), jnum(tm.ms)];
            if (f.graph is given) args = args.concat([jid(nameOf(ctx.names, NameKey.Edges(d.sym.id, i)))]);
            return rtCall(ctx, "timed", args);
        }
        return c;
    }

    fn fieldCell0(ctx: Ctx, f: Field, init: JsExpr) -> JsExpr {
        const ps: Persist | not = f.persist;
        if (ps is given && f.wcap is given) return persistedJs(ctx, f, ps, init);
        if (f.wcap is given) return rtCall(ctx, "seeded", [init]);
        // s482 (lane s482-seed-timing, Q13): a constant with a live seed is a seed (constSeedField)
        if (constSeedField(ctx.p, f)) return rtCall(ctx, "seeded", [init]);
        return rtCall(ctx, "derived", [jmember(jid("inst$"), "scope"), init]);
    }

    // s482 (lane s482-seed-timing, Q13) — fieldCtor, for a field that may be given a use-site value
    // (`given`, its factory parameter; "" when it is not a parameter). A locked attribute whose
    // DEFAULT is a constant seed (constSeedField) is that seed when the use site gives no value; a
    // given value is computed when it is read (`rt.propSeed(scope, <given>, <init>)`:
    // `<given> === undefined ? rt.seeded(<init>) : rt.derived(scope, <init>)`), unless it is marked
    // a constant seed — ~~⚑ INTERIM (g-boot-use-site-value-seed-s482)~~ resolved s482 r1, below.
    // s482 r1 (#2105 review LOW-1 → built; §66.7.6 rule 5): a given value the use site marks a
    // constant seed (`rt.givenSeed(<thunk>)`, createJs) is that seed too — computed at the mount
    // (`given.$seed`); `useSeed`: some use site gives this field one, so a field whose default is
    // derived or a literal takes the same path (`rt.propSeed(scope, <given>, <init>, false)`: no given
    // value → derived, as before).
    fn fieldCtorGiven(ctx: Ctx, d: Decl, f: Field, i: int, init: JsExpr, usePn: string, useSeed: boolean) -> JsExpr {
        if (usePn != "" && constSeedField(ctx.p, f)) return rtCall(ctx, "propSeed", [jmember(jid("inst$"), "scope"), jid(usePn), init]);
        if (usePn != "" && useSeed) return rtCall(ctx, "propSeed", [jmember(jid("inst$"), "scope"), jid(usePn), init, JsExpr.JBool(false)]);
        return fieldCtor(ctx, d, f, i, init);
    }

    // s451 — a `persist=` field (§6.14.2):
    // `rt.persisted(inst$.scope, <default thunk>, "local" | "session", <key>, <wire table>)`
    // — a seeded cell whose construction value is the stored value decoded
    // against the field's type (the §57 descriptor below), or the default; it
    // is written on change and (`"local"`) synced across tabs. C17 guarantees
    // the descriptor exists; `unwireable$` marks a Core that skipped check.
    fn persistedJs(ctx: Ctx, f: Field, ps: Persist, init: JsExpr) -> JsExpr {
        const wt: WireTable | not = wireBuild(ctx.p, f.ty).table;
        let wire: JsExpr = jid("unwireable$" + f.sym.id);
        if (wt is given) wire = wireTableJs(wt);
        const where: PersistStore = ps.store;
        const store: string = match where {
            .Local :> "local",
            .Session :> "session"
        };
        const invs: Expr | not = ps.invs;
        // r1 (#2128 review H1): the restore's invariant checks (§6.14.2 rules 1, 3, 5)
        if (invs is given) return rtCall(ctx, "persisted", [jmember(jid("inst$"), "scope"), init, jstr(store), jstr(ps.key), wire, exprJs(ctx, invs), jstr(ps.loc)]);
        return rtCall(ctx, "persisted", [jmember(jid("inst$"), "scope"), init, jstr(store), jstr(ps.key), wire]);
    }

    // s451 — the storage half of a reset (§6.14.2 rule 9): `rt.unpersist(<cell>)`
    // removes the key and cancels the store the reset's Write queued.
    fn unpersistJs(ctx: Ctx, dsym: Sym, inst: InstRef, idx: int) -> JsStmt {
        const d: Decl | not = findDecl(ctx.p, dsym);
        if (d is not) return sexpr(jid("unboundDecl$" + dsym.id));
        return sexpr(rtCall(ctx, "unpersist", [fieldCell(instJs(ctx, inst), d, idx)]));
    }

    // -------------------------------------------------------------------------
    // Functions.
    // -------------------------------------------------------------------------
    fn dedupe(xs: Sym[]) -> Sym[] {
        let out: Sym[] = [];
        for (const x of xs) { if (!symIn(out, x)) out = out.concat([x]); }
        return out;
    }

    // =========================================================================
    // s472 (boot-math-port) — HOST-BACKED FUNCTIONS (core.scrml Fn.host; SPEC
    // §21.3.1, ruling:user-voice-scrml.md S472 "stdlib host `.js` output
    // location" + "host function type …" item 1). Each host module is imported
    // ONCE per artifact, as a namespace, from where the driver copies it:
    //   import * as hostmod$0 from "./_scrml/math/host.js";
    // and a host-backed function is its signature around the host call, the
    // value DECODED against the declared return type at that point:
    //   function floor(x) { return rt.hostResult(hostmod$0.floor(x), { k: "int" }, "floor() — …"); }
    // (runtime.js hostResult: the F3 §5.4 boundary decode; a mismatch is the
    // E-HOST-VALUE-MISMATCH-RT trap). The namespace names carry `$`, so no
    // minted name can collide with them (names.scrml). Both artifacts number
    // the modules over the WHOLE program (`hostModules`), so one module has one
    // name everywhere.
    // =========================================================================
    // The program's host modules, each once, in function order.
    export fn hostModules(p: CoreProgram) -> HostFn[] {
        let out: HostFn[] = [];
        for (const f of p.fns) {
            const h: HostFn | not = f.host;
            if (h is given) {
                // s473: a `<host>` binding names no host module (its target is printed in place)
                if (h.bind is not && hostModuleIndex(out, h) < 0) out = out.concat([h]);
            }
        }
        return out;
    }

    fn hostModuleIndex(ms: HostFn[], h: HostFn) -> int {
        let i: int = 0;
        for (const m of ms) {
            if (m.module == h.module && m.file == h.file) return i;
            i = i + 1;
        }
        return -1;
    }

    fn hostModName(p: CoreProgram, h: HostFn) -> string {
        return "hostmod$" + hostModuleIndex(hostModules(p), h);
    }

    // Where the driver puts a host module, relative to the artifacts (both sit in `<outputDir>`).
    export fn hostModulePath(h: HostFn) -> string {
        return "./_scrml/" + h.module + "/" + h.file;
    }

    // The namespace imports of the host modules the functions `fs` reach (each once).
    export fn hostImports(p: CoreProgram, fs: Fn[]) -> JsStmt[] {
        let seen: HostFn[] = [];
        for (const f of fs) {
            const h: HostFn | not = f.host;
            if (h is given) {
                if (h.bind is not && hostModuleIndex(seen, h) < 0) seen = seen.concat([h]);
            }
        }
        let out: JsStmt[] = [];
        for (const h of seen) { out = out.concat([JsStmt.SImportAll(hostModName(p, h), hostModulePath(h))]); }
        // s473 (allowlist lane A, §21.3.3 rule 3): each `<host src=>` file the functions reach, once —
        // through the shim the driver writes (slice-m1/host-src.js), which re-exports the file's copy
        let srcs: string[] = [];
        for (const f of fs) {
            const sp: string = hostSrcPathOf(f);
            if (sp != "" && srcs.indexOf(sp) < 0) srcs = srcs.concat([sp]);
        }
        for (const sp of srcs) {
            const k: int = hostSrcs(p).indexOf(sp);
            out = out.concat([JsStmt.SImportAll("hostsrc$" + k, "./_scrml/host-src/" + k + ".js")]);
        }
        return out;
    }

    // The `<host src=>` path a function's binding is rooted at ("" — none).
    fn hostSrcPathOf(f: Fn) -> string {
        const h: HostFn | not = f.host;
        if (h is not) return "";
        const b: HostBind | not = h.bind;
        if (b is not) return "";
        const s: HostSrc | not = b.src;
        if (s is not) return "";
        return s.path;
    }

    // The program's `<host src=>` files, each once, in function order — the driver numbers its shims
    // `_scrml/host-src/<K>.js` in this same order (slice-m1/host-src.js planHostSrcs).
    export fn hostSrcs(p: CoreProgram) -> string[] {
        let out: string[] = [];
        for (const f of p.fns) {
            const sp: string = hostSrcPathOf(f);
            if (sp != "" && out.indexOf(sp) < 0) out = out.concat([sp]);
        }
        return out;
    }

    export fn hostFnJs(ctx: Ctx, f: Fn, h: HostFn) -> JsStmt {
        let params: string[] = [];
        let args: JsExpr[] = [];
        for (const prm of f.params) {
            const n: string = symName(ctx, prm.sym);
            params = params.concat([n]);
            args = args.concat([jid(n)]);
        }
        const hb: HostBind | not = h.bind;
        if (hb is given) return hostBindJs(ctx, f, hb, h.ret, params);
        const call: JsExpr = jcall(jmember(jid(hostModName(ctx.p, h)), h.name), args);
        const at: string = f.sym.hint + "() — the host function `" + h.name + "` of " + hostModulePath(h).slice(2);
        const rt0: Type | not = h.ret;
        let desc: JsExpr = hostKind("unchecked");
        if (rt0 is given) desc = hostTypeJs(rt0);
        return JsStmt.SFunc(symName(ctx, f.sym), params, [JsStmt.SReturn(rtCall(ctx, "hostResult", [call, desc, jstr(at)]))]);
    }

    // s473 (boot-host-block-f3) — a `<host>` BINDING (DRAFT SPEC §21.3.3): its
    // target printed as LITERAL JavaScript (rule 7 — never built from source
    // text at run time) inside a thunk the runtime calls (`rt.hostCall`), which
    // turns a throw into `E-HOST-THROW-RT` (rule 18) and decodes the result
    // against the declared type (rule 13; `{ k: "void" }` — no `->`: discarded,
    // a thenable still a mismatch). A root `window` / `document` / `navigator`
    // is read through the runtime (`rt.hostRoot("window")`), so no name the
    // program declares can shadow it.
    fn hostBindJs(ctx: Ctx, f: Fn, b: HostBind, ret: Type | not, params: string[]) -> JsStmt {
        let base: JsExpr = rtCall(ctx, "hostRoot", [jstr(b.root)]);
        if (b.rootParam >= 0) base = jid(params[b.rootParam]);
        const hs: HostSrc | not = b.src;
        if (hs is given) base = jmember(jid("hostsrc$" + hostSrcs(ctx.p).indexOf(hs.path)), b.root);
        const at0: string = f.sym.hint + "() — the `<host>` binding";
        // s473-host-allowlist-b (DRAFT §21.3.3 rule 8.5): a guarded entry's target is routed through
        // runtime.js's checks — guarded(inert-receiver): the receiver through `rt.hostInert`;
        // guarded(url) on a write: the value through `rt.hostUrl` (§5.2 rule 3's guard);
        // guarded(attr-name): the name through `rt.hostSetAttrName` and a `setAttribute` value through
        // `rt.hostAttrValue` (URL-valued names judged by the same guard). Still literal JS (rule 7).
        // `inert@k` (analyze.scrml hostWalk): the receiver of chain member k goes through rt.hostInert —
        // at EVERY guarded(inert-receiver) step, a mid-chain read (`e.classList`) included
        let recv: JsExpr = base;
        let recvG: JsExpr = base;
        let i: int = 0;
        for (; i < b.chain.length; ) {
            let r: JsExpr = recv;
            if (b.guards.indexOf("inert@" + i) >= 0) r = rtCall(ctx, "hostInert", [recv, jstr(at0)]);
            if (i == b.chain.length - 1) {
                recvG = r;
            } else {
                recv = jmember(r, b.chain[i]);
            }
            i = i + 1;
        }
        let args: JsExpr[] = [];
        for (const a of b.args) { args = args.concat([hostArgJs(a, params)]); }
        if (b.chain.length > 0 && b.guards.length > 0) {
            const last: string = b.chain[b.chain.length - 1];
            if (b.shape == 3 && b.guards.indexOf("url") >= 0) args = [rtCall(ctx, "hostUrl", [recv, jstr(last), args[0], jstr(at0)])];
            if (b.guards.indexOf("attr-name") >= 0 && args.length > 0) {
                const nameArg: JsExpr = args[0];
                let next: JsExpr[] = [rtCall(ctx, "hostSetAttrName", [nameArg, jstr(at0)])];
                if (last == "setAttribute" && args.length > 1) next = next.concat([rtCall(ctx, "hostAttrValue", [recv, nameArg, args[1], jstr(at0)])]);
                args = next;
            }
            base = jmember(recvG, last);
        } else {
            for (const m of b.chain) { base = jmember(base, m); }
        }
        let thunk: JsExpr = JsExpr.JArrowE([], jcall(base, args));
        if (b.shape == 1) thunk = JsExpr.JArrowE([], JsExpr.JNew(base, args));
        if (b.shape == 2) thunk = JsExpr.JArrowE([], base);
        if (b.shape == 3) thunk = JsExpr.JArrow([], [JsStmt.SAssign(base, args[0])]);
        let desc: JsExpr = hostKind("void");
        let body: JsStmt[] = [];
        if (ret is given) {
            const hoist: Sym[] = hostDescHoist(ctx, ret);
            let k: int = 0;
            for (; k < hoist.length; ) {
                body = body.concat([JsStmt.SConst(hostDescName(k), hostNamedDesc(ctx, hoist[k], 0, hoist, k))]);
                k = k + 1;
            }
            desc = hostDescJs(ctx, ret, 0, hoist);
        }
        const at: string = f.sym.hint + "() — the `<host>` binding";
        return JsStmt.SFunc(symName(ctx, f.sym), params, body.concat([JsStmt.SReturn(rtCall(ctx, "hostCall", [thunk, desc, jstr(at)]))]));
    }

    // s480 (g-boot-host-desc-exponential-s480, review:#1991 F2) — the decode descriptor is a DAG,
    // printed as one. A struct type the descriptor names from TWO or more places (two fields, a
    // field and the result, …) is printed once, as a `const hostty$K` at the top of the binding's
    // function, and named from each place; every other type is printed where it stands, as before.
    // The tree printing repeated a shared struct at every path: 16 fields per struct, depth 4 was a
    // 6.3 MB client.js, depth 5 101 MB, depth 6 out of memory — for a clean 6-declaration program.
    // The runtime decode (runtime.js hostDecode) only READS the descriptor, so a shared object is
    // decoded exactly as its copies were. The order is post-order (a hoisted struct after every
    // struct it names), and a descriptor has no cycle: rule 13's decode check refuses a result type
    // more than 12 steps deep (analyze.scrml hostResultOk, check.scrml hostDecodes C-HB4), and a
    // cyclic struct is unboundedly deep.
    type HostDescPlan:struct = { ids: int[], counts: int[], syms: Sym[], order: int[] }

    fn hostDescName(k: int) -> string { return "hostty$" + k; }

    // The structs to hoist, in post-order: those named from two or more places.
    fn hostDescHoist(ctx: Ctx, t: Type) -> Sym[] {
        const pl: HostDescPlan = hostPlanType(ctx, t, { ids: [], counts: [], syms: [], order: [] });
        let out: Sym[] = [];
        for (const id of pl.order) {
            const k: int = pl.ids.indexOf(id);
            if (pl.counts[k] >= 2) out = out.concat([pl.syms[k]]);
        }
        return out;
    }

    fn hostPlanType(ctx: Ctx, t: Type, pl: HostDescPlan) -> HostDescPlan {
        return match t {
            .Maybe(inner: i) :> hostPlanType(ctx, i, pl),
            .Seq(elem: e) :> hostPlanType(ctx, e, pl),
            .Named(sym: s) :> hostPlanNamed(ctx, s, pl),
            .Int :> pl,
            .Num :> pl,
            .Str :> pl,
            .Bool :> pl,
            .Fn(params: ps) :> pl
        };
    }

    fn hostPlanNamed(ctx: Ctx, s: Sym, pl: HostDescPlan) -> HostDescPlan {
        const k: int = pl.ids.indexOf(s.id);
        if (k >= 0) {
            const counts: int[] = pl.counts.slice(0, k).concat([pl.counts[k] + 1]).concat(pl.counts.slice(k + 1));
            return { ids: pl.ids, counts: counts, syms: pl.syms, order: pl.order };
        }
        const td: TypeDef | not = findTypeDef(ctx.p, s);
        if (td is not) return pl;
        const fs: FieldDef[] | not = hostStructFieldsOf(td);
        if (fs is not) return pl;
        let q: HostDescPlan = { ids: pl.ids.concat([s.id]), counts: pl.counts.concat([1]), syms: pl.syms.concat([s]), order: pl.order };
        for (const fd of fs) { q = hostPlanType(ctx, fd.ty, q); }
        return { ids: q.ids, counts: q.counts, syms: q.syms, order: q.order.concat([s.id]) };
    }

    fn hostStructFieldsOf(td: TypeDef) -> FieldDef[] | not {
        return match td {
            .StructDef(fields: fs) :> fs,
            .HostDef(sym: x) :> not,
            .EnumDef(sym: x) :> not
        };
    }

    // The index of `s` among the hoisted structs, or -1.
    fn hostHoistIndex(hoist: Sym[], s: Sym) -> int {
        let k: int = 0;
        for (; k < hoist.length; ) {
            if (hoist[k].id == s.id) return k;
            k = k + 1;
        }
        return -1;
    }

    fn hostArgJs(a: HostArg, params: string[]) -> JsExpr {
        return match a {
            .HParam(idx: i) :> jid(params[i]),
            .HStr(v: s) :> jstr(s),
            .HNum(raw: r) :> JsExpr.JNum(r),
            .HBool(v: b) :> JsExpr.JBool(b),
            .HObj(props: ps) :> hostObjJs(ps, params)
        };
    }

    fn hostObjJs(ps: HostProp[], params: string[]) -> JsExpr {
        let out: JsProp[] = [];
        for (const p of ps) { out = out.concat([{ key: p.key, value: hostArgJs(p.value, params) }]); }
        return JsExpr.JObject(out);
    }

    // The decode descriptor of a binding's declared result (rule 13) — check.scrml C-HB4.
    // `hoist`: the structs printed once as `hostty$K` (hostDescHoist) — a reference to one is its name.
    fn hostDescJs(ctx: Ctx, t: Type, depth: int, hoist: Sym[]) -> JsExpr {
        return match t {
            .Int :> hostKind("int"),
            .Num :> hostKind("number"),
            .Str :> hostKind("string"),
            .Bool :> hostKind("bool"),
            .Maybe(inner: i) :> JsExpr.JObject([{ key: "k", value: jstr("maybe") }, { key: "inner", value: hostDescJs(ctx, i, depth + 1, hoist) }]),
            .Seq(elem: e) :> JsExpr.JObject([{ key: "k", value: jstr("tape") }, { key: "elem", value: hostDescJs(ctx, e, depth + 1, hoist) }]),
            .Named(sym: s) :> hostNamedDesc(ctx, s, depth, hoist, -1),
            .Fn(params: ps) :> hostKind("unchecked")   // unreachable: analyze refuses a function type in a host binding (resolveType)
        };
    }

    // `selfK`: the index of the hoisted struct whose `const` this is (printed in full, not named), else -1.
    fn hostNamedDesc(ctx: Ctx, s: Sym, depth: int, hoist: Sym[], selfK: int) -> JsExpr {
        const hk: int = hostHoistIndex(hoist, s);
        if (hk >= 0 && hk != selfK) return jid(hostDescName(hk));
        const td: TypeDef | not = findTypeDef(ctx.p, s);
        if (td is not) return hostKind("unchecked");
        if (depth > 12) return hostKind("unchecked");
        return hostDefDesc(ctx, s, td, depth, hoist);
    }

    // s473-host-allowlist-b (DRAFT §21.3.3 rules 8.4, 8.7): an Appendix H interface result is decoded
    // by the brand check (`{ k: "iface", name }`, runtime.js hostBranded) — a downcast and a `src=`
    // result included; a user-named `:host` handle (the `src=` world) only by non-null (`handle`).
    fn hostHandleKind(name: string) -> string {
        if (isSurfaceIface(name)) return "iface";
        return "handle";
    }

    fn hostDefDesc(ctx: Ctx, s: Sym, td: TypeDef, depth: int, hoist: Sym[]) -> JsExpr {
        return match td {
            .HostDef(sym: x) :> JsExpr.JObject([{ key: "k", value: jstr(hostHandleKind(s.hint)) }, { key: "name", value: jstr(s.hint) }]),
            .StructDef(fields: fs) :> hostStructDesc(ctx, s, fs, depth, hoist),
            .EnumDef(sym: x) :> hostKind("unchecked")
        };
    }

    fn hostStructDesc(ctx: Ctx, s: Sym, fs: FieldDef[], depth: int, hoist: Sym[]) -> JsExpr {
        let fields: JsExpr[] = [];
        for (const fd of fs) {
            fields = fields.concat([JsExpr.JObject([{ key: "name", value: jstr(fd.sym.hint) }, { key: "ty", value: hostDescJs(ctx, fd.ty, depth + 1, hoist) }])]);
        }
        return JsExpr.JObject([{ key: "k", value: jstr("struct") }, { key: "name", value: jstr(s.hint) }, { key: "fields", value: JsExpr.JArray(fields) }]);
    }

    // The return-point decode's descriptor of a (scalar, or scalar `T | not`) type — check.scrml C-H2.
    fn hostTypeJs(t: Type) -> JsExpr {
        return match t {
            .Int :> hostKind("int"),
            .Num :> hostKind("number"),
            .Str :> hostKind("string"),
            .Bool :> hostKind("bool"),
            .Maybe(inner: i) :> JsExpr.JObject([{ key: "k", value: jstr("maybe") }, { key: "inner", value: hostTypeJs(i) }]),
            .Named(sym: s) :> hostKind("unchecked"),
            .Seq(elem: e) :> hostKind("unchecked"),
            .Fn(params: ps) :> hostKind("unchecked")   // unreachable: analyze refuses a function type in a host binding (resolveType)
        };
    }

    fn hostKind(k: string) -> JsExpr { return JsExpr.JObject([{ key: "k", value: jstr(k) }]); }

    // s477 — a NESTED function (Stmt.LocalFn, §7.3.1), printed where it stands as
    // a host function declaration: "closes over the outer function's `let`,
    // `const`, and `lin` bindings with standard JavaScript closure semantics",
    // and a host declaration is hoisted to its block (§48.6.4). It never waits,
    // so it returns plainly (`ret` "") whatever its enclosing function does; it
    // stands at the top of a function body, so no row, loop or Tier-0 context
    // reaches it. Its shared-instance reads use the enclosing function's
    // prologue locals (sharedRefs walks into it).
    // s478 (s478-boot-block-lambda) — the context a block lambda's body prints in: the
    // enclosing one's names and bindings (it closes over them), but its Returns are plain
    // `return`s of the lambda (never a waiting function's `ret$` continuation), and the
    // locals it owns are its own.
    fn lambdaCtx(ctx: Ctx, b: Block) -> Ctx {
        return { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared, rows: ctx.rows, slot: ctx.slot, prebuilt: ctx.prebuilt, ret: "", server: ctx.server, tier0: not, cycles: [], ns: ctx.ns, owned: ownedLocals(b) };
    }

    fn localFnJs(ctx: Ctx, f: Fn) -> JsStmt {
        const fctx: Ctx = { p: ctx.p, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared, rows: ctx.rows, slot: ctx.slot, prebuilt: ctx.prebuilt, ret: "", server: ctx.server, tier0: not, cycles: [], ns: ctx.ns, owned: ownedLocals(f.body) };
        let params: string[] = [];
        for (const p of f.params) { params = params.concat([symName(ctx, p.sym)]); }
        return JsStmt.SFunc(symName(ctx, f.sym), params, blockJs(fctx, f.body));
    }

    fn fnJs(ctx: Ctx, f: Fn) -> JsStmt {
        const hf: HostFn | not = f.host;
        if (hf is given) return hostFnJs(ctx, f, hf);
        // Prologue: one local per shared instance the body references.
        let prologue: JsStmt[] = [];
        let shared: SharedLoc[] = [];
        for (const d of dedupe(sharedRefs(Node.NFn(f)))) {
            const local: string = d.hint.replaceAll("$", "_") + "$";
            prologue = prologue.concat([JsStmt.SConst(local, jcall(jid(nameOf(ctx.names, NameKey.SharedGet(d.id))), []))]);
            shared = shared.concat([{ decl: d.id, js: jid(local) }]);
        }
        let ret: string = "";
        if (f.waits) ret = "ret$";
        // s476: a function that does not wait prints its body straight through, so its owned
        // locals' edits are made in place; a waiting one's body is continuations (copies, as before)
        let owned: OwnedLocal[] = [];
        if (!f.waits) owned = ownedLocals(f.body);
        const fctx: Ctx = { p: ctx.p, pix: ctx.pix, names: ctx.names, lexical: [], handles: [], shared: shared, rows: [], slot: JsExpr.JNull, prebuilt: false, ret: ret, server: false, tier0: not, cycles: [], ns: ctx.ns, owned: owned };
        let params: string[] = [];
        for (const p of f.params) { params = params.concat([symName(ctx, p.sym)]); }
        if (!f.waits) return JsStmt.SFunc(symName(ctx, f.sym), params, prologue.concat(blockJs(fctx, f.body)));
        // s454 (U1b) — a WAITING function (Fn.waits, §13.2 async colour; design
        // §2.3 "a return continuation"): it takes its caller's task first and
        // returns a Promise its body settles — `return ret$(v)` on every exit,
        // from the body or from any continuation (lower ends every path that
        // falls off with an explicit Return). `rt.waiting` never rejects through
        // a scrml failure: a `fail` resolves with the Failure value.
        return JsStmt.SFunc(symName(ctx, f.sym), ["task$"].concat(params),
            prologue.concat([JsStmt.SReturn(rtCall(ctx, "waiting", [jid("task$"), JsExpr.JArrow(["ret$"], blockJs(fctx, f.body))]))]));
    }

    // -------------------------------------------------------------------------
    // s468 (U1c) — the SERVER artifact's pieces (print-server.scrml assembles
    // them). The names: the client's NameTable with every ServerFn minted after
    // (so no client name changes), the runtime as `rt`. A server-side function
    // is `async function` iff Core says it WAITS (Fn.waits / ServerFn.waits —
    // check.scrml C-S8 / C-S8s), its body printed in server mode (blockJs:
    // `await` at each Suspend and nowhere else). No prologue: a server-reached
    // body touches no shared instance (check.scrml C-S1).
    // -------------------------------------------------------------------------
    export fn serverCtx(p: CoreProgram) -> Ctx {
        let names: NameTable = planNames(p);
        for (const sf of p.server) { names = mint(names, NameKey.OfSym(sf.sym.id), sf.sym.hint); }
        return { p: p, pix: printIx(p), names: names, lexical: [], handles: [], shared: [], rows: [], slot: JsExpr.JNull, prebuilt: false, ret: "", server: true, tier0: not, cycles: [], ns: htmlNs(), owned: [] };
    }

    export fn serverFnJs(ctx: Ctx, sym: Sym, params: Param[], body: Block, waits: boolean) -> JsStmt {
        let ps: string[] = [];
        for (const prm of params) { ps = ps.concat([symName(ctx, prm.sym)]); }
        // s476: a server body prints natively (an `await` in place), so its owned locals' edits are in place
        const octx: Ctx = withOwned(ctx, ownedLocals(body));
        if (waits) return JsStmt.SAsyncFunc(symName(ctx, sym), ps, blockJs(octx, body));
        return JsStmt.SFunc(symName(ctx, sym), ps, blockJs(octx, body));
    }

    // s474 (U1e) — a `!` function with an Envelope (CoreProgram.envelopes, SPEC
    // §8.9.2 / §19.10.5 / §19.10.6), on the SERVER: its body, unchanged, as the
    // inner `body$`, run by the runtime inside the transaction —
    //   async function move(a) {
    //     async function body$() { … }
    //     return await rt.envelope(db$1, body$, true);
    //   }
    // The envelope reads the body's result: a failure (`fail`, `?`) rolls back
    // and is returned unchanged; a throw rolls back and continues; anything else
    // commits. The function waits (check.scrml C-TX2 — its set holds a query),
    // so its callers already await it; the `await` here is the envelope's.
    // S474 ruling 5: the fourth argument spells the envelope's BEGIN — "IMMEDIATE" when its query
    // set writes (core.scrml Envelope.writes, decided by analyze), "DEFERRED" when it only reads.
    export fn envelopedFnJs(ctx: Ctx, sym: Sym, params: Param[], body: Block, db: Sym, standalone: boolean, writes: boolean) -> JsStmt {
        let ps: string[] = [];
        for (const prm of params) { ps = ps.concat([symName(ctx, prm.sym)]); }
        let begin: string = "DEFERRED";
        if (writes) begin = "IMMEDIATE";
        const run: JsExpr = rtCall(ctx, "envelope", [jid(dbVarName(db)), jid("body$"), JsExpr.JBool(standalone), JsExpr.JStr(begin)]);
        return JsStmt.SAsyncFunc(symName(ctx, sym), ps, [
            JsStmt.SAsyncFunc("body$", [], blockJs(withOwned(ctx, ownedLocals(body)), body)),
            JsStmt.SReturn(JsExpr.JAwait(run)),
        ]);
    }

    // -------------------------------------------------------------------------
    // The program.
    // -------------------------------------------------------------------------
    // s451 (U1a) — THE SERVER REFUSAL. Route inference now places functions on
    // the server (§12.2) and a ServerFn reaches Core, but the bootstrap prints
    // only the CLIENT artifact. A program with server functions printed without
    // them would be the client half of a program whose server half does not
    // exist — §12.3 obliges a route handler and a client fetch call for EVERY
    // server-escalated function. So the whole program is refused, naming the
    // slice that lifts it, rather than printed incomplete.
    // s454 (U1b): the refusal of a program WITH server functions is lifted —
    // the client artifact is printed (s468: print-server.scrml prints the server half). A query
    // anywhere but a server function is still refused (C-S2 makes it
    // unrepresentable; this keeps the printer fail-closed on a bad Core).
    fn serverRefusal(p: CoreProgram) -> string[] {
        let out: string[] = [];
        if (holdsQuery(p) && p.server.length == 0) {
            out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: this program holds a `?{}` query outside a server function — the client printer has no SQL (a query stands only in a server function, check.scrml C-S2)"]);
        }
        return out.concat(channelRefusal(p));
    }

    // =========================================================================
    // s478 (s478-boot-channel) — SPEC §38.7 "The compiler emits a client-side IIFE …
    // It manages connect, reconnect …, message dispatch, channel-scoped cell sync
    // (the auto-sync wire layer for cells declared in the channel body — §38.4), and
    // cleanup registration." One `rt.channel(prog$.scope, { … })` per channel, after
    // the program is constructed and mounted (runtime.js `channel`): its name, its
    // reconnect delay, per synced cell the sync key (the cell's name), its signal and
    // its §57 wire table (the SAME table the server artifact decodes a frame with —
    // print-server channelConsts), and its `onclient:*` hooks (§38.10).
    // Refused by name (the printer does not build it): a `watches=` feed (§38.13 —
    // the Postgres LISTEN bridge), a synced cell with no wire table, with a timing
    // rule (§6.13) or browser persistence (§6.14) — the SPEC composes neither with
    // §38.4 sync —, and a hook whose function waits (§13.2: it calls the server).
    // =========================================================================
    export fn channelRefusal(p: CoreProgram) -> string[] {
        let out: string[] = [];
        for (const ch of p.channels) {
            const at: string = "`<channel name=\"" + ch.name + "\">`";
            if (ch.watches != "") {
                out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + at + " is a `watches=" + ch.watches + "` change feed — its Postgres LISTEN/NOTIFY capture and `<onchange>` dispatch (§38.13.7) are not built (INTERIM, g-boot-channel-s478)"]);
            }
            for (const c of ch.cells) {
                const fd: Field | not = programField(p, c);
                if (fd is not) {
                    out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + at + "'s cell `" + c.hint + "` is not a field of the program — the Core is ill-formed"]);
                } else {
                    if (wireBuild(p, fd.ty).table is not) out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + at + "'s cell `" + c.hint + "` has a type with no §57 wire form, so it cannot be synchronized (§38.4)"]);
                    if (fd.persist is given) out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + at + "'s cell `" + c.hint + "` is `persist=` — the SPEC does not compose browser persistence (§6.14) with channel sync (§38.4); INTERIM, g-boot-channel-s478"]);
                    if (fd.timing is given) out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + at + "'s cell `" + c.hint + "` is `debounced=` / `throttled=` — the SPEC does not compose a timing rule (§6.13) with channel sync (§38.4); INTERIM, g-boot-channel-s478"]);
                }
            }
            for (const h of [ch.open, ch.close, ch.error]) {
                if (h is given) {
                    const hf: Fn | not = findFn(p, h);
                    const why: string = "E-BOOTSTRAP-UNSUPPORTED: " + at + "'s `onclient:*` handler `" + h.hint + "()` is not a client function of the program (§38.10.2: \"`onclient:*` handlers SHALL execute on the client only\")";
                    if (hf is not) {
                        out = out.concat([why]);
                    } else if (hasInt(serverOnlyFns(p).concat(reachedOnlyByServer(p)), h.id)) {
                        out = out.concat([why]);
                    } else if (hf.waits) {
                        out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + at + "'s `onclient:*` handler `" + h.hint + "()` calls the server (§13.2 — it waits); a WebSocket event handler does not wait (INTERIM, g-boot-channel-s478)"]);
                    }
                }
            }
        }
        return out;
    }

    fn programField(p: CoreProgram, s: Sym) -> Field | not {
        for (const d of p.decls) {
            if (d.sym.id == p.program.id) {
                for (const f of d.fields) { if (f.sym.id == s.id) return f; }
            }
        }
        return not;
    }

    fn programFieldIdx(p: CoreProgram, s: Sym) -> int {
        for (const d of p.decls) {
            if (d.sym.id == p.program.id) {
                let i = 0;
                for (const f of d.fields) {
                    if (f.sym.id == s.id) return i;
                    i = i + 1;
                }
            }
        }
        return -1;
    }

    // =========================================================================
    // S479 (s479-channel-relay-fold) — SPEC §38.4.2 "The relay's fold" (ruling: user-voice S479
    // "⭐ RULED — S478 hand-off §3.A and §3.B", item 7: "the relay fold — a relay-computed state used
    // to judge and close senders of refused frames, and as a compaction base in the replay"). The
    // relay folds a channel only when the source alone fixes the value every client starts the
    // channel from and every write that applying a frame causes: "A channel has a fold when each of
    // its cells is initialized by a literal value, … no body-top statement writes one of its cells,
    // no `<request>` writes one, and every `reset-on=` rule that resets one of its cells is
    // triggered only by cells of the same channel and resets it to a literal value." `chFoldWhy`:
    // "" when it does, else why not (the server desc's `noFold` — the relay then judges nothing and
    // truncates at the log bound, as before). `chResets`: the `reset-on=` rules the fold makes.
    // =========================================================================
    export type ChReset:struct = { cell: string, on: string[], rank: int, value: Expr }
    type ChWrite:struct = { cap: Sym, edit: EditKind, value: Expr }

    export fn chFoldWhy(p: CoreProgram, ch: CoreChannel) -> string {
        for (const c of ch.cells) {
            const fd: Field | not = programField(p, c);
            if (fd is not) return "@" + c.hint + " is not a field of the program";
            const init: Expr | not = fd.init;
            if (init is not) return "@" + c.hint + " has no initializer";
            if (!chConstExpr(init)) return "@" + c.hint + "'s initializer is not a literal value, so the relay cannot know the value clients start it from";
        }
        const all: Node[] = allNodes(Node.NProgram(p));
        let runs: Block[] = [];
        for (const n of all) {
            const why: string = chNodeWhy(p, ch, n);
            if (why != "") return why;
            runs = runs.concat(nodeRunBody(n));
        }
        const caps: int[] = chCaps(p, ch);
        for (const id of writtenCaps(p, runs)) {
            if (caps.indexOf(id) >= 0) return "a body-top statement (§40.8) writes a cell of the channel when the page mounts, so a client may start the channel from a value the source does not fix";
        }
        return "";
    }

    export fn chResets(p: CoreProgram, ch: CoreChannel) -> ChReset[] {
        let out: ChReset[] = [];
        for (const n of allNodes(Node.NProgram(p))) { out = out.concat(chNodeReset(p, ch, n)); }
        return out;
    }

    // The channel desc's `init` / reset value of a cell (a literal, chConstExpr), as the client prints it.
    export fn chValueJs(ctx: Ctx, e: Expr) -> JsExpr { return exprJs(ctx, e); }

    // A `rule=` field's edge table, by variant tag (the SAME table the client's `<field>_edges` holds), or null.
    export fn chEdgesJs(ctx: Ctx, f: Field) -> JsExpr {
        const g: TransitionGraph | not = f.graph;
        if (g is not) return JsExpr.JNull;
        let props: JsProp[] = [];
        for (const e of g.edges) {
            let targets: JsExpr[] = [];
            for (const t of e.targets) { targets = targets.concat([jstr(variantTag(ctx, g.enumSym, t))]); }
            props = props.concat([{ key: variantTag(ctx, g.enumSym, e.origin), value: JsExpr.JArray(targets) }]);
        }
        return JsExpr.JObject(props);
    }

    fn chConstExpr(e: Expr) -> boolean {
        return match e {
            .Lit(lit: x) :> true,
            .ArrayOf(elems: es) :> chConstAll(es),
            .StructOf(ty: x, fields: fs) :> chConstAll(fs),
            .VariantOf(enumSym: x, idx: y, args: va) :> chConstAll(va),
            .Local(sym: x) :> false,
            .Read(place: x) :> false,
            .Call(callee: x) :> false,
            .Prim(op: x) :> false,
            .Match(scrut: x) :> false,
            .Handle(inst: x) :> false,
            .InitOf(decl: x) :> false,
            .Host(call: x) :> false,
            .Lambda(params: x) :> false,
            .BlockLambda(params: x) :> false,
            .SeqCall(op: x) :> false,
            .Validity(of: x) :> false,
            .Refetch(req: x) :> false,
            .ServerCall(fn: x) :> false,
            .Query(q: x) :> false,
            .Assigned(local: x) :> false,
            .Foreign(slice: x) :> false,
            .FnRef(fn: x) :> false,
            .CallV(f: x) :> false,
            .FCall(fn: x) :> false,
            .FSettled(outcome: x) :> false,
            .FParse(json: x) :> false,
            .FCallV(f: x) :> false
        };
    }

    fn chConstAll(es: Expr[]) -> boolean {
        for (const e of es) { if (!chConstExpr(e)) return false; }
        return true;
    }

    // The write capabilities (sym ids) of the channel's cells.
    fn chCaps(p: CoreProgram, ch: CoreChannel) -> int[] {
        let out: int[] = [];
        for (const c of ch.cells) {
            const fd: Field | not = programField(p, c);
            if (fd is given) {
                const w: Sym | not = fd.wcap;
                if (w is given) out = out.concat([w.id]);
            }
        }
        return out;
    }

    // The program field a write capability writes, or not.
    fn chCapField(p: CoreProgram, cap: Sym) -> Field | not {
        for (const d of p.decls) {
            if (d.sym.id == p.program.id) {
                for (const f of d.fields) {
                    const w: Sym | not = f.wcap;
                    if (w is given && w.id == cap.id) return f;
                }
            }
        }
        return not;
    }

    // The program field a dependency names, when it is a cell of `ch`.
    fn chDepCell(p: CoreProgram, ch: CoreChannel, d: EffectDep) -> Sym | not {
        if (d.decl.id != p.program.id) return not;
        for (const pd of p.decls) {
            if (pd.sym.id == p.program.id && d.idx >= 0 && d.idx < pd.fields.length) {
                const s: Sym = pd.fields[d.idx].sym;
                for (const c of ch.cells) { if (c.id == s.id) return s; }
            }
        }
        return not;
    }

    fn chIsCell(ch: CoreChannel, s: Sym) -> boolean {
        for (const c of ch.cells) { if (c.id == s.id) return true; }
        return false;
    }

    fn nodeRunBody(n: Node) -> Block[] {
        return match n {
            .NView(v: v) :> viewRunBody(v),
            .NProgram(p: x) :> [],
            .NDecl(d: x) :> [],
            .NField(f: x) :> [],
            .NFn(f: x) :> [],
            .NServerFn(f: x) :> [],
            .NBlock(b: x) :> [],
            .NStmt(s: x) :> [],
            .NExpr(e: x) :> [],
            .NPlace(pl: x) :> [],
            .NInst(i: x) :> [],
            .NPattern(pat: x) :> [],
            .NEdit(k: x) :> [],
            .NAttr(a: x) :> []
        };
    }

    fn viewRunBody(v: View) -> Block[] {
        return match v {
            .Run(body: b) :> [b],
            .Init :> [],
            .El :> [],
            .Text :> [],
            .RawText :> [],
            .Dyn :> [],
            .Cond :> [],
            .Each :> [],
            .Instance :> [],
            .Slot :> [],
            .Star :> [],
            .Effect :> [],
            .Request :> [],
            .ResetOn :> [],
            .Errors :> [],
            .Reach :> [],
            .Gather :> []
        };
    }

    fn chNodeWhy(p: CoreProgram, ch: CoreChannel, n: Node) -> string {
        return match n {
            .NView(v: v) :> chViewWhy(p, ch, v),
            .NProgram(p: x) :> "",
            .NDecl(d: x) :> "",
            .NField(f: x) :> "",
            .NFn(f: x) :> "",
            .NServerFn(f: x) :> "",
            .NBlock(b: x) :> "",
            .NStmt(s: x) :> "",
            .NExpr(e: x) :> "",
            .NPlace(pl: x) :> "",
            .NInst(i: x) :> "",
            .NPattern(pat: x) :> "",
            .NEdit(k: x) :> "",
            .NAttr(a: x) :> ""
        };
    }

    fn chViewWhy(p: CoreProgram, ch: CoreChannel, v: View) -> string {
        return match v {
            .Request(target: t) :> chRequestWhy(p, ch, t),
            .ResetOn(triggers: ds, reset: b) :> chResetWhy(p, ch, ds, b),
            .El :> "",
            .Text :> "",
            .RawText :> "",
            .Dyn :> "",
            .Cond :> "",
            .Each :> "",
            .Instance :> "",
            .Slot :> "",
            .Star :> "",
            .Effect :> "",
            .Run :> "",
            .Init :> "",
            .Errors :> "",
            .Reach :> "",
            .Gather :> ""
        };
    }

    fn chRequestWhy(p: CoreProgram, ch: CoreChannel, t: EffectDep) -> string {
        const s: Sym | not = chDepCell(p, ch, t);
        if (s is given) return "@" + s.hint + " is the target of a <request>, whose result is written on each client";
        return "";
    }

    fn chResetWhy(p: CoreProgram, ch: CoreChannel, ds: EffectDep[], b: Block) -> string {
        const w: ChWrite | not = chResetWrite(b);
        if (w is not) return "";
        const f: Field | not = chCapField(p, w.cap);
        if (f is not) return "";
        if (!chIsCell(ch, f.sym)) return "";
        for (const d of ds) {
            if (chDepCell(p, ch, d) is not) return "@" + f.sym.hint + "'s reset-on= has a trigger that is not a cell of this channel, so it is reset on each client by a change the relay does not see";
        }
        if (!editIsReplace(w.edit)) return "@" + f.sym.hint + "'s reset-on= reset is a move along its rule= graph, which the relay does not make";
        if (!chConstExpr(w.value)) return "@" + f.sym.hint + "'s reset-on= value is not a literal value";
        return "";
    }

    fn chNodeReset(p: CoreProgram, ch: CoreChannel, n: Node) -> ChReset[] {
        return match n {
            .NView(v: v) :> chViewReset(p, ch, v),
            .NProgram(p: x) :> [],
            .NDecl(d: x) :> [],
            .NField(f: x) :> [],
            .NFn(f: x) :> [],
            .NServerFn(f: x) :> [],
            .NBlock(b: x) :> [],
            .NStmt(s: x) :> [],
            .NExpr(e: x) :> [],
            .NPlace(pl: x) :> [],
            .NInst(i: x) :> [],
            .NPattern(pat: x) :> [],
            .NEdit(k: x) :> [],
            .NAttr(a: x) :> []
        };
    }

    fn chViewReset(p: CoreProgram, ch: CoreChannel, v: View) -> ChReset[] {
        return match v {
            .ResetOn(triggers: ds, reset: b, rank: r) :> chResetOf(p, ch, ds, b, r),
            .El :> [],
            .Text :> [],
            .RawText :> [],
            .Dyn :> [],
            .Cond :> [],
            .Each :> [],
            .Instance :> [],
            .Slot :> [],
            .Star :> [],
            .Effect :> [],
            .Run :> [],
            .Init :> [],
            .Request :> [],
            .Errors :> [],
            .Reach :> [],
            .Gather :> []
        };
    }

    fn chResetOf(p: CoreProgram, ch: CoreChannel, ds: EffectDep[], b: Block, rank: int) -> ChReset[] {
        const w: ChWrite | not = chResetWrite(b);
        if (w is not) return [];
        const f: Field | not = chCapField(p, w.cap);
        if (f is not) return [];
        if (!chIsCell(ch, f.sym)) return [];
        let on: string[] = [];
        for (const d of ds) {
            const s: Sym | not = chDepCell(p, ch, d);
            if (s is given) on = on.concat([s.hint]);
        }
        const r: ChReset = { cell: f.sym.hint, on: on, rank: rank, value: w.value };
        return [r];
    }

    // A `reset-on=` rule's ONE Write (check.scrml C13).
    fn chResetWrite(b: Block) -> ChWrite | not {
        if (b.stmts.length != 1) return not;
        return match b.stmts[0] {
            .Write(cap: c, edit: k, value: v) :> chWrite(c, k, v),
            .Let(sym: x) :> not,
            .Assign(local: x) :> not,
            .Commit(writes: x) :> not,
            .If(cond: x) :> not,
            .Return(e: x) :> not,
            .Eval(e: x) :> not,
            .Suspend(bind: x) :> not,
            .ResetSurface(of: x) :> not,
            .Defer(body: x) :> not,
            .Unpersist(decl: x) :> not,
            .Attempt(result: x) :> not,
            .Fail(err: x) :> not,
            .Join(k: x) :> not,
            .Jump(k: x) :> not,
            .Loop(label: x) :> not,
            .Break(target: x) :> not,
            .Continue(target: x) :> not,
            .Gather(g: x) :> not,
            .Lift(into: x) :> not,
            .LocalFn(f: x) :> not
        };
    }

    fn chWrite(c: Sym, k: EditKind, v: Expr) -> ChWrite | not {
        const w: ChWrite = { cap: c, edit: k, value: v };
        return w;
    }

    fn editIsReplace(k: EditKind) -> boolean {
        return match k {
            .Replace :> true,
            .Append :> false,
            .Prepend :> false,
            .Anywhere :> false,
            .PositionWrite :> false,
            .FieldAt(path: x) :> false,
            .Transition :> false,
            .RemoveEnd :> false,
            .RemoveFront :> false,
            .RemoveAnywhere :> false,
            .ElemAt(index: x) :> false,
            .PositionAt(index: x) :> false
        };
    }

    fn channelBoot(ctx: Ctx, p: CoreProgram, progLocal: string) -> JsStmt[] {
        if (p.channels.length == 0) return [];
        let pd: Decl | not = not;
        for (const d of p.decls) { if (d.sym.id == p.program.id) pd = d; }
        if (pd is not) return [];
        let out: JsStmt[] = [JsStmt.SComment("the §38 channels — each cell declared in a channel body is synchronized across the channel's clients (§38.4)")];
        for (const ch of p.channels) {
            let cells: JsExpr[] = [];
            let ci: int = 0;
            for (const c of ch.cells) {
                const fd: Field | not = programField(p, c);
                const idx: int = programFieldIdx(p, c);
                if (fd is given && idx >= 0) {
                    // s478 (s478-boot-channel-ops) — §38.4.2: the op kinds the cell syncs (the
                    // sender's and every receiver's check) and, for a `rule=` field, its edge table
                    // (the receiver checks a `transition` against the CURRENT variant)
                    let edges: JsExpr = JsExpr.JNull;
                    if (fd.graph is given) edges = jid(nameOf(ctx.names, NameKey.Edges(pd.sym.id, idx)));
                    cells = cells.concat([JsExpr.JObject([
                        { key: "key", value: jstr(c.hint) },
                        { key: "cell", value: fieldCell(jid(progLocal), pd, idx) },
                        { key: "table", value: wireOrNull(p, fd.ty) },
                        { key: "ops", value: chOpsJs(ch.ops, ci) },
                        { key: "edges", value: edges },
                    ])]);
                }
                ci = ci + 1;
            }
            out = out.concat([sexpr(rtCall(ctx, "channel", [jmember(jid(progLocal), "scope"), JsExpr.JObject([
                { key: "name", value: jstr(ch.name) },
                { key: "reconnect", value: jnum(ch.reconnect) },
                // §38.4.3 (S478 fix r1, MED-3): the relay's bounds, so the client paces its frames to them
                { key: "limits", value: JsExpr.JObject([
                    { key: "maxFrame", value: jnum(ch.maxFrame) },
                    { key: "rate", value: jnum(ch.rate) },
                    { key: "burst", value: jnum(ch.burst) },
                ]) },
                { key: "cells", value: JsExpr.JArray(cells) },
                { key: "open", value: channelHookJs(ctx, ch.open) },
                { key: "close", value: channelHookJs(ctx, ch.close) },
                { key: "error", value: channelHookJs(ctx, ch.error) },
            ])]))]);
        }
        return out;
    }

    // `ops[i]` (CoreChannel, space-separated) as a JS array of op names; [] when absent (nothing is sent or applied)
    export fn chOpsJs(ops: string[], i: int) -> JsExpr {
        let out: JsExpr[] = [];
        if (i < ops.length) {
            for (const o of ops[i].split(" ")) {
                if (o != "") out = out.concat([jstr(o)]);
            }
        }
        return JsExpr.JArray(out);
    }

    fn channelHookJs(ctx: Ctx, h: Sym | not) -> JsExpr {
        if (h is not) return JsExpr.JNull;
        return JsExpr.JArrowE([], jcall(jid(symName(ctx, h)), []));
    }

    fn holdsTxBlock(f: Fn) -> boolean {
        for (const n of allNodes(Node.NFn(f))) {
            if (nodeIsTxBlock(n)) return true;
        }
        return false;
    }

    fn nodeIsTxBlock(n: Node) -> boolean {
        return match n {
            .NStmt(s: s) :> stmtTxOf(s) is given,
            .NExpr(e: x) :> false,
            .NProgram(p: x) :> false,
            .NDecl(d: x) :> false,
            .NField(f: x) :> false,
            .NFn(f: x) :> false,
            .NServerFn(f: x) :> false,
            .NBlock(b: x) :> false,
            .NPlace(pl: x) :> false,
            .NInst(i: x) :> false,
            .NPattern(pat: x) :> false,
            .NEdit(k: x) :> false,
            .NView(v: x) :> false,
            .NAttr(a: x) :> false
        };
    }

    fn stmtTxOf(s: Stmt) -> Sym | not {
        return match s {
            .If(cond: c, tx: tx) :> tx,
            .Let(sym: x) :> not,
            .Assign(local: x) :> not,
            .Write(cap: x) :> not,
            .Commit(writes: x) :> not,
            .Return(e: x) :> not,
            .Eval(e: x) :> not,
            .Suspend(bind: x) :> not,
            .ResetSurface(of: x) :> not,
            .Defer(body: x) :> not,
            .Unpersist(decl: x) :> not,
            .Attempt(result: x) :> not,
            .Fail(err: x) :> not,
            .Join(k: x) :> not,
            .Jump(k: x) :> not,
            .Loop(label: x) :> not,
            .Break(target: x) :> not,
            .Continue(target: x) :> not,
            .Gather(g: x) :> not,
            .Lift(into: x) :> not,
            .LocalFn(f: x) :> not
        };
    }

    fn holdsQuery(p: CoreProgram) -> boolean {
        for (const n of allNodes(Node.NProgram(p))) {
            if (nodeIsQuery(n)) return true;
        }
        return false;
    }

    fn nodeIsQuery(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> exprIsQuery(e),
            .NStmt(s: x) :> false,
            .NProgram(p: x) :> false,
            .NDecl(d: x) :> false,
            .NField(f: x) :> false,
            .NFn(f: x) :> false,
            .NServerFn(f: x) :> false,
            .NBlock(b: x) :> false,
            .NPlace(pl: x) :> false,
            .NInst(i: x) :> false,
            .NPattern(pat: x) :> false,
            .NEdit(k: x) :> false,
            .NView(v: x) :> false,
            .NAttr(a: x) :> false
        };
    }

    fn exprIsQuery(e: Expr) -> boolean {
        return match e {
            .Query(q: x) :> true,
            .Foreign(slice: fsl0) :> false,
            .Lit(lit: x) :> false,
            .Local(sym: x) :> false,
            .Read(place: x) :> false,
            .Call(callee: x) :> false,
            .FnRef(fn: x) :> false,
            .CallV(f: x) :> false,
            .Prim(op: x) :> false,
            .Match(scrut: x) :> false,
            .ArrayOf(elems: x) :> false,
            .StructOf(ty: x) :> false,
            .VariantOf(enumSym: x) :> false,
            .Handle(inst: x) :> false,
            .Assigned(local: x) :> false,
            .InitOf(decl: x) :> false,
            .Host(call: x) :> false,
            .Lambda(params: x) :> false,
            .BlockLambda(params: x) :> false,
            .SeqCall(op: x) :> false,
            .Refetch(req: rf0) :> false,
            .Validity(of: x) :> false,
            .ServerCall(fn: x) :> false
        };
    }

    // s468 (U1c fix round 1, F3) — THE GATE AT EMISSION. A printer prints only a
    // Core `checkCore` accepts: the S467 §13 gate's C-S8s / C-SQL2 (a waiting call
    // or a query that is not a Suspend's `on` would print UNAWAITED), and every
    // other invariant. A Core that fails any check is a compiler defect: nothing is
    // printed, and each finding is named. (Before: only tests and the conformance
    // counter ran checkCore — a pass that produced an ill-formed Core printed it.)
    export fn coreRefusal(p: CoreProgram) -> string[] {
        let out: string[] = [];
        for (const finding of checkCore(p)) {
            out = out.concat(["E-BOOTSTRAP-CORE-ILL-FORMED: the lowered Core fails checkCore — a compiler defect; nothing is printed (" + finding + ")"]);
        }
        return out;
    }

    // s469 — the stylesheet Core this program prints: its author sheet, or the
    // reset alone; `reset` is the program's own flag (§65.3.4).
    fn sheetOf(p: CoreProgram) -> CssUnit {
        const c: CoreCss | not = p.css;
        if (c is given) {
            const u: CssUnit = c.sheet;
            return { charsets: u.charsets, imports: u.imports, reset: p.reset, tokens: u.tokens, global: u.global, scopes: u.scopes };
        }
        return { charsets: [], imports: [], reset: p.reset, tokens: [], global: [], scopes: [] };
    }

    // s469 — §25.7: one `cssVar` per program cell a `#{}` value reads —
    // `--scrml-<name>` on `:root`, from the cell, now and on every change; the
    // runtime writes only a value its guard admits (the injection boundary).
    fn cssVarStmts(ctx: Ctx, p: CoreProgram, scope: JsExpr) -> JsStmt[] {
        const c: CoreCss | not = p.css;
        if (c is not) return [];
        let out: JsStmt[] = [];
        for (const v of c.vars) {
            out = out.concat([sexpr(rtCall(ctx, "cssVar", [scope, jstr("--scrml-" + v.cell.hint), JsExpr.JArrowE([], exprJs(ctx, v.read))]))]);
        }
        return out;
    }

    // =========================================================================
    // s481 — the program body runs once, in source order (§7.6 S481; ruling:user-voice-
    // scrml.md-S481-body-run-order: "The program body runs once, top to bottom, in source
    // order, and that sequence is the module initialization. Every file-scope initializer
    // runs whether or not anything reads it"). lower put a View.Init where each of the
    // program body's file-scope bindings was declared; here each becomes, in the client:
    //  - IN SEQUENCE: a body-top statement assigning the binding (`k = init`), run in its
    //    place among the body's statements and displays; the binding is declared (only) at
    //    module level. Unless code that runs BEFORE the place reaches it:
    //  - EARLY: code that runs before the place reaches the binding. s482: the program's seeds
    //    and those of the instances the body mounts run at their PLACE (heldFields /
    //    liveSeedDecl, ruling S481 run-order-followups item 1), so construction no longer
    //    counts; what does — the construction of a declaration the body does not mount
    //    (constructedElsewhere: a shared reference, a function's lift), a seed not held, a
    //    §25.7 CSS bridge, an earlier view, a read of a seed / lazy derived value whose
    //    initializer reaches it, or a function any of those calls (reachOf). A direct reach
    //    from an earlier display or statement is E-SCOPE-001 (analyze bodyReachDiags, S482), so
    //    what is left is a reach through a function value. Its initializer runs at module
    //    initialization, as before S481, so it is never read before it is set (INTERIM: when
    //    an earlier body-top statement writes what it reads, that order is not the source's).
    //    Whatever an early binding's initializer reaches is early too.
    //  - SERVER ONLY: no client code reads it and server code does — it stays out of the
    //    client artifact (the server artifact evaluates what it reads, rule (b)). So does one
    //    no code reads whose initializer reaches server-only code (serverInits, r1 H1): the
    //    server artifact runs it.
    // Any other binding no artifact reads is IN SEQUENCE: its initializer runs (S481, P1).
    // As-if: an initializer that does nothing (initActs) and reads no `let` and no in-sequence
    // binding (staticInits) runs at module initialization, as before S481 — nothing can observe
    // the difference — and one that does nothing and that no code reads is left out.
    // =========================================================================
    type InitPlan:struct = { p: CoreProgram, seq: int[] }

    fn programDeclOf(p: CoreProgram) -> Decl | not {
        for (const d of p.decls) { if (d.sym.id == p.program.id) return d; }
        return not;
    }

    // r2 (#2041 review MED-1): a place can stand inside an element (lower lowerPlaced puts it
    // among the element's children, at any depth) — every reader of the places walks El kids.
    fn initsIn(vs: View[]) -> int[] {
        let out: int[] = [];
        for (const v of vs) { out = out.concat(initOf(v)).concat(initsIn(elKids(v))); }
        return out;
    }

    // The children of an element view (the only view a place is nested in), else none.
    fn elKids(v: View) -> View[] {
        return match v {
            .El(tag: t, attrs: a, kids: ks) :> ks,
            .Init :> [],
            .Text :> [],
            .RawText :> [],
            .Dyn :> [],
            .Cond :> [],
            .Each :> [],
            .Instance :> [],
            .Slot :> [],
            .Star :> [],
            .Effect :> [],
            .Run :> [],
            .Request :> [],
            .ResetOn :> [],
            .Errors :> [],
            .Reach :> [],
            .Gather :> []
        };
    }

    // `v` with its children replaced (an element), else `v`.
    fn withElKids(v: View, ks: View[]) -> View {
        return match v {
            .El(tag: t, attrs: a, kids: x) :> View.El(t, a, ks),
            .Init :> v,
            .Text :> v,
            .RawText :> v,
            .Dyn :> v,
            .Cond :> v,
            .Each :> v,
            .Instance :> v,
            .Slot :> v,
            .Star :> v,
            .Effect :> v,
            .Run :> v,
            .Request :> v,
            .ResetOn :> v,
            .Errors :> v,
            .Reach :> v,
            .Gather :> v
        };
    }

    // r2 (MED-1) — the body in the order it runs: an element holding a place is its own
    // attributes (the element with no children: they are wired before its children), then its
    // children in this order; any other view is itself.
    fn runOrder(vs: View[]) -> View[] {
        let out: View[] = [];
        for (const v of vs) {
            const ks: View[] = elKids(v);
            if (ks.length > 0 && initsIn(ks).length > 0) out = out.concat([withElKids(v, [])]).concat(runOrder(ks));
            else out = out.concat([v]);
        }
        return out;
    }

    // r2 (MED-1) — each place in `vs`, at any depth: an in-sequence one (`seq`) becomes the
    // body-top statement assigning its binding; any other is dropped.
    // s482: a held program cell's place (`held`) stays a View.Init — printed `rt.seed(<cell>)`
    // (wireHole); any other cell's is dropped (its seed is computed at construction: nothing
    // can observe where — heldFields).
    fn placeInits(p0: CoreProgram, vs: View[], seq: int[], held: int[]) -> View[] {
        let out: View[] = [];
        for (const v of vs) {
            const h: int[] = initOf(v);
            if (h.length == 0) {
                const ks: View[] = elKids(v);
                if (ks.length > 0 && initsIn(ks).length > 0) out = out.concat([withElKids(v, placeInits(p0, ks, seq, held))]);
                else out = out.concat([v]);
            } else if (hasInt(held, h[0])) {
                out = out.concat([v]);
            } else if (hasInt(seq, h[0])) {
                const k: CoreConst | not = findConst(p0, h[0]);
                if (k is given) out = out.concat([View.Run(block([Stmt.Assign(k.sym, k.init, [])]), [], "")]);
            }
        }
        return out;
    }

    fn initOf(v: View) -> int[] {
        return match v {
            .Init(k: k) :> [k.id],
            .El :> [],
            .Text :> [],
            .RawText :> [],
            .Dyn :> [],
            .Cond :> [],
            .Each :> [],
            .Instance :> [],
            .Slot :> [],
            .Star :> [],
            .Effect :> [],
            .Run :> [],
            .Request :> [],
            .ResetOn :> [],
            .Errors :> [],
            .Reach :> [],
            .Gather :> []
        };
    }

    fn withRenders(d: Decl, rs: View[]) -> Decl {
        return { sym: d.sym, key: d.key, kind: d.kind, single: d.single, fields: d.fields, renders: rs, wiring: d.wiring, handles: d.handles, invs: d.invs };
    }

    // `p` with the program declaration's renders replaced by `rs`.
    fn withProgramRenders(p: CoreProgram, rs: View[]) -> CoreProgram {
        let ds: Decl[] = [];
        for (const d of p.decls) {
            if (d.sym.id == p.program.id) {
                ds = ds.concat([withRenders(d, rs)]);
            } else {
                ds = ds.concat([d]);
            }
        }
        return { program: p.program, decls: ds, types: p.types, fns: p.fns, server: p.server, dbs: p.dbs, reset: p.reset, sqlError: p.sqlError,
                 serverCallError: p.serverCallError, css: p.css, consts: p.consts, loads: p.loads, envelopes: p.envelopes, head: p.head,
                 tool: p.tool, endpoints: p.endpoints, channels: p.channels, typed: p.typed, outer: p.outer };
    }

    // The file-scope bindings code under `roots` reaches when it runs: read directly, read
    // by a function it calls (transitively), or by the initializer of a binding it reaches.
    fn constsReached(p: CoreProgram, roots: Node[]) -> int[] {
        if (roots.length == 0) return [];
        let rs: Node[] = roots;
        const fns: int[] = fnClosureThroughConsts(p, roots);
        for (const f of p.fns) { if (hasInt(fns, f.sym.id)) rs = rs.concat([Node.NFn(f)]); }
        let out: int[] = [];
        for (const k of constsReadIn(p, rs)) { out = out.concat([k.sym.id]); }
        return out;
    }

    fn findConst(p: CoreProgram, id: int) -> CoreConst | not {
        for (const k of p.consts) { if (k.sym.id == id) return k; }
        return not;
    }

    fn unionInts(a: int[], b: int[]) -> int[] {
        let out: int[] = a;
        for (const x of b) { if (!hasInt(out, x)) out = out.concat([x]); }
        return out;
    }

    // s481 — an initializer that may DO something when it runs: a call (of any kind), a host or
    // foreign call, a query, an assignment — or that reads an instance. One that does none of these
    // computes a value from literals and the bindings it reads, and nothing else observes it run.
    fn initActs(e: Expr) -> boolean {
        for (const n of allNodes(Node.NExpr(e))) {
            if (nodeActs(n)) return true;
        }
        return false;
    }

    fn nodeActs(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> exprActs(e),
            .NStmt(s: x) :> true,
            .NBlock(b: x) :> true,
            .NPlace(pl: x) :> false,
            .NProgram(p: x) :> false,
            .NDecl(d: x) :> false,
            .NField(f: x) :> false,
            .NFn(f: x) :> false,
            .NServerFn(f: x) :> false,
            .NInst(i: x) :> true,
            .NPattern(pat: x) :> false,
            .NEdit(k: x) :> true,
            .NView(v: x) :> true,
            .NAttr(a: x) :> true
        };
    }

    fn exprActs(e: Expr) -> boolean {
        return match e {
            .Lit(lit: x) :> false,
            .Local(sym: x) :> false,
            .Read(place: x) :> false,
            .Prim(op: o, args: a) :> primTraps(o, a),
            .Match(scrut: x) :> false,
            .ArrayOf(elems: x) :> false,
            .StructOf(ty: x) :> false,
            .VariantOf(enumSym: x) :> false,
            .FnRef(fn: x) :> false,
            .Lambda(params: x) :> false,
            .Call(callee: x) :> true,
            .CallV(f: x) :> true,
            .Host(call: x) :> true,
            .SeqCall(op: x) :> true,
            .Refetch(req: x) :> true,
            .ServerCall(fn: x) :> true,
            .Query(q: x) :> true,
            .Assigned(local: x) :> true,
            .Foreign(slice: x) :> true,
            .Handle(inst: x) :> true,
            .InitOf(decl: x) :> true,
            .Validity(of: x) :> true,
            .BlockLambda(params: x) :> true
        };
    }

    // s483 r1 (#2129 review LOW-3; RULED S483, ruling:user-voice-scrml.md-S483-unread-trapping-init-runs —
    // *"per §7.6 R1 an initializer runs at its place whether or not anything reads it; a trapping
    // initializer is not 'doing nothing', so the printer keeps it"*) — a primitive that can trap
    // (§19.17) ACTS: an initializer holding one is never left out as unobservable, and runs in its
    // place. The Core form of analyze.scrml trapSiteWhat's own sites: an index read (IndexRead —
    // E-INDEX-OUT-OF-RANGE-RT); a `slice` / `repeat` / `padStart` / `padEnd` position that is not a
    // non-negative int literal, an `insert` (TapeInsert); an unproven tape bound (LengthCheck —
    // E-WRITE-INVARIANT-RT); a run-time refinement check (RefineCheck — E-CONTRACT-001-RT); a `%`
    // whose divisor is not a non-zero number literal (its trap is owed:
    // g-bootstrap-int-overflow-and-mod-zero-untrapped-s469). A call already acts (it may reach any
    // of these), and so does a host call (the E-INT-CONVERSION-RT conversions are host calls).
    fn primTraps(o: PrimOp, args: Expr[]) -> boolean {
        if (o == PrimOp.IndexRead || o == PrimOp.TapeInsert || o == PrimOp.LengthCheck || o == PrimOp.RefineCheck) return true;
        // s483 r2 (#2128 r1 re-review item 8): an invariant check (InvariantGuard / InvariantValue with a
        // check) — E-WRITE-INVARIANT-RT
        const ci: int = invChecksArg(o);
        if (ci >= 0) return args.length > ci && invElems(args[ci]).length > 0;
        if (o == PrimOp.Mod) return args.length < 2 || !nonZeroNumLit(args[1]);
        if (o == PrimOp.StrSlice) {
            let i: int = 1;
            for (; i < args.length; ) {
                if (!nonNegIntLitCore(args[i])) return true;
                i = i + 1;
            }
            return false;
        }
        if (o == PrimOp.StrRepeat || o == PrimOp.StrPadStart || o == PrimOp.StrPadEnd) return args.length < 2 || !nonNegIntLitCore(args[1]);
        return false;
    }

    fn nonNegIntLitCore(e: Expr) -> boolean {
        return match e {
            .Lit(lit: l) :> litNonNegInt(l),
            // no-default-arm: only a literal is a literal position
            _ :> false
        };
    }

    fn litNonNegInt(l: Literal) -> boolean {
        return match l {
            .Int(v: v) :> v >= 0,
            .Num(v: v) :> v >= 0 && Math.floor(v) == v,
            // no-default-arm: only a number literal is a position
            _ :> false
        };
    }

    fn nonZeroNumLit(e: Expr) -> boolean {
        return match e {
            .Lit(lit: l) :> litNonZero(l),
            // no-default-arm: only a literal is proven non-zero here
            _ :> false
        };
    }

    fn litNonZero(l: Literal) -> boolean {
        return match l {
            .Int(v: v) :> v != 0,
            .Num(v: v) :> v != 0,
            // no-default-arm: only a number literal divides
            _ :> false
        };
    }

    // s481 — the program-body bindings whose initializer can run at module initialization with
    // no observable difference from running in its place: it does nothing (initActs), and every
    // binding it reads is a `const` that is itself such a binding or is declared outside the body
    // (initialized before the body). A `let` it reads could be written by an earlier body-top
    // statement, so a reader of one runs in its place.
    fn staticInits(p: CoreProgram, marked: int[]) -> int[] {
        let out: int[] = [];
        for (const k of p.consts) {
            if (hasInt(marked, k.sym.id) && !initActs(k.init)) {
                let ok = true;
                for (const n of allNodes(Node.NExpr(k.init))) {
                    const id: int = localReadOf(n);
                    if (id >= 0) {
                        const c: CoreConst | not = findConst(p, id);
                        if (c is given) {
                            if (c.mutable) ok = false;
                            else if (hasInt(marked, id) && !hasInt(out, id)) ok = false;
                        }
                    }
                }
                if (ok) out = out.concat([k.sym.id]);
            }
        }
        return out;
    }

    fn bodyInits(p: CoreProgram, si: int[], keep: int[]) -> InitPlan {
        const pd: Decl | not = programDeclOf(p);
        if (pd is not) return { p: p, seq: [] };
        const rs0: View[] | not = pd.renders;
        if (rs0 is not) return { p: p, seq: [] };
        const rs: View[] = rs0;
        const marked: int[] = initsIn(rs);
        if (marked.length == 0) return { p: p, seq: [] };
        const order: View[] = runOrder(rs);
        // the program without its places: what the client and the server read otherwise
        const bare: View[] = withoutInits(rs);
        const p0: CoreProgram = withProgramRenders(p, bare);
        const serverOnly0: int[] = serverOnlyFns(p0).concat(reachedOnlyByServer(p0));
        let croots: Node[] = [];
        for (const d0 of p0.decls) { croots = croots.concat([Node.NDecl(d0)]); }
        croots = croots.concat(clientFnRoots(p0, serverOnly0, keep, si));     // s482: the reached ones (§12.2 Trigger 6)
        // r2 (#2041 re-review INFO-5): the same server roots as clientConsts / serverInits — the
        // server functions AND the functions only server code reaches (serverOnly0)
        // s482 r1 (#2061 review H1): and the server-only initializers (serverRoots)
        const serverRead: int[] = constsReached(p0, serverRoots(p0, serverOnly0, si));
        // s482 (lane s482-write-only-secret): the bindings the client holds with their initializer —
        // as clientConsts judges it: a binding its code only overwrites, whose initializer it does
        // not run (clientNoInit), is a shell there, never placed here
        const noInit0: int[] = clientNoInit(p0, serverRead, si);
        const clientRead: int[] = clientHeld(constUse(p0, croots, noInit0), noInit0);
        // s482 (§7.6 rule (b) S482, ruling:user-voice-scrml.md-S481-run-order-followups item 1):
        // "each seed is computed at its place in the sequence; records are still created at
        // construction … a read of a seed before its place computes it early, on demand". The
        // program's seeds are HELD for their place (heldFields; a cell's place is its declaration),
        // and so are those of each instance the body mounts unconditionally (liveSeedDecl; its
        // place is its mount) — so neither reaches anything before the body. What still runs
        // before it: the construction of a declaration the body does not mount (a shared
        // reference in a function or an unplaced binding, an instance a function lifts —
        // constructedElsewhere; a shared reference in the body is constructed at it, R4), a seed that is not
        // held (a persisted cell's default), and the §25.7 CSS bridges; and a READ of a seed, or
        // of a lazy derived value, before its place runs its initializer then (reachOf follows
        // cell reads into their initializers, and instances into their declarations).
        const held: int[] = heldFields(p0, pd, marked);
        const insts: View[] = programInstances(pd);
        let pre: Node[] = [];
        for (const f of pd.fields) {
            if ((f.wcap is given || constSeedField(p0, f)) && f.init is given && !hasInt(held, f.sym.id)) pre = pre.concat([Node.NField(f)]);
        }
        // s482 (lane s482-seed-timing, Q12): a cell declared outside the body runs its seed before it
        for (const oc of outerLive(p0)) {
            const od: Decl | not = findDecl(p0, oc.decl);
            if (od is given) pre = pre.concat([Node.NField(od.fields[0])]);
        }
        const elsewhere: int[] = constructedElsewhere(p0, marked);
        for (const d1 of p0.decls) { if (hasInt(elsewhere, d1.sym.id)) pre = pre.concat([Node.NDecl(d1)]); }
        const css: CoreCss | not = p0.css;
        if (css is given) { for (const cv of css.vars) { pre = pre.concat([Node.NExpr(cv.read)]); } }
        let reached: int[] = reachOf(p0, insts, pre);
        const stat: int[] = staticInits(p0, marked);
        let early: int[] = [];
        let seq: int[] = [];
        let left: int = marked.length;
        let i: int = 0;
        for (; i < order.length && left > 0; ) {
            const v: View = order[i];
            const here: int[] = initOf(v);
            const fh: Field | not = fieldOfSym(pd, here);
            if (fh is given) {
                // a program cell's place: a held seed runs here (what it reaches is reached here)
                left = left - 1;
                if (hasInt(held, fh.sym.id)) reached = unionInts(reached, reachOf(p0, insts, [Node.NField(fh)]));
            } else if (here.length > 0) {
                const id: int = here[0];
                left = left - 1;
                if (hasInt(stat, id)) {
                    // does nothing and reads nothing the body changes: module initialization, as
                    // before S481, when the client reads it; left out when it does not
                    if (hasInt(clientRead, id)) early = early.concat([id]);
                } else if (hasInt(reached, id)) {
                    early = early.concat([id]);
                } else if (hasInt(clientRead, id) || (!hasInt(serverRead, id) && !hasInt(si, id))) {
                    const kc: CoreConst | not = findConst(p0, id);
                    // one no code reads that does nothing: running it is unobservable — left out
                    if (kc is given && (hasInt(clientRead, id) || initActs(kc.init))) seq = seq.concat([id]);
                }
            }
            if (left > 0) reached = unionInts(reached, reachOf(p0, insts, [Node.NView(v)]));
            i = i + 1;
        }
        // an early binding's initializer runs before the body: what it reaches is early too
        let changed = true;
        for (; changed; ) {
            changed = false;
            let roots: Node[] = [];
            for (const e of early) {
                const k: CoreConst | not = findConst(p0, e);
                if (k is given) roots = roots.concat([Node.NExpr(k.init)]);
            }
            const dep: int[] = reachOf(p0, insts, roots);
            let keep: int[] = [];
            for (const s of seq) {
                if (hasInt(dep, s)) {
                    early = early.concat([s]);
                    changed = true;
                } else {
                    keep = keep.concat([s]);
                }
            }
            seq = keep;
        }
        return { p: withProgramRenders(p, placeInits(p0, rs, seq, held)), seq: seq };
    }

    // s481 — the file-scope bindings the client artifact holds: those its code reads, and
    // (§7.6 S481: "every file-scope initializer runs whether or not anything reads it")
    // those NO artifact reads — in Core order. A binding only server code reads stays out, and
    // so does one no code reads whose initializer reaches server-only code (`si`, serverInits:
    // the server artifact runs it).
    // s482 (lane s482-write-only-secret): a binding the client's code only OVERWRITES (constUse
    // `writes`, not `reads`) and whose initializer the client does not run (clientNoInit: it is
    // server-only, server code reads it, or it does nothing) is a SHELL here — `let x = null;`, the
    // binding with the absence value `not` (§42) as its seed and never its initializer, so the
    // client's writes have a binding to write and nothing the initializer reaches is printed because
    // of it. Its value is never observed: a client read of it would have been counted. (A cell
    // declared outside the body that outerPlaced made a binding is written through its shell
    // DECLARATION instead — outerAsConsts — so it gets no binding here.)
    fn clientConsts(p: CoreProgram, clientRoots: Node[], serverOnly: int[], si: int[]) -> CoreConst[] {
        // s482 r1 (#2061 review H1): server code includes the server-only initializers (serverRoots)
        const sread: int[] = constsReached(p, serverRoots(p, serverOnly, si));
        const noInit: int[] = clientNoInit(p, sread, si);
        const u: ConstUse = constUse(p, clientRoots, noInit);
        const rid: int[] = clientHeld(u, noInit);
        if (rid.length == p.consts.length && !bodyAny(bodyCellsOf(p))) return p.consts;
        let out: CoreConst[] = [];
        for (const k2 of p.consts) {
            const id: int = k2.sym.id;
            // s483 (lane s483-body-cell-server-only): a body cell bodyPlaced made a binding is never a
            // client binding — the client writes its shell FIELD (bodyAsConsts), and its seed runs in
            // the server artifact
            if (isBodyCell(p, id)) {
                // (its shell is the program declaration's field)
            } else if (hasInt(rid, id)) {
                out = out.concat([k2]);
            } else if (!hasInt(sread, id) && initActs(k2.init) && !hasInt(si, id)) {
                // (one that does nothing, nothing reads: running it is unobservable — left out)
                out = out.concat([k2]);
            } else if (hasInt(u.writes, id) && findDecl(p, k2.sym) is not) {
                out = out.concat([{ sym: k2.sym, init: Expr.Lit(Literal.Absent), mutable: true }]);
            }
        }
        return out;
    }

    // An initializer that calls (transitively) a function the client artifact does not hold.
    fn callsServerOnly(p: CoreProgram, k: CoreConst, serverOnly: int[]) -> boolean {
        for (const id of fnClosure(p, fnCalleesIn(p, Node.NExpr(k.init)))) {
            if (hasInt(serverOnly, id)) return true;
        }
        return false;
    }

    // s481 r1 (#2041 review H1/M1) — the file-scope bindings NO code reads whose initializer
    // reaches server-only code: a function the client artifact does not hold (callsServerOnly —
    // §12.2 Trigger 5, server-placed by inheritance or reached only by server code), or a binding
    // only server code reads (S472: "a value read only by server code never reaches the client
    // artifact") — directly, through a function it calls, or through another such binding (a
    // fixed point). Each is SERVER-ONLY: nothing of it is in the client, and the server artifact
    // runs it, once, at module initialization, in Core order (print-server.scrml serverConsts) —
    // S481's "every file-scope initializer runs", in the artifact its reach places it in. (An
    // initializer that does nothing is left out, as everywhere: running it is unobservable.)
    // Judged on the program without its body places (View.Init reads every binding it places).
    export fn serverInits(p1: CoreProgram) -> int[] {
        return serverInitsExposing(p1, []);
    }

    // s482 — `keep`: as clientLiveFns'.
    // s482 r1 (#2061 review H1): a FIXED POINT. Each round judges "the client reads" from the
    // client roots WITHOUT the initializers already found server-only (clientLiveFns `si`), and
    // "server code reads" WITH them (serverRoots): the first round (none known) counts every
    // acting initializer as client code, as before; each later one can only add bindings (a
    // round starts from the last one's, and dropping client roots only shrinks what the client
    // reads), so it ends. At the fixed point the set agrees with what printProgram and the server
    // artifact use it for — the client runs none of these initializers, nor anything only they
    // reach (clientLiveFns), and the server runs every one (print-server.scrml serverConsts).
    fn serverInitsExposing(p1: CoreProgram, keep: int[]) -> int[] {
        if (p1.consts.length == 0) return [];
        let p: CoreProgram = p1;
        const pd: Decl | not = programDeclOf(p1);
        if (pd is given) {
            const rs: View[] | not = pd.renders;
            if (rs is given) p = withProgramRenders(p1, withoutInits(rs));
        }
        let si: int[] = [];
        let more = true;
        for (; more; ) {
            const next: int[] = serverInitsRound(p, keep, si);
            more = next.length > si.length;
            si = next;
        }
        return si;
    }

    fn serverInitsRound(p: CoreProgram, keep: int[], prev: int[]) -> int[] {
        const serverOnly: int[] = serverOnlyFns(p).concat(reachedOnlyByServer(p));
        let croots: Node[] = [];
        for (const d of p.decls) { croots = croots.concat([Node.NDecl(d)]); }
        // s482 r1 (#2105 review HIGH-1; ruling:user-voice-scrml.md-S482-circular-server-only — "the
        // largest set consistent with these rules"): "the client reads" is judged from the client's
        // OWN code — its declarations and the functions they reach (§12.2 Trigger 6) — never from the
        // initializer of a binding no code reads (every binding counted server-only here, `allK`):
        // whether such an initializer runs in the client is what this decides. Counting them as
        // client code (the round-one `prev` = [] before) made a binding they reach through a
        // function "client-read", so a binding no code reads whose initializer calls a client
        // function that reads a server-only binding stayed in the client and shipped it (probes
        // t6 / t6c — the smaller fixed point, not the largest).
        croots = croots.concat(clientFnRoots(p, serverOnly, keep, allConstIds(p)));     // s482: the reached ones (§12.2 Trigger 6)
        // s482 (lane s482-write-only-secret): what the client READS — a binding it only overwrites is
        // not client-read (§7.6 rule (b): "no code reads it"); the client gets a shell to write to
        // (clientConsts), never the initializer
        const cread: int[] = constsOnlyRead(p, croots);
        const sread: int[] = constsReached(p, serverRoots(p, serverOnly, prev));
        // the bindings only server code reads
        let held: int[] = [];
        for (const s of sread) { if (!hasInt(cread, s)) held = held.concat([s]); }
        let out: int[] = prev;
        let changed = true;
        for (; changed; ) {
            changed = false;
            for (const k of p.consts) {
                const id: int = k.sym.id;
                if (!hasInt(out, id) && !hasInt(cread, id) && !hasInt(sread, id) && runsK(p, k)) {
                    let hit: boolean = callsServerOnly(p, k, serverOnly);
                    if (!hit) {
                        for (const r of constsReached(p, [Node.NExpr(k.init)])) {
                            if (hasInt(held, r) || hasInt(out, r)) hit = true;
                        }
                    }
                    if (hit) {
                        out = out.concat([id]);
                        changed = true;
                    }
                }
            }
        }
        // Core order (print-server.scrml serverConsts prints them so; a round's additions follow)
        let ordered: int[] = [];
        for (const k2 of p.consts) { if (hasInt(out, k2.sym.id)) ordered = ordered.concat([k2.sym.id]); }
        return ordered;
    }

    fn allConstIds(p: CoreProgram) -> int[] {
        let out: int[] = [];
        for (const k of p.consts) { out = out.concat([k.sym.id]); }
        return out;
    }

    // An initializer the classification places (serverInitsRound): one that may act (initActs),
    // or the seed of a cell declared outside the body that outerPlaced classifies as a binding —
    // Q12 runs it "even when nothing reads the cell", and a seed that only reads a server-only
    // binding must be judged too (probe t11), not left to the client as one that does nothing.
    // s483 (lane s483-body-cell-server-only): and the seed of a cell of the program BODY that
    // bodyPlaced classifies as a binding (isBodyCell) — the same judgment as an outer cell's.
    fn runsK(p: CoreProgram, k: CoreConst) -> boolean {
        if (initActs(k.init)) return true;
        for (const oc of p.outer) { if (oc.decl.id == k.sym.id) return true; }
        return isBodyCell(p, k.sym.id);
    }

    fn withoutInits(rs: View[]) -> View[] {
        return placeInitsOff(rs);
    }

    // every place dropped, at any depth (r2: a place nested in an element too — else it would
    // read as a client read of its binding, and a server-only binding would reach the client)
    fn placeInitsOff(vs: View[]) -> View[] {
        let out: View[] = [];
        for (const v of vs) {
            if (initOf(v).length == 0) {
                const ks: View[] = elKids(v);
                if (ks.length > 0 && initsIn(ks).length > 0) out = out.concat([withElKids(v, placeInitsOff(ks))]);
                else out = out.concat([v]);
            }
        }
        return out;
    }

    // s481 r1 (#2041 review M2) — the declarations the program constructs ... s482: only those it
    // constructs OUTSIDE the body's own run — a shared reference (wherever it stands), an
    // instance a function names (a lift: the function may run before a place), and every
    // declaration one of those constructs, transitively. An instance the program body mounts
    // (unconditionally, or in a branch / row) is constructed and rendered at its place in the
    // run, so its declaration's code is reached there (reachOf, as the order walk passes it).
    // One nothing names is never constructed, so its code never runs.
    // s482 (lane s482-mount-reach-fu, #2112 r1 re-review F/U-1; §7.6 R4: "A lazy shared instance is
    // constructed at its first reference. Each is judged by R2 at the demand point.") — a shared
    // reference counts here only where it stands in code that may run BEFORE the body or outside its
    // order: a function (it may be called before a place, or through a value), a file-scope binding
    // the body does not place (not `marked`: module initialization), and a declaration constructed
    // elsewhere (transitively). One in the program's body — a display, an attribute, a statement, a
    // placed binding's initializer, a program cell's seed, the code of an instance the body mounts —
    // constructs the instance where it stands (`shared_<decl>()` is printed at the reference); the
    // order walk reaches its seeds there (reachOf follows a shared reference into every seeded
    // field; a derived field is reached where it is read — S483 #2116 review F1), so
    // a body binding the instance reads is computed at its own place, before the reference (R2
    // refuses a reference before it — analyze sharedReach), not hoisted to module initialization.
    fn constructedElsewhere(p: CoreProgram, marked: int[]) -> int[] {
        let roots: Node[] = [];
        for (const f0 of p.fns) { roots = roots.concat([Node.NFn(f0)]); }
        for (const sf of p.server) { roots = roots.concat([Node.NServerFn(sf)]); }
        for (const k0 of p.consts) { if (!hasInt(marked, k0.sym.id)) roots = roots.concat([Node.NExpr(k0.init)]); }
        let out: int[] = [];
        for (const r of roots) { out = unionInts(out, sharedIdsIn(p, r)); }
        for (const f of p.fns) { out = unionInts(out, instancedIn(Node.NFn(f))); }
        let changed = true;
        for (; changed; ) {
            changed = false;
            for (const d of p.decls) {
                if (hasInt(out, d.sym.id)) {
                    const more: int[] = unionInts(unionInts(out, instancedIn(Node.NDecl(d))), sharedIdsIn(p, Node.NDecl(d)));
                    if (more.length != out.length) {
                        out = more;
                        changed = true;
                    }
                }
            }
        }
        let res: int[] = [];
        for (const x of out) { if (x != p.program.id) res = res.concat([x]); }
        return res;
    }

    // s482 (lane s482-mount-reach-fu) — the declarations whose shared instance code under `root`
    // references (sharedRefs), the program's own left out.
    fn sharedIdsIn(p: CoreProgram, root: Node) -> int[] {
        let out: int[] = [];
        for (const s of sharedRefs(root)) { if (s.id != p.program.id && !hasInt(out, s.id)) out = out.concat([s.id]); }
        return out;
    }

    // s482 — the program cells whose seed is HELD for its place (§7.6 rule (b) S482): a writable
    // cell (a seeded field) with a written initializer that can be observed running where it
    // runs (seedLive: it acts, or reads a binding or a cell), whose place is in the body's run
    // (`marked`: a View.Init lower put at its declaration). A persisted cell's seed is its stored
    // value's default — computed at construction, as before (INTERIM, stated in §7.6 rule (b) S482 r1:
    // g-boot-persist-seed-at-construction-s482). Any other seed computes the same
    // value wherever it runs.
    // s482 (lane s482-seed-timing, Q13): and a locked program cell whose initializer is a constant
    // with a live seed (constSeedField) — its place is its declaration too.
    fn heldFields(p: CoreProgram, pd: Decl, marked: int[]) -> int[] {
        let out: int[] = [];
        for (const f of pd.fields) {
            const init: Expr | not = f.init;
            if (f.wcap is given && f.persist is not && init is given && hasInt(marked, f.sym.id) && seedLive(init)) out = out.concat([f.sym.id]);
            else if (hasInt(marked, f.sym.id) && constSeedField(p, f)) out = out.concat([f.sym.id]);
        }
        return out;
    }

    fn seedLive(e: Expr) -> boolean {
        if (initActs(e)) return true;
        for (const n of allNodes(Node.NExpr(e))) {
            if (localReadOf(n) >= 0 || isPlaceNode(n)) return true;
        }
        return false;
    }

    fn isPlaceNode(n: Node) -> boolean {
        return match n {
            .NPlace(pl: x) :> true,
            // no-default-arm: one question — is it a cell (or local path) read or write
            _ :> false
        };
    }

    // s482 (lane s482-seed-timing; ruling:user-voice-scrml.md-S482-locked-field-derived: "a locked
    // field is derived exactly when its initializer reads a cell, directly or through any function it
    // calls, at any depth. Otherwise it's a constant, whose initializer is a seed computed at its
    // place, meaning the instance's mount.") — a LOCKED field (no write capability) whose initializer
    // is a CONSTANT with a live seed (seedLive: it calls something or reads a binding, so where it
    // runs can be observed): printed as a seed (`rt.seeded`), held to its place like a `let` seed —
    // an instance's at its mount, a program cell's at its declaration — and never recomputed. One
    // whose initializer may read a cell (readsCellReach, fail closed) stays derived (`rt.derived`,
    // computed when it is read, §66.9 rule 3); a literal one computes the same value wherever it runs.
    export fn constSeedField(p: CoreProgram, f: Field) -> boolean {
        const init: Expr | not = f.init;
        if (f.wcap is given || f.persist is given || init is not) return false;
        return seedLive(init) && !readsCellReach(p, init);
    }

    // Does `e` read a cell — directly, through a function it calls or names as a value, or through a
    // file-scope binding it reads (a function value it holds), at any depth? FAIL CLOSED: what the
    // walk cannot follow counts as a read (a call through a function value, a server call, a callee
    // whose body Core does not hold), and so does every read of reactive state that is not a field
    // read (an instance handle, a validity surface, a request refetch, a re-run initializer).
    //
    // s482 r2 (#2105 r1 review HIGH-A; ruling:user-voice-scrml.md-S482-locked-field-derived — "derived
    // exactly when its initializer reads a cell, directly or through any function it calls, at any
    // depth"): in an EXPRESSION root — the value itself, or a file-scope constant's initializer it
    // reaches — a `Local` that is not a file-scope binding (findConst / a `<db>` load's value misses)
    // counts as a cell read, FAIL CLOSED. At a use site such a Local is a markup binding: an `<each>`
    // row item (`as it`), a `<match>` arm payload, a for-lift variable — a reactive projection of a
    // cell's element — and it is never a constant. A name bound INSIDE the root (a lambda parameter,
    // a block-lambda local, an expression `match` binder) is not free and is not counted (r3, #2105
    // r2 review LOW-1: Q13 — derived only when it reads a cell). A function body's own
    // parameters and locals are not judged so: they are bound by the function, from arguments the
    // walk already judges at the call.
    fn readsCellReach(p: CoreProgram, e: Expr) -> boolean {
        let todo: Node[] = [Node.NExpr(e)];
        let seenFn: int[] = [];
        let seenK: int[] = [];
        for (; todo.length > 0; ) {
            let next: Node[] = [];
            for (const r of todo) {
                const exprRoot: boolean = !isCoreFnNode(r);
                // s482 r3 (#2105 r2 review LOW-1) — names bound INSIDE the root (a lambda's or block
                // lambda's parameters, its own locals, an expression `match` arm's binders) are not
                // free: they read no cell by themselves, and whatever feeds them a cell's value is a
                // read the walk already judges at its source (`@xs.map(x => …)` reads `@xs`)
                let inner: int[] = [];
                if (exprRoot) { for (const bs of boundSyms(r)) { inner = inner.concat([bs.id]); } }
                for (const n of allNodes(r)) {
                    if (exprRoot && freeLocalRead(p, n) && !hasInt(inner, localReadOf(n))) return true;
                    if (cellReadOf(n) is given || nodeReadsState(n)) return true;
                    const fid: int = namedFnOf(n);
                    if (fid >= 0 && !hasInt(seenFn, fid)) {
                        seenFn = seenFn.concat([fid]);
                        let found: boolean = false;
                        for (const f of p.fns) {
                            if (f.sym.id == fid) {
                                found = true;
                                next = next.concat([Node.NFn(f)]);
                            }
                        }
                        if (!found) return true;
                    }
                    const kid: int = localReadOf(n);
                    if (kid >= 0 && !hasInt(seenK, kid)) {
                        seenK = seenK.concat([kid]);
                        const k: CoreConst | not = findConst(p, kid);
                        if (k is given) next = next.concat([Node.NExpr(k.init)]);
                    }
                }
            }
            todo = next;
        }
        return false;
    }

    fn isCoreFnNode(r: Node) -> boolean {
        return match r {
            .NFn(f: x) :> true,
            // no-default-arm: one question — is it a function (its own bindings are its own)
            _ :> false
        };
    }

    // s482 r2 (#2105 r1 review HIGH-A) — a read of a `Local` (a whole local or a path into one)
    // that is not a file-scope binding: no file-scope constant / `let` (findConst) and no `<db>`
    // load's module-level value (DbLoad.val).
    fn freeLocalRead(p: CoreProgram, n: Node) -> boolean {
        const id: int = localReadOf(n);
        if (id < 0) return false;
        if (findConst(p, id) is given) return false;
        for (const l of p.loads) { if (l.val.id == id) return false; }
        return true;
    }

    // A scrml function an expression node calls or names as a value (its Sym id), else -1.
    fn namedFnOf(n: Node) -> int {
        return match n {
            .NExpr(e: e) :> exprNamedFn(e),
            // no-default-arm: one question — is it a call or a function value
            _ :> -1
        };
    }

    fn exprNamedFn(e: Expr) -> int {
        return match e {
            .Call(callee: c) :> c.id,
            .FnRef(fn: f) :> f.id,
            // no-default-arm: one question — does it name a function
            _ :> -1
        };
    }

    // Reactive state read other than through a cell place, and what the walk cannot follow.
    fn nodeReadsState(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> exprReadsState(e),
            // no-default-arm: one question — an expression that reads state the place walk does not see
            _ :> false
        };
    }

    fn exprReadsState(e: Expr) -> boolean {
        return match e {
            .Handle(inst: x) :> true,
            .InitOf(decl: x) :> true,
            .Validity(of: x) :> true,
            .Refetch(req: x) :> true,
            .CallV(f: x) :> true,
            .ServerCall(fn: x) :> true,
            .Query(q: x) :> true,
            .Foreign(slice: x) :> true,
            // no-default-arm: one question — does it read state, or call what the walk cannot follow
            _ :> false
        };
    }

    // s482 — does a declaration's record hold a seed whose place matters (seedLive), itself or in
    // a record it mounts unconditionally, at any depth? Such an instance, mounted unconditionally
    // by the program body, is HELD (`rt.hold`) and seeded at its mount (`rt.seedAll`).
    // s482 r1 (#2105 review LOW-1): `ix` — and a locked attribute some use site gives a constant
    // seed (givenSeedField): it is seeded at the mount too.
    export fn liveSeedDecl(p: CoreProgram, ix: PrintIx, d: Decl) -> boolean {
        return liveSeedIn(p, ix, d, []);
    }

    fn liveSeedIn(p: CoreProgram, ix: PrintIx, d: Decl, seen: int[]) -> boolean {
        if (hasInt(seen, d.sym.id)) return false;
        let fi: int = 0;
        for (const f of d.fields) {
            const init: Expr | not = f.init;
            if (f.wcap is given && f.persist is not && init is given && seedLive(init)) return true;
            if (constSeedField(p, f)) return true;     // s482 (lane s482-seed-timing, Q13)
            if (givenSeedField(ix, d, fi, f)) return true;
            fi = fi + 1;
        }
        const views: View[] | not = d.renders;
        if (views is not) return false;
        for (const v of mountedInstances(views)) {
            const kd: int = viewInstanced(v);
            for (const d2 of p.decls) {
                if (d2.sym.id == kd && liveSeedIn(p, ix, d2, seen.concat([d.sym.id]))) return true;
            }
        }
        return false;
    }

    // The program cell whose place `here` (initOf) is, else `not`.
    fn fieldOfSym(pd: Decl, here: int[]) -> Field | not {
        if (here.length == 0) return not;
        for (const f of pd.fields) { if (f.sym.id == here[0]) return f; }
        return not;
    }

    // Every instance view the program body holds, at any depth (a branch, a row, slot content).
    fn programInstances(pd: Decl) -> View[] {
        let out: View[] = [];
        for (const n of allNodes(Node.NDecl(pd))) {
            const v: View | not = instanceViewOf(n);
            if (v is given) out = out.concat([v]);
        }
        return out;
    }

    fn instanceViewOf(n: Node) -> View | not {
        return match n {
            .NView(v: v) :> (viewInstanced(v) >= 0 ? v : not),
            // no-default-arm: one question — is it an instance view
            _ :> not
        };
    }

    // s482 — the file-scope bindings code under `roots` reaches when it runs (constsReached),
    // and also through what that code sets running on the way (S482 "a read of a seed before its
    // place computes it early, on demand"): a read or a write of a cell runs the cell's
    // initializer if it has not run (a held seed, a lazy derived value) — and, for a field of a
    // mounted declaration, the use-site values that feed it (`insts`); an instance constructs
    // and renders its declaration. Followed through the functions reached, to a fixed point.
    // s482 (lane s482-handler-reach, g-boot-handler-reach-runs-binding-early-s482) — only the
    // code that runs when `roots` runs is walked (runsNowNode): an event handler and a `bind:`
    // write-back run on an event, after the body (§7.6 rule (b) S482), so what only they reach
    // is not run early — it runs at its place, and they read it from there. (An `<effect>` /
    // `<request>` body is still walked: both run during the body today.)
    fn reachOf(p: CoreProgram, insts: View[], roots: Node[]) -> int[] {
        if (roots.length == 0) return [];
        let all: Node[] = runsNowNodes(roots);
        let todo: Node[] = all;
        let seenF: string[] = [];
        let seenD: int[] = [];
        let seenFn: int[] = [];
        for (; todo.length > 0; ) {
            let walk: Node[] = todo;
            for (const fid of fnClosureThroughConsts(p, todo)) {
                if (!hasInt(seenFn, fid)) {
                    seenFn = seenFn.concat([fid]);
                    for (const f of p.fns) { if (f.sym.id == fid) walk = walk.concat([Node.NFn(f)]); }
                }
            }
            let next: Node[] = [];
            for (const r of walk) {
                for (const n of allNodes(r)) {
                    const cf: CellRead | not = cellReadOf(n);
                    if (cf is given) {
                        for (const d of p.decls) {
                            if (d.sym.id == cf.decl) {
                                let k: int = 0;
                                for (const f of d.fields) {
                                    const key: string = cf.decl + ":" + k;
                                    if ((cf.idx < 0 || cf.idx == k) && seenF.indexOf(key) < 0) {
                                        seenF = seenF.concat([key]);
                                        next = next.concat([Node.NField(f)]);
                                    }
                                    k = k + 1;
                                }
                                if (cf.decl != p.program.id && !hasInt(seenD, -1 - cf.decl)) {
                                    seenD = seenD.concat([-1 - cf.decl]);
                                    for (const iv of insts) { if (viewInstanced(iv) == cf.decl) next = next.concat([Node.NView(iv)]); }
                                }
                            }
                        }
                    }
                    // s482 (lane s482-mount-reach-fu; §7.6 R4) — a reference to a declaration's shared
                    // instance constructs it (its first one): every SEED of the record runs there
                    // (rt.seeded is owed until the construction ends), so every seeded field is reached
                    // — the same "has a seed" test as bodyInits' `pre` (a writable cell's, or a
                    // constant's with a live seed, constSeedField). A derived field is lazy
                    // (rt.derived): its formula runs where it is READ, and the cellReadOf branch
                    // above reaches it there (`@card.d`, or the whole record), not at the
                    // construction (S483 review F1 of #2116: an unread derived field hoisted).
                    const sh: Sym | not = sharedRefOf(n);
                    if (sh is given && sh.id != p.program.id) {
                        for (const d3 of p.decls) {
                            if (d3.sym.id == sh.id) {
                                let k3: int = 0;
                                for (const f3 of d3.fields) {
                                    const key3: string = sh.id + ":" + k3;
                                    if (seenF.indexOf(key3) < 0 && (f3.wcap is given || constSeedField(p, f3))) {
                                        seenF = seenF.concat([key3]);
                                        next = next.concat([Node.NField(f3)]);
                                    }
                                    k3 = k3 + 1;
                                }
                            }
                        }
                    }
                    const di: int = nodeInstanced(n);
                    if (di >= 0 && di != p.program.id && !hasInt(seenD, di)) {
                        seenD = seenD.concat([di]);
                        for (const d2 of p.decls) { if (d2.sym.id == di) next = next.concat([Node.NDecl(d2)]); }
                    }
                }
            }
            next = runsNowNodes(next);
            all = all.concat(next);
            todo = next;
        }
        return constsReached(p, all);
    }

    // s482 (lane s482-handler-reach) — §7.6 rule (b) S482: "Code that does not run in the body is
    // not judged: an event handler …". A view (and a declaration's renders — a component's
    // handlers) with the code that runs AFTER the body left out: every `on…` handler (View
    // attribute On — in an element, an `<each>` row, a lifted gather row, a conditional arm,
    // slot content) and a `bind:` attribute's write-back (it runs on the input event; the
    // attribute's read stays — it shows the cell where it stands). A listener runs only on an
    // event, and the program's DOM is inserted after its render (rt.insert, the render's last
    // step), so no listener can run during the body. ~~KEPT, fail closed — they run during the
    // body today …: an `<effect>` … and a `<request>` …~~ s482 (lane s482-hold-body; RULED S482,
    // ruling:user-voice-scrml.md-S482-hold-until-body-ends): an `<effect>`'s and a `<request>`'s
    // BODY are left out too — every run of either triggered during the body is held until the
    // body ends (rt.runBody, §7.6 R5), so neither runs in the body and what it reaches is read
    // from its place (g-boot-effect-fires-in-body-before-place-s482 and
    // g-boot-request-runs-in-body-s482, resolved). Their dependency / target / signal cells stay
    // (requestOn / effectOn take those cells where they stand). Nothing is dropped from what is
    // PRINTED: this copy only decides what reachOf walks.
    fn runsNowNodes(ns: Node[]) -> Node[] {
        let out: Node[] = [];
        for (const n of ns) { out = out.concat([runsNowNode(n)]); }
        return out;
    }

    fn runsNowNode(n: Node) -> Node {
        return match n {
            .NView(v: v) :> Node.NView(runsNowView(v)),
            .NDecl(d: d) :> Node.NDecl(runsNowDecl(d)),
            // no-default-arm: only a view (or a declaration's renders) holds code that runs after the mount
            _ :> n
        };
    }

    fn runsNowDecl(d: Decl) -> Decl {
        const rs: View[] | not = d.renders;
        if (rs is not) return d;
        return withRenders(d, runsNowViews(rs));
    }

    fn runsNowViews(vs: View[]) -> View[] {
        let out: View[] = [];
        for (const v of vs) { out = out.concat([runsNowView(v)]); }
        return out;
    }

    fn runsNowView(v: View) -> View {
        return match v {
            .El(tag: t, attrs: a, kids: ks) :> View.El(t, runsNowAttrs(a), runsNowViews(ks)),
            .Cond(arms: arms) :> View.Cond(runsNowArms(arms)),
            .Each(src: s, bind: b, key: k, handles: h, row: r) :> View.Each(s, b, k, h, runsNowViews(r)),
            .Instance(decl: d, attrs: a, slot: sl, alias: al) :> View.Instance(d, a, runsNowViews(sl), al),
            .Gather(g: g, rows: rows, key: k) :> View.Gather(g, runsNowRows(rows), k),
            .Request(target: t, deps: ds, body: b, mount: m, state: st, handle: h, cls: k) :> View.Request(t, ds, { stmts: [] }, m, st, h, k),   // s482: its body runs after the body (held)
            .Text :> v,
            .RawText :> v,
            .Dyn :> v,
            .Slot :> v,
            .Star :> v,
            .Effect(deps: ds) :> View.Effect(ds, { stmts: [] }),   // s482: its body runs after the body (held)
            .Run :> v,
            .Init :> v,
            .ResetOn :> v,
            .Errors :> v,
            .Reach :> v
        };
    }

    fn runsNowAttrs(as0: Attr[]) -> Attr[] {
        let out: Attr[] = [];
        for (const a of as0) {
            const r: Attr | not = runsNowAttr(a);
            if (r is given) out = out.concat([r]);
        }
        return out;
    }

    fn runsNowAttr(a: Attr) -> Attr | not {
        return match a {
            .On :> not,
            .Bind(kind: k, read: r, sink: s, write: w) :> Attr.Bind(k, r, s, { stmts: [] }),
            .Static :> a,
            .Bound :> a,
            .Show :> a,
            .ClassOn :> a,
            .Gate :> a
        };
    }

    fn runsNowArms(arms: CondArm[]) -> CondArm[] {
        let out: CondArm[] = [];
        for (const c of arms) { out = out.concat([{ test: c.test, body: runsNowViews(c.body) }]); }
        return out;
    }

    fn runsNowRows(rows: GatherRow[]) -> GatherRow[] {
        let out: GatherRow[] = [];
        for (const r of rows) { out = out.concat([{ views: runsNowViews(r.views) }]); }
        return out;
    }

    type CellRead:struct = { decl: int, idx: int }

    // A read or a write of a declaration's field (`idx`; -1: the whole record).
    fn cellReadOf(n: Node) -> CellRead | not {
        return match n {
            .NPlace(pl: pl) :> cellPlaceRead(pl),
            // no-default-arm: one question — is it a cell place
            _ :> not
        };
    }

    fn cellPlaceRead(pl: Place) -> CellRead | not {
        return match pl {
            .Cell(decl: d, inst: i, path: ps) :> (ps.length > 0 ? { decl: d.id, idx: ps[0].idx } : { decl: d.id, idx: -1 }),
            .LocalPath(sym: s) :> not
        };
    }

    fn instancedIn(root: Node) -> int[] {
        let out: int[] = [];
        for (const n of allNodes(root)) {
            const id: int = nodeInstanced(n);
            if (id >= 0 && !hasInt(out, id)) out = out.concat([id]);
        }
        return out;
    }

    fn nodeInstanced(n: Node) -> int {
        return match n {
            .NView(v: v) :> viewInstanced(v),
            .NExpr(e: x) :> -1,
            .NStmt(s: x) :> -1,
            .NBlock(b: x) :> -1,
            .NPlace(pl: x) :> -1,
            .NProgram(p: x) :> -1,
            .NDecl(d: x) :> -1,
            .NField(f: x) :> -1,
            .NFn(f: x) :> -1,
            .NServerFn(f: x) :> -1,
            .NInst(i: x) :> -1,
            .NPattern(pat: x) :> -1,
            .NEdit(k: x) :> -1,
            .NAttr(a: x) :> -1
        };
    }

    fn viewInstanced(v: View) -> int {
        return match v {
            .Instance(decl: d) :> d.id,
            .Star(decl: d) :> d.id,
            .El :> -1,
            .Text :> -1,
            .RawText :> -1,
            .Dyn :> -1,
            .Cond :> -1,
            .Each :> -1,
            .Slot :> -1,
            .Effect :> -1,
            .Run :> -1,
            .Init :> -1,
            .Request :> -1,
            .ResetOn :> -1,
            .Errors :> -1,
            .Reach :> -1,
            .Gather :> -1
        };
    }

    export fn printProgram(p1: CoreProgram, jsFile: string, runtimeFile: string) -> Output {
        return printProgramExposing(p1, jsFile, runtimeFile, []);
    }

    // s482 (s482-client-roots) — printProgram, with the functions `keep` names counted reached
    // (clientLiveFns): TEST SCAFFOLDING only (slice-m1/load-program.js `expose` — a test that
    // calls a program function no code of the program reaches). Every compile passes none.
    export fn printProgramExposing(p1: CoreProgram, jsFile: string, runtimeFile: string, keep: int[]) -> Output {
        const ill: string[] = coreRefusal(p1);
        if (ill.length > 0) return { js: "", html: "", refused: ill, routes: [] };
        // s482 r1 (#2061 review M1/M2): §12.2 Trigger 6 / §41.9 — the nested functions nothing
        // reaches and the components nothing constructs are not in the program the artifacts are
        // printed from (shakeProgram; print-server.scrml shakes the same way, so both artifacts
        // judge one program)
        const ps: CoreProgram = shakeProgram(p1, keep);
        const orf: string[] = outerRefusal(ps);
        if (orf.length > 0) return { js: "", html: "", refused: orf, routes: [] };
        // s483 r2 (#2128 r1 re-review H2a–H2d): an invariant never moves a server-only binding,
        // function or field into the client (invLeakRefusal — this classification, run without the
        // invariant checks and with them)
        const ilr: string[] = invLeakRefusal(p1, keep);
        if (ilr.length > 0) return { js: "", html: "", refused: ilr, routes: [] };
        const cp: ClientPlan = clientPlanOf(ps, keep);
        const si: int[] = cp.si;
        const plan: InitPlan = cp.plan;
        const p: CoreProgram = plan.p;
        // S478 ruling item 26 (1): a LIBRARY entry (no `<program>`, §21.5) is analyzed as a
        // library, but §21.5's output — "no HTML output … a JS module with the exported bindings
        // as its sole output" — is not built: refused by name, never printed as a page (INTERIM,
        // g-boot-library-entry-emit-s478).
        if (p.program.id < 0) return { js: "", html: "", refused: ["E-BOOTSTRAP-UNSUPPORTED: this entry is a library file (no `<program>`, §21.5) — its checks ran, but the bootstrap does not emit a library's JS module yet (§21.5: \"a JS module with the exported bindings as its sole output\"), and it never prints a library as a page. Import it from a program, or compile it with the main compiler"], routes: [] };
        const refused: string[] = serverRefusal(p);
        if (refused.length > 0) return { js: "", html: "", refused: refused, routes: [] };
        const names: NameTable = planNames(p);
        const ctx0: Ctx = baseCtx(p, names);
        const rt: string = rtName(ctx0);
        // s482 (lane s482-seed-timing, Q12): the cells declared outside the body with a live seed —
        // each constructed in the file-scope section, at its place in link order (constsWithOuter)
        const outs: OuterCell[] = outerLive(p);
        let liveSyms: Sym[] = [];
        for (const oc of outs) { liveSyms = liveSyms.concat([oc.decl]); }
        // every outer cell's declaration is printed by constsWithOuter (outerPrinted), not below
        let outSyms: Sym[] = [];
        for (const oc1 of p.outer) { if (findDecl(p, oc1.decl) is given) outSyms = outSyms.concat([oc1.decl]); }
        const sharedUsed: Sym[] = dedupe(sharedRefs(Node.NProgram(p)).concat([p.program]).concat(liveSyms));
        let body: JsStmt[] = [
            JsStmt.SComment(jsFile + " — generated by the scrml bootstrap printer (self-host-v2, slice M1). Do not edit."),
            JsStmt.SImportAll(rt, "./" + runtimeFile),
        ];
        let templates: Template[] = [];
        // s472: the constants the CLIENT's code reads — its declarations and its functions
        // (computed below, before any is printed: a module-level `const` precedes its readers)
        // s483 r2: clientPlanOf — the steps invLeakRefusal runs too
        const clientRoots: Node[] = cp.roots;
        const liveFns: int[] = cp.liveFns;
        const cconsts: CoreConst[] = cp.consts;
        // s482 (s482-registry-client): the runtime `reflect` registries print only the types this
        // client code uses (clientRegistryIds, §22.4.2 strategy 2)
        let regRoots: Node[] = clientRoots;
        for (const k0 of cconsts) { regRoots = regRoots.concat([Node.NExpr(k0.init)]); }
        const ctx: Ctx = withReg(ctx0, clientRegistryIds(p, regRoots, calledServerFnsWith(p, keep, si)));
        const uses: DeclNs[] = declNsUses(p);
        body = body.concat(constsWithOuter(ctx, cconsts, plan.seq, outs, sharedUsed, uses));
        body = body.concat(requestSlotStmts(ctx, p));          // s475 (S3b)
        for (const d of p.decls) {
            if (!symIn(outSyms, d.sym)) {
                const r: Rendered = declJs(ctx, d, sharedUsed, uses);
                body = body.concat(r.stmts);
                templates = templates.concat(r.templates);
            }
        }
        // s454 (U1b): the routes of the server functions the client calls
        // s482 r1 (#2061 review M3): those the client CAN call (calledServerFnsWith)
        const called: ServerFn[] = calledServerFnsWith(p, keep, si);
        let routes: RouteOut[] = [];
        if (called.length > 0) body = body.concat([JsStmt.SBlank, JsStmt.SComment("server routes (the client half of each call — the server artifact holds the other half)")]);
        for (const sf of called) {
            body = body.concat([routeJs(p, sf)]);
            routes = routes.concat([{ fn: sf.sym.hint, path: routePath(sf.sym), value: sf.ret is given }]);
        }
        // s454 (U1b): a function whose calls reach a server function IN PLACE
        // (§12.2 Trigger 5 — server-placed by inheritance) is server code: it
        // is not in the client artifact.
        // s468 (U1c): nor is one only server functions reach ("Trigger 5 is emission").
        const serverOnly: int[] = serverOnlyFns(p).concat(reachedOnlyByServer(p));
        // s482: and an unreached function (§12.2 Trigger 6 — "never called … tree-shaken out of all
        // output") is in neither artifact (clientLiveFns; the server artifact holds only what its
        // server functions reach).
        let clientFns: Fn[] = [];
        for (const f of p.fns) { if (!hasInt(serverOnly, f.sym.id) && hasInt(liveFns, f.sym.id)) clientFns = clientFns.concat([f]); }
        // s478 (s478-boot-syntax-batch): a `transaction { … }` block runs only inside a server
        // function's envelope (§19.10.3) — a client function holding one is never printed
        for (const tf of clientFns) {
            if (holdsTxBlock(tf)) return { js: "", html: "", refused: ["E-BOOTSTRAP-UNSUPPORTED: " + tf.sym.hint + "() holds a `transaction { … }` block and is printed in the client artifact — a block runs only inside a server function's transaction (§19.10.3); the Core is ill-formed (check.scrml C-TX4)"], routes: [] };
        }
        // s472 (boot-math-port): the host modules those functions call, imported beside the runtime
        body = body.slice(0, 2).concat(hostImports(p, clientFns)).concat(body.slice(2));
        if (clientFns.length > 0) body = body.concat([JsStmt.SBlank, JsStmt.SComment("functions")]);
        for (const f of clientFns) { body = body.concat([fnJs(ctx, f)]); }
        // Boot: render the program's shared instance at the end of <body>.
        const progLocal: string = p.program.hint.replaceAll("$", "_") + "$";
        let boot: JsStmt[] = [JsStmt.SConst(progLocal, jcall(jid(nameOf(names, NameKey.SharedGet(p.program.id))), []))];
        boot = boot.concat(cssVarStmts(ctx, p, jmember(jid(progLocal), "scope")));
        // s482 (lane s482-hold-body; RULED S482, ruling:user-voice-scrml.md-S482-hold-until-body-ends):
        // the render runs inside `rt.runBody` — effect and request runs triggered during the body are
        // held until it ends, then run in trigger order (§7.6 R5)
        const renderCall: JsExpr = jcall(jid(nameOf(names, NameKey.Render(p.program.id))), [
            jid(progLocal), jmember(jid(progLocal), "scope"),
            rtCall(ctx, "mount", [jmember(jid("document"), "body")]), JsExpr.JNull,
        ]);
        boot = boot.concat([sexpr(rtCall(ctx, "runBody", [JsExpr.JArrow([], [sexpr(renderCall)])]))]);
        boot = boot.concat(channelBoot(ctx, p, progLocal));
        body = body.concat([JsStmt.SBlank, JsStmt.SComment("boot")]).concat(dbLoadBoot(ctx, p, boot));
        let head: HNode[] = [HNode.HElem("script", [{ name: "type", value: "module" }, { name: "src", value: jsFile }], [])];
        // s451 — §65.3.4: the built-in reset, its own bottom `@layer`, unless
        // `<program reset="none">`.
        // s469 (s469-boot-css): with the program's author sheet (§9.1, §65) —
        // the reset, `@layer global`, the components' `@scope` donuts — in one
        // `<style>`, printed as a STYLE text node (html.scrml HStyle: verbatim,
        // so `>` stays a combinator; the reader refused every `<`, and the node
        // re-encodes any `<` as the CSS escape `\3c `, so nothing in it can
        // close the element).
        const css: string = emitCss(sheetOf(p));
        if (css != "") head = [HNode.HElem("style", [], [HNode.HStyle(css)])].concat(head);
        for (const t of templates) {
            head = head.concat([templateElem(t)]);
        }
        // s473 — §40.7: the documentary `<meta>`s lead the head, after its `<title>`.
        let metas: HNode[] = [];
        for (const m of p.head.metas) {
            metas = metas.concat([HNode.HElem("meta", [{ name: "name", value: m.name }, { name: "content", value: m.content }], [])]);
        }
        const page: Page = { title: headTitle(p), head: metas.concat(head), body: [] };
        return { js: printModule(body), html: printPage(page), refused: [], routes: routes };
    }

    // s473 — §40.7: the head's `<title>` text — the documentary `title=`, the
    // compiler's default, or none (the program's markup writes its own).
    fn headTitle(p: CoreProgram) -> string | not {
        const t: HeadTitle = p.head.title;
        return match t {
            .Default :> p.program.hint,
            .Documentary(text: s) :> s,
            .Author :> not
        };
    }

    // s473 (Lane B — SPEC §8.1.3; RULED S472 "`<db>` body + client reads", items
    // 1–2): with `<db>` cells, the boot WAITS for their server loads — one route
    // each, the value decoded against the cell's declared type — and binds each
    // answer to the module-level const its field's init reads (`Local(val)`);
    // only then is the program instance built and mounted. A failed load mounts
    // no program: rt.loadDbCells reports it and shows the program-level default
    // failure view instead (§8.1.3 "A failed load", S479). Without `<db>` cells:
    // `boot` as it is.
    //   const dbcells$ = await rt.loadDbCells([route$load_rows]);
    //   const rows_db = dbcells$.values[0];
    //   if (dbcells$.ok) { const program$ = shared_program(); … mount … }
    fn dbLoadBoot(ctx: Ctx, p: CoreProgram, boot: JsStmt[]) -> JsStmt[] {
        if (p.loads.length == 0) return boot;
        let routes: JsExpr[] = [];
        for (const ld of p.loads) { routes = routes.concat([jid(routeName(p, ld.fn))]); }
        let out: JsStmt[] = [
            JsStmt.SComment("the page's <db> cells: each is loaded on the server, per request, and the page waits for them (§8.1.3) — nothing mounts if one fails"),
            JsStmt.SConst("dbcells$", JsExpr.JAwait(rtCall(ctx, "loadDbCells", [JsExpr.JArray(routes)]))),
        ];
        let i: int = 0;
        for (const ld of p.loads) {
            out = out.concat([JsStmt.SConst(symName(ctx, ld.val), JsExpr.JIndex(jmember(jid("dbcells$"), "values"), jnum(i)))]);
            i = i + 1;
        }
        return out.concat([JsStmt.SIf(jmember(jid("dbcells$"), "ok"), boot, [])]);
    }

    // =========================================================================
    // s454 (U1b) — THE CLIENT HALF OF A SERVER CALL'S ROUTE (design Item 3).
    // One module constant per server function the client calls:
    //   const route$saveNote = { path, params: [<table>…], result, error };
    // `params`: the §57 wire table of each parameter (the request body is a
    // JSON ARRAY of the encoded arguments, in parameter order — Item 3.1);
    // `result`: the declared return type's table, `null` for a function that
    // yields no value (the 204 contract — Item 3.2; analyze refuses a client
    // call of a server function that yields a value it does not declare);
    // `error`: the declared error enum's table (the §57.8 `fail` envelope is
    // decoded against it, strictly), `null` for a function not declared `!`.
    // The path is compiler-internal, minted from the Sym (U1 design §4: "never
    // the name") — both ends are one compile.
    // =========================================================================
    export fn routePath(s: Sym) -> string { return "/_scrml/call/" + s.id; }

    export fn routeJs(p: CoreProgram, sf: ServerFn) -> JsStmt {
        let params: JsExpr[] = [];
        for (const prm of sf.params) { params = params.concat([wireOrNull(p, prm.ty)]); }
        let result: JsExpr = JsExpr.JNull;
        const rt: Type | not = sf.ret;
        if (rt is given) result = wireOrNull(p, rt);
        let error: JsExpr = JsExpr.JNull;
        const e: Sym | not = sf.err;
        if (e is given) error = wireOrNull(p, Type.Named(e));
        return JsStmt.SConst(routeName(p, sf.sym), JsExpr.JObject([
            { key: "path", value: jstr(routePath(sf.sym)) },
            { key: "params", value: JsExpr.JArray(params) },
            { key: "result", value: result },
            { key: "error", value: error },
        ]));
    }

    // (C-S4: every routed type has a descriptor, so `null` here is unreachable on a checked Core.)
    export fn wireOrNull(p: CoreProgram, t: Type) -> JsExpr {
        const wt: WireTable | not = wireBuild(p, t).table;
        if (wt is given) return wireTableJs(wt);
        return JsExpr.JNull;
    }

    // The ServerFns a ServerCall names, in program order, each once.
    // s473: and every `<db>` cell's load (CoreProgram.loads) — the client calls it at boot.
    export fn calledServerFns(p: CoreProgram) -> ServerFn[] {
        return calledServerFnsWith(p, [], serverInits(p));
    }

    // s482 r1 (#2061 review M3) — ~~a ServerCall anywhere in the program~~: one in code that
    // can RUN. A server function only an unreached client function calls (§12.2 Trigger 6 — the
    // function is in neither artifact) got a route, and the client its route descriptor: an
    // endpoint no shipped code calls, its path published. FAIL CLOSED: only the code known never
    // to run is left out — a function the client cannot run (clientLiveFns) that server code
    // does not reach either (serverOnlyFns / reachedOnlyByServer, or a server-only initializer's
    // reach); a component nothing constructs and a nested function nothing reaches are already
    // gone (shakeProgram). Every declaration, server function and file-scope initializer is
    // still read. `keep` / `si`: as clientLiveFns'.
    export fn calledServerFnsWith(p: CoreProgram, keep: int[], si: int[]) -> ServerFn[] {
        let ids: int[] = [];
        for (const ld of p.loads) { if (!hasInt(ids, ld.fn.id)) ids = ids.concat([ld.fn.id]); }
        const live: int[] = clientLiveFns(p, keep, si);
        const serverOnly: int[] = serverOnlyFns(p).concat(reachedOnlyByServer(p));
        const siFns: int[] = fnClosureThroughConsts(p, siRoots(p, si));
        let roots: Node[] = [];
        for (const d of p.decls) { roots = roots.concat([Node.NDecl(d)]); }
        for (const f of p.fns) {
            const id: int = f.sym.id;
            if (hasInt(live, id) || hasInt(serverOnly, id) || hasInt(siFns, id)) roots = roots.concat([Node.NFn(f)]);
        }
        for (const sf0 of p.server) { roots = roots.concat([Node.NServerFn(sf0)]); }
        for (const k of p.consts) { roots = roots.concat([Node.NExpr(k.init)]); }
        for (const r of roots) {
            for (const n of allNodes(r)) {
                const s: Sym | not = nodeServerCall(n);
                if (s is given) { if (!hasInt(ids, s.id)) ids = ids.concat([s.id]); }
            }
        }
        let out: ServerFn[] = [];
        for (const sf of p.server) { if (hasInt(ids, sf.sym.id)) out = out.concat([sf]); }
        return out;
    }

    fn nodeServerCall(n: Node) -> Sym | not {
        return match n {
            .NExpr(e: e) :> exprServerCall(e),
            .NStmt(s: x) :> not,
            .NProgram(p: x) :> not,
            .NDecl(d: x) :> not,
            .NField(f: x) :> not,
            .NFn(f: x) :> not,
            .NServerFn(f: x) :> not,
            .NBlock(b: x) :> not,
            .NPlace(pl: x) :> not,
            .NInst(i: x) :> not,
            .NPattern(pat: x) :> not,
            .NEdit(k: x) :> not,
            .NView(v: x) :> not,
            .NAttr(a: x) :> not
        };
    }

    fn exprServerCall(e: Expr) -> Sym | not {
        return match e {
            .ServerCall(fn: f) :> f,
            .Query(q: x) :> not,
            .Foreign(slice: fsl0) :> not,
            .Lit(lit: x) :> not,
            .Local(sym: x) :> not,
            .Read(place: x) :> not,
            .Call(callee: x) :> not,
            .FnRef(fn: x) :> not,
            .CallV(f: x) :> not,
            .Prim(op: x) :> not,
            .Match(scrut: x) :> not,
            .ArrayOf(elems: x) :> not,
            .StructOf(ty: x) :> not,
            .VariantOf(enumSym: x) :> not,
            .Handle(inst: x) :> not,
            .Assigned(local: x) :> not,
            .InitOf(decl: x) :> not,
            .Host(call: x) :> not,
            .Lambda(params: x) :> not,
            .BlockLambda(params: x) :> not,
            .SeqCall(op: x) :> not,
            .Refetch(req: rf0) :> not,
            .Validity(of: x) :> not
        };
    }

    // s468 (U1c) — "Trigger 5 is emission" (U1 design §2: "The server artifact
    // contains the transitive closure (over Core `Call` Syms) of every ServerFn;
    // the client artifact the closure of the client roots"): a function only
    // server functions reach — through a call in their bodies, in a query's
    // value, or through other functions — is in the server artifact and not
    // here. One the client also reaches is printed in both (§13.4 "TWO
    // representations"); one nobody reaches stays here (dead either way).
    // s479: both closures follow the file-scope bindings their code reads into the functions
    // those bindings' initializers call (fnClosureThroughConsts).
    fn reachedOnlyByServer(p: CoreProgram) -> int[] {
        let croots: Node[] = [];
        for (const d of p.decls) { croots = croots.concat([Node.NDecl(d)]); }
        const client: int[] = fnClosureThroughConsts(p, croots);
        let sroots: Node[] = [];
        for (const sf of p.server) { sroots = sroots.concat([Node.NServerFn(sf)]); }
        const server: int[] = fnClosureThroughConsts(p, sroots);
        let out: int[] = [];
        for (const id of server) { if (!hasInt(client, id)) out = out.concat([id]); }
        return out;
    }

    // s482 (s482-client-roots; g-boot-dead-client-fn-ships-server-const-s481) — the functions
    // the CLIENT artifact can run: those reached (called, or named as a value — FnRef) from what
    // it runs, transitively and through the file-scope bindings that code reads
    // (fnClosureThroughConsts). §12.2 Trigger 6: "Functions that are never called … are
    // tree-shaken out of all output." Before this, every function that was not server-only was a
    // client root whether or not anything reached it, so a function nothing calls that reads a
    // binding only server code otherwise reads shipped that binding into the client artifact,
    // against S472 "a value read only by server code never reaches the client artifact".
    // The roots, read FAIL-CLOSED (counted reached when in doubt — dropping a function the client
    // needs is a runtime ReferenceError):
    //  - every declaration of `p` (the program, and each component the program can construct —
    //    shakeProgram has dropped the others, §41.9): its fields' initializers, views,
    //    attributes, handlers, effects and wiring;
    //  - each channel's `onclient:*` hooks (§38.10.2 — named by Sym, not by a call);
    //  - the §25.7 CSS bridges' reads (cssVarStmts prints them in the client);
    //  - the initializer of every file-scope binding no server code reads whose initializer may
    //    act (initActs) and that is not server-only (`si`, serverInits): the client runs such a
    //    binding when no artifact reads it (clientConsts, bodyInits — S481 "every file-scope
    //    initializer runs"), so what it calls is client code. s482 r1 (#2061 review H1): ~~a
    //    server-only one is counted too: over-inclusion only keeps a function~~ — a server-only
    //    initializer runs in the SERVER artifact (print-server.scrml serverConsts), so it roots
    //    nothing here, and the bindings it reads are server-read (siRoots counted as server
    //    code): a function only it reaches, and a constant only that function reads, is not in
    //    the client artifact. (`si` = [] counts every acting initializer — serverInitsExposing's
    //    first, over-inclusive round.)
    //  - `keep`: the functions a caller of printProgramExposing names (test scaffolding that calls
    //    a function directly — slice-m1/load-program.js `expose`); empty on every compile;
    //  - a `kind="tool"` program keeps every function (its functions are all server-placed and
    //    printed by printTool; nothing here judges them).
    // A function only an unreached function reaches is unreached too. Exports (§21) do not
    // matter here: the client artifact exports nothing (a library entry is refused above).
    fn clientLiveFns(p: CoreProgram, keep: int[], si: int[]) -> int[] {
        if (p.tool is given) {
            let all: int[] = [];
            for (const f0 of p.fns) { all = all.concat([f0.sym.id]); }
            return all;
        }
        let roots: Node[] = [];
        for (const d of p.decls) { roots = roots.concat([Node.NDecl(d)]); }
        for (const kid of keep) { roots = roots.concat([Node.NExpr(Expr.FnRef(mkSym(kid, "")))]); }
        for (const ch of p.channels) {
            for (const h of [ch.open, ch.close, ch.error]) {
                if (h is given) roots = roots.concat([Node.NExpr(Expr.FnRef(h))]);
            }
        }
        const css: CoreCss | not = p.css;
        if (css is given) { for (const cv of css.vars) { roots = roots.concat([Node.NExpr(cv.read)]); } }
        const serverOnly: int[] = serverOnlyFns(p).concat(reachedOnlyByServer(p));
        const sread: int[] = constsReached(p, serverRoots(p, serverOnly, si));
        for (const k of p.consts) {
            if (!hasInt(si, k.sym.id) && !hasInt(sread, k.sym.id) && initActs(k.init)) roots = roots.concat([Node.NExpr(k.init)]);
        }
        // s482 (lane s482-write-only-secret): closed through the initializers of the bindings this
        // code READS — one it only overwrites keeps its initializer out of the client unless the loop
        // above roots it (clientNoInit / clientConsts: the same condition)
        return fnClosureThroughReads(p, roots);
    }

    // s482 r1 (#2061 review H1) — the code the SERVER artifact runs, as roots: the server
    // functions, the functions only server code reaches (`serverOnly`), and the initializers of
    // the server-only bindings (`si`, serverInits — print-server.scrml serverConsts runs them at
    // module initialization). What clientLiveFns / clientConsts / bodyInits / serverInits judge
    // "server code reads" from.
    fn serverRoots(p: CoreProgram, serverOnly: int[], si: int[]) -> Node[] {
        let sroots: Node[] = [];
        for (const sf of p.server) { sroots = sroots.concat([Node.NServerFn(sf)]); }
        for (const f of p.fns) { if (hasInt(serverOnly, f.sym.id)) sroots = sroots.concat([Node.NFn(f)]); }
        return sroots.concat(siRoots(p, si));
    }

    fn siRoots(p: CoreProgram, si: int[]) -> Node[] {
        let out: Node[] = [];
        for (const k of p.consts) { if (hasInt(si, k.sym.id)) out = out.concat([Node.NExpr(k.init)]); }
        return out;
    }

    // s482 — the client functions as roots: every function that is not server-only (`serverOnly`)
    // and that the client can run (clientLiveFns). What clientConsts / bodyInits / serverInits
    // judge "the client reads" from, and what printProgram prints.
    fn clientFnRoots(p: CoreProgram, serverOnly: int[], keep: int[], si: int[]) -> Node[] {
        const live: int[] = clientLiveFns(p, keep, si);
        let out: Node[] = [];
        for (const f of p.fns) { if (!hasInt(serverOnly, f.sym.id) && hasInt(live, f.sym.id)) out = out.concat([Node.NFn(f)]); }
        return out;
    }

    // =========================================================================
    // s482 (s482-registry-client) — §22.4.2 strategy 2, the client-used registry
    // (ruling:user-voice-scrml.md-S482-registry-client-types: "client-used types only"). A runtime
    // `reflect` whose argument is not a type literal looks its name up in a registry
    // (meta.scrml rtReflect: every type in scope at the block). The client artifact prints only the
    // entries of the types the CLIENT half uses: a type that only server code reaches (a server
    // function, a function only server code reaches, a server-only binding's initializer), or that
    // no code names, is left out, so its name and its field names are not in the client bundle and
    // a lookup of it gives `not` (§22.5.4 "Unknown names SHALL return `not`").
    // "The client half" is the code the client artifact holds, as #2061's reach decides it
    // (printProgramExposing: the declarations, the functions clientLiveFns keeps that are not
    // server-only, and the constants clientConsts gives the client) — no second reach walk.
    // Within it a type is USED when it is named by: a struct or variant value (StructOf /
    // VariantOf / a variant literal or pattern), a field path's owner (a read, a write, a local
    // part write), a cell's type (Field.ty), a client function's parameter types or error enum, a
    // `fail`'s enum, the signature (parameters, return, error enum) of a server function the
    // client calls (calledServerFnsWith — the client holds those values), and a runtime
    // `reflect` with a type LITERAL (`reflect(T)`, `meta.types.reflect("T")` — client code naming
    // T). Closed transitively through struct fields and enum payloads (codec.scrml
    // typesReached): a client type's field of a server-only type keeps that type (fail-safe — the
    // client already holds values of it). The five primitive entries are always kept.
    // s482 r1 (#2093 review): matched by the type's IDENTITY, not its name — lower.scrml
    // reflectIds gives each registry entry the Sym id of the type its name denotes in the
    // block's file (s482 r2: exactly one — the file's own declaration, else the one its import
    // names), and an entry is kept only when that type is client-used (HIGH-1: a server-only
    // `Config` in one file no longer ships because another file's `Config` is client-used). Also USED (LOW-1): a client function's declared return type and a client
    // local's written annotation (CoreProgram.typed), as a called server function's are.
    // =========================================================================
    fn clientRegistryIds(p: CoreProgram, roots: Node[], called: ServerFn[]) -> int[] {
        let seeds: Type[] = [];
        let lits: int[] = [];
        let skip: int[] = [];
        let declared: int[] = [];
        for (const r of roots) {
            for (const n of allNodes(r)) {
                seeds = seeds.concat(nodeTypes(n));
                lits = lits.concat(nodeReflectLit(n));
                skip = skip.concat(nodeEntrySyms(n));
                declared = declared.concat(nodeDeclared(n));
            }
        }
        for (const tn of p.typed) {
            if (hasInt(declared, tn.sym.id)) seeds = seeds.concat([tn.ty]);
        }
        for (const sf of called) {
            for (const pr of sf.params) { seeds = seeds.concat([pr.ty]); }
            const rt0: Type | not = sf.ret;
            if (rt0 is given) seeds = seeds.concat([rt0]);
            seeds = seeds.concat(errType(sf.err));
        }
        for (const td of p.types) {
            const ts: Sym = typeDefSym(td);
            if (hasInt(lits, ts.id) && !hasInt(skip, ts.id)) seeds = seeds.concat([Type.Named(ts)]);
        }
        let acc: Sym[] = [];
        for (const t of seeds) { acc = typesReachedFn(p, t, acc, skip); }
        let out: int[] = [];
        for (const s of acc) {
            if (hasInt(skip, s.id)) continue;
            const td: TypeDef | not = findTypeDef(p, s);
            if (td is given && !hasInt(out, s.id)) out = out.concat([s.id]);
        }
        return out;
    }

    // s482 r1 (#2093 review LOW-1) — the Syms whose WRITTEN type (CoreProgram.typed) one client
    // node declares: a client function (its return type), a local it binds (its annotation)
    fn nodeDeclared(n: Node) -> int[] {
        return match n {
            .NFn(f: f) :> [f.sym.id],
            .NStmt(s: s) :> stmtDeclared(s),
            // no-default-arm: only a function and a binding statement declare a written type
            _ :> []
        };
    }

    fn stmtDeclared(s: Stmt) -> int[] {
        return match s {
            .Let(sym: x) :> [x.id],
            .Suspend(bind: b) :> [b.id],
            // no-default-arm: one question of a statement — the local it binds
            _ :> []
        };
    }

    // typesReached, with a function type's parts followed (a client parameter of a function type)
    // and the registry's own `TypeInfo` / `FieldInfo` (`skip`) never followed
    fn typesReachedFn(p: CoreProgram, t: Type, acc: Sym[], skip: int[]) -> Sym[] {
        const k: Type = t;
        return match k {
            .Fn(params: ps, ret: r, pure: pu, err: e) :> fnTypeReached(p, ps, r, e, acc, skip),
            .Named(sym: s) :> namedReached(p, s, acc, skip),
            // no-default-arm: every other type reaches what codec's closure gives it
            _ :> typesReached(p, t, acc)
        };
    }

    fn namedReached(p: CoreProgram, s: Sym, acc: Sym[], skip: int[]) -> Sym[] {
        if (hasInt(skip, s.id)) return acc;
        return typesReached(p, Type.Named(s), acc);
    }

    fn fnTypeReached(p: CoreProgram, ps: Type[], r: Type | not, e: Sym | not, acc: Sym[], skip: int[]) -> Sym[] {
        let out: Sym[] = acc;
        for (const t of ps) { out = typesReachedFn(p, t, out, skip); }
        if (r is given) out = typesReachedFn(p, r, out, skip);
        for (const et of errType(e)) { out = typesReachedFn(p, et, out, skip); }
        return out;
    }

    fn errType(e: Sym | not) -> Type[] {
        if (e is given) return [Type.Named(e)];
        return [];
    }

    fn refsTypes(rs: FieldRef[]) -> Type[] {
        let out: Type[] = [];
        for (const r of rs) { out = out.concat([Type.Named(r.owner)]); }
        return out;
    }

    fn litTypes(l: Literal) -> Type[] {
        return match l {
            .Variant(enumSym: es) :> [Type.Named(es)],
            // no-default-arm: one question of a literal — the enum a variant literal names
            _ :> []
        };
    }

    // the types one client node names (clientRegistryIds)
    fn nodeTypes(n: Node) -> Type[] {
        return match n {
            .NExpr(e: e) :> exprTypes(e),
            .NPlace(pl: pl) :> placeTypes(pl),
            .NPattern(pat: pat) :> patTypes(pat),
            .NEdit(k: k) :> editTypes(k),
            .NStmt(s: s) :> stmtTypes(s),
            .NField(f: f) :> [f.ty],
            .NFn(f: f) :> fnTypes(f),
            // no-default-arm: the other nodes name no type of their own (their parts are walked)
            _ :> []
        };
    }

    fn fnTypes(f: Fn) -> Type[] {
        let out: Type[] = [];
        for (const pr of f.params) { out = out.concat([pr.ty]); }
        return out.concat(errType(f.err));
    }

    fn exprTypes(e: Expr) -> Type[] {
        return match e {
            .StructOf(ty: t) :> [Type.Named(t)],
            .VariantOf(enumSym: es) :> [Type.Named(es)],
            .Lit(lit: l) :> litTypes(l),
            // no-default-arm: one question of an expression — the type its value is built as
            _ :> []
        };
    }

    fn placeTypes(pl: Place) -> Type[] {
        return match pl {
            .Cell(path: rs) :> refsTypes(rs),
            .LocalPath(path: rs) :> refsTypes(rs),
            // no-default-arm: one question of a place — the owners of its field path
            _ :> []
        };
    }

    fn patTypes(pat: Pattern) -> Type[] {
        return match pat {
            .PVariant(enumSym: es) :> [Type.Named(es)],
            .PLit(lit: l) :> litTypes(l),
            // no-default-arm: one question of a pattern — the enum it tests
            _ :> []
        };
    }

    fn editTypes(k: EditKind) -> Type[] {
        return match k {
            .FieldAt(path: rs) :> refsTypes(rs),
            .ElemAt(path: rs) :> refsTypes(rs),
            // no-default-arm: one question of an edit — the owners of its field path
            _ :> []
        };
    }

    fn stmtTypes(s: Stmt) -> Type[] {
        return match s {
            .Assign(path: ps) :> stepTypes(ps),
            .Fail(err: e) :> [Type.Named(e)],
            // no-default-arm: one question of a statement — the types its own fields name
            _ :> []
        };
    }

    fn stepTypes(ps: PathStep[]) -> Type[] {
        let out: Type[] = [];
        for (const st of ps) { out = out.concat(stepType(st)); }
        return out;
    }

    fn stepType(st: PathStep) -> Type[] {
        return match st {
            .StepField(ref: r) :> [Type.Named(r.owner)],
            .StepIndex(index: ix) :> []
        };
    }

    // a runtime `reflect` with a type LITERAL — `Prim(MetaReflect, [Lit(Str(T)), [the entry of T],
    // [[T's Sym id]]])` (meta.scrml rtReflect; lower.scrml reflectIds) — names T: the Sym id of
    // the type T denotes in the block's file (s482 r2: one id; anything else seeds nothing)
    fn nodeReflectLit(n: Node) -> int[] {
        const a: Expr[] = reflectArgs(n);
        if (a.length != 3) return [];
        const nm: string = strLitExpr(a[0]);
        if (nm == "") return [];
        if (arrayElemsOf(a[1]).length != 1) return [];
        const ids: int[] = entryIds(a[2], 0);
        if (ids.length != 1) return [];
        return ids;
    }

    // entry `i`'s Sym ids, from a runtime `reflect`'s third argument (lower.scrml reflectIds)
    fn entryIds(ids: Expr, i: int) -> int[] {
        const per: Expr[] = arrayElemsOf(ids);
        if (i >= per.length) return [];
        let out: int[] = [];
        for (const x of arrayElemsOf(per[i])) { out = out.concat(intLitExpr(x)); }
        return out;
    }

    fn intLitExpr(e: Expr) -> int[] {
        return match e {
            .Lit(lit: l) :> intOfLit(l),
            // no-default-arm: one question of an expression — the int literal it is
            _ :> []
        };
    }

    fn intOfLit(l: Literal) -> int[] {
        return match l {
            .Int(v: v) :> [v],
            // no-default-arm: one question of a literal — the int it is
            _ :> []
        };
    }

    // the registry's own record types (`TypeInfo` for an entry, `FieldInfo` for a field), never a
    // type the client uses
    fn nodeEntrySyms(n: Node) -> int[] {
        const a: Expr[] = reflectArgs(n);
        if (a.length < 2) return [];
        let out: int[] = [];
        for (const en of arrayElemsOf(a[1])) {
            out = out.concat(structSym(en));
            for (const fx of structFields(en)) {
                for (const fr of arrayElemsOf(fx)) { out = out.concat(structSym(fr)); }
            }
        }
        return out;
    }

    fn structSym(e: Expr) -> int[] {
        return match e {
            .StructOf(ty: t) :> [t.id],
            // no-default-arm: one question of an expression — the struct it builds
            _ :> []
        };
    }

    fn structFields(e: Expr) -> Expr[] {
        return match e {
            .StructOf(fields: fs) :> fs,
            // no-default-arm: one question of an expression — a struct value's fields
            _ :> []
        };
    }

    // a runtime `reflect`'s arguments; empty for any other node
    fn reflectArgs(n: Node) -> Expr[] {
        return match n {
            .NExpr(e: e) :> reflectPrimArgs(e),
            // no-default-arm: a registry stands only in an expression
            _ :> []
        };
    }

    fn reflectPrimArgs(e: Expr) -> Expr[] {
        return match e {
            .Prim(op: o, args: a) :> (o == PrimOp.MetaReflect ? a : []),
            // no-default-arm: one question of an expression — is it a runtime `reflect`
            _ :> []
        };
    }

    fn arrayElemsOf(e: Expr) -> Expr[] {
        return match e {
            .ArrayOf(elems: es) :> es,
            // no-default-arm: one question of an expression — a list's elements
            _ :> []
        };
    }

    fn strLitExpr(e: Expr) -> string {
        return match e {
            .Lit(lit: l) :> strOfLit(l),
            // no-default-arm: one question of an expression — the string literal it is
            _ :> ""
        };
    }

    fn strOfLit(l: Literal) -> string {
        return match l {
            .Str(v: s) :> s,
            // no-default-arm: one question of a literal — the string it is
            _ :> ""
        };
    }

    // a runtime `reflect`'s arguments as the client prints them: its registry holds the entries
    // of the primitive names and of the types the client uses (`ctx.pix.reg`), no other. The
    // third argument (lower.scrml reflectIds, each entry's type identity) is never printed.
    fn regArgs(ctx: Ctx, op: PrimOp, args: Expr[]) -> Expr[] {
        if (op != PrimOp.MetaReflect || args.length < 2) return args;
        let ids: Expr = Expr.ArrayOf([]);
        if (args.length > 2) ids = args[2];
        let kept: Expr[] = [];
        let i: int = 0;
        for (const en of arrayElemsOf(args[1])) {
            if (entryKept(ctx, en, entryIds(ids, i))) kept = kept.concat([en]);
            i = i + 1;
        }
        return [args[0], Expr.ArrayOf(kept)];
    }

    // an entry (meta.scrml entryExpr: a `TypeInfo` StructOf) is kept when it is a primitive's,
    // or when the ONE type its name denotes in the block's file (`ids`, lower.scrml reflectIds)
    // is one the client uses — none given, more than one, or one not client-used drops it
    // (fail closed)
    fn entryKept(ctx: Ctx, en: Expr, ids: int[]) -> boolean {
        const ty: int[] = structSym(en);
        if (ty.length != 1) return false;
        let kind: string = "";
        let name: string = "";
        let i: int = 0;
        const owner: Sym = mkSym(ty[0], "");
        for (const f of structFields(en)) {
            const m: string = memberName(ctx, owner, i);
            if (m == "kind") kind = strLitExpr(f);
            if (m == "name") name = strLitExpr(f);
            i = i + 1;
        }
        if (kind == "primitive") return true;
        if (name == "" || ids.length != 1) return false;
        return hasInt(ctx.pix.reg, ids[0]);
    }

    fn withReg(ctx: Ctx, reg: int[]) -> Ctx {
        const ix: PrintIx = { constructed: ctx.pix.constructed, reinits: ctx.pix.reinits, reg: reg, gseeds: ctx.pix.gseeds };
        return { p: ctx.p, pix: ix, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared,
                 rows: ctx.rows, slot: ctx.slot, prebuilt: ctx.prebuilt, ret: ctx.ret, server: ctx.server, tier0: ctx.tier0, cycles: ctx.cycles, ns: ctx.ns, owned: ctx.owned };
    }

    // =========================================================================
    // s482 r1 (s482-client-roots; #2061 review M1/M2) — §12.2 Trigger 6 ("Functions that are
    // never called … are tree-shaken out of all output") and §41.9 ("only the components and
    // values that are actually referenced … are included in the compiled output") applied to
    // what clientLiveFns cannot drop by itself: a NESTED function (Stmt.LocalFn, §7.3.1) is
    // printed with its enclosing function, and a COMPONENT declaration was a client root whether
    // or not anything constructed it — so a dead one shipped the constants it (or a function only
    // it calls) reads. `p` without them: each function body keeps the nested functions it reaches
    // (prunedBody), and `decls` keeps the program, every non-user declaration, and each component
    // live code can construct (liveDecls). Both printers start from it (printProgramExposing,
    // print-server.scrml printServerBuild), so the two artifacts judge one program. A tool is
    // returned as it is (printTool prints every function; nothing here judges it).
    // =========================================================================
    //
    // s482 r1 (#2105 review HIGH-1): and the cells declared outside the body placed as the
    // library's plain initializers are (outerPlaced) — the last step, so both artifacts judge
    // the one result.
    export fn shakeProgram(p: CoreProgram, keep: int[]) -> CoreProgram {
        if (p.tool is given) return p;
        return outerPlaced(shakeDecls(p, keep), keep);
    }

    fn shakeDecls(p: CoreProgram, keep: int[]) -> CoreProgram {
        let fs: Fn[] = [];
        for (const f of p.fns) { fs = fs.concat([prunedFn(f)]); }
        const p1: CoreProgram = withDeclsFns(p, p.decls, fs, p.loads);
        const live: int[] = liveDecls(p1, keep);
        if (live.length == p1.decls.length) return p1;
        let ds: Decl[] = [];
        let gone: int[] = [];
        for (const d of p1.decls) {
            if (hasInt(live, d.sym.id)) {
                ds = ds.concat([d]);
            } else {
                for (const fl of d.fields) { gone = gone.concat([fl.sym.id]); }
            }
        }
        // a dropped component's `<db>` cells are loaded by no one (their routes go too)
        let lds: DbLoad[] = [];
        for (const ld of p1.loads) { if (!hasInt(gone, ld.cell.id)) lds = lds.concat([ld]); }
        return withDeclsFns(p1, ds, p1.fns, lds);
    }

    // =========================================================================
    // s482 r1 (#2105 review HIGH-1; ruling:user-voice-scrml.md-S482-outside-cell-seed-time — "before
    // the body, in link order" — the same as the library's plain `let` / `const` initializers, even
    // when nothing reads the cell; §7.6 rule (b) / R6 and the S481 server-only classification;
    // ruling:user-voice-scrml.md-S482-circular-server-only — the largest set). A cell declared
    // outside the body whose seed runs before the body (outerLive) is classified as a plain
    // file-scope binding is — by serverInits itself, not by a second rule: each such cell is
    // judged as a binding whose initializer is its seed (outerAsConsts; constReads counts a
    // reference to its shared instance as a read of it). One that classification makes
    // SERVER-ONLY (no client code reads the cell, and its seed reaches server-only code — a
    // function the client does not hold, or a binding only server code reads, directly, through a
    // function, or through another such cell) is not a cell of the client at all: it is that
    // binding in the program both printers print — the client artifact holds none of it (nor what
    // only it reaches), and the server artifact runs its seed at module initialization, in link
    // order (print-server.scrml serverConsts), as it runs a server-only `const`. Any other stays
    // a cell, constructed before the body as before. (A server-only seed that reads a cell, or
    // calls through what the walk cannot follow, can run in neither artifact: outerRefusal.)
    // A program with no such cell is returned as it is.
    // =========================================================================
    //
    // s483 (lane s483-body-cell-server-only; ruling:user-voice-scrml.md-S482-body-cell-server-only — "treat
    // body cells like top-level ones, so the same rule (b) classification applies"): and the cells of
    // the program BODY (bodyCands), judged in the same classification — each as a binding whose
    // initializer is its seed (bodyAsConsts) — so a chain through both kinds (o2b: an unread body cell
    // reading an outer cell) is one fixed point. A body cell it makes server-only is a SHELL field in
    // the program declaration and a binding the server artifact runs (bodyAsConsts `fin`).
    fn outerPlaced(p: CoreProgram, keep: int[]) -> CoreProgram {
        return outerPlacedBy(p, outerMoves(p, keep));
    }

    // s483 r2 (#2128 r1 re-review H2d): the classification alone — the Sym ids of the cells declared
    // outside the body and of the body / component fields it makes server-only (outerPlaced moves them;
    // invLeakRefusal compares two runs of it)
    fn outerMoves(p: CoreProgram, keep: int[]) -> int[] {
        const outs: OuterCell[] = outerLive(p);
        const bcs: int[] = bodyCands(p);
        if (outs.length == 0 && bcs.length == 0) return [];
        const si: int[] = serverInitsExposing(bodyAsConsts(outerAsConsts(p, outs, false), p, bcs, false), keep);
        let out: int[] = [];
        for (const oc of outs) { if (hasInt(si, oc.decl.id)) out = out.concat([oc.decl.id]); }
        for (const b of bcs) { if (hasInt(si, b)) out = out.concat([b]); }
        return out;
    }

    fn outerPlacedBy(p: CoreProgram, mv: int[]) -> CoreProgram {
        if (mv.length == 0) return p;
        let moved: OuterCell[] = [];
        for (const oc of outerLive(p)) { if (hasInt(mv, oc.decl.id)) moved = moved.concat([oc]); }
        let bmoved: int[] = [];
        for (const b of bodyCands(p)) { if (hasInt(mv, b)) bmoved = bmoved.concat([b]); }
        if (moved.length == 0 && bmoved.length == 0) return p;
        let q: CoreProgram = p;
        if (moved.length > 0) q = outerAsConsts(p, moved, true);
        if (bmoved.length > 0) q = bodyAsConsts(q, p, bmoved, true);
        return q;
    }

    // `p` with each cell of `cs` (cells declared outside the body, CoreProgram.outer) as a
    // file-scope binding: its declaration dropped, and a binding of the declaration's Sym whose
    // initializer is the cell's seed put among the constants at its place in link order
    // (OuterCell.at). It stays in `outer` (runsK: its seed is placed even when it does nothing);
    // each later outer cell's place moves past the bindings put before it.
    // s482 (lane s482-write-only-secret) — `shells`: a cell of `cs` that code WRITES whole (a
    // whole-value Write of its shared instance, overwrittenSharedOf — a client read keeps the cell
    // client-read, so not server-only; a read in code that never runs, a function nothing calls,
    // names no shell) keeps a SHELL declaration: the declaration
    // with the absence value `not` (§42) as its seed, so the client's writes have a cell to write and
    // the seed — which runs in the server artifact — is not in the client. Its seed does nothing,
    // so it is constructed at its first write (outerLive: not live). Its value is never observed: a
    // client read of the cell would have been counted. The binding of the same Sym carries the real
    // seed (findConst; outerRefusal judges it).
    fn outerAsConsts(p: CoreProgram, cs: OuterCell[], shells: boolean) -> CoreProgram {
        let named: int[] = [];
        if (shells) {
            for (const n of allNodes(Node.NProgram(p))) {
                const w: int = overwrittenSharedOf(n);
                if (w >= 0 && !hasInt(named, w)) named = named.concat([w]);
            }
        }
        let ds: Decl[] = [];
        for (const d of p.decls) {
            if (!outerIn(cs, d.sym.id)) ds = ds.concat([d]);
            else if (hasInt(named, d.sym.id)) ds = ds.concat([shellDecl(d)]);
        }
        let ks: CoreConst[] = [];
        let i: int = 0;
        for (const k of p.consts) {
            for (const c of cs) { if (c.at == i) ks = ks.concat(seedConst(p, c)); }
            ks = ks.concat([k]);
            i = i + 1;
        }
        for (const c2 of cs) { if (c2.at >= p.consts.length) ks = ks.concat(seedConst(p, c2)); }
        let os: OuterCell[] = [];
        let n: int = 0;
        for (const o of p.outer) {
            os = os.concat([{ decl: o.decl, at: o.at + n }]);
            if (outerIn(cs, o.decl.id)) n = n + 1;
        }
        return { program: p.program, decls: ds, types: p.types, fns: p.fns, server: p.server, dbs: p.dbs, reset: p.reset, sqlError: p.sqlError,
                 serverCallError: p.serverCallError, css: p.css, consts: ks, loads: p.loads, envelopes: p.envelopes, head: p.head,
                 tool: p.tool, endpoints: p.endpoints, channels: p.channels, typed: p.typed, outer: os };
    }

    fn shellDecl(d: Decl) -> Decl {
        let fs: Field[] = [];
        for (const f of d.fields) {
            fs = fs.concat([{ sym: f.sym, ty: f.ty, init: Expr.Lit(Literal.Absent), mode: f.mode, role: f.role, grants: f.grants, graph: f.graph,
                              exported: f.exported, wcap: f.wcap, vals: f.vals, persist: f.persist, timing: f.timing }]);
        }
        return { sym: d.sym, key: d.key, kind: d.kind, single: d.single, fields: fs, renders: d.renders, wiring: d.wiring, handles: d.handles, invs: d.invs };
    }

    fn seedConst(p: CoreProgram, c: OuterCell) -> CoreConst[] {
        const d: Decl | not = findDecl(p, c.decl);
        if (d is not) return [];
        const f: Field = d.fields[0];
        const init: Expr | not = f.init;
        if (init is not) return [];
        return [{ sym: d.sym, init: init, mutable: f.wcap is given }];
    }

    // s482 r1 (#2105 review HIGH-1) — a server-only outer cell (outerPlaced) whose seed reads a
    // cell, or calls through what the walk cannot follow (readsCellReach, fail closed): the server
    // artifact holds no cell, and the client must not run it (its seed reaches server-only code).
    // ⚑ INTERIM (g-boot-outer-cell-server-seed-reads-cell-s482): refused by name, never printed
    // into either artifact.
    export fn outerRefusal(p: CoreProgram) -> string[] {
        let out: string[] = [];
        for (const oc of p.outer) {
            // s482 (lane s482-write-only-secret): a moved cell is the binding of its Sym (findConst) —
            // its shell declaration (outerAsConsts `shells`) may remain
            if (findConst(p, oc.decl.id) is given) {
                const k: CoreConst | not = findConst(p, oc.decl.id);
                if (k is given && readsCellReach(p, k.init)) {
                    out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: the seed of `@" + oc.decl.hint + "`, a cell declared outside the program body that nothing on the client reads, reaches server-only code, so it runs in the server artifact (§7.6 rule (b), S481/S482) — but it also reads a cell (or calls through what the bootstrap cannot follow), which the server artifact does not hold. The bootstrap does not run such a seed yet (⚑ INTERIM, g-boot-outer-cell-server-seed-reads-cell-s482). Read the cell in the page, or seed it from bindings and functions only"]);
                }
            }
        }
        // s483 (lane s483-body-cell-server-only): the same for a cell of the program BODY that
        // bodyPlaced made server-only (a derived one has no binding: nothing runs its formula)
        const pd: Decl | not = programDeclOf(p);
        if (pd is given) {
            for (const f of pd.fields) {
                const bk: CoreConst | not = findConst(p, f.sym.id);
                if (bk is given && readsCellReach(p, bk.init)) {
                    out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: the seed of `@" + f.sym.hint + "`, a cell of the program body that nothing on the client reads, reaches server-only code, so it runs in the server artifact (§7.6 rule (b), S481/S482; ruling:user-voice-scrml.md-S482-body-cell-server-only — a body cell is judged as a file-scope binding is) — but it also reads a cell (or calls through what the bootstrap cannot follow), which the server artifact does not hold. The bootstrap does not run such a seed yet (⚑ INTERIM, g-boot-outer-cell-server-seed-reads-cell-s482). Read the cell in the page, or seed it from bindings and functions only"]);
                }
            }
        }
        return out;
    }

    // =========================================================================
    // s483 (lane s483-body-cell-server-only; gap g-boot-body-unread-cell-server-only-s482;
    // ruling:user-voice-scrml.md-S482-body-cell-server-only — "(a) treat body cells like top-level
    // ones, so the same rule (b) classification applies"). A cell of the program BODY is a field of the
    // program declaration — a client root — so its seed was printed in the client whether or not any
    // code read it, with whatever server-only binding the seed reached (probes s12 / s13 / o2b / n31).
    // It is now judged by §7.6 rule (b) exactly as a file-scope binding and a cell declared outside the
    // body are — by serverInits itself, not by a second rule (outerPlaced): each candidate (bodyCands)
    // is put in the program as a binding of its field's Sym whose initializer is its seed
    // (bodyAsConsts), and a reference to the field is a use of that binding (constReads / constUseIn
    // through bodyUseOf): a read, or a whole-value overwrite (`@c = v`, EditKind.Replace with a static
    // check — "a write is not a read", S482). One the classification makes SERVER-ONLY — nothing on the
    // client reads it, and its seed reaches server-only code, directly, through a function, or through
    // another server-only binding (the largest set) — keeps its field in the program declaration as a
    // SHELL (seed `not`, §42 — S482 `prov=pa-ruled:S482-write-only-shell-not`), so the record's field
    // positions and the client's writes stand; and its seed becomes that binding, which the server
    // artifact runs at module initialization at its place in Core order (print-server.scrml
    // serverConsts). A DERIVED body cell (a locked one whose formula reads a cell, §66.9 rule 3) has no
    // place: its formula runs only when it is read, so an unread one runs nowhere — it is a shell and
    // no binding. One whose seed reads a cell is refused by name (outerRefusal — the server artifact
    // holds no cell).
    //
    // s483 (lane s483-component-cell-server-only; ruling:user-voice-scrml.md-S483-component-cell-server-only
    // — RULED (a): "an unread component cell whose seed reaches server-only code becomes an empty client
    // stand-in and nothing runs its seed"): and the cells of a COMPONENT declaration's body (bodyCands),
    // judged in the same fixed point — no second classifier. A component cell is a field of every
    // instance of its declaration; the classification is the DECLARATION's: a read through any
    // instance (the declaration's own renders and handlers — Lexical, an `as=` handle, the shared
    // instance; a `<*x/>` shows the renders, which read what they read) keeps the field client-read for
    // every instance. s483 (lane s483-component-attr-server-only): and an ATTRIBUTE of a component, and a
    // cell a use site gives a value — judged with all of its values (bodyCands). One it makes server-only is
    // a SHELL field in every instance (seed `not`) and no binding anywhere: the server artifact holds no
    // instance, and nothing reads the field, so running its seed is unobservable (§6.15 A1: a seed is a
    // value position) — the same reason an unread derived program cell runs nowhere.
    // =========================================================================
    // One entry per declaration field that is a binding here (`isConstSym`): its declaration
    // (`decls`), its index there (`idxs`), its Sym (`ids`) and its write capability (`caps`, or -1).
    // `prog`: the program declaration's Sym id. No entry: the classification judges no body cell.
    type BodyCells:struct = { prog: int, decls: int[], idxs: int[], ids: int[], caps: int[] }

    fn bodyCellsOf(p: CoreProgram) -> BodyCells {
        const none: BodyCells = { prog: p.program.id, decls: [], idxs: [], ids: [], caps: [] };
        if (p.consts.length == 0) return none;
        let ds: int[] = [];
        let xs: int[] = [];
        let ids: int[] = [];
        let caps: int[] = [];
        for (const d of p.decls) {
            if (d.sym.id == p.program.id || d.kind == DeclKind.User) {
                let i: int = 0;
                for (const f of d.fields) {
                    if (isConstSym(p, f.sym.id)) {
                        ds = ds.concat([d.sym.id]);
                        xs = xs.concat([i]);
                        ids = ids.concat([f.sym.id]);
                        let cap: int = -1;
                        const w: Sym | not = f.wcap;
                        if (w is given) cap = w.id;
                        caps = caps.concat([cap]);
                    }
                    i = i + 1;
                }
            }
        }
        return { prog: p.program.id, decls: ds, idxs: xs, ids: ids, caps: caps };
    }

    fn bodyAny(bc: BodyCells) -> boolean {
        return bc.ids.length > 0;
    }

    // a field of the program declaration or of a component declaration (a candidate of bodyCands —
    // the program's, or a user declaration's)
    fn isBodyCell(p: CoreProgram, id: int) -> boolean {
        for (const d of p.decls) {
            if (d.sym.id == p.program.id || d.kind == DeclKind.User) {
                for (const f of d.fields) { if (f.sym.id == id) return true; }
            }
        }
        return false;
    }

    // One node's uses of the body cells that are bindings. FAIL CLOSED: every reference to such a
    // field other than a whole-value, statically checked Write is a READ — a place read (a whole
    // instance snapshot reads all of its declaration's), a part / compound / checked write, a
    // validity surface or its reset, a storage removal, an effect's, a request's or a reset rule's
    // dependency (a request's target too), an error list, a gate, a handle of an instance (a Lexical
    // handle names every body cell; an `as=` / narrowed handle every component cell — ⚑ INTERIM,
    // g-boot-component-handle-value-reads-all-s483: a handle used as a value is not followed to the
    // fields read through it). A `<*x/>` reads nothing by itself (bodyViewIds, S483).
    // s483 (lane s483-component-cell-server-only; #2121 review MED-1, prov=pa-ruled:S483-reset-is-write):
    // a RESET — `reset(@c)`, or a `reset-on=` rule's write — is a Write whose value is the field's
    // own initializer re-run (InitOf, lower.scrml resetStmt / resetWrite): a statically checked
    // whole-value write (a Replace, or the Static transition of a `rule=` cell), not a read. The
    // InitOf itself observes nothing of the field; what it runs is the seed, which a server-only
    // cell's shell does not hold (its reset writes `not`).
    fn bodyUseOf(bc: BodyCells, n: Node) -> ConstUse {
        return match n {
            .NPlace(pl: pl) :> readUse(bodyPlaceIds(bc, pl)),
            .NStmt(s: s) :> bodyStmtUse(bc, s),
            .NExpr(e: e) :> readUse(bodyExprIds(bc, e)),
            .NView(v: v) :> readUse(bodyViewIds(bc, v)),
            .NAttr(a: a) :> readUse(bodyAttrIds(bc, a)),
            // no-default-arm: one question of a node — does it reference a body cell
            _ :> readUse([])
        };
    }

    fn readUse(ids: int[]) -> ConstUse {
        return { reads: ids, writes: [] };
    }

    // s483 r2 (#2128 r1 re-review H2d) — bodyUseOf over the nodes `ns` (one walk, preorder), with an
    // INVARIANT GUARD read as the runtime reads it: an InvariantGuard over a declaration's instance
    // builds its candidate from the fields it writes and the fields its checks name (and the
    // dependencies of the derived fields they recompute) — runtime invariantGuard `need` — and reads
    // no other field, so it reads exactly those (invGuardReads), never every field its instance handle
    // names (a Lexical handle names every body cell). The guard's own handle — its first argument, the
    // next node in preorder — is judged with it. A guard whose declaration is not known here (a handle
    // through an alias, a Lexical handle of a guard that writes — fail closed) is judged by
    // bodyUseOf as before. `cur`: the declaration whose subtree the walk is in (its construction
    // check's Lexical(0) handle is that declaration's fresh instance).
    fn bodyUseAll(p: CoreProgram, bc: BodyCells, ns: Node[]) -> ConstUse {
        let reads: int[] = [];
        let writes: int[] = [];
        let cur: int = -1;
        let skip: boolean = false;
        for (const n of ns) {
            const dn: int = nodeDeclId(n);
            if (dn >= 0) cur = dn;
            const own: boolean = skip && invHandleNode(n);
            skip = false;
            if (!own) {
                let u: ConstUse = { reads: [], writes: [] };
                const g: int[] | not = invGuardReads(p, bc, n, cur);
                if (g is given) {
                    u = readUse(g);
                    skip = true;
                } else {
                    u = bodyUseOf(bc, n);
                }
                for (const r of u.reads) { if (!hasInt(reads, r)) reads = reads.concat([r]); }
                for (const w of u.writes) { if (!hasInt(writes, w)) writes = writes.concat([w]); }
            }
        }
        return { reads: reads, writes: writes };
    }

    fn nodeDeclId(n: Node) -> int {
        return match n {
            .NDecl(d: d) :> d.sym.id,
            // no-default-arm: one question of a node — is it a declaration
            _ :> -1
        };
    }

    fn invHandleNode(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> invHandleExpr(e),
            // no-default-arm: one question of a node — is it an instance handle
            _ :> false
        };
    }

    fn invHandleExpr(e: Expr) -> boolean {
        return match e {
            .Handle :> true,
            // no-default-arm: one question of an expression — is it an instance handle
            _ :> false
        };
    }

    // The body cells an InvariantGuard node reads (see bodyUseAll), or `not` when `n` is not one whose
    // declaration and fields are known here.
    fn invGuardReads(p: CoreProgram, bc: BodyCells, n: Node, cur: int) -> int[] | not {
        const e: Expr | not = nodeExprOf(n);
        if (e is not) return not;
        const g: InvGF | not = invGuardFields(p, e, cur);
        if (g is not) return not;
        let out: int[] = [];
        for (const ix of g.idxs) {
            for (const id of bodyAt(bc, g.decl, ix)) { if (!hasInt(out, id)) out = out.concat([id]); }
        }
        return out;
    }

    // An InvariantGuard's declaration (Sym id) and the indices of the fields it reads — those it
    // writes, and those its checks name (a check below a field: that field; else the names and the
    // derived fields' dependencies) — or `not` when `e` is not a guard whose declaration and fields
    // are all known here (fail closed).
    type InvGF:struct = { decl: int, idxs: int[] }

    fn invGuardFields(p: CoreProgram, e: Expr, cur: int) -> InvGF | not {
        const a: Expr[] | not = invGuardArgs(e);
        if (a is not || a.length != 4) return not;
        const ws: Expr[] = invElems(a[1]);
        const d: int = invGuardDecl(a[0], ws.length == 0, cur);
        if (d < 0) return not;
        let dd: Decl | not = not;
        for (const x of p.decls) { if (x.sym.id == d) dd = x; }
        if (dd is not) return not;
        let names: string[] = [];
        for (const f of dd.fields) { names = names.concat([f.sym.hint]); }
        let idxs: int[] = [];
        for (const w of ws) {
            const parts: Expr[] = invElems(w);
            if (parts.length == 0) return not;
            const i: int = invLitInt(parts[0]);
            const nm: string | not = invLitStr(parts[0]);
            if (i >= 0) idxs = idxs.concat([i]);
            else if (nm is given) idxs = idxs.concat([names.indexOf(nm)]);
            else return not;
        }
        for (const c of invElems(a[2])) {
            const parts: Expr[] = invElems(c);
            if (parts.length < 5) return not;
            const at: Expr[] = invElems(parts[0]);
            let want: Expr[] = [];
            if (at.length > 0) {
                want = [at[0]];
            } else {
                want = invElems(parts[2]);
                if (parts.length > 5) {
                    for (const dv of invElems(parts[5])) {
                        const dp: Expr[] = invElems(dv);
                        if (dp.length < 3) return not;
                        want = want.concat(invElems(dp[2]));
                    }
                }
            }
            for (const x of want) {
                const nm: string | not = invLitStr(x);
                if (nm is not) return not;
                idxs = idxs.concat([names.indexOf(nm)]);
            }
        }
        let out: int[] = [];
        for (const ix of idxs) {
            if (ix < 0) return not;
            if (!hasInt(out, ix)) out = out.concat([ix]);
        }
        return { decl: d, idxs: out };
    }

    // the declaration a guard's instance handle names: a shared instance or a child instance's
    // declaration, or — for a guard that writes nothing (a construction check) — the declaration the
    // walk is in, for its own fresh instance (Lexical(0)); else -1
    fn invGuardDecl(h: Expr, noWrites: boolean, cur: int) -> int {
        return match h {
            .Handle(inst: i) :> invInstDecl(i, noWrites, cur),
            // no-default-arm: one question of a guard's first argument — whose instance is it
            _ :> -1
        };
    }

    fn invInstDecl(i: InstRef, noWrites: boolean, cur: int) -> int {
        return match i {
            .Shared(decl: d) :> d.id,
            .Kid(decl: d) :> d.id,
            .Lexical(depth: k) :> (k == 0 && noWrites ? cur : -1),
            .Alias(sym: x) :> -1,
            .Narrowed(sym: x) :> -1,
            .HandleOf(sym: x) :> -1
        };
    }

    fn nodeExprOf(n: Node) -> Expr | not {
        return match n {
            .NExpr(e: e) :> e,
            // no-default-arm: one question of a node — is it an expression
            _ :> not
        };
    }

    fn invElems(e: Expr) -> Expr[] {
        return match e {
            .ArrayOf(elems: xs) :> xs,
            // no-default-arm: one question of an expression — is it a tape literal
            _ :> []
        };
    }

    fn invLitInt(e: Expr) -> int {
        return match e {
            .Lit(lit: l) :> invLitIntV(l),
            // no-default-arm: one question of an expression — is it an int literal
            _ :> -1
        };
    }

    fn invLitIntV(l: Literal) -> int {
        return match l {
            .Int(v: v) :> v,
            // no-default-arm: one question of a literal — is it an int
            _ :> -1
        };
    }

    fn invLitStr(e: Expr) -> string | not {
        return match e {
            .Lit(lit: l) :> invLitStrV(l),
            // no-default-arm: one question of an expression — is it a string literal
            _ :> not
        };
    }

    fn invLitStrV(l: Literal) -> string | not {
        return match l {
            .Str(v: v) :> v,
            // no-default-arm: one question of a literal — is it a string
            _ :> not
        };
    }

    // field `idx` of declaration `d`, when it is a binding here
    fn bodyAt(bc: BodyCells, d: int, idx: int) -> int[] {
        let j: int = 0;
        for (const x of bc.decls) {
            if (x == d && bc.idxs[j] == idx) return [bc.ids[j]];
            j = j + 1;
        }
        return [];
    }

    // every field of declaration `d` that is a binding here
    fn bodyOf(bc: BodyCells, d: int) -> int[] {
        let out: int[] = [];
        let j: int = 0;
        for (const x of bc.decls) {
            if (x == d) out = out.concat([bc.ids[j]]);
            j = j + 1;
        }
        return out;
    }

    // every component (non-program) field that is a binding here
    fn bodyComp(bc: BodyCells) -> int[] {
        let out: int[] = [];
        let j: int = 0;
        for (const x of bc.decls) {
            if (x != bc.prog) out = out.concat([bc.ids[j]]);
            j = j + 1;
        }
        return out;
    }

    fn bodyCellIds(bc: BodyCells, d: Sym, path: FieldRef[]) -> int[] {
        if (path.length == 0) return bodyOf(bc, d.id);
        return bodyAt(bc, d.id, path[0].idx);
    }

    fn bodyPlaceIds(bc: BodyCells, pl: Place) -> int[] {
        return match pl {
            .Cell(decl: d, path: ps) :> bodyCellIds(bc, d, ps),
            .LocalPath(sym: x) :> []
        };
    }

    fn bodyFieldIds(bc: BodyCells, d: Sym, idx: int) -> int[] {
        return bodyAt(bc, d.id, idx);
    }

    fn bodyStmtUse(bc: BodyCells, s: Stmt) -> ConstUse {
        return match s {
            .Write(cap: c, edit: e, value: v, check: k) :> bodyWriteUse(bc, c, e, v, k),
            // s483 (#2121 review MED-1, prov=pa-ruled:S483-reset-is-write): the surface and storage
            // halves of a reset (lower.scrml resetStmt — each follows the reset's Write of the same
            // field and writes no cell; core.scrml) observe nothing of its value: they are the reset,
            // which bodyWriteUse judges
            .ResetSurface(of: v) :> readUse([]),
            .Unpersist(decl: d, idx: i) :> readUse([]),
            // no-default-arm: one question of a statement — does it write or reset a body cell
            _ :> readUse([])
        };
    }

    fn bodyWriteUse(bc: BodyCells, cap: Sym, e: EditKind, v: Expr, c: Check) -> ConstUse {
        let i: int = 0;
        for (const w of bc.caps) {
            if (w == cap.id) {
                if (isStaticCheck(c) && (isReplaceEdit(e) || isInitOfExpr(v))) return { reads: [], writes: [bc.ids[i]] };
                return readUse([bc.ids[i]]);
            }
            i = i + 1;
        }
        return readUse([]);
    }

    fn isInitOfExpr(e: Expr) -> boolean {
        return match e {
            .InitOf(decl: x) :> true,
            // no-default-arm: one question of an expression — is it a reset's re-run initializer
            _ :> false
        };
    }

    fn bodyExprIds(bc: BodyCells, e: Expr) -> int[] {
        return match e {
            .Validity(of: v) :> bodyValidityIds(bc, v),
            .Handle(inst: i) :> bodyInstIds(bc, i),
            // InitOf (a reset's value) reads nothing of the field — bodyWriteUse judges the reset
            // no-default-arm: one question of an expression — does it read a body cell other than by a place
            _ :> []
        };
    }

    fn bodyInstIds(bc: BodyCells, i: InstRef) -> int[] {
        return match i {
            .Shared(decl: d) :> bodyOf(bc, d.id),
            .Lexical(depth: x) :> bc.ids,
            .Kid(decl: d) :> bodyOf(bc, d.id),
            .Alias(sym: x) :> bodyComp(bc),
            .Narrowed(sym: x) :> bodyComp(bc),
            .HandleOf(sym: x) :> bodyComp(bc)
        };
    }

    fn bodyValidityIds(bc: BodyCells, v: ValidityOf) -> int[] {
        return match v {
            .OfField(decl: d, idx: i) :> bodyFieldIds(bc, d, i),
            .OfDecl(decl: d) :> bodyOf(bc, d.id)
        };
    }

    fn bodyDepIds(bc: BodyCells, ds: EffectDep[]) -> int[] {
        let out: int[] = [];
        for (const d of ds) { out = unionInts(out, bodyFieldIds(bc, d.decl, d.idx)); }
        return out;
    }

    fn bodyValiditiesIds(bc: BodyCells, vs: ValidityOf[]) -> int[] {
        let out: int[] = [];
        for (const v of vs) { out = unionInts(out, bodyValidityIds(bc, v)); }
        return out;
    }

    fn bodyViewIds(bc: BodyCells, v: View) -> int[] {
        return match v {
            .Effect(deps: ds) :> bodyDepIds(bc, ds),
            .Request(target: t, deps: ds, state: st) :> bodyDepIds(bc, [t].concat(ds).concat(requestStateDeps(st))),
            .ResetOn(triggers: ds) :> bodyDepIds(bc, ds),
            .Errors(of: x) :> bodyValidityIds(bc, x),
            .Reach(fields: fs) :> bodyValiditiesIds(bc, fs),
            // s483 (lane s483-component-attr-server-only; #2125 review MED-1 (i)): a `<*x/>` renders x's
            // renders for an existing instance — it reads exactly the fields those renders read, and they
            // are client code already (every declaration is a client root), so the `<*x/>` itself reads
            // nothing (was: every field of x — no cell of a `single` declaration, which only a `<*x/>`
            // renders, could become a shell; d22 / d31)
            .Star(decl: d) :> [],
            // no-default-arm: one question of a view — does it name a body cell other than by a place
            _ :> []
        };
    }

    fn bodyAttrIds(bc: BodyCells, a: Attr) -> int[] {
        return match a {
            .Gate(fields: fs) :> bodyValiditiesIds(bc, fs),
            // no-default-arm: one question of an attribute — does a form gate name a body cell
            _ :> []
        };
    }

    // The cells of the program body the classification judges: each field of the program
    // declaration with a seed that may reach something (seedLive — a literal reaches nothing), except
    // the fields whose value the client holds by construction: a `<db>` cell (its load's answer,
    // §8.1.3), a `<channel>`'s synced cell (§38.4 — sent to other clients), a §25.7 CSS bridge's cell
    // (cssVarStmts reads it in the client), and an engine field with an `<onIdle>` watchdog (the
    // runtime reads it, §51.0.R).
    fn bodyCands(p: CoreProgram) -> int[] {
        const pd: Decl | not = programDeclOf(p);
        if (pd is not) return [];
        let skip: int[] = [];
        for (const ld of p.loads) { skip = skip.concat([ld.cell.id]); }
        for (const ch of p.channels) { for (const c of ch.cells) { skip = skip.concat([c.id]); } }
        const css: CoreCss | not = p.css;
        if (css is given) { for (const cv of css.vars) { skip = skip.concat([cv.cell.id]); } }
        let out: int[] = [];
        for (const f of pd.fields) {
            const init: Expr | not = f.init;
            if (init is given && !hasInt(skip, f.sym.id) && !idleWatched(f) && seedLive(init)) out = out.concat([f.sym.id]);
        }
        // s483 (lane s483-component-cell-server-only; ruling:user-voice-scrml.md-S483-component-cell-server-only):
        // and each field of a COMPONENT declaration — s483 (lane s483-component-attr-server-only;
        // ruling:user-voice-scrml.md-S483-component-attr-server-only — "an attribute no client code reads
        // gets an empty client stand-in; its default never runs and its use-site value is never evaluated
        // in the client"): an ATTRIBUTE as well as a cell of its body, and a field a use site gives a value
        // as well as one it does not (#2125 review MED-1 (ii): excluding the latter left every OTHER
        // instance running the secret seed, i05). Its values are its seed (an attribute's default) and
        // every use site's value for it (compUseVals); it is a candidate when one of them is live, with
        // the same exceptions.
        const uv: UseVal[] = compUseVals(p);
        for (const d of p.decls) {
            if (d.kind == DeclKind.User) {
                let i: int = 0;
                for (const cf of d.fields) {
                    let live: boolean = false;
                    for (const v of fieldVals(d, i, uv)) { if (seedLive(v)) live = true; }
                    if (live && !hasInt(skip, cf.sym.id) && !idleWatched(cf)) out = out.concat([cf.sym.id]);
                    i = i + 1;
                }
            }
        }
        return out;
    }

    // s483 (lane s483-component-attr-server-only) — one use site's value for field `field` of
    // declaration `decl` (a View.Instance's ConstructAttr), with the key fieldKey gives the field.
    type UseVal:struct = { key: string, value: Expr }

    // every use site's value, in every declaration's renders, at any depth (allNodes: an element's
    // children, an `if=` arm, an `<each>` row, a slot, a gather row)
    fn compUseVals(p: CoreProgram) -> UseVal[] {
        let out: UseVal[] = [];
        for (const n of allNodes(Node.NProgram(p))) {
            const g: GivenAt | not = givenAtOf(n);
            if (g is given) {
                for (const a of g.attrs) { out = out.concat([{ key: fieldKey(g.decl, a.field), value: a.value }]); }
            }
        }
        return out;
    }

    fn givenAtOf(n: Node) -> GivenAt | not {
        return match n {
            .NView(v: v) :> viewGivenAt(v),
            // no-default-arm: one question of a node — is it a use site
            _ :> not
        };
    }

    fn viewGivenAt(v: View) -> GivenAt | not {
        return match v {
            .Instance(decl: d, attrs: attrs) :> { decl: d, attrs: attrs },
            // no-default-arm: only a use site gives values
            _ :> not
        };
    }

    // field `i` of `d`'s values: its seed (a default), then each use site's value for it
    fn fieldVals(d: Decl, i: int, uv: UseVal[]) -> Expr[] {
        let out: Expr[] = [];
        const init: Expr | not = d.fields[i].init;
        if (init is given) out = [init];
        const key: string = fieldKey(d.sym, i);
        for (const u of uv) { if (u.key == key) out = out.concat([u.value]); }
        return out;
    }

    // the binding the classification judges for a component field: its one value, or all of them as
    // one tape — the reach of a tape is the union of its elements' (the binding is never printed:
    // bodyAsConsts `fin` gives a component field none)
    fn joinVals(vs: Expr[]) -> Expr {
        if (vs.length == 1) return vs[0];
        return Expr.ArrayOf(vs);
    }

    // `vs` with every use site's value for a field in `keys` dropped, at any depth (an element's
    // children, an `if=` arm, an `<each>` row, a slot, a gather row)
    fn dropGivenViews(vs: View[], keys: string[]) -> View[] {
        let out: View[] = [];
        for (const v of vs) { out = out.concat([dropGivenView(v, keys)]); }
        return out;
    }

    fn dropGivenView(v: View, keys: string[]) -> View {
        return match v {
            .El(tag: t, attrs: a, kids: ks) :> View.El(t, a, dropGivenViews(ks, keys)),
            .Cond(arms: arms) :> View.Cond(dropGivenArms(arms, keys)),
            .Each(src: s, bind: b, key: k, handles: hs, row: r) :> View.Each(s, b, k, hs, dropGivenViews(r, keys)),
            .Instance(decl: d, attrs: attrs, slot: sl, alias: al) :> View.Instance(d, dropGivenAttrs(d, attrs, keys), dropGivenViews(sl, keys), al),
            .Gather(g: g, rows: rows, key: k) :> View.Gather(g, dropGivenRows(rows, keys), k),
            .Text :> v,
            .RawText :> v,
            .Dyn :> v,
            .Slot :> v,
            .Star :> v,
            .Effect :> v,
            .Run :> v,
            .Init :> v,
            .Request :> v,
            .ResetOn :> v,
            .Errors :> v,
            .Reach :> v
        };
    }

    fn dropGivenArms(arms: CondArm[], keys: string[]) -> CondArm[] {
        let out: CondArm[] = [];
        for (const a of arms) { out = out.concat([{ test: a.test, body: dropGivenViews(a.body, keys) }]); }
        return out;
    }

    fn dropGivenRows(rows: GatherRow[], keys: string[]) -> GatherRow[] {
        let out: GatherRow[] = [];
        for (const r of rows) { out = out.concat([{ views: dropGivenViews(r.views, keys) }]); }
        return out;
    }

    fn dropGivenAttrs(d: Sym, attrs: ConstructAttr[], keys: string[]) -> ConstructAttr[] {
        let out: ConstructAttr[] = [];
        for (const a of attrs) { if (keys.indexOf(fieldKey(d, a.field)) < 0) out = out.concat([a]); }
        return out;
    }

    fn dropGivenDecl(d: Decl, keys: string[]) -> Decl {
        const rs: View[] | not = d.renders;
        if (rs is not || keys.length == 0) return d;
        return { sym: d.sym, key: d.key, kind: d.kind, single: d.single, fields: d.fields, renders: dropGivenViews(rs, keys), wiring: d.wiring, handles: d.handles, invs: d.invs };
    }

    fn idleWatched(f: Field) -> boolean {
        const g: TransitionGraph | not = f.graph;
        if (g is not) return false;
        return g.idle is given;
    }

    // A derived body cell (no write capability, not a constant — its formula reads a cell; §66.9
    // rule 3): judged on `orig`, the program before any field was made a shell.
    fn bodyDerived(orig: CoreProgram, f: Field) -> boolean {
        return f.wcap is not && f.persist is not && !constSeedField(orig, f);
    }

    // `p` with each body cell of `cells` (field Sym ids) a SHELL field — its seed `not` — and a binding
    // of the field's Sym whose initializer is the cell's seed among the constants, at the cell's place:
    // after the body binding placed before it (the program's View.Init order), else before the first
    // one placed after it, else last. `fin`: the program both printers print — a DERIVED cell
    // (bodyDerived, judged on `orig`) gets no binding there (nothing runs an unread formula); in the
    // classification (`fin` false) it is one, so what its formula reaches is judged. Each cell
    // declared outside the body keeps its place (OuterCell.at moves past the bindings put before it).
    fn bodyAsConsts(p: CoreProgram, orig: CoreProgram, cells: int[], fin: boolean) -> CoreProgram {
        const pd: Decl | not = programDeclOf(p);
        if (pd is not || cells.length == 0) return p;
        let fs: Field[] = [];
        let adds: CoreConst[] = [];
        for (const f of pd.fields) {
            const init: Expr | not = f.init;
            if (hasInt(cells, f.sym.id) && init is given) {
                fs = fs.concat([shellField(f)]);
                if (!fin || !bodyDerived(orig, f)) adds = adds.concat([{ sym: f.sym, init: init, mutable: f.wcap is given }]);
            } else {
                fs = fs.concat([f]);
            }
        }
        let marks: int[] = [];
        const rs: View[] | not = pd.renders;
        if (rs is given) marks = initsIn(rs);
        // the added bindings in place order (a cell with no place goes last)
        let order: CoreConst[] = [];
        for (const m of marks) { for (const a of adds) { if (a.sym.id == m) order = order.concat([a]); } }
        for (const a2 of adds) { if (!hasInt(marks, a2.sym.id)) order = order.concat([a2]); }
        let ks: CoreConst[] = [];
        let done: int[] = [];
        let newAt: int[] = [];
        for (const k of p.consts) {
            const mk: int = marks.indexOf(k.sym.id);
            if (mk >= 0) {
                for (const c of order) {
                    if (!hasInt(done, c.sym.id) && marks.indexOf(c.sym.id) >= 0 && marks.indexOf(c.sym.id) < mk) {
                        ks = ks.concat([c]);
                        done = done.concat([c.sym.id]);
                    }
                }
            }
            newAt = newAt.concat([ks.length]);
            ks = ks.concat([k]);
        }
        for (const c2 of order) { if (!hasInt(done, c2.sym.id)) ks = ks.concat([c2]); }
        let os: OuterCell[] = [];
        for (const o of p.outer) {
            let at: int = ks.length;
            if (o.at < newAt.length) at = newAt[o.at];
            os = os.concat([{ decl: o.decl, at: at }]);
        }
        // s483 (lane s483-component-cell-server-only; ruling:user-voice-scrml.md-S483-component-cell-server-only
        // — "becomes an empty client stand-in and nothing runs its seed"): a COMPONENT cell of `cells` is a
        // shell field in its declaration — every instance's — and a binding only in the classification
        // (`fin` false: what its seed reaches is judged), put last (it has no place; a seed names only
        // file-scope bindings, which precede it). In the program both printers print it has none.
        // s483 (lane s483-component-attr-server-only; ruling:user-voice-scrml.md-S483-component-attr-server-only
        // — "its default never runs and its use-site value is never evaluated in the client"): so is an
        // ATTRIBUTE of `cells`, and a cell a use site gives a value. The binding's initializer stands for
        // all of the field's values — its seed and every use site's (fieldVals, joinVals) — so what any of
        // them reaches is judged, and a read of the field reads all of them. Every use site's value for
        // such a field is dropped from the renders (dropGivenDecl), in the classification too: there it
        // is the binding's initializer, not client code. In the program both printers print, the use site
        // passes nothing, so the instance holds the shell.
        const uv: UseVal[] = compUseVals(p);
        let dropKeys: string[] = [];
        for (const d0 of p.decls) {
            if (d0.kind == DeclKind.User) {
                let j: int = 0;
                for (const f0 of d0.fields) {
                    if (hasInt(cells, f0.sym.id)) dropKeys = dropKeys.concat([fieldKey(d0.sym, j)]);
                    j = j + 1;
                }
            }
        }
        let ds: Decl[] = [];
        for (const d of p.decls) {
            if (d.sym.id == pd.sym.id) {
                ds = ds.concat([dropGivenDecl({ sym: d.sym, key: d.key, kind: d.kind, single: d.single, fields: fs, renders: d.renders, wiring: d.wiring, handles: d.handles, invs: d.invs }, dropKeys)]);
            } else if (d.kind == DeclKind.User) {
                let cfs: Field[] = [];
                let ci: int = 0;
                for (const cf of d.fields) {
                    if (hasInt(cells, cf.sym.id)) {
                        cfs = cfs.concat([shellField(cf)]);
                        const vs: Expr[] = fieldVals(d, ci, uv);
                        if (!fin && vs.length > 0) ks = ks.concat([{ sym: cf.sym, init: joinVals(vs), mutable: cf.wcap is given }]);
                    } else {
                        cfs = cfs.concat([cf]);
                    }
                    ci = ci + 1;
                }
                ds = ds.concat([dropGivenDecl({ sym: d.sym, key: d.key, kind: d.kind, single: d.single, fields: cfs, renders: d.renders, wiring: d.wiring, handles: d.handles, invs: d.invs }, dropKeys)]);
            } else {
                ds = ds.concat([dropGivenDecl(d, dropKeys)]);
            }
        }
        return { program: p.program, decls: ds, types: p.types, fns: p.fns, server: p.server, dbs: p.dbs, reset: p.reset, sqlError: p.sqlError,
                 serverCallError: p.serverCallError, css: p.css, consts: ks, loads: p.loads, envelopes: p.envelopes, head: p.head,
                 tool: p.tool, endpoints: p.endpoints, channels: p.channels, typed: p.typed, outer: os };
    }

    fn shellField(f: Field) -> Field {
        return { sym: f.sym, ty: f.ty, init: Expr.Lit(Literal.Absent), mode: f.mode, role: f.role, grants: f.grants, graph: f.graph,
                 exported: f.exported, wcap: f.wcap, vals: f.vals, persist: f.persist, timing: f.timing };
    }

    fn withDeclsFns(p: CoreProgram, ds: Decl[], fs: Fn[], lds: DbLoad[]) -> CoreProgram {
        return { program: p.program, decls: ds, types: p.types, fns: fs, server: p.server, dbs: p.dbs, reset: p.reset, sqlError: p.sqlError,
                 serverCallError: p.serverCallError, css: p.css, consts: p.consts, loads: lds, envelopes: p.envelopes, head: p.head,
                 tool: p.tool, endpoints: p.endpoints, channels: p.channels, typed: p.typed, outer: p.outer };
    }

    // The declarations live code can construct, a fixed point from the program and every
    // non-user declaration: a component is constructed only by a mount (View.Instance /
    // View.Star — instancedIn) or a reference to its shared instance (InstRef.Shared, through a
    // Kid / HandleOf too — sharedRefs; every cell read, write, init, validity, effect and gate
    // dependency names its instance by an InstRef child), and §41.9 "Dynamic component references
    // … are not possible in scrml's markup syntax", so the reference set is complete. Read
    // FAIL-CLOSED: the code scanned is every live declaration, every function the client can run
    // counting EVERY acting initializer as a root (clientLiveFns with no server-only set), every
    // function server code reaches, every server function, and every file-scope initializer;
    // and a component holding a `<db>` cell some load fills is kept.
    fn liveDecls(p: CoreProgram, keep: int[]) -> int[] {
        let live: int[] = [p.program.id];
        // s482 (lane s482-seed-timing, Q12): a cell declared outside the body with a live seed runs
        // before the body even when nothing reads it
        for (const oc of outerLive(p)) { if (!hasInt(live, oc.decl.id)) live = live.concat([oc.decl.id]); }
        for (const d of p.decls) {
            if (d.kind != DeclKind.User && !hasInt(live, d.sym.id)) live = live.concat([d.sym.id]);
        }
        let cells: int[] = [];
        for (const ld of p.loads) { cells = cells.concat([ld.cell.id]); }
        for (const d1 of p.decls) {
            for (const fl of d1.fields) {
                if (hasInt(cells, fl.sym.id) && !hasInt(live, d1.sym.id)) live = live.concat([d1.sym.id]);
            }
        }
        if (live.length == p.decls.length) return live;
        let sroots: Node[] = [];
        for (const sf of p.server) { sroots = sroots.concat([Node.NServerFn(sf)]); }
        let fixed: Node[] = sroots;
        for (const k of p.consts) { fixed = fixed.concat([Node.NExpr(k.init)]); }
        const css: CoreCss | not = p.css;
        if (css is given) { for (const cv of css.vars) { fixed = fixed.concat([Node.NExpr(cv.read)]); } }
        let changed = true;
        for (; changed; ) {
            changed = false;
            let ds: Decl[] = [];
            for (const d2 of p.decls) { if (hasInt(live, d2.sym.id)) ds = ds.concat([d2]); }
            const pl: CoreProgram = withDeclsFns(p, ds, p.fns, p.loads);
            const fns: int[] = clientLiveFns(pl, keep, []).concat(serverOnlyFns(pl)).concat(fnClosureThroughConsts(pl, sroots));
            let roots: Node[] = fixed;
            for (const d3 of ds) { roots = roots.concat([Node.NDecl(d3)]); }
            for (const f of p.fns) { if (hasInt(fns, f.sym.id)) roots = roots.concat([Node.NFn(f)]); }
            let named: int[] = [];
            for (const r of roots) {
                named = unionInts(named, instancedIn(r));
                for (const s of sharedRefs(r)) { if (!hasInt(named, s.id)) named = named.concat([s.id]); }
            }
            for (const d4 of p.decls) {
                if (hasInt(named, d4.sym.id) && !hasInt(live, d4.sym.id)) {
                    live = live.concat([d4.sym.id]);
                    changed = true;
                }
            }
        }
        return live;
    }

    // A function whose body keeps only the nested functions it reaches (prunedBody).
    fn prunedFn(f: Fn) -> Fn {
        return { sym: f.sym, params: f.params, body: prunedBody(f.body), pure: f.pure, err: f.err, waits: f.waits, host: f.host };
    }

    // A function body without the nested function declarations (Stmt.LocalFn, which stand only at
    // the top level of a function body — core.scrml) it never reaches: one is reached when a
    // statement of the body names it (a call, a value, a read — namedIn, at any depth), or a
    // reached nested function does (its own body pruned first, so a nested function only a dead
    // one names is dead too). The same rule as analyze.scrml's `usesR` (#2053): a nested function
    // declaration a function never calls nor uses as a value adds nothing. FAIL CLOSED: a
    // declaration anywhere else (not at the top of the body) is left in its statement, and that
    // statement's names count.
    fn prunedBody(b: Block) -> Block {
        let named: int[] = [];
        let locals: Fn[] = [];
        for (const st of b.stmts) {
            const lf: Fn | not = stmtLocalFn(st);
            if (lf is given) {
                locals = locals.concat([prunedFn(lf)]);
            } else {
                named = namedIn(Node.NStmt(st), named);
            }
        }
        if (locals.length == 0) return b;
        let reached: int[] = [];
        let more = true;
        for (; more; ) {
            more = false;
            for (const l of locals) {
                if (hasInt(named, l.sym.id) && !hasInt(reached, l.sym.id)) {
                    reached = reached.concat([l.sym.id]);
                    named = namedIn(Node.NFn(l), named);
                    more = true;
                }
            }
        }
        let out: Stmt[] = [];
        for (const st2 of b.stmts) {
            const lf2: Fn | not = stmtLocalFn(st2);
            if (lf2 is given) {
                if (hasInt(reached, lf2.sym.id)) {
                    for (const l2 of locals) { if (l2.sym.id == lf2.sym.id) out = out.concat([Stmt.LocalFn(l2)]); }
                }
            } else {
                out = out.concat([st2]);
            }
        }
        return { stmts: out };
    }

    // Every Sym a node tree names as a callee (a Call, an Attempt's FCall), a function value
    // (FnRef) or a local read (Local, a LocalPath place).
    fn namedIn(root: Node, acc: int[]) -> int[] {
        let out: int[] = acc;
        for (const n of allNodes(root)) {
            const c: Sym | not = nodePlainCallee(n);
            if (c is given) {
                if (!hasInt(out, c.id)) out = out.concat([c.id]);
            } else {
                const id: int = localReadOf(n);
                if (id >= 0 && !hasInt(out, id)) out = out.concat([id]);
            }
        }
        return out;
    }

    fn stmtLocalFn(s: Stmt) -> Fn | not {
        return match s {
            .LocalFn(f: f) :> f,
            .Let(sym: x) :> not,
            .Assign(local: x) :> not,
            .Write(cap: x) :> not,
            .Commit(writes: x) :> not,
            .If(cond: x) :> not,
            .Return(e: x) :> not,
            .Eval(e: x) :> not,
            .Suspend(bind: x) :> not,
            .ResetSurface(of: x) :> not,
            .Defer(body: x) :> not,
            .Unpersist(decl: x) :> not,
            .Attempt(result: x) :> not,
            .Fail(err: x) :> not,
            .Join(k: x) :> not,
            .Jump(k: x) :> not,
            .Loop(label: x) :> not,
            .Break(target: x) :> not,
            .Continue(target: x) :> not,
            .Gather(g: x) :> not,
            .Lift(into: x) :> not
        };
    }

    // The Fns (not ServerFns) a node tree calls.
    fn fnCalleesIn(p: CoreProgram, root: Node) -> int[] {
        let out: int[] = [];
        for (const n of allNodes(root)) {
            const c: Sym | not = nodePlainCallee(n);
            if (c is given) {
                if (findFn(p, c) is given && !hasInt(out, c.id)) out = out.concat([c.id]);
            }
        }
        return out;
    }

    // `start` and every Fn they reach by a call, transitively.
    fn fnClosure(p: CoreProgram, start: int[]) -> int[] {
        let out: int[] = [];
        let todo: int[] = start;
        for (; todo.length > 0; ) {
            const id: int = todo[0];
            todo = todo.slice(1);
            if (!hasInt(out, id)) {
                out = out.concat([id]);
                for (const f of p.fns) {
                    if (f.sym.id == id) todo = todo.concat(fnCalleesIn(p, Node.NFn(f)));
                }
            }
        }
        return out;
    }

    // The Fns that call a server function IN PLACE — a plain Call of a ServerFn,
    // directly or through a Fn that does (a fixed point). check.scrml C-S3
    // guarantees no client root reaches one, so they are server code.
    fn serverOnlyFns(p: CoreProgram) -> int[] {
        let out: int[] = [];
        let changed = true;
        for (; changed; ) {
            changed = false;
            for (const f of p.fns) {
                if (!hasInt(out, f.sym.id)) {
                    let hit = false;
                    for (const n of allNodes(Node.NFn(f))) {
                        const c: Sym | not = nodePlainCallee(n);
                        if (c is given) {
                            if (findServerFn(p, c) is given || hasInt(out, c.id)) hit = true;
                        }
                    }
                    if (hit) {
                        out = out.concat([f.sym.id]);
                        changed = true;
                    }
                }
            }
        }
        return out;
    }

    // The callee of a plain Call node (an Expr.Call, or an Attempt's FCall), else not.
    fn nodePlainCallee(n: Node) -> Sym | not {
        return match n {
            .NExpr(e: e) :> exprPlainCallee(e),
            .NStmt(s: s) :> stmtFCallee(s),
            .NProgram(p: x) :> not,
            .NDecl(d: x) :> not,
            .NField(f: x) :> not,
            .NFn(f: x) :> not,
            .NServerFn(f: x) :> not,
            .NBlock(b: x) :> not,
            .NPlace(pl: x) :> not,
            .NInst(i: x) :> not,
            .NPattern(pat: x) :> not,
            .NEdit(k: x) :> not,
            .NView(v: x) :> not,
            .NAttr(a: x) :> not
        };
    }

    fn exprPlainCallee(e: Expr) -> Sym | not {
        return match e {
            .Call(callee: f) :> f,
            .FnRef(fn: f) :> f,      // s478: a function named as a value is reached as if called (its artifact must hold it)
            .CallV(f: x) :> not,
            .ServerCall(fn: x) :> not,
            .Query(q: x) :> not,
            .Foreign(slice: fsl0) :> not,
            .Lit(lit: x) :> not,
            .Local(sym: x) :> not,
            .Read(place: x) :> not,
            .Prim(op: x) :> not,
            .Match(scrut: x) :> not,
            .ArrayOf(elems: x) :> not,
            .StructOf(ty: x) :> not,
            .VariantOf(enumSym: x) :> not,
            .Handle(inst: x) :> not,
            .Assigned(local: x) :> not,
            .InitOf(decl: x) :> not,
            .Host(call: x) :> not,
            .Lambda(params: x) :> not,
            .BlockLambda(params: x) :> not,
            .SeqCall(op: x) :> not,
            .Refetch(req: rf0) :> not,
            .Validity(of: x) :> not
        };
    }

    fn stmtFCallee(s: Stmt) -> Sym | not {
        return match s {
            .Attempt(call: c) :> failableCallee(c),
            .Let(sym: x) :> not,
            .Assign(local: x) :> not,
            .Write(cap: x) :> not,
            .Commit(writes: x) :> not,
            .If(cond: x) :> not,
            .Return(e: x) :> not,
            .Eval(e: x) :> not,
            .Suspend(bind: x) :> not,
            .ResetSurface(of: x) :> not,
            .Defer(body: x) :> not,
            .Unpersist(decl: x) :> not,
            .Fail(err: x) :> not,
            .Join(k: x) :> not,
            .Jump(k: x) :> not,
            .Loop(label: x) :> not,
            .Break(target: x) :> not,
            .Continue(target: x) :> not,
            .Gather(g: x) :> not,
            .Lift(into: x) :> not,
            .LocalFn(f: x) :> not
        };
    }

    fn failableCallee(c: Failable) -> Sym | not {
        return match c {
            .FCall(fn: f) :> f,
            .FSettled(outcome: x) :> not,
            .FParse(json: x) :> not,
            .FCallV(f: x) :> not
        };
    }

    // =========================================================================
    // s483 r2 (#2128 r1 re-review H2a–H2d; ruling:user-voice-scrml.md-S483-invariant-const-read — "a
    // server-only const stays refused"; prov=pa-ruled:S483-invariant-attr-server-only) — THE INVARIANT
    // LEAK CHECK. An invariant is checked wherever its value is written, the client included, so its
    // predicates are client code: what they reach is read by the client. §7.6 (b) keeps a binding only
    // server code reads — and an unread one whose initializer reaches server-only code — out of the
    // client artifact; an invariant must never move such a binding into it. Several analyze-side
    // approximations of that reach each missed a root (a constant's initializer, a server-only
    // initializer, a derived field's formula, a component attribute's value), so the judgement is the
    // printer's OWN classification, run twice: once on the program with every invariant check left out
    // (invStripProgram — the checks' predicates gone, every write and value kept), once on the program
    // as printed. A binding, a function or a component / body field that is server-only in the first
    // run and client-held in the second is refused by name (E-DECL-INVARIANT-IMPURE) — there is no
    // second classifier that can disagree with the printer: both runs ARE the printer's (clientPlanOf —
    // the steps printProgramExposing takes). A binding the client holds anyway (it reads it itself) is
    // in both runs, so it is admitted — the capable form of g-boot-invariant-const-client-read-s483.
    // A program with no invariant check is not judged (nothing differs).
    // =========================================================================

    // The client half's classification of a shaken, placed program `ps` — what printProgramExposing
    // prints from: the server-only initializers (`si`), the body places (`plan`), the server-only
    // functions, the functions the client can run, the client roots and the client's bindings.
    type ClientPlan:struct = { si: int[], plan: InitPlan, serverOnly: int[], liveFns: int[], roots: Node[], consts: CoreConst[] }

    fn clientPlanOf(ps: CoreProgram, keep: int[]) -> ClientPlan {
        const si: int[] = serverInitsExposing(ps, keep);
        const plan: InitPlan = bodyInits(ps, si, keep);
        const p: CoreProgram = plan.p;
        const serverOnly0: int[] = serverOnlyFns(p).concat(reachedOnlyByServer(p));
        let clientRoots: Node[] = [];
        for (const d0 of p.decls) { clientRoots = clientRoots.concat([Node.NDecl(d0)]); }
        // s482 (g-boot-dead-client-fn-ships-server-const-s481): the functions the client can run
        // (clientLiveFns) — an unreached one is not printed, so nothing it reads is held here
        const liveFns: int[] = clientLiveFns(p, keep, si);
        for (const f0 of p.fns) { if (!hasInt(serverOnly0, f0.sym.id) && hasInt(liveFns, f0.sym.id)) clientRoots = clientRoots.concat([Node.NFn(f0)]); }
        const cconsts: CoreConst[] = clientConsts(p, clientRoots, serverOnly0, si);
        return { si: si, plan: plan, serverOnly: serverOnly0, liveFns: liveFns, roots: clientRoots, consts: cconsts };
    }

    // One run of the classification: what the client holds — the bindings it holds WITH their
    // initializer (`consts`; a shell, clientConsts' `not` stand-in, holds nothing), the functions it
    // prints (`fns`) — and what is server-only: the functions (`serverFns`) and the cells / fields
    // outerPlaced makes server-only (`moved`), and the bindings server code reads or that are server-only
    // (`srv`). `p`: the program the client is printed from.
    type ClientView:struct = { consts: int[], fns: int[], serverFns: int[], moved: int[], srv: int[], p: CoreProgram }

    fn clientViewOf(p1: CoreProgram, keep: int[]) -> ClientView {
        const q: CoreProgram = shakeDecls(p1, keep);
        const mv: int[] = outerMoves(q, keep);
        const ps: CoreProgram = outerPlacedBy(q, mv);
        const cp: ClientPlan = clientPlanOf(ps, keep);
        const p: CoreProgram = cp.plan.p;
        let ks: int[] = [];
        for (const k of cp.consts) {
            const k0: CoreConst | not = findConst(p, k.sym.id);
            let shell: boolean = false;
            if (k0 is given) shell = invAbsent(k.init) && !invAbsent(k0.init);
            if (!shell) ks = ks.concat([k.sym.id]);
        }
        let fs: int[] = [];
        for (const f of p.fns) { if (!hasInt(cp.serverOnly, f.sym.id) && hasInt(cp.liveFns, f.sym.id)) fs = fs.concat([f.sym.id]); }
        // the bindings server code reads, and the server-only ones (§7.6 (b) — what keeps a binding out of the client)
        const srv: int[] = unionInts(constsReached(p, serverRoots(p, cp.serverOnly, cp.si)), cp.si);
        return { consts: ks, fns: fs, serverFns: cp.serverOnly, moved: mv, srv: srv, p: p };
    }

    fn invAbsent(e: Expr) -> boolean {
        return match e {
            .Lit(lit: l) :> invAbsentLit(l),
            // no-default-arm: one question of an expression — is it the absence literal
            _ :> false
        };
    }

    fn invAbsentLit(l: Literal) -> boolean {
        return match l {
            .Absent :> true,
            // no-default-arm: one question of a literal — is it `not`
            _ :> false
        };
    }

    // The refusals: what is server-only without the invariant checks (`b`, invStripProgram) and
    // client-held with them (`a`) — a binding server code reads or that is server-only, a function only
    // server code reaches, a cell / field outerPlaced makes server-only — one refusal per invariant that
    // reaches any of it, naming each with the chain it is reached by (invLeakChains). A binding reached
    // only through such a field's value is named with that field.
    fn invLeakRefusal(p1: CoreProgram, keep: int[]) -> string[] {
        if (p1.tool is given || p1.program.id < 0 || !hasInvariantChecks(p1)) return [];
        const a: ClientView = clientViewOf(p1, keep);
        const b: ClientView = clientViewOf(invStripProgram(p1), keep);
        let tk: int[] = [];
        for (const k of a.consts) { if (!hasInt(b.consts, k) && hasInt(b.srv, k)) tk = tk.concat([k]); }
        let tf: int[] = [];
        for (const f of a.fns) { if (!hasInt(b.fns, f) && hasInt(b.serverFns, f)) tf = tf.concat([f]); }
        let tm: int[] = [];
        for (const m of b.moved) { if (!hasInt(a.moved, m)) tm = tm.concat([m]); }
        if (tk.length == 0 && tf.length == 0 && tm.length == 0) return [];
        const ch: InvChains = invLeakChains(a.p, tk.concat(tf), tm);
        // one refusal per invariant, in the order the walk met them
        let labels: string[] = [];
        for (const l of ch.flabels.concat(ch.labels)) { if (labels.indexOf(l) < 0) labels = labels.concat([l]); }
        let out: string[] = [];
        for (const lbl of labels) {
            let parts: string[] = [];
            let anyField: boolean = false;
            let j: int = 0;
            for (const fid of ch.fids) {
                if (ch.flabels[j] == lbl) {
                    anyField = true;
                    let secrets: string[] = [];
                    let jj: int = 0;
                    for (const t of ch.ids) {
                        if (hasInt(ch.via[jj], fid)) secrets = secrets.concat(["`" + invSymHint(a.p, t) + "`"]);
                        jj = jj + 1;
                    }
                    let tail: string = "";
                    if (secrets.length > 0) tail = " — " + secrets.join(", ");
                    parts = parts.concat([invFieldName(p1, fid) + " (no client code reads it, and its value reaches server-only code" + tail + ", so the client holds an empty stand-in and never evaluates that value)"]);
                }
                j = j + 1;
            }
            let i: int = 0;
            for (const t2 of ch.ids) {
                if (ch.labels[i] == lbl && ch.via[i].length == 0) {
                    const nm: string = invSymHint(a.p, t2);
                    let thru: string = "";
                    if (ch.paths[i] != "") thru = " through " + ch.paths[i];
                    if (hasInt(tf, t2)) parts = parts.concat(["`" + nm + "()`" + thru + " (only server code reaches it — §12.2 Trigger 5)"]);
                    else parts = parts.concat(["`" + nm + "`" + thru + " (only server code reads it, or no code reads it and its initializer reaches server-only code)"]);
                }
                i = i + 1;
            }
            let rule: string = "ruling:user-voice-scrml.md-S483-invariant-const-read: \"a server-only const stays refused\" — the set refused through a call, a constant or a derived field is the set refused directly";
            let fix: string = "Read a constant the client already holds, or compute the bound in a `fn` from the fields";
            if (anyField) {
                rule = rule + "; prov=pa-ruled:S483-invariant-attr-server-only with ruling:user-voice-scrml.md-S483-component-attr-server-only";
                fix = "Keep the secret off the field: give it a value the client may hold (e.g. a server-computed non-secret value), or leave the field out of the invariant";
            }
            if (parts.length > 0) {
                out = out.concat(["E-DECL-INVARIANT-IMPURE: " + lbl + " reaches what §7.6 (b) keeps out of the client artifact: " + parts.join("; ") + ". An invariant is checked wherever the value is written, the client included, so what it reaches is client code, and checking it there would print each of these into the client (" + rule + "). " + fix]);
            }
        }
        // (a difference no chain was found for — not expected: every difference is the checks' reach)
        for (const t3 of tk.concat(tf)) {
            if (!hasInt(ch.ids, t3)) out = out.concat(["E-DECL-INVARIANT-IMPURE: an invariant check puts `" + invSymHint(a.p, t3) + "`, which is server-only without it (§7.6 (b)), in the client artifact (ruling:user-voice-scrml.md-S483-invariant-const-read: \"a server-only const stays refused\"). Read a constant the client already holds, or compute the bound in a `fn` from the fields"]);
        }
        for (const t4 of tm) {
            if (!hasInt(ch.fids, t4)) out = out.concat(["E-DECL-INVARIANT-IMPURE: an invariant check reads " + invFieldName(p1, t4) + ", which is server-only without it (§7.6 (b); ruling:user-voice-scrml.md-S483-component-attr-server-only), so it would print the field's value into the client. Keep the secret off the field: give it a value the client may hold (e.g. a server-computed non-secret value), or leave the field out of the invariant"]);
        }
        return out;
    }

    fn invSymHint(p: CoreProgram, id: int) -> string {
        for (const k of p.consts) { if (k.sym.id == id) return k.sym.hint; }
        for (const f of p.fns) { if (f.sym.id == id) return f.sym.hint; }
        for (const d of p.decls) { if (d.sym.id == id) return d.sym.hint; }
        return "#" + id;
    }

    // "the attribute `t` of `<card>`" / "the cell `@c`" / "the cell `c` of `<card>`"
    fn invFieldName(p: CoreProgram, id: int) -> string {
        for (const d of p.decls) {
            for (const f of d.fields) {
                if (f.sym.id == id) {
                    if (d.sym.id == p.program.id) return "the cell `@" + f.sym.hint + "`";
                    if (invIsAttr(f.role)) return "the attribute `" + f.sym.hint + "` of `<" + d.sym.hint + ">`";
                    return "the cell `" + f.sym.hint + "` of `<" + d.sym.hint + ">`";
                }
            }
            if (d.sym.id == id) return "the cell `@" + d.sym.hint + "`";
        }
        return "the field #" + id;
    }

    fn invIsAttr(r: FieldRole) -> boolean {
        return match r {
            .Attribute :> true,
            .Child :> false
        };
    }

    // The chains an invariant check reaches each target by — a breadth-first walk from every check
    // (an InvariantGuard's / InvariantValue's checks, a persisted cell's restore checks) through the
    // bindings it reads (into their initializers), the functions it calls (into their bodies), and —
    // for a guard over a known declaration — the fields its checks name (into their values: the seed
    // and every use site's value). `ids` / `labels` / `paths` / `via`: each binding or function target
    // found, the invariant that reaches it, the chain after the invariant (`` `L` → `K` ``), and the
    // field targets the chain passes through; `fids` / `flabels`: each field target found and the
    // invariant that reads it.
    type InvChains:struct = { ids: int[], labels: string[], paths: string[], via: int[][], fids: int[], flabels: string[] }

    fn invLeakChains(p: CoreProgram, targets: int[], fields: int[]) -> InvChains {
        let qn: Node[] = [];
        let ql: string[] = [];
        let qc: string[] = [];
        let qv: int[][] = [];
        const noVia: int[] = [];
        const uv: UseVal[] = compUseVals(p);
        let fids: int[] = [];
        let flabels: string[] = [];
        let cur: int = -1;
        for (const n of allNodes(Node.NProgram(p))) {
            const dn: int = nodeDeclId(n);
            if (dn >= 0) cur = dn;
            const e: Expr | not = nodeExprOf(n);
            if (e is given) {
                const pa: InvPrimAt | not = invPrimAt(e);
                if (pa is given) {
                    for (const c of invElems(pa.checks)) {
                        const lbl: string = invCheckLabel(c, pa.loc);
                        qn = qn.concat([Node.NExpr(c)]);
                        ql = ql.concat([lbl]);
                        qc = qc.concat([""]);
                        qv = qv.concat([noVia]);
                        const gf: InvGF | not = invGuardFields(p, e, cur);
                        if (gf is given) {
                            for (const d of p.decls) {
                                if (d.sym.id == gf.decl) {
                                    for (const ix of invCheckFieldIdxs(d, c)) {
                                        const f: Field = d.fields[ix];
                                        if (hasInt(fields, f.sym.id) && !hasInt(fids, f.sym.id)) {
                                            fids = fids.concat([f.sym.id]);
                                            flabels = flabels.concat([lbl]);
                                        }
                                        for (const v of fieldVals(d, ix, uv)) {
                                            qn = qn.concat([Node.NExpr(v)]);
                                            ql = ql.concat([lbl]);
                                            qc = qc.concat(["`" + f.sym.hint + "` (its value)"]);
                                            qv = qv.concat([[f.sym.id]]);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        for (const d2 of p.decls) {
            for (const f2 of d2.fields) {
                const ps: Persist | not = f2.persist;
                if (ps is given) {
                    const iv: Expr | not = ps.invs;
                    if (iv is given) {
                        for (const c2 of invElems(iv)) {
                            qn = qn.concat([Node.NExpr(c2)]);
                            ql = ql.concat([invCheckLabel(c2, ps.loc) + " (the restore check of `@" + f2.sym.hint + "`)"]);
                            qc = qc.concat([""]);
                            qv = qv.concat([noVia]);
                        }
                    }
                }
            }
        }
        let ids: int[] = [];
        let labels: string[] = [];
        let paths: string[] = [];
        let via: int[][] = [];
        let seen: int[] = [];
        let i: int = 0;
        for (; i < qn.length; ) {
            const n2: Node = qn[i];
            for (const k of constReads(p, n2, [])) {
                if (!hasInt(seen, k)) {
                    seen = seen.concat([k]);
                    const kc: CoreConst | not = findConst(p, k);
                    const c3: string = invStep(qc[i], "`" + invSymHint(p, k) + "`");
                    if (hasInt(targets, k)) {
                        ids = ids.concat([k]);
                        labels = labels.concat([ql[i]]);
                        paths = paths.concat([c3]);
                        via = via.concat([qv[i]]);
                    }
                    if (kc is given) {
                        qn = qn.concat([Node.NExpr(kc.init)]);
                        ql = ql.concat([ql[i]]);
                        qc = qc.concat([c3]);
                        qv = qv.concat([qv[i]]);
                    }
                }
            }
            for (const fid of fnCalleesIn(p, n2)) {
                if (!hasInt(seen, fid)) {
                    seen = seen.concat([fid]);
                    const c4: string = invStep(qc[i], "`" + invSymHint(p, fid) + "()`");
                    if (hasInt(targets, fid)) {
                        ids = ids.concat([fid]);
                        labels = labels.concat([ql[i]]);
                        paths = paths.concat([c4]);
                        via = via.concat([qv[i]]);
                    }
                    for (const fn0 of p.fns) {
                        if (fn0.sym.id == fid) {
                            qn = qn.concat([Node.NFn(fn0)]);
                            ql = ql.concat([ql[i]]);
                            qc = qc.concat([c4]);
                            qv = qv.concat([qv[i]]);
                        }
                    }
                }
            }
            i = i + 1;
        }
        // a chain of one step is the target itself: no "through"
        let ps2: string[] = [];
        for (const pth of paths) {
            if (pth.indexOf(" → ") < 0) ps2 = ps2.concat([""]);
            else ps2 = ps2.concat([pth]);
        }
        return { ids: ids, labels: labels, paths: ps2, via: via, fids: fids, flabels: flabels };
    }

    fn invStep(path: string, step: string) -> string {
        if (path == "") return step;
        return path + " → " + step;
    }

    // an invariant primitive's checks and its location
    type InvPrimAt:struct = { checks: Expr, loc: string }

    fn invPrimAt(e: Expr) -> InvPrimAt | not {
        return match e {
            .Prim(op: o, args: a) :> invPrimAtOf(o, a),
            // no-default-arm: one question of an expression — is it an invariant primitive
            _ :> not
        };
    }

    fn invPrimAtOf(o: PrimOp, a: Expr[]) -> InvPrimAt | not {
        const ci: int = invChecksArg(o);
        if (ci < 0 || a.length < ci + 2) return not;
        let loc: string = "";
        const l: string | not = invLitStr(a[a.length - 1]);
        if (l is given) loc = l;
        return { checks: a[ci], loc: loc };
    }

    // "`invariant [label]` on <owner> (file:line)"
    fn invCheckLabel(c: Expr, loc: string) -> string {
        const parts: Expr[] = invElems(c);
        let owner: string = "";
        let what: string = "";
        if (parts.length >= 5) {
            const o: string | not = invLitStr(parts[3]);
            if (o is given) owner = o;
            const w: string | not = invLitStr(parts[4]);
            if (w is given) what = w;
        }
        let at: string = "";
        if (loc != "") at = " (" + loc + ")";
        return "the invariant " + what + " on " + owner + at;
    }

    // the field indices of declaration `d` a check names (its root field for a check below a field,
    // else its names and its derived fields' dependencies)
    fn invCheckFieldIdxs(d: Decl, c: Expr) -> int[] {
        let names: string[] = [];
        for (const f of d.fields) { names = names.concat([f.sym.hint]); }
        const parts: Expr[] = invElems(c);
        if (parts.length < 5) return [];
        const at: Expr[] = invElems(parts[0]);
        let want: Expr[] = [];
        if (at.length > 0) {
            want = [at[0]];
        } else {
            want = invElems(parts[2]);
            if (parts.length > 5) {
                for (const dv of invElems(parts[5])) {
                    const dp: Expr[] = invElems(dv);
                    if (dp.length >= 3) want = want.concat(invElems(dp[2]));
                }
            }
        }
        let out: int[] = [];
        for (const x of want) {
            const nm: string | not = invLitStr(x);
            if (nm is given) {
                const ix: int = names.indexOf(nm);
                if (ix >= 0 && !hasInt(out, ix)) out = out.concat([ix]);
            }
        }
        return out;
    }

    // the index of the checks argument of an invariant primitive, else -1
    fn invChecksArg(o: PrimOp) -> int {
        if (o == PrimOp.InvariantGuard) return 2;
        if (o == PrimOp.InvariantValue) return 4;
        return -1;
    }

    fn hasInvariantChecks(p: CoreProgram) -> boolean {
        for (const d of p.decls) {
            if (d.invs is given) return true;
            for (const f of d.fields) {
                const ps: Persist | not = f.persist;
                if (ps is given) { if (ps.invs is given) return true; }
            }
        }
        for (const n of allNodes(Node.NProgram(p))) {
            if (invPrimNode(n)) return true;
        }
        return false;
    }

    fn invPrimNode(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> invPrimExpr(e),
            // no-default-arm: one question of a node — is it an invariant primitive
            _ :> false
        };
    }

    fn invPrimExpr(e: Expr) -> boolean {
        return match e {
            .Prim(op: o) :> invChecksArg(o) >= 0,
            // no-default-arm: one question of an expression — is it an invariant primitive
            _ :> false
        };
    }

    // `p` with every invariant check left out: a declaration's construction check and a persisted
    // cell's decode check gone (`not`), and the checks of every InvariantGuard / InvariantValue empty —
    // the primitive itself, its instance, its writes and its value kept, so the program differs from
    // `p` only by what the predicates (and their derived-field recomputations) read and call.
    fn invStripProgram(p: CoreProgram) -> CoreProgram {
        let ds: Decl[] = [];
        for (const d of p.decls) { ds = ds.concat([sivDecl(d)]); }
        let fs: Fn[] = [];
        for (const f of p.fns) { fs = fs.concat([sivFn(f)]); }
        let ss: ServerFn[] = [];
        for (const sf of p.server) {
            ss = ss.concat([{ sym: sf.sym, params: sf.params, ret: sf.ret, body: sivBlock(sf.body), err: sf.err, waits: sf.waits }]);
        }
        let ks: CoreConst[] = [];
        for (const k of p.consts) { ks = ks.concat([{ sym: k.sym, init: sivExpr(k.init), mutable: k.mutable }]); }
        let css: CoreCss | not = p.css;
        const c0: CoreCss | not = p.css;
        if (c0 is given) {
            let vs: CssVar[] = [];
            for (const cv of c0.vars) { vs = vs.concat([{ cell: cv.cell, read: sivExpr(cv.read) }]); }
            css = { sheet: c0.sheet, vars: vs };
        }
        return { program: p.program, decls: ds, types: p.types, fns: fs, server: ss, dbs: p.dbs, reset: p.reset, sqlError: p.sqlError,
                 serverCallError: p.serverCallError, css: css, consts: ks, loads: p.loads, envelopes: p.envelopes, head: p.head,
                 tool: p.tool, endpoints: p.endpoints, channels: p.channels, typed: p.typed, outer: p.outer };
    }

    fn sivDecl(d: Decl) -> Decl {
        let fs: Field[] = [];
        for (const f of d.fields) { fs = fs.concat([sivField(f)]); }
        const rs: View[] | not = d.renders;
        let rs2: View[] | not = not;
        if (rs is given) rs2 = sivViews(rs);
        return { sym: d.sym, key: d.key, kind: d.kind, single: d.single, fields: fs, renders: rs2, wiring: d.wiring, handles: d.handles, invs: not };
    }

    fn sivField(f: Field) -> Field {
        const init: Expr | not = f.init;
        let init2: Expr | not = not;
        if (init is given) init2 = sivExpr(init);
        const ps: Persist | not = f.persist;
        let ps2: Persist | not = not;
        if (ps is given) ps2 = { store: ps.store, key: ps.key, invs: not, loc: ps.loc };
        return { sym: f.sym, ty: f.ty, init: init2, mode: f.mode, role: f.role, grants: f.grants, graph: f.graph,
                 exported: f.exported, wcap: f.wcap, vals: f.vals, persist: ps2, timing: f.timing };
    }

    fn sivFn(f: Fn) -> Fn {
        return { sym: f.sym, params: f.params, body: sivBlock(f.body), pure: f.pure, err: f.err, waits: f.waits, host: f.host };
    }

    fn sivBlock(b: Block) -> Block {
        return { stmts: sivStmts(b.stmts) };
    }

    fn sivMaybeBlock(b: Block | not) -> Block | not {
        if (b is not) return not;
        return sivBlock(b);
    }

    fn sivMaybeExpr(e: Expr | not) -> Expr | not {
        if (e is not) return not;
        return sivExpr(e);
    }

    fn sivExprs(es: Expr[]) -> Expr[] {
        let out: Expr[] = [];
        for (const e of es) { out = out.concat([sivExpr(e)]); }
        return out;
    }

    fn sivExpr(e: Expr) -> Expr {
        return match e {
            .Lit :> e,
            .Local :> e,
            .Read :> e,
            .Call(callee: c, args: a) :> Expr.Call(c, sivExprs(a)),
            .Prim(op: o, args: a) :> Expr.Prim(o, sivPrimArgs(o, a)),
            .Match(scrut: s, arms: arms) :> Expr.Match(sivExpr(s), sivMatchArms(arms)),
            .ArrayOf(elems: xs) :> Expr.ArrayOf(sivExprs(xs)),
            .StructOf(ty: t, fields: xs) :> Expr.StructOf(t, sivExprs(xs)),
            .VariantOf(enumSym: es, idx: i, args: a) :> Expr.VariantOf(es, i, sivExprs(a)),
            .Handle :> e,
            .InitOf :> e,
            .Host :> e,
            .Lambda(params: ps, body: b) :> Expr.Lambda(ps, sivExpr(b)),
            .BlockLambda(params: ps, body: b) :> Expr.BlockLambda(ps, sivBlock(b)),
            .SeqCall(op: o, seq: sq, f: f) :> Expr.SeqCall(o, sivExpr(sq), sivExpr(f)),
            .Validity :> e,
            .Refetch :> e,
            .ServerCall(fn: f, args: a) :> Expr.ServerCall(f, sivExprs(a)),
            .Query(q: q) :> Expr.Query(sivQuery(q)),
            .Assigned(local: l, value: v) :> Expr.Assigned(l, sivExpr(v)),
            .Foreign(slice: sl, args: a) :> Expr.Foreign(sl, sivExprs(a)),
            .FnRef :> e,
            .CallV(f: f, args: a) :> Expr.CallV(sivExpr(f), sivExprs(a))
        };
    }

    // an invariant primitive's checks argument emptied; every other argument kept (and stripped)
    fn sivPrimArgs(o: PrimOp, a: Expr[]) -> Expr[] {
        const ci: int = invChecksArg(o);
        let out: Expr[] = [];
        let i: int = 0;
        for (const x of a) {
            if (i == ci) out = out.concat([Expr.ArrayOf([])]);
            else out = out.concat([sivExpr(x)]);
            i = i + 1;
        }
        return out;
    }

    fn sivQuery(q: SqlQuery) -> SqlQuery {
        return { db: q.db, chunks: q.chunks, params: sivExprs(q.params), slots: q.slots, mode: q.mode, kind: q.kind, reads: q.reads,
                 writes: q.writes, columns: q.columns, nobatch: q.nobatch, handled: q.handled, site: q.site, row: q.row };
    }

    fn sivMatchArms(arms: MatchArm[]) -> MatchArm[] {
        let out: MatchArm[] = [];
        for (const a of arms) { out = out.concat([{ pat: a.pat, body: sivExpr(a.body) }]); }
        return out;
    }

    fn sivStmts(ss: Stmt[]) -> Stmt[] {
        let out: Stmt[] = [];
        for (const s of ss) { out = out.concat([sivStmt(s)]); }
        return out;
    }

    fn sivStmt(s: Stmt) -> Stmt {
        return match s {
            .Let(sym: x, init: i) :> Stmt.Let(x, sivExpr(i)),
            .Assign(local: l, value: v, path: ps) :> Stmt.Assign(l, sivExpr(v), sivPath(ps)),
            .Write(cap: c, inst: i, edit: k, value: v, check: ck) :> Stmt.Write(c, i, sivEdit(k), sivExpr(v), ck),
            .Commit(writes: ws) :> Stmt.Commit(sivStmts(ws)),
            .If(cond: c, thenB: t, elseB: el, tx: tx) :> Stmt.If(sivExpr(c), sivBlock(t), sivMaybeBlock(el), tx),
            .Return(e: x) :> Stmt.Return(sivExpr(x)),
            .Eval(e: x) :> Stmt.Eval(sivExpr(x)),
            .Suspend(bind: b, on: on, then: t) :> Stmt.Suspend(b, sivExpr(on), sivBlock(t)),
            .ResetSurface :> s,
            .Defer(body: b) :> Stmt.Defer(sivBlock(b)),
            .Unpersist :> s,
            .Attempt(result: r, call: c, err: er, ok: ok, arms: arms) :> Stmt.Attempt(r, sivFailable(c), er, sivOk(ok), sivErrArms(arms)),
            .Fail(err: er, idx: i, args: a) :> Stmt.Fail(er, i, sivExprs(a)),
            .Join(k: k, body: b) :> Stmt.Join(k, sivBlock(b)),
            .Jump :> s,
            .Loop(label: l, head: h, body: b) :> Stmt.Loop(l, sivLoopHead(h), sivBlock(b)),
            .Break :> s,
            .Continue :> s,
            .Gather(g: g) :> Stmt.Gather(sivGather(g)),
            .Lift(into: i, what: w) :> Stmt.Lift(i, sivLifted(w)),
            .LocalFn(f: f) :> Stmt.LocalFn(sivFn(f))
        };
    }

    fn sivPath(ps: PathStep[]) -> PathStep[] {
        let out: PathStep[] = [];
        for (const st of ps) { out = out.concat([sivPathStep(st)]); }
        return out;
    }

    fn sivPathStep(st: PathStep) -> PathStep {
        return match st {
            .StepField :> st,
            .StepIndex(index: i, loc: l) :> PathStep.StepIndex(sivExpr(i), l)
        };
    }

    fn sivEdit(k: EditKind) -> EditKind {
        return match k {
            .ElemAt(index: i, path: p, loc: l) :> EditKind.ElemAt(sivExpr(i), p, l),
            .PositionAt(index: i, loc: l) :> EditKind.PositionAt(sivExpr(i), l),
            .Replace :> k,
            .Append :> k,
            .Prepend :> k,
            .Anywhere :> k,
            .PositionWrite :> k,
            .FieldAt :> k,
            .Transition :> k,
            .RemoveEnd :> k,
            .RemoveFront :> k,
            .RemoveAnywhere :> k
        };
    }

    fn sivFailable(c: Failable) -> Failable {
        return match c {
            .FCall(fn: f, args: a) :> Failable.FCall(f, sivExprs(a)),
            .FSettled :> c,
            .FParse(json: j, en: en, err: er) :> Failable.FParse(sivExpr(j), en, er),
            .FCallV(f: f, args: a) :> Failable.FCallV(sivExpr(f), sivExprs(a))
        };
    }

    fn sivOk(ok: OkArm) -> OkArm {
        return { bind: ok.bind, body: sivBlock(ok.body), value: sivMaybeExpr(ok.value) };
    }

    fn sivErrArms(arms: ErrArm[]) -> ErrArm[] {
        let out: ErrArm[] = [];
        for (const a of arms) { out = out.concat([{ pat: a.pat, body: sivBlock(a.body), value: sivMaybeExpr(a.value), whole: a.whole }]); }
        return out;
    }

    fn sivLoopHead(h: LoopHead) -> LoopHead {
        return match h {
            .Forever :> h,
            .While(cond: c) :> LoopHead.While(sivExpr(c)),
            .Counted(init: i, cond: c, step: sp) :> LoopHead.Counted(sivStmts(i), sivMaybeExpr(c), sivStmts(sp)),
            .Each(h: eh) :> LoopHead.Each({ bind: eh.bind, src: sivExpr(eh.src) }),
            .Range(h: rh) :> LoopHead.Range({ bind: rh.bind, counter: rh.counter, end: rh.end, lo: sivExpr(rh.lo), hi: sivExpr(rh.hi), inclusive: rh.inclusive })
        };
    }

    fn sivGather(g: Gather) -> Gather {
        return { label: g.label, bind: g.bind, head: sivLoopHead(g.head), body: sivBlock(g.body) };
    }

    fn sivLifted(w: Lifted) -> Lifted {
        return match w {
            .LValue(e: e) :> Lifted.LValue(sivExpr(e)),
            .LRow :> w
        };
    }

    fn sivViews(vs: View[]) -> View[] {
        let out: View[] = [];
        for (const v of vs) { out = out.concat([sivView(v)]); }
        return out;
    }

    fn sivView(v: View) -> View {
        return match v {
            .El(tag: t, attrs: a, kids: ks) :> View.El(t, sivAttrs(a), sivViews(ks)),
            .Text :> v,
            .RawText :> v,
            .Dyn(e: e) :> View.Dyn(sivExpr(e)),
            .Cond(arms: arms) :> View.Cond(sivCondArms(arms)),
            .Each(src: s, bind: b, key: k, handles: hs, row: r) :> View.Each(sivExpr(s), b, sivMaybeExpr(k), hs, sivViews(r)),
            .Instance(decl: d, attrs: attrs, slot: sl, alias: al) :> View.Instance(d, sivConstructAttrs(attrs), sivViews(sl), al),
            .Slot :> v,
            .Star :> v,
            .Effect(deps: ds, body: b) :> View.Effect(ds, sivBlock(b)),
            .Request(target: t, deps: ds, body: b, mount: m, state: st, handle: h, cls: c) :> View.Request(t, ds, sivBlock(b), m, st, h, c),
            .ResetOn(triggers: ds, reset: b, rank: r) :> View.ResetOn(ds, sivBlock(b), r),
            .Errors :> v,
            .Gather(g: g, rows: rows, key: k) :> View.Gather(sivGather(g), sivGatherRows(rows), k),
            .Run(body: b, hoist: h, meta: m) :> View.Run(sivBlock(b), h, m),
            .Init :> v,
            .Reach :> v
        };
    }

    fn sivAttrs(xs: Attr[]) -> Attr[] {
        let out: Attr[] = [];
        for (const a of xs) { out = out.concat([sivAttr(a)]); }
        return out;
    }

    fn sivAttr(a: Attr) -> Attr {
        return match a {
            .Static :> a,
            .Bound(name: n, e: e) :> Attr.Bound(n, sivExpr(e)),
            .Show(test: t) :> Attr.Show(sivExpr(t)),
            .ClassOn(name: n, test: t) :> Attr.ClassOn(n, sivExpr(t)),
            .On(event: ev, body: b) :> Attr.On(ev, sivBlock(b)),
            .Bind(kind: k, read: r, sink: sk, write: w) :> Attr.Bind(k, sivExpr(r), sk, sivBlock(w)),
            .Gate :> a
        };
    }

    fn sivCondArms(arms: CondArm[]) -> CondArm[] {
        let out: CondArm[] = [];
        for (const a of arms) { out = out.concat([{ test: sivExpr(a.test), body: sivViews(a.body) }]); }
        return out;
    }

    fn sivConstructAttrs(attrs: ConstructAttr[]) -> ConstructAttr[] {
        let out: ConstructAttr[] = [];
        for (const a of attrs) { out = out.concat([{ field: a.field, value: sivExpr(a.value) }]); }
        return out;
    }

    fn sivGatherRows(rows: GatherRow[]) -> GatherRow[] {
        let out: GatherRow[] = [];
        for (const r of rows) { out = out.concat([{ views: sivViews(r.views) }]); }
        return out;
    }
}
