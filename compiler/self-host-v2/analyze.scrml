// =============================================================================
// self-host-v2 / analyze.scrml — FileAst[] → TypedProgram (bootstrap impl#2,
// slice M2). The S233 re-cut's third phase: `TypedProgram = FileAst + NodeId
// side-tables` (dpa-051 §3.1, R1 (a) ruled S437).
//
//   - NAMES ARE SYMBOLS (§3.3). This module is THE BINDER: the only minter of
//     Syms (core.scrml, THE BINDER'S OBLIGATION). Every identifier the program
//     uses is bound here — to a declaration, a field (with the InstRef that
//     reaches it, L1/L2/L10/L11/L12), a write capability (L3), a type, a
//     variant, a function, a parameter, a local, an `as=` handle or an `<each>`
//     row binding.
//   - ONE TABLES RECORD (§3.5): every fact `lower` needs is either a
//     declaration/type/function record or a node fact keyed by the NodeId it
//     is about — one side-table per FACT FAMILY (names, values, effects,
//     binders, elements, attributes; M3 item 2), each reached through ONE
//     NodeId index in O(1). Tables are built once, never mutated (each step
//     returns a new value), and `lower` consumes them without re-deciding
//     anything.
//   - THE EDIT CLASSIFIER (§6.2, §66.11.2) runs here: every write becomes a
//     `WriteFact { cap, inst, edit, check }` or a diagnostic —
//     E-DERIVED-WRITE, E-WRITE-NOT-GRANTED, E-DECL-HANDLE-NOT-NARROWED,
//     E-FIELD-PRIVATE-WRITE, E-DECL-RENDERS-BARE-WRITE, E-ENGINE-INVALID-TRANSITION
//     (§66.20). The spread `@x = { ...@x, f: v }` is a FIELD EDIT (O58 (b)).
//   - Two passes then READ the binder's tables (M3 item 1): THE SCOPE PASS
//     (a scope binds each name once — E-SCOPE-010, E-SCOPE-REDECLARE) and
//     THE TYPER (a type per expression node in `Tables.typing`; writes,
//     initializers, call arity, `<each in=>`, conditions and operator
//     operands checked — E-TYPE-031, E-TYPE-041, E-CALL-ARITY,
//     E-EACH-NOT-SEQUENCE, and the S440-ruled E-COND-NOT-BOOLEAN (SPEC
//     §42.4, S460), E-OPERATOR-OPERAND-TYPE, E-OPERAND-NOT-NARROWED,
//     E-INT-DIVISION — named in SPEC §66.20, S442). Where neither a
//     ruling nor the SPEC names a rule they use bootstrap-local
//     `E-BOOTSTRAP-*` codes; see each section's header for the sentences.
//
// Scope of slice M2: the §66 subset §66.19.1 (counter) and §66.19.3 (dropdown)
// use. A construct outside it is reported (`E-BOOTSTRAP-UNSUPPORTED`), never
// guessed.
//
// impl#1 workarounds: F4 (qualified variants), F5 (typed host results), F11
// (named payload binding), F15 (no fn named like a
// payload field of an enum declared in this file), F16 (≥ 1 binding arm over an
// imported payload enum).
// =============================================================================
${
    import { Sym, Type, SeqAt, LengthGrant, SeqGrants, FieldDef, VariantDef, TypeDef, FieldRef, InstRef,
             Literal, PrimOp, EditKind, Check, FieldMode, FieldRole, GrantSet, Edge, TransitionGraph,
             DeclKind, HostCall, HostFn, HostBind, HostSrc, HostArg, HostProp, SeqFn, BindKind, Validator, SurfaceProp, ValidityOf, Persist, PersistStore, CoreProgram,
             SqlKind, SqlTables, SqlColumns, Db, Driver, DbLoad, Envelope,
             CssPart, CssDecl, StyleRule, CssImport, ScopeSheet,
             mkSym, noGrants, replaceGrant, typeDefSym, validityInst, validityDecl, plainHead, declScopeKey } from "./core.scrml"
    import { ASpan, BinOp, UnOp, AExpr, AProp, AExprK, AStmt, ABlock, AStmtK, AEffect, AType, ATypeK,
             ATypeField, AVariant, ATypeBody, ATypeDecl, AParam, AFn, AImportName, AImport,
             AAttrValue, AAttr, AElem, ANode, ANodeK, ADeclAttr, AStateChild, ADeclChild, ADecl, AValArg, AValidator,
             AProgram, AItem, AItemK, AConst, FileAst, ADbFn, AHostBind, Diag, ASql,
             AHow, AHandled, AArm, APat, ABind, AArmBody, AFail, AFor, AForHead, AIterSrc, AForBound, ALift, AForeign,
             ACss, ACssItem, ACssRule, ACssDecl, ACssPart, ACssRef, mkSpan, newDiag,
             HView, HTargetParts, hostView, hostTargetParts, hostRootGlobal, isHyphenWordExpr } from "./ast.scrml"
    import { Severity } from "./severity.scrml"
    import { isKnownElementName, isHtmlElementName } from "./elements.scrml"
    import { importTarget, importsOfItems, hostImportsOfItems, hostTagOf, isStdlibPath, stdlibPrefix, HostLoc, hostLocOf } from "./link.scrml"
    import { WireBuild, WireTable, wireBuild, hasFixedLength } from "./codec.scrml"
    import { SqlFacts, SlotQuote, MultiStmt, StmtVerdict, sqlFacts, slotInLiteral, txControl, txControlAware, multiStatement, programStatement, journalOff } from "./sql.scrml"
    import { FxAtom, ownAtom, closeDim, witnessOf, atomChain, sccOrder } from "./effects.scrml"
    import { UrlAttr, StaticSink, classifyStatic, staticExecMessage, logicWriteSink, logicCallSink, attrNameArgIndex, executableAttrName, htmlArgIndex, attrNodeMember, attrNodeValueMember, urlValueAdmitted, schemeOfUrl, isUrlAttrName, attrValueArgIndex } from "./url.scrml"
    import { HEntry, surfaceInterfaces, isSurfaceIface, isDomElementIface, ifaceInherits, findEntry, accessesOf, sigParams, sigResult,
             slotType, slotOptional, isCallbackSlot, slotAlternatives, slotAdmitsNot, unWaiting, entryGuards, inertTagIface,
             dictKeys, attrNameVerdict, entryConflict, runtimeGuardsBuilt, brandChecksBuilt, inertElements } from "./host-surface.scrml"

    // =========================================================================
    // THE TABLES (exported — `lower` consumes them).
    // =========================================================================
    // One field of a declaration (Core `Field` minus the lowered initializer;
    // `init` is the syntax lower lowers, with the facts below).
    // `span` / `annotated` (M3 typer): where the field is declared, and whether
    // its type was WRITTEN (`name:Type`) rather than inferred from a literal —
    // §7.5.1's initializer rule applies to an annotation only.
    // `trusted`: its TYPE EXPRESSION parsed cleanly (no parser error inside
    // the type's own span) — the typer checks nothing against a type that
    // failed to parse. A diagnostic anywhere else (the initializer, a
    // sibling, the body) does not untrust the type. `typeSpan`: the written
    // type (`not` when the type is inferred).
    export type FieldInfo:struct = {
        nid: int,
        span: ASpan,
        annotated: boolean,
        trusted: boolean,
        typeSpan: ASpan | not,
        sym: Sym,
        ty: Type,
        mode: FieldMode,
        role: FieldRole,
        grants: GrantSet,
        graph: TransitionGraph | not,
        exported: boolean,
        wcap: Sym | not,
        init: AAttrValue,
        reads: string[],
        shrink: SeqAt[],        // s442: the SHRINK places its sequence type grants (RULED S442 grow/shrink split)
        vals: ValInfo[],        // s444 Phase B: its validators, as the bootstrap honors them (their HTML-native lowering)
        valsWritten: int,       // s449: how many validators the source wrote (a refused one is absent from `vals`)
        origin: TypeOrigin,     // s462: where `ty` came from (§66.3 rules 3, 5–10) — what the typer reports
    }

    // s462 — O35(d), RULED S462 ("go on the package", SPEC §66.3 rules 5–10).
    // Where a field's type came from, decided in phase A (ownOrigin) and
    // REPORTED by the typer (originReport — after every other pass, so a
    // diagnostic already inside the initializer suppresses it: no cascade).
    //   Written            — `:T` is written, and the initializer is provable
    //   WrittenUnproven    — `:T` over an initializer whose value is unresolvable
    //                        (rule 10, E-DECL-TYPE-UNPROVEN)
    //   Literal            — inferred from a literal (rule 3, rule 5 (a))
    //   Inferred           — inferred from a non-literal member of the set (rule 5)
    //   Failed             — outside the set (rule 7, E-DECL-TYPE-NOT-INFERABLE)
    //   Cyclic             — on an inference cycle (rule 8): silent when every
    //                        member is derived (E-DERIVED-CIRCULAR-DEP owns it)
    //   Boundary           — non-literal, unannotated, and persist= / export
    //                        (rule 9, E-DECL-TYPE-REQUIRED-AT-BOUNDARY)
    //   Blamed             — another diagnostic owns it (a refused type, a
    //                        cell that itself failed, a mis-linked callee)
    export type TypeOrigin:enum = {
        Written,
        WrittenUnproven(why: string, at: CalleeAt),
        Literal,
        Inferred,
        Failed(why: string, at: CalleeAt),
        Cyclic(names: string[]),
        Boundary(where: string),
        Blamed,
    }
    // s462 fix round 1 (F5): the function a failed proof stands in ("" file —
    // none). An Error already inside that function (a refused construct)
    // owns the failure: the own-value code is not a second report.
    export type CalleeAt:struct = { file: string, start: int, end: int }

    // s444 Phase B (dpa-058, RULED S442 (2)) — one validator of a field and its
    // HTML-native lowering (`required`, `minlength` / `maxlength`, `min` /
    // `max`, `pattern` only when exact): the attributes that land on every
    // native input / textarea / select whose `bind:` targets the field's value.
    export type HtmlAttrPair:struct = { name: string, value: string }
    // `core` (s449): the validator as Core carries it — what the §55 surface evaluates.
    export type ValInfo:struct = { name: string, span: ASpan, attrs: HtmlAttrPair[], core: Validator }

    // `nid` = the ADecl (user) / AProgram node. `file` = the defining file (E2).
    export type DeclInfo:struct = {
        nid: int,
        span: ASpan,
        sym: Sym,
        kind: DeclKind,
        single: boolean,
        file: string,
        fields: FieldInfo[],
        handles: Sym[],
    }

    // An `as=` handle (L10): where its cell lives (`owner` = the declaration or
    // `<each>` element nid), the declaration of the instance it names, and
    // whether that instance is conditionally mounted (§66.7.5 → `T | not`).
    // `span` / `file`: the `as=` attribute that binds it (the scope pass's diagnostics).
    export type HandleInfo:struct = { sym: Sym, name: string, target: Sym, owner: int, conditional: boolean,
                                      span: ASpan, file: string }

    export type TypeInfo:struct = { nid: int, span: ASpan, name: string, file: string, exported: boolean, def: TypeDef }
    // `arity`: its parameter count (the bootstrap has no default parameters);
    // -1 when the signature did not parse cleanly or a parameter is untyped
    // (no arity check against it). `ret`: the declared return type (`-> T`),
    // resolved here; `not` when none is written (or `-> void`), or when the
    // signature did not parse.
    // s451 (Ue): `failable` — declared `!` (§19.4); `err` — its error enum
    // (the declared `! E`, or the built-in `Error` for a bare `!`, §19.4.2);
    // `not` when it cannot fail, or when the declared type is not an enum
    // (E-ERROR-011 — then nothing is checked against it).
    // s454 (U1b): `serverOwn` — its OWN body places it on the server (§12.2 T1 /
    // T4: a `?{}` in it, or the deprecated `server` modifier) — syntactic, known
    // in phase A, before any body is bound (design §2.5: "compute the
    // own-trigger fact … ONCE in phaseA per function"); a Split function
    // (§19.9.5) has it too. `rerr` — the failure enum of a CLIENT call of it
    // (§19.9.10 "The failure set of a client call"): its declared enum plus ONE
    // variant `Transport(t: ServerCallError)` (minted `E + Transport`; `E`
    // itself when it already declares exactly that variant), or the shared
    // `Transport` enum for a callee not declared `!`. `not`: not serverOwn, or
    // its enum has a `Transport` variant of another shape (E-ERROR-016 at each
    // client call site), or its error type is not an enum (E-ERROR-011).
    // s472 (boot-math-port) — `host`: the function is HOST-BACKED (fnsOf
    // `hostWrapperOf`, the §21.3.1 wrapper rule): its body is the one host call
    // it wraps, and Core keeps its signature and the host reference (core.scrml
    // HostFn) instead of a body. `not`: an ordinary function.
    export type FnInfo:struct = { nid: int, span: ASpan, sym: Sym, name: string, file: string, exported: boolean,
                                  pure: boolean, arity: int, ret: Type | not, failable: boolean, err: Sym | not,
                                  serverOwn: boolean, rerr: Sym | not, host: HostFn | not }

    // A classified write (§6.2): the capability, the instance, the edit, the check.
    export type WriteFact:struct = { cap: Sym, inst: InstRef, edit: EditKind, check: Check }
    // One override of a spread write `@x = { ...@x, f: v }` (O58 (b)): a
    // FieldAt edit whose value is the object literal's prop number `prop`.
    // `tmp` is the local that value is evaluated into BEFORE any override is
    // written: the literal is one value built from one snapshot (§66.10 item 1),
    // so `{ ...@p, x: @p.y, y: @p.x }` swaps exactly as the genuine replace
    // `{ x: @p.y, y: @p.x }` does (§66.11.3 item 1 — legality and meaning never
    // depend on spelling). Minted here so `lower` still decides nothing. A
    // non-spread write viewed as one override (the typer's `oneWrite`, prop -1)
    // has no local: `tmp` is `not`.
    export type SpreadWrite:struct = { w: WriteFact, prop: int, tmp: Sym | not }
    // One per-field snapshot local of a spread's target (RULED S440 strict
    // snapshot; see spreadEffect): the field (`ref`) and the local it is read
    // into when an override value reads it.
    export type SnapField:struct = { ref: FieldRef, local: Sym }
    // r2 (RULED S442 "sequence spreads use one snapshot"): the one snapshot of a
    // sequence shape's target — field `idx` of `decl` — read into `local` before
    // any element is evaluated; every `@x` read inside the elements reads it.
    export type SeqSnap:struct = { local: Sym, decl: Sym, idx: int }

    // How an attribute of an element is used.
    export type AttrKind:enum = {
        AStatic,                  // a plain HTML attribute with a literal value
        ABound,                   // a plain HTML attribute bound to an expression
        AOn(event: string),       // an event handler (onclick → "click")
        AIf,                      // if= (L5)
        AShow,                    // s451: show= (§17.2) — a visibility condition on an HTML element
        AConstruct(field: int),   // a use-site construction value (§66.14 rule 4)
        AAs,                      // as= on a use (the handle is on the element's MUse)
        AEachIn,
        AEachKey,
        AEachAs,
        // s444: a two-way bind (§5.4) — the write it performs (the place's own
        // contract, as `@x = v` / `@x.f = v`), the declaration field it
        // targets (`decl` / `idx`, the Phase-B validator join) and the
        // event-value local (`sink`, minted here).
        ABind(kind: BindKind, w: WriteFact, decl: Sym, idx: int, sink: Sym, vattrs: HtmlAttrPair[]),
    }

    // ---- THE NODE FACTS, by family (M3 item 2) --------------------------------
    // A node's fact lives in the side-table of its FAMILY — chosen by which
    // consumer asks, so each consumer's `match` is total over a few variants
    // (plus `not`: no fact) instead of one enum of every fact:
    //   names   — what a name / `@x` / `@.` / member / callee DENOTES
    //             (lower's reads, member steps and calls; the typer's value types)
    //   values  — a constant or an operator the binder resolved
    //             (lower's literals / variants / struct values / primitives)
    //   effects — what a statement-position assignment or edit call DOES
    //             (lower's writes; the typer's write checks)
    //   binds   — the Sym a `let` / function / parameter / `given` binds
    //   elems   — what an element IS (HTML, a use, an `<each>`, a slot)
    //   attrs   — how an attribute is used (AttrKind)
    export type NameFact:enum = {
        NLocal(sym: Sym),                                // a local / parameter / row binding
        NField(decl: Sym, inst: InstRef, idx: int),       // a read of a declaration field
        NInst(decl: Sym, inst: InstRef),                  // an instance (a whole-value read, or a handle)
        NStruct(owner: Sym, idx: int),                    // a struct-field step
        NFn(sym: Sym),                                    // a function
        NLength,                                          // `.length` of a sequence or a string (a primitive read)
        NSurface(of: ValidityOf, prop: SurfaceProp),      // s449: a read of the validity surface (§55.5 / §55.6) — read-only
        NConst(sym: Sym),                                 // s472: a file-scope constant (§7.6) — lowered to Core `Local(sym)` of CoreProgram.consts
    }
    export type ValueFact:enum = {
        VLit(lit: Literal),                               // a literal (int vs number resolved)
        VVariant(enumSym: Sym, idx: int),                 // a bare variant
        VOp(op: PrimOp),                                  // a unary / binary operator, resolved (§45)
        VStructOf(ty: Sym, order: int[]),                 // an object literal: prop index per declared field
        VConstruct(enumSym: Sym, idx: int),               // s472: a payload-variant construction `E.V(…)` / `.V(…)` (§14.4) — a call node; Core VariantOf
        VHost(call: HostCall),                            // s444: a host call (`Date.now()`) — the closed HostCall set
        VSeqCall(op: SeqFn),                              // s444: `seq.filter(λ)` / `seq.map(λ)` — a call node
        VLambda(params: Sym[]),                           // s444: `x => e` as a SeqCall's argument — its parameter locals
        VToEnum(enumSym: Sym),                            // s469: `E.toEnum(s)` (§14.4.1) — a call node: `string -> E | not`
        VMethod(op: PrimOp),                              // s469: a typed built-in method (`s.slice(1)`, `xs.sort()`) — a call node; Core Prim(op, [receiver, …args])
        VIndex(loc: string),                              // s469: `xs[i]` read (§49.13) — an index node; `loc` "file:line" for the trap (§19.17)
        VAt,                                              // s469: `xs.at(i)` (§49.13) — a call node: `T | not`, never a trap
        VTemplate(text: boolean[]),                       // s469: a logic template (§14.13.3) — per slot, true when it is not a `string` and lower renders its text (Core Text)
    }
    export type EffectFact:enum = {
        EWrite(w: WriteFact),                             // an assignment / an edit call
        ESpread(ws: SpreadWrite[], inst: Sym, snap: Sym, fields: SnapField[]), // a spread assignment: FieldAt edits (O58 (b)); the instance + snapshot locals
        EReset(w: WriteFact, decl: Sym, idx: int),        // reset(@x): a replace with x's initializer (L4)
        // a local rebinding (§66.11.5) — `path` empty; s472: `path` non-empty is a
        // write to a PART of the local (`p.f = v`, `xs[i] = v`; Core Assign with a
        // path), `ty` the type of the part written (the typer checks the value)
        EAssignLocal(sym: Sym, path: LStep[], ty: Type | not),
        EEdits(w: WriteFact, elems: AExpr[], tmps: Sym[], snap: SeqSnap), // s442: `@x = [...@x, a, b]` — one edit per element (§66.11.2); r1: each element evaluated into `tmps[i]` first; r2: reads of `@x` see `snap`
        ERemove(w: WriteFact),                            // s444: `@x.pop()` / `@x.shift()` — a removal of one element (RemoveEnd / RemoveFront)
        EElemAt(cap: Sym, inst: InstRef, index: AExpr, path: FieldRef[], loc: string), // s444: `@xs[i].f = v` — an element-field write (Core ElemAt; dpa-052 Q3); s473: `loc` "file:line" for the trap
        EPosition(cap: Sym, inst: InstRef, index: AExpr, loc: string),   // s472: `@xs[i] = v` — a position write (Core PositionAt; §66.12.6 rule 3); `loc` "file:line" for the trap
    }
    // s472 — one step of a local part write's path (EAssignLocal): a struct field
    // (`name` as written, for the narrowing key), or a tape position.
    export type LStep:enum = {
        LField(ref: FieldRef, name: string),
        LIndex(index: AExpr, loc: string),
    }
    export type BindFact:enum = {
        BBind(sym: Sym),                                  // a binder: a local statement, a function
        BParam(sym: Sym, ty: Type),                       // a function parameter and its (annotated) type
        BGiven(sym: Sym, inst: InstRef),                  // given c = @handle (L11)
        BLoop(label: Sym, end: Sym | not, counter: Sym | not, key: Sym | not), // s469: a `for` (on the AFor) — its label; a range head's `end` / `counter` (§49.2.5); s474: the local holding an iteration's header `key` (§17.4b)
        BJump(target: Sym),                               // s469: a `break` / `continue` — the label Sym of the loop it leaves / re-enters
    }
    export type ElemFact:enum = {
        MHtml,
        MUse(decl: Sym, alias: Sym | not),                // an element that is a USE of a declaration
        MEach(bind: Sym, handles: Sym[]),                 // an <each> element
        MSlot,
        MStateView(v: StateView),                         // `<*f/>` of a graph field: its state-child bodies (O5 (1i))
        MInline(v: InlineView),                           // `<*x/>` rendered by inlining its markup (s442)
        MStar(decl: Sym, inst: InstRef),                  // s444: `<*x/>` of a user declaration's EXISTING instance (Core View.Star)
        MErrors(of: ValidityOf, all: boolean),            // s449: `<errors of=…/>` (§55.8) — the surface whose errors it renders
        MDb,                                              // s452: a `<db src=…>` state block (§4, §8.1.1) — its children render in place
    }
    // s442 — `<*x/>` (§66.6.2, "the existing one") rendered by INLINING markup
    // that is already resolved in the right context: a child field's own
    // `renders` inside its declaration's renders (`<*email/>`, `subst` = not —
    // the current instance is already Lexical(0)), or a user declaration's
    // `renders` for its shared instance at program top level (`<*signup/>`,
    // `subst` = Shared(x): the renders' `.Lexical(0)` means that instance).
    // Core has no View.Star (M1 D4; core.scrml is outside this slice), so the
    // inline form is restricted to markup that constructs nothing (no use, no
    // `as=`, no `<slot/>`) — every node reads / writes the ONE existing instance.
    export type InlineView:struct = { nodes: ANode[], subst: InstRef | not }
    // s442 — `<*f/>` of a field whose value carries a `rule=` graph with
    // state-child BODIES: O5 RULED (1i) "a state-child's body is that
    // variant's markup, rendered wherever the field renders". One arm per
    // state-child that has a body: shown while the field (`decl`/`inst`/`idx`)
    // holds variant `variant` of `enumSym`. The bodies are syntax (resolved in
    // the declaring declaration's context, like its renders); lower lowers them.
    export type StateArm:struct = { variant: int, body: ANode[] }
    export type StateView:struct = { decl: Sym, inst: InstRef, idx: int, enumSym: Sym, arms: StateArm[] }

    // A family's side-table: its facts in the order the binder recorded them,
    // `nids[i]` the node `facts[i]` is about, and `at` — the NodeId index:
    // `at[nid]` is the position of node `nid`'s fact, -1 (or past the end)
    // when the family has none. O(1). Built once, when the binder is done
    // (`indexed`); a node has one fact (the binder resolves each node once —
    // tables.test.js checks), and were there two, the first would answer, as
    // the linear scan this replaces did.
    // s451 (Ue) — THE ERROR-MODEL FACTS (lower reads them; it decides nothing).
    //   FHandled — a handling form (`?` / `!{}` / `match`, keyed by its
    //     AExprK.Handled node), or a `?{}` a `!` function propagates
    //     implicitly (keyed by its Sql node, §19.8.2): see HandledFact.
    //   FArm — an arm of a `!{}` / `match` (keyed by its AArm nid): the
    //     variant index it matches; -1 the wildcard (`_` / `else`); -2 `.Ok`.
    //   FFail — a `fail` statement (keyed by its AStmt nid): variant `idx` of
    //     enum `err` (§19.3).
    // HandledFact: `err` — the error enum of the failable; `result` — the local
    // its value is read from after the Attempt (an AExprK.Handled reads as
    // it); `ok` — the local the raw result is bound to; `stmt` — the form
    // stands as a statement (its arms yield no value); `into` / `retag` — for
    // propagation (`?`, an implicit `?{}`), the enclosing function's error enum
    // and, per variant of `err`, the variant of `into` it re-fails as with
    // the payload locals it binds (§19.5.2: "`::ErrorVariant(args) :> fail
    // EnclosingErrorType::ErrorVariant(args)`").
    export type Retag:struct = { from: int, to: int, binds: Sym[] }
    // s454 (U1b): `outcome` — the local a Suspend binds the call's SETTLED
    // outcome to, when the call suspends (a client call of a server function, a
    // call of a waiting client function — the suspension plan decides; design
    // §2.1 "Suspend waits, Attempt inspects"); `remote` — the call names a
    // server-triggered function from a site that is (or may be) on the client:
    // then `err` is the CLIENT call's failure set (FnInfo.rerr) and RemoteFact
    // says what the call is when the site turns out server→server.
    export type HandledFact:struct = { err: Sym, result: Sym, ok: Sym, stmt: boolean, into: Sym | not, retag: Retag[],
                                       outcome: Sym, remote: RemoteFact | not }
    // s454 (U1b) — `callee`: the server function; `caller`: the enclosing
    // function's Sym id (-1: an event handler / effect body — a client site by
    // position); `local`: the callee's own error enum (`not`: not declared `!`)
    // — the Attempt's `err` when the call is server→server; `retagT`: for `?`,
    // the re-fail of the client set's trailing `Transport` (owed only by a
    // client call; `retag` holds the callee's own variants).
    export type RemoteFact:struct = { callee: Sym, caller: int, local: Sym | not, retagT: Retag[] }
    export type FailFact:enum = {
        FHandled(h: HandledFact),
        FArm(idx: int),
        FFail(err: Sym, idx: int),
        FPlain(m: PlainMatch),
    }
    // s469 — THE §18 PLAIN-VALUE `match` (keyed by its AExprK.Handled node): a
    // `match` whose subject is not a failable result. Its arms are FArm facts:
    // idx ≥ 0 a variant of `es`, -1 the wildcard (`_` / `else`), -5 the absence
    // arm `not :>`, -6 a literal arm (its literal is the VLit of the pattern's
    // expression), -3 an arm that did not resolve (reported).
    //   `kind` — 0 an enum (`es`), 1 string, 2 number, 3 bool, 4 not known;
    //   `maybe` — the subject may be `not` (its type is `T | not`, or a `not` arm
    //     is written); `known` — the binder knew the subject's type (else the
    //     typer checks the arms against it); `wild` — a wildcard arm is written;
    //   `exhaustive` — every value the subject can hold has an arm (else the
    //     value form yields `not` for the rest, §18.16.3);
    //   `stmt` — the form stands as a statement (its arms yield no value);
    //   `scrut` / `pick` — the statement form's locals: the subject, evaluated
    //     once, and the index of the arm it takes; `arms` — per arm, the inner
    //     binders the statement form reads a payload through.
    export type PlainArm:struct = { nid: int, inner: Sym[] }
    export type PlainMatch:struct = { es: Sym | not, kind: int, maybe: boolean, known: boolean, wild: boolean, exhaustive: boolean, notArm: boolean,
                                      stmt: boolean, scrut: Sym, pick: Sym, arms: PlainArm[] }
    export type FailTable:struct = { facts: FailFact[], nids: int[], at: int[] }

    export type NameTable:struct = { facts: NameFact[], nids: int[], at: int[] }
    export type ValueTable:struct = { facts: ValueFact[], nids: int[], at: int[] }
    export type EffectTable:struct = { facts: EffectFact[], nids: int[], at: int[] }
    export type BindTable:struct = { facts: BindFact[], nids: int[], at: int[] }
    export type ElemTable:struct = { facts: ElemFact[], nids: int[], at: int[] }
    export type AttrTable:struct = { facts: AttrKind[], nids: int[], at: int[] }

    // THE TYPER'S TABLE (M3 item 1). `exprs`: the type of every expression
    // node the typer walked, keyed by NodeId (`at`, built once when the typer
    // settles; of two entries for one node the first answers). A value's
    // type is what the typer can PROVE: `Known(t)`, the absence literal `not`
    // (`Absent`, §42), `Unknown` (inference stopped — no check ever fires
    // on an Unknown), or `OneOf(ts)` (s472, g-boot-mixed-arm-type-unresolved-
    // fail-open-s472): a CHOICE — a ternary, or a local joined from several
    // values — whose branches have KNOWN types with no common type. It is one
    // of those types, each the value when its branch is taken, so every typed
    // position checks every member (the union rule of §17.6: "If arms lift
    // different types, the result type is their union"). It is not Unknown: the
    // typer resolved every branch, so it is never provable-or-silent. (A
    // `match` whose arms disagree is §18.4 rule 3's E-TYPE-001 instead.)
    export type VType:enum = { Known(t: Type), Absent, Unknown, OneOf(ts: Type[]) }
    export type ExprType:struct = { nid: int, vt: VType }
    // `presence`: the condition nodes (`if`, `if=`, a ternary test) whose
    // value is a `T | not` — a PRESENCE TEST (RULED S440, truthiness Q1: "a
    // bare `@x` of type `T | not` IS a presence test … the compiler emits an
    // absence check, never JS truthiness"). `lower` wraps each in `IsSome`.
    export type Typing:struct = { exprs: ExprType[], at: int[], presence: int[] }
    // r8 — Rule C for NAMES: a declared type that did not resolve (E-TYPE-UNKNOWN
    // answers with a placeholder type) is never checked against. `params`: the
    // parameter nids whose type did not resolve; `fields`: the struct FieldDef
    // Sym ids whose type did not resolve. (A declaration field records it on
    // FieldInfo.trusted; a local's annotation and a return type are left unset.)
    export type Unresolved:struct = { params: int[], fields: int[] }
    // A local's WRITTEN type (`let a: T = …`), by its Sym (the binder's).
    export type LocalAnnot:struct = { sym: Sym, ty: Type }

    export type Tables:struct = {
        program: Sym,
        types: TypeInfo[],
        decls: DeclInfo[],
        fns: FnInfo[],
        handles: HandleInfo[],
        names: NameTable,
        values: ValueTable,
        effects: EffectTable,
        binds: BindTable,
        elems: ElemTable,
        attrs: AttrTable,
        fails: FailTable,       // s451 (Ue): the error-model facts (FailFact)
        annots: LocalAnnot[],
        unresolved: Unresolved,
        typing: Typing,
        novalidate: int[],      // s444 Phase B (RULED S442 (3)): the `<form>` elements the compiler adds `novalidate` to
        resets: ResetOnInfo[],  // s449: the program cells' accepted `reset-on=` rules (§6.8.4)
        gated: GateInfo[],      // s449: the `<form>` elements that bind a surfaced value (§55.7), and the values that gate each (§55.17.3)
        persists: PersistInfo[], // s451: the program cells' accepted `persist=` (§6.14)
        server: ServerFacts,    // s451 (U1a): route placement + the program's queries and databases (placePass)
        css: CssFacts,          // s469: the stylesheet the program's `#{}` blocks make (cssPass)
        consts: ConstInfo[],    // s472: the file-scope constants (constPass) — lowered once each into CoreProgram.consts
        taliases: TypeAlias[],  // s474 r1 (#1715 F7): each type a file imports under an alias — diagnostics name it by the alias there
    }

    // s474 r1 (#1715 review F7): `file` binds the user type `sym` (declared `orig` in
    // `from`) under the local name `local` (an aliased import).
    export type TypeAlias:struct = { file: string, local: string, sym: Sym, orig: string, from: string }

    // s451 (U1a) — what route inference and the SQL pass decided (placePass).
    // `servers`: the Sym ids of the functions placed on the SERVER (§12.2) —
    // lower makes each a Core ServerFn. `sqls`: one fact per `?{}` node (by
    // NodeId) — the database it runs on and what its SQL does (recorded once,
    // from the literal text — sql.scrml). `dbs`: the program's databases.
    // `places`: every function's placement (§12.1/§12.2 — design §2's table:
    // Ambient = no server trigger and no client access, emitted on every side
    // that reaches it; Client; Server; Split = a server trigger + a reactive
    // write, split across the boundary — refused until U1d).
    export type SqlInfo:struct = { nid: int, db: Sym, kind: SqlKind, reads: SqlTables, writes: SqlTables, columns: SqlColumns }
    export type PlaceK:enum = { Ambient, Client, Server, Split }

    // The SQL sigil for messages, in two pieces: impl#1 (which compiles this
    // file) rewrites a literal sigil inside a string literal into its own SQL
    // placeholder (parse.scrml sqlSigil).
    fn sqlSigil() -> string { return "?" + "{" }
    export type PlaceFact:struct = { sym: int, name: string, place: PlaceK }
    // s454 (U1b): `inherited` — the functions server-placed by inheritance
    // (§12.2 Trigger 5): their calls of server functions are made in place;
    // `plan` — the suspension plan (planPass) lower reads.
    export type ServerFacts:struct = { servers: int[], sqls: SqlInfo[], dbs: Db[], places: PlaceFact[], inherited: int[], plan: SuspendPlan, loads: DbLoad[], envelopes: Envelope[] }

    export fn noServerFacts() -> ServerFacts { return { servers: [], sqls: [], dbs: [], places: [], inherited: [], plan: noPlan(), loads: [], envelopes: [] } }

    // s454 (U1b): is a call made in function `caller` (-1: a handler / effect body)
    // a CLIENT call — the caller is not server-placed, by its own body or by
    // inheritance (§19.9.10 "placement is whole-program")?
    export fn remoteCaller(t: Tables, caller: int) -> boolean {
        if (caller < 0) return true
        for (const p of t.server.places) {
            if (p.sym == caller && p.place == PlaceK.Server) return false
        }
        return t.server.inherited.indexOf(caller) < 0
    }

    export fn sqlInfo(t: Tables, nid: int) -> SqlInfo | not {
        for (const s of t.server.sqls) {
            if (s.nid == nid) return s
        }
        return not
    }

    export fn isServerPlaced(t: Tables, s: Sym) -> boolean { return t.server.servers.indexOf(s.id) >= 0 }

    // s451 — one accepted `persist=` program cell (§6.14): field `sym` of the
    // program and its storage + key. `lower` sets Core Field.persist from it.
    export type PersistInfo:struct = { sym: Sym, persist: Persist }

    // s449 — a form whose composed subtree binds a value with a surface: its
    // submit sets `submitted` (§55.7). `values`: the bound values that carry
    // validators, in source order, named as §55.17.6 names them (a top-level
    // value `email`, a child field `signup.email`) — non-empty = GATED
    // (§55.17.3); empty = the form only records the submit.
    // `span` / `file`: the form's opener, where I-FORM-SUBMIT-GATED reports.
    export type GateInfo:struct = { form: int, values: string[], span: ASpan, file: string }

    // `infos` (s449): the non-fatal I- notes — SPEC §55.17.6 "As an `I-` code it
    // is non-fatal and reports in the warnings stream" — kept apart from
    // `diags`, so a program with a gated form still compiles clean.
    export type TypedProgram:struct = { files: FileAst[], tables: Tables, diags: Diag[], infos: Diag[] }

    // s449 — one `reset-on=[…]` rule of a program cell (§6.8.4), as the
    // analysis accepted it: field `target` of the program resets when any field
    // in `triggers` changes; `rank` is its depth in the static reset-on graph
    // (the order a chain is applied in). `lower` turns it into View.ResetOn.
    export type ResetOnInfo:struct = { target: int, triggers: int[], rank: int }

    // ---- the NodeId index ------------------------------------------------------
    // The position `at` holds for `nid` (-1: none).
    fn slotOf(at: int[], nid: int) -> int {
        if (nid < 0 || nid >= at.length) return -1
        return at[nid]
    }

    // The index over a key column: `at[nid]` = the position of the FIRST
    // entry for `nid`, -1 for none. Built in one pass into a FRESH local
    // array — with typingOf, the only array position writes in the
    // bootstrap: nothing
    // else holds `at` yet (a position write into a shared array would change
    // a value another holder already has — every AS the binder threads, a
    // discarded speculative one included, shares its arrays), and a write per
    // entry keeps the build O(nodes + entries) where appending is quadratic.
    fn nidIndex(nids: int[]) -> int[] {
        let top: int = -1
        for (const n of nids) {
            if (n > top) top = n
        }
        let at: int[] = minusOnes(top + 1)
        let i: int = nids.length - 1
        while (i >= 0) {
            // backwards: a node's first entry is written last, and stays
            if (nids[i] >= 0) at[nids[i]] = i
            i = i - 1
        }
        return at
    }

    // `n` × -1 (by doubling: O(n)).
    fn minusOnes(n: int) -> int[] {
        if (n <= 0) return []
        let out: int[] = [-1]
        while (out.length + out.length <= n) { out = out.concat(out) }
        return out.concat(minusOnes(n - out.length))
    }

    // The fact about node `nid` in each family (`not` when that family has
    // none — analyze reported an error on the node, or its fact is another
    // family's, or no consumer asks about it).
    export fn nameFact(t: NameTable, nid: int) -> NameFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn valueFact(t: ValueTable, nid: int) -> ValueFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn effectFact(t: EffectTable, nid: int) -> EffectFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn failFact(t: FailTable, nid: int) -> FailFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn bindFact(t: BindTable, nid: int) -> BindFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn elemFact(t: ElemTable, nid: int) -> ElemFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn attrFact(t: AttrTable, nid: int) -> AttrKind | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn declInfo(t: Tables, s: Sym) -> DeclInfo | not {
        for (const d of t.decls) {
            if (d.sym.id == s.id) return d
        }
        return not
    }

    // =========================================================================
    // Analyze state: the facts and diagnostics so far, and the Sym counter.
    // A family table grows by appending (`at` stays empty); `indexed` builds
    // every index once, when the binder is done.
    // =========================================================================
    type NodeFacts:struct = { names: NameTable, values: ValueTable, effects: EffectTable, binds: BindTable,
                              elems: ElemTable, attrs: AttrTable, fails: FailTable }
    // `bad`: the declared types that did not resolve (r8 — see Unresolved).
    // `effects` (s449): the reactive effects the binder accepted in an element
    // scope, in order, with their file — the input of the no-write pass
    // (effectPass), which runs once every function body is bound.
    type EffectSrc:struct = { w: AEffect, file: string }
    // `pend` (s452, dpa-066 M3): the binder's decisions that need the effect
    // summary — recorded where the binder meets them, decided by rulesPass.
    // s469 — `lifts`: every `lift` the binder resolved, by the tape it appends
    // to and its operand's type where known (a bound loop's binder type is the
    // join of its lifts', §49.6 rule 2; none at all is E-LOOP-007).
    type AS:struct = { facts: NodeFacts, diags: Diag[], nextSym: int, annots: LocalAnnot[], bad: Unresolved, effects: EffectSrc[], pend: Pending[], lifts: LiftSeen[] }
    type LiftSeen:struct = { into: int, ty: Type | not }
    type RSym:struct = { s: Sym, st: AS }

    fn noFacts() -> NodeFacts {
        return { names: { facts: [], nids: [], at: [] }, values: { facts: [], nids: [], at: [] },
                 effects: { facts: [], nids: [], at: [] }, binds: { facts: [], nids: [], at: [] },
                 elems: { facts: [], nids: [], at: [] }, attrs: { facts: [], nids: [], at: [] },
                 fails: { facts: [], nids: [], at: [] } }
    }

    fn indexed(fs: NodeFacts) -> NodeFacts {
        return {
            names: { facts: fs.names.facts, nids: fs.names.nids, at: nidIndex(fs.names.nids) },
            values: { facts: fs.values.facts, nids: fs.values.nids, at: nidIndex(fs.values.nids) },
            effects: { facts: fs.effects.facts, nids: fs.effects.nids, at: nidIndex(fs.effects.nids) },
            binds: { facts: fs.binds.facts, nids: fs.binds.nids, at: nidIndex(fs.binds.nids) },
            elems: { facts: fs.elems.facts, nids: fs.elems.nids, at: nidIndex(fs.elems.nids) },
            attrs: { facts: fs.attrs.facts, nids: fs.attrs.nids, at: nidIndex(fs.attrs.nids) },
            fails: { facts: fs.fails.facts, nids: fs.fails.nids, at: nidIndex(fs.fails.nids) },
        }
    }

    // s473 (p5 hole 4, g-boot-reserved-prefix-unchecked-s473) — §47.1.1: "A
    // user-authored scrml program SHALL NOT **declare** a binding whose name begins
    // with `_scrml_`" (S439 #7) and "SHALL NOT **declare** or **reference** a name
    // that begins with `__scrml_`" (S457): E-NAME-COLLIDES-RESERVED-PREFIX.
    // "Standard-library source is exempt by path" (S440 #9). Called at each binder
    // site that mints a USER-written name (a type, a declaration and its fields, a
    // function and its parameters, a local, a pattern / loop / `given` / `<each>` /
    // `as=` binder, a lambda parameter, a file-scope constant), and at every bare
    // name / `@name` reference (resolveName / resolveAt — "declares or references",
    // §34). Member names and object-literal keys are not inspected (§34: "object-
    // literal keys in parsed logic … are not inspected"; a member name is not ruled
    // either way for the bootstrap).
    fn reservedName(st: AS, file: string, span: ASpan, name: string) -> AS {
        if (!(name.indexOf("_scrml_") == 0 || name.indexOf("__scrml_") == 0)) return st
        if (isStdlibPath(file)) return st
        return addDiag(st, file, span, "E-NAME-COLLIDES-RESERVED-PREFIX", "`" + name + "` begins with a reserved prefix — `_scrml_` and `__scrml_` name the compiler's and runtime's own identifiers, and a program SHALL NOT declare or reference one (§47.1.1; S439 #7, S440 #9, S457); rename it")
    }

    fn mint(st: AS, hint: string) -> RSym {
        return { s: mkSym(st.nextSym, hint), st: { facts: st.facts, diags: st.diags, nextSym: st.nextSym + 1, annots: st.annots, bad: st.bad, effects: st.effects, pend: st.pend, lifts: st.lifts } }
    }

    fn withFacts(st: AS, fs: NodeFacts) -> AS {
        return { facts: fs, diags: st.diags, nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects, pend: st.pend, lifts: st.lifts }
    }

    fn addName(st: AS, nid: int, f: NameFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: NameTable = { facts: fs.names.facts.concat([f]), nids: fs.names.nids.concat([nid]), at: [] }
        return withFacts(st, { names: t, values: fs.values, effects: fs.effects, binds: fs.binds, elems: fs.elems, attrs: fs.attrs, fails: fs.fails })
    }

    fn addValue(st: AS, nid: int, f: ValueFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: ValueTable = { facts: fs.values.facts.concat([f]), nids: fs.values.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: t, effects: fs.effects, binds: fs.binds, elems: fs.elems, attrs: fs.attrs, fails: fs.fails })
    }

    fn addEffect(st: AS, nid: int, f: EffectFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: EffectTable = { facts: fs.effects.facts.concat([f]), nids: fs.effects.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: t, binds: fs.binds, elems: fs.elems, attrs: fs.attrs, fails: fs.fails })
    }

    fn addBind(st: AS, nid: int, f: BindFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: BindTable = { facts: fs.binds.facts.concat([f]), nids: fs.binds.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: fs.effects, binds: t, elems: fs.elems, attrs: fs.attrs, fails: fs.fails })
    }

    fn addElem(st: AS, nid: int, f: ElemFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: ElemTable = { facts: fs.elems.facts.concat([f]), nids: fs.elems.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: fs.effects, binds: fs.binds, elems: t, attrs: fs.attrs, fails: fs.fails })
    }

    fn addAttr(st: AS, nid: int, k: AttrKind) -> AS {
        const fs: NodeFacts = st.facts
        const t: AttrTable = { facts: fs.attrs.facts.concat([k]), nids: fs.attrs.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: fs.effects, binds: fs.binds, elems: fs.elems, attrs: t, fails: fs.fails })
    }
    // s451 (Ue)
    fn addFail(st: AS, nid: int, f: FailFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: FailTable = { facts: fs.fails.facts.concat([f]), nids: fs.fails.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: fs.effects, binds: fs.binds, elems: fs.elems, attrs: fs.attrs, fails: t })
    }

    fn addDiag(st: AS, file: string, span: ASpan, code: string, msg: string) -> AS {
        const d: Diag = newDiag(code, msg, file, span)
        return withDiag(st, d)
    }

    fn withDiag(st: AS, d: Diag) -> AS {
        return { facts: st.facts, diags: st.diags.concat([d]), nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects, pend: st.pend, lifts: st.lifts }
    }

    // s452 (dpa-066 M3): a decision for rulesPass, at the place in the
    // diagnostic list where the binder used to make it.
    fn addPending(st: AS, r: PendRule) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects,
                 pend: st.pend.concat([{ at: st.diags.length, rule: r }]), lifts: st.lifts }
    }

    fn addAnnot(st: AS, s: Sym, ty: Type) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots.concat([{ sym: s, ty: ty }]), bad: st.bad, effects: st.effects, pend: st.pend, lifts: st.lifts }
    }

    fn addLift(st: AS, into: Sym, ty: Type | not) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects, pend: st.pend, lifts: st.lifts.concat([{ into: into.id, ty: ty }]) }
    }

    fn badParam(st: AS, nid: int) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots,
                 bad: { params: st.bad.params.concat([nid]), fields: st.bad.fields }, effects: st.effects, pend: st.pend, lifts: st.lifts }
    }

    fn badField(st: AS, id: int) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots,
                 bad: { params: st.bad.params, fields: st.bad.fields.concat([id]) }, effects: st.effects, pend: st.pend, lifts: st.lifts }
    }

    // s449: record an effect the binder accepted (the no-write pass's input).
    fn addEffectSrc(st: AS, w: AEffect, file: string) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots, bad: st.bad,
                 effects: st.effects.concat([{ w: w, file: file }]), pend: st.pend, lifts: st.lifts }
    }

    // =========================================================================
    // Phase A — the program's shape: types, declarations, functions, fields,
    // handles. (Everything a body may name, before any body is resolved.)
    // =========================================================================
    // A declaration together with its syntax (for Phase B).
    type DeclSrc:struct = { info: DeclInfo, file: string, isProgram: boolean, d: ADecl | not, p: AProgram | not }
    type FnSrc:struct = { info: FnInfo, f: AFn }

    type Globals:struct = {
        program: Sym,
        entry: string,
        te: TypeEnv,
        types: TypeInfo[],
        decls: DeclSrc[],
        fns: FnSrc[],
        handles: HandleInfo[],
        files: FileAst[],
        errorSym: Sym,          // s451 (Ue): the built-in `Error` enum (§19.4.2 — a bare `!`'s error type)
        sqlErrorSym: Sym,       // s451 (Ue): the built-in `SqlError` enum (§19.8.1 — every query's error type)
        sceSym: Sym,            // s454 (U1b): the built-in `ServerCallError` enum (§19.9.10)
        voids: int[],           // s469 (#1471 r3): the VOID functions (voidFns) — a call of one has type `void`
        hostSites: HostSite[],  // s472 (boot-math-port): every wrapper-shaped host call, judged (hostWrappers)
        consts: ConstInfo[],    // s472: the file-scope constants, in link order then source order (constPass)
    }

    type RTypeInfos:struct = { ts: TypeInfo[], st: AS }

    // ---- types ---------------------------------------------------------------
    // A1: mint every type's Sym (and its variants' / fields' Syms). The field
    // TYPES are resolved in A2, once every type name is known.
    type TypeStub:struct = { nid: int, name: string, file: string, exported: boolean, sym: Sym,
                             isEnum: boolean, members: Sym[], src: ATypeDecl }

    type RStubs:struct = { stubs: TypeStub[], st: AS }

    fn typeStubs(files: FileAst[], st0: AS) -> RStubs {
        let st: AS = st0
        let out: TypeStub[] = []
        for (const f of files) {
            for (const td of typeItems(f.items)) {
                const rs: RSym = mint(reservedName(st, f.path, td.span, td.name), td.name)
                st = rs.st
                let members: Sym[] = []
                let isEnum = false
                const body: ATypeBody = td.body
                const names: string[] = typeMemberNames(body)
                isEnum = isEnumBody(body)
                for (const n of names) {
                    const rm: RSym = mint(st, n)
                    st = rm.st
                    members = members.concat([rm.s])
                }
                out = out.concat([{ nid: td.nid, name: td.name, file: f.path, exported: td.exported, sym: rs.s,
                                    isEnum: isEnum, members: members, src: td }])
            }
        }
        // s451 (Ue): the built-in error enums, AFTER every user type (a user
        // `Error` is found first by name — it shadows the built-in, whose Sym
        // the bare `!` default still names; a user `SqlError` is refused,
        // builtinRedeclares).
        for (const bd of builtinTypeDecls()) {
            const rb: RSym = mint(st, bd.name)
            st = rb.st
            let bms: Sym[] = []
            for (const n of typeMemberNames(bd.body)) {
                const rm2: RSym = mint(st, n)
                st = rm2.st
                bms = bms.concat([rm2.s])
            }
            out = out.concat([{ nid: -1, name: bd.name, file: builtinFile(), exported: false, sym: rb.s,
                                isEnum: true, members: bms, src: bd }])
        }
        // s473-host-allowlist-b (DRAFT §21.3.3 rule 8.1, ruling Q2 — "WebIDL interface names
        // are built-in scrml types"): each Appendix H interface is a built-in host type (a
        // HostDef, no members). Its Sym is FIXED (ifaceSym, a negative id), not minted, so
        // adding the surface shifts no other Sym of any program.
        let k = 0
        for (const f of surfaceInterfaces()) {
            const td: ATypeDecl = { nid: -1, span: mkSpan(0, 0), exported: false, name: f.name, body: ATypeBody.HostBody }
            out = out.concat([{ nid: -1, name: f.name, file: builtinFile(), exported: false, sym: mkSym(-2000 - k, f.name),
                                isEnum: false, members: [], src: td }])
            k = k + 1
        }
        return { stubs: out, st: st }
    }

    // s451 (Ue) — the built-in error enums, written as the SPEC writes them:
    // §19.4.2 "`!` without `-> ErrorType` uses a built-in default error enum:
    // `Error`, which has a single variant `Error::Generic(message: string)`";
    // §19.8.1 `type SqlError:enum = { QueryFailed(message: string)
    // ConstraintViolation(field: string) ConnectionLost }` (their `renders`
    // clauses display a variant inside an `<errorBoundary>` / `<render of=>`,
    // neither of which is in the bootstrap). §8.9.4's `BatchPrepareFailed`
    // arrives with batch coalescing (not in the bootstrap — §19.8.4 "The
    // compiler MAY add additional variants").
    export fn builtinFile() -> string { return "scrml:builtin" }

    // s454 (U1b) — §19.9.10 "The error type — `ServerCallError` (S454)": "The
    // three kinds are carried by one built-in enum, **`ServerCallError`**. It is
    // provided by the compiler, as `SqlError` is (§19.8.1): the developer SHALL
    // NOT redefine it, it SHALL have at least the four variants below" —
    // `Unreachable`, `Refused(status: int)`, `ServerFault(status: int)`,
    // `Malformed(reason: string)`. Each variant's `renders` clause (§19.2) is
    // not modelled: the bootstrap's AST carries no `renders` on a variant (as for
    // `SqlError`), and the one route that displays one — the `<formFor>` submit
    // dispatch (§19.6.6) into an `<errorBoundary>` — is not in the bootstrap.
    export fn serverCallErrorName() -> string { return "ServerCallError" }

    fn builtinTypeDecls() -> ATypeDecl[] {
        return [
            builtinEnum("Error", [builtinVariant("Generic", ["message"])]),
            builtinEnum("SqlError", [builtinVariant("QueryFailed", ["message"]), builtinVariant("ConstraintViolation", ["field"]), builtinVariant("ConnectionLost", [])]),
            builtinEnum(serverCallErrorName(), [builtinTyped("Unreachable", "", ""), builtinTyped("Refused", "status", "int"),
                                                builtinTyped("ServerFault", "status", "int"), builtinTyped("Malformed", "reason", "string")]),
        ]
    }

    // A built-in variant with at most one field, of the named type ("" — none).
    fn builtinTyped(name: string, field: string, ty: string) -> AVariant {
        let fs: ATypeField[] = []
        if (field != "") {
            const at: AType = { nid: -1, span: mkSpan(0, 0), k: ATypeK.TName(ty) }
            fs = [{ nid: -1, span: mkSpan(0, 0), isLet: false, name: field, ty: at }]
        }
        return { nid: -1, span: mkSpan(0, 0), name: name, fields: fs }
    }

    fn builtinEnum(name: string, vs: AVariant[]) -> ATypeDecl {
        return { nid: -1, span: mkSpan(0, 0), exported: false, name: name, body: ATypeBody.EnumBody(vs) }
    }

    fn builtinVariant(name: string, fields: string[]) -> AVariant {
        let fs: ATypeField[] = []
        for (const f of fields) {
            const ty: AType = { nid: -1, span: mkSpan(0, 0), k: ATypeK.TName("string") }
            fs = fs.concat([{ nid: -1, span: mkSpan(0, 0), isLet: false, name: f, ty: ty }])
        }
        return { nid: -1, span: mkSpan(0, 0), name: name, fields: fs }
    }

    fn builtinSym(stubs: TypeStub[], name: string) -> Sym {
        for (const s of stubs) {
            if (s.file == builtinFile() && s.name == name) return s.sym
        }
        return mkSym(-1, name)
    }

    fn isEnumBody(b: ATypeBody) -> boolean {
        return match b {
            .EnumBody(variants: vs) :> true
            .StructBody(fields: fs) :> false
            .HostBody :> false
        }
    }

    fn typeMemberNames(b: ATypeBody) -> string[] {
        return match b {
            .EnumBody(variants: vs) :> variantNames(vs)
            .StructBody(fields: fs) :> typeFieldNames(fs)
            .HostBody :> []
        }
    }

    fn variantNames(vs: AVariant[]) -> string[] {
        let out: string[] = []
        for (const v of vs) { out = out.concat([v.name]) }
        return out
    }

    fn typeFieldNames(fs: ATypeField[]) -> string[] {
        let out: string[] = []
        for (const f of fs) { out = out.concat([f.name]) }
        return out
    }

    // Every TypeItem of a file, the program's included.
    fn typeItems(items: AItem[]) -> ATypeDecl[] {
        let out: ATypeDecl[] = []
        for (const it of items) { if (!isLaterProgram(items, it)) out = out.concat(typeItemOf(it)) }   // s451: a second top-level program is E-PROGRAM-002, not read
        return out
    }

    fn typeItemOf(it: AItem) -> ATypeDecl[] {
        const k: AItemK = it.k
        return match k {
            .TypeItem(t: t) :> [t]
            .ProgramItem(p: p) :> typeItems(p.items)
            .ConstItem(c: c) :> []
            .ImportItem(i: i) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
            .MarkupItem(n: n) :> []
        }
    }

    // ---- s472: FILE SCOPE — which declaration a name denotes in each file ------
    // Before s472 the bootstrap linked every file into ONE namespace: a use
    // resolved by bare name across all linked files, so any function, type or
    // declaration of any file — exported-but-not-imported, or not exported at
    // all — was usable without importing it (a `scrml:` module's internals
    // included), and two files could not each keep a private name.
    // §21.3: "Named imports … from `.scrml` files SHALL be resolved by the
    // compiler against the exporting file's export list." A name is in scope in
    // a file when the file DECLARES it (a type, a function, a user declaration),
    // or an import of the file brings it from a file that EXPORTS it (an import
    // of a name its target does not export is E-IMPORT-004, checkImports, and
    // brings nothing). Every by-name lookup of a type / function / declaration
    // goes through `scopeFrom`: it answers WHICH FILE's declaration the name
    // denotes, and the lookup takes the one of that (file, name) — never the
    // first of that name (no first-match mis-link). A name not in scope in a
    // file resolves to nothing there (fail closed: E-SCOPE-001 / E-TYPE-UNKNOWN
    // at the use, saying where the name IS declared — elsewhereNote).
    // `own`: every declared name of every linked file (built-in types excluded).
    // s472 r1 (F2): a name is scoped BY KIND — a type, a function and a user
    // declaration of one name are three entries. An import brings in only the
    // EXPORTED declaration(s) of the name: a private declaration of another kind
    // that shares the name stays private (before r1, importing an exported type
    // `Tag` also brought the file's private `fn Tag` into scope).
    // s472: KConst — a file-scope constant (§7.6; `[export] const NAME = …` in a `${ }` block).
    type NameKind:enum = { KType, KFn, KDecl, KConst }
    type OwnName:struct = { name: string, kind: NameKind, file: string, exported: boolean }
    // s474 (import alias): `name` is the LOCAL name (what the file writes);
    // `orig` the name the declaration has in `from` — they differ only for an
    // aliased import (`import { Card as Card2 }`: name `Card2`, orig `Card`).
    // A lookup takes the declaration of (`from`, `orig`), so the declaration —
    // and its per-file scope key — stay the DECLARING file's.
    type ScopeName:struct = { name: string, kind: NameKind, from: string, orig: string }
    type FileScope:struct = { file: string, names: ScopeName[] }
    type Linkage:struct = { own: OwnName[], scopes: FileScope[] }

    // The file whose declaration of KIND `k` named `name` is in scope in
    // `file`; "" when none is.
    fn scopeFrom(lk: Linkage, file: string, k: NameKind, name: string) -> string {
        const h: ScopeName | not = scopeHit(lk, file, k, name)
        if (h is not) return ""
        return h.from
    }

    // s474 — the name the declaration that `name` denotes in `file` has where it
    // is DECLARED (`name` itself unless an import aliases it); "" when none is.
    fn scopeOrig(lk: Linkage, file: string, k: NameKind, name: string) -> string {
        const h: ScopeName | not = scopeHit(lk, file, k, name)
        if (h is not) return ""
        return h.orig
    }

    // The scope entry of KIND `k` that the local name `name` denotes in `file`:
    // the first one (see linkage), else not.
    fn scopeHit(lk: Linkage, file: string, k: NameKind, name: string) -> ScopeName | not {
        for (const fs of lk.scopes) {
            if (fs.file == file) {
                for (const n of fs.names) {
                    if (n.name == name && n.kind == k) return n
                }
                return not
            }
        }
        return not
    }

    // s474 — every LOCAL name under which `file` binds the `k` declaration
    // `declName` of `declFile`: its own name, an alias, or both (`import { Card,
    // Card as C2 }`); empty when the declaration is not in scope there. Only a
    // name that DENOTES it counts (the first entry of that name, as scopeHit).
    fn boundAs(lk: Linkage, file: string, k: NameKind, declName: string, declFile: string) -> string[] {
        let out: string[] = []
        for (const fs of lk.scopes) {
            if (fs.file == file) {
                for (const n of fs.names) {
                    if (n.kind == k && n.from == declFile && n.orig == declName && out.indexOf(n.name) < 0) {
                        const h: ScopeName | not = scopeHit(lk, file, k, n.name)
                        if (h is given) {
                            if (h.from == declFile && h.orig == declName) out = out.concat([n.name])
                        }
                    }
                }
                return out
            }
        }
        return out
    }

    // s474 r1 (#1715 F7): every user type a file imports under an alias.
    fn typeAliases(lk: Linkage, types: TypeInfo[]) -> TypeAlias[] {
        let out: TypeAlias[] = []
        for (const fs of lk.scopes) {
            for (const n of fs.names) {
                if (n.kind == NameKind.KType && n.name != n.orig) {
                    for (const ti of types) {
                        if (ti.file == n.from && ti.name == n.orig) {
                            out = out.concat([{ file: fs.file, local: n.name, sym: typeDefSym(ti.def), orig: n.orig, from: n.from }])
                        }
                    }
                }
            }
        }
        return out
    }

    // Is the `k` declaration `name` of `declFile` in scope in `file` — under its
    // own name or (s474) an alias?
    fn inScope(lk: Linkage, file: string, k: NameKind, name: string, declFile: string) -> boolean {
        return boundAs(lk, file, k, name, declFile).length > 0
    }

    fn exportsName(own: OwnName[], file: string, name: string) -> boolean {
        for (const o of own) {
            if (o.file == file && o.name == name && o.exported) return true
        }
        return false
    }

    // Every declared name of every file: its types, its functions (a
    // `<program>`'s included — typeItems / fnItems), its user declarations
    // (the decl stubs — the program itself is not a name).
    // s473 — a db cell's LOAD function is named `@name` (parse readDbCell): a
    // spelling no identifier has, so no program code can name or call it.
    fn isLoadName(n: string) -> boolean { return n.substring(0, 1) == "@" }

    fn ownNames(files: FileAst[], stubs: TypeStub[], ds: DeclStub[]) -> OwnName[] {
        let out: OwnName[] = []
        for (const s of stubs) {
            if (s.file != builtinFile()) out = out.concat([{ name: s.name, kind: NameKind.KType, file: s.file, exported: s.exported }])
        }
        for (const d of ds) {
            const ad: ADecl | not = d.d
            if (ad is given && !d.isProgram) out = out.concat([{ name: ad.name, kind: NameKind.KDecl, file: d.file, exported: ad.exported }])
        }
        for (const f of files) {
            // s473: a db cell's load (`@name`, parse readDbCell) is in no file scope — no program code names it
            for (const af of fnItems(f.items)) { if (!isLoadName(af.name)) out = out.concat([{ name: af.name, kind: NameKind.KFn, file: f.path, exported: af.exported }]) }
            for (const ac of constItems(f.items)) { out = out.concat([{ name: ac.name, kind: NameKind.KConst, file: f.path, exported: ac.exported }]) }
        }
        return out
    }

    type RLinkage:struct = { lk: Linkage, st: AS }

    // Each file's scope: its own names, then each name its imports bring, in
    // source order — one entry per EXPORTED declaration of the name in the
    // target (s472 r1, F2). §41.7: "When an `import` statement imports a name
    // that is already in scope from another `import` statement in the same
    // file, the later import WINS and a W-IMPORT-001 warning is emitted." A
    // name the file declares AND imports is bound twice in file scope — §7.6:
    // "Re-declaring a name … when that name was already declared at file scope
    // SHALL be a compile error (E-SCOPE-010: duplicate binding in file scope)";
    // the file's own declaration stays in scope (the error stops the build).
    fn linkage(files: FileAst[], own: OwnName[], st0: AS) -> RLinkage {
        let st: AS = st0
        const paths: string[] = filePaths(files)
        let scopes: FileScope[] = []
        for (const f of files) {
            let names: ScopeName[] = []
            let mine: string[] = []
            for (const o of own) {
                if (o.file == f.path) {
                    names = names.concat([{ name: o.name, kind: o.kind, from: f.path, orig: o.name }])
                    if (mine.indexOf(o.name) < 0) mine = mine.concat([o.name])
                }
            }
            // s474 (import alias): the rules below are about the LOCAL name an import
            // binds (`n.name` — the alias when there is one); the export it binds is
            // `n.orig` of `target`. `importedOrig[i]` / `importedFrom[i]`: the
            // declaration the i-th local name already binds.
            let imported: string[] = []
            let importedFrom: string[] = []
            let importedOrig: string[] = []
            for (const imp of importsOfItems(f.items)) {
                const target: string = importTarget(f.path, imp.from, paths)
                for (const n of imp.names) {
                    // s474 r1 (#1715 review F5): an import's LOCAL name is a binding of this file —
                    // a reserved `_scrml_` / `__scrml_` one is refused at the import (§47.1.1),
                    // as a declaration's is, not only at a use
                    if (n.name != n.orig) st = reservedName(st, f.path, n.span, n.name)
                    if (target != "" && exportsName(own, target, n.orig)) {
                        if (mine.indexOf(n.name) >= 0) {
                            st = addDiag(st, f.path, n.span, "E-SCOPE-010", "`" + n.name + "` is imported from `" + imp.from + "` and also declared in this file — a name is bound once in file scope (duplicate binding in file scope, §7.6); rename one, drop the import, or import it under another name (`import { " + n.orig + " as " + n.orig + "2 } from \"" + imp.from + "\"`)")
                        } else {
                            const at: int = imported.indexOf(n.name)
                            if (at >= 0) {
                                const earlier: string = importedFrom[at]
                                // s474 (door 3): two USER files may each export a name now; importing
                                // both into ONE file binds it twice in that file's scope — refused
                                // here, at the later import (was: refused at the second exporter, S473).
                                // s474 (alias): so are two DIFFERENT exports of one file bound to one
                                // local name (`{ a as x, b as x }`); the same export twice stays §41.7.
                                // s474 r1 (review F2, PA ruling — row-C amendment "one local name cannot
                                // bind two declarations"): UNIFORM — user + user, user + stdlib,
                                // stdlib + stdlib and within one import list alike (was: a stdlib side
                                // fell back to the §41.7 later-wins W-IMPORT-001). W-IMPORT-001 is left
                                // only for the SAME declaration imported twice.
                                const other: boolean = earlier != target || importedOrig[at] != n.orig
                                if (other) {
                                    // s474 r1 (review F3): no cascade. The build already fails here; the
                                    // EARLIER import keeps the name (scopeFrom takes the first entry of a
                                    // kind), and the refused one's entries follow it, so a use of the name
                                    // of EITHER kind resolves — never also E-SCOPE-001 ("this file does not
                                    // import it") for a name this file does import
                                    st = addDiag(st, f.path, n.span, "E-SCOPE-010", "`" + n.name + "` is already imported into this file (`" + importedOrig[at] + "` from `" + earlier + "`), and this import binds it to another declaration (`" + n.orig + "` from `" + target + "`) — one local name cannot bind two declarations, whichever files (user or stdlib) export them (duplicate binding in file scope, §7.6; ruled S474); import one of them under another name (`import { " + n.orig + " as " + n.orig + "2 } from \"" + imp.from + "\"`), or drop one import")
                                    names = names.concat(exportedEntries(own, target, n.orig, n.name))
                                } else {
                                    st = addDiag(st, f.path, n.span, "W-IMPORT-001", "`" + n.name + "` is already imported by an earlier import in this file — the same declaration imported twice; this later import wins (§41.7); remove the duplicate")
                                    names = unbound(names, n.name).concat(exportedEntries(own, target, n.orig, n.name))
                                }
                            } else {
                                imported = imported.concat([n.name])
                                importedFrom = importedFrom.concat([target])
                                importedOrig = importedOrig.concat([n.orig])
                                names = names.concat(exportedEntries(own, target, n.orig, n.name))
                            }
                        }
                    }
                }
            }
            scopes = scopes.concat([{ file: f.path, names: names }])
        }
        return { lk: { own: own, scopes: scopes }, st: st }
    }

    // The scope entries an import of `name` from `target` brings: one per
    // EXPORTED declaration of that name there (never a private one).
    // s474: bound under the LOCAL name `local` (an alias, or `name` itself).
    fn exportedEntries(own: OwnName[], target: string, name: string, local: string) -> ScopeName[] {
        let out: ScopeName[] = []
        for (const o of own) {
            if (o.file == target && o.name == name && o.exported) out = out.concat([{ name: local, kind: o.kind, from: target, orig: name }])
        }
        return out
    }

    fn unbound(names: ScopeName[], name: string) -> ScopeName[] {
        let out: ScopeName[] = []
        for (const n of names) {
            if (n.name != name) out = out.concat([n])
        }
        return out
    }

    // Why the `k` declaration `name` is not in scope in `file` when ANOTHER
    // linked file declares one — appended to the use's diagnostic; "" when no
    // other file declares it. `alsoDecl`: a type position, where a user
    // declaration names a type too.
    fn elsewhereNote(lk: Linkage, file: string, k: NameKind, alsoDecl: boolean, name: string) -> string {
        for (const o of lk.own) {
            if (o.name == name && o.file != file && o.exported && kindFits(o.kind, k, alsoDecl)) {
                // s474: imported here under an alias — the alias is the name in this file
                const als: string[] = boundAs(lk, file, o.kind, name, o.file)
                if (als.length > 0) return " in this file — it is imported from `" + o.file + "` as `" + als[0] + "`, and that is its name here (`import { " + name + " as " + als[0] + " }` binds `" + als[0] + "` only, §21.3)"
                return " in this file — `" + o.file + "` exports it, but this file does not import it: write `import { " + name + " } from …` (§21.3)"
            }
        }
        for (const o2 of lk.own) {
            if (o2.name == name && o2.file != file && kindFits(o2.kind, k, alsoDecl)) {
                return " in this file — `" + o2.file + "` declares it but does not export it, so it is private to that file (§21.3)"
            }
        }
        return ""
    }

    fn kindFits(have: NameKind, k: NameKind, alsoDecl: boolean) -> boolean {
        return have == k || (alsoDecl && have == NameKind.KDecl)
    }

    // ---- resolving a type expression ------------------------------------------
    // s472: `link` — the file scopes (above); `declFiles` — each declaration
    // name's defining file (parallel to `declNames` / `declSyms`). `file` — the
    // file the type expression is written in: a name resolves in ITS scope.
    type TypeEnv:struct = { stubs: TypeStub[], declNames: string[], declSyms: Sym[], declFiles: string[], link: Linkage, file: string }

    fn teAt(te: TypeEnv, file: string) -> TypeEnv {
        return { stubs: te.stubs, declNames: te.declNames, declSyms: te.declSyms, declFiles: te.declFiles, link: te.link, file: file }
    }
    // `unresolved`: the TYPE itself did not resolve — a name in it is unknown
    // (E-TYPE-UNKNOWN; `t` then holds a placeholder). A diagnostic about the
    // type's GRANTS (E-GRANT-UNKNOWN) leaves the type resolved: the element type
    // is real and is checked against (S444 review, fail-closed).
    type RType:struct = { t: Type, st: AS, unresolved: boolean }

    // s472: the type `name` denotes in `te.file` — the one its scope names
    // (declared there, or imported), else a built-in of that name (`Error`,
    // `SqlError`, `ServerCallError`: in scope everywhere, shadowed by a user
    // type in scope).
    fn stubNamed(te: TypeEnv, name: string) -> TypeStub | not {
        const from: string = scopeFrom(te.link, te.file, NameKind.KType, name)
        const orig: string = scopeOrig(te.link, te.file, NameKind.KType, name)   // s474: an alias names its export
        let builtin: TypeStub | not = not
        for (const s of te.stubs) {
            if (from != "" && s.file == from && s.name == orig) return s
            if (s.name == name && s.file == builtinFile()) builtin = s
        }
        return builtin
    }

    // s472: the user declaration `name` denotes in `te.file` as a type, else not.
    fn declTypeNamed(te: TypeEnv, name: string) -> Sym | not {
        const from: string = scopeFrom(te.link, te.file, NameKind.KDecl, name)
        if (from == "") return not
        const orig: string = scopeOrig(te.link, te.file, NameKind.KDecl, name)
        let i = 0
        while (i < te.declNames.length) {
            if (te.declNames[i] == orig && te.declFiles[i] == from) return te.declSyms[i]
            i = i + 1
        }
        return not
    }

    fn resolveType(te: TypeEnv, at: AType, st: AS) -> RType {
        const k: ATypeK = at.k
        return match k {
            .TName(name: n) :> resolveTypeName(te, at, n, st)
            .TSeq(elem: e, grants: gs) :> resolveSeqType(te, at, e, gs, st)
            .TMaybe(inner: i) :> resolveMaybe(te, i, st)
        }
    }

    fn resolveMaybe(te: TypeEnv, inner: AType, st: AS) -> RType {
        const r: RType = resolveType(te, inner, st)
        return { t: Type.Maybe(r.t), st: r.st, unresolved: r.unresolved }
    }

    // s473 fix round 2 — `n` names no user type in `te.file`'s scope (declared
    // there or imported), so it means the built-in of that name
    // (resolveTypeName's order: a user type wins).
    fn isBuiltinTypeName(te: TypeEnv, n: string) -> boolean {
        const s: TypeStub | not = stubNamed(te, n)
        if (s is given) return s.file == builtinFile()
        const ds: Sym | not = declTypeNamed(te, n)
        return ds is not
    }

    fn isNamedShape(n: string) -> boolean {
        return n == "email" || n == "url" || n == "uuid" || n == "phone" || n == "date" || n == "time" || n == "color"
    }

    fn resolveTypeName(te: TypeEnv, at: AType, n: string, st: AS) -> RType {
        // s469 — `integer` / `boolean` are `int` / `bool` in type position (§14.13.6; the §63 window,
        // W-TYPE-NAME-DEPRECATED, is not open yet — so no warning). Never namespaces (resolvePrimParse).
        if (n == "int" || n == "integer") return { t: Type.Int, st: st, unresolved: false }
        if (n == "number") return { t: Type.Num, st: st, unresolved: false }
        if (n == "string") return { t: Type.Str, st: st, unresolved: false }
        if (n == "bool" || n == "boolean") return { t: Type.Bool, st: st, unresolved: false }
        const s: TypeStub | not = stubNamed(te, n)
        if (s is given) return { t: Type.Named(s.sym), st: st, unresolved: false }
        const ds: Sym | not = declTypeNamed(te, n)
        if (ds is given) return { t: Type.Named(ds), st: st, unresolved: false }
        // s469 (review L3): `asIs` is a built-in type (§14.1.2) the bootstrap does not have — refused by name, not "unknown"
        if (n == "asIs") return { t: Type.Str, st: addDiag(st, te.file, at.span, "E-BOOTSTRAP-UNSUPPORTED", "the built-in type `asIs` (§14.1.2) is not in the bootstrap — its type system has no unresolved-value type; give the value a declared type"), unresolved: true }
        // s473 (B9) — `timestamp` is a "registered string-shaped primitive"
        // (§66.3's canonical-empty list; §53's union-member rule: "tested as
        // strings"), and the bootstrap types it as `string`. That is NOT all of
        // it: §66.3 gives a bare `timestamp` cell no canonical empty — it starts
        // as `not` with an implicit `(not to T)` lifecycle, where `string`
        // starts as `""` — so a `timestamp` cell with no value is refused
        // (stampNoDefaultDiag). With a value, as a parameter or as a field, it is
        // a string. (SPEC conflict: §51.11.4 calls a timestamp a Number —
        // g-spec-timestamp-number-vs-string-s473.) (A user type of that name, in
        // scope, wins — above.)
        if (n == "timestamp") return { t: Type.Str, st: st, unresolved: false }
        // s473 (B9) — the §53 named-shape vocabulary (§14's canonical rule: "the
        // named-shape vocabulary `email`/`url`/`uuid`/`phone`/`date`/`time`/
        // `color`") is built in — not unknown — but a named shape is a string
        // with a format predicate the bootstrap does not check: refused by name.
        if (isNamedShape(n)) return { t: Type.Str, st: addDiag(st, te.file, at.span, "E-BOOTSTRAP-UNSUPPORTED", "the named-shape type `" + n + "` (§53 — a string with a built-in format predicate) is not in the bootstrap — it checks no named shape; declare the value a `string`"), unresolved: true }
        return { t: Type.Str, st: addDiag(st, te.file, at.span, "E-TYPE-UNKNOWN", "unknown type `" + n + "`" + elsewhereNote(te.link, te.file, NameKind.KType, true, n)), unresolved: true }
    }

    // ---- the grant words (the ONE place a grant SPELLING is read) -------------
    // RULED S442 (user-voice "the tape 'where it changes' axis splits grow from
    // shrink; `anywhere` covers end/front", and "spellings are fine" for the six
    // tokens): grow and shrink are SEPARATE grants at each place —
    //   end:      `append` (grow) · `pop` (shrink)
    //   front:    `prepend` (grow) · `shift` (shrink)
    //   anywhere: `insert` (grow) · `remove` (shrink) — and anywhere COVERS end
    //             and front (an insert grant admits appends and prepends, a
    //             remove grant pops and shifts).
    // The retired bare place tokens `end` / `front` / `anywhere` are refused,
    // naming both halves (never guessing which was meant).
    // RULED S469 (O10 complete; user-voice "I dont like writable, I think I
    // prefer write" … "Keep free and replace (Rec)"): the bracket form `T[g, …]`,
    // `free` (length may change), `write` (positions may be overwritten), and
    // `replace` (whole-value reassignment). The old spelling `writable` is
    // refused with the fix-it "`writable` is spelled `write`" (E-GRANT-UNKNOWN,
    // no deprecation window — the bootstrap is pre-release).
    type GrantAxis:enum = { GFree, GWrite, GReplace, GGrow(at: SeqAt), GShrink(at: SeqAt), GRetired(grow: string, shrink: string), GRenamed(to: string), GUnknown }

    fn grantAxis(w: string) -> GrantAxis {
        return match w {
            "free"     :> GrantAxis.GFree
            "write"    :> GrantAxis.GWrite
            "replace"  :> GrantAxis.GReplace
            "append"   :> GrantAxis.GGrow(SeqAt.End)
            "pop"      :> GrantAxis.GShrink(SeqAt.End)
            "prepend"  :> GrantAxis.GGrow(SeqAt.Front)
            "shift"    :> GrantAxis.GShrink(SeqAt.Front)
            "insert"   :> GrantAxis.GGrow(SeqAt.Anywhere)
            "remove"   :> GrantAxis.GShrink(SeqAt.Anywhere)
            "end"      :> GrantAxis.GRetired("append", "pop")
            "front"    :> GrantAxis.GRetired("prepend", "shift")
            "anywhere" :> GrantAxis.GRetired("insert", "remove")
            "writable" :> GrantAxis.GRenamed("write")
            _          :> GrantAxis.GUnknown
        }
    }

    fn growAt(ax: GrantAxis) -> SeqAt | not {
        return match ax {
            .GGrow(at: a) :> a
            .GShrink(at: a) :> not
            .GRetired(grow: g) :> not
            .GRenamed(to: t) :> not
            .GFree :> not
            .GWrite :> not
            .GReplace :> not
            .GUnknown :> not
        }
    }

    fn shrinkAt(ax: GrantAxis) -> SeqAt | not {
        return match ax {
            .GShrink(at: a) :> a
            .GGrow(at: a) :> not
            .GRetired(grow: g) :> not
            .GRenamed(to: t) :> not
            .GFree :> not
            .GWrite :> not
            .GReplace :> not
            .GUnknown :> not
        }
    }

    fn grantUnknownMessage(g: string, ax: GrantAxis) -> string {
        return match ax {
            .GRetired(grow: gw, shrink: sw) :> "`" + g + "` no longer names a grant: growing and shrinking are separate grants at each place (RULED S442) — write `" + gw + "` (grow), `" + sw + "` (shrink), or both"
            .GGrow(at: a) :> ""
            .GShrink(at: a) :> ""
            .GRenamed(to: t) :> "`" + g + "` is spelled `" + t + "` (RULED S469, O10) — write `" + t + "`"
            .GFree :> ""
            .GWrite :> ""
            .GReplace :> ""
            .GUnknown :> "`" + g + "` is not a permission axis value (§66.12.2; there is no `any` / `all`, §66.12.4)"
        }
    }

    // (s469-boot-tape-grants: a removal is judged by `grantsAdmit` over the
    // GrantSet's RemoveEnd / RemoveFront / RemoveAnywhere edits — seqEdits puts
    // them there from the shrink grants, `remove` covering end and front.)

    // A2: the TypeDefs.
    fn typeInfos(stubs: TypeStub[], te: TypeEnv, st0: AS) -> RTypeInfos {
        let st: AS = st0
        let out: TypeInfo[] = []
        for (const s of stubs) {
            const fte: TypeEnv = teAt(te, s.file)
            const body: ATypeBody = s.src.body
            const r: RTypeDef = typeDefOf(fte, s, body, st)
            st = r.st
            out = out.concat([{ nid: s.nid, span: s.src.span, name: s.name, file: s.file, exported: s.exported, def: r.def }])
        }
        return { ts: out, st: st }
    }

    type RTypeDef:struct = { def: TypeDef, st: AS }

    fn typeDefOf(te: TypeEnv, s: TypeStub, body: ATypeBody, st: AS) -> RTypeDef {
        return match body {
            .EnumBody(variants: vs) :> enumDefOf(te, s, vs, st)
            .StructBody(fields: fs) :> structDefOf(te, s, fs, st)
            .HostBody :> hostDefOf(s, st)
        }
    }

    fn enumDefOf(te: TypeEnv, s: TypeStub, vs: AVariant[], st0: AS) -> RTypeDef {
        let st: AS = st0
        let out: VariantDef[] = []
        let i = 0
        for (const v of vs) {
            const r: RFieldDefs = fieldDefsOf(te, v.fields, [], st, true)
            st = r.st
            out = out.concat([{ sym: s.members[i], fields: r.fs }])
            i = i + 1
        }
        return { def: TypeDef.EnumDef(s.sym, out), st: st }
    }

    fn structDefOf(te: TypeEnv, s: TypeStub, fs: ATypeField[], st0: AS) -> RTypeDef {
        const r: RFieldDefs = fieldDefsOf(te, fs, s.members, st0, false)
        return { def: TypeDef.StructDef(s.sym, r.fs), st: r.st }
    }

    type RFieldDefs:struct = { fs: FieldDef[], st: AS }

    // Payload fields (variants) are values: no grants. Struct fields take their
    // own `let` (O3) and their type's edit grants. `syms` = the member Syms minted
    // with the type (struct fields); payload fields are minted here.
    fn fieldDefsOf(te: TypeEnv, fs: ATypeField[], syms: Sym[], st0: AS, payload: boolean) -> RFieldDefs {
        let st: AS = st0
        let out: FieldDef[] = []
        let i = 0
        for (const f of fs) {
            const rt: RType = resolveType(te, f.ty, st)
            const unresolved: boolean = rt.unresolved
            st = rt.st
            // s469-boot-tape-grants (g-bootstrap-let-struct-field-tape-no-let-on-sequence-s469):
            // a struct field whose type is a tape is a rule-1 position (§66.12.6) — `let` on it
            // is `let` on a sequence, exactly as on a cell (fieldOf; through `| not` too). The
            // `replace` the `let` reads as stays as error recovery (no cascade of refusals).
            if (!payload && f.isLet && seqElem(unMaybe(rt.t)) is given) {
                st = addDiag(st, te.file, f.span, "E-GRANT-LET-ON-SEQUENCE", "`let` on the tape field `" + f.name + "` — a struct field of tape type takes its grants from its type: write `replace` in the type's grants (`" + f.name + ": T[replace, …]`), not `let` (O3 ruled; §66.12.6 rule 1)")
            }
            let fsym: Sym = mkSym(0, f.name)
            if (i < syms.length) {
                fsym = syms[i]
            } else {
                const rm: RSym = mint(st, f.name)
                fsym = rm.s
                st = rm.st
            }
            if (unresolved) st = badField(st, fsym.id)     // r8: never checked against
            out = out.concat([{ sym: fsym, ty: rt.t, grants: fieldDefGrants(payload, f.isLet || seqReplace(f.ty), typeEdits(rt.t)) }])
            i = i + 1
        }
        return { fs: out, st: st }
    }

    // ---- lookups over the global shape ------------------------------------------
    fn typeInfoNamed(ts: TypeInfo[], name: string) -> TypeInfo | not {
        for (const t of ts) {
            if (t.name == name) return t
        }
        return not
    }

    fn typeInfoOf(ts: TypeInfo[], s: Sym) -> TypeInfo | not {
        for (const t of ts) {
            if (typeDefSym(t.def).id == s.id) return t
        }
        return not
    }

    fn enumVariants(td: TypeDef) -> VariantDef[] {
        return match td {
            .EnumDef(sym: s, variants: vs) :> vs
            .StructDef(sym: s) :> []
            .HostDef(sym: s) :> []
        }
    }

    fn structFieldDefs(td: TypeDef) -> FieldDef[] | not {
        return match td {
            .StructDef(sym: s, fields: fs) :> fs
            .EnumDef(sym: s) :> not
            .HostDef(sym: s) :> not
        }
    }

    // The index of variant `name` in enum `s`, else -1.
    fn variantIndex(ts: TypeInfo[], s: Sym, name: string) -> int {
        const t: TypeInfo | not = typeInfoOf(ts, s)
        if (t is not) return -1
        let i = 0
        for (const v of enumVariants(t.def)) {
            if (v.sym.hint == name) return i
            i = i + 1
        }
        return -1
    }

    fn isEnumType(ts: TypeInfo[], t: Type) -> Sym | not {
        const s: Sym | not = namedOf(t)
        if (s is not) return not
        const ti: TypeInfo | not = typeInfoOf(ts, s)
        if (ti is not) return not
        if (isHostDef(ti.def)) return not
        if (enumVariants(ti.def).length == 0) {
            const fs: FieldDef[] | not = structFieldDefs(ti.def)
            if (fs is given) return not
        }
        return s
    }

    fn namedOf(t: Type) -> Sym | not {
        return match t {
            .Named(sym: s) :> s
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Seq(elem: e) :> not
            .Maybe(inner: i) :> not
        }
    }

    fn seqElem(t: Type) -> Type | not {
        return match t {
            .Seq(elem: e) :> e
            .Named(sym: s) :> not
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Maybe(inner: i) :> not
        }
    }

    fn findDeclSrc(g: Globals, s: Sym) -> DeclSrc | not {
        for (const d of g.decls) {
            if (d.info.sym.id == s.id) return d
        }
        return not
    }

    // s472: the user declaration `name` denotes in `file` (declared there, or
    // imported — scopeFrom), else not.
    fn declNamed(g: Globals, file: string, name: string) -> DeclSrc | not {
        const from: string = scopeFrom(g.te.link, file, NameKind.KDecl, name)
        if (from == "") return not
        const orig: string = scopeOrig(g.te.link, file, NameKind.KDecl, name)   // s474: an alias names its export
        for (const d of g.decls) {
            if (!d.isProgram && d.info.sym.hint == orig && d.file == from) return d
        }
        return not
    }

    // s472: a user declaration `name` in SOME linked file (scope aside) — a tag
    // naming one that is not in scope here is refused, never read as HTML.
    fn declAnywhere(g: Globals, name: string) -> boolean {
        for (const d of g.decls) {
            if (!d.isProgram && d.info.sym.hint == name) return true
        }
        return false
    }

    fn fieldIndex(d: DeclInfo, name: string) -> int {
        let i = 0
        for (const f of d.fields) {
            if (f.sym.hint == name) return i
            i = i + 1
        }
        return -1
    }

    // s472: the function `name` denotes in `file` (declared there, or
    // imported — scopeFrom), else not. Never the first of that name.
    fn fnNamed(g: Globals, file: string, name: string) -> FnInfo | not {
        const from: string = scopeFrom(g.te.link, file, NameKind.KFn, name)
        if (from == "") return not
        const orig: string = scopeOrig(g.te.link, file, NameKind.KFn, name)   // s474: an alias names its export
        for (const f of g.fns) {
            if (f.info.name == orig && f.info.file == from) return f.info
        }
        return not
    }

    // ---- declarations -----------------------------------------------------------
    // The program (the entry file's `<program>`) and every user declaration
    // (a top-level `<x …>` with typed attributes / a `renders`, in any file).
    type DeclStub:struct = { sym: Sym, file: string, isProgram: boolean, d: ADecl | not, p: AProgram | not, nid: int }
    type RDeclStubs:struct = { ds: DeclStub[], st: AS }

    fn declStubs(files: FileAst[], entry: string, st0: AS) -> RDeclStubs {
        let st: AS = st0
        let out: DeclStub[] = []
        for (const f of files) {
            for (const it of f.items) {
                const k: AItemK = it.k
                const r: RDeclStubs = isLaterProgram(f.items, it) ? noStubs(st) : declStubOf(k, f.path, entry, st)
                out = out.concat(r.ds)
                st = r.st
            }
        }
        return { ds: out, st: st }
    }

    fn declStubOf(k: AItemK, file: string, entry: string, st: AS) -> RDeclStubs {
        return match k {
            .DeclItem(d: d) :> userDeclStub(d, file, st)
            .ProgramItem(p: p) :> withNestedStubs(programStub(p, file, entry, st), p, file)
            .ConstItem(c: c) :> noStubs(st)
            .ImportItem(i: i) :> noStubs(st)
            .TypeItem(t: t) :> noStubs(st)
            .FnItem(f: f) :> noStubs(st)
            .MarkupItem(n: n) :> noStubs(st)
        }
    }

    fn noStubs(st: AS) -> RDeclStubs { return { ds: [], st: st } }

    // Where a declaration is written: its `<x …>` opener / its `<program>`.
    fn declSpan(ds: DeclStub) -> ASpan {
        const d: ADecl | not = ds.d
        if (d is given) return d.span
        const p: AProgram | not = ds.p
        if (p is given) return p.span
        return mkSpan(0, 0)
    }

    fn userDeclStub(d: ADecl, file: string, st0: AS) -> RDeclStubs {
        let st: AS = st0
        if (reservedElementName(d.name)) {
            st = addDiag(st, file, d.span, "E-NAME-COLLIDES-RESERVED", "`<" + d.name + ">` is a reserved scrml structural-element name (§4.15, §24.4: a user declaration named `engine`, `match`, `each`, `errors`, `render`, `page`, `onMount`, `md`, … is E-NAME-COLLIDES-RESERVED) — a use `<" + d.name + ">` names the structural element, not this declaration. Rename the declaration")
        }
        const r: RSym = mint(reservedName(st, file, d.span, d.name), d.name)
        return { ds: [{ sym: r.s, file: file, isProgram: false, d: d, p: not, nid: d.nid }], st: r.st }
    }

    // s473 — the reserved scrml structural-element identifiers a user
    // declaration may not take: §4.15's list ("registering a user component
    // named `engine`, `match`, `each`, `errors`, `onTransition`, `onTimeout`,
    // `onIdle`, `onMount` (S449), `render`, `page`, `endpoint`, `onchange`,
    // `theme`, `defaults`, or `md` (S462, §67) is `E-NAME-COLLIDES-RESERVED`").
    // Compared lowercase: §24.4 extends it to the capitalised spellings
    // (`const Engine = <div>`, `OnMount`, `Page`, `Theme`, …).
    fn reservedElementName(name: string) -> boolean {
        const t: string = name.toLowerCase()
        return match t {
            "engine"       :> true
            "match"        :> true
            "each"         :> true
            "errors"       :> true
            "ontransition" :> true
            "ontimeout"    :> true
            "onidle"       :> true
            "onmount"      :> true
            "render"       :> true
            "page"         :> true
            "endpoint"     :> true
            "onchange"     :> true
            "theme"        :> true
            "defaults"     :> true
            "md"           :> true
            _              :> false
        }
    }

    // s442: a declaration with typed attributes or a `renders` written inside
    // `<program>` is a USER declaration (a multi-instance type, §66.1) — the
    // §66.19.6 `<card title:string>` — not a program field. Its instances come
    // from its uses; the declaration itself renders nothing where it is
    // written (the §66.19 programs render instances only through uses and
    // `<*x/>`; ⚑ O38 — whether a program-level declaration is in "a markup
    // position" — is not decided here). A declaration with neither stays a
    // program field (R4), `single` or not.
    // S447 (§66.4 rule 6): attributes are always locked data, so a declaration
    // whose writable fields were attributes now holds them as CHILD
    // declarations under a `:struct` opener — the marker that replaces its
    // typed attributes (§66.2.2). `<x:struct>` is therefore a user declaration
    // too (it was the same kind before the respelling).
    fn isNestedUserDecl(d: ADecl) -> boolean {
        return d.attrs.length > 0 || d.renders is given || ownTypeName(d) == "struct"
    }

    fn withNestedStubs(r: RDeclStubs, p: AProgram, file: string) -> RDeclStubs {
        let st: AS = r.st
        let out: DeclStub[] = r.ds
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (isNestedUserDecl(d)) {
                    const n: RDeclStubs = userDeclStub(d, file, st)
                    out = out.concat(n.ds)
                    st = n.st
                }
            }
        }
        return { ds: out, st: st }
    }

    fn programStub(p: AProgram, file: string, entry: string, st: AS) -> RDeclStubs {
        let st2: AS = st
        if (file != entry) st2 = addDiag(st, file, p.span, "E-BOOTSTRAP-UNSUPPORTED", "a `<program>` outside the entry file")
        const r: RSym = mint(st2, "program")
        return { ds: [{ sym: r.s, file: file, isProgram: true, d: not, p: p, nid: p.nid }], st: r.st }
    }

    // ---- s451: the program shape (fail closed) ---------------------------------------
    // Before s451 every `<program>` attribute was parsed and never read, a
    // second top-level `<program>` silently won (phaseA kept the LAST), a
    // `<program>` in a program body was ignored, and markup at a file's top
    // level, outside any `<program>`, was dropped. Each now gets the SPEC's code
    // where the rule is static and cheap, else E-BOOTSTRAP-UNSUPPORTED naming
    // it. The governing sentences are quoted in
    // docs/changes/s451-boot-program-shape/progress.md.

    // Is this item the second (or later) top-level `<program>` of its file?
    // §40.8: "A second (or later) top-level `<program>` in the SAME file …
    // SHALL be `E-PROGRAM-002`" — it is reported (programShapeDiags), and no
    // stub is minted for it, so its body is not analyzed as the program.
    fn isLaterProgram(items: AItem[], it: AItem) -> boolean {
        let seen = 0
        for (const x of items) {
            if (x.nid == it.nid) return seen > 0 && programOfItem(x) is given
            if (programOfItem(x) is given) seen = seen + 1
        }
        return false
    }

    fn programOfItem(it: AItem) -> AProgram | not {
        const k: AItemK = it.k
        return match k {
            .ProgramItem(p: p) :> p
            .ConstItem(c: c) :> not
            .DeclItem(d: d) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .FnItem(f: f) :> not
            .MarkupItem(n: n) :> not
        }
    }

    // s473 — does the program body's markup write `<tag>` (a plain tag, any
    // depth; not a `<*x>` reference, not inside a user declaration's renders)?
    fn programUsesTag(p: AProgram, tag: string) -> boolean {
        for (const it of p.items) {
            const n: ANode | not = markupOfItem(it)
            if (n is given && nodesUseTag([n], tag)) return true
        }
        return false
    }

    fn nodesUseTag(ns: ANode[], tag: string) -> boolean {
        for (const n of ns) {
            const e: AElem | not = elemOfANode(n)
            if (e is given) {
                if (!e.star && e.tag == tag) return true
                if (nodesUseTag(e.kids, tag)) return true
            }
        }
        return false
    }

    fn markupOfItem(it: AItem) -> ANode | not {
        const k: AItemK = it.k
        return match k {
            .MarkupItem(n: n) :> n
            .ProgramItem(p: p) :> not
            .ConstItem(c: c) :> not
            .DeclItem(d: d) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .FnItem(f: f) :> not
        }
    }

    fn topElemOf(n: ANode) -> AElem | not {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> e
            .Text(text: t) :> not
            .Interp(e: x) :> not
            .DeclNode(d: d) :> not
            .Css(c: c) :> not
            .Gather(f: x) :> not
            .Effect(w: w) :> not
        }
    }

    // Every file: a second+ top-level `<program>` (E-PROGRAM-002), file-top
    // markup outside any `<program>`, and — for the entry file's program —
    // its attributes and the `<program>`s nested in its body.
    fn programShapeDiags(files: FileAst[], entry: string, st0: AS) -> AS {
        let st: AS = st0
        for (const f of files) {
            let programs = 0
            for (const it of f.items) {
                if (programOfItem(it) is given) programs = programs + 1
            }
            let seen = 0
            for (const it of f.items) {
                const p: AProgram | not = programOfItem(it)
                if (p is given) {
                    seen = seen + 1
                    if (seen > 1) {
                        st = addDiag(st, f.path, p.span, "E-PROGRAM-002", "a second top-level `<program>` in this file — a file declares its top-level `<program>` exactly once (§40.8), so which program's `auth=`, cookie and middleware settings govern it cannot be told; merge them into one `<program>`, or put a worker / sidecar / scoped-db program INSIDE the first (without `auth=` or cookie attributes)")
                    } else if (f.path == entry) {
                        st = topProgramAttrDiags(f.path, p, st)
                        st = nestedProgramDiags(f.path, p.items, st)
                    }
                }
                const n: ANode | not = markupOfItem(it)
                if (n is given) st = outsideProgramDiag(f.path, n, programs > 0, st)
            }
        }
        return st
    }

    // Markup at a file's top level, outside any `<program>`. §38.1, §20.8.1
    // and §23.6 name three shapes; for the rest the SPEC names no rule (§40.8:
    // "The file top level outside any `<program>` / `<page>` / `<channel>` is
    // NOT this locus"), so it is refused — never dropped.
    fn outsideProgramDiag(file: string, n: ANode, fileHasProgram: boolean, st: AS) -> AS {
        const e: AElem | not = topElemOf(n)
        // a file-top `<effect>` is already refused by `strayEffects` (s449)
        if (e is not) return st
        const t: string = e.tag.toLowerCase()
        if (t == "channel" && fileHasProgram) return addDiag(st, file, e.span, "E-CHANNEL-OUTSIDE-PROGRAM", "`<channel>` outside `<program>` in a file that has a `<program>` (§38.1) — move it inside the `<program>`")
        if (t == "outlet") return addDiag(st, file, e.span, "E-OUTLET-OUTSIDE-SHELL", "`<outlet>` outside a `<program>` shell (§20.8.1) — an outlet is the shell's route-content region; move it inside the `<program>`")
        if (t == "foreign" && fileHasProgram && attrNamed(e.attrs, "lang") is given) return addDiag(st, file, e.span, "E-FOREIGN-LANG-IN-PROGRAM", "`<foreign lang>` in a file that also declares a top-level `<program>` (§23.6) — `<foreign lang>` is the library-file surface; remove it and set `lang=` on the `<program>`")
        return addDiag(st, file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + e.tag + ">` at a file's top level, outside any `<program>`, is not in the bootstrap — the SPEC names no rule for what it renders as (§40.8); move it inside the `<program>`")
    }

    // The `<program>` attribute set (§52.13.3: a closed set — "unknown
    // attribute names emit `W-ATTR-001`"): the names §4.12.2, §20.5.1, §23.5,
    // §40.2, §40.7, §43, §58.8, §64 and §65.3.4 give it.
    fn isProgramAttrName(a: string) -> boolean {
        if (isCookieAttr(a)) return true
        return match a {
            "kind" :> true
            "serve" :> true
            "db" :> true
            "tables" :> true
            "html" :> true
            "name" :> true
            "auth" :> true
            "loginRedirect" :> true
            "csrf" :> true
            "title" :> true
            "description" :> true
            "version" :> true
            "author" :> true
            "license" :> true
            "cors" :> true
            "cors-max-age" :> true
            "log" :> true
            "headers" :> true
            "ratelimit" :> true
            "idempotency-store" :> true
            "idempotency-ttl" :> true
            "transactions" :> true
            "batch-in-list-cap" :> true
            "channel-reconnect" :> true
            "lang" :> true
            "mode" :> true
            "callchar" :> true
            "build" :> true
            "port" :> true
            "health" :> true
            "route" :> true
            "protect" :> true
            "story" :> true
            "capabilities" :> true
            "autostart" :> true
            "restart" :> true
            "max-restarts" :> true
            "within" :> true
            "mcp" :> true
            "reset" :> true
            _ :> false
        }
    }

    // A name outside the closed `<program>` set (§52.13.3: "unknown attribute
    // names emit `W-ATTR-001`"). s451 fix round (S239 MED): a CASE VARIANT of a
    // `<program>` attribute or of a scrml control attribute (`RESET=`,
    // `Auth=`, `loginredirect=`, `SHOW=`) is not an unknown name to warn past
    // — it is a known one the bootstrap would not read, so it is refused (the
    // SPEC names no rule for attribute-name case). A case-variant repeat
    // (`reset` + `RESET`) lands here too.
    fn unknownProgramAttrDiag(file: string, a: AAttr, st: AS) -> AS {
        const lower: string = a.name.toLowerCase()
        if (isProgramAttrName(lower) || lower == "loginredirect" || lower == "sessionexpiry" || (lower != a.name && isControlAttrName(lower))) {
            return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on `<program>` is a case variant of a `<program>` / scrml attribute name — the bootstrap reads attribute names exactly, so it would be ignored; write the exact name")
        }
        return addDiag(st, file, a.span, "W-ATTR-001", "`" + a.name + "` is not a `<program>` attribute (§52.13.3: `<program>` has a closed attribute set)")
    }

    // §4.12.2's table: what a NESTED `<program>` may carry.
    fn isNestedProgramAttr(a: string) -> boolean {
        return match a {
            "name" :> true
            "lang" :> true
            "db" :> true
            "mode" :> true
            "build" :> true
            "port" :> true
            "health" :> true
            "route" :> true
            "protect" :> true
            "callchar" :> true
            "story" :> true
            "capabilities" :> true
            "autostart" :> true
            "restart" :> true
            "max-restarts" :> true
            "within" :> true
            _ :> false
        }
    }

    // The two §20.5.1 cookie attributes (`sessionExpiry=` and the `-secure`
    // one). The second name is assembled, and no string here holds the bare
    // word: impl#1's route inference scans raw source for /\bsession\b/
    // (route-inference.ts SERVER_ONLY_PATTERNS) — a string literal included —
    // and would place this function, and every function it calls, on the server.
    fn isCookieAttr(a: string) -> boolean {
        return a == "sessionExpiry" || a == "sess" + "ion-secure"
    }

    fn isDocumentaryAttr(a: string) -> boolean {
        return a == "title" || a == "description" || a == "version" || a == "author" || a == "license"
    }

    // The value as written, for a message.
    fn attrValueText(v: AAttrValue) -> string {
        return match v {
            .Quoted(v: s) :> "\"" + s + "\""
            .NoValue :> "no value (a bare attribute)"
            .Bare(e: x) :> "a non-literal value"
            .Paren(e: x) :> "a non-literal value"
            .Braced(b: b) :> "a non-literal value"
        }
    }

    fn quotedAttrText(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> s
            .NoValue :> not
            .Bare(e: x) :> not
            .Paren(e: x) :> not
            .Braced(b: b) :> not
        }
    }

    // The entry file's top-level `<program>`: no attribute is read by the
    // bootstrap's build, so each one is checked to its SPEC rule where that
    // rule is static, and otherwise refused.
    fn topProgramAttrDiags(file: string, p: AProgram, st0: AS) -> AS {
        let st: AS = st0
        for (const a of p.attrs) {
            if (a.name == "auth") {
                st = topAuthDiag(file, a, st)
            } else if (a.name == "ratelimit") {
                st = ratelimitDiag(file, a, st)
            } else if (a.name == "capabilities") {
                st = capabilitiesDiags(file, a, st)
            } else if (a.name == "story") {
                st = addDiag(st, file, a.span, "W-STORY-ON-TOP-LEVEL", "`story=` on the top-level `<program>` is ignored — the top-level program's build story is `[story] default` in `scrml.toml`; per-`<program>` build stories are for nested programs (§58.8, §4.12.2)")
            } else if (a.name == "reset") {
                st = resetAttrDiag(file, a, st)
            } else if (a.name == "db") {
                // s451 (U1a): read — the program's database (§8.1.1, §44.2);
                // placePass's dbsPass checks it (E-SQL-005) and makes it a Core Db
            } else if (a.name == "lang") {
                st = langAttrDiag(file, a, st)
            } else if (a.name == "name") {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`name=` on the top-level `<program>` — \"The top-level `<program>` MUST NOT have a `name=` attribute\" (§4.12.2), and the SPEC names no code for it; remove it")
            } else if (isDocumentaryAttr(a.name)) {
                // s473 (B3): read — §40.7 head metadata (lower headOf; print).
                // "A non-string-literal value … is silently ignored" and an
                // empty one is "as if the attribute were absent" (§40.7).
            } else if (a.name == "mcp") {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<program mcp>` is not in the bootstrap — it asks for the MCP dev-telemetry server (a stdio MCP server, booted beside the program's server, that exposes the running program's state over read-only tools), and the bootstrap builds no MCP server; remove `mcp` to compile here (the SPEC registers the attribute, §4.12.2, but no section says what it emits)")
            } else if (isProgramAttrName(a.name)) {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<program " + a.name + "=…>` is not in the bootstrap — it reads no `<program>` attribute, and never ignores one it does not implement")
            } else {
                st = unknownProgramAttrDiag(file, a, st)
            }
        }
        return st
    }

    // s473 — `lang=` (§4.12 table: "Declares the foreign language toolchain for
    // `_{}` blocks in this scope"; §23.2.1). Read: it is the language of the
    // file's foreign blocks (foreignLangOf). The bootstrap runs only the
    // in-process ts/js form (§23.2.4a), so any other language — a sidecar
    // toolchain — is refused here rather than ignored.
    fn langAttrDiag(file: string, a: AAttr, st: AS) -> AS {
        const v: string | not = quotedAttrText(a.value)
        if (v is given) {
            // s473-boot-program-attrs-small (S239 review F6): `lang=""` is as
            // if absent (the §40.7 empty-value rule) — foreignLangOf reads none
            if (v == "ts" || v == "js" || v == "") return st
        }
        return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<program lang=…>` is " + attrValueText(a.value) + " — the bootstrap runs foreign code only in-process, for `lang=\"ts\"` / `\"js\"` (§23.2.4a); another language's toolchain (§23.2.1, a sidecar) is not in the bootstrap")
    }

    // §65.3.4: "Opt out via `<program reset=\"none\">` — drops the whole `reset`
    // layer." `"none"` is implemented (lower: CoreProgram.reset = false; print
    // emits no reset layer). §65.3.4 names no other value and no code for one,
    // so any other value is refused rather than given a meaning.
    fn resetAttrDiag(file: string, a: AAttr, st: AS) -> AS {
        const v: string | not = quotedAttrText(a.value)
        if (v is given) {
            if (v == "none") return st
        }
        return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`reset=` is " + attrValueText(a.value) + " — §65.3.4 names one value, \"none\" (drop the built-in reset layer); the bootstrap gives no other value a meaning")
    }

    // §52.13.2 (S449): exactly one of the three literals, else E-AUTH-ATTR-INVALID.
    // A legal value is REFUSED: the bootstrap emits no server and no login
    // gate, so compiling it would serve the program ungated.
    fn topAuthDiag(file: string, a: AAttr, st: AS) -> AS {
        const v: string | not = quotedAttrText(a.value)
        if (v is given) {
            if (v == "required" || v == "optional" || v == "none") return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<program auth=\"" + v + "\">` is not in the bootstrap — it emits no server and no login gate (§52.13, §40.2), so the program is refused rather than compiled ungated")
        }
        return addDiag(st, file, a.span, "E-AUTH-ATTR-INVALID", "`auth=` on `<program>` is " + attrValueText(a.value) + " — it must be exactly one of the literals \"required\", \"optional\", \"none\" (§52.13.2)")
    }

    // §39.2.4: `N/unit`, unit ∈ { sec, min, hour }, else E-MW-002. A valid
    // value is refused: the bootstrap emits no request pipeline.
    fn ratelimitDiag(file: string, a: AAttr, st: AS) -> AS {
        const v: string | not = quotedAttrText(a.value)
        if (v is given) {
            if (isRatelimitForm(v)) return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<program ratelimit=\"" + v + "\">` is not in the bootstrap — it emits no request pipeline (§40.2), so the limit would be dropped")
        }
        return addDiag(st, file, a.span, "E-MW-002", "`ratelimit=` is " + attrValueText(a.value) + " — it must be `N/unit` with unit one of sec, min, hour (e.g. ratelimit=\"100/min\", §39.2.4)")
    }

    fn isRatelimitForm(v: string) -> boolean {
        const slash: int = v.indexOf("/")
        if (slash < 1) return false
        let i = 0
        while (i < slash) {
            if ("0123456789".indexOf(v.substring(i, i + 1)) < 0) return false
            i = i + 1
        }
        const unit: string = v.substring(slash + 1, v.length)
        return unit == "sec" || unit == "min" || unit == "hour"
    }

    // §23.5.2 / §23.5.3: `capabilities=[tok, …]` over the closed vocabulary.
    // An unknown token is E-FOREIGN-CAPABILITY-UNKNOWN; a value outside the
    // §23.5.2 grammar is refused. A valid list is accepted: in v1.0 it is
    // advisory and governs only foreign code (§23.5.1), which the bootstrap
    // refuses everywhere — so there is nothing for it to change here.
    type CapTok:struct = { name: string, ok: boolean }

    fn capabilitiesDiags(file: string, a: AAttr, st0: AS) -> AS {
        let st: AS = st0
        const v: AAttrValue = a.value
        const es: AExpr[] | not = match v {
            .Bare(e: x) :> capList(x)
            .Paren(e: x) :> not
            .Quoted(v: s) :> not
            .NoValue :> not
            .Braced(b: b) :> not
        }
        if (es is not) return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`capabilities=` is not a bracketed capability list `[tok, …]` (§23.5.2)")
        for (const e of es) {
            const t: CapTok = capToken(e)
            if (t.name != "" && !isCapability(t.name)) {
                st = addDiag(st, file, e.span, "E-FOREIGN-CAPABILITY-UNKNOWN", "`" + t.name + "` is not a capability — the v1 vocabulary is { network, fs-read, fs-write, spawn, env, db } (§23.5.3)")
            } else if (t.name == "" || !t.ok || (t.name == "db" && capHasArgs(e))) {
                st = addDiag(st, file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "this `capabilities=` entry is outside the §23.5.2 grammar (a token, `tok(\"…\", …)` with string-literal arguments, or a bare `db`)")
            }
        }
        return st
    }

    fn capList(e: AExpr) -> AExpr[] | not {
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: xs) :> xs
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn isCapability(n: string) -> boolean {
        return n == "network" || n == "fs-read" || n == "fs-write" || n == "spawn" || n == "env" || n == "db"
    }

    // A capability token, read back from the expression the attribute value
    // parsed as: `spawn` (a name), `network("a")` (a call), `fs-read("p")`
    // (`fs - read("p")`: a subtraction whose right side is the call). name ""
    // = not a token shape; ok = false = arguments that are not string literals.
    fn capToken(e: AExpr) -> CapTok {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> { name: n, ok: true }
            .Call(callee: c, args: args) :> { name: capHyphenName(c), ok: allStrLits(args) }
            .Binary(op: o, l: l, r: r) :> capHyphenTok(o, l, r)
            .At(name: n) :> { name: "", ok: false }
            .AtItem :> { name: "", ok: false }
            .Num(raw: r) :> { name: "", ok: false }
            .Str(v: s) :> { name: "", ok: false }
            .Bool(v: b) :> { name: "", ok: false }
            .NotLit :> { name: "", ok: false }
            .Recovered :> { name: "", ok: false }
            .Variant(name: n) :> { name: "", ok: false }
            .Member(obj: o) :> { name: "", ok: false }
            .Unary(op: o) :> { name: "", ok: false }
            .Ternary(test: t) :> { name: "", ok: false }
            .Assign(target: t) :> { name: "", ok: false }
            .ArrayLit(elems: xs) :> { name: "", ok: false }
            .ObjectLit(props: ps) :> { name: "", ok: false }
            .Spread(e: x) :> { name: "", ok: false }
            .Index(obj: o) :> { name: "", ok: false }
            .Lambda(params: ps) :> { name: "", ok: false }
            .Sql(q: q) :> { name: "", ok: false }
            .Handled(h: x) :> { name: "", ok: false }
            .Template(quasis: qs) :> { name: "", ok: false }
            .Foreign(f: fb0) :> { name: "", ok: false }
        }
    }

    fn capHyphenTok(o: BinOp, l: AExpr, r: AExpr) -> CapTok {
        if (o != BinOp.Sub) return { name: "", ok: false }
        const left: string = capHyphenName(l)
        if (left == "") return { name: "", ok: false }
        const t: CapTok = capToken(r)
        if (t.name == "") return t
        return { name: left + "-" + t.name, ok: t.ok }
    }

    // `a` or `a-b-…` (a chain of subtractions of names) → "a" / "a-b-…".
    fn capHyphenName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> n
            .Binary(op: o, l: l, r: r) :> capHyphenPair(o, l, r)
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: x) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: x) :> ""
            .Call(callee: c) :> ""
            .Unary(op: x) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: xs) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: x) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    fn capHyphenPair(o: BinOp, l: AExpr, r: AExpr) -> string {
        if (o != BinOp.Sub) return ""
        const a: string = capHyphenName(l)
        const b: string = capHyphenName(r)
        if (a == "" || b == "") return ""
        return a + "-" + b
    }

    fn allStrLits(args: AExpr[]) -> boolean {
        for (const x of args) {
            if (!isStrLitExpr(x)) return false
        }
        return true
    }

    fn isStrLitExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Str(v: s) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: xs) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // `db(…)`: `db` is presence-only (§23.5.2 grammar: 'db' takes no arguments).
    fn capHasArgs(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Call(callee: c) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: xs) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // A `<program>` in a program body is NESTED (§4.12) — an execution
    // context (worker / sidecar / scoped db) the bootstrap does not build, so
    // it is refused; its attributes still get §4.12.2's codes (each is an
    // error whatever the bootstrap builds), and its own body is walked for
    // deeper programs.
    fn nestedProgramDiags(file: string, items: AItem[], st0: AS) -> AS {
        let st: AS = st0
        for (const it of items) {
            const p: AProgram | not = programOfItem(it)
            if (p is given) {
                st = addDiag(st, file, p.span, "E-BOOTSTRAP-UNSUPPORTED", "a nested `<program>` (§4.12 — a worker, sidecar or scoped-db execution context) is not in the bootstrap")
                st = nestedProgramAttrDiags(file, p, st)
                st = nestedProgramDiags(file, p.items, st)
            }
        }
        return st
    }

    fn nestedProgramAttrDiags(file: string, p: AProgram, st0: AS) -> AS {
        let st: AS = st0
        for (const a of p.attrs) {
            if (a.name == "auth") {
                st = addDiag(st, file, a.span, "E-PROGRAM-NESTED-AUTH", "`auth=` on a nested `<program>` — a nested program is not an auth scope (§4.12.2); put `auth=` on the top-level `<program>` or on the `<page>` that needs it")
            } else if (isCookieAttr(a.name)) {
                st = addDiag(st, file, a.span, "E-PROGRAM-NESTED-SESSION", "`" + a.name + "=` on a nested `<program>` — the login cookie belongs to the whole application (§4.12.2, §20.5.1)")
            } else if (isDocumentaryAttr(a.name)) {
                st = addDiag(st, file, a.span, "W-PROGRAM-TITLE-NESTED", "`" + a.name + "=` on a nested `<program>` is head metadata with no effect there (§40.7)")
            } else if (a.name == "capabilities") {
                st = capabilitiesDiags(file, a, st)
            } else if (a.name == "kind" || a.name == "serve") {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` on a nested `<program>` (§64) is not in the bootstrap")
            } else if (isNestedProgramAttr(a.name)) {
                // §4.12.2's table: valid here (the nested program itself is refused above)
            } else if (isProgramAttrName(a.name)) {
                st = addDiag(st, file, a.span, "E-PROGRAM-NESTED-ATTR", "`" + a.name + "=` is application-level and not valid on a nested `<program>` (§4.12.2 lists what a nested program may carry)")
            } else {
                st = unknownProgramAttrDiag(file, a, st)
            }
        }
        return st
    }

    // ---- fields -------------------------------------------------------------------
    // Does an initializer read cells (§66.9: derived when locked, seeded when
    // `let`)? A call counts: a function may read cells.
    fn valueReads(v: AAttrValue) -> string[] {
        return match v {
            .Bare(e: e) :> exprReads(e)
            .Paren(e: e) :> exprReads(e)
            .NoValue :> []
            .Quoted(v: s) :> []
            .Braced(b: b) :> []
        }
    }

    // The `@names` an expression reads ("()" for a call), for E-DERIVED-WRITE's message.
    fn exprReads(e: AExpr) -> string[] {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> ["@" + n]
            .AtItem :> ["@."]
            .Member(obj: o) :> exprReads(o)
            .Call(callee: c, args: args) :> ["()"].concat(listReads(args))
            .Unary(op: o, e: x) :> exprReads(x)
            .Binary(op: o, l: l, r: r) :> exprReads(l).concat(exprReads(r))
            .Ternary(test: t, yes: y, no: n) :> exprReads(t).concat(exprReads(y)).concat(exprReads(n))
            .Assign(target: t, value: v) :> exprReads(v)
            .ArrayLit(elems: es) :> listReads(es)
            .ObjectLit(props: ps) :> propReads(ps)
            .Spread(e: x) :> exprReads(x)
            .Index(obj: o, idx: i) :> exprReads(o).concat(exprReads(i))
            .Lambda(params: ps2, body: b) :> exprReads(b)
            .Sql(q: q) :> ["" + sqlSigil() + "}"].concat(listReads(q.params))      // s451: a query reads (like a call)
            .Handled(h: h) :> listReads(handledKids(h))      // s451 (Ue): the subject and the arms' values
            .Template(quasis: qs, slots: ss) :> listReads(ss)      // s469: a template reads what its slots read
            .Foreign(f: fb0) :> listReads(fb0.crossings)            // s473: a foreign block reads its crossings (§23.2.4a)
            .Name(name: n) :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
        }
    }

    fn listReads(es: AExpr[]) -> string[] {
        let out: string[] = []
        for (const e of es) { out = out.concat(exprReads(e)) }
        return out
    }

    fn propReads(ps: AProp[]) -> string[] {
        let out: string[] = []
        for (const p of ps) { out = out.concat(exprReads(p.value)) }
        return out
    }

    // An own-value type from its literal when no annotation is written (§66.3 rule 3).
    type RMaybeType:struct = { t: Type | not, st: AS }

    // The literal an initializer IS (§66.3 rule 3; rule 5 (a)), or `not`.
    fn literalOf(v: AAttrValue) -> Type | not {
        return match v {
            .Bare(e: e) :> literalType(e)
            .Paren(e: e) :> literalType(e)
            .Quoted(v: s) :> Type.Str
            .NoValue :> not
            .Braced(b: b) :> not
        }
    }

    // s462 (dpa-065 D3): only a `-` before a numeric literal is a literal —
    // `(!0)` is not an `int` (it is `!` over an `int`, refused by the typer).
    // s462 (§66.3 rule 5 (a)): a non-empty `[…]` of scalar literals of one
    // base type is a literal (`[1, 2, 3]` → `int[]`).
    fn literalType(e: AExpr) -> Type | not {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> numType(r)
            .Str(v: s) :> Type.Str
            .Bool(v: b) :> Type.Bool
            .Unary(op: o, e: x) :> negLiteralType(o, x)
            .ArrayLit(elems: es) :> seqLiteralType(es)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn negLiteralType(o: UnOp, x: AExpr) -> Type | not {
        if (o != UnOp.Neg) return not
        const t: Type | not = literalType(x)
        if (t is not) return not
        if (isNumericKind(t)) return t
        return not
    }

    // A non-empty `[…]` whose elements are all SCALAR literals of one base
    // type (`int` with `number` → `number`); `not` otherwise ([] is O35(b)).
    fn seqLiteralType(es: AExpr[]) -> Type | not {
        if (es.length == 0) return not
        let acc: Type | not = not
        for (const e of es) {
            const t: Type | not = literalType(e)
            if (t is not) return not
            if (kindOf(t) == 5) return not
            if (acc is not) {
                acc = t
            } else {
                const j: Type | not = joinBase(acc, t)
                if (j is not) return not
                acc = j
            }
        }
        if (acc is not) return not
        return Type.Seq(acc, fixedSeq())
    }

    // Two members' shared base type: the same type, or `number` for two numbers.
    fn joinBase(a: Type, b: Type) -> Type | not {
        if (sameType(a, b)) return a
        if (isNumericKind(a) && isNumericKind(b)) return Type.Num
        return not
    }

    // §66.3 rule 6: the BASE type — no grants on a sequence (no singleton or
    // refinement exists in the bootstrap's Type). `T | not` stays `T | not`.
    fn baseOf(t: Type) -> Type {
        return match t {
            .Seq(elem: e) :> Type.Seq(baseOf(e), fixedSeq())
            .Maybe(inner: i) :> Type.Maybe(baseOf(i))
            .Int :> t
            .Num :> t
            .Str :> t
            .Bool :> t
            .Named(sym: s) :> t
        }
    }

    // L19: an integer literal infers `int`; a non-integer numeric literal `number`.
    // A hex / binary / octal literal (`0xFE`, `0b101`, `0o17`) is an integer
    // literal whatever its digits (s442 r2 F4: `0xE`'s `E` is a hex digit, not
    // an exponent). SPEC: "An integer literal infers `int`".
    fn numType(raw: string) -> Type {
        if (isRadixLiteral(raw)) return Type.Int
        if (raw.indexOf(".") >= 0 || raw.indexOf("e") >= 0 || raw.indexOf("E") >= 0) return Type.Num
        return Type.Int
    }

    fn isRadixLiteral(raw: string) -> boolean {
        if (raw.length < 3) return false
        if (raw.substring(0, 1) != "0") return false
        const p: string = raw.substring(1, 2)
        return p == "x" || p == "X" || p == "b" || p == "B" || p == "o" || p == "O"
    }

    // =========================================================================
    // s462 — OWN-VALUE TYPES (O35(d), RULED S462 "go on the package"; SPEC
    // §66.3 rules 5–10; dd own-value-type-annotation-o35d-dpa-065).
    //
    // "Within a file, a non-literal own value's type is INFERRED from its
    // initializer" — from the SPEC-LISTED set and nothing beyond it (whether a
    // program is legal must not depend on which compiler runs it, dd §3):
    //   (a) a literal (rule 3's scalars, `-` before a number, `[…]` of them);
    //   (b) a typed `@ref` — a cell whose type is written or itself inferred,
    //       or a declaration (its shared instance, §66.7.1);
    //   (c) arithmetic, (d) comparison, (e) ternary, (f) `.length` over members;
    //   (g) a call of a function with a DECLARED or INFERRED-AND-PROVEN return
    //       (no `->`, not `!`, not server-placed, `return` on every path, every
    //       returned expression a member — its parameters typed by their
    //       annotations, never a local — and of one base type).
    // The type is the BASE type (rule 6). Outside the set: a hard error,
    // reported by the typer (originReport — E-DECL-TYPE-NOT-INFERABLE), so a
    // diagnostic already inside the initializer suppresses it (no cascade).
    //
    // `Inf.kind`: 0 a member · 1 outside the set · 2 unresolved (a call whose
    // return is neither declared nor proven, an unannotated parameter — rule
    // 10's "cannot resolve") · 3 blamed (another diagnostic owns it) · 4 on a
    // cycle (`cyc`: the cells on it, rule 8).
    // =========================================================================
    type Inf:struct = { ty: Type | not, kind: int, why: string, cyc: string[], at: CalleeAt }
    // A program cell the table is built over (rule 5 (b)'s "cell").
    type OwnSrc:struct = { name: string, aty: AType | not, init: AAttrValue }
    type OwnT:struct = { name: string, ty: Type | not, origin: TypeOrigin }
    // One name in scope inside a function body, innermost LAST (fix round 1,
    // F1): a parameter (`param`), a local, a `given` binding, an arm's binder.
    // `ty` `not` = its type is not written and not determined.
    type ParamT:struct = { name: string, ty: Type | not, param: boolean }
    // `st` is only read (resolveType's diagnostics are DISCARDED here — the
    // binder reports each written type once, where it stands). `res` (fix
    // round 1, F2): RESOLVE mode — is the value's type DETERMINED (rule 5 (g)'s
    // proven return, rule 10)? — rather than MEMBERSHIP mode (is the
    // initializer in rule 5's set?). Resolve mode also reads a comparison, `!`,
    // `is given` / `is not` as `bool` whatever their operands (`&&` / `||` only
    // over two `bool`s — N1), and a member path / an owner-scoped `as=` handle
    // through declared types (N2). What it proves is SPEC §66.3 rule 5's list. `types` / `decls` / `handles`: the
    // declared struct and declaration fields a member path reads.
    // `hscope` (fix round 2, N2): the OWNER whose `as=` handles a bare `@h`
    // may name here — the program's nid inside a program-file function or a
    // program cell's initializer (the binder's scope there), -1 elsewhere (no
    // handle is read: an unresolved one is simply not determined). `prog` /
    // `progFile`: the program's nid and file.
    type InferCx:struct = { te: TypeEnv, fns: FnSrc[], st: AS, srcs: OwnSrc[], res: boolean,
                            types: TypeInfo[], decls: DeclStub[], handles: HandleInfo[],
                            hscope: int, prog: int, progFile: string }
    type RInf:struct = { r: Inf, done: OwnT[] }

    // s472: the same context, resolving names in `file`'s scope (`cx.te.file`
    // is the file whose names are being read: the program's for a program
    // cell, the function's own inside a followed function body).
    fn cxAt(cx: InferCx, file: string) -> InferCx {
        return { te: teAt(cx.te, file), fns: cx.fns, st: cx.st, srcs: cx.srcs, res: cx.res, types: cx.types, decls: cx.decls, handles: cx.handles,
                 hscope: cx.hscope, prog: cx.prog, progFile: cx.progFile }
    }
    type ROwn:struct = { t: OwnT, done: OwnT[] }
    // A `return` and the names in scope where it stands.
    type RetAt:struct = { e: AExpr | not, sc: ParamT[] }
    type RRets:struct = { rs: RetAt[], done: OwnT[] }

    fn noCallee() -> CalleeAt { return { file: "", start: -1, end: -1 } }
    fn infOk(t: Type) -> Inf { return { ty: t, kind: 0, why: "", cyc: [], at: noCallee() } }
    fn infOut(why: string) -> Inf { return { ty: not, kind: 1, why: why, cyc: [], at: noCallee() } }
    fn infUnres(why: string) -> Inf { return { ty: not, kind: 2, why: why, cyc: [], at: noCallee() } }
    fn infBlamed() -> Inf { return { ty: not, kind: 3, why: "", cyc: [], at: noCallee() } }
    fn infCycle(names: string[]) -> Inf { return { ty: not, kind: 4, why: "", cyc: names, at: noCallee() } }
    fn rinf(r: Inf, done: OwnT[]) -> RInf { return { r: r, done: done } }
    // the same failure, standing in function `af` (when it names none yet)
    fn infIn(r: Inf, file: string, af: AFn) -> Inf {
        if (r.at.file != "") return r
        return { ty: r.ty, kind: r.kind, why: r.why, cyc: r.cyc, at: { file: file, start: af.span.start, end: af.span.end } }
    }
    fn withRes(cx: InferCx, res: boolean) -> InferCx {
        return { te: cx.te, fns: cx.fns, st: cx.st, srcs: cx.srcs, res: res, types: cx.types, decls: cx.decls, handles: cx.handles,
                 hscope: cx.hscope, prog: cx.prog, progFile: cx.progFile }
    }
    fn withHscope(cx: InferCx, h: int) -> InferCx {
        return { te: cx.te, fns: cx.fns, st: cx.st, srcs: cx.srcs, res: cx.res, types: cx.types, decls: cx.decls, handles: cx.handles,
                 hscope: h, prog: cx.prog, progFile: cx.progFile }
    }

    fn fileOfFn(cx: InferCx, af: AFn) -> string {
        for (const f of cx.fns) {
            if (f.f.nid == af.nid) return f.info.file
        }
        return ""
    }

    fn programNid(ds: DeclStub[]) -> int {
        for (const d of ds) {
            if (d.isProgram) return d.nid
        }
        return -1
    }

    // N1: `a && b` / `a || b` is a determined `bool` only when both operands
    // are; an unresolved operand is unresolved (rule 10 reports it), any other
    // operand leaves the value undetermined (JavaScript returns an operand).
    fn andOrInf(a: Inf, b: Inf, o: BinOp) -> Inf {
        const bad: Inf = worse(a, b)
        if (bad.kind >= 2) return bad
        if (bad.kind == 1) return infUnres(binWord(o) + " over an operand whose type is not determined — its value is an operand, not a `bool`")
        const x: Type | not = a.ty
        const y: Type | not = b.ty
        if (x is given && y is given && kindOf(x) == 3 && kindOf(y) == 3) return infOk(Type.Bool)
        return infUnres(binWord(o) + " over a non-`bool` operand — its value is that operand, not a `bool`")
    }

    // Of two results, the one that decides the report: blamed > cycle >
    // unresolved > outside > a member.
    fn worse(a: Inf, b: Inf) -> Inf {
        if (infRank(b) > infRank(a)) return b
        return a
    }

    fn infRank(r: Inf) -> int {
        if (r.kind == 3) return 4
        if (r.kind == 4) return 3
        if (r.kind == 2) return 2
        if (r.kind == 1) return 1
        return 0
    }

    // The program's own values (the declarations directly in its body).
    fn programSrcs(ds: DeclStub[]) -> OwnSrc[] {
        let out: OwnSrc[] = []
        for (const d of ds) {
            const p: AProgram | not = d.p
            if (d.isProgram && p is given) {
                for (const it of p.items) {
                    for (const x of declsOfItem(it)) {
                        if (!isNestedUserDecl(x)) out = out.concat([{ name: x.name, aty: x.ty, init: x.own }])
                    }
                }
            }
        }
        return out
    }

    // Every `as=` handle of every declaration's markup (fix round 1, F2: a
    // member path through a handle, `@country.value`, is a declared type).
    // The handle pass's own diagnostics are phase A's (the declaration loop);
    // this read discards them.
    fn allHandles(ds: DeclStub[], lk: Linkage, st: AS) -> HandleInfo[] {
        let out: HandleInfo[] = []
        for (const d of ds) {
            out = out.concat(handlesIn(stubsInScope(ds, lk, d.file), rendersNodes(d), { owner: d.nid, conditional: false, file: d.file }, st).hs)
        }
        return out
    }

    // The table of every program cell's type and origin (phase A, before any
    // field is built — a field's `@ref` resolves against it).
    fn ownTable(cx: InferCx) -> OwnT[] {
        let done: OwnT[] = []
        for (const s of cx.srcs) { done = ownResolve(cx, s.name, [], done).done }
        return done
    }

    fn srcIndex(srcs: OwnSrc[], name: string) -> int {
        let i = 0
        for (const s of srcs) {
            if (s.name == name) return i
            i = i + 1
        }
        return -1
    }

    fn ownFound(done: OwnT[], name: string) -> OwnT | not {
        for (const t of done) {
            if (t.name == name) return t
        }
        return not
    }

    // One program cell, resolved (memoized in `done`). `stack`: the cells
    // ("@x") and functions ("f()") whose inference is in progress. A cell's
    // own type is always rule 5's (MEMBERSHIP mode), whoever asks.
    fn ownResolve(cx0: InferCx, name: string, stack: string[], done: OwnT[]) -> ROwn {
        const found: OwnT | not = ownFound(done, name)
        if (found is given) return { t: found, done: done }
        const cx: InferCx = withRes(cx0, false)
        const s: OwnSrc = cx.srcs[srcIndex(cx.srcs, name)]
        const aty: AType | not = s.aty
        if (aty is given) {
            // a WRITTEN type answers a reader at once — a reader never makes the
            // annotated cell's own initializer part of its inference
            const rt: RType = resolveType(cx.te, aty, cx.st)
            let t: OwnT = { name: name, ty: rt.t, origin: TypeOrigin.Written }
            if (rt.unresolved) t = { name: name, ty: not, origin: TypeOrigin.Blamed }
            return { t: t, done: done.concat([t]) }
        }
        const r: RInf = inferValue(cx, s.init, stack.concat(["@" + name]), [], done)
        const t2: OwnT = { name: name, ty: r.r.ty, origin: originOf(r.r, name, literalInit(cx, s.init)) }
        return { t: t2, done: r.done.concat([t2]) }
    }

    fn originOf(r: Inf, name: string, isLiteral: boolean) -> TypeOrigin {
        if (r.kind == 0) {
            if (isLiteral) return TypeOrigin.Literal
            return TypeOrigin.Inferred
        }
        if (r.kind == 4) {
            if (r.cyc.indexOf(name) >= 0) return TypeOrigin.Cyclic(r.cyc)
            return TypeOrigin.Blamed
        }
        if (r.kind == 3) return TypeOrigin.Blamed
        return TypeOrigin.Failed(r.why, r.at)
    }

    fn inferValue(cx: InferCx, v: AAttrValue, stack: string[], ps: ParamT[], done: OwnT[]) -> RInf {
        return match v {
            .Quoted(v: s) :> rinf(infOk(Type.Str), done)
            .NoValue :> rinf(infOut("it has neither a type nor a value"), done)
            .Braced(b: b) :> rinf(infOut("a `{ … }` block"), done)
            .Bare(e: e) :> inferE(cx, e, stack, ps, done)
            .Paren(e: e) :> inferE(cx, e, stack, ps, done)
        }
    }

    fn inferE(cx: InferCx, e: AExpr, stack: string[], ps: ParamT[], done: OwnT[]) -> RInf {
        const lt: Type | not = literalType(e)
        if (lt is given) return rinf(infOk(lt), done)
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> inferAt(cx, n, stack, done)
            .Name(name: n) :> rinf(scopeInf(ps, n), done)
            .Member(obj: o, name: n) :> inferMember(cx, o, n, stack, ps, done)
            .Call(callee: c) :> inferCall(cx, c, stack, done)
            .Unary(op: o, e: x) :> inferUnary(cx, o, x, stack, ps, done)
            .Binary(op: o, l: l, r: r) :> inferBinary(cx, o, l, r, stack, ps, done)
            .Ternary(test: t, yes: y, no: n) :> inferTernary(cx, t, y, n, stack, ps, done)
            .Recovered :> rinf(infBlamed(), done)
            .Num(raw: r) :> rinf(infOk(numType(r)), done)
            .Str(v: s) :> rinf(infOk(Type.Str), done)
            .Bool(v: b) :> rinf(infOk(Type.Bool), done)
            .NotLit :> rinf(infOut("`not` (an absent value has no type of its own — O35(b))"), done)
            .Variant(name: n) :> rinf(infOut("the bare variant `." + n + "` (O35(b))"), done)
            .AtItem :> rinf(infOut("`@.`"), done)
            .Assign(target: t) :> rinf(infOut("an assignment"), done)
            .ArrayLit(elems: es) :> rinf(infOut("a sequence literal that is not literals of one type (`[]` and compound elements are O35(b))"), done)
            .ObjectLit(props: ps2) :> rinf(infOut("an object literal (O35(b))"), done)
            .Spread(e: sx) :> rinf(infOut("a spread"), done)
            .Index(obj: ix) :> rinf(infOut("an index `[…]`"), done)
            .Lambda(params: lp) :> rinf(infOut("a function value"), done)
            .Sql(q: q) :> rinf(infOut("a query"), done)
            .Handled(h: x) :> rinf(infOut("a handled failable value"), done)
            .Template(quasis: qs) :> rinf(infOk(Type.Str), done)      // s469: a template is a `string` (§14.13.3); its slots are typed where it is resolved
            .Foreign(f: fb0) :> rinf(infOut("a foreign code block (its value is an untyped JavaScript-boundary value, §23.2.4a)"), done)
        }
    }

    // A bare name inside a function body, through the function's REAL scopes
    // (innermost last — a shadowing local, `given` binding or arm binder hides
    // an outer name or a parameter; fix round 1, F1). A parameter is typed by
    // its written type; an UNANNOTATED parameter is refused by the bootstrap
    // whole (E-BOOTSTRAP-UNSUPPORTED), so it is blamed, not reported again
    // (F5). Any other binding whose type is not determined is unresolved.
    fn scopeInf(ps: ParamT[], n: string) -> Inf {
        let i = ps.length - 1
        while (i >= 0) {
            const p: ParamT = ps[i]
            if (p.name == n) {
                const t: Type | not = p.ty
                if (t is given) return infOk(baseOf(t))
                if (p.param) return infBlamed()
                return infUnres("`" + n + "`, a binding whose type is neither written nor determined")
            }
            i = i - 1
        }
        return infOut("the name `" + n + "` (not a typed `@` reference)")
    }

    fn inferAt(cx: InferCx, n: string, stack: string[], done: OwnT[]) -> RInf {
        const key: string = "@" + n
        const at: int = stack.indexOf(key)
        if (at >= 0) {
            let seg: string[] = []
            let viaFn = false
            let i = at
            while (i < stack.length) {
                const s: string = stack[i]
                if (s.substring(0, 1) == "@") {
                    seg = seg.concat([s.substring(1)])
                } else {
                    viaFn = true
                }
                i = i + 1
            }
            // through a function's return: that return is not proven (rule 5 (g))
            if (viaFn) return rinf(infUnres("`@" + n + "` is read back through a function's return"), done)
            return rinf(infCycle(seg), done)
        }
        if (srcIndex(cx.srcs, n) >= 0) {
            const ro: ROwn = ownResolve(cx, n, stack, done)
            return rinf(refInf(ro.t, stack), ro.done)
        }
        if (cx.res) {
            // N2: only a handle of the scope's OWNER, and only when the name is
            // UNIQUE there (the binder's lookup for a program-level body); any
            // other handle reading is not determined
            if (cx.hscope >= 0) {
                let hit: HandleInfo | not = not
                let count = 0
                for (const h of cx.handles) {
                    if (h.name == n && h.owner == cx.hscope) {
                        hit = h
                        count = count + 1
                    }
                }
                // bound twice in one scope: E-HANDLE-REDECLARE (the scope pass) owns it
                if (count > 1) return rinf(infBlamed(), done)
                if (hit is given) {
                    if (hit.conditional) return rinf(infOk(Type.Maybe(Type.Named(hit.target))), done)
                    return rinf(infOk(Type.Named(hit.target)), done)
                }
            }
        }
        const sd: Sym | not = declTypeNamed(cx.te, n)     // s472: the shared instance of a declaration in scope here
        if (sd is given) return rinf(infOk(Type.Named(sd)), done)
        // E-SCOPE-001 (the binder's) — the typer finds it inside the initializer
        return rinf(infOut("`@" + n + "`, which names no cell"), done)
    }

    // A read of a resolved cell: its base type; a cell that failed is its own
    // diagnostic's (blamed) — unless it is on a cycle this read is part of.
    fn refInf(t: OwnT, stack: string[]) -> Inf {
        const ty: Type | not = t.ty
        if (ty is given) return infOk(baseOf(ty))
        const o: TypeOrigin = t.origin
        return match o {
            .Cyclic(names: ns) :> cycleRead(ns, stack)
            .Written :> infBlamed()
            .WrittenUnproven(why: w) :> infBlamed()
            .Literal :> infBlamed()
            .Inferred :> infBlamed()
            .Failed(why: w) :> infBlamed()
            .Boundary(where: b) :> infBlamed()
            .Blamed :> infBlamed()
        }
    }

    fn cycleRead(ns: string[], stack: string[]) -> Inf {
        for (const n of ns) {
            if (stack.indexOf("@" + n) >= 0) return infCycle(ns)
        }
        return infBlamed()
    }

    // Rule 5 (a)'s literals, the qualified variant included — what rule 9's
    // boundary exemption ("a literal own value is unaffected") reads.
    fn literalInit(cx: InferCx, v: AAttrValue) -> boolean {
        if (literalOf(v) is given) return true
        const e: AExpr | not = valueExpr(v)
        if (e is not) return false
        const mo: AExpr | not = memberObj(e)
        if (mo is not) return false
        return qualifiedVariant(cx, mo, memberName(e.k)) is given
    }

    // Rule 5 (a): a QUALIFIED variant `E.V` names its enum — a literal of `E`
    // (the bare `.V` is O35(b), outside the set). `not` when `e` is not one.
    fn qualifiedVariant(cx: InferCx, o: AExpr, n: string) -> Type | not {
        const en: string = exprName(o)
        if (en == "") return not
        const s: TypeStub | not = stubNamed(cx.te, en)
        if (s is not) return not
        if (!s.isEnum) return not
        for (const m of s.members) {
            if (m.hint == n) return Type.Named(s.sym)
        }
        return not
    }

    // RESOLVE mode (F2): the declared type of field `n` of a value typed `t` —
    // a struct's field (its written type), or a declaration's attribute / child
    // field (its written type, or its literal's); `not` when undetermined.
    fn declaredFieldType(cx: InferCx, t: Type, n: string) -> Type | not {
        const s: Sym | not = namedSym(t)
        if (s is not) return not
        const ti: TypeInfo | not = typeInfoOf(cx.types, s)
        if (ti is given) {
            const fs: FieldDef[] | not = structFieldDefs(ti.def)
            if (fs is not) return not
            for (const f of fs) {
                if (f.sym.hint == n) return f.ty
            }
            return not
        }
        for (const ds of cx.decls) {
            const d: ADecl | not = ds.d
            if (ds.sym.id == s.id && d is given) {
                for (const a of d.attrs) {
                    if (a.name == n) return writtenOrLiteral(cx, a.ty, a.dflt)
                }
                for (const c of childFields(d.body)) {
                    if (c.name == n) return writtenOrLiteral(cx, c.ty, c.own)
                }
            }
        }
        return not
    }

    fn namedSym(t: Type) -> Sym | not {
        return match t {
            .Named(sym: s) :> s
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Seq(elem: e) :> not
            .Maybe(inner: i) :> not
        }
    }

    fn writtenOrLiteral(cx: InferCx, aty: AType | not, v: AAttrValue) -> Type | not {
        if (aty is given) {
            const rt: RType = resolveType(cx.te, aty, cx.st)
            if (rt.unresolved) return not
            return rt.t
        }
        return literalOf(v)
    }

    fn inferMember(cx: InferCx, o: AExpr, n: string, stack: string[], ps: ParamT[], done: OwnT[]) -> RInf {
        const qv: Type | not = qualifiedVariant(cx, o, n)
        if (qv is given) return rinf(infOk(qv), done)
        const r: RInf = inferE(cx, o, stack, ps, done)
        if (r.r.kind >= 3) return r
        const t: Type | not = r.r.ty
        if (n != "length") {
            if (cx.res) {
                if (r.r.kind != 0) return r
                if (t is given) {
                    const ft: Type | not = declaredFieldType(cx, t, n)
                    if (ft is given) return rinf(infOk(baseOf(ft)), r.done)
                }
            }
            return rinf(infOut("the member path `." + n + "`"), r.done)
        }
        if (t is not) return r
        const kd: int = kindOf(t)
        if (kd == 2 || kd == 5) return rinf(infOk(Type.Int), r.done)
        return rinf(infOut("`.length` of a `" + typeName(t) + "`"), r.done)
    }

    fn inferUnary(cx: InferCx, o: UnOp, x: AExpr, stack: string[], ps: ParamT[], done: OwnT[]) -> RInf {
        const r: RInf = inferE(cx, x, stack, ps, done)
        if (o != UnOp.Neg) {
            if (cx.res) return rinf(infOk(Type.Bool), r.done)      // `!`, `is given`, `is not` are `bool`
            if (r.r.kind >= 3) return r
            return rinf(infOut(unaryWord(o) + " (a logical operator is not in the inferable set)"), r.done)
        }
        if (r.r.kind != 0) return r
        const t: Type | not = r.r.ty
        if (t is given && isNumericKind(t)) return rinf(infOk(t), r.done)
        return rinf(infOut("unary `-` of a non-number"), r.done)
    }

    fn unaryWord(o: UnOp) -> string {
        return match o {
            .Not :> "`!`"
            .Neg :> "`-`"
            .IsGiven :> "`is given`"
            .IsNot :> "`is not`"
        }
    }

    fn inferBinary(cx: InferCx, o: BinOp, l: AExpr, r: AExpr, stack: string[], ps: ParamT[], done: OwnT[]) -> RInf {
        const rl: RInf = inferE(cx, l, stack, ps, done)
        const rr: RInf = inferE(cx, r, stack, ps, rl.done)
        const d: OwnT[] = rr.done
        const isLogic: boolean = o == BinOp.And || o == BinOp.Or || o == BinOp.Pipe
        const cmp: boolean = o == BinOp.Eq || o == BinOp.Ne || o == BinOp.Lt || o == BinOp.Le || o == BinOp.Gt || o == BinOp.Ge
        // RESOLVE mode: a comparison or `&&` / `||` is a `bool` whatever its
        // operands (the typer's answer, F2) — an operand's own fault is the
        // typer's to report
        // N1 (fix round 2): `&&` / `||` lower to JavaScript's, which returns an
        // OPERAND — they are a determined `bool` only when BOTH operands are
        if (cx.res && cmp) return rinf(infOk(Type.Bool), d)
        const isAndOr: boolean = o == BinOp.And || o == BinOp.Or
        if (cx.res && isAndOr) return rinf(andOrInf(rl.r, rr.r, o), d)
        if (isLogic) {
            const bad: Inf = worse(rl.r, rr.r)
            if (bad.kind >= 3) return rinf(bad, d)
            return rinf(infOut(binWord(o) + " (a logical operator is not in the inferable set)"), d)
        }
        if (rl.r.kind != 0 || rr.r.kind != 0) return rinf(worse(rl.r, rr.r), d)
        const a: Type | not = rl.r.ty
        const b: Type | not = rr.r.ty
        if (a is not || b is not) return rinf(infBlamed(), d)
        if (cmp) return rinf(infOk(Type.Bool), d)
        const nums: boolean = isNumericKind(a) && isNumericKind(b)
        const isDiv: boolean = o == BinOp.Div
        if (isDiv) {
            if (nums) return rinf(infOk(Type.Num), d)
        } else if (nums) {
            if (kindOf(a) == 0 && kindOf(b) == 0) return rinf(infOk(Type.Int), d)
            return rinf(infOk(Type.Num), d)
        }
        const isAdd: boolean = o == BinOp.Add
        if (isAdd && kindOf(a) == 2 && kindOf(b) == 2) return rinf(infOk(Type.Str), d)
        return rinf(infOut(binWord(o) + " over a `" + typeName(a) + "` and a `" + typeName(b) + "`"), d)
    }

    fn binWord(o: BinOp) -> string {
        return match o {
            .Add :> "`+`"
            .Sub :> "`-`"
            .Mul :> "`*`"
            .Div :> "`/`"
            .Mod :> "`%`"
            .Lt :> "`<`"
            .Le :> "`<=`"
            .Gt :> "`>`"
            .Ge :> "`>=`"
            .Eq :> "`==`"
            .Ne :> "`!=`"
            .And :> "`&&`"
            .Or :> "`||`"
            .Pipe :> "`|`"
        }
    }

    fn inferTernary(cx: InferCx, t: AExpr, y: AExpr, n: AExpr, stack: string[], ps: ParamT[], done: OwnT[]) -> RInf {
        const rt: RInf = inferE(cx, t, stack, ps, done)
        const ry: RInf = inferE(cx, y, stack, ps, rt.done)
        const rn: RInf = inferE(cx, n, stack, ps, ry.done)
        const d: OwnT[] = rn.done
        // RESOLVE mode: the test's own fault is the condition rule's (E-COND-NOT-BOOLEAN)
        let testR: Inf = rt.r
        if (cx.res) testR = infOk(Type.Bool)
        if (testR.kind != 0 || ry.r.kind != 0 || rn.r.kind != 0) return rinf(worse(worse(testR, ry.r), rn.r), d)
        const tt: Type | not = testR.ty
        const a: Type | not = ry.r.ty
        const b: Type | not = rn.r.ty
        if (tt is not || a is not || b is not) return rinf(infBlamed(), d)
        if (kindOf(tt) != 3) return rinf(infOut("a ternary whose test is a `" + typeName(tt) + "`"), d)
        const j: Type | not = joinBase(a, b)
        if (j is given) return rinf(infOk(j), d)
        return rinf(infOut("a ternary whose arms are a `" + typeName(a) + "` and a `" + typeName(b) + "`"), d)
    }

    // Rule 5 (g) — only the call's RETURN decides; its arguments are not judged.
    fn inferCall(cx: InferCx, callee: AExpr, stack: string[], done: OwnT[]) -> RInf {
        const n: string = exprName(callee)
        if (n == "") {
            // rule 5 (g): a payload variant's construction `E.V(…)` — its type is `E`, declared
            const mc: MethodCall | not = memberCall(callee)
            if (mc is given) {
                const qv: Type | not = qualifiedVariant(cx, mc.obj, mc.method)
                if (qv is given) return rinf(infOk(qv), done)
                return rinf(infOut("a method call"), done)
            }
            return rinf(infOut("a call of a computed function"), done)
        }
        // s472: the function `n` denotes in the file being read (declared there, or imported)
        let found: FnSrc | not = not
        const from: string = scopeFrom(cx.te.link, cx.te.file, NameKind.KFn, n)
        const orig: string = scopeOrig(cx.te.link, cx.te.file, NameKind.KFn, n)   // s474: an alias names its export
        for (const f of cx.fns) {
            if (f.info.name == orig && f.info.file == from) found = f
        }
        if (found is not) return rinf(infOut("`" + n + "(…)`, which is not a function in scope here"), done)
        const fi: FnInfo = found.info
        const ret: Type | not = fi.ret
        if (ret is given) return rinf(infOk(baseOf(ret)), done)
        const at: AType | not = found.f.ret
        if (at is given) {
            if (isVoidType(at)) return rinf(infOut("`" + n + "(…)`, which returns no value"), done)
            return rinf(infBlamed(), done)            // a written return type that was refused (E-TYPE-UNKNOWN / a parse error)
        }
        if (fi.failable) return rinf(infUnres("`" + n + "(…)` is failable (§19.4), and a failable function has no success type to infer"), done)
        // a server call in a value position is §13.7's E-VALUE-SERVER-CALL
        // (placePass, after the typer — so condBlamed cannot see it): blamed
        if (fi.serverOwn) return rinf(infBlamed(), done)
        const key: string = n + "()"
        if (stack.indexOf(key) >= 0) return rinf(infUnres("`" + n + "(…)`, whose return is not declared and depends on itself"), done)
        const r: RInf = ownProvenReturn(cx, found.f, stack.concat([key]), done)
        return rinf(infIn(r.r, fi.file, found.f), r.done)
    }

    // Rule 5 (g)'s INFERRED-AND-PROVEN return (fix round 1, F2: in RESOLVE
    // mode — every returned value's type DETERMINED, as §66.3 rule 5 lists it:
    // a typed local, a member path through declared types, a comparison;
    // the ruled fail-closed core stays — an unannotated parameter, recursion, a
    // non-total body, a failable or server function). Names resolve through
    // the body's real scopes (F1, retsIn). (The client-call plan's
    // `provenReturn` is a different question: a server function's success type
    // for the wire, §57.4 R10, read off the typer's proven types.)
    fn ownProvenReturn(cx0: InferCx, af: AFn, stack: string[], done: OwnT[]) -> RInf {
        // a program-file function reads the program's handles (the binder's
        // scope for a program-level body); a library function reads none
        let hs: int = -1
        if (cx0.progFile == fileOfFn(cx0, af)) hs = cx0.prog
        // s472: the body's names resolve in the function's OWN file
        const cx: InferCx = withHscope(withRes(cxAt(cx0, fileOfFn(cx0, af)), true), hs)
        const who: string = "`" + af.name + "(…)` declares no return type, and its return is not proven: "
        if (!exits(af.body)) return rinf(infUnres(who + "it does not end in `return` on every path"), done)
        let ps: ParamT[] = []
        for (const p of af.params) {
            let pt: Type | not = not
            const at: AType | not = p.ty
            if (at is given) {
                const rt: RType = resolveType(cx.te, at, cx.st)
                if (!rt.unresolved) pt = rt.t
            }
            ps = ps.concat([{ name: p.name, ty: pt, param: true }])
        }
        const rr: RRets = retsIn(cx, af.body, ps, stack, done)
        let d: OwnT[] = rr.done
        let acc: Type | not = not
        for (const site of rr.rs) {
            const e: AExpr | not = site.e
            if (e is not) return rinf(infUnres(who + "a `return` carries no value"), d)
            const r: RInf = inferE(cx, e, stack, site.sc, d)
            d = r.done
            if (r.r.kind == 3) return rinf(r.r, d)
            const t: Type | not = r.r.ty
            if (r.r.kind != 0 || t is not) return rinf({ ty: not, kind: 2, why: who + r.r.why, cyc: [], at: r.r.at }, d)
            if (acc is not) {
                acc = t
            } else {
                const j: Type | not = joinBase(acc, t)
                if (j is not) return rinf(infUnres(who + "its returns are a `" + typeName(acc) + "` and a `" + typeName(t) + "`"), d)
                acc = j
            }
        }
        if (acc is not) return rinf(infUnres(who + "it never returns a value"), d)
        return rinf(infOk(acc), d)
    }

    // ---- fix round 1, F1: the body's scopes ---------------------------------
    // Every `return` of a block with the names in scope where it stands: a
    // local (`let` / `const`) is in scope after it, in its block; a `given`
    // binding in its body; an arm's binders in its arm block. A local's type
    // is its written one, or — a `const` only — its initializer's DETERMINED
    // type; a `let` without a type, a `given` binding over an undetermined
    // subject and every arm binder are untyped (returning one is not proven).
    // A lambda's body is not walked (its `return` is not the function's).
    fn retsIn(cx: InferCx, b: ABlock, sc0: ParamT[], stack: string[], done0: OwnT[]) -> RRets {
        let sc: ParamT[] = sc0
        let done: OwnT[] = done0
        let out: RetAt[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const r: RRets = match k {
                .Return(e: x) :> retsInMaybe(cx, x, sc, stack, done)
                .If(cond: c, thenB: tb, elseB: eb) :> retsIf(cx, c, tb, eb, sc, stack, done)
                .Given(name: n, subject: x, body: gb) :> retsGiven(cx, n, x, gb, sc, stack, done)
                .For(f: lf) :> retsFor(cx, lf, sc, stack, done)
                .Break(label: x) :> noRets(done)
                .Continue(label: x) :> noRets(done)
                .Lift(what: w) :> retsInList(cx, liftExprs(w), sc, stack, done)
                .Eval(e: x) :> retsInExpr(cx, x, sc, stack, done)
                .Local(name: n, init: i) :> retsInExpr(cx, i, sc, stack, done)
                .EffectStmt(w: w) :> noRets(done)
                .Defer(body: db) :> noRets(done)
                .Fail(f: x) :> noRets(done)
            }
            out = out.concat(r.rs)
            done = r.done
            const ret: AExpr | not = returnedExpr(k)
            if (isReturn(k)) out = out.concat([{ e: ret, sc: sc }])
            const lb: RBind = localBinding(cx, k, sc, stack, done)
            done = lb.done
            if (lb.b is given) sc = sc.concat([lb.b])
        }
        return { rs: out, done: done }
    }

    type RBind:struct = { b: ParamT | not, done: OwnT[] }

    fn noRets(done: OwnT[]) -> RRets { return { rs: [], done: done } }
    fn noBind(done: OwnT[]) -> RBind { return { b: not, done: done } }

    fn localBinding(cx: InferCx, k: AStmtK, sc: ParamT[], stack: string[], done: OwnT[]) -> RBind {
        return match k {
            .Local(name: n, mutable: m, ty: t, init: i) :> localOf(cx, n, m, t, i, sc, stack, done)
            .Return(e: x) :> noBind(done)
            .If(cond: c) :> noBind(done)
            .Given(name: n) :> noBind(done)
            .For(f: lf) :> forBinding(cx, lf, done)        // s469: a bound loop binds its name (§49.6)
            .Lift(what: x) :> noBind(done)
            .Break(label: x) :> noBind(done)
            .Continue(label: x) :> noBind(done)
            .Eval(e: x) :> noBind(done)
            .EffectStmt(w: w) :> noBind(done)
            .Defer(body: db) :> noBind(done)
            .Fail(f: x) :> noBind(done)
        }
    }

    // s469 — a bound loop's binder: its written type, else untyped (returning
    // it is not proven — write the function's return type).
    fn forBinding(cx: InferCx, f: AFor, done: OwnT[]) -> RBind {
        const b: AForBound | not = f.bound
        if (b is not) return noBind(done)
        const aty: AType | not = b.ty
        if (aty is given) {
            const rt: RType = resolveType(cx.te, aty, cx.st)
            if (!rt.unresolved) return { b: { name: b.name, ty: rt.t, param: false }, done: done }
        }
        return { b: { name: b.name, ty: not, param: false }, done: done }
    }

    fn localOf(cx: InferCx, n: string, mutable: boolean, aty: AType | not, init: AExpr, sc: ParamT[], stack: string[], done: OwnT[]) -> RBind {
        if (aty is given) {
            const rt: RType = resolveType(cx.te, aty, cx.st)
            if (rt.unresolved) return { b: { name: n, ty: not, param: false }, done: done }
            return { b: { name: n, ty: rt.t, param: false }, done: done }
        }
        if (mutable) return { b: { name: n, ty: not, param: false }, done: done }
        const r: RInf = inferE(cx, init, stack, sc, done)
        return { b: { name: n, ty: r.r.ty, param: false }, done: r.done }
    }

    fn isReturn(k: AStmtK) -> boolean {
        return match k {
            .Return(e: x) :> true
            .If(cond: c) :> false
            .Given(name: n) :> false
            .For(f: lf) :> false
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: x) :> false
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: db) :> false
            .Fail(f: x) :> false
        }
    }

    fn returnedExpr(k: AStmtK) -> AExpr | not {
        return match k {
            .Return(e: x) :> x
            .If(cond: c) :> not
            .Given(name: n) :> not
            .For(f: lf) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: x) :> not
            .Eval(e: x) :> not
            .Local(name: n) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: db) :> not
            .Fail(f: x) :> not
        }
    }

    fn retsInMaybe(cx: InferCx, e: AExpr | not, sc: ParamT[], stack: string[], done: OwnT[]) -> RRets {
        if (e is not) return { rs: [], done: done }
        return retsInExpr(cx, e, sc, stack, done)
    }

    fn retsIf(cx: InferCx, c: AExpr, tb: ABlock, eb: ABlock | not, sc: ParamT[], stack: string[], done: OwnT[]) -> RRets {
        const rc: RRets = retsInExpr(cx, c, sc, stack, done)
        const rt: RRets = retsIn(cx, tb, sc, stack, rc.done)
        if (eb is not) return { rs: rc.rs.concat(rt.rs), done: rt.done }
        const re: RRets = retsIn(cx, eb, sc, stack, rt.done)
        return { rs: rc.rs.concat(rt.rs).concat(re.rs), done: re.done }
    }

    // `given n = subject :> { … }`: `n` is the subject narrowed (its `T`).
    fn retsGiven(cx: InferCx, n: string, x: AExpr, gb: ABlock, sc: ParamT[], stack: string[], done: OwnT[]) -> RRets {
        const rx: RRets = retsInExpr(cx, x, sc, stack, done)
        const r: RInf = inferE(cx, x, stack, sc, rx.done)
        let ty: Type | not = r.r.ty
        if (ty is given) ty = unMaybe(ty)
        const rb: RRets = retsIn(cx, gb, sc.concat([{ name: n, ty: ty, param: false }]), stack, r.done)
        return { rs: rx.rs.concat(rb.rs), done: rb.done }
    }

    // The `return`s inside an expression's handling-form arm blocks (they
    // leave the function); an arm's binders are in scope in its block, untyped.
    fn retsInList(cx: InferCx, es: AExpr[], sc: ParamT[], stack: string[], done0: OwnT[]) -> RRets {
        let done: OwnT[] = done0
        let out: RetAt[] = []
        for (const e of es) {
            const r: RRets = retsInExpr(cx, e, sc, stack, done)
            out = out.concat(r.rs)
            done = r.done
        }
        return { rs: out, done: done }
    }

    fn retsInExpr(cx: InferCx, e: AExpr, sc: ParamT[], stack: string[], done0: OwnT[]) -> RRets {
        const k: AExprK = e.k
        if (isLambdaK(k)) return { rs: [], done: done0 }
        let done: OwnT[] = done0
        let out: RetAt[] = []
        const h: AHandled | not = handledOf(k)
        if (h is given) {
            const rs: RRets = retsInExpr(cx, h.subject, sc, stack, done)
            out = out.concat(rs.rs)
            done = rs.done
            for (const arm of handledArms(h)) {
                const sc2: ParamT[] = sc.concat(armBinders(arm.pat))
                const ab: AArmBody = arm.body
                const ra: RRets = match ab {
                    .ArmBlock(b: b) :> retsIn(cx, b, sc2, stack, done)
                    .ArmExpr(e: x) :> retsInExpr(cx, x, sc2, stack, done)
                }
                out = out.concat(ra.rs)
                done = ra.done
            }
            return { rs: out, done: done }
        }
        for (const x of exprKids(e)) {
            const r: RRets = retsInExpr(cx, x, sc, stack, done)
            out = out.concat(r.rs)
            done = r.done
        }
        return { rs: out, done: done }
    }

    fn isLambdaK(k: AExprK) -> boolean {
        return match k {
            .Lambda(params: lp) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    fn armBinders(p: APat) -> ParamT[] {
        return match p {
            .PName(name: n, binds: bs) :> bindersOf(bs)
            .PWild :> []
            .PWhole(bind: b) :> bindersOf([b])
            .PBare(bind: b) :> bindersOf([b])
            .PNot :> []
            .PLit(e: x) :> []
        }
    }

    fn bindersOf(bs: ABind[]) -> ParamT[] {
        let out: ParamT[] = []
        for (const b of bs) {
            if (b.name != "_") out = out.concat([{ name: b.name, ty: not, param: false }])
        }
        return out
    }

    // A field's type origin when no type is written (§66.3 rules 3, 5, 7, 8).
    // A program cell (`where` 2) reads the table; a child field infers over it.
    // An ATTRIBUTE default is left as it was before S462 — O35(a) is OPEN
    // (fix round 1, F7 (c)): a literal infers (rule 3), anything else has no
    // type and reports nothing new (the bootstrap's parser refuses an untyped
    // attribute whole).
    fn ownOrigin(cx: InferCx, tab: OwnT[], name: string, init: AAttrValue, role: FieldRole, where: int) -> OwnT {
        if (where == 2) {
            const t: OwnT | not = ownFound(tab, name)
            if (t is given) return t
        }
        const lit: Type | not = literalOf(init)
        if (lit is given) return { name: name, ty: lit, origin: TypeOrigin.Literal }
        const r: RInf = inferValue(cx, init, [], [], tab)
        const isLit: boolean = literalInit(cx, init)
        const isAttr: boolean = role == FieldRole.Attribute
        if (isAttr && !isLit) return { name: name, ty: not, origin: TypeOrigin.Blamed }
        return { name: name, ty: r.r.ty, origin: originOf(r.r, name, isLit) }
    }

    // Rule 10: a WRITTEN type over an initializer whose value's type cannot be
    // resolved — judged in RESOLVE mode (F2: a comparison is a `bool`, a
    // member path through declared types is resolved, whatever a sub-call is).
    fn writtenOrigin(cx: InferCx, tab: OwnT[], name: string, init: AAttrValue, where: int) -> TypeOrigin {
        let stack: string[] = []
        if (where == 2) stack = ["@" + name]
        let hs: int = -1
        if (where == 2) hs = cx.prog
        const r: RInf = inferValue(withHscope(withRes(cx, true), hs), init, stack, [], tab)
        if (r.r.kind == 2) return TypeOrigin.WrittenUnproven(r.r.why, r.r.at)
        return TypeOrigin.Written
    }

    // Rule 9: where an own value's type leaves the compile ("" — it does not).
    // `server` (rule 9 (ii)) is NOT read: the bootstrap's parser refuses
    // `server` on a declaration whole (E-BOOTSTRAP-UNSUPPORTED), and a second
    // report on a refused construct would be a cascade. When `server` lands
    // in the bootstrap, it joins here (boundaryReport already words it).
    fn boundaryOf(exported: boolean, mods: AAttr[]) -> string {
        if (attrNamed(mods, "persist") is given) return "persist"
        if (exported) return "export"
        return ""
    }

    fn hasFlag(mods: AAttr[], name: string) -> boolean {
        for (const m of mods) {
            if (m.name == name) return true
        }
        return false
    }

    type RFields:struct = { fs: FieldInfo[], st: AS }
    type RField:struct = { f: FieldInfo, st: AS }

    // One field: its type, mode (§66.9), grants (L3/L18, §66.12), graph, capability.
    // `vals` / `where` (s444 Phase B): the field's validators, and where the
    // field stands — 0 an attribute (it has none, §66.4 rule 1), 1 a child
    // field of a user declaration, 2 a program cell (a top-level value — it
    // has the surface, §55.5.1, S447). Both 1 and 2 are honored.
    // s462 (§66.3 rules 5–10): `ix` / `tab` — the own-value inference context
    // and the program's table (ownTable); `bnd` — where the type leaves the
    // compile (boundaryOf: "persist" / "server" / "export", or "").
    fn fieldOf(te: TypeEnv, g: TypeInfo[], nid: int, span: ASpan, name: string, isLet: boolean, exported: boolean,
               aty: AType | not, init: AAttrValue, body: ADeclChild[], role: FieldRole, vals: AValidator[], where: int,
               ix: InferCx, tab: OwnT[], bnd: string, st0: AS) -> RField {
        let st: AS = st0
        const rs: RSym = mint(reservedName(st, te.file, span, name), name)
        st = rs.st
        let ty: Type = Type.Str
        let seqRep = false
        let resolved = true
        let origin: TypeOrigin = TypeOrigin.Written
        if (aty is given) {
            const rt: RType = resolveType(te, aty, st)
            ty = rt.t
            resolved = !rt.unresolved     // r8: an unknown type name → untrusted
            st = rt.st
            seqRep = seqReplace(aty)
            // rule 10 is ruled for OWN values (program cells, child fields); an
            // attribute default's `:T` over an unprovable call is not judged
            // here (the same hole — surfaced for a ruling, not widened into)
            if (resolved && role == FieldRole.Child) origin = writtenOrigin(ix, tab, name, init, where)
        } else {
            // s462: inferred (§66.3 rule 3 / rule 5), or — outside the set — no
            // type at all: the field is untrusted (nothing is checked against a
            // type the program never had; the typer reports why, originReport)
            const ot: OwnT = ownOrigin(ix, tab, name, init, role, where)
            const inf: Type | not = ot.ty
            if (inf is given) {
                ty = inf
            } else {
                resolved = false
            }
            origin = ot.origin
            if (bnd != "" && role == FieldRole.Child && !literalInit(ix, init)) origin = TypeOrigin.Boundary(bnd)
        }
        // s469 review r2: through `| not` too — `let <xs:int[] | not=…/>` is `let` on a sequence
        if (isLet && seqElem(unMaybe(ty)) is given) {
            st = addDiag(st, te.file, span, "E-GRANT-LET-ON-SEQUENCE", "`let` on a sequence — write `replace` in the type's grants (O3 ruled)")
        }
        const rg: RGraph = graphOf(te, g, ty, body, st)
        st = rg.st
        const reads: string[] = valueReads(init)
        let edits: EditKind[] = typeEdits(ty)
        // s473: a DERIVED value's state-children carry no transition grant (§51.0.J
        // "Direct writes … REJECTED"; derivedRules below) — so it gets no write
        // capability and is printed as a Derived that recomputes, never seeded
        if (rg.graph is given && (isLet || reads.length == 0)) edits = edits.concat([EditKind.Transition])
        // s444: a sequence of structs whose element fields carry their own
        // `let` grants an ELEMENT-field write (`@xs[i].f = v`, dpa-052 Q3) —
        // listed as FieldAt(path) over the element struct (Core EditKind note)
        let elemEdits: EditKind[] = []
        const et: Type | not = seqElem(ty)
        if (et is given) elemEdits = subFieldEdits(g, et)
        const grantRep: boolean = isLet || seqRep
        const grantEdits: EditKind[] = edits.concat(subFieldEdits(g, ty)).concat(elemEdits)
        let mode: FieldMode = FieldMode.Locked
        if (isLet) {
            if (reads.length > 0) {
                mode = FieldMode.Seeded
            } else {
                mode = FieldMode.Let
            }
        } else if (reads.length > 0) {
            // s473 (p5 hole 2, g-boot-derived-single-with-state-children-seeded-s473):
            // §66.9 rule 3 "A locked declaration whose initializer reads cells is
            // DERIVED" — state-children do not change that (O5, RULED S435:
            // "`derived=` RETIRES (a locked declaration with a reactive initializer
            // is derived, §66.9)"; §51.0.J: a derived engine keeps its
            // state-children). Before this, state-children made it SEEDED — read
            // once, stale after. A `rule=` on such a state-child is §51.0.J's
            // E-DERIVED-ENGINE-NO-RULES ("Transitions are determined by the
            // source, not authored"); `let` is the seeded, writable form.
            mode = FieldMode.Derived
            if (rg.graph is given) st = derivedRules(te.file, body, st)
        }

        let wcap: Sym | not = not
        if (grantsAny(fieldGrantSet(grantRep, grantEdits))) {
            const rw: RSym = mint(st, name)
            wcap = rw.s
            st = rw.st
        }
        // s449 — §55.5.3 case 1: "`isValid`, `errors`, `touched` and `submitted`
        // SHALL NOT be used as … the name of a child field (child declaration) or
        // an attribute of any declaration — every compound has the surface (Edge
        // B), so a field by one of these names would shadow it." A top-level
        // value's own name is "Not affected" (where 2). Case 2 (a field of a
        // validated value's STRUCT type) cannot arise here: the bootstrap admits
        // validators only on string / number values (fieldVals).
        if (where != 2 && isSurfaceProp(name)) {
            st = addDiag(st, te.file, span, "E-VALIDITY-RESERVED-NAME", "`" + name + "` is a reserved validity-surface name — a field or attribute by this name would hide the declaration's synthesized `." + name + "` (§55.5.3); rename it")
        }
        const rv: RVals = fieldVals(te.file, name, ty, mode, vals, where, st)
        st = rv.st
        const f: FieldInfo = {
            nid: nid, span: span, annotated: aty is given, trusted: resolved, typeSpan: typeSpanOf(aty), sym: rs.s, ty: ty, mode: mode, role: role, grants: fieldGrantSet(grantRep, grantEdits), graph: rg.graph,
            exported: exported, wcap: wcap, init: init, reads: reads, shrink: shrinkOf(aty), vals: rv.vs, valsWritten: vals.length,
            origin: origin,
        }
        return { f: f, st: st }
    }

    // =========================================================================
    // s444 Phase B — VALIDATORS (dpa-058, RULED S442); s449 — evaluated by the
    // §55 surface and enforced by the §55.17 gate. The bootstrap's runtime
    // evaluates `req` on a string, `length` of a string against an int literal,
    // `min` / `max` against a numeric literal, and a `pattern` whose HTML
    // `pattern` form is exact; each also lowers to its HTML-native attribute
    // (RULED S442 (2), §55.17.1) on the controls that bind the value. Any other
    // validator is not evaluated yet, so it is refused (E-BOOTSTRAP-UNSUPPORTED)
    // — never kept inert (g-bootstrap-validity-errors-value-and-messages-unbuilt).
    // =========================================================================
    type RVals:struct = { vs: ValInfo[], st: AS }
    type RVal:struct = { v: ValInfo | not, st: AS }

    fn fieldVals(file: string, name: string, ty: Type, mode: FieldMode, vals: AValidator[], where: int, st0: AS) -> RVals {
        let st: AS = st0
        if (vals.length == 0) return { vs: [], st: st }
        if (where != 1 && where != 2) return { vs: [], st: addDiag(st, file, vals[0].span, "E-BOOTSTRAP-UNSUPPORTED", "validators here are not in the bootstrap (only on a top-level value or a child field of a declaration)") }
        const isDerived: boolean = mode == FieldMode.Derived
        if (isDerived) {
            return { vs: [], st: addDiag(st, file, vals[0].span, "E-DERIVED-WITH-VALIDATORS", "`" + name + "` is derived (a locked declaration whose initializer reads cells) — validators on a derived value are rejected (§55.14); constrain it with a refinement type instead") }
        }
        let out: ValInfo[] = []
        for (const v of vals) {
            const r: RVal = valInfoOf(file, ty, v, st)
            st = r.st
            const vi: ValInfo | not = r.v
            if (vi is given) out = out.concat([vi])
        }
        return { vs: out, st: st }
    }

    // s449 — B3 is RULED (S447, user-voice "validated top-level cells get a
    // validity surface (Edge A reversed)" item 1; SPEC §55.5.1): a top-level
    // value that carries validators has the surface, bound or not, and its
    // validators lower onto every control that binds it (§55.17.1) — the
    // former `topLevelValidatorsLower()` switch is gone: a program cell's
    // validators take the same path as a child field's. Dead is §55.5.2
    // (validatorPass).

    fn noSurfaceMsg(what: string) -> string {
        return what + " — the bootstrap's validity surface does not evaluate this validator yet (it evaluates `req` on a string, `length` of a string against an int literal, `min` / `max` against a numeric literal, and an exact `pattern`, §55.1); it is refused rather than left inert"
    }

    fn pair(n: string, v: string) -> HtmlAttrPair { return { name: n, value: v } }

    fn valOk(v: AValidator, attrs: HtmlAttrPair[], core: Validator, st: AS) -> RVal {
        return { v: { name: v.name, span: v.span, attrs: attrs, core: core }, st: st }
    }

    fn valBad(file: string, v: AValidator, code: string, msg: string, st: AS) -> RVal {
        return { v: not, st: addDiag(st, file, v.span, code, msg) }
    }

    fn isStrLike(t: Type) -> boolean {
        const mi: Type | not = maybeInner(t)
        if (mi is given) return mi == Type.Str
        return t == Type.Str
    }

    fn isNumLike(t: Type) -> boolean {
        let x: Type = t
        const mi: Type | not = maybeInner(t)
        if (mi is given) x = mi
        return x == Type.Int || x == Type.Num
    }

    fn valInfoOf(file: string, ty: Type, v: AValidator, st: AS) -> RVal {
        const a: AValArg = v.arg
        return match a {
            .NoArgs :> bareVal(file, ty, v, st)
            .Cmp(op: op, e: x) :> cmpVal(file, ty, v, op, x, st)
            .Exprs(es: es) :> exprsVal(file, ty, v, es, st)
            .Regex(source: src, flags: fl) :> regexVal(file, ty, v, src, fl, st)
        }
    }

    // `req` (§55.1: `""` fails, `not` fails) → `required` on a STRING value: HTML
    // `required` fails exactly the empty value. On a boolean it would mean
    // "checked" (not exact); on a number / sequence / struct there is no form.
    fn bareVal(file: string, ty: Type, v: AValidator, st: AS) -> RVal {
        if (v.name != "req") return valBad(file, v, "E-PARSE-ATTR", "`" + v.name + "` needs its argument: `" + v.name + "(…)` (§55.1)", st)
        if (isStrLike(ty)) return valOk(v, [pair("required", "")], Validator.Req, st)
        return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`req` on a `" + typeName(ty) + "` value"), st)
    }

    // `length(>=N)` / `(<=N)` / `(>N)` / `(<N)` / `(==N)` on a string, N an int
    // literal → `minlength` / `maxlength` (integer lengths: `> N` is `>= N+1`).
    fn cmpVal(file: string, ty: Type, v: AValidator, op: string, x: AExpr, st: AS) -> RVal {
        if (v.name != "length") return valBad(file, v, "E-PARSE-ATTR", "`" + v.name + "(" + op + " …)` — only `length` takes a comparison (§55.1)", st)
        if (!isStrLike(ty) && seqElem(ty) is not) return valBad(file, v, "E-TYPE-031", "`length(…)` applies to a string or a sequence, and this value is `" + typeName(ty) + "` (§55.1)", st)
        const n: int = intLit(x)
        if (!isStrLike(ty) || n < 0) return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`length(" + op + " …)` here (not a string's length against an int literal)"), st)
        const lc: Validator = Validator.LengthCmp(op, n)
        if (op == ">=") return valOk(v, [pair("minlength", "" + n)], lc, st)
        if (op == ">") return valOk(v, [pair("minlength", "" + (n + 1))], lc, st)
        if (op == "<=") return valOk(v, [pair("maxlength", "" + n)], lc, st)
        if (op == "<" && n >= 1) return valOk(v, [pair("maxlength", "" + (n - 1))], lc, st)
        if (op == "==") return valOk(v, [pair("minlength", "" + n), pair("maxlength", "" + n)], lc, st)
        return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`length(" + op + " " + n + ")`"), st)
    }

    // `min(n)` / `max(n)` on a number, n a numeric literal → `min` / `max`. A
    // Level-1 message (`req("…")`, §55.10) has no reader in the bootstrap (no
    // `messageFor`, no `<errors>`). The rest of §55.1 has no HTML form.
    fn exprsVal(file: string, ty: Type, v: AValidator, es: AExpr[], st: AS) -> RVal {
        if (v.name == "req") return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", "`req(\"…\")` — a Level-1 message (§55.10): the bootstrap's `<errors of=…/>` renders only the Level-3 default messages, so the inline message would be dropped; write `req` and let the default message render", st)
        if (v.name == "length") return valBad(file, v, "E-PARSE-ATTR", "`length(…)` takes a comparison: `length(>=N)` (§55.1)", st)
        if (v.name == "pattern") return valBad(file, v, "E-PARSE-ATTR", "`pattern(…)` takes a regex literal: `pattern(/…/)` (§55.1)", st)
        if (v.name == "min" || v.name == "max") {
            if (!isNumLike(ty)) return valBad(file, v, "E-TYPE-031", "`" + v.name + "(…)` applies to a number, and this value is `" + typeName(ty) + "` (§55.1)", st)
            const lit: string = numLitText(es)
            if (lit == "") return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`" + v.name + "(…)` with a non-literal bound"), st)
            const bound: number = Number(lit)
            let mc: Validator = Validator.Max(bound)
            if (v.name == "min") mc = Validator.Min(bound)
            return valOk(v, [pair(v.name, lit)], mc, st)
        }
        return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`" + v.name + "(…)`"), st)
    }

    // `pattern(/re/)` on a string → `pattern="re"` ONLY WHEN EXACT (RULED S442
    // (2), dpa-058 D6): no flags, anchored `^…$`, no top-level alternation, and
    // written in the subset that reads the same under HTML's `v`-mode regex.
    fn regexVal(file: string, ty: Type, v: AValidator, src: string, flags: string, st: AS) -> RVal {
        if (v.name != "pattern") return valBad(file, v, "E-PARSE-ATTR", "`" + v.name + "(…)` does not take a regex (§55.1)", st)
        if (!isStrLike(ty)) return valBad(file, v, "E-TYPE-031", "`pattern(…)` applies to a string, and this value is `" + typeName(ty) + "` (§55.1)", st)
        if (flags != "" || !exactPattern(src)) {
            return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`pattern(/" + src + "/" + flags + ")` — a pattern is admitted only when its HTML `pattern` attribute says the same (no flags, `^…$` anchoring, no top-level `|`, plain characters / classes), so the browser's attribute and the surface agree"), st)
        }
        return valOk(v, [pair("pattern", src)], Validator.Pattern(src), st)
    }

    // The value of a non-negative int literal (-1: not one).
    fn intLit(x: AExpr) -> int {
        const k: AExprK = x.k
        return match k {
            .Num(raw: r) :> intOfRaw(r)
            .Name(name: n) :> -1
            .At(name: n) :> -1
            .AtItem :> -1
            .Str(v: s) :> -1
            .Bool(v: b) :> -1
            .NotLit :> -1
            .Recovered :> -1
            .Variant(name: n) :> -1
            .Member(obj: o) :> -1
            .Call(callee: c) :> -1
            .Unary(op: o) :> -1
            .Binary(op: o) :> -1
            .Ternary(test: t) :> -1
            .Assign(target: t) :> -1
            .ArrayLit(elems: es) :> -1
            .ObjectLit(props: ps) :> -1
            .Spread(e: sx) :> -1
            .Index(obj: ix) :> -1
            .Lambda(params: lp) :> -1
            .Sql(q: q) :> -1
            .Handled(h: x) :> -1
            .Template(quasis: qs) :> -1
            .Foreign(f: fb0) :> -1
        }
    }

    fn intOfRaw(r: string) -> int {
        if (numType(r) != Type.Int || isRadixLiteral(r)) return -1
        const n: number = Number(r)
        return n
    }

    // The text of the one numeric literal argument (`-` allowed) — "" otherwise.
    fn numLitText(es: AExpr[]) -> string {
        if (es.length != 1) return ""
        const k: AExprK = es[0].k
        return match k {
            .Num(raw: r) :> decimalText(r)
            .Unary(op: o, e: x) :> negText(o, x)
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: xs) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    fn decimalText(r: string) -> string {
        if (isRadixLiteral(r)) return ""
        return r
    }

    fn negText(o: UnOp, x: AExpr) -> string {
        const isNeg: boolean = o == UnOp.Neg
        if (!isNeg) return ""
        const t: string = numLitText([x])
        if (t == "") return ""
        return "-" + t
    }

    // EXACT as HTML's `pattern` (compiled `^(?:p)$` with the `v` flag): anchored
    // `^…$`, no `|` outside a group, and only the plain subset — letters,
    // digits, `_`, space, `.`, `*`, `+`, `?`, `@`, `-` (outside a class),
    // groups `(…)` / `(?:…)`, `{n}` / `{n,m}`, the escapes `\d \w \s \D \W \S`
    // and escaped syntax characters, and classes of letters / digits / `_` /
    // ranges / those escapes. Anything else is not claimed exact.
    fn exactPattern(src: string) -> boolean {
        if (src.length < 2) return false
        if (src.substring(0, 1) != "^") return false
        if (src.substring(src.length - 1) != "$") return false
        if (src.length >= 2 && src.substring(src.length - 2, src.length - 1) == "\\") return false
        let i = 1
        let depth = 0
        const end: int = src.length - 1
        while (i < end) {
            const c: string = src.substring(i, i + 1)
            if (c == "\\") {
                if (!safeEscape(src.substring(i + 1, i + 2))) return false
                i = i + 2
            } else if (c == "[") {
                const close: int = classEnd(src, i + 1)
                if (close < 0) return false
                i = close + 1
            } else if (c == "(") {
                depth = depth + 1
                if (src.substring(i + 1, i + 2) == "?") {
                    if (src.substring(i + 2, i + 3) != ":") return false
                    i = i + 3
                } else {
                    i = i + 1
                }
            } else if (c == ")") {
                depth = depth - 1
                if (depth < 0) return false
                i = i + 1
            } else if (c == "|") {
                if (depth == 0) return false
                i = i + 1
            } else if (c == "{") {
                const q: int = quantEnd(src, i + 1)
                if (q < 0) return false
                i = q + 1
            } else if (plainChar(c) || c == "." || c == "*" || c == "+" || c == "?" || c == "-") {
                i = i + 1
            } else {
                return false
            }
        }
        return depth == 0
    }

    fn plainChar(c: string) -> boolean {
        if (c == "_" || c == " " || c == "@") return true
        return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
    }

    fn alnum(c: string) -> boolean {
        return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
    }

    fn safeEscape(c: string) -> boolean {
        return c == "d" || c == "w" || c == "s" || c == "D" || c == "W" || c == "S" ||
               c == "." || c == "*" || c == "+" || c == "?" || c == "(" || c == ")" || c == "[" || c == "]" ||
               c == "{" || c == "}" || c == "|" || c == "^" || c == "$" || c == "/" || c == "\\"
    }

    // The index of the `]` closing a class opened before `from` (-1: not in the subset).
    fn classEnd(src: string, from: int) -> int {
        let i: int = from
        if (src.substring(i, i + 1) == "^") i = i + 1
        let first = true
        while (i < src.length) {
            const c: string = src.substring(i, i + 1)
            if (c == "]") {
                if (first) return -1
                return i
            }
            if (c == "\\") {
                const e: string = src.substring(i + 1, i + 2)
                if (!(e == "d" || e == "w" || e == "s" || e == "D" || e == "W" || e == "S")) return -1
                i = i + 2
            } else if (alnum(c) && src.substring(i + 1, i + 2) == "-" && alnum(src.substring(i + 2, i + 3))) {
                i = i + 3
            } else if (alnum(c) || c == "_") {
                i = i + 1
            } else {
                return -1
            }
            first = false
        }
        return -1
    }

    // The index of the `}` ending a `{n}` / `{n,}` / `{n,m}` quantifier (-1: not one).
    fn quantEnd(src: string, from: int) -> int {
        let i: int = from
        let digits = 0
        while (i < src.length && src.substring(i, i + 1) >= "0" && src.substring(i, i + 1) <= "9") {
            i = i + 1
            digits = digits + 1
        }
        if (digits == 0) return -1
        if (src.substring(i, i + 1) == ",") {
            i = i + 1
            while (i < src.length && src.substring(i, i + 1) >= "0" && src.substring(i, i + 1) <= "9") { i = i + 1 }
        }
        if (src.substring(i, i + 1) != "}") return -1
        return i
    }

    type RGraph:struct = { graph: TransitionGraph | not, st: AS }

    // L18 / §66.13.2: state-children with `rule=` make the field's value a graph
    // (O52 ruled: a state-child names a variant of the field's enum).
    fn graphOf(te: TypeEnv, g: TypeInfo[], ty: Type, body: ADeclChild[], st0: AS) -> RGraph {
        let st: AS = st0
        let children: AStateChild[] = []
        for (const c of body) { children = children.concat(stateChildOf(c)) }
        if (children.length == 0) return { graph: not, st: st }
        const es: Sym | not = isEnumType(g, ty)
        if (es is not) {
            return { graph: not, st: addDiag(st, te.file, children[0].span, "E-DECL-STATE-CHILD", "state-children need an enum-valued field (§66.13.2)") }
        }
        let edges: Edge[] = []
        let seen: int[] = []
        for (const c of children) {
            const origin: int = variantIndex(g, es, c.name)
            if (origin >= 0 && seen.indexOf(origin) >= 0) {
                // r1 nit: one state-child per variant
                st = addDiag(st, te.file, c.span, "E-DECL-STATE-CHILD", "`<" + c.name + ">` is declared twice in this graph — a variant has one state-child (its edges and body)")
            }
            seen = seen.concat([origin])
            if (origin < 0) {
                st = addDiag(st, te.file, c.span, "E-DECL-STATE-CHILD", "`<" + c.name + ">` is not a variant of `" + es.hint + "` (O52: a state-child names a variant of the enclosing field)")
            } else {
                let targets: int[] = []
                for (const a of c.attrs) {
                    if (a.name == "rule") {
                        const names: string[] = ruleNames(a.value)
                        for (const n of names) {
                            const ti: int = variantIndex(g, es, n)
                            if (ti < 0) {
                                st = addDiag(st, te.file, a.span, "E-DECL-STATE-CHILD", "`rule=." + n + "`: not a variant of `" + es.hint + "`")
                            } else {
                                targets = targets.concat([ti])
                            }
                        }
                    } else {
                        // s451: any other attribute on a state-child (`show=`,
                        // `title=`, …) was read by nothing — silently ignored.
                        st = addDiag(st, te.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on the state-child `<" + c.name + ">` is not in the bootstrap — a state-child reads only `rule=` (§66.13.2); the attribute would be ignored")
                    }
                }
                edges = edges.concat([{ origin: origin, targets: targets }])
            }
        }
        return { graph: { enumSym: es, edges: edges }, st: st }
    }

    // §51.0.J: every `rule=` on a state-child of a DERIVED value.
    fn derivedRules(file: string, body: ADeclChild[], st0: AS) -> AS {
        let st: AS = st0
        for (const c of body) {
            for (const sc of stateChildOf(c)) {
                for (const a of sc.attrs) {
                    if (a.name == "rule") st = addDiag(st, file, a.span, "E-DERIVED-ENGINE-NO-RULES", "`rule=` on the state-child `<" + sc.name + ">` of a derived value — a locked declaration whose initializer reads cells is derived (§66.9 rule 3), and a derived value's transitions are determined by its source, not authored (§51.0.J). Remove `rule=`, or write `let` before the `<` for a value seeded once from its initializer and then moved along its rules")
                }
            }
        }
        return st
    }

    fn stateChildOf(c: ADeclChild) -> AStateChild[] {
        return match c {
            .StateChild(s: s) :> [s]
            .ChildField(d: d) :> []
        }
    }

    // `rule=.X` or `rule=(.X | .Y)` → the variant names.
    fn ruleNames(v: AAttrValue) -> string[] {
        return match v {
            .Bare(e: e) :> altNames(e)
            .Paren(e: e) :> altNames(e)
            .NoValue :> []
            .Quoted(v: s) :> []
            .Braced(b: b) :> []
        }
    }

    fn altNames(e: AExpr) -> string[] {
        const k: AExprK = e.k
        return match k {
            .Variant(name: n) :> [n]
            .Binary(op: o, l: l, r: r) :> altNames(l).concat(altNames(r))
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    fn childFields(body: ADeclChild[]) -> ADecl[] {
        let out: ADecl[] = []
        for (const c of body) { out = out.concat(childFieldOf(c)) }
        return out
    }

    fn childFieldOf(c: ADeclChild) -> ADecl[] {
        return match c {
            .ChildField(d: d) :> [d]
            .StateChild(s: s) :> []
        }
    }

    // A user declaration's fields (L17): attributes in opener order, then child
    // fields in body order.
    fn userFields(te: TypeEnv, g: TypeInfo[], d: ADecl, ix: InferCx, tab: OwnT[], st0: AS) -> RFields {
        let st: AS = st0
        let out: FieldInfo[] = []
        for (const a of d.attrs) {
            const r: RField = fieldOf(te, g, a.nid, a.span, a.name, a.isLet, a.exported, a.ty, a.dflt, [], FieldRole.Attribute, [], 0, ix, tab, "", st)
            out = out.concat([r.f])
            st = r.st
        }
        for (const c of childFields(d.body)) {
            if (hasFlag(c.mods, "single")) {
                // s442, §66.13.4: the Move-20 invariant — one declaration site
                // inside N instances cannot be one instance.
                st = addDiag(st, te.file, c.span, "E-COMPONENT-ENGINE-SCOPE", "`<" + c.name + " … single>` is a `single` declaration inside the multi-instance declaration `<" + d.name + ">` — every `<" + d.name + ">` instance would share one `" + c.name + "`. Drop `single`: an ordinary child field gives each `<" + d.name + ">` its own `" + c.name + "` (§66.13.4)")
            }
            const r2: RField = fieldOf(te, g, c.nid, c.span, c.name, c.isLet, c.exported, c.ty, c.own, c.body, FieldRole.Child, c.validators, 1, ix, tab, boundaryOf(c.exported, c.mods), st)
            out = out.concat([r2.f])
            st = r2.st
        }
        return { fs: out, st: st }
    }

    // The program's fields: the declarations directly in its body (L14).
    fn programFields(te: TypeEnv, g: TypeInfo[], p: AProgram, ix: InferCx, tab: OwnT[], st0: AS) -> RFields {
        let st: AS = st0
        let out: FieldInfo[] = []
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (isNestedUserDecl(d)) {
                    // a user declaration (stubbed by withNestedStubs), not a field
                } else {
                    const r: RField = fieldOf(te, g, d.nid, d.span, d.name, d.isLet, d.exported, d.ty, d.own, d.body, FieldRole.Child, d.validators, 2, ix, tab, boundaryOf(d.exported, d.mods), st)
                    out = out.concat([r.f])
                    st = r.st
                }
            }
        }
        return { fs: out, st: st }
    }

    fn declsOfItem(it: AItem) -> ADecl[] {
        const k: AItemK = it.k
        return match k {
            .DeclItem(d: d) :> [d]
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .MarkupItem(n: n) :> []
            .ProgramItem(p: p) :> []
            .ConstItem(c: c) :> []
        }
    }

    // ---- handles (L10) ---------------------------------------------------------------
    // Walk a renders: every USE with `as=` binds a handle on the nearest
    // enclosing `<each>` row, else on the declaration. Conditional = under an
    // `if=` (inside the same row scope).
    type RHandles:struct = { hs: HandleInfo[], st: AS }
    type HWalk:struct = { owner: int, conditional: boolean, file: string }

    fn handlesIn(g0: ScopedStub[], nodes: ANode[], w: HWalk, st0: AS) -> RHandles {
        let st: AS = st0
        let out: HandleInfo[] = []
        for (const n of nodes) {
            const r: RHandles = handlesInNode(g0, n, w, st)
            out = out.concat(r.hs)
            st = r.st
        }
        return { hs: out, st: st }
    }

    fn handlesInNode(g0: ScopedStub[], n: ANode, w: HWalk, st: AS) -> RHandles {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> handlesInElem(g0, e, w, st)
            .Text(text: t) :> noHandles(st)
            .Interp(e: x) :> noHandles(st)
            .DeclNode(d: d) :> noHandles(st)
            .Css(c: c) :> noHandles(st)
            .Gather(f: lf) :> handlesIn(g0, gatherRows(lf), w, st)
            .Effect(w: w) :> noHandles(st)
        }
    }

    fn noHandles(st: AS) -> RHandles { return { hs: [], st: st } }

    fn attrNamed(attrs: AAttr[], name: string) -> AAttr | not {
        for (const a of attrs) {
            if (a.name == name) return a
        }
        return not
    }

    fn bareName(v: AAttrValue) -> string {
        return match v {
            .Bare(e: e) :> exprName(e)
            .Paren(e: e) :> exprName(e)
            .Quoted(v: s) :> ""
            .NoValue :> ""
            .Braced(b: b) :> ""
        }
    }

    fn exprName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> n
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // s472: the decl stubs a file can name — each user declaration in scope there
    // (handlesIn's `g0`: a tag names one of these). s474: one per LOCAL name it is
    // bound under (an aliased import binds it as the alias), so a tag names it by
    // that name. (The program is no tag's target.)
    type ScopedStub:struct = { local: string, d: DeclStub }

    fn stubsInScope(ds: DeclStub[], lk: Linkage, file: string) -> ScopedStub[] {
        let out: ScopedStub[] = []
        for (const d of ds) {
            if (!d.isProgram) {
                for (const local of boundAs(lk, file, NameKind.KDecl, d.sym.hint, d.file)) { out = out.concat([{ local: local, d: d }]) }
            }
        }
        return out
    }

    fn stubNamedDecl(g0: ScopedStub[], name: string) -> DeclStub | not {
        for (const s of g0) {
            if (s.local == name) return s.d
        }
        return not
    }

    fn handlesInElem(g0: ScopedStub[], e: AElem, w: HWalk, st0: AS) -> RHandles {
        let st: AS = st0
        let out: HandleInfo[] = []
        const cond: boolean = w.conditional || attrNamed(e.attrs, "if") is given || attrNamed(e.attrs, "else-if") is given || attrNamed(e.attrs, "else") is given
        if (e.tag == "each" && !e.star) {
            // a row scope: handles inside it live on the row, conditional relative to the row
            const r: RHandles = handlesIn(g0, e.kids, { owner: e.nid, conditional: false, file: w.file }, st)
            return { hs: r.hs, st: r.st }
        }
        const target: DeclStub | not = stubNamedDecl(g0, e.tag)
        if (target is given && !e.star) {
            const as: AAttr | not = attrNamed(e.attrs, "as")
            if (as is given) {
                const name: string = bareName(as.value)
                if (name == "") {
                    st = addDiag(st, w.file, as.span, "E-DECL-AS", "`as=` takes a name")
                } else {
                    const rs: RSym = mint(reservedName(st, w.file, as.span, name), name)
                    st = rs.st
                    out = out.concat([{ sym: rs.s, name: name, target: target.sym, owner: w.owner, conditional: cond,
                                        span: as.span, file: w.file }])
                }
            }
        }
        const r2: RHandles = handlesIn(g0, e.kids, { owner: w.owner, conditional: cond, file: w.file }, st)
        return { hs: out.concat(r2.hs), st: r2.st }
    }

    fn markupNodes(items: AItem[]) -> ANode[] {
        let out: ANode[] = []
        for (const it of items) { out = out.concat(markupOf(it)) }
        return out
    }

    fn markupOf(it: AItem) -> ANode[] {
        const k: AItemK = it.k
        return match k {
            .MarkupItem(n: n) :> [n]
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
            .ProgramItem(p: p) :> []
            .ConstItem(c: c) :> []
        }
    }

    fn rendersNodes(ds: DeclStub) -> ANode[] {
        const p: AProgram | not = ds.p
        if (p is given) return markupNodes(p.items)
        const d: ADecl | not = ds.d
        if (d is not) return []
        const r: AElem | not = d.renders
        if (r is not) return []
        return [{ nid: -1, span: r.span, k: ANodeK.Elem(r) }]
    }

    // ---- functions ---------------------------------------------------------------------
    type RFns:struct = { fs: FnSrc[], st: AS }

    fn fnsOf(files: FileAst[], te: TypeEnv, st0: AS) -> RFns {
        let st: AS = st0
        let out: FnSrc[] = []
        for (const f of files) {
            const fte: TypeEnv = teAt(te, f.path)
            for (const af of fnItems(f.items)) {
                // s473: a db cell's load `@rows` is minted as `load$rows` (its Sym hint names generated code)
                // s474: a composed batch `#book` is minted as `book#batch` (composeFiles; the printers write `#` as `_`)
                let hint: string = af.name
                if (isLoadName(af.name)) hint = "load$" + af.name.substring(1)
                if (isBatchName(af.name)) hint = af.name.substring(1) + "#batch"   // r1 (review L3): `#` — no identifier spells it
                const r: RSym = mint(reservedName(st, f.path, af.span, af.name), hint)
                st = r.st
                // each signature component is judged by its own type
                // expression: the return type alone, the parameter list as a
                // whole (an untyped or mis-typed parameter voids the arity)
                let ret: Type | not = not
                const at: AType | not = af.ret
                if (at is given) {
                    if (!isVoidType(at) && !hasErrIn(f.errs, at.span)) {
                        const rt: RType = resolveType(fte, at, st)
                        // guard (i), r7 A: a return type that did not resolve
                        // (E-TYPE-UNKNOWN answers with a placeholder type) is
                        // left unresolved — never checked against, never trusted
                        if (!rt.unresolved) ret = rt.t
                        st = rt.st
                    }
                }
                let arity: int = af.params.length
                if (!paramsTrusted(f.errs, af.params)) arity = -1
                const re: RErrType = errTypeOf(fte, f, af, st)
                st = re.st
                const info: FnInfo = { nid: af.nid, span: af.span, sym: r.s, name: af.name, file: f.path,
                                       exported: af.exported, pure: af.pure, arity: arity, ret: ret,
                                       failable: af.failable, err: re.err,
                                       serverOwn: af.server || sqlsInBlock(af.body).length > 0, rerr: not, host: not }
                st = addBind(st, af.nid, BindFact.BBind(r.s))
                out = out.concat([{ info: info, f: af }])
            }
        }
        return { fs: out, st: st }
    }

    // =========================================================================
    // s472 (boot-math-port) — HOST-BACKED FUNCTIONS: the §21.3.1 WRAPPER RULE.
    // ruling:user-voice-scrml.md S472 "host function type, math API, remaining
    // review debt" item 1: "an `import:host` binding is usable ONLY as the
    // direct callee of a `return` in a fully typed scrml function; the
    // wrapper's signature IS the host function's type, and the returned value
    // is decoded against it at that point". Read here (SPEC §21.3.1): the
    // wrapper's WHOLE body is `return h(p1, …, pn);` — `h` an admitted host
    // binding of the function's own file, `p1 … pn` the function's own
    // parameters in declaration order (so the host function receives exactly
    // the wrapper's arguments, and its type is the wrapper's signature and
    // nothing else) — and the function writes its return type, is not `!` and
    // not `server`. One wrapper per binding (a host function has one type).
    // Every other use of a host binding is E-HOST-BINDING-USE (resolveName).
    // The bootstrap carries scalars across the boundary: parameters `int` /
    // `number` / `string` / `bool`, a result of one of those or its `T | not`;
    // any other wrapper type is E-BOOTSTRAP-UNSUPPORTED at the wrapper (F3 §5.4
    // also decodes enums, structs and tapes — not built here).
    // =========================================================================
    // A host binding's call site as the rule judged it: `nid` the callee name's
    // node, `wrapper` the function it stands in. `ok`: the call IS the host call.
    // Not ok: `why` says why it is not (E-HOST-BINDING-USE at the use), or is ""
    // when the wrapper already carries the report (an unsupported type).
    type HostSite:struct = { nid: int, wrapper: Sym, ok: boolean, why: string }
    type RHostFns:struct = { fs: FnSrc[], sites: HostSite[], st: AS }
    type CallParts:struct = { callee: AExpr, args: AExpr[] }

    fn hostWrappers(files: FileAst[], te: TypeEnv, fs0: FnSrc[], st0: AS) -> RHostFns {
        let st: AS = st0
        let out: FnSrc[] = []
        let sites: HostSite[] = []
        let wrapped: string[] = []   // the bindings already wrapped, as "<file> <local>"
        for (const fs of fs0) {
            let next: FnSrc = fs
            const c: CallParts | not = wholeReturnCall(fs.f.body)
            if (c is given) {
                const h: string = exprName(c.callee)
                const b: AImport | not = hostImportBinding(files, fs.info.file, h)
                if (b is given && h != "" && !paramNamed(fs.f.params, h) && hostImportAdmitted(fs.info.file, b)) {
                    const key: string = fs.info.file + " " + h
                    const why: string = wrapperShapeWhy(fs, c, h, wrapped.indexOf(key) >= 0)
                    if (why != "") {
                        sites = sites.concat([{ nid: c.callee.nid, wrapper: fs.info.sym, ok: false, why: why }])
                    } else if (fs.info.ret is not) {
                        // a written return type that was refused carries its own report
                        sites = sites.concat([{ nid: c.callee.nid, wrapper: fs.info.sym, ok: false, why: "" }])
                    } else {
                        wrapped = wrapped.concat([key])
                        const unsup: string = wrapperTypeWhy(teAt(te, fs.info.file), fs, st)
                        if (unsup != "") {
                            st = addDiag(st, fs.info.file, fs.f.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + fs.info.name + "` wraps the host function `" + h + "` (§21.3.1), but " + unsup + " — the bootstrap carries only `int`, `number`, `string` and `bool` values (and a `T | not` result of one) across the host boundary")
                            sites = sites.concat([{ nid: c.callee.nid, wrapper: fs.info.sym, ok: false, why: "" }])
                        } else {
                            const loc: HostLoc | not = hostLocOf(fs.info.file, b.from)
                            const rt: Type | not = fs.info.ret
                            if (loc is given && rt is given) {
                                const hf: HostFn = { module: loc.module, file: loc.file, name: hostOrigOf(b, h), ret: rt, bind: not }
                                next = { info: fnWithHost(fs.info, hf), f: fs.f }
                                sites = sites.concat([{ nid: c.callee.nid, wrapper: fs.info.sym, ok: true, why: "" }])
                            }
                        }
                    }
                }
            }
            out = out.concat([next])
        }
        return { fs: out, sites: sites, st: st }
    }

    // s472 (boot-math-port) — FAIL CLOSED: a host-backed function is an ordinary
    // function, placed wherever it is called; route placement never makes one a
    // server function of its own (its body is the host call — nothing server-only).
    // Should it ever (a placement rule this did not foresee), the Core has no
    // server-side host-backed function to print it as — refused, never printed
    // without its body.
    fn hostPlacedDiags(fns: FnInfo[], servers: int[]) -> Diag[] {
        let out: Diag[] = []
        for (const f of fns) {
            if (f.host is given && servers.indexOf(f.sym.id) >= 0) {
                out = out.concat([newDiag("E-BOOTSTRAP-UNSUPPORTED", "the host-backed `" + f.name + "` (§21.3.1.1) was placed on the server as a server function of its own — the bootstrap prints a host-backed function only as an ordinary function (a bootstrap defect: please report it)", f.file, f.span)])
            }
        }
        return out
    }

    // =========================================================================
    // s473 (boot-host-block-f3) — `<host>` BINDINGS (DRAFT SPEC §21.3.3).
    // ruling:user-voice-scrml.md S473 "⭐ RULED — S473 PA recs, all" item 4 —
    // "F3 typed host binding Q1–Q5: a `<host>` block; `-> waiting T`; `!
    // HostError`; closed `:host` handles; checked results."
    //
    // The parser desugared each binding into a function item with an empty body
    // (FileAst.hosts keeps the target), so rule 9 — "A binding is a function
    // bound in file scope (§7.6) … Its calls are checked like any call: wrong
    // arity is `E-CALL-ARITY`, a wrong argument type is `E-TYPE-031` … A
    // binding name that is also bound in its file as a value … SHALL be
    // `E-SCOPE-010`" — holds by construction: every pass sees an ordinary
    // function. Here each binding the bootstrap can carry becomes HOST-BACKED
    // (FnInfo.host with a HostBind — Core keeps its signature, no body, and the
    // printer emits the target as literal JavaScript, rule 7).
    //
    // What the bootstrap carries across the boundary (else E-BOOTSTRAP-UNSUPPORTED
    // at the binding, naming the rule not built):
    //   - a parameter: `int` / `number` / `string` / `bool`, a declared `:host`
    //     handle, or the `T | not` of one (rule 12 — those cross "in its runtime
    //     representation"; a struct or tape argument's deep fresh copy is not
    //     built);
    //   - a result: those, a struct whose fields are results, a tape of results
    //     (rule 13's decode); not an enum (the §41.13 parseVariant decode is not
    //     built), not a declaration type, not a DOM element type (rule 16 — the
    //     bootstrap has no DOM element types).
    // Rule 10 (S473 round 2 item 3): "Server-side `<host>` bindings SHALL be
    // allowed only in a compiler-bundled stdlib module file … In any other file,
    // a binding is client-only" — an adopter binding is client-only for route
    // analysis (domsInExpr); a stdlib module's `<host>` (server-side bindings)
    // is not built and refused by name.
    // =========================================================================
    fn hostDefOf(s: TypeStub, st: AS) -> RTypeDef {
        return { def: TypeDef.HostDef(s.sym), st: st }
    }

    fn isHostDef(td: TypeDef) -> boolean {
        return match td {
            .HostDef(sym: s) :> true
            .StructDef(sym: s) :> false
            .EnumDef(sym: s) :> false
        }
    }

    // Is `t` a declared `:host` handle type?
    fn isHostType(ts: TypeInfo[], t: Type) -> boolean {
        const s: Sym | not = namedOf(t)
        if (s is not) return false
        const ti: TypeInfo | not = typeInfoOf(ts, s)
        if (ti is not) return false
        return isHostDef(ti.def)
    }

    // Does `t` contain a declared `:host` type at any depth (a `T | not`, a
    // tape element, a struct field, an enum payload)? `depth` bounds a cyclic type.
    fn containsHost(ts: TypeInfo[], t: Type, depth: int) -> boolean {
        if (depth > 12) return false
        if (isHostType(ts, t)) return true
        const mi: Type | not = maybeInner(t)
        if (mi is given) return containsHost(ts, mi, depth + 1)
        const el: Type | not = seqElemOf(t)
        if (el is given) return containsHost(ts, el, depth + 1)
        const s: Sym | not = namedOf(t)
        if (s is not) return false
        const ti: TypeInfo | not = typeInfoOf(ts, s)
        if (ti is not) return false
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is given) {
            for (const f of fs) {
                if (containsHost(ts, f.ty, depth + 1)) return true
            }
        }
        for (const v of enumVariants(ti.def)) {
            for (const f of v.fields) {
                if (containsHost(ts, f.ty, depth + 1)) return true
            }
        }
        return false
    }

    fn seqElemOf(t: Type) -> Type | not {
        return match t {
            .Seq(elem: e) :> e
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Named(sym: s) :> not
            .Maybe(inner: i) :> not
        }
    }

    // The FileAst.hosts record of the function item `nid` in `file`; `not`: not a binding.
    fn hostBindOf(files: FileAst[], file: string, nid: int) -> AHostBind | not {
        for (const f of files) {
            if (f.path == file) {
                for (const h of f.hosts) { if (h.fn == nid) return h }
            }
        }
        return not
    }

    fn isHostBindFn(files: FileAst[], fs: FnSrc) -> boolean {
        return hostBindOf(files, fs.info.file, fs.f.nid) is given
    }

    fn hostBindings(files: FileAst[], te: TypeEnv, types: TypeInfo[], fs0: FnSrc[], st0: AS) -> RFns {
        let st: AS = st0
        let out: FnSrc[] = []
        for (const fs of fs0) {
            let next: FnSrc = fs
            const hb: AHostBind | not = hostBindOf(files, fs.info.file, fs.f.nid)
            if (hb is given && !hasErrIn(fileErrs(files, fs.info.file), fs.f.span)) {
                if (isStdlibPath(fs.info.file)) {
                    st = addDiag(st, fs.info.file, fs.f.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + fs.info.name + "` is a `<host>` binding in a stdlib module file — a compiler-bundled stdlib module's bindings may be reached from server code too (§21.3.3 rule 10, S473 ruling), and those server-side bindings are not in the bootstrap yet; the module keeps the §21.3.1.1 `import:host` wrapper form")
                } else {
                    // s473-host-allowlist-b: rule 8 — the typed chain walk over the host surface
                    const hwk: HSurfWalk = hostWalk(teAt(te, fs.info.file), types, fs, hb, st)
                    const why: string = hostBindTypeWhy(teAt(te, fs.info.file), types, fs, st)
                    if (hwk.hcode != "") {
                        st = addDiag(st, fs.info.file, hostWalkSpan(fs, hb), hwk.hcode, hwk.hmsg)
                    } else if (why != "") {
                        st = addDiag(st, fs.info.file, fs.f.span, "E-BOOTSTRAP-UNSUPPORTED", "the `<host>` binding `" + fs.info.name + "` " + why)
                    } else {
                        const bind: HostBind | not = hostBindCore(fs.f.params, hb, fs.info.name, fs.info.file, hwk.hguards)
                        if (bind is given) {
                            const hf: HostFn = { module: "", file: "", name: fs.info.name, ret: fs.info.ret, bind: bind }
                            next = { info: fnWithHost(fs.info, hf), f: fs.f }
                        } else {
                            // FAIL CLOSED: a binding the parser accepted always converts; should one not,
                            // it is refused here — never left an ordinary function with an empty body
                            st = addDiag(st, fs.info.file, fs.f.span, "E-BOOTSTRAP-UNSUPPORTED", "the `<host>` binding `" + fs.info.name + "`'s target could not be carried into Core (a bootstrap defect: please report it)")
                        }
                    }
                }
            }
            out = out.concat([next])
        }
        return { fs: out, st: st }
    }

    // =========================================================================
    // s473-host-allowlist-b — RULE 8, THE TYPED CHAIN WALK (DRAFT SPEC §21.3.3
    // rule 8, Appendix H; host-surface.scrml is the surface).
    //
    // Rulings (user-voice-scrml.md, S473): "§21.3.3 rule 8 becomes an ALLOWLIST.
    // A binding may call or read only what the allowlist admits; everything else
    // is refused at compile time." · Q1 "the unit is option (d), a curated
    // surface typed by interface" · Q2 "WebIDL interface names are built-in
    // scrml types, replacing user-named handles" · Q4 "existing bindings get a
    // hard error now".
    //
    // It replaces #1659's INTERIM denylist (parse.scrml hostSinkWhy and its
    // three name tables): instead of guessing what a handle might hold, every
    // receiver has a static interface, and every step is an Appendix H entry.
    //   8.2 the root: `window` / `document` / `navigator`, or a parameter typed
    //       by an Appendix H interface (`I | not` included); a parameter of a
    //       user `:host` type declared in the same `<host src=>` is the `src=`
    //       world (8.6, not walked); anything else is E-HOST-ROOT-OPAQUE.
    //   8.3 each member but the last a `read` entry whose result is an
    //       interface; the last an entry of the target's access (call /
    //       construct / read / write); else E-HOST-TARGET-NOT-ALLOWED. An entry
    //       url.scrml's sink table disagrees with is never admitted (one source).
    //   8.4 arguments assignable to the entry's slots (E-HOST-ARG-TYPE), the
    //       declared result one the entry yields (E-HOST-RESULT-TYPE).
    //   8.5 guarded(attr-name) judged here on the literal name; a literal URL
    //       judged here by §5.2's test (E-ATTR-STATIC-EXECUTABLE); the run-time
    //       guards and the 8.7 brand check are lane A's — until built, an entry
    //       needing one is refused by name (host-surface.scrml runtimeGuardsBuilt).
    // The walk runs only on a target whose shape parse.scrml accepted (rule 4).
    // =========================================================================
    type HSurfWalk:struct = { hcode: string, hmsg: string, hguards: string[] }
    type HArgFit:struct = { w: HSurfWalk, tag: string, url: boolean, urlLit: string }

    fn hwOk() -> HSurfWalk { return { hcode: "", hmsg: "", hguards: [] } }
    fn hw(code: string, msg: string) -> HSurfWalk { return { hcode: code, hmsg: msg, hguards: [] } }
    fn haOk() -> HArgFit { return { w: hwOk(), tag: "", url: false, urlLit: "" } }
    fn haBad(code: string, msg: string) -> HArgFit { return { w: hw(code, msg), tag: "", url: false, urlLit: "" } }

    fn hostWalkSpan(fs: FnSrc, hb: AHostBind) -> ASpan {
        const tg: AExpr | not = hb.target
        if (tg is given) return tg.span
        return fs.f.span
    }

    // A scrml type in the surface's slot notation (Appendix H.1): `int`, `number`,
    // `string`, `bool`, `T[]`, `T | not`, an Appendix H interface by name, and
    // `host:N` / `struct:N` / `enum:N` for a user type (never an interface).
    fn hostSlotText(types: TypeInfo[], t: Type) -> string {
        return match t {
            .Int :> "int"
            .Num :> "number"
            .Str :> "string"
            .Bool :> "bool"
            .Maybe(inner: i) :> hostSlotText(types, i) + " | not"
            .Seq(elem: e) :> hostSlotText(types, e) + "[]"
            .Named(sym: s) :> hostNamedText(types, s)
        }
    }

    fn hostNamedText(types: TypeInfo[], s: Sym) -> string {
        const ti: TypeInfo | not = typeInfoOf(types, s)
        if (ti is not) return "?"
        if (isHostDef(ti.def)) {
            if (ti.file == builtinFile() && isSurfaceIface(ti.name)) return ti.name
            return "host:" + ti.name
        }
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is given) return "struct:" + ti.name
        return "enum:" + ti.name
    }

    fn stripNot(t: string) -> string {
        if (t.endsWith(" | not")) return t.substring(0, t.length - 6)
        return t
    }

    // Is a value of slot text `h` (no `| not`) assignable to the alternative `w`?
    // WebIDL inheritance for interfaces; `int` into `number`.
    fn hostCoreFits(h: string, w: string) -> boolean {
        if (h == w) return true
        if (h == "int" && w == "number") return true
        if (isSurfaceIface(h) && isSurfaceIface(w)) return ifaceInherits(h, w)
        if (h.endsWith("[]") && w.endsWith("[]")) return hostCoreFits(h.substring(0, h.length - 2), w.substring(0, w.length - 2)) && h.substring(0, h.length - 2) == w.substring(0, w.length - 2)
        return false
    }

    // A parameter of type `h` in a slot of type `w` (8.4).
    fn hostArgFits(h: string, w: string) -> boolean {
        if (h.endsWith(" | not") && !slotAdmitsNot(w)) return false
        const hc: string = stripNot(h)
        for (const alt of slotAlternatives(w)) {
            if (hostCoreFits(hc, alt)) return true
        }
        return false
    }

    // An entry's result `r` (no `waiting`) against a declared result `d` (8.4):
    // "ok"; "down" — a subinterface (a downcast, brand-checked at run time, 8.7);
    // "bad". A widening (`T` declared as a supertype, or as `T | not`) is ok; a
    // result that admits `not` declared without it is bad.
    fn hostResultVerdict(r: string, d: string) -> string {
        if (r.endsWith(" | not") && !d.endsWith(" | not")) return "bad"
        const rc: string = stripNot(r)
        const dc: string = stripNot(d)
        if (rc == dc) return "ok"
        if (rc == "int" && dc == "number") return "ok"
        if (rc == "number" && dc == "int") return "ok"   // rule 13 decodes `int` (integral, ±(2^53−1))
        if (isSurfaceIface(rc) && isSurfaceIface(dc)) {
            if (ifaceInherits(rc, dc)) return "ok"
            if (ifaceInherits(dc, rc)) return "down"
            return "bad"
        }
        if (rc.endsWith("[]") && dc.endsWith("[]")) return hostResultVerdict(rc.substring(0, rc.length - 2), dc.substring(0, dc.length - 2))
        return "bad"
    }

    fn hostNotAllowed(name: string, iface: string, member: string, access: string) -> HSurfWalk {
        const there: string[] = accessesOf(iface, member)
        let note: string = ""
        if (there.length > 0) note = " (the surface has `" + iface + "." + member + "` only as: " + there.join(", ") + ")"
        return hw("E-HOST-TARGET-NOT-ALLOWED", "the target of `" + name + "` uses `" + member + "` (" + access + ") on `" + iface + "`, which is not on the host surface" + note + " — a binding may reach only an Appendix H entry of its receiver's interface with that access (§21.3.3 rule 8.3). Bind it through a `src=` file instead: `<host src=\"./glue.js\">` (rule 8.6; the surface changes only by SPEC amendment, rule 8.8)")
    }

    fn hostParamSlot(te: TypeEnv, types: TypeInfo[], p: AParam, st: AS) -> string {
        const at: AType | not = p.ty
        if (at is not) return "?"
        const rt: RType = resolveType(te, at, st)
        return hostSlotText(types, rt.t)
    }

    fn hostWalk(te: TypeEnv, types: TypeInfo[], fs: FnSrc, hb: AHostBind, st: AS) -> HSurfWalk {
        const tg: AExpr | not = hb.target
        if (tg is not) return hwOk()                      // no target: a `src=` export (8.6)
        const parts: HTargetParts = hostTargetParts(tg, hb.isNew)
        if (!parts.ok || !parts.chain.ok) return hwOk()   // rule 4 — parse.scrml reported it
        const name: string = fs.info.name
        const ps: AParam[] = fs.f.params
        const root: string = parts.chain.root
        let cur: string = ""
        if (root == "window") cur = "Window"
        if (root == "document") cur = "Document"
        if (root == "navigator") cur = "Navigator"
        if (cur == "") {
            const pi: int = paramIndexOf(ps, root)
            if (pi < 0) return hwOk()                     // rule 4 — E-HOST-TARGET-UNBOUND (parse.scrml)
            const rs: string = hostParamSlot(te, types, ps[pi], st)
            const core: string = stripNot(rs)
            if (isSurfaceIface(core)) {
                cur = core
            } else if (core.startsWith("host:") && hb.src != "" && hb.blockTypes.indexOf(core.substring(5, core.length)) >= 0) {
                return hwOk()                             // 8.6 — the `src=` world, not walked
            } else {
                let what: string = "`" + rs + "`, which is not an Appendix H interface"
                if (core.startsWith("host:")) what = "the user-named handle type `" + core.substring(5, core.length) + "`, which is a receiver only inside the `<host src=>` block that declares it (rule 8.6)"
                return hw("E-HOST-ROOT-OPAQUE", "the target of `" + name + "` is rooted at the parameter `" + root + "` of type " + what + " — a target's root is `window`, `document`, `navigator`, or a parameter typed by an Appendix H interface (§21.3.3 rule 8.2); a data value, `asIs` or a callback is not a host receiver")
            }
        }
        const ms: string[] = parts.chain.members
        // `inert@k`: the receiver of chain member k SHALL pass the run-time inert-receiver check
        // (rule 8.5) — every guarded(inert-receiver) entry on the chain, a mid-chain read included
        // (`e.classList.add(t)`: the classList read is guarded). The static type is never the proof.
        let inertAt: string[] = []
        let i: int = 0
        while (i < ms.length - 1) {
            const e0: HEntry | not = findEntry(cur, ms[i], "read")
            if (e0 is not) return hostNotAllowed(name, cur, ms[i], "read")
            if (entryGuards(e0).indexOf("inert-receiver") >= 0) inertAt = inertAt.concat(["inert@" + i])
            const r0: string = sigResult(e0)
            if (!isSurfaceIface(r0)) return hw("E-HOST-TARGET-NOT-ALLOWED", "the target of `" + name + "` continues past `" + cur + "." + ms[i] + "`, whose result is `" + r0 + "`, not an interface — each member of a chain but the last SHALL be a `read` entry whose result is an interface (§21.3.3 rule 8.3); read it in a binding of its own, test it, and pass it on")
            cur = r0
            i = i + 1
        }
        const last: string = ms[ms.length - 1]
        let access: string = "call"
        if (parts.shape == 1) access = "construct"
        if (parts.shape == 2) access = "read"
        if (parts.shape == 3) access = "write"
        const e1: HEntry | not = findEntry(cur, last, access)
        if (e1 is not) return hostNotAllowed(name, cur, last, access)
        const e: HEntry = e1
        const conflict: string = entryConflict(e)
        if (conflict != "") return hw("E-HOST-TARGET-NOT-ALLOWED", "the target of `" + name + "` uses `" + cur + "." + last + "` (" + access + "): " + conflict + " — one sink table, never a second list (§21.3.3 rule 8.3)")
        // 8.4 — the arguments
        let tagIface: string = ""
        let attrUrl: boolean = false
        let urlLit: string = ""
        let urlAttr: string = last
        if (access == "write") {
            const fa: HArgFit = hostArgFit(te, types, ps, parts.args[0], e.sig, name, st)
            if (fa.w.hcode != "") return fa.w
            urlLit = fa.urlLit
        } else if (access == "call" || access == "construct") {
            const slots: string[] = sigParams(e)
            let required: int = 0
            for (const sl of slots) { if (!slotOptional(sl)) required = required + 1 }
            if (parts.args.length > slots.length || parts.args.length < required) {
                return hw("E-HOST-ARG-TYPE", "the target of `" + name + "` passes " + parts.args.length + " argument(s) to `" + cur + "." + last + "`, whose entry takes " + e.sig + " (§21.3.3 rule 8.4, Appendix H " + e.id + ")")
            }
            let j: int = 0
            for (const x of parts.args) {
                const fa: HArgFit = hostArgFit(te, types, ps, x, slotType(slots[j]), name, st)
                if (fa.w.hcode != "") return fa.w
                if (fa.tag != "") tagIface = fa.tag
                if (fa.url) {
                    attrUrl = true
                    urlAttr = fa.urlLit
                }
                if (attrUrl && j == 1) urlLit = fa.urlLit
                j = j + 1
            }
            // a URL-valued attribute's value literal (`setAttribute("href", "…")`): judged below
            if (attrUrl && parts.args.length > 1) {   // #1674 r1 N1: removeAttribute has one argument
                const vv: HView = hostView(parts.args[1])
                urlLit = ""
                if (vv.k == 4) urlLit = vv.name
            }
        }
        // 8.4 — the result
        let r: string = sigResult(e)
        const rw: boolean = r.startsWith("waiting ")
        r = unWaiting(r)
        if (tagIface != "") r = tagIface
        if (rw && !hb.waiting) return hw("E-HOST-RESULT-TYPE", "`" + name + "` reaches `" + cur + "." + last + "`, whose result is `waiting " + r + "` — declare the binding `-> waiting " + r + "` (§21.3.3 rules 8.4, 17)")
        const dr: Type | not = fs.info.ret
        if (hb.hasResult && dr is given) {
            const d: string = hostSlotText(types, dr)
            const dc: string = stripNot(d)
            let v: string = "bad"
            if (r == "void") {
                v = "bad"
            } else if (dc.startsWith("host:")) {
                v = "bad"
            } else if (dc.startsWith("struct:") && isSurfaceIface(stripNot(r))) {
                v = hostStructFromIface(types, dr, stripNot(r))
                if (v == "ok" && r.endsWith(" | not") && !d.endsWith(" | not")) v = "bad"
            } else {
                v = hostResultVerdict(r, d)
            }
            // #1674 review I1: a `createElement` result is EXACTLY its literal tag's interface (H.4), so a
            // declared subinterface of it can never pass the brand check — refused at compile time
            if (v == "down" && tagIface != "") return hw("E-HOST-RESULT-TYPE", "`" + name + "` declares `-> " + d + "` for `createElement`, but the literal tag makes exactly `" + r + "` (Appendix H.4) — the result would always fail its brand check (§21.3.3 rules 8.4, 8.7); declare `-> " + r + "`")
            if (v == "down" && !brandChecksBuilt()) return hw("E-BOOTSTRAP-UNSUPPORTED", "`" + name + "` declares `-> " + d + "`, a subinterface of the entry's result `" + r + "` (a downcast) — it is admitted with a run-time brand check (§21.3.3 rules 8.4, 8.7), which is not in this build yet; declare `-> " + r + "`")
            if (v == "bad") {
                let why: string = "the entry yields `" + r + "`"
                if (dc.startsWith("host:")) why = "a user-named `:host` type is never the result of a surface entry (rule 8.6)"
                if (dc.startsWith("struct:")) why = "a struct result of an interface-valued entry declares only fields that are `read` entries of that interface, of compatible types"
                return hw("E-HOST-RESULT-TYPE", "`" + name + "` declares `-> " + d + "` for `" + cur + "." + last + "` (" + access + ") — " + why + " (§21.3.3 rule 8.4, Appendix H " + e.id + ")")
            }
        }
        // 8.5 — the guards
        let guards: string[] = []
        for (const g of entryGuards(e)) { if (g != "attr-name") guards = guards.concat([g]) }
        if (attrUrl && guards.indexOf("url") < 0) guards = guards.concat(["url"])
        if (guards.indexOf("url") >= 0 && urlLit != "") {
            if (!urlValueAdmitted(urlAttr, urlLit)) return hw("E-ATTR-STATIC-EXECUTABLE", "the target of `" + name + "` writes the URL `" + urlLit + "` to `" + urlAttr + "`, whose scheme (`" + schemeOfUrl(urlLit) + ":`) is not admitted — a `guarded(url)` entry's literal value is judged at compile time by §5.2 rule 2's test (§21.3.3 rule 8.5)")
            let rest: string[] = []
            for (const g of guards) { if (g != "url") rest = rest.concat([g]) }
            guards = rest
        }
        if (guards.length > 0 && !runtimeGuardsBuilt()) return hw("E-BOOTSTRAP-UNSUPPORTED", "`" + name + "` reaches `" + cur + "." + last + "` (" + access + "), a `guarded(" + guards.join(", ") + ")` entry (Appendix H " + e.id + ") — its run-time check (§21.3.3 rule 8.5) is not in this build yet, so the entry is refused rather than run unguarded")
        // the run-time checks the printer emits (print.scrml hostBindJs): every guard of the entry,
        // a statically admitted literal URL included (the guard is cheap and the emission one shape)
        if (entryGuards(e).indexOf("inert-receiver") >= 0) inertAt = inertAt.concat(["inert@" + (ms.length - 1)])
        if (inertAt.length > 0 && !runtimeGuardsBuilt()) return hw("E-BOOTSTRAP-UNSUPPORTED", "`" + name + "`'s chain reaches a `guarded(inert-receiver)` entry — its run-time check (§21.3.3 rule 8.5) is not in this build, so the entry is refused rather than run unguarded")
        return { hcode: "", hmsg: "", hguards: entryGuards(e).concat(inertAt) }
    }

    // One argument `x` of a target against the slot type `slot` (8.4, 8.5).
    fn hostArgFit(te: TypeEnv, types: TypeInfo[], ps: AParam[], x: AExpr, slot: string, name: string, st: AS) -> HArgFit {
        const v: HView = hostView(x)
        const bad: string = "an argument of `" + name + "`'s target does not fit the slot `" + slot + "`"
        if (v.k == 0) {
            const pi: int = paramIndexOf(ps, v.name)
            if (pi < 0) return haOk()                     // rule 4 (parse.scrml)
            const h: string = hostParamSlot(te, types, ps[pi], st)
            if (isCallbackSlot(slot)) return haBad("E-HOST-ARG-TYPE", bad + ": the parameter `" + v.name + "` is `" + h + "`, and a callback slot takes a scrml function (§21.3.3 rule 8.4)")
            if (slot == "inert-tag" || slot == "attr-name" || slot.startsWith("\"")) return haBad("E-HOST-ARG-TYPE", bad + ": the parameter `" + v.name + "` is not a string literal, and this slot admits only a literal (§21.3.3 rule 8.5, Appendix H.1)")
            if (dictKeys(stripNot(slot)) is given) return haBad("E-HOST-ARG-TYPE", bad + ": a dictionary slot takes a one-level object literal (§21.3.3 rule 8.4)")
            if (!hostArgFits(h, slot)) return haBad("E-HOST-ARG-TYPE", bad + ": the parameter `" + v.name + "` is `" + h + "` (§21.3.3 rule 8.4)")
            return haOk()
        }
        if (v.k == 4) {
            if (slot == "inert-tag") {
                const ti: string = inertTagIface(v.name)
                if (ti == "") return haBad("E-HOST-ARG-TYPE", bad + ": `\"" + v.name + "\"` is not on the inert element list (Appendix H.4) — `createElement` makes only an element whose content and attributes run nothing (§21.3.3 rule 8.5)")
                return { w: hwOk(), tag: ti, url: false, urlLit: "" }
            }
            if (slot == "attr-name") {
                const av: string = attrNameVerdict(v.name)
                if (av == "exec") return haBad("E-HOST-TARGET-NOT-ALLOWED", "the target of `" + name + "` names the attribute `" + v.name + "` — an event-handler attribute or `srcdoc` installs or runs code, and a `guarded(attr-name)` entry refuses it (§21.3.3 rule 8.5, §5.2's name test)")
                // #1674 review F1: every name the MARKUP walk refuses from data, on any element the
                // receiver may be (the H.4 inert list) — `form`, `formaction`, `style`, … — by markup's
                // own predicate (dataAttrRefusal), whatever the value: a binding is a data path
                for (const it of inertElements()) {
                    const mc: string = dataAttrRefusal(it.tag, v.name, [])
                    if (mc != "") return haBad("E-HOST-TARGET-NOT-ALLOWED", "the target of `" + name + "` names the attribute `" + v.name + "`, which §5.2 / §65.4.2 never write from data (markup refuses a data `" + v.name + "=` on an element the receiver may be as " + mc + ": data never chooses where a form posts, which form a control submits with, or a style) — a `guarded(attr-name)` entry refuses it too (§21.3.3 rule 8.5); write it as a static attribute in markup")
                }
                if (av == "url") return { w: hwOk(), tag: "", url: true, urlLit: v.name }
                return haOk()
            }
            if (slot.startsWith("\"")) {
                if (slot == "\"" + v.name + "\"") return haOk()
                return haBad("E-HOST-ARG-TYPE", bad + ": this slot admits only the literal " + slot)
            }
            for (const alt of slotAlternatives(slot)) {
                if (alt == "string") return { w: hwOk(), tag: "", url: false, urlLit: v.name }
            }
            return haBad("E-HOST-ARG-TYPE", bad + ": a string literal (§21.3.3 rule 8.4)")
        }
        if (v.k == 5) {
            for (const alt of slotAlternatives(slot)) {
                if (alt == "number") return haOk()
                if (alt == "int" && v.name.indexOf(".") < 0 && v.name.indexOf("e") < 0 && v.name.indexOf("E") < 0) return haOk()
            }
            return haBad("E-HOST-ARG-TYPE", bad + ": a number literal (§21.3.3 rule 8.4)")
        }
        if (v.k == 6) {
            for (const alt of slotAlternatives(slot)) { if (alt == "bool") return haOk() }
            return haBad("E-HOST-ARG-TYPE", bad + ": a bool literal (§21.3.3 rule 8.4)")
        }
        if (v.k == 7) {
            const keys: string[] | not = dictKeys(stripNot(slot))
            if (keys is not) return haBad("E-HOST-ARG-TYPE", bad + ": an object literal fills only a dictionary slot (§21.3.3 rule 8.4, Appendix H.5)")
            for (const pr of v.props) {
                let kt: string = ""
                for (const k of keys) {
                    const at: int = k.indexOf(":")
                    let kn: string = k.substring(0, at).trim()
                    if (kn.endsWith("?")) kn = kn.substring(0, kn.length - 1)
                    if (kn == pr.name) kt = k.substring(at + 1, k.length).trim()
                }
                if (kt == "") return haBad("E-HOST-ARG-TYPE", "the object literal in `" + name + "`'s target has the key `" + pr.name + "`, which the dictionary `" + stripNot(slot) + "` does not have (§21.3.3 rule 8.4, Appendix H.5)")
                const fa: HArgFit = hostArgFit(te, types, ps, pr.value, kt, name, st)
                if (fa.w.hcode != "") return fa
            }
            return haOk()
        }
        return haOk()                                     // rule 4 (parse.scrml)
    }

    // A struct declared as the result of an interface-valued entry: every field a
    // `read` entry of `iface` whose type yields the field's (8.4). "ok" / "bad".
    fn hostStructFromIface(types: TypeInfo[], dr: Type, iface: string) -> string {
        let t: Type = dr
        const mi: Type | not = maybeInner(dr)
        if (mi is given) t = mi
        const s: Sym | not = namedOf(t)
        if (s is not) return "bad"
        const ti: TypeInfo | not = typeInfoOf(types, s)
        if (ti is not) return "bad"
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return "bad"
        for (const f of fs) {
            const e: HEntry | not = findEntry(iface, f.sym.hint, "read")
            if (e is not) return "bad"
            if (hostResultVerdict(sigResult(e), hostSlotText(types, f.ty)) != "ok") return "bad"
        }
        return "ok"
    }

    // Why the binding's signature does not cross the boundary in the bootstrap ("" — it does).
    fn hostBindTypeWhy(te: TypeEnv, types: TypeInfo[], fs: FnSrc, st: AS) -> string {
        for (const p of fs.f.params) {
            const at: AType | not = p.ty
            if (at is not) return "does not declare the type of its parameter `" + p.name + "` — a binding is fully typed: its signature is the host function's type (§21.3.3)"
            const rt: RType = resolveType(te, at, st)
            if (!rt.unresolved && !hostArgOk(types, rt.t)) return "takes the parameter `" + p.name + "` of type `" + typeName(rt.t) + "` — the bootstrap passes `int`, `number`, `string`, `bool`, a declared `:host` handle, or the `T | not` of one into the host; a struct or tape argument's deep fresh copy (§21.3.3 rule 12) is not built"
        }
        const r: Type | not = fs.info.ret
        if (r is given) {
            if (!hostResultOk(types, r, 0)) return "returns `" + typeName(r) + "` — the bootstrap decodes a host result of `int`, `number`, `string`, `bool`, a declared `:host` handle, a struct of those, a tape of those, or the `T | not` of one (§21.3.3 rule 13); an enum's decode (the §41.13 `parseVariant` shape) and DOM element types (rule 16) are not built"
        }
        return ""
    }

    fn hostArgOk(types: TypeInfo[], t: Type) -> boolean {
        const mi: Type | not = maybeInner(t)
        if (mi is given) return hostArgOk(types, mi)
        return scalarType(t) || isHostType(types, t)
    }

    fn hostResultOk(types: TypeInfo[], t: Type, depth: int) -> boolean {
        if (depth > 12) return false
        if (scalarType(t) || isHostType(types, t)) return true
        const mi: Type | not = maybeInner(t)
        if (mi is given) return hostResultOk(types, mi, depth + 1)
        const el: Type | not = seqElemOf(t)
        if (el is given) return hostResultOk(types, el, depth + 1)
        const s: Sym | not = namedOf(t)
        if (s is not) return false
        const ti: TypeInfo | not = typeInfoOf(types, s)
        if (ti is not) return false
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return false
        for (const f of fs) {
            if (!hostResultOk(types, f.ty, depth + 1)) return false
        }
        return true
    }

    // The checked target as Core's HostBind (parse.scrml already judged its
    // shape — rules 4, 5, 8; a shape it refused carries its report, so `not`).
    // s473 (allowlist lane A, §21.3.3 rule 3/4): in a `<host src=>`, a binding WITHOUT a target calls
    // the export of its own name with its parameters in order, and a target whose root is neither a
    // parameter nor `window` / `document` / `navigator` is rooted at an export of `src` (the driver
    // reads the exports statically — slice-m1/host-src.js — and refuses a name the file does not
    // export: E-IMPORT-004 / E-HOST-TARGET-UNBOUND).
    fn hostBindCore(ps: AParam[], hb: AHostBind, name: string, file: string, guards: string[]) -> HostBind | not {
        const tg: AExpr | not = hb.target
        if (tg is not) {
            if (hb.src == "") return not
            let all: HostArg[] = []
            let i: int = 0
            while (i < ps.length) {
                all = all.concat([HostArg.HParam(i)])
                i = i + 1
            }
            const hs0: HostSrc = { path: hostSrcPath(file, hb.src), file: file, at: hb.span.start, targetless: true }
            return { shape: 0, root: name, rootParam: -1, chain: [], args: all, src: hs0, guards: [] }
        }
        const parts: HTargetParts = hostTargetParts(tg, hb.isNew)
        if (!parts.ok || !parts.chain.ok) return not
        let root: string = parts.chain.root
        let src: HostSrc | not = not
        const rp: int = paramIndexOf(ps, root)
        if (rp >= 0) {
            root = ""
        } else if (!hostRootGlobal(root)) {
            if (hb.src == "") return not
            src = { path: hostSrcPath(file, hb.src), file: file, at: hb.span.start, targetless: false }
        }
        let args: HostArg[] = []
        for (const x of parts.args) {
            const a: HostArg | not = hostArgCore(ps, x, true)
            if (a is not) return not
            args = args.concat([a])
        }
        return { shape: parts.shape, root: root, rootParam: rp, chain: parts.chain.members, args: args, src: src, guards: guards }
    }

    // A `src=` value (`./x.js`, `../lib/x.js`), resolved against the directory of the file `file` that
    // declares it, as a path relative to the build's source root — `..` segments the root cannot absorb
    // are kept (the file may lie above the source root and inside the project root; the driver judges
    // that, E-IMPORT-011).
    fn hostSrcPath(file: string, src: string) -> string {
        let segs: string[] = []
        const cut: int = file.lastIndexOf("/")
        if (cut >= 0) segs = file.substring(0, cut).split("/")
        for (const s of src.split("/")) {
            if (s == "..") {
                if (segs.length > 0 && segs[segs.length - 1] != "..") {
                    segs = segs.slice(0, segs.length - 1)
                } else {
                    segs = segs.concat([".."])
                }
            } else if (s != "." && s != "") {
                segs = segs.concat([s])
            }
        }
        return segs.join("/")
    }

    fn paramIndexOf(ps: AParam[], n: string) -> int {
        let i: int = 0
        for (const p of ps) {
            if (p.name == n) return i
            i = i + 1
        }
        return -1
    }

    fn hostArgCore(ps: AParam[], x: AExpr, objOk: boolean) -> HostArg | not {
        const v: HView = hostView(x)
        if (v.k == 0) {
            const i: int = paramIndexOf(ps, v.name)
            if (i < 0) return not
            return HostArg.HParam(i)
        }
        if (v.k == 4) return HostArg.HStr(v.name)
        if (v.k == 5) return HostArg.HNum(v.name)
        if (v.k == 6) return HostArg.HBool(v.name == "true")
        if (v.k == 7 && objOk) {
            let props: HostProp[] = []
            for (const pr of v.props) {
                if (pr.spread || pr.name == "__proto__") return not
                const pv: HostArg | not = hostArgCore(ps, pr.value, false)
                if (pv is not) return not
                props = props.concat([{ key: pr.name, value: pv }])
            }
            return HostArg.HObj(props)
        }
        return not
    }

    // Rule 15 — a declared `:host` type is not data: "A struct field SHALL NOT be
    // of a type that contains a declared `:host` type … Each of these SHALL be
    // `E-HOST-HANDLE-NOT-DATA`." An enum payload holding one, and a CELL holding
    // one (rule 15 admits a client cell; the bootstrap's cells are the §57 /
    // persist / server boundaries' carriers, whose handle checks are not built),
    // are refused by name — fail closed.
    fn hostTypeDataDiags(types: TypeInfo[], st0: AS) -> AS {
        let st: AS = st0
        for (const ti of types) {
            const fs: FieldDef[] | not = structFieldDefs(ti.def)
            if (fs is given) {
                for (const f of fs) {
                    if (containsHost(types, f.ty, 0)) st = addDiag(st, ti.file, ti.span, "E-HOST-HANDLE-NOT-DATA", "the struct `" + ti.name + "` has the field `" + f.sym.hint + "` of type `" + typeName(f.ty) + "`, which contains a declared `:host` handle type — a struct field SHALL NOT be of a type that contains one (§21.3.3 rule 15: a handle is not data)")
                }
            }
            for (const v of enumVariants(ti.def)) {
                for (const f of v.fields) {
                    if (containsHost(types, f.ty, 0)) st = addDiag(st, ti.file, ti.span, "E-BOOTSTRAP-UNSUPPORTED", "the variant `" + ti.name + "." + v.sym.hint + "` has a payload field of type `" + typeName(f.ty) + "`, which contains a declared `:host` handle type — an enum payload holding a host handle is not in the bootstrap (§21.3.3 rule 15 refuses it at every data boundary; those checks are not built here)")
                }
            }
        }
        return st
    }

    // Rule 15 at the server boundary: "A value whose type contains one at any
    // depth … SHALL NOT … be sent where one sends: … a server-function
    // parameter or result". Judged after placement, on each SERVER-placed function.
    fn hostServerDiags(g: Globals, servers: int[]) -> Diag[] {
        let out: Diag[] = []
        for (const fs of g.fns) {
            if (servers.indexOf(fs.info.sym.id) >= 0) {
                const te: TypeEnv = teAt(g.te, fs.info.file)
                for (const p of fs.f.params) {
                    const at: AType | not = p.ty
                    if (at is given) {
                        const rt: RType = resolveType(te, at, emptyAS())
                        if (!rt.unresolved && containsHost(g.types, rt.t, 0)) out = out.concat([newDiag("E-HOST-HANDLE-NOT-DATA", "the server function `" + fs.info.name + "` takes `" + p.name + ": " + typeName(rt.t) + "`, which contains a declared `:host` handle type — a host handle SHALL NOT cross to the server (§21.3.3 rule 15)", fs.info.file, p.span)])
                    }
                }
                const r: Type | not = fs.info.ret
                if (r is given) {
                    if (containsHost(g.types, r, 0)) out = out.concat([newDiag("E-HOST-HANDLE-NOT-DATA", "the server function `" + fs.info.name + "` returns `" + typeName(r) + "`, which contains a declared `:host` handle type — a host handle SHALL NOT cross from the server (§21.3.3 rule 15)", fs.info.file, fs.info.span)])
                }
            }
        }
        return out
    }

    fn hostMemberText(ty: string, name: string) -> string {
        return "`." + name + "` on a value of the declared host handle type `" + ty + "` — a `:host` handle is closed: no member access or method call is written on it (§21.3.3 rule 15). Declare a binding that does it instead: `" + name + "(h: " + ty + ") -> T = h." + name + "` (or `= h." + name + "(…)`) in a `<host>`"
    }

    // A cell (a declaration's field) whose type contains a declared `:host` type.
    fn hostCellDiags(g: Globals, st0: AS) -> AS {
        let st: AS = st0
        for (const ds of g.decls) {
            for (const f of ds.info.fields) {
                if (containsHost(g.types, f.ty, 0)) st = addDiag(st, ds.file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "the cell `" + f.sym.hint + "` holds `" + typeName(f.ty) + "`, which contains a declared `:host` handle type — a cell holding a host handle is not in the bootstrap (§21.3.3 rule 15 admits a client cell but refuses a `persist=` / `server` cell; the bootstrap does not build that split). Hold the handle in a local")
            }
        }
        return st
    }

    fn fnWithHost(i: FnInfo, h: HostFn) -> FnInfo {
        return { nid: i.nid, span: i.span, sym: i.sym, name: i.name, file: i.file, exported: i.exported,
                 pure: i.pure, arity: i.arity, ret: i.ret, failable: i.failable, err: i.err,
                 serverOwn: i.serverOwn, rerr: i.rerr, host: h }
    }

    // Why the function `fs` (whose whole body is `return h(…)`) is not the
    // wrapper of `h`; "" when its SHAPE is the rule's.
    fn wrapperShapeWhy(fs: FnSrc, c: CallParts, h: string, twice: boolean) -> string {
        if (fs.f.ret is not) return "`" + fs.info.name + "` does not declare its return type — a host binding's wrapper is fully typed: its signature IS the host function's type"
        const wr: AType | not = fs.f.ret
        if (wr is given) {
            if (isVoidType(wr)) return "`" + fs.info.name + "` declares no return value (`void`) — a host binding's wrapper returns the host function's value, decoded against its declared return type"
        }
        if (fs.f.failable) return "`" + fs.info.name + "` is declared `!` — a host function's failure is not a scrml error value, so its wrapper cannot be failable"
        if (fs.f.server) return "`" + fs.info.name + "` is a `server` function — a host binding's wrapper is an ordinary function, placed wherever it is called"
        if (twice) return "`" + h + "` is already wrapped by another function in this file — a host function has one type, so it has one wrapper"
        if (c.args.length != fs.f.params.length) return "the call passes " + c.args.length + " argument(s) and `" + fs.info.name + "` takes " + fs.f.params.length + " — the host function receives exactly its wrapper's parameters, in order"
        let i: int = 0
        while (i < c.args.length) {
            if (exprName(c.args[i]) != fs.f.params[i].name) return "argument " + (i + 1) + " is not the parameter `" + fs.f.params[i].name + "` — the host function receives exactly its wrapper's parameters, in order (its type is the wrapper's signature)"
            i = i + 1
        }
        return ""
    }

    // Why a wrapper's signature does not cross the host boundary in the
    // bootstrap; "" when it does (every parameter a scalar, the result a scalar
    // or a scalar's `T | not`).
    fn wrapperTypeWhy(te: TypeEnv, fs: FnSrc, st: AS) -> string {
        for (const p of fs.f.params) {
            const at: AType | not = p.ty
            if (at is given) {
                const rt: RType = resolveType(te, at, st)
                if (!rt.unresolved && !scalarType(rt.t)) return "its parameter `" + p.name + "` is a `" + typeName(rt.t) + "`"
            }
        }
        const r: Type | not = fs.info.ret
        if (r is given) {
            const inner: Type | not = maybeInner(r)
            if (inner is given) {
                if (!scalarType(inner)) return "it returns a `" + typeName(r) + "`"
            } else if (!scalarType(r)) {
                return "it returns a `" + typeName(r) + "`"
            }
        }
        return ""
    }

    fn scalarType(t: Type) -> boolean {
        const k: int = kindOf(t)
        return k >= 0 && k <= 3
    }

    fn paramNamed(ps: AParam[], name: string) -> boolean {
        for (const p of ps) {
            if (p.name == name) return true
        }
        return false
    }

    // The call a block consists of: its ONE statement is `return <call>;`.
    fn wholeReturnCall(b: ABlock) -> CallParts | not {
        if (b.stmts.length != 1) return not
        const k: AStmtK = b.stmts[0].k
        const e: AExpr | not = match k {
            .Return(e: x) :> x
            .Eval(e: x) :> not
            .Local(name: n) :> not
            .If(cond: x) :> not
            .Given(name: n) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: d) :> not
            .Fail(f: x) :> not
            .For(f: lf) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: w) :> not
        }
        if (e is not) return not
        return callParts(e)
    }

    fn callParts(e: AExpr) -> CallParts | not {
        const k: AExprK = e.k
        return match k {
            .Call(callee: c, args: xs) :> mkCallParts(c, xs)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn mkCallParts(c: AExpr, xs: AExpr[]) -> CallParts { return { callee: c, args: xs } }

    // The `import:<tag>` declaration of `file` that binds `local` — the LAST
    // one (§41.7: a later import of a name wins); `not` when none does.
    fn hostImportBinding(files: FileAst[], file: string, local: string) -> AImport | not {
        let found: AImport | not = not
        for (const f of files) {
            if (f.path == file) {
                for (const h of hostImportsOfItems(f.items)) {
                    for (const n of h.names) {
                        if (n.name == local) found = h
                    }
                }
            }
        }
        return found
    }

    // The host module's export name `local` binds in the declaration `h`.
    fn hostOrigOf(h: AImport, local: string) -> string {
        let out: string = local
        for (const n of h.names) {
            if (n.name == local) out = n.orig
        }
        return out
    }

    // A host-import declaration analyze ADMITS (checkHostImport reports
    // nothing for it): at file top, the `host` tag, a JavaScript module
    // (`.js` / `.mjs` — the bootstrap's artifacts are JavaScript; a `.ts`
    // module is refused, E-BOOTSTRAP-UNSUPPORTED), in a stdlib file, and inside
    // that file's module directory (link.scrml hostLocOf; else E-IMPORT-012).
    fn hostImportAdmitted(file: string, h: AImport) -> boolean {
        return h.top && hostTagOf(h) == "host" && hostEmitSource(h.from) && isStdlibPath(file) && hostLocOf(file, h.from) is given
    }

    fn hostEmitSource(from: string) -> boolean {
        return from.endsWith(".js") || from.endsWith(".mjs")
    }

    // The judged call site of a host binding at callee node `nid`; `not` when
    // the use is not the callee of a wrapper-shaped `return`.
    fn hostSiteAt(g: Globals, nid: int) -> HostSite | not {
        for (const s of g.hostSites) {
            if (s.nid == nid) return s
        }
        return not
    }

    // s451 (Ue) — a `!` function's error type. §19.4.2 "`!` without
    // `-> ErrorType` uses a built-in default error enum: `Error`"; §19.4.4.1
    // "The error type after `!` SHALL be an enum type … A non-enum error type
    // SHALL be E-ERROR-011" (scalar, sequence, `T | not` — "they fail for one
    // reason, not several"). A type that does not resolve is E-TYPE-UNKNOWN's.
    type RErrType:struct = { err: Sym | not, st: AS }

    fn errTypeOf(te: TypeEnv, f: FileAst, af: AFn, st: AS) -> RErrType {
        if (!af.failable) return { err: not, st: st }
        const at: AType | not = af.err
        if (at is not) return { err: builtinSym(te.stubs, "Error"), st: st }
        if (hasErrIn(f.errs, at.span)) return { err: not, st: st }
        const rt: RType = resolveType(te, at, st)
        if (rt.unresolved) return { err: not, st: rt.st }
        const es: Sym | not = enumStubSym(te, rt.t)
        if (es is given) return { err: es, st: rt.st }
        return { err: not, st: addDiag(rt.st, f.path, at.span, "E-ERROR-011", "the error type of `" + af.name + "(…)!` is not an enum — §19.4.4.1: \"The error type after `!` SHALL be an enum type\" (a `:enum` declaration, or the built-in `Error` when it is omitted). Declare the failures as variants: `type " + af.name + "Error:enum = { … }`") }
    }

    // =========================================================================
    // s454 (U1b) — THE FAILURE ENUM OF A CLIENT CALL (§19.9.10 "The failure set
    // of a client call (S454)"): "At a client call site … of a server-placed
    // function `f`, the call fails with: `f`'s declared error enum's variants
    // (when `f` is declared `! E`) … **plus** ONE variant, **`Transport(t:
    // ServerCallError)`** … For an `f` not declared `!`, the failure set is
    // `Transport(t: ServerCallError)` alone." and "A declared variant named
    // `Transport`": "If `f`'s declared enum has a variant `Transport` whose
    // payload is exactly `(t: ServerCallError)`, that variant IS the wrapper …
    // A declared variant named `Transport` with any other payload (or none)
    // SHALL be a compile error at the client call site — **`E-ERROR-016`**".
    //
    // Design Item 1 B "Core shape": "Lower mints one EnumDef per declared error
    // enum used at a remote site — `E+Transport` = `E`'s variants followed by
    // `Transport(t: ServerCallError)` (merged when `E` already has it) — plus one
    // shared `{ Transport(t: ServerCallError) }` for non-`!` callees." Minted HERE
    // (phase A, before any arm is resolved against it), once per declared enum,
    // for every function whose own body places it on the server — a callee
    // that may be called from the client (whether a site is a client call is
    // decided per site, §19.9.10 "placement is whole-program"). The minted enums
    // live in the built-in file: one ships in Core only when Core names it.
    // E's variants come FIRST, in order, so a variant's index is the same in `E`
    // and in `E + Transport` (an arm resolved against either reads the same).
    // =========================================================================
    type RRemoteEnums:struct = { fs: FnSrc[], minted: TypeInfo[], st: AS }
    // A declared enum's id (-1: the shared enum of a non-`!` callee) → its remote enum.
    type RemoteMemo:struct = { enumId: int, remote: Sym }
    type RMintedEnum:struct = { ti: TypeInfo, st: AS }

    fn remoteEnums(fs: FnSrc[], ts: TypeInfo[], sce: Sym, st0: AS) -> RRemoteEnums {
        let st: AS = st0
        let minted: TypeInfo[] = []
        let memo: RemoteMemo[] = []
        let out: FnSrc[] = []
        for (const f of fs) {
            let rerr: Sym | not = not
            if (f.info.serverOwn) {
                const e: Sym | not = f.info.err
                let key: int = -1
                let make = true
                if (f.info.failable) {
                    if (e is given) {
                        key = e.id
                        const shape: int = transportShape(ts, e, sce)
                        if (shape == 0) {
                            rerr = e              // E declares `Transport(t: ServerCallError)`: E IS the set
                            make = false
                        } else if (shape == 1) {
                            make = false          // another `Transport`: E-ERROR-016 at each client call site
                        }
                    } else {
                        make = false              // not an enum: E-ERROR-011 reported
                    }
                }
                if (make) {
                    // (named `prior`, not `known`: impl#1 resolves a narrowed local that shares
                    // a top-level function's name to that FUNCTION — dogfood finding, progress.md)
                    const prior: Sym | not = remoteMemoOf(memo, key)
                    if (prior is given) {
                        rerr = prior
                    } else {
                        const rm: RMintedEnum = mintRemoteEnum(ts, e, key, sce, st)
                        st = rm.st
                        minted = minted.concat([rm.ti])
                        const ms: Sym = typeDefSym(rm.ti.def)
                        memo = memo.concat([{ enumId: key, remote: ms }])
                        rerr = ms
                    }
                }
            }
            out = out.concat([{ info: withRemoteErr(f.info, rerr), f: f.f }])
        }
        return { fs: out, minted: minted, st: st }
    }

    fn remoteMemoOf(memo: RemoteMemo[], key: int) -> Sym | not {
        for (const m of memo) {
            if (m.enumId == key) return m.remote
        }
        return not
    }

    fn withRemoteErr(i: FnInfo, rerr: Sym | not) -> FnInfo {
        return { nid: i.nid, span: i.span, sym: i.sym, name: i.name, file: i.file, exported: i.exported,
                 pure: i.pure, arity: i.arity, ret: i.ret, failable: i.failable, err: i.err,
                 serverOwn: i.serverOwn, rerr: rerr, host: i.host }
    }

    // Does enum `e` declare a variant named `Transport`: -1 none; 0 exactly
    // `Transport(t: ServerCallError)` (§19.9.10 "that variant IS the wrapper");
    // 1 any other payload, or none (E-ERROR-016).
    export fn transportShape(ts: TypeInfo[], e: Sym, sce: Sym) -> int {
        const t: TypeInfo | not = typeInfoOf(ts, e)
        if (t is not) return -1
        for (const v of enumVariants(t.def)) {
            if (v.sym.hint == "Transport") {
                if (v.fields.length == 1 && v.fields[0].sym.hint == "t" && v.fields[0].ty == Type.Named(sce)) return 0
                return 1
            }
        }
        return -1
    }

    // `E + Transport` (or, key -1, the shared `Transport` enum): fresh Syms for
    // every variant and payload field (one declaration site per Sym).
    fn mintRemoteEnum(ts: TypeInfo[], e: Sym | not, key: int, sce: Sym, st0: AS) -> RMintedEnum {
        let st: AS = st0
        let name: string = "Transport"
        let vs: VariantDef[] = []
        if (key >= 0 && e is given) {
            name = e.hint + " + Transport"
            const t: TypeInfo | not = typeInfoOf(ts, e)
            if (t is given) {
                for (const v of enumVariants(t.def)) {
                    const rv: RSym = mint(st, v.sym.hint)
                    st = rv.st
                    let fds: FieldDef[] = []
                    for (const fd of v.fields) {
                        const rf: RSym = mint(st, fd.sym.hint)
                        st = rf.st
                        fds = fds.concat([{ sym: rf.s, ty: fd.ty, grants: noGrants() }])
                    }
                    vs = vs.concat([{ sym: rv.s, fields: fds }])
                }
            }
        }
        const re: RSym = mint(st, name)
        st = re.st
        const rt: RSym = mint(st, "Transport")
        st = rt.st
        const rtf: RSym = mint(st, "t")
        st = rtf.st
        vs = vs.concat([{ sym: rt.s, fields: [{ sym: rtf.s, ty: Type.Named(sce), grants: noGrants() }] }])
        const ti: TypeInfo = { nid: -1, span: mkSpan(0, 0), name: name, file: builtinFile(), exported: false, def: TypeDef.EnumDef(re.s, vs) }
        return { ti: ti, st: st }
    }

    // The enum a resolved type names (a `type … :enum` or a built-in one), else not.
    fn enumStubSym(te: TypeEnv, t: Type) -> Sym | not {
        const s: Sym | not = namedOf(t)
        if (s is not) return not
        for (const st of te.stubs) {
            if (st.sym.id == s.id && st.isEnum) return s
        }
        return not
    }

    // Did the parser report an error inside `span`?
    fn hasErrIn(errs: ASpan[], span: ASpan) -> boolean {
        for (const e of errs) {
            if (e.start >= span.start && e.end <= span.end) return true
        }
        return false
    }


    fn fileErrs(files: FileAst[], path: string) -> ASpan[] {
        for (const f of files) {
            if (f.path == path) return f.errs
        }
        return []
    }

    // A field is untrusted only when ITS OWN written type failed to parse
    // (a parser error inside the type expression's span).
    fn trustFields(fs: FieldInfo[], errs: ASpan[]) -> FieldInfo[] {
        let out: FieldInfo[] = []
        for (const f of fs) {
            out = out.concat([{ nid: f.nid, span: f.span, annotated: f.annotated, trusted: f.trusted && typeTrusted(errs, f.typeSpan),
                                typeSpan: f.typeSpan, sym: f.sym, ty: f.ty, mode: f.mode, role: f.role, grants: f.grants,
                                graph: f.graph, exported: f.exported, wcap: f.wcap, init: f.init, reads: f.reads, shrink: f.shrink, vals: f.vals, valsWritten: f.valsWritten,
                                origin: f.origin }])
        }
        return out
    }

    fn typeSpanOf(at: AType | not) -> ASpan | not {
        if (at is not) return not
        return at.span
    }

    fn typeTrusted(errs: ASpan[], span: ASpan | not) -> boolean {
        if (span is not) return true
        return !hasErrIn(errs, span)
    }

    // Every parameter is written with a type, and none of those types failed to parse.
    fn paramsTrusted(errs: ASpan[], ps: AParam[]) -> boolean {
        for (const p of ps) {
            const at: AType | not = p.ty
            if (at is not) return false
            if (hasErrIn(errs, at.span)) return false
        }
        return true
    }

    // `-> void` (§7.5 primitive-type) declares that the function returns no value.
    fn isVoidType(at: AType) -> boolean {
        const k: ATypeK = at.k
        return match k {
            .TName(name: n) :> n == "void"
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
        }
    }

    fn fnItems(items: AItem[]) -> AFn[] {
        let out: AFn[] = []
        for (const it of items) { if (!isLaterProgram(items, it)) out = out.concat(fnItemOf(it)) }   // s451: a second top-level program is E-PROGRAM-002, not read
        return out
    }

    fn fnItemOf(it: AItem) -> AFn[] {
        const k: AItemK = it.k
        return match k {
            .FnItem(f: f) :> [f]
            .ProgramItem(p: p) :> fnItems(p.items)
            .ConstItem(c: c) :> []
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .DeclItem(d: d) :> []
            .MarkupItem(n: n) :> []
        }
    }

    // s472 — the file-scope constants of `items` (a `<program>`'s `${ }` included), in source order.
    fn constItems(items: AItem[]) -> AConst[] {
        let out: AConst[] = []
        for (const it of items) { if (!isLaterProgram(items, it)) out = out.concat(constItemOf(it)) }
        return out
    }

    fn constItemOf(it: AItem) -> AConst[] {
        const k: AItemK = it.k
        return match k {
            .ConstItem(c: c) :> [c]
            .ProgramItem(p: p) :> constItems(p.items)
            .FnItem(f: f) :> []
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .DeclItem(d: d) :> []
            .MarkupItem(n: n) :> []
        }
    }

    // s442: `<accent:swatch label="Accent" …/>` — a declaration whose own type
    // names a DECLARATION is a named shared instance (§66.8.2; `:Decl` is a
    // typed own value, #16). Not in the bootstrap: it is reported where it is
    // written, instead of reading as a field-less declaration named `accent`.
    fn namedInstanceDiags(te: TypeEnv, ds: DeclStub[], declNames: string[], files: FileAst[], st0: AS) -> AS {
        let st: AS = st0
        for (const s of ds) {
            const d: ADecl | not = s.d
            if (d is given) {
                const n: string = ownTypeName(d)
                if (n != "" && declNames.indexOf(n) >= 0) {
                    st = addDiag(st, s.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + d.name + ":" + n + " …/>` is a named shared instance of `<" + n + ">` (§66.8.2) — not in the bootstrap")
                } else {
                    st = o19Diags(s.file, d, st)
                    st = openerWordDiags(teAt(te, s.file), s.file, fileErrs(files, s.file), d, false, st)
                    // s444 Phase B: a user declaration's OWN validators, and a field's below depth 1
                    if (d.validators.length > 0) st = addDiag(st, s.file, d.validators[0].span, "E-BOOTSTRAP-UNSUPPORTED", "validators on `<" + d.name + ">`'s own opener bind its own value (§66.4 rule 3) — a user declaration's own value is not bindable in the bootstrap; put them on a child field")
                    for (const c of childFields(d.body)) { st = deepValidatorDiags(s.file, c.body, st) }
                }
            }
            const p: AProgram | not = s.p
            if (p is given) {
                // the program's cells (a nested user declaration is its own stub)
                for (const it of p.items) {
                    for (const c of declsOfItem(it)) {
                        // s473 — §66.8.2: a named shared instance in a `<program>`
                        // body is refused as it is at file scope (above). It
                        // compiled clean: its attributes were dropped and `@name`
                        // read `rt.noDefault`, which throws.
                        // s473 — RULED (bryan, user-voice S473 "review-surfaced
                        // decisions" item 3): a program cell named like a markup
                        // element is refused WHERE IT IS DECLARED when the same
                        // program body also writes that name as a tag — `let
                        // <filter:string=""/>` + `<filter/>` (that tag used to be
                        // the inert element, §66.6.6's "silently changes
                        // meaning"). With no colliding tag the cell is fine.
                        // Code: the one #1682 (S473 SPEC rulings) names for this rule —
                        // E-DECL-ELEMENT-NAME-COLLIDES.
                        if (!isNestedUserDecl(c) && markupElementName(c.name) && programUsesTag(p, c.name)) {
                            st = addDiag(st, s.file, c.span, "E-DECL-ELEMENT-NAME-COLLIDES", "the program cell `" + c.name + "` is named like the markup element `<" + c.name + ">`, and this program also writes `<" + c.name + ">` as a tag — the tag would be the element, not the cell (§66.6.6: a tag never silently changes meaning; ruled S473). Rename the cell, or drop the tag (show the value with `$" + "{@" + c.name + "}`)")
                        }
                        if (!isNestedUserDecl(c) && ownTypeName(c) != "" && declNames.indexOf(ownTypeName(c)) >= 0) {
                            st = addDiag(st, s.file, c.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + c.name + ":" + ownTypeName(c) + " …/>` is a named shared instance of `<" + ownTypeName(c) + ">` (§66.8.2) — not in the bootstrap")
                        }
                        if (!isNestedUserDecl(c) && declNames.indexOf(ownTypeName(c)) < 0) st = openerWordDiags(teAt(te, s.file), s.file, fileErrs(files, s.file), c, s.isProgram, st)
                        if (!isNestedUserDecl(c)) st = deepValidatorDiags(s.file, c.body, st)
                    }
                }
            }
        }
        return st
    }

    // s444 (PA): an opener word the bootstrap does not READ used to land in
    // ADecl.mods and be silently ignored (analyze reads only `single`; the
    // parser reports validators) — e.g. §6.14 `persist="local" key="…"`.
    // Every other word is refused here, on the declaration and on every child
    // field at any depth. (A named shared instance's construction words are
    // not opener words — it is refused as a whole, namedInstanceDiags.)
    // s444 Phase B: validators on a declaration nested BELOW a child field (the
    // bootstrap models one level of child fields) are refused, never dropped.
    fn deepValidatorDiags(file: string, body: ADeclChild[], st0: AS) -> AS {
        let st: AS = st0
        for (const g of childFields(body)) {
            if (g.validators.length > 0) st = addDiag(st, file, g.validators[0].span, "E-BOOTSTRAP-UNSUPPORTED", "validators on `<" + g.name + ">` (a field nested below a child field) are not in the bootstrap")
            st = deepValidatorDiags(file, g.body, st)
        }
        return st
    }

    // A declaration holding a parse error is recovery debris there (Rule C).
    // `cell`: `d` is a program cell (the only place the bootstrap reads
    // `reset-on=`, s449 — resetOnPass).
    fn openerWordDiags(te: TypeEnv, file: string, errs: ASpan[], d: ADecl, cell: boolean, st0: AS) -> AS {
        let st: AS = st0
        if (hasErrIn(errs, d.span)) return st
        st = repeatedWordDiags(file, d, st)
        st = stampNoDefaultDiag(te, file, d, st)
        for (const a of d.mods) {
            // s473 (#1646 review F1): a foreign block in an opener word's value
            // is no admitted position (§23.2.4) — whatever reads the word
            for (const fs of foreignsInAttrValue(a.value)) {
                st = addDiag(st, file, fs, "E-FOREIGN-004", "a foreign code block is not valid in a declaration opener's `" + a.name + "=` (§23.2.4) — its value is bound WHOLE: `const x = _={ … }=` or `return _={ … }=` in a `function` body")
            }
            if (isKnownOpenerWord(a.name) && a.name != "reset-on" && !isNoValue(a.value)) {
                // s473 (#1646 review F1): `single` (§66.13.3) and the validator
                // words (§55.1) take no `=value` — a validator's argument is its
                // call `min(18)`; this value was read by nothing, so the bound was
                // silently not enforced. §34 names no code for the `=` spelling.
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", valuedWordMessage(a.name))
            } else if (a.name == "reset-on" && !cell) {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`reset-on=` on `<" + d.name + ">`, a field of a declaration, is not in the bootstrap — whether a field's `reset-on=` may name a sibling field of the same instance (a per-instance reset) is OPEN (§6.8.4); it is read on a program cell")
            } else if (isPersistWord(a.name)) {
                // s451: on a program cell, persistPass reads them (§6.14)
                if (!cell) st = persistFieldDiag(file, d, a, st)
            } else if (!isKnownOpenerWord(a.name) && a.name.indexOf(":") < 0) {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", unknownOpenerMessage(a.name))
            }
        }
        for (const c of childFields(d.body)) { st = openerWordDiags(te, file, errs, c, false, st) }
        return st
    }

    // s473 fix round (F1) — §66.3: "**`date` / `timestamp`** (registered
    // string-shaped primitives) have no meaningful canonical empty → `not`", and
    // such a bare cell "initializes to **`not`** and the cell acquires an
    // **implicit `(not to T)` lifecycle** (§14.12)". The bootstrap types
    // `timestamp` as `string` (resolveTypeName), whose canonical empty is `""`,
    // and has no implicit lifecycle — so a `timestamp` cell with no own value is
    // refused by name rather than given `string`'s meaning
    // (g-bootstrap-timestamp-canonical-empty-s473). Only the BUILT-IN
    // `timestamp`: a user type of that name in scope wins (resolveTypeName),
    // and its cell is judged as any user type's (fix round 2).
    fn stampNoDefaultDiag(te: TypeEnv, file: string, d: ADecl, st: AS) -> AS {
        const ty: AType | not = d.ty
        if (ty is not) return st
        const k: ATypeK = ty.k
        const isStamp: boolean = match k {
            .TName(name: n) :> n == "timestamp" && isBuiltinTypeName(te, n)
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
        }
        if (!isStamp) return st
        const own: AAttrValue = d.own
        const none: boolean = match own {
            .NoValue :> true
            .Quoted(v: s) :> false
            .Bare(e: x) :> false
            .Paren(e: x) :> false
            .Braced(b: b) :> false
        }
        if (!none) return st
        return addDiag(st, file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + d.name + ":timestamp/>` with no value is not in the bootstrap — a bare `timestamp` cell starts as `not` with an implicit `(not to T)` lifecycle (§66.3, §14.12), which the bootstrap does not build (it types `timestamp` as `string`); give it a value: `<" + d.name + ":timestamp=\"…\"/>`")
    }

    // The declaration-opener words the bootstrap reads (besides the typed
    // attributes and the own value): `single` (§66.13.3); the validator words
    // are the parser's (it reports them, validatorMessage).
    fn isKnownOpenerWord(w: string) -> boolean {
        return w == "single" || w == "reset-on" || isValidatorName(w)
    }

    fn isValidatorName(w: string) -> boolean {
        return w == "req" || w == "length" || w == "pattern" || w == "min" || w == "max" || w == "gt" || w == "lt" ||
               w == "gte" || w == "lte" || w == "eq" || w == "neq" || w == "oneOf" || w == "notIn"
    }

    // s451 fix round (S239 review MED-1) — a word written TWICE in one opener
    // (`persist="local" persist="cookie"`, `single single`, `req req`,
    // `reset-on=[@q] reset-on=[@q]`, any modifier or validator) is refused:
    // every reader takes the first match, so the rest were silently dropped.
    // Searched §4, §5, §66.2 and §34 for a duplicate-attribute code — none
    // governs a repeated opener word — so E-BOOTSTRAP-UNSUPPORTED, by
    // construction for every name, at each repeat.
    fn repeatedWordDiags(file: string, d: ADecl, st0: AS) -> AS {
        let st: AS = st0
        let seen: string[] = []
        for (const a of d.mods) {
            if (seen.indexOf(a.name) >= 0) st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", repeatedMessage(d.name, a.name))
            seen = seen.concat([a.name])
        }
        // A validator CALL may repeat with other arguments — `length(>2)
        // length(<9)` is a conjunction every one of which is read (validators.
        // test.js pins it); a bare one (`req req`) says nothing twice.
        // s451 (S239 nit on #1260): a PRESENCE validator — `req`, `is some` —
        // is one predicate whatever its argument (§55.1: its argument is only a
        // message, §55.10), so `req req("m")` / `req("a") req` repeat it too.
        for (const v of d.validators) {
            if (seen.indexOf(v.name) >= 0 && (isBareValidator(v) || isPresenceValidator(v.name))) st = addDiag(st, file, v.span, "E-BOOTSTRAP-UNSUPPORTED", repeatedMessage(d.name, v.name))
            seen = seen.concat([v.name])
        }
        return st
    }

    // §55.1's presence predicates: `req` and `is given` — `is some` is its
    // soft-deprecated spelling (S462). The two-word forms reach the bootstrap
    // as the opener words `is` `given` / `is` `some`, refused as unknown — and a
    // second `is` is caught by the `mods` pass above.
    fn isPresenceValidator(name: string) -> boolean {
        return name == "req" || name == "is given" || name == "is some"
    }

    fn isBareValidator(v: AValidator) -> boolean {
        const a: AValArg = v.arg
        return match a {
            .NoArgs :> true
            .Cmp(op: o) :> false
            .Exprs(es: es) :> false
            .Regex(source: s) :> false
        }
    }

    fn repeatedMessage(decl: string, w: string) -> string {
        return "`" + w + "` is written twice on `<" + decl + ">` — the bootstrap reads one, so the other would be silently dropped; the SPEC names no code for a repeated opener word, so it is refused: write it once"
    }

    // s451 — the `persist=` storage value "session", spelled in pieces: impl#1
    // (which compiles the bootstrap) escalates a function to the SERVER when
    // its body holds the word `session` ANYWHERE, string literals included —
    // route-inference.ts SERVER_ONLY_PATTERNS `/(?<!@)\bsession\b/` is
    // string-blind (the `print(` and `Bun.*` triggers moved to the AST; this
    // one did not). Dogfood finding, s451.
    fn sessionWord() -> string { return "sess" + "ion" }

    // s451 — the §6.14 opener words: `persist=`, `key=` and `prepaint`.
    fn isPersistWord(w: string) -> boolean {
        return w == "persist" || w == "key" || w == "prepaint"
    }

    // s451 — a §6.14 word on a user declaration or on a field of one. §6.14.1
    // rule 3: "On a §66 declaration it governs the **shared instance only**";
    // where the attribute sits in a declaration, and per-instance keys, are
    // OPEN (O-061-9) — refused. `prepaint` with no `persist=` on the same
    // opener is §6.14.4.2 rule 2's error wherever it is written.
    fn persistFieldDiag(file: string, d: ADecl, a: AAttr, st: AS) -> AS {
        if (a.name == "prepaint" && attrNamed(d.mods, "persist") is not) {
            return addDiag(st, file, a.span, "E-PREPAINT-WITHOUT-PERSIST", "`prepaint` on `<" + d.name + ">`, which has no `persist=` — REFLECT pre-paints a STORED value, so it needs `persist=\"local\"` or `\"" + sessionWord() + "\"` + `key=` on the same cell (§6.14.4.2 rule 2)")
        }
        return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on `<" + d.name + ">`, a declaration or a field of one, is not in the bootstrap — on a §66 declaration `persist=` governs the shared instance only (§6.14.1 rule 3), and its position there and per-instance keys are OPEN (O-061-9); the bootstrap persists a program cell, `let <x:T=v persist=\"local\" key=\"app.x\"/>`")
    }

    fn valuedWordMessage(w: string) -> string {
        if (w == "single") return "`single=` — `single` is a bare modifier and takes no value (§66.13.3); the value would be ignored. Write `single`"
        return "`" + w + "=` — the validator `" + w + "` takes its argument as a call, `" + w + "(…)` (§55.1), or none (`req`); a `=` value is no validator spelling, and the bootstrap never ignores it (the bound would silently not be enforced)"
    }

    // s473 — the foreign blocks in an attribute value, at any depth.
    fn foreignsInAttrValue(v: AAttrValue) -> ASpan[] {
        return match v {
            .Bare(e: e) :> foreignsInExpr(e)
            .Paren(e: e) :> foreignsInExpr(e)
            .Braced(b: b) :> foreignsInBlock(b)
            .Quoted(v: s) :> []
            .NoValue :> []
        }
    }

    fn unknownOpenerMessage(w: string) -> string {
        return "`" + w + "` in a declaration opener is not in the bootstrap — it reads only typed attributes, the own value, `single` and validators there, and never ignores a word it does not implement"
    }

    // r1 G2 / r2 item 1: an own value AND typed attributes on one declaration —
    // what `@x` then is, is ⚑ O19 (OPEN). Refused, not decided — on the
    // declaration itself and on every child field, at any depth.
    fn o19Diags(file: string, d: ADecl, st0: AS) -> AS {
        let st: AS = st0
        // r3: an own TYPE with no initializer (`<c:int s:int=7/>`) is an own value too
        if ((hasOwnValue(d.own) || hasOwnType(d)) && d.attrs.length > 0) {
            st = addDiag(st, file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + d.name + ">` has an own value (or an own type) AND attributes — what `@" + d.name + "` then names is ⚑ O19 (not ruled); the bootstrap does not decide it")
        }
        for (const c of childFields(d.body)) { st = o19Diags(file, c, st) }
        return st
    }

    // A declared own type other than the `:struct` container marker (§66.2.2).
    fn hasOwnType(d: ADecl) -> boolean {
        if (d.ty is not) return false
        return ownTypeName(d) != "struct"
    }

    fn hasOwnValue(v: AAttrValue) -> boolean {
        return match v {
            .NoValue :> false
            .Quoted(v: x) :> true
            .Bare(e: x) :> true
            .Paren(e: x) :> true
            .Braced(b: b) :> true
        }
    }

    fn ownTypeName(d: ADecl) -> string {
        const t: AType | not = d.ty
        if (t is not) return ""
        const k: ATypeK = t.k
        return match k {
            .TName(name: n) :> n
            .TSeq(elem: e) :> ""
            .TMaybe(inner: i) :> ""
        }
    }

    // ---- Phase A driver -----------------------------------------------------------------
    type RGlobals:struct = { g: Globals, st: AS }

    fn phaseA(files: FileAst[], entry: string, st0: AS) -> RGlobals {
        let st: AS = st0
        const rs: RStubs = typeStubs(files, st)
        st = rs.st
        const rd: RDeclStubs = declStubs(files, entry, st)
        st = programShapeDiags(files, entry, rd.st)
        let declNames: string[] = []
        let declSyms: Sym[] = []
        let declFiles: string[] = []
        let program: Sym = mkSym(-1, "program")
        let hasProgram = false
        for (const d of rd.ds) {
            if (d.isProgram) {
                hasProgram = true
                program = d.sym
            } else {
                declNames = declNames.concat([d.sym.hint])
                declSyms = declSyms.concat([d.sym])
                declFiles = declFiles.concat([d.file])
            }
        }
        // s472: each file's scope (the imports' bindings judged here — §41.7, §7.6)
        const rl: RLinkage = linkage(files, ownNames(files, rs.stubs, rd.ds), st)
        st = rl.st
        const lk: Linkage = rl.lk
        if (!hasProgram) st = addDiag(st, entry, mkSpan(0, 0), "E-PROGRAM-MISSING", "the entry file has no `<program>`")
        const te0: TypeEnv = { stubs: rs.stubs, declNames: declNames, declSyms: declSyms, declFiles: declFiles, link: lk, file: entry }
        st = namedInstanceDiags(te0, rd.ds, declNames, files, st)
        const rt: RTypeInfos = typeInfos(rs.stubs, te0, st)
        st = rt.st
        const rf00: RFns = fnsOf(files, te0, st)
        st = rf00.st
        // s472 (boot-math-port): the host-backed functions (the §21.3.1 wrapper rule)
        const rh: RHostFns = hostWrappers(files, te0, rf00.fs, st)
        st = rh.st
        // s473 (boot-host-block-f3): the `<host>` bindings (DRAFT §21.3.3)
        const rhb: RFns = hostBindings(files, te0, rt.ts, rh.fs, st)
        st = rhb.st
        const rf0: RFns = { fs: rhb.fs, st: st }
        // s454 (U1b): the failure enum of a client call of each server-triggered function
        const rr: RRemoteEnums = remoteEnums(rf0.fs, rt.ts, builtinSym(rs.stubs, serverCallErrorName()), st)
        st = rr.st
        const rf: RFns = { fs: rr.fs, st: st }
        const allTypes: TypeInfo[] = rt.ts.concat(rr.minted)
        // s462 (§66.3 rules 5–8): every program cell's type, inferred where none
        // is written — before any field is built, since a field's `@ref` (in
        // any declaration) resolves against the program's cells
        const icx: InferCx = { te: te0, fns: rf.fs, st: st, srcs: programSrcs(rd.ds), res: false,
                               types: allTypes, decls: rd.ds, handles: allHandles(rd.ds, lk, st),
                               hscope: programNid(rd.ds), prog: programNid(rd.ds), progFile: entry }
        const ownTab: OwnT[] = ownTable(icx)
        // fields + handles per declaration
        let decls: DeclSrc[] = []
        let handles: HandleInfo[] = []
        for (const ds of rd.ds) {
            const te: TypeEnv = teAt(te0, ds.file)
            const dcx: InferCx = cxAt(icx, ds.file)
            let fields: FieldInfo[] = []
            let single = false
            const p: AProgram | not = ds.p
            const d: ADecl | not = ds.d
            if (p is given) {
                const r: RFields = programFields(te, rt.ts, p, dcx, ownTab, st)
                fields = r.fs
                st = r.st
                single = true
            } else if (d is given) {
                const r2: RFields = userFields(te, rt.ts, d, dcx, ownTab, st)
                fields = r2.fs
                st = r2.st
                single = hasFlag(d.mods, "single")
            }
            fields = trustFields(fields, fileErrs(files, ds.file))
            const rh: RHandles = handlesIn(stubsInScope(rd.ds, lk, ds.file), rendersNodes(ds), { owner: ds.nid, conditional: false, file: ds.file }, st)
            st = rh.st
            handles = handles.concat(rh.hs)
            let own: Sym[] = []
            for (const h of rh.hs) {
                if (h.owner == ds.nid) own = own.concat([h.sym])
            }
            let kind: DeclKind = DeclKind.User
            if (ds.isProgram) kind = DeclKind.Program
            const info: DeclInfo = { nid: ds.nid, span: declSpan(ds), sym: ds.sym, kind: kind, single: single, file: ds.file, fields: fields, handles: own }
            decls = decls.concat([{ info: info, file: ds.file, isProgram: ds.isProgram, d: ds.d, p: ds.p }])
        }
        const rc: RCycles = derivedCycles(decls, files, st)
        st = rc.st
        decls = rc.decls
        // s472: the file-scope constants' Syms and written types (their values: constPass)
        const rk: RConsts = constStubs(files, te0, st)
        st = rk.st
        const g: Globals = { program: program, entry: entry, te: te0, types: allTypes, decls: decls, fns: rf.fs, handles: handles, files: files,
                             errorSym: builtinSym(rs.stubs, "Error"), sqlErrorSym: builtinSym(rs.stubs, "SqlError"),
                             sceSym: builtinSym(rs.stubs, serverCallErrorName()), voids: voidFns(rf.fs, lk), hostSites: rh.sites, consts: rk.cs }
        return { g: g, st: st }
    }

    // s462 — E-DERIVED-CIRCULAR-DEP (§6.6.10; §66.3 rule 8: "the cycle's
    // diagnostic is reported and E-DECL-TYPE-NOT-INFERABLE is not"). A program
    // cell that is DERIVED (§66.9 rule 3) and reads, directly by `@x`, a
    // derived cell that reads it back — annotated or not. One report per
    // cycle, at its first member in source order. (A read through a function
    // is not followed: the bootstrap's effect summary does not trace reads
    // yet — a cycle only through a function's body is not reported here: a
    // stated divergence from §6.6.10, g-bootstrap-derived-cycle-through-function-s462.)
    // Fix round 1 (F3): the cycle code OUTRANKS — every member of a reported
    // cycle has its own-value report withdrawn (its origin becomes Blamed:
    // the cycle owns it), whether that report would have been
    // E-DECL-TYPE-NOT-INFERABLE, -REQUIRED-AT-BOUNDARY or -UNPROVEN.
    type DEdge:struct = { from: int, to: int }
    type RCycles:struct = { st: AS, decls: DeclSrc[] }

    fn derivedCycles(decls: DeclSrc[], files: FileAst[], st0: AS) -> RCycles {
        let st: AS = st0
        let out: DeclSrc[] = []
        for (const ds of decls) {
            let members: int[] = []
            if (ds.isProgram) {
                const fs: FieldInfo[] = ds.info.fields
                const errs: ASpan[] = fileErrs(files, ds.file)
                let es: DEdge[] = []
                let i = 0
                for (const f of fs) {
                    const m: FieldMode = f.mode
                    if (m == FieldMode.Derived) {
                        for (const r of f.reads) {
                            if (r.substring(0, 1) == "@") {
                                const j: int = fieldIndex(ds.info, r.substring(1))
                                if (j >= 0) {
                                    const mj: FieldMode = fs[j].mode
                                    if (mj == FieldMode.Derived) es = es.concat([{ from: i, to: j }])
                                }
                            }
                        }
                    }
                    i = i + 1
                }
                let k = 0
                while (k < fs.length) {
                    const path: int[] = derivedPath(es, k, k, [])
                    if (path.length > 0 && !hasErrIn(errs, fs[k].span)) {
                        let names: string[] = []
                        for (const p of path) { names = names.concat(["@" + fs[p].sym.hint]) }
                        names = names.concat(["@" + fs[k].sym.hint])
                        st = addDiag(st, ds.file, fs[k].span, "E-DERIVED-CIRCULAR-DEP", "`@" + fs[k].sym.hint + "` is derived from itself: " + names.join(" → ") + " — a derived value (a locked declaration whose initializer reads cells) cannot depend on itself, it would recompute forever (§6.6.10); break the cycle")
                        members = members.concat(path).concat([k])
                    }
                    k = k + 1
                }
            }
            if (members.length == 0) {
                out = out.concat([ds])
            } else {
                let nf: FieldInfo[] = []
                let j2 = 0
                for (const f of ds.info.fields) {
                    if (members.indexOf(j2) >= 0) {
                        nf = nf.concat([withOrigin(f, TypeOrigin.Blamed)])
                    } else {
                        nf = nf.concat([f])
                    }
                    j2 = j2 + 1
                }
                const di: DeclInfo = ds.info
                const ni: DeclInfo = { nid: di.nid, span: di.span, sym: di.sym, kind: di.kind, single: di.single, file: di.file, fields: nf, handles: di.handles }
                out = out.concat([{ info: ni, file: ds.file, isProgram: ds.isProgram, d: ds.d, p: ds.p }])
            }
        }
        return { st: st, decls: out }
    }

    // A written / literal / inferred origin is kept (there is nothing to withdraw).
    fn withOrigin(f: FieldInfo, o0: TypeOrigin) -> FieldInfo {
        const cur: TypeOrigin = f.origin
        const keep: boolean = match cur {
            .Written :> true
            .Literal :> true
            .Inferred :> true
            .Blamed :> true
            .WrittenUnproven(why: w) :> false
            .Failed(why: w) :> false
            .Cyclic(names: ns) :> false
            .Boundary(where: b) :> false
        }
        let o: TypeOrigin = o0
        if (keep) o = cur
        return { nid: f.nid, span: f.span, annotated: f.annotated, trusted: f.trusted, typeSpan: f.typeSpan, sym: f.sym, ty: f.ty, mode: f.mode,
                 role: f.role, grants: f.grants, graph: f.graph, exported: f.exported, wcap: f.wcap, init: f.init, reads: f.reads,
                 shrink: f.shrink, vals: f.vals, valsWritten: f.valsWritten, origin: o }
    }

    // A path from `at` back to `start` through cells numbered above `start`
    // (so each cycle is found once, at its first member); [] when none.
    fn derivedPath(es: DEdge[], start: int, at: int, seen: int[]) -> int[] {
        for (const e of es) {
            if (e.from == at) {
                if (e.to == start) return seen.concat([at])
                if (e.to > start && seen.indexOf(e.to) < 0 && e.to != at) {
                    const p: int[] = derivedPath(es, start, e.to, seen.concat([at]))
                    if (p.length > 0) return p
                }
            }
        }
        return []
    }

    // r2 F4 — does a body read the clock (`Date.now()`) ITSELF? The effect
    // summary's own `clock` fact (dpa-066 M3: the name-keyed whole-program
    // set this section used to close over calls is retired — the summary
    // closes it over the binder's Syms, rulesPass reads it). Syntactic — the
    // call's shape, wherever it stands (a `fn` body too, where E-FN-004 also
    // reports it).
    fn blockClock(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtClock(s)) return true
        }
        return false
    }

    fn stmtClock(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> exprClock(e)
            .Local(name: n, init: i) :> exprClock(i)
            .Return(e: e) :> maybeClock(e)
            .If(cond: c, thenB: t, elseB: el) :> exprClock(c) || blockClock(t) || maybeBlockClock(el)
            .Given(name: n, subject: sub, body: b) :> exprClock(sub) || blockClock(b)
            .For(f: lf) :> exprsClock(forExprs(lf)) || blockClock(lf.body)
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: w) :> exprsClock(liftExprs(w))
            .EffectStmt(w: w) :> blockClock(w.body)
            .Defer(body: b) :> blockClock(b)
            .Fail(f: f) :> exprsClock(failExprs(f))
        }
    }

    fn exprsClock(es: AExpr[]) -> boolean {
        for (const x of es) {
            if (exprClock(x)) return true
        }
        return false
    }

    fn maybeClock(e: AExpr | not) -> boolean {
        if (e is not) return false
        return exprClock(e)
    }

    fn maybeBlockClock(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockClock(b)
    }

    fn exprClock(e: AExpr) -> boolean {
        if (isClockCall(e)) return true
        for (const x of exprKids(e)) {
            if (exprClock(x)) return true
        }
        for (const b of exprBlocks(e)) {
            if (blockClock(b)) return true
        }
        return false
    }

    fn isClockCall(e: AExpr) -> boolean {
        const k: AExprK = e.k
        const c: AExpr | not = calleeOf(k)
        if (c is not) return false
        const m: MethodCall | not = memberCall(c)
        if (m is not) return false
        return m.method == "now" && exprName(m.obj) == "Date"
    }

    fn calleeOf(k: AExprK) -> AExpr | not {
        return match k {
            .Call(callee: c) :> c
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: ix) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    // =========================================================================
    // Phase B — resolving bodies: expressions, statements, writes, views.
    // =========================================================================
    // Where code sits (L1): a function body, or a declaration's initializers /
    // renders (the program is one — R4).
    type CtxK:enum = { InFn, InDecl(owner: Sym, isProgram: boolean) }
    // s444 — where a host call (`Date.now()`) may stand (the host-call surface,
    // progress.md): a `function` body or an event handler (HostOk); a pure
    // `fn` body (HostPure → E-FN-004, §33.3 item 7 / §48.3.4); anywhere else —
    // initializers, markup, `if=` / `in=` values — not in the bootstrap (HostNo).
    type HostCtx:enum = { HostNo, HostOk, HostPure }

    type LocalB:struct = { name: string, s: Sym, ty: Type | not, mutable: boolean, narrowed: InstRef | not, nDecl: Sym | not, fresh: boolean }   // s473 `fresh`: a `const` bound to an object / array literal — scrml data, never a host value (the plain-logic sink judgment)
    type RowB:struct = { bind: Sym, ty: Type | not }
    // `@name` narrowed by an enclosing `given c = @name :> { … }` (§66.7.5, O56
    // RULED S435: "A direct `@handle.field = …` inside the narrowed block is
    // legal"; reads S437): inside the block `@name` IS the narrowed instance
    // `c`, so a direct `@name.f = …` / `@name.f` there goes through `c` exactly
    // as `c.f` does. Scoped to the block and to the handle named.
    type NarrowB:struct = { name: string, ty: Type | not, inst: InstRef, iDecl: Sym }

    // `present`: the conditional handles a PRESENCE TEST has proven mounted here
    // (RULED S442: "the S437 conditional-handle rule vs Q1: the presence test
    // COUNTS AS the narrowing (`if=@color` is legal; reads inside are
    // narrowed)"). Inside, `@h` is not `maybe`.
    type Env:struct = {
        g: Globals,
        file: string,
        ctx: CtxK,
        locals: LocalB[],
        rows: RowB[],
        handles: HandleInfo[],
        inRenders: boolean,
        narrows: NarrowB[],
        present: string[],
        host: HostCtx,          // s444: may a host call stand here?
        own: string,            // s444: the child field whose own `renders` this is ("" — none): `@own` is this instance (O54 = (a), RULED S442)
        inEffect: boolean,      // s449: inside an effect body (an effect there is E-LIFECYCLE-016, §6.7.4)
        fx: FailCtx,            // s451 (Ue): the error-model context (see FailCtx)
        lift: LiftCtx,          // s469 (§49.6): where a `lift` here appends (see LiftCtx)
    }

    // s469 — where a `lift` appends (§49.6 rule 7: "to the nearest enclosing
    // bound loop"): `LiftTo(into, tier0)` inside a bound loop's body — `into`
    // the loop's tape (a `for-binding`'s binder, or a Tier-0 loop's
    // accumulator; `tier0`: markup may be lifted); `LiftInArm` inside an arm
    // block (refused: §18.5 makes an arm block's `lift` the arm's value);
    // `NoLift` anywhere else. A function body, a handler block and an effect
    // body start at NoLift (a loop does not reach across them, §49.4.3).
    type LiftCtx:enum = {
        NoLift,
        LiftTo(into: Sym, tier0: boolean),
        LiftInArm,
    }

    fn withLift(env: Env, l: LiftCtx) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx, lift: l }
    }

    // s451 (Ue) — the error-model context of the code being resolved.
    // `inFn` / `fnName` / `failable` / `err`: the enclosing function
    // DECLARATION (a handler, an effect and a declaration's markup are not
    // one — "a handler is not a `!` function", §19.4.3); `defer`: inside a
    // deferred body (§19.16.3 rule 3); `subject`: the node being resolved as a
    // handling form's subject (its failable is handled there); `whole`: the
    // node that is a statement's WHOLE value — the one place a handling form
    // stands in this slice (nested ones are Ue2's).
    // `fnRef` (review HIGH-2): the one node allowed to NAME a function without
    // calling it here — a direct call's callee, or an event-handler reference.
    // `wholeWhat` (s452): what position `whole` is, for E-ERROR-012's message
    // ("the initializer of `x`", "a `return` operand", …; "" — not named).
    // s454 (U1b): `fnSym` — the enclosing function's Sym id (-1: not in a
    // function); `serverOwn` — its own body places it on the server (§12.2
    // T1/T4), so a call made in it is server→server whatever the rest of the
    // program does (§19.9.10 "Not affected: A server→server call").
    type FailCtx:struct = { inFn: boolean, fnName: string, failable: boolean, err: Sym | not, defer: boolean, subject: int, whole: int, fnRef: int, wholeWhat: string, fnSym: int, serverOwn: boolean, stmtCall: int }

    fn noFailCtx() -> FailCtx { return { inFn: false, fnName: "", failable: false, err: not, defer: false, subject: -1, whole: -1, fnRef: -1, wholeWhat: "", fnSym: -1, serverOwn: false, stmtCall: -1 } }

    fn withFx(env: Env, fx: FailCtx) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: fx, lift: env.lift }
    }

    fn withSubject(env: Env, nid: int) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: f.defer, subject: nid, whole: f.whole, fnRef: f.fnRef, wholeWhat: f.wholeWhat, fnSym: f.fnSym, serverOwn: f.serverOwn, stmtCall: f.stmtCall })
    }

    fn withWhole(env: Env, nid: int) -> Env {
        return withWholeAt(env, nid, "")
    }

    // s452: `nid` is a statement's whole value standing in position `what`
    // (named in E-ERROR-012's message).
    fn withWholeAt(env: Env, nid: int, what: string) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: f.defer, subject: f.subject, whole: nid, fnRef: f.fnRef, wholeWhat: what, fnSym: f.fnSym, serverOwn: f.serverOwn, stmtCall: f.stmtCall })
    }

    fn withFnRef(env: Env, nid: int) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: f.defer, subject: f.subject, whole: f.whole, fnRef: nid, wholeWhat: f.wholeWhat, fnSym: f.fnSym, serverOwn: f.serverOwn, stmtCall: f.stmtCall })
    }

    // s469 (#1471 round-2 MED-2): `nid` is a call evaluated as a STATEMENT (its result is
    // not read), or one whose no-value use another rule already reports (an arm's value,
    // E-ERROR-012) — resolveCall does not report it as a value use.
    fn withStmtCall(env: Env, nid: int) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: f.defer, subject: f.subject, whole: f.whole, fnRef: f.fnRef, wholeWhat: f.wholeWhat, fnSym: f.fnSym, serverOwn: f.serverOwn, stmtCall: nid })
    }

    fn withDeferFx(env: Env) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: true, subject: f.subject, whole: f.whole, fnRef: f.fnRef, wholeWhat: f.wholeWhat, fnSym: f.fnSym, serverOwn: f.serverOwn, stmtCall: f.stmtCall })
    }

    fn withLocal(env: Env, l: LocalB) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals.concat([l]), rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx, lift: env.lift }
    }

    fn withRow(env: Env, row: RowB, name: string, hs: HandleInfo[]) -> Env {
        const l: LocalB = { name: name, s: row.bind, ty: row.ty, mutable: false, narrowed: not, nDecl: not, fresh: false }
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals.concat([l]), rows: env.rows.concat([row]),
                 handles: env.handles.concat(hs), inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx, lift: env.lift }
    }

    fn withNarrow(env: Env, n: NarrowB) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows.concat([n]), present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx, lift: env.lift }
    }

    fn withPresent(env: Env, name: string) -> Env {
        if (name == "") return env
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present.concat([name]), host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx, lift: env.lift }
    }

    fn withHost(env: Env, h: HostCtx) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: h, own: env.own, inEffect: env.inEffect, fx: env.fx, lift: env.lift }
    }

    fn withOwn(env: Env, name: string) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: name, inEffect: env.inEffect, fx: env.fx, lift: env.lift }
    }

    // s449: an effect body — a logic context (§6.7.4 "same rules as `${}`") run
    // on a change: a host call may stand in it, as in a handler (it is the
    // effect's job to call the outside world), and an effect inside it is
    // E-LIFECYCLE-016.
    fn effectBodyEnv(env: Env) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: HostCtx.HostOk, own: env.own, inEffect: true, fx: env.fx, lift: LiftCtx.NoLift }
    }

    // s444 — O54 = (a) (RULED S442: "`@email` inside `email`'s own `renders` …
    // Rec: this instance."): inside a CHILD field's own renders, `@<field>`
    // names that field of the current instance (Lexical(0) — the declaration
    // instance that holds it). -1 = not the own field.
    fn ownFieldIndex(env: Env, name: string) -> int {
        if (env.own == "" || env.own != name) return -1
        const d: DeclSrc | not = ctxDecl(env)
        if (d is not) return -1
        if (d.isProgram) return -1
        return fieldIndex(d.info, name)
    }

    // The conditional handle a condition tests for presence ("" — none): a
    // BARE `@h` (the ruled spelling, `if=@color`), where `@h` is a conditional
    // handle in scope not narrowed by a `given`. (`@h is given` is not taken:
    // its `@h` lowers as a snapshot read — still S437's read rule. `@h != not`
    // is E-EQ-002 since s469.)
    fn presenceHandle(env: Env, c: AExpr) -> string {
        return condHandleNamed(env, atName(c))
    }

    fn condHandleNamed(env: Env, n: string) -> string {
        if (n == "") return ""
        if (lookupNarrow(env, n) is given) return ""
        const h: HandleInfo | not = lookupHandle(env, n)
        if (h is not) return ""
        if (!h.conditional) return ""
        return n
    }

    // A condition: a presence test of a conditional handle resolves its `@h`
    // as a SUBJECT (not a read — the test is the narrowing, ruled S442).
    fn resolveCond(env: Env, c: AExpr, st0: AS) -> AS {
        const st: AS = keptHeadAliasing(env, c, st0)
        const h: string = presenceHandle(env, c)
        if (h == "") return resolveExpr(env, c, Type.Bool, st).st
        return resolveExpr(withPresent(env, h), c, Type.Bool, st).st
    }

    // s474 (#1700 review F1) — a kept condition-head assignment's local named
    // ANYWHERE else in the same head (a second kept assignment of it, or a read
    // / presence test of it in another operand) is refused by name: the typer's
    // head narrowing is not ordered, so `((m = a) is given && ((m = b) is not ||
    // true))` would leave `m` narrowed present by the first operand after the
    // second rebound it. Its own value may read it (`((m = m + 1) > 0)` — the
    // value is evaluated before the rebinding). Fail closed (D28): the language
    // admits these heads; the bootstrap does not type them soundly yet.
    fn keptHeadAliasing(env: Env, c: AExpr, st0: AS) -> AS {
        let st: AS = st0
        for (const a of keptAssigns(c)) {
            const t: AExpr | not = keptTargetExpr(a)
            const v: AExpr | not = assignValue(a)
            if (t is given && v is given) {
                const n: string = exprName(t)
                if (n != "" && nameCount(c, n) > 1 + nameCount(v, n)) {
                    st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + n + "` is the target of this condition-head assignment and is named again elsewhere in the same head — a second assignment of it, or a read / test of it in another operand. The bootstrap does not yet track the order of such a head (its narrowing could outlive the rebinding), so it refuses it: assign `" + n + "` once in the head and test it in a nested `if` inside the body (§50, S473 D10)")
                }
            }
        }
        return st
    }

    fn nameCount(e: AExpr, n: string) -> int {
        let c: int = 0
        if (exprName(e) == n) c = 1
        for (const x of exprKids(e)) { c = c + nameCount(x, n) }
        return c
    }

    fn keptTargetExpr(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t) :> t
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: x) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn lookupNarrow(env: Env, name: string) -> NarrowB | not {
        let i: int = env.narrows.length - 1
        while (i >= 0) {
            if (env.narrows[i].name == name) return env.narrows[i]
            i = i - 1
        }
        return not
    }

    fn lookupLocal(env: Env, name: string) -> LocalB | not {
        let i: int = env.locals.length - 1
        while (i >= 0) {
            if (env.locals[i].name == name) return env.locals[i]
            i = i - 1
        }
        return not
    }

    fn lookupHandle(env: Env, name: string) -> HandleInfo | not {
        let i: int = env.handles.length - 1
        while (i >= 0) {
            if (env.handles[i].name == name) return env.handles[i]
            i = i - 1
        }
        return not
    }

    fn ctxDecl(env: Env) -> DeclSrc | not {
        const c: CtxK = env.ctx
        return match c {
            .InDecl(owner: o) :> findDeclSrc(env.g, o)
            .InFn :> not
        }
    }

    fn inProgramCtx(env: Env) -> boolean {
        const c: CtxK = env.ctx
        return match c {
            .InDecl(owner: o, isProgram: p) :> p
            .InFn :> false
        }
    }

    // L1: the program's fields from here — its own initializers / renders use
    // the lexically enclosing instance; everything else the shared instance.
    fn programInst(env: Env) -> InstRef {
        if (inProgramCtx(env)) return InstRef.Lexical(0)
        return InstRef.Shared(env.g.program)
    }

    // The program's cells, when code in THIS file can see them: §7.6.1 — a
    // file-level cell is reachable as `@x` "in the same file". A library's
    // `@x` never reaches the app that links it (its meaning must not depend on
    // which app imports it).
    fn programInfo(env: Env) -> DeclInfo | not {
        const d: DeclSrc | not = findDeclSrc(env.g, env.g.program)
        if (d is not) return not
        if (d.file != env.file) return not
        return d.info
    }

    // A user declaration named `name` that THIS file can see: declared here, or
    // imported here (§21.3). Only such a one is `@name`'s shared instance (§66.7.1).
    fn visibleDecl(env: Env, name: string) -> DeclSrc | not {
        return declNamed(env.g, env.file, name)     // s472: declared here, or imported FROM ITS FILE (was: any import of the name)
    }

    // ---- expression results -------------------------------------------------
    // `inst` / `iDecl`: the expression names an INSTANCE (a handle, the current
    // instance, a shared instance, a narrowed local); `maybe`: a conditional
    // handle, not narrowed (§66.7.5).
    type XI:struct = { ty: Type | not, inst: InstRef | not, iDecl: Sym | not, maybe: boolean }
    type RX:struct = { x: XI, st: AS }

    fn plain(t: Type | not, st: AS) -> RX { return { x: { ty: t, inst: not, iDecl: not, maybe: false }, st: st } }

    fn diagX(env: Env, e: AExpr, code: string, msg: string, st: AS) -> RX {
        return plain(not, addDiag(st, env.file, e.span, code, msg))
    }

    fn resolveExprs(env: Env, es: AExpr[], expected: Type | not, st0: AS) -> AS {
        let st: AS = st0
        for (const e of es) { st = resolveExpr(env, e, expected, st).st }
        return st
    }

    // s469 (templates review H1, BACKSTOP) — a Recovered node is a parse-error
    // placeholder: lower turns it into `not`, which is only safe because the
    // parser's Error stops the build (lower.scrml hasError). A Recovered node
    // in a file with NO Error-severity parse diagnostic would reach the printer
    // as a silent `null` — an internal compiler error, reported (fail closed).
    // The Error-severity parse spans of the file being resolved.
    fn envParseErrs(env: Env) -> ASpan[] { return fileErrs(env.g.files, env.file) }

    fn recoveredBackstop(env: Env, e: AExpr, st: AS) -> AS {
        if (envParseErrs(env).length > 0) return st
        return addDiag(st, env.file, e.span, "E-INTERNAL-RECOVERED-UNREPORTED", "internal compiler error: the parser left a placeholder here (it could not read this expression) but reported no error for this file — the program would compile with this expression silently replaced by `not`. This is a compiler bug; the build is stopped")
    }

    fn resolveExpr(env: Env, e: AExpr, expected: Type | not, st: AS) -> RX {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> resolveName(env, e, n, st)
            .At(name: n) :> resolveAtRead(env, e, n, st)
            .AtItem :> resolveAtItem(env, e, st)
            .Num(raw: r) :> resolveNum(e, r, st)
            .Str(v: s) :> plain(Type.Str, addValue(st, e.nid, ValueFact.VLit(Literal.Str(s))))
            .Bool(v: b) :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VLit(Literal.Bool(b))))
            .NotLit :> plain(expected, addValue(st, e.nid, ValueFact.VLit(Literal.Absent)))
            .Recovered :> plain(not, recoveredBackstop(env, e, st))   // the parser reported it: no fact, no type
            .Variant(name: n) :> resolveVariant(env, e, n, expected, st)
            .Member(obj: o, name: n) :> resolveMember(env, e, o, n, st)
            .Call(callee: c, args: args) :> resolveCallOrConstruct(env, e, c, args, expected, st)
            .Unary(op: o, e: x) :> resolveUnary(env, e, o, x, st)
            .Binary(op: o, l: l, r: r) :> resolveBinary(env, e, o, l, r, st)
            .Ternary(test: t, yes: y, no: n) :> resolveTernary(env, e, t, y, n, expected, st)
            .Assign(target: t, value: av, kept: kp) :> assignAsValue(env, e, t, av, kp, st)   // s474: the §50 kept form
            .ArrayLit(elems: es) :> resolveArray(env, e, es, expected, st)
            .ObjectLit(props: ps) :> resolveObject(env, e, ps, expected, st)
            .Spread(e: x) :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "an array spread `...` is in the bootstrap only as a recognized edit shape (`@x = [...@x, e]`, §66.11.2) — Core has no spread value", st)
            .Index(obj: o, idx: ix) :> resolveIndexRead(env, e, o, ix, st)   // s469 (§49.13)
            .Lambda(params: ps2) :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "an arrow function is in the bootstrap only as the argument of `.filter(…)` / `.map(…)` on a sequence", st)
            .Sql(q: q) :> resolveSql(env, e, q, false, st)   // s451: a query's values are bound like any expression; its facts are placePass's; (Ue) its failable rule here
            .Handled(h: h) :> resolveHandled(env, e, h, false, expected, st)   // s451 (Ue); s469 the plain-value match
            .Template(quasis: qs, slots: ss) :> resolveTemplate(env, e, ss, st)   // s469 (§14.13.3)
            .Foreign(f: fb0) :> resolveForeign(env, e, fb0, st)                 // s473 (§23.2.4a)
        }
    }

    // s474 (§50 amendment, S473 D10): "The ONLY assignment-as-expression the
    // language keeps is an assignment wrapped in its own parentheses inside the
    // condition head of a `for (…)` or `if (…)` / `else if (…)`" — parse.scrml
    // keptHead marks it `kept`. Its target is an lvalue (§50.2.1: `lvalue ::=
    // identifier | reactive-lvalue`): a `let` local is built — rebound, and the
    // expression's value is the assigned value (§50.3.1), its type the value's
    // (§50.4.1, the typer); a `const` local is E-ASSIGN-CONST, as the statement
    // form (§50.3.5 "same error as a statement-level `const` reassignment"); a
    // CELL target (`((@x = e))`, §50.3.4) is not built — refused by name; any
    // other target is not an lvalue, so not the kept form: E-ASSIGN-POSITION.
    fn assignAsValue(env: Env, e: AExpr, t: AExpr, v: AExpr, kept: boolean, st: AS) -> RX {
        if (!kept) return resolveValueAssign(env, e, t, v, st)
        const sw: string = assignSinkWhy(env, t, v)      // #1700 review F4: the statement form's judgement
        if (sw != "") return diagX(env, e, "E-LOGIC-EXECUTABLE-SINK", sinkMessage(sw), st)
        const rp: RPlace = resolvePlace(env, t, st)
        const l: LocalB | not = rp.local
        if (l is given && exprName(t) != "") {
            let st1: AS = rp.st
            if (!l.mutable) st1 = addDiag(st1, env.file, t.span, "E-ASSIGN-CONST", "`" + l.name + "` is not a `let` local")
            st1 = addEffect(st1, e.nid, EffectFact.EAssignLocal(l.s, [], not))
            return resolveExpr(env, v, l.ty, st1)
        }
        if (rp.place is given) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "a CELL as the target of a condition-head assignment (`((" + placeKey(t) + " = …))`, §50.3.4) is not in the bootstrap yet — write the cell in a statement before the test (`" + placeKey(t) + " = …;` then `if (" + placeKey(t) + " …)`); a `let` local is built (`((x = e))`)", resolveExpr(env, v, not, rp.st).st)
        return diagX(env, e, "E-ASSIGN-POSITION", "the kept condition-head assignment `((x = e))` assigns a VARIABLE (§50.2.1 `lvalue ::= identifier`) — `" + placeKey(t) + "` is not one, so this is an assignment used as a value (S473 D10). Write it as a statement before the test", resolveExpr(env, v, not, rp.st).st)
    }

    // An assignment where a value stands is E-ASSIGN-POSITION; one that writes an
    // executable sink is reported as the sink (s473, §5.2 — the #1663 review probe
    // `@s = (@w.innerHTML = @s)`), so the refusal names the hazard, not the position.
    fn resolveValueAssign(env: Env, e: AExpr, t: AExpr, v: AExpr, st: AS) -> RX {
        if (!env.fx.serverOwn) {
            const sw: string = sinkTargetWhy(env, t, v)
            if (sw != "") return diagX(env, e, "E-LOGIC-EXECUTABLE-SINK", sinkMessage(sw), st)
        }
        return diagX(env, e, "E-ASSIGN-POSITION", "an assignment is a statement — it cannot be used as a value", st)
    }

    fn resolveNum(e: AExpr, raw: string, st: AS) -> RX {
        const t: Type = numType(raw)
        const n: number = Number(raw)
        const isInt: boolean = t == Type.Int
        if (isInt) return plain(t, addValue(st, e.nid, ValueFact.VLit(Literal.Int(n))))
        return plain(t, addValue(st, e.nid, ValueFact.VLit(Literal.Num(n))))
    }

    // s473 (§47.1.1): a REFERENCE to a reserved-prefix name is refused too
    // (S440 #9, S457 — reservedName); then resolved as any name is.
    fn resolveName(env: Env, e: AExpr, name: string, st: AS) -> RX {
        return resolveNameOf(env, e, name, reservedName(st, env.file, e.span, name))
    }

    fn resolveNameOf(env: Env, e: AExpr, name: string, st: AS) -> RX {
        const l: LocalB | not = lookupLocal(env, name)
        // s473 — §5.2 "Executable sinks in plain logic (S473)" (the #1663 review F3):
        // `eval` / `Function` as a VALUE (`const f = eval`, `.map(Function)`)
        if (l is not && (name == "eval" || name == "Function")) return diagX(env, e, "E-LOGIC-EXECUTABLE-SINK", sinkMessage("refers to `" + name + "` as a value — a function that runs source text as JavaScript, refused wherever it is called"), st)
        if (l is given) {
            const st2: AS = addName(st, e.nid, NameFact.NLocal(l.s))
            if (l.narrowed is given) return { x: { ty: l.ty, inst: l.narrowed, iDecl: l.nDecl, maybe: false }, st: st2 }
            return plain(l.ty, st2)
        }
        // s472 (boot-math-port): an `import:host` binding of this file (§21.3.1)
        const hb: AImport | not = hostImportBinding(env.g.files, env.file, name)
        if (hb is given) return resolveHostBinding(env, e, name, hb, st)
        // §66.5.2: inside a declaration's renders / initializers, its fields are
        // bare read-only projections of the current instance.
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given) {
            if (!d.isProgram) {
                const i: int = fieldIndex(d.info, name)
                if (i >= 0) return plain(d.info.fields[i].ty, addName(st, e.nid, NameFact.NField(d.info.sym, InstRef.Lexical(0), i)))
            }
        }
        // s472: a file-scope constant (§7.6) — after the locals, which shadow it
        const kc: ConstInfo | not = constNamed(env.g, env.file, name)
        if (kc is given) {
            if (!kc.ready) return diagX(env, e, "E-SCOPE-001", "`" + name + "` is read before it is initialized — a file-scope constant's initializer reads only the constants initialized before it (declared earlier in this file, or in a file this one imports)", st)
            return plain(kc.ty, addName(st, e.nid, NameFact.NConst(kc.sym)))
        }
        const f: FnInfo | not = fnNamed(env.g, env.file, name)
        if (f is given) {
            const st2: AS = addName(st, e.nid, NameFact.NFn(f.sym))
            if (env.fx.fnRef == e.nid) return plain(not, st2)
            // s451 (Ue, review HIGH-2): a function named without being called —
            // an alias, a returned / passed / stored function. Core has no
            // function value (only a Lambda as a SeqCall argument), so it was
            // lowered as `null`. A `!` function there is a call left unhandled
            // (§19.4.3 / §19.4.4: an unhandled `!` call SHALL be E-ERROR-002);
            // any other function value is refused.
            if (f.failable) return plain(not, addDiag(st2, env.file, e.span, "E-ERROR-002", "the failable function '" + f.name + "' is used as a value — whatever calls it later would discard its error. Call it here and handle the result (`" + f.name + "(…) !{ … }`, `match`, `?`) (§19.4.3)"))
            return plain(not, addDiag(st2, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + name + "` names a function without calling it (an alias, a returned, passed or stored function) — function values arrive with a later \"function values\" slice; call it directly: `" + name + "(…)`"))
        }
        const pi: DeclInfo | not = programInfo(env)
        if (pi is given) {
            if (fieldIndex(pi, name) >= 0) {
                return diagX(env, e, "E-SCOPE-001", "`" + name + "` is a cell — read it as `@" + name + "` (V5-strict: bare names are locals)", st)
            }
        }
        // s471: a name a refused import brings is that import's failure (checkImports), not also undeclared
        if (importRefusesName(env.g, env.file, name)) return plain(not, st)
        return diagX(env, e, "E-SCOPE-001", "`" + name + "` is not declared" + valueElsewhere(env.g.te.link, env.file, name), st)
    }

    // s472 — where a VALUE name (a function, or a file-scope constant) is declared, when not here.
    fn valueElsewhere(lk: Linkage, file: string, name: string) -> string {
        const n: string = elsewhereNote(lk, file, NameKind.KFn, false, name)
        if (n != "") return n
        return elsewhereNote(lk, file, NameKind.KConst, false, name)
    }

    // s472 (boot-math-port) — a use of the `import:host` binding `name` (§21.3.1,
    // the S472 wrapper rule; hostWrappers). The callee of an admitted wrapper's
    // `return` IS the host call: it names the wrapper itself (the wrapper's
    // signature is the host function's type, so the call is typed, checked and
    // placed as a call of the wrapper; lower replaces the wrapper's body by the
    // host reference, core.scrml HostFn). Any other use — a bare reference, a
    // call anywhere else, a call that does not pass the wrapper's parameters —
    // is E-HOST-BINDING-USE. A declaration analyze refuses (checkHostImport)
    // owns its failure: its names do not also report here.
    fn resolveHostBinding(env: Env, e: AExpr, name: string, hb: AImport, st: AS) -> RX {
        if (!hostImportAdmitted(env.file, hb)) return plain(not, st)
        const site: HostSite | not = hostSiteAt(env.g, e.nid)
        if (site is given) {
            if (site.ok && env.fx.fnRef == e.nid) return plain(not, addName(st, e.nid, NameFact.NFn(site.wrapper)))
            if (!site.ok && site.why == "") return plain(not, st)
            if (!site.ok) return diagX(env, e, "E-HOST-BINDING-USE", hostUseText(name) + " Here " + site.why + ".", st)
        }
        return diagX(env, e, "E-HOST-BINDING-USE", hostUseText(name), st)
    }

    fn hostUseText(name: string) -> string {
        return "`" + name + "` is an `import:host` binding — it is usable ONLY as the direct callee of the `return` that is the whole body of a fully typed function, passing that function's parameters in order: `fn f(x: number) -> int { return " + name + "(x); }` (§21.3.1). Call the wrapper instead."
    }

    // A READ through `@h`. RULED S437 (bryan: "yes, reads require narrowing"):
    // reading through a conditionally-mounted handle (`T | not`, §66.7.5)
    // outside a narrowing is an error, as a write already is. Same code as the
    // write (§66.20 E-DECL-HANDLE-NOT-NARROWED names only writes today; the
    // ruling widens its condition to reads — slice-m2/progress.md).
    fn resolveAtRead(env: Env, e: AExpr, name: string, st: AS) -> RX {
        const r: RX = resolveAt(env, e, name, st)
        if (!r.x.maybe) return r
        let tn: string = "T"
        const td: Sym | not = r.x.iDecl
        if (td is given) tn = td.hint
        const msg: string = "`@" + name + "` names a conditionally-mounted instance (typed `" + tn + " | not`) — a read through it must be narrowed first: `given c = @" + name + " :> { … c.field … }` (§66.7.5; reads ruled S437)"
        return { x: r.x, st: addDiag(r.st, env.file, e.span, "E-DECL-HANDLE-NOT-NARROWED", msg) }
    }

    // A handle as the SUBJECT of a narrowing or a write: no read check (the
    // `given` narrows it; a write has its own guard, writeGuards).
    fn resolveHandleSubject(env: Env, e: AExpr, st: AS) -> RX {
        const n: string = atName(e)
        if (n != "") return resolveAt(env, e, n, st)
        return resolveExpr(env, e, not, st)
    }

    fn atName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> n
            .Name(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // s473 (§47.1.1): a REFERENCE to a reserved-prefix name is refused too
    // (S440 #9, S457 — reservedName); then resolved as any name is.
    fn resolveAt(env: Env, e: AExpr, name: string, st: AS) -> RX {
        return resolveAtOf(env, e, name, reservedName(st, env.file, e.span, name))
    }

    fn resolveAtOf(env: Env, e: AExpr, name: string, st: AS) -> RX {
        // §66.7.5: inside `given c = @name :> { … }`, `@name` is the narrowed `c`.
        const nb: NarrowB | not = lookupNarrow(env, name)
        if (nb is given) {
            return { x: { ty: nb.ty, inst: nb.inst, iDecl: nb.iDecl, maybe: false },
                     st: addName(st, e.nid, NameFact.NInst(nb.iDecl, nb.inst)) }
        }
        // s444 — O54 (a) for a CHILD field's own renders: `@f` is this instance's `f`.
        const oi: int = ownFieldIndex(env, name)
        if (oi >= 0) {
            const od: DeclSrc | not = ctxDecl(env)
            if (od is given) return plain(od.info.fields[oi].ty, addName(st, e.nid, NameFact.NField(od.info.sym, InstRef.Lexical(0), oi)))
        }
        // O54 (a): inside x's own renders / initializers, `@x` is the current instance.
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given) {
            if (!d.isProgram && d.info.sym.hint == name) {
                const inst: InstRef = InstRef.Lexical(0)
                return { x: { ty: Type.Named(d.info.sym), inst: inst, iDecl: d.info.sym, maybe: false },
                         st: addName(st, e.nid, NameFact.NInst(d.info.sym, inst)) }
            }
        }
        // A handle in scope first: a row-scoped (§66.7.4) or declaration-scoped
        // handle shadows a program-scope name; a program-scope handle cannot
        // share a program cell's name (the scope pass refuses that).
        const h: HandleInfo | not = lookupHandle(env, name)
        if (h is given) {
            const hi: InstRef = InstRef.Alias(h.sym)
            // a presence test in scope proves it mounted (ruled S442)
            const maybe: boolean = h.conditional && env.present.indexOf(name) < 0
            return { x: { ty: Type.Named(h.target), inst: hi, iDecl: h.target, maybe: maybe },
                     st: addName(st, e.nid, NameFact.NInst(h.target, hi)) }
        }
        const pi: DeclInfo | not = programInfo(env)
        if (pi is given) {
            const i: int = fieldIndex(pi, name)
            if (i >= 0) return plain(pi.fields[i].ty, addName(st, e.nid, NameFact.NField(pi.sym, programInst(env), i)))
        }
        const ud: DeclSrc | not = visibleDecl(env, name)
        if (ud is given) {
            const si: InstRef = InstRef.Shared(ud.info.sym)
            return { x: { ty: Type.Named(ud.info.sym), inst: si, iDecl: ud.info.sym, maybe: false },
                     st: addName(st, e.nid, NameFact.NInst(ud.info.sym, si)) }
        }
        // s473 D29 — the read side of §6.1.1 is E-STATE-UNDECLARED (the more specific code; §34 row
        // "Read-side fire"), as the write side is (placeName). Was E-SCOPE-001
        // (g-bootstrap-undeclared-cell-read-code-s473).
        return diagX(env, e, "E-STATE-UNDECLARED", "`@" + name + "` is read here, but it names no cell, declaration or `as=` handle in scope (§6.1.1: declare it, e.g. `let <" + name + ":T=(…)/>`)", st)
    }

    fn resolveAtItem(env: Env, e: AExpr, st: AS) -> RX {
        if (env.rows.length == 0) return diagX(env, e, "E-SYNTAX-064", "`@.` outside an `<each>` body (§17.7.3)", st)
        const row: RowB = env.rows[env.rows.length - 1]
        return plain(row.ty, addName(st, e.nid, NameFact.NLocal(row.bind)))
    }

    // A bare variant resolves against the type its position expects; with no
    // expectation, against the one enum that has it.
    fn resolveVariant(env: Env, e: AExpr, name: string, expected: Type | not, st: AS) -> RX {
        // s472 r1 F5: a `T | not` position expects `T` (§14.10: the position's type)
        const want: Type | not = unMaybeOpt(expected)
        if (want is given) {
            const es: Sym | not = isEnumType(env.g.types, want)
            if (es is given) {
                const i: int = variantIndex(env.g.types, es, name)
                if (i >= 0) return unitVariantValue(env, e, es, i, "." + name, Type.Named(es), st)
                return diagX(env, e, "E-TYPE-VARIANT", "`." + name + "` is not a variant of `" + es.hint + "`", st)
            }
        }
        let found: Sym[] = []
        let idx: int = -1
        for (const t of env.g.types) {
            // s451 (Ue): a built-in error enum's variant resolves only where its type is expected
            // s472: and only an enum IN SCOPE in this file (declared here, or imported) is searched
            const s: Sym = typeDefSym(t.def)
            const i: int = variantIndex(env.g.types, s, name)
            if (i >= 0 && t.file != builtinFile() && typeInScope(env, t)) {
                found = found.concat([s])
                idx = i
            }
        }
        if (found.length == 1) return unitVariantValue(env, e, found[0], idx, "." + name, Type.Named(found[0]), st)
        if (found.length == 0) return diagX(env, e, "E-TYPE-VARIANT", "`." + name + "` is not a variant of any enum in scope", st)
        return diagX(env, e, "E-VARIANT-AMBIGUOUS", "`." + name + "` is a variant of more than one enum — qualify it", st)
    }

    fn unMaybeOpt(t: Type | not) -> Type | not {
        if (t is not) return not
        const i: Type | not = maybeInner(t)
        if (i is given) return i
        return t
    }

    // s472 r1 F3 — a variant named as a VALUE without parentheses. A unit variant is
    // its value (§14.5). A PAYLOAD variant named without its payload is not a value:
    // §45.7 (W-EQ-PAYLOAD-VARIANT) reads `Enum.PayloadVariant` with no payload argument
    // as "the ctor function, not a value", and the bootstrap has no function values —
    // refused, fail closed, bare and qualified alike (was: the bare spelling lowered
    // to a unit-shaped `Lit(Variant)` of a payload variant, which no arm matches).
    fn unitVariantValue(env: Env, e: AExpr, es: Sym, i: int, written: string, ty: Type, st: AS) -> RX {
        const vs: VariantDef[] = enumVariantsOf(env.g, es)
        if (vs[i].fields.length > 0) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", payloadNoArgsMsg(es.hint, vs[i].sym.hint, written, vs[i].fields.length), st)
        return plain(ty, addValue(st, e.nid, ValueFact.VVariant(es, i)))
    }

    fn payloadNoArgsMsg(en: string, vn: string, written: string, n: int) -> string {
        return "`" + written + "` — `" + en + "." + vn + "` carries a payload (" + n + " field(s)); named without one it is the constructor, not a value (§45.7: \"the ctor function, not a value\"), and a constructor as a function value is not in the bootstrap — construct the value: `" + written + "(…)`, one argument per declared field (§14.4)"
    }

    fn isLengthOf(t: Type | not) -> boolean {
        if (t is not) return false
        if (seqElem(t) is given) return true
        return t == Type.Str
    }

    fn resolveMember(env: Env, e: AExpr, obj: AExpr, name: string, st0: AS) -> RX {
        // s473 — §5.2 "Executable sinks in plain logic (S473)" (the #1663 review F3):
        // `window.eval` / `x.Function` / `f.constructor` read as a VALUE
        if (logicCallSink(name) == "exec") return diagX(env, e, "E-LOGIC-EXECUTABLE-SINK", sinkMessage("refers to `." + name + "` as a value — a function that runs source text as JavaScript, refused wherever it is called"), st0)
        // s469 — a QUALIFIED unit variant `E.V` (§14.4, §18.13: "always valid"):
        // `E` is a type name (no local shadows it), not a value — never resolved
        // as one. A payload variant is construction, which Core has no value for.
        const qv: RX | not = qualVariantValue(env, e, obj, name, st0)
        if (qv is given) return qv
        const ro: RX = resolveExpr(env, obj, not, st0)
        const st: AS = ro.st
        // s469: a field of an index read (`xs[i].f`) — Core reads a field through a
        // place (a cell or a local), and an index read is a value: refused, never
        // lowered to a placeholder.
        if (isIndexExpr(obj) && name != "length") return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "a field of an index read (`xs[i]." + name + "`) is not in the bootstrap yet — bind the element first: `const x = xs[i]`, then `x." + name + "`", st)
        // `.length` of a sequence or a string is a primitive (a read, never a place).
        if (name == "length" && ro.x.inst is not && isLengthOf(ro.x.ty)) {
            // s469 (bryan: "code points everywhere, `.length` included"): a
            // STRING's length counts code points — Core StrLength, recorded as
            // the member node's value fact (lower reads it first); a tape's
            // stays Length (its element count)
            const lst: AS = addName(st, e.nid, NameFact.NLength)
            if (ro.x.ty == Type.Str) return plain(Type.Int, addValue(lst, e.nid, ValueFact.VMethod(PrimOp.StrLength)))
            return plain(Type.Int, lst)
        }
        const inst: InstRef | not = ro.x.inst
        const iDecl: Sym | not = ro.x.iDecl
        if (inst is given && iDecl is given) {
            const d: DeclSrc | not = findDeclSrc(env.g, iDecl)
            if (d is not) return diagX(env, e, "E-SCOPE-001", "unknown declaration", st)
            const i: int = fieldIndex(d.info, name)
            // s449 — the compound surface (§55.5): every user declaration has one (Edge B)
            if (i < 0 && isSurfaceProp(name) && !d.isProgram) return compoundSurface(env, e, iDecl, inst, name, st)
            if (i < 0) return diagX(env, e, "E-SCOPE-001", "`<" + d.info.sym.hint + ">` has no field `" + name + "`", st)
            return { x: { ty: d.info.fields[i].ty, inst: not, iDecl: not, maybe: ro.x.maybe },
                     st: addName(st, e.nid, NameFact.NField(iDecl, inst, i)) }
        }
        // s449 — the validity surface of a FIELD read (`@email.isValid`,
        // `@signup.email.touched`): a top-level value has one when it carries
        // validators (§55.5.1 rules 1-2), a user declaration's field always
        // (§55.6, Edge B).
        if (isSurfaceProp(name)) {
            const nf: NameFact | not = nameFactIn(st, obj.nid)
            const where: int = fieldReadKind(env, nf)
            if (where == 2 || where == 1) return fieldSurface(env, e, obj, nf, name, where, st)
        }
        const t: Type | not = ro.x.ty
        if (t is given) {
            const s: Sym | not = namedOf(t)
            if (s is given) {
                const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
                if (ti is given) {
                    const fs: FieldDef[] | not = structFieldDefs(ti.def)
                    if (fs is given) {
                        let i = 0
                        for (const fd of fs) {
                            if (fd.sym.hint == name) return plain(fd.ty, addName(st, e.nid, NameFact.NStruct(s, i)))
                            i = i + 1
                        }
                        return diagX(env, e, "E-SCOPE-001", shownStruct(env, s) + " has no field `" + name + "`", st)
                    }
                }
            }
        }
        // s473 (§21.3.3 rule 15): a declared `:host` handle is closed
        if (t is given) {
            // s473-host-allowlist-b (rule 16 as amended): a DOM element type's members stay OPEN
            // in logic — E-HOST-HANDLE-MEMBER never applies; open untyped DOM access is not built
            if (isDomElementIface(hostSlotText(env.g.types, unMaybe(t)))) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "member access `." + name + "` on the DOM element type `" + typeName(unMaybe(t)) + "` — DOM members stay open in logic (§21.3.3 rule 16, S473 round 2 item 7), but open, untyped DOM member access is not in the bootstrap; declare a `<host>` binding for it", st)
            if (isHostType(env.g.types, unMaybe(t))) return diagX(env, e, "E-HOST-HANDLE-MEMBER", "member access " + hostMemberText(typeName(unMaybe(t)), name), st)
        }
        return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "member access `." + name + "` on a value that is not a struct or an instance is not in bootstrap slice M2", st)
    }

    // s444 Phase B — the synthesized validity-surface properties (§55.5–§55.7).
    fn isSurfaceProp(n: string) -> boolean {
        return n == "isValid" || n == "errors" || n == "touched" || n == "submitted"
    }

    fn surfaceDeferred(what: string, sec: string) -> string {
        return "`" + what + "` reads the synthesized validity surface (" + sec + "), which is not in the bootstrap yet"
    }

    fn surfaceProp(n: string) -> SurfaceProp {
        if (n == "isValid") return SurfaceProp.IsValid
        if (n == "errors") return SurfaceProp.Errors
        if (n == "touched") return SurfaceProp.Touched
        return SurfaceProp.Submitted
    }

    // `errors` read as a VALUE: §55.9 makes it an array of ValidationError
    // tags (a map of them on a compound), and the bootstrap has no
    // ValidationError type for the typer to give it — refused, never read as
    // an untyped value. `<errors of=…/>` renders it (§55.8).
    fn errorsAsValue(what: string) -> string {
        return "`" + what + ".errors` read as a value — the ValidationError array (§55.9) has no type in the bootstrap yet; render it with `<errors of=" + what + "/>` (§55.8), or test `" + what + ".isValid`"
    }

    // s449 — `@signup.isValid` / `.submitted` (§55.5): the compound of a user
    // declaration's instance. Its `touched` / `errors` are per-field maps
    // (§55.5) the bootstrap has no type for — refused (read them per field).
    fn compoundSurface(env: Env, e: AExpr, d: Sym, inst: InstRef, name: string, st: AS) -> RX {
        const what: string = "@" + d.hint
        if (name == "errors") return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", errorsAsValue(what), st)
        if (name == "touched") return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`" + what + ".touched` is a map of per-field flags (§55.5) — a map value has no type in the bootstrap yet; read one field's: `" + what + ".<field>.touched` (§55.6)", st)
        return plain(Type.Bool, addName(st, e.nid, NameFact.NSurface(ValidityOf.OfDecl(d, inst), surfaceProp(name))))
    }

    // s449 — a field's surface (§55.5.1 / §55.6). `where`: 2 a top-level
    // value, 1 a user declaration's field (fieldReadKind).
    fn fieldSurface(env: Env, e: AExpr, obj: AExpr, nf: NameFact | not, name: string, where: int, st: AS) -> RX {
        const v: ValidityOf | not = fieldValidity(nf)
        if (v is not) return diagX(env, e, "E-SCOPE-001", "`." + name + "` — `" + exprLabel(obj) + "` is not a field", st)
        const what: string = exprLabel(obj)
        // its validators were written but refused (already reported): no second, false diagnostic
        if (where == 2 && fieldValidatorsRefused(env, v)) return plain(not, st)
        if (where == 2 && !fieldCarriesValidators(env, v)) {
            return diagX(env, e, "E-VALIDITY-NO-SURFACE", "`." + name + "` — `" + what + "` is a top-level value that carries no validators, so it has no validity surface (§55.5.1 rule 2: only a value that carries validators gets one); add a validator to its declaration, or drop the read", st)
        }
        if (name == "errors") return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", errorsAsValue(what), st)
        if (where == 1 && name == "submitted") {
            return diagX(env, e, "E-SCOPE-001", "`" + what + ".submitted` — a field of a declaration has no `submitted` of its own (§55.6); its compound has it: `@" + validityDecl(v).hint + ".submitted` (§55.5)", st)
        }
        return plain(Type.Bool, addName(st, e.nid, NameFact.NSurface(v, surfaceProp(name))))
    }

    fn fieldValidity(nf: NameFact | not) -> ValidityOf | not {
        return match nf {
            .NField(decl: d, inst: i, idx: x) :> ValidityOf.OfField(d, i, x)
            .NLocal(sym: s) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            .NConst(sym: s) :> not
            not :> not
        }
    }

    fn fieldCarriesValidators(env: Env, v: ValidityOf) -> boolean {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> declFieldValidated(env, d, x)
            .OfDecl(decl: d) :> false
        }
    }

    // A value whose source wrote validators that were all refused (each
    // reported where written): it has no admitted validator, but the author
    // did write some — a surface read of it is not E-VALIDITY-NO-SURFACE.
    fn fieldValidatorsRefused(env: Env, v: ValidityOf) -> boolean {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> declFieldRefused(env, d, x)
            .OfDecl(decl: d) :> false
        }
    }

    fn declFieldRefused(env: Env, d: Sym, idx: int) -> boolean {
        const ds: DeclSrc | not = findDeclSrc(env.g, d)
        if (ds is not) return false
        if (idx < 0 || idx >= ds.info.fields.length) return false
        const f: FieldInfo = ds.info.fields[idx]
        return f.vals.length == 0 && f.valsWritten > 0
    }

    fn declFieldValidated(env: Env, d: Sym, idx: int) -> boolean {
        const ds: DeclSrc | not = findDeclSrc(env.g, d)
        if (ds is not) return false
        if (idx < 0 || idx >= ds.info.fields.length) return false
        return ds.info.fields[idx].vals.length > 0
    }

    fn exprLabel(e: AExpr) -> string {
        const k: string = placeKey(e)
        if (k == "") return "this value"
        return k
    }

    // The fact recorded so far for node `nid` (the binder's names list, unindexed).
    fn nameFactIn(st: AS, nid: int) -> NameFact | not {
        const i: int = st.facts.names.nids.indexOf(nid)
        if (i < 0) return not
        return st.facts.names.facts[i]
    }

    // 2 = a read of a program cell (top level), 1 = a read of a user
    // declaration's field, 0 = anything else.
    fn fieldReadKind(env: Env, f: NameFact | not) -> int {
        return match f {
            .NField(decl: d) :> declKindOf(env, d)
            .NLocal(sym: s) :> 0
            .NInst(decl: d) :> 0
            .NStruct(owner: o) :> 0
            .NFn(sym: s) :> 0
            .NLength :> 0
            .NSurface(of: x) :> 0
            .NConst(sym: s) :> 0
            not :> 0
        }
    }

    fn declKindOf(env: Env, d: Sym) -> int {
        if (d.id == env.g.program.id) return 2
        return 1
    }

    // =========================================================================
    // s472 — PAYLOAD-VARIANT CONSTRUCTION (g-boot-payload-variant-value-s472).
    // SPEC §14.4 "Construction arity": "Constructing a payload variant
    // (`Shape.Rectangle(w, h)`, `.Circle(r)`) supplies exactly one positional
    // argument per declared field, in declaration order … A construction whose
    // argument count does not match the variant's declared payload field count —
    // too few, too many, or any payload on a unit variant (`Shape.Point(x)`) — is a
    // hard error (E-TYPE-082) … The check lives at the variant-constructor site and
    // applies uniformly across every construction locus — `let` / `const` /
    // state-cell initializers, `return`, and `fail`."
    // §14.10: "An enum-payload-variant CONSTRUCTOR argument is such a position" (a
    // bare variant argument resolves against the PAYLOAD field's type); "The
    // constructor callee may be bare (`.OnePlayer(...)`, resolved against the
    // surrounding-declaration enum) or qualified (`Mode.OnePlayer(...)` …, resolved
    // directly)". §66.3 rule 5 (via §14.10): "`E.V(…)` is a call whose declared type
    // is `E`".
    // The callee is decided from the AST alone: `E.V(…)` where `E` names an enum
    // type here (no local shadows it), or a bare `.V(…)`. Anything else is not a
    // construction (`not`) and goes on to resolveCall unchanged. The value is
    // recorded as VConstruct on the CALL node; each argument is resolved against
    // its field's type (the bare-variant position above) and TYPED against it by
    // typeCall (E-TYPE-031, as a `fail`'s payload is — typeFail).
    // =========================================================================
    fn resolveCallOrConstruct(env: Env, e: AExpr, callee: AExpr, args: AExpr[], expected: Type | not, st0: AS) -> RX {
        // s473 — §5.2 "Executable sinks in plain logic (S473)": judged first
        const sinkC: string = sinkCallWhy(env, callee, args)
        if (sinkC != "") return diagX(env, e, "E-LOGIC-EXECUTABLE-SINK", sinkMessage(sinkC), st0)
        const rc: RX | not = resolveConstruct(env, e, callee, args, expected, st0)
        if (rc is given) return rc
        return resolveCall(env, e, callee, args, st0)
    }

    fn bareVariantName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Variant(name: n) :> n
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // The enum a construction's callee names, or not when the callee is not a
    // variant constructor at all. `written` is the callee as the author wrote it.
    type CtorOf:struct = { es: Sym | not, name: string, written: string, err: string, code: string }

    fn ctorOf(env: Env, callee: AExpr, expected: Type | not) -> CtorOf | not {
        const m: MethodCall | not = memberCall(callee)
        if (m is given) {
            const n: string = exprName(m.obj)
            if (n == "" || atName(m.obj) != "") return not
            // r1 F7: `E.V(…)` where `E` is not in scope here — say why, as #1606's
            // E-SCOPE-001 does (declared in another file, not exported / not imported)
            const nt: Sym | not = typeNamedHere(env, n)
            if (lookupLocal(env, n) is given) {
                if (nt is given && startsUpper(m.method)) {
                    if (isEnumType(env.g.types, Type.Named(nt)) is given) return { es: not, name: m.method, written: n + "." + m.method, err: "`" + n + "." + m.method + "(…)` — `" + n + "` here is a local, which shadows the enum `" + n + "`; rename the local to construct the variant", code: "E-BOOTSTRAP-UNSUPPORTED" }
                }
                return not
            }
            if (nt is not && startsUpper(n) && startsUpper(m.method)) {
                const why: string = elsewhereNote(env.g.te.link, env.file, NameKind.KType, false, n)
                if (why != "") return { es: not, name: m.method, written: n + "." + m.method, err: "`" + n + "` is not declared" + why, code: "E-SCOPE-001" }
            }
            const ts: Sym | not = nt
            if (ts is not) return not
            const qs: Sym | not = isEnumType(env.g.types, Type.Named(ts))
            if (qs is not) return not
            // `E.parse(s)` / `E.toEnum(s)` are the enum's built-ins (§14.13.4, §14.4.1), not
            // variants: a variant name begins with an uppercase letter (§14.4,
            // E-ENUM-VARIANT-CASE), so only such a name is a constructor — one the enum
            // does not declare is an unknown variant (ctor resolution reports it)
            if (variantIndex(env.g.types, qs, m.method) < 0 && !startsUpper(m.method)) return not
            return { es: qs, name: m.method, written: n + "." + m.method, err: "", code: "" }
        }
        const b: string = bareVariantName(callee)
        if (b == "") return not
        // r2 (claim gate): a lowercase bare callee is no variant name (§14.4,
        // E-ENUM-VARIANT-CASE) — e.g. the `.send(…)` a recovered `<#w>.send(…)` leaves.
        // Not a construction: resolveCall refuses it as it did before (no cascade)
        if (!startsUpper(b)) return not
        const w: string = "." + b
        // the bare form: against the enum its position expects (§14.10) — as a
        // bare unit variant resolves (resolveVariant), one rule for both
        const want: Type | not = unMaybeOpt(expected)   // r1 F5: a `T | not` position expects `T`
        if (want is given) {
            const xs: Sym | not = isEnumType(env.g.types, want)
            if (xs is given) {
                if (variantIndex(env.g.types, xs, b) >= 0) return { es: xs, name: b, written: w, err: "", code: "" }
                return { es: not, name: b, written: w, err: "`" + w + "(…)` — `" + b + "` is not a variant of `" + xs.hint + "`", code: "E-TYPE-VARIANT" }
            }
        }
        let found: Sym[] = []
        for (const t of env.g.types) {
            const s: Sym = typeDefSym(t.def)
            if (variantIndex(env.g.types, s, b) >= 0 && t.file != builtinFile() && typeInScope(env, t)) found = found.concat([s])
        }
        if (found.length == 1) return { es: found[0], name: b, written: w, err: "", code: "" }
        if (found.length == 0) return { es: not, name: b, written: w, err: "`" + w + "(…)` — `" + b + "` is not a variant of any enum in scope", code: "E-TYPE-VARIANT" }
        return { es: not, name: b, written: w, err: "`" + w + "(…)` — `" + b + "` is a variant of more than one enum — qualify it", code: "E-VARIANT-AMBIGUOUS" }
    }

    fn startsUpper(n: string) -> boolean {
        if (n.length == 0) return false
        const c: string = n.charAt(0)
        return c >= "A" && c <= "Z"
    }

    // r2: on an arity refusal, each argument that HAS a declared field is still resolved
    // against it (its own errors are real); a surplus one is not (nothing to resolve it
    // against, and an object literal there would only cascade)
    fn resolveCtorArgs(env: Env, args: AExpr[], fs: FieldDef[], st0: AS) -> AS {
        let st: AS = st0
        let i = 0
        for (const a of args) {
            if (i < fs.length) st = resolveExpr(env, a, fs[i].ty, st).st
            i = i + 1
        }
        return st
    }

    fn resolveConstruct(env: Env, e: AExpr, callee: AExpr, args: AExpr[], expected: Type | not, st0: AS) -> RX | not {
        const c: CtorOf | not = ctorOf(env, callee, expected)
        if (c is not) return not
        const es: Sym | not = c.es
        // r2: a refused construction does not resolve its arguments (no field type to
        // resolve them against — an object literal there would cascade as
        // E-TYPE-STRUCT-CONTEXT), as resolveCall's refusals do not
        if (es is not) return diagX(env, e, c.code, c.err, st0)
        const idx: int = variantIndex(env.g.types, es, c.name)
        if (idx < 0) return diagX(env, e, "E-TYPE-VARIANT", "`" + c.written + "(…)` — `" + c.name + "` is not a variant of `" + es.hint + "`", st0)
        const fs: FieldDef[] = enumVariantsOf(env.g, es)[idx].fields
        if (fs.length == 0 && args.length > 0) return diagX(env, e, "E-TYPE-082", "`" + es.hint + "." + c.name + "` is a unit variant — it carries no payload, and this construction supplies " + args.length + " — write `" + es.hint + "." + c.name + "` (§14.4 construction arity)", st0)
        // `E.V()` on a unit variant: no payload, but not the unit value's spelling
        // either (§14.5 writes it `E.V`); the SPEC does not say what `()` adds —
        // refused, fail closed, rather than read as the unit value
        if (fs.length == 0) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`" + c.written + "()` — `" + c.name + "` is a unit variant; its value is written without parentheses: `" + c.written + "` (§14.5)", st0)
        if (fs.length != args.length) return diagX(env, e, "E-TYPE-082", "`" + es.hint + "." + c.name + "` carries " + fs.length + " payload value(s) but this construction supplies " + args.length + " — one argument per declared field, in order (§14.4)", resolveCtorArgs(env, args, fs, st0))
        let st: AS = st0
        let i = 0
        for (const a of args) {
            st = resolveExpr(env, a, fs[i].ty, st).st
            i = i + 1
        }
        return plain(Type.Named(es), addValue(st, e.nid, ValueFact.VConstruct(es, idx)))
    }

    fn resolveCall(env: Env, e: AExpr, callee: AExpr, args: AExpr[], st0: AS) -> RX {
        const n: string = exprName(callee)
        if (n == "reset") return diagX(env, e, "E-RESET-POSITION", "`reset(@x)` is a statement (a write), not a value", st0)
        if (n == "") {
            const m: MethodCall | not = memberCall(callee)
            if (m is given) {
                // s473 (§21.3.3 rule 15): a method call on a declared `:host` handle is
                // E-HOST-HANDLE-MEMBER (the receiver is peeked: its resolution is redone below)
                const hro: RX = resolveExpr(env, m.obj, not, st0)
                const hot: Type | not = hro.x.ty
                if (hot is given) {
                    if (isDomElementIface(hostSlotText(env.g.types, unMaybe(hot)))) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "the method call `." + m.method + "(…)` on the DOM element type `" + typeName(unMaybe(hot)) + "` — DOM members stay open in logic (§21.3.3 rule 16, S473 round 2 item 7), but open, untyped DOM member access is not in the bootstrap; declare a `<host>` binding for it", hro.st)
                    if (isHostType(env.g.types, unMaybe(hot))) return diagX(env, e, "E-HOST-HANDLE-MEMBER", "the method call " + hostMemberText(typeName(unMaybe(hot)), m.method), hro.st)
                }
                // s444: the host-call surface (one call — the clock read) and the
                // sequence functions a lambda is admitted to (filter / map)
                if (m.method == "now" && exprName(m.obj) == "Date" && lookupLocal(env, "Date") is not) return resolveHost(env, e, args, st0)
                if (m.method == "filter" || m.method == "map") return resolveSeqCall(env, e, m, args, st0)
                // s469 — `xs.sort((a, b) => …)`: a comparator (a SeqCall, like filter / map)
                if (m.method == "sort" && args.length == 1) return resolveSortBy(env, e, m, args, st0)
                // s469 — `xs.at(i)` (§49.13): `T | not`, never a trap
                if (m.method == "at") {
                    const ra: RX | not = resolveAtCall(env, e, m, args, st0)
                    if (ra is given) return ra
                }
                // s469 — a primitive type name is a namespace for `.parse` only (§14.13.4)
                const pn: string = primNamespace(env, m.obj)
                if (pn != "") return resolvePrimParse(env, e, pn, m, args, st0)
                // s469 — `E.parse(s)` (§14.13.4) and `E.toEnum(s)` (§14.4.1, folding into
                // `E.parse` — the same path): a typed built-in, `string -> E | not`
                if (m.method == "parse" || m.method == "toEnum") {
                    const te: RX | not = resolveToEnum(env, e, m, args, st0)
                    if (te is given) return te
                }
                // s469 — the typed built-in methods of a string and a tape, and
                // JavaScript's tape method names, refused (E-TAPE-JS-METHOD)
                if (isBuiltinMethodName(m.method)) return resolveMethod(env, e, m, args, st0)
                // s469 — any other method on a `string` is E-STRING-METHOD-UNKNOWN (D.1:
                // "The table is the whole string surface")
                const su: RX | not = unknownStrMethod(env, e, m, args, st0)
                if (su is given) return su
            }
            return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", callText(env, callee) + "only calls of a named function, " + dateNowText() + ", `.filter(x => …)` / `.map(x => …)` / `.sort(…)` / `.reverse()` / `.join(sep)` on a tape, and the string methods " + strMethodList() + " are in the bootstrap", st0)
        }
        const rc: RX = resolveExpr(withFnRef(env, callee.nid), callee, not, st0)
        const st: AS = resolveExprs(env, args, not, rc.st)
        const cf: FnInfo | not = calledFn(env, nameFactIn(st, callee.nid))
        if (cf is given) {
            const sp: AS = callPurity(env, e, cf, st)
            // s451 (Ue): a `!` function's call is handled only as a handling form's subject (§19.4.3)
            if (cf.failable && env.fx.subject != e.nid) return plain(not, bySite(env, siteOf(env), conflictDiags(env, cf, e), [], unhandledCall(env, e, cf.name, sp)))
            // s454 (U1b): a server function's call made on the client is failable (§19.9.10)
            if (cf.serverOwn && env.fx.subject != e.nid) return plain(not, remoteUnhandled(env, e, cf, sp))
            // s469 (#1471 r3): a call of a VOID function has type `void` (voidFns) — refused in
            // every value position (§18.3, E-TYPE-001). Not a value position: a statement call
            // (and an arm's value, whose E-ERROR-012 is reported by the arm rule), or the
            // operand of a `return` in a function that is itself void (it passes `void` on).
            if (isVoidFn(env.g, cf.sym.id) && env.fx.stmtCall != e.nid && env.fx.subject != e.nid) return plain(not, addDiag(sp, env.file, e.span, "E-TYPE-001", "`" + cf.name + "(…)` is `void` (no path of it returns a value) — it cannot be used as a value (§18.3); call it as a statement, or make it `return` a value on every path"))
            return plain(not, sp)
        }
        // s469 (templates review round 2 — found by the end-to-end fuzz): a call
        // whose callee is NOT a declared function — a local, a parameter, a field,
        // an instance — was accepted silently and lowered to `not` (`total()` on a
        // `number` parameter printed `null`). Refused by name, fail closed. An
        // undeclared callee already carries its own report (E-SCOPE-001).
        // r3 F2: never piled onto a parse error. The refusal exists to stop a SILENT
        // miscompile; a file with a parse error does not compile at all, and a recovered
        // parse can produce such a call next to (not inside) the error — so it is judged
        // only in a file the parser read cleanly (the parse-reject stays the report)
        if (nameFactIn(st, callee.nid) is given && envParseErrs(env).length == 0) {
            return plain(not, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", callText(env, callee) + "only a declared scrml function is callable in the bootstrap — `" + exprName(callee) + "` names a value (a local, a parameter, a field), and calling a function VALUE is not in the bootstrap"))
        }
        return plain(not, st)
    }

    fn calledFn(env: Env, f: NameFact | not) -> FnInfo | not {
        return match f {
            .NFn(sym: s) :> fnOfSym(env.g, s)
            .NField(decl: d) :> not
            .NLocal(sym: s) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            .NConst(sym: s) :> not
            not :> not
        }
    }

    fn fnOfSym(g: Globals, s: Sym) -> FnInfo | not {
        for (const f of g.fns) {
            if (f.info.sym.id == s.id) return f.info
        }
        return not
    }

    // r2 F4 — a call is judged by where it stands, like `Date.now()` itself:
    //  - in a pure `fn` body, a call of a `function` is E-FN-003 — §48.6.2 "A
    //    `fn` body SHALL NOT call a `function`-declared callable (§7.3), because
    //    `function` declarations carry no purity guarantees … Calling a
    //    `function` from inside `fn` is E-FN-003". With it, a `fn` reaches the
    //    clock only by calling it itself (E-FN-004, resolveHost) — §48.6.1's
    //    "transitivity of `fn` constraints" holds by construction.
    //  - where the clock is not in the bootstrap (an initializer, markup, an
    //    attribute value), a call of a function that reads it (directly or
    //    through a call — the effect summary's `clock`) is refused exactly as a
    //    direct `Date.now()` there is.
    // Whether the callee reads the clock is the summary's to say: both are
    // recorded here and decided by rulesPass (dpa-066 M3).
    fn callPurity(env: Env, e: AExpr, cf: FnInfo, st: AS) -> AS {
        const h: HostCtx = env.host
        return match h {
            .HostOk :> st
            .HostPure :> fnCallsFunction(env, e, cf, st)
            .HostNo :> clockCallHere(env, e, cf, st)
        }
    }

    // s473 D29 ("one code per rule, the more specific winning") — a `fn` calling a function that
    // is NON-DETERMINISTIC is §48.3.4 E-FN-004, not the general §48.6.2 E-FN-003: one that reads
    // the clock (the summary's `clock`, through calls — decided by rulesPass), or a member of the
    // stdlib's `scrml:random` (§41.20: "every member is NON-DETERMINISTIC … E-FN-004"). Any other
    // `function` callee stays E-FN-003.
    fn fnCallsFunction(env: Env, e: AExpr, cf: FnInfo, st: AS) -> AS {
        if (cf.pure) return st
        if (isRandomModuleFile(cf.file)) return addDiag(st, env.file, e.span, "E-FN-004", "a `fn` body calls `" + cf.name + "` from `scrml:random`, which is non-deterministic — a `fn` is pure and cannot call it (§48.3.4, §41.20); call it in a `function` (or an event handler) and pass the value in as a parameter")
        return addPending(st, PendRule.PureCall(cf.sym.id, fnCallsFunctionDiag(env, e, cf, ""),
            newDiag("E-FN-004", "a `fn` body calls `" + cf.name + "`, which reads the clock (" + dateNowText() + ", directly or through a function it calls) — a non-deterministic call, so a `fn` cannot make it (§48.3.4); call it in a `function` (or an event handler) and pass the time in as a parameter", env.file, e.span)))
    }

    // A file of the stdlib's `scrml:random` module (the prefixed stdlib path, link.scrml).
    fn isRandomModuleFile(path: string) -> boolean {
        const p: string = stdlibPrefix() + "random"
        return path == p + ".scrml" || path.startsWith(p + "/")
    }

    // s468 — the WRITE half of E-FN-003 (SPEC §48.3.3): "A `fn` body SHALL NOT
    // write to any variable declared outside the `fn`'s own scope boundary.
    // This includes: … Property mutation on a value declared outside the `fn`
    // body … Calling a mutating method on an `@` reactive variable declared
    // outside the `fn` body (e.g., `@list.push(item)`)". The bootstrap enforced
    // only the call half (above), so `fn f() -> int { @n = 1 … }` compiled clean
    // (gap g-bootstrap-fn-writes-outer-cells-not-refused). Judged on the effect
    // summary's own scan of each `fn` body — the SAME write list every write
    // rule reads (§6.15 "one summary shared by every rule that uses it"): every
    // reactive write the binder classified (assignment, field / element write,
    // edit / removal call, spread, `reset(@x)`, transition) and, by shape, one
    // it refused; an arrow body inside the `fn` is scanned in place. Each write
    // is reported once, where it stands. A write REACHED through a call needs
    // no second report: a `fn` may call only another `fn` (E-FN-003, call
    // half), whose own body is judged here, so the transitive rule (§48.3
    // "any reachable call chain from the `fn` body") holds by construction.
    // A `fn` body has no other outer scope it could write in the bootstrap: a
    // plain local is the `fn`'s own (§48.3.3 "Local `let`/`const`/`lin`
    // variables declared inside the `fn` body may be freely mutated").
    fn fnWritePass(g: Globals, s: Summary) -> Diag[] {
        let out: Diag[] = []
        for (const fs of g.fns) {
            if (fs.info.pure) {
                const i: int = nodeIdx(s.nodes, fs.info.sym.id)
                if (i >= 0) {
                    for (const w of s.nodes[i].f.scan.writes) {
                        let cell: string = w.cell
                        if (cell.substring(0, 1) != "`") cell = "`" + cell + "`"
                        out = out.concat([newDiag("E-FN-003", "`fn " + fs.info.name + "` body writes the reactive cell " + cell + " — a `fn` is pure and may not mutate state declared outside its own body (§48.3.3); move the write out of the `fn` (return the new value and write it in the caller), or declare `" + fs.info.name + "` with `function` if the side effect is intended", w.file, w.span)])
                    }
                }
            }
        }
        return out
    }

    // s469 (review HIGH-1) — A FUNCTION WITH A DECLARED RETURN TYPE THAT CAN
    // FALL OFF THE END. JS gives `undefined` there, a value no scrml program may
    // produce (§42.5) — and an absence test that missed it let a wrong password
    // in. Refused, fail closed:
    //   - `-> T` (no `| not`): §17.6 / §34 E-TYPE-043 — "a code path that
    //     returns `not` … implicitly by falling off the end of the function body";
    //   - `-> T | not`: whether falling off MEANS `not` is a language decision
    //     not taken for the bootstrap (§42.7 says so of a server function only),
    //     so it is refused (E-BOOTSTRAP-UNSUPPORTED — write `return not`), never
    //     lowered to an implicit `return not`.
    // A path that leaves by `return <value>` (an `if` whose branches all do; a
    // statement `match` whose arms all do and which is exhaustive — a
    // failable `match` is total by E-TYPE-020) does not fall off. A `!`
    // function has no success-type slot (§19.4.1): not judged here.
    fn fallOffPass(g: Globals, t: Tables) -> Diag[] {
        let out: Diag[] = []
        for (const fs of g.fns) {
            // a function with a parse error inside it is not judged (Rule C: its body is not what was written)
            // s473: a `<host>` binding has no scrml body (§21.3.3 — its target is the function)
            if (!hasErrIn(fileErrs(g.files, fs.info.file), fs.f.span) && !isHostBindFn(g.files, fs)) out = out.concat(fallOffDiags(g, t, fs))
        }
        return out
    }

    // s469 — bryan's ruling "Always explicit" (#1471 round 2): no implicit tail return anywhere;
    // a declared-return function (`-> T | not` included) `return`s on every path — `return not;`
    // written out; a function with no return type returns nothing, and if any path of it returns
    // a value, every path must.
    fn fallOffDiags(g: Globals, t: Tables, fs: FnSrc) -> Diag[] {
        const b: ABlock = fs.f.body
        const r: AType | not = fs.f.ret
        const file: string = fs.info.file
        const n: string = fs.info.name
        // a `!` function (no success-type slot, §19.4.1) or an unannotated one: if any path
        // returns a value, every path returns one (or fails) — a bare `return` included
        // (in a `!` function it is a SUCCESS carrying nothing: `.Ok(v)` would take it)
        if (fs.info.failable || r is not) {
            if (hasValueReturn(g, file, b) && (blockHasBareReturn(b) || !fallsNever(t, b, false))) return [newDiag("E-RETURN-INCOMPLETE", "`" + n + "` returns a value on some path, so it must return one on every path — a path here " + incompleteWhat(b) + " (no implicit return in scrml); end every path with `return <value>;`" + incompleteFix(fs.info.failable), file, fs.f.span)]
            return []
        }
        if (fs.info.ret is not || declaresVoid(r)) return []
        const ty: string = typeText(r)
        // a bare `return` returns nothing, never `not`: write `return not;` (`-> T | not`) or a value
        if (blockHasBareReturn(b)) return [newDiag("E-TYPE-043", "`" + n + "` is declared `-> " + ty + "` but has a bare `return` — a declared-return function returns a value on every path (§17.6); write `return <value>;`" + notFix(r), file, fs.f.span)]
        if (fallsNever(t, b, false)) return []
        if (tailValue(b)) return [newDiag("E-TYPE-043", "`" + n + "` ends in an expression it does not `return` — scrml has no implicit tail return; write `return <expr>;` (§17.6)", file, fs.f.span)]
        return [newDiag("E-TYPE-043", "`" + n + "` is declared `-> " + ty + "` but can reach the end of its body without a `return` — a declared-return function returns on every path, `return not;` written out (§17.6); end every path with `return <value>;`" + notFix(r), file, fs.f.span)]
    }

    fn incompleteWhat(b: ABlock) -> string {
        if (blockHasBareReturn(b)) return "has a bare `return`"
        return "reaches the end of the body"
    }

    fn incompleteFix(failable: boolean) -> string {
        if (failable) return " or `fail …`"
        return ""
    }

    fn notFix(r: AType) -> string {
        const k: ATypeK = r.k
        return match k {
            .TMaybe(inner: i) :> " — for the absent case, `return not;`"
            .TName(name: x) :> ""
            .TSeq(elem: e) :> ""
        }
    }

    fn typeText(r: AType) -> string {
        const k: ATypeK = r.k
        return match k {
            .TName(name: x) :> x
            .TSeq(elem: e) :> typeText(e) + "[…]"
            .TMaybe(inner: i) :> typeText(i) + " | not"
        }
    }

    // =========================================================================
    // s469 (#1471 round 3) — "NO VALUE" IS A TYPE: `void` (§18.3: "A void match may not appear
    // on the right-hand side of an assignment"; bryan's ruling "Always explicit": a function
    // with no return type returns nothing). A function's result is VOID when it is declared
    // `-> void`, or it has no declared return type (unannotated, or `!` — whose SUCCESS has no
    // type slot, §19.4.1) and no path returns a value. `return f()` of a void `f` is not a value:
    // it passes `void` on (so an unannotated function whose every return is such a pass-through
    // is void too) — computed to a fixpoint over the program's functions, once (Globals.voids).
    // A call of a void function has type `void`, and ONE reader refuses `void` in every value
    // position (resolveCall for a call; noSuccessUse for a handled `!` call's success value):
    // E-TYPE-001. A declared `-> T` function is never void.
    // =========================================================================
    fn voidFns(fs: FnSrc[], lk: Linkage) -> int[] {
        let v: int[] = []
        for (const f of fs) {
            const r: AType | not = f.f.ret
            if (r is not) {
                v = v.concat([f.info.sym.id])
            } else if (declaresVoid(r)) {
                v = v.concat([f.info.sym.id])
            }
        }
        let changed = true
        while (changed) {
            changed = false
            let next: int[] = []
            for (const f of fs) {
                if (v.indexOf(f.info.sym.id) >= 0) {
                    if (fnDeclaredVoid(f) || !valueReturnIn(fnsInScope(fs, lk, f.info.file), v, f.f.body)) {
                        next = next.concat([f.info.sym.id])
                    } else {
                        changed = true
                    }
                }
            }
            v = next
        }
        return v
    }

    fn fnDeclaredVoid(f: FnSrc) -> boolean {
        const r: AType | not = f.f.ret
        if (r is not) return false
        return declaresVoid(r)
    }

    // Is a function's result `void` (a call of it has type `void`)?
    fn isVoidFn(g: Globals, sym: int) -> boolean {
        return g.voids.indexOf(sym) >= 0
    }

    // Does `b` hold a `return <value>` anywhere (any depth, arm blocks included) — a `return`
    // whose operand is not `void` (`return f()` of a void `f` passes `void` on)?
    fn hasValueReturn(g: Globals, file: string, b: ABlock) -> boolean {
        return valueReturnIn(fnsInScope(g.fns, g.te.link, file), g.voids, b)
    }

    // s472: the functions whose names are in scope in `file` — one per name, so
    // a by-name match among them (retIsValue) is THE callee, never another
    // file's function of that name.
    // s474: one entry per LOCAL name the function is bound under (an aliased
    // import binds it as the alias): `local` is what a call writes, `id` its sym.
    type ScopedFn:struct = { local: string, id: int }

    fn fnsInScope(fs: FnSrc[], lk: Linkage, file: string) -> ScopedFn[] {
        let out: ScopedFn[] = []
        for (const f of fs) {
            for (const local of boundAs(lk, file, NameKind.KFn, f.info.name, f.info.file)) { out = out.concat([{ local: local, id: f.info.sym.id }]) }
        }
        return out
    }

    fn valueReturnIn(fs: ScopedFn[], v: int[], b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtValueReturn(fs, v, s)) return true
        }
        return false
    }

    fn stmtValueReturn(fs: ScopedFn[], v: int[], s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> retIsValue(fs, v, x)
            .If(cond: c, thenB: tb, elseB: el) :> blocksValueReturn(fs, v, allExprBlocks(c)) || blocksValueReturn(fs, v, thenElse(tb, el))
            .Given(name: n, subject: x, body: gb) :> blocksValueReturn(fs, v, allExprBlocks(x)) || valueReturnIn(fs, v, gb)
            .For(f: lf) :> blocksValueReturn(fs, v, forExprBlocks(lf)) || valueReturnIn(fs, v, lf.body)
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: w) :> blocksValueReturn(fs, v, liftBlocks(w))
            .Eval(e: x) :> blocksValueReturn(fs, v, allExprBlocks(x))
            .Local(name: n, init: x) :> blocksValueReturn(fs, v, allExprBlocks(x))
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false
            .Fail(f: x) :> false
        }
    }

    fn blocksValueReturn(fs: ScopedFn[], v: int[], bs: ABlock[]) -> boolean {
        for (const b of bs) {
            if (valueReturnIn(fs, v, b)) return true
        }
        return false
    }

    // A `return` operand that is a value: present, and not a call of a void function.
    fn retIsValue(fs: ScopedFn[], v: int[], x: AExpr | not) -> boolean {
        if (x is not) return false
        const c: AExpr | not = calleeOf(x.k)
        if (c is not) return true
        const n: string = exprName(c)
        if (n == "") return true
        for (const f of fs) {
            if (f.local == n) return v.indexOf(f.id) < 0
        }
        return true
    }

    // Does `b` end in a value expression (not a write) — a §48.11 tail return?
    fn tailValue(b: ABlock) -> boolean {
        if (b.stmts.length == 0) return false
        const x: AExpr | not = evalOf(b.stmts[b.stmts.length - 1])
        if (x is not) return false
        if (isWriteExpr(x)) return false
        // a statement `match` whose arms are all blocks (`:> return …`, `:> { … }`) yields no value
        const h: AHandled | not = handledOf(x.k)
        if (h is given) {
            const arms: AArm[] | not = matchArmsOf(h.how)
            if (arms is given) {
                let allBlocks = true
                for (const a of arms) {
                    const body: AArmBody = a.body
                    const isB: boolean = match body {
                        .ArmBlock(b: bb) :> true
                        .ArmExpr(e: ee) :> false
                    }
                    if (!isB) allBlocks = false
                }
                if (allBlocks) return false
            }
        }
        return true
    }

    // Does every path through `b` leave with a value (or fail)?
    fn fallsNever(t: Tables, b: ABlock, bareOk: boolean) -> boolean {
        for (const s of b.stmts) {
            if (stmtLeavesAll(t, s, bareOk)) return true
        }
        return false
    }

    fn stmtLeavesAll(t: Tables, s: AStmt, bareOk: boolean) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> x is given || bareOk
            .Fail(f: x) :> true
            .If(cond: c, thenB: tb, elseB: el) :> fallsNever(t, tb, bareOk) && elseLeavesAll(t, el, bareOk)
            .Eval(e: x) :> matchLeavesAll(t, x, bareOk)
            .Given(name: n) :> false
            .For(f: lf) :> loopNeverCompletes(lf)
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: x) :> false
            .Local(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false
        }
    }

    fn elseLeavesAll(t: Tables, el: ABlock | not, bareOk: boolean) -> boolean {
        if (el is not) return false
        return fallsNever(t, el, bareOk)
    }

    // A statement `match` every arm of which leaves, and which takes every value.
    fn matchLeavesAll(t: Tables, e: AExpr, bareOk: boolean) -> boolean {
        const h: AHandled | not = handledOf(e.k)
        if (h is not) return false
        const arms: AArm[] | not = matchArmsOf(h.how)
        if (arms is not) return false
        const pm: PlainMatch | not = plainFactOf(failFact(t.fails, e.nid))
        if (pm is given) {
            if (!pm.exhaustive) return false
        }
        for (const a of arms) {
            const body: AArmBody = a.body
            const leaves: boolean = match body {
                .ArmBlock(b: b) :> fallsNever(t, b, bareOk)
                .ArmExpr(e: x) :> false
            }
            if (!leaves) return false
        }
        return arms.length > 0
    }

    fn fnCallsFunctionDiag(env: Env, e: AExpr, cf: FnInfo, why: string) -> Diag {
        return newDiag("E-FN-003", "a `fn` body calls `" + cf.name + "`, which is declared `function` — a `function` carries no purity guarantee, so a `fn` may call only another `fn` (§48.6.2)" + why + "; declare `" + cf.name + "` with `fn`, or make the caller a `function`", env.file, e.span)
    }

    fn clockCallHere(env: Env, e: AExpr, cf: FnInfo, st: AS) -> AS {
        return addPending(st, PendRule.IfClock(cf.sym.id, newDiag("E-BOOTSTRAP-UNSUPPORTED", "`" + cf.name + "()` reads the clock (" + dateNowText() + ", directly or through a function it calls) — here (an initializer, markup, or an attribute value) that is not in the bootstrap; its host-call surface is a `function` body or an event handler", env.file, e.span)))
    }

    // s444 — THE HOST-CALL SURFACE (progress.md "host call surface"): exactly
    // `Date.now()`, a `number` (ms since the epoch), in a `function` body or an
    // event handler. In a pure `fn` it is E-FN-004 (§33.3 item 7: a pure
    // function SHALL NOT "Call any non-deterministic built-in (`Date.now`, …)";
    // §41.19: the host member-expression `Date.now` "remains covered by the
    // existing E-FN-004"). Elsewhere (an initializer, markup, an `if=`) it is
    // outside the bootstrap: those positions evaluate on a schedule (lazy
    // shared instances, reactive re-runs) the SPEC's one-shot rule (§6.x
    // "one-shot evaluation at module initialization") does not describe.
    // The clock call's spelling, for messages. (impl#1 workaround F-NEW-s444:
    // impl#1's E-FN-004 scan matches the call's TEXT inside a string literal
    // of a `fn` body — so the spelling is never written whole in one here.)
    fn dateNowText() -> string { return "`Date" + ".now()`" }

    fn resolveHost(env: Env, e: AExpr, args: AExpr[], st: AS) -> RX {
        if (args.length > 0) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", dateNowText() + " takes no argument", st)
        const h: HostCtx = env.host
        return match h {
            .HostOk :> plain(Type.Num, addValue(st, e.nid, ValueFact.VHost(HostCall.DateNow)))
            .HostPure :> diagX(env, e, "E-FN-004", dateNowText() + " is non-deterministic — a `fn` body is pure and cannot call it (§33.3 item 7, §48.3.4); call it in a `function` (or an event handler) and pass the time in as a parameter", st)
            .HostNo :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", dateNowText() + " here (an initializer, markup, or an attribute value) is not in the bootstrap — its host-call surface is a `function` body or an event handler", st)
        }
    }

    // s444 — `seq.filter(x => e)` / `seq.map(x => e)`: a NEW sequence (R3). The
    // one argument is an arrow function of ONE parameter, typed as the element.
    fn resolveSeqCall(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> RX {
        const ro: RX = resolveExpr(env, m.obj, not, st0)
        let st: AS = ro.st
        let elem: Type | not = not
        const ot: Type | not = ro.x.ty
        const isFilter: boolean = m.method == "filter"
        // what a refusal still answers (a filter keeps the receiver's type), so
        // a `.length` after a refused call is not a second report
        let guess: Type | not = not
        if (isFilter && ot is given) guess = ungranted(ot)
        if (ot is given) {
            elem = seqElem(ot)
            if (elem is not) return plain(not, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`." + m.method + "(…)` on a value that is not a sequence (it is `" + typeName(ot) + "`)"))
        }
        const lam: AExpr | not = oneArg(args)
        if (lam is not) return plain(guess, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`." + m.method + "(…)` takes one arrow function `x => …`"))
        const ps: string[] = lambdaParams(lam)
        if (!isLambda(lam) || ps.length != 1) {
            return plain(guess, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "the argument of `." + m.method + "(…)` must be an arrow function of one parameter, `x => …` (the bootstrap has no other function value)"))
        }
        let want: Type | not = not
        let op: SeqFn = SeqFn.Map
        if (isFilter) {
            want = Type.Bool
            op = SeqFn.Filter
        }
        const rl: RX = resolveLambda(env, lam, ps, elem, want, st)
        st = rl.st
        // a filter keeps the receiver's type; a map is a sequence of the body's
        // type with the receiver's length (s469 F/U-5: a NEW tape — no grants, §66.12.6 rule 3)
        let result: Type | not = guess
        if (!isFilter) result = mappedType(ot, rl.x.ty)
        return plain(result, addValue(st, e.nid, ValueFact.VSeqCall(op)))
    }

    fn qualVariantValue(env: Env, e: AExpr, obj: AExpr, name: string, st: AS) -> RX | not {
        const n: string = exprName(obj)
        if (n == "") return not
        if (atName(obj) != "" || lookupLocal(env, n) is given) return not
        const ts: Sym | not = typeNamedHere(env, n)
        if (ts is not) return not
        const es: Sym | not = isEnumType(env.g.types, Type.Named(ts))
        if (es is not) return not
        const i: int = variantIndex(env.g.types, es, name)
        if (i < 0) return diagX(env, e, "E-TYPE-VARIANT", "`" + n + "." + name + "` — `" + name + "` is not a variant of `" + n + "`", st)
        const vs: VariantDef[] = enumVariantsOf(env.g, es)
        if (vs[i].fields.length > 0) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", payloadNoArgsMsg(n, name, n + "." + name, vs[i].fields.length), st)
        return plain(Type.Named(es), addValue(st, e.nid, ValueFact.VVariant(es, i)))
    }

    // s469 — `E.parse(s)` (SPEC §14.13.4, S469 "parse spelling `T.parse(s)`")
    // and `E.toEnum(s)`, which folds into it through a §63 window not yet open
    // (so no warning): ONE path, ONE fact (VToEnum), ONE lowering. §14.4.1:
    // `E.toEnum(s)` "accepts a string value and returns
    // the corresponding enum variant, or `not` if no variant matches … The
    // return type is `E | not` … String matching is case-sensitive — the string
    // must exactly match the variant name as declared." A typed signature
    // (`string -> E | not`, the typer checks the argument), never an untyped
    // escape. `E` must name an enum whose variants are all unit variants: a
    // payload variant has no value a name alone could produce (the SPEC does
    // not say what `toEnum` gives for one), so such an enum is refused — fail
    // closed. Lowered (lower.scrml toEnumExpr) to a `match` of `===` tests on
    // each declared name, never a property lookup: `"constructor"`,
    // `"__proto__"` and `"toString"` give `not`. `not` when `E` names no type
    // (the call is then refused by the general rule); a local named `E`
    // shadows the type.
    fn resolveToEnum(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> RX | not {
        const n: string = exprName(m.obj)
        if (n == "") return not
        if (lookupLocal(env, n) is given) return not
        const ts: Sym | not = typeNamedHere(env, n)
        if (ts is not) return not
        const es: Sym | not = isEnumType(env.g.types, Type.Named(ts))
        if (es is not) return diagX(env, e, "E-SCOPE-001", "`" + n + "` is not an enum — `" + m.method + "` is defined on enum types (and on `int`, `number`, `bool`) (§14.13.4)", resolveExprs(env, args, not, st0))
        if (args.length != 1) return diagX(env, e, "E-CALL-ARITY", "`" + n + "." + m.method + "(…)` takes one argument, the string to convert (§14.13.4); " + args.length + " given", resolveExprs(env, args, not, st0))
        const st: AS = resolveExpr(env, args[0], Type.Str, st0).st
        for (const v of enumVariantsOf(env.g, es)) {
            if (v.fields.length > 0) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`" + n + "." + m.method + "(…)` on an enum with a payload variant (`." + v.sym.hint + "`) — a name alone cannot build its payload, and §14.4.1 / §14.13.4 do not say what it gives; the bootstrap admits `" + m.method + "` on an enum of unit variants only", st)
        }
        return plain(Type.Maybe(Type.Named(es)), addValue(st, e.nid, ValueFact.VToEnum(es)))
    }

    // s469 — `int.parse(s)`, `number.parse(s)`, `bool.parse(s)` (SPEC §14.13.4,
    // ruled S469 "conversions: parse spelling `T.parse(s)`"): "A primitive type
    // name is a namespace for `parse` and nothing else; the spellings
    // `integer.parse` and `boolean.parse` do not exist." Each is `string ->
    // T | not`, strict and whole-string (the runtime's parseIntText /
    // parseNumText / parseBoolText — the ONE reader of number text). The
    // receiver names a type, not a value, so it gets no fact; anything else
    // written on a primitive type name is refused by name (fail closed).
    // `""` when `obj` is not a primitive type name (or a local shadows it).
    fn primNamespace(env: Env, obj: AExpr) -> string {
        const n: string = exprName(obj)
        if (!isPrimTypeName(n)) return ""
        if (lookupLocal(env, n) is given) return ""
        return n
    }

    fn isPrimTypeName(n: string) -> boolean {
        return n == "int" || n == "number" || n == "bool" || n == "string" || n == "integer" || n == "boolean"
    }

    fn resolvePrimParse(env: Env, e: AExpr, pn: string, m: MethodCall, args: AExpr[], st0: AS) -> RX {
        const call: string = "`" + pn + "." + m.method + "(…)`"
        if (m.method != "parse") return diagX(env, e, "E-SCOPE-001", call + " — `" + pn + "` is a type, and a primitive type name is a namespace for `.parse(s)` only (§14.13.4)", resolveExprs(env, args, not, st0))
        if (pn == "integer" || pn == "boolean") return diagX(env, e, "E-SCOPE-001", call + " does not exist — `" + pn + "` is a synonym of `" + primCanon(pn) + "` in type position only; write `" + primCanon(pn) + ".parse(s)` (§14.13.4, §14.13.6)", resolveExprs(env, args, not, st0))
        if (pn == "string") return diagX(env, e, "E-SCOPE-001", call + " does not exist — text is already a `string`; `T.parse(s)` reads text as an `int`, a `number`, a `bool` or an enum (§14.13.4)", resolveExprs(env, args, not, st0))
        if (args.length != 1) return diagX(env, e, "E-CALL-ARITY", call + " takes one argument, the text to read (§14.13.4); " + args.length + " given", resolveExprs(env, args, not, st0))
        const st: AS = resolveExpr(env, args[0], Type.Str, st0).st
        const op: PrimOp = primParseOp(pn)
        return plain(methodResult(op, Type.Str), addValue(st, e.nid, ValueFact.VMethod(op)))
    }

    fn primCanon(n: string) -> string {
        if (n == "integer") return "int"
        if (n == "boolean") return "bool"
        return n
    }

    fn primParseOp(pn: string) -> PrimOp {
        if (pn == "int") return PrimOp.ParseInt
        if (pn == "number") return PrimOp.ParseNum
        return PrimOp.ParseBool
    }

    fn isParseOp(op: PrimOp) -> boolean {
        return op == PrimOp.ParseInt || op == PrimOp.ParseNum || op == PrimOp.ParseBool
    }

    // =========================================================================
    // s469 — THE TYPED BUILT-IN METHODS (strings + tapes). A method call is
    // admitted only when its RECEIVER's type is known here and the method is in
    // that type's table below; anything else is refused BY NAME (fail closed) —
    // never passed through to the host as a generic JS member call.
    //   string (SPEC Appendix D sanctions the host string methods; S469: string
    //   positions are CODE POINTS — `slice` / `charAt` / `split("")` count them):
    //     toUpperCase() toLowerCase() trim()             -> string
    //     slice(from: int) slice(from: int, to: int)     -> string
    //     charAt(i: int)                                 -> string ("" past the end)
    //     includes(s) startsWith(s) endsWith(s)          -> bool    (s: string)
    //     split(sep: string)                             -> string[] (no grants: a value)
    //   tape (§66.12.6 rule 3: these never mutate; each returns a NEW tape):
    //     sort()   — natural order (S469: ints / numbers numerically, strings by
    //                code point); any other element type is refused
    //     sort((a, b) => n)  — a comparator returning a number (resolveSortBy)
    //     reverse()          — the receiver's type
    //     join(sep: string)  — a tape of strings only (an int→string conversion
    //                          is not ruled yet, so nothing else converts)
    //   JavaScript's names on a tape are E-TAPE-JS-METHOD (§66.12.6 rule 3):
    //     push / unshift / splice (mutating: the scrml method is named after its
    //     grant), toSorted / toReversed / with (S469: "Refuse, one name each").
    // The binder decides the receiver (ONE reader: the type `resolveExpr` gives
    // the receiver, as `.length` does); the typer types each argument against
    // the method's signature (methodArgCheck) and the result (methodType), from
    // the ONE table `methodSig`.
    // =========================================================================

    // A refused call names its method (fail closed BY NAME), when it has one.
    // s469 F/U-8: `E.V(…)` on an enum type is a payload-variant CONSTRUCTION,
    // said as such (not as a "method"). s472: resolveConstruct takes every
    // `E.V(…)` on an enum before resolveCall runs, so that branch is a
    // fail-closed fallback only.
    fn callText(env: Env, callee: AExpr) -> string {
        const m: MethodCall | not = memberCall(callee)
        if (m is not) return ""
        const n: string = exprName(m.obj)
        if (n != "" && atName(m.obj) == "" && lookupLocal(env, n) is not) {
            const ts: Sym | not = typeNamedHere(env, n)
            if (ts is given) {
                if (isEnumType(env.g.types, Type.Named(ts)) is given) return "`" + n + "." + m.method + "(…)` — "
            }
        }
        return "`." + m.method + "(…)` is not in the bootstrap — "
    }

    fn isBuiltinMethodName(n: string) -> boolean {
        return isStrMethodName(n) || n == "sort" || n == "reverse" || n == "join" || tapeJsFix(n) != ""
    }

    fn isStrMethodName(n: string) -> boolean {
        return strMethodOp(n) is given
    }

    fn strMethodList() -> string {
        return "`toUpperCase` / `toLowerCase` / `trim` / `trimStart` / `trimEnd` / `slice` / `charAt` / `includes` / `startsWith` / `endsWith` / `split` / `indexOf` / `lastIndexOf` / `replace` / `replaceAll` / `padStart` / `padEnd` / `repeat`"
    }

    // s469 — E-STRING-METHOD-UNKNOWN's fix-it: the nearest admitted form of a
    // host string method that is not in Appendix D.1's table ("" when there is
    // none to name).
    fn strMethodNearest(n: string) -> string {
        return match n {
            "substring" :> "`.slice(from, to)`"
            "substr" :> "`.slice(from, to)`"
            "at" :> "`.charAt(i)` (the empty string out of range), or the index read `s[i]` (a trap out of range)"
            "codePointAt" :> "`.charAt(i)` — a position is already a code point"
            "charCodeAt" :> "`.charAt(i)` — a position is already a code point"
            "trimLeft" :> "`.trimStart()`"
            "trimRight" :> "`.trimEnd()`"
            "search" :> "`.indexOf(t)` (a plain string; `int | not`)"
            "match" :> "`.includes(t)` / `.indexOf(t)` (plain strings — regex has no ruled type yet)"
            "matchAll" :> "`.indexOf(t)` (plain strings — regex has no ruled type yet)"
            "concat" :> "a backtick template holding both values"
            "toLocaleUpperCase" :> "`.toUpperCase()`"
            "toLocaleLowerCase" :> "`.toLowerCase()`"
            "toString" :> "the string itself (it is already text)"
            "valueOf" :> "the string itself"
            _ :> ""
        }
    }

    // The fix-it for a JavaScript tape method name (E-TAPE-JS-METHOD), "" for
    // any other name.
    fn tapeJsFix(n: string) -> string {
        return match n {
            "push" :> "`.append(x)` (one call per value)"
            "unshift" :> "`.prepend(x)` (one call per value)"
            "splice" :> "`.remove(i)` for each removed position and `.insert(i, x)` for each inserted value"
            "toSorted" :> "`.sort()` — a scrml `sort` already returns a new tape"
            "toReversed" :> "`.reverse()` — a scrml `reverse` already returns a new tape"
            "with" :> "a position write, `xs[i] = v` (granted by `write`)"
            _ :> ""
        }
    }

    // The built-in a method name is on a receiver of type `t`; `not` when the
    // type has no such method in the bootstrap (or, for `sort()`, when the
    // element type has no natural order — the caller says which).
    fn methodOp(n: string, t: Type) -> PrimOp | not {
        if (t == Type.Str) return strMethodOp(n)
        const el: Type | not = seqElem(t)
        if (el is not) return not
        if (n == "reverse") return PrimOp.Reverse
        if (n == "join" && el == Type.Str) return PrimOp.Join
        if (n == "sort") {
            if (el == Type.Int || el == Type.Num) return PrimOp.SortNum
            if (el == Type.Str) return PrimOp.SortStr
        }
        return not
    }

    fn strMethodOp(n: string) -> PrimOp | not {
        return match n {
            "toUpperCase" :> PrimOp.StrUpper
            "toLowerCase" :> PrimOp.StrLower
            "trim" :> PrimOp.StrTrim
            "slice" :> PrimOp.StrSlice
            "charAt" :> PrimOp.StrCharAt
            "includes" :> PrimOp.StrIncludes
            "startsWith" :> PrimOp.StrStartsWith
            "endsWith" :> PrimOp.StrEndsWith
            "split" :> PrimOp.StrSplit
            // s469 — admitted (S469 "more string methods admitted"), code points everywhere
            "indexOf" :> PrimOp.StrIndexOf
            "lastIndexOf" :> PrimOp.StrLastIndexOf
            "replace" :> PrimOp.StrReplace
            "replaceAll" :> PrimOp.StrReplaceAll
            "padStart" :> PrimOp.StrPadStart
            "padEnd" :> PrimOp.StrPadEnd
            "repeat" :> PrimOp.StrRepeat
            "trimStart" :> PrimOp.StrTrimStart
            "trimEnd" :> PrimOp.StrTrimEnd
            _ :> not
        }
    }

    // The ONE signature table: a built-in's argument types, in order. `slice`'s
    // second argument is optional (methodArity's minimum).
    // s469: `padStart` / `padEnd`'s `fill` is optional (default " "); `indexOf`
    // / `lastIndexOf` take NO start position (D.1: slice first, then search);
    // `replace` / `replaceAll` take plain strings (a regex is not a `string`,
    // so it is E-TYPE-031 — or unparsed). A parse's one argument is its text.
    fn methodSig(op: PrimOp) -> Type[] {
        if (op == PrimOp.StrSlice) return [Type.Int, Type.Int]
        if (op == PrimOp.StrCharAt || op == PrimOp.StrRepeat) return [Type.Int]
        if (op == PrimOp.StrPadStart || op == PrimOp.StrPadEnd) return [Type.Int, Type.Str]
        if (op == PrimOp.StrIncludes || op == PrimOp.StrStartsWith || op == PrimOp.StrEndsWith) return [Type.Str]
        if (op == PrimOp.StrIndexOf || op == PrimOp.StrLastIndexOf) return [Type.Str]
        if (op == PrimOp.StrReplace || op == PrimOp.StrReplaceAll) return [Type.Str, Type.Str]
        if (op == PrimOp.StrSplit || op == PrimOp.Join) return [Type.Str]
        if (isParseOp(op)) return [Type.Str]
        return []
    }

    fn methodMinArity(op: PrimOp) -> int {
        if (op == PrimOp.StrSlice || op == PrimOp.StrPadStart || op == PrimOp.StrPadEnd) return 1
        return methodSig(op).length
    }

    // The result type of a built-in on a receiver of type `recv`.
    fn methodResult(op: PrimOp, recv: Type) -> Type {
        if (op == PrimOp.StrIncludes || op == PrimOp.StrStartsWith || op == PrimOp.StrEndsWith) return Type.Bool
        if (op == PrimOp.StrIndexOf || op == PrimOp.StrLastIndexOf) return Type.Maybe(Type.Int)
        if (op == PrimOp.ParseInt) return Type.Maybe(Type.Int)
        if (op == PrimOp.ParseNum) return Type.Maybe(Type.Num)
        if (op == PrimOp.ParseBool) return Type.Maybe(Type.Bool)
        if (op == PrimOp.StrSplit) return Type.Seq(Type.Str, anySeqGrants())
        if (op == PrimOp.SortNum || op == PrimOp.SortStr || op == PrimOp.Reverse) return ungranted(recv)
        return Type.Str
    }

    // s469 F/U-5 — a NEW tape (`sort`, `reverse`, `filter`, `map`, a comparator
    // sort) is a value: it carries its own type's grants, and that type grants
    // nothing (§66.12.6 rule 3: "a binding of it carries the grants of its own
    // type, and inference never invents one") — never the receiver's.
    fn ungranted(t: Type) -> Type {
        const el: Type | not = seqElem(t)
        if (el is not) return t
        return Type.Seq(el, fixedSeq())
    }

    // A built-in's name as written (for messages).
    fn methodName(op: PrimOp) -> string {
        if (op == PrimOp.StrUpper) return "toUpperCase"
        if (op == PrimOp.StrLower) return "toLowerCase"
        if (op == PrimOp.StrTrim) return "trim"
        if (op == PrimOp.StrSlice) return "slice"
        if (op == PrimOp.StrCharAt) return "charAt"
        if (op == PrimOp.StrIncludes) return "includes"
        if (op == PrimOp.StrStartsWith) return "startsWith"
        if (op == PrimOp.StrEndsWith) return "endsWith"
        if (op == PrimOp.StrSplit) return "split"
        if (op == PrimOp.StrIndexOf) return "indexOf"
        if (op == PrimOp.StrLastIndexOf) return "lastIndexOf"
        if (op == PrimOp.StrReplace) return "replace"
        if (op == PrimOp.StrReplaceAll) return "replaceAll"
        if (op == PrimOp.StrPadStart) return "padStart"
        if (op == PrimOp.StrPadEnd) return "padEnd"
        if (op == PrimOp.StrRepeat) return "repeat"
        if (op == PrimOp.StrTrimStart) return "trimStart"
        if (op == PrimOp.StrTrimEnd) return "trimEnd"
        if (op == PrimOp.ParseInt) return "parse"
        if (op == PrimOp.ParseNum) return "parse"
        if (op == PrimOp.ParseBool) return "parse"
        if (op == PrimOp.Reverse) return "reverse"
        if (op == PrimOp.Join) return "join"
        return "sort"
    }

    // A refused method call: ONE report, on the call; it gets no fact and no
    // type, and its arguments are not judged (as the general refusal in
    // resolveCall — an argument has no expected type to be judged against).
    fn refuseMethod(env: Env, e: AExpr, code: string, msg: string, args: AExpr[], st: AS) -> RX {
        return plain(not, addDiag(st, env.file, e.span, code, msg))
    }

    // What a refused copy-returning JS name still answers (the receiver's type,
    // as a refused filter does), so a `.length` after it is not a second report.
    fn tapeGuess(n: string, ot: Type) -> Type | not {
        if (n == "toSorted" || n == "toReversed" || n == "with") return ot
        return not
    }

    fn resolveMethod(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> RX {
        const ro: RX = resolveExpr(env, m.obj, not, st0)
        const st: AS = ro.st
        const ot: Type | not = ro.x.ty
        const call: string = "`." + m.method + "(…)`"
        if (ot is not) {
            if (strMethodOp(m.method) is not && strReceiver(env, m.obj, ro)) return refuseMethod(env, e, "E-STRING-METHOD-UNKNOWN", strUnknownMsg(m.method), args, st)
            return refuseMethod(env, e, "E-BOOTSTRAP-UNSUPPORTED", call + " on a value whose type the compiler cannot resolve — a built-in method needs a receiver of a known type (a `string` or a tape); give it one (`: string`, `: T[…]`)", args, st)
        }
        const fix: string = tapeJsFix(m.method)
        if (fix != "") {
            if (seqElem(ot) is given) return plain(tapeGuess(m.method, ot), refuseMethod(env, e, "E-TAPE-JS-METHOD", call + " is JavaScript's array method, not a tape method — write " + fix + " (§66.12.6 rule 3: tape methods are named after their grants, and `sort` / `reverse` return a new tape)", args, st).st)
            if (isStrOrMaybeStr(ot)) return refuseMethod(env, e, "E-STRING-METHOD-UNKNOWN", strUnknownMsg(m.method), args, st)
            return refuseMethod(env, e, "E-BOOTSTRAP-UNSUPPORTED", call + " on a `" + typeName(ot) + "` is not in the bootstrap", args, st)
        }
        // review F2: a method outside D.1 on a `string | not` is unknown on the string inside, narrowed or not
        if (isStrOrMaybeStr(ot) && strMethodOp(m.method) is not) return refuseMethod(env, e, "E-STRING-METHOD-UNKNOWN", strUnknownMsg(m.method), args, st)
        if (maybeInner(ot) is given) {
            return refuseMethod(env, e, "E-BOOTSTRAP-UNSUPPORTED", call + " on a `" + typeName(ot) + "` — the value may be `not`, and the bootstrap does not read a narrowing at a method's receiver; pass the narrowed value to a function that takes the plain type", args, st)
        }
        const op: PrimOp | not = methodOp(m.method, ot)
        if (op is not) {
            const el: Type | not = seqElem(ot)
            if (m.method == "sort" && el is given) {
                return plain(ot, refuseMethod(env, e, "E-TYPE-031", "`.sort()` with no comparator needs elements with a natural order — ints and numbers (numerically) or strings (by code point) — and these are `" + typeName(el) + "` (S469); pass a comparator, `.sort((a, b) => …)` returning a number", args, st).st)
            }
            if (m.method == "join" && el is given) {
                return refuseMethod(env, e, "E-TYPE-031", "`.join(sep)` joins a tape of strings, and this one holds `" + typeName(el) + "` — there is no ruled conversion of a `" + typeName(el) + "` to a string yet, so nothing converts it implicitly", args, st)
            }
            if (ot == Type.Str) return refuseMethod(env, e, "E-STRING-METHOD-UNKNOWN", strUnknownMsg(m.method), args, st)
            return refuseMethod(env, e, "E-BOOTSTRAP-UNSUPPORTED", call + " on a `" + typeName(ot) + "` is not in the bootstrap — its built-in methods are, on a string: " + strMethodList() + "; on a tape: `.sort()`, `.reverse()`, `.join(sep)`, `.filter(x => …)`, `.map(x => …)`", args, st)
        }
        const lo: int = methodMinArity(op)
        const hi: int = methodSig(op).length
        if (args.length < lo || args.length > hi) {
            let want: string = hi + " argument(s)"
            if (lo != hi) want = lo + " or " + hi + " arguments"
            if (m.method == "sort") want = "no argument (the natural order) or one comparator `(a, b) => …`"
            return refuseMethod(env, e, "E-CALL-ARITY", "`." + m.method + "(…)` takes " + want + "; " + args.length + " given", args, st)
        }
        const sig: Type[] = methodSig(op)
        let st2: AS = st
        let i = 0
        for (const a of args) {
            st2 = resolveExpr(env, a, sig[i], st2).st
            if (isPositionArg(op, i) && negLiteral(a)) st2 = addDiag(st2, env.file, a.span, "E-POSITION-NEGATIVE", negPositionMsg(op))
            i = i + 1
        }
        return plain(methodResult(op, ot), addValue(st2, e.nid, ValueFact.VMethod(op)))
    }

    // s469 — no negative positions (S469 "No negatives anywhere (Recommended)";
    // Appendix D.1): a negative LITERAL `slice` position — and, derived, a
    // `repeat` count or a `padStart` / `padEnd` width — is E-POSITION-NEGATIVE
    // at compile time; a negative COMPUTED one traps at run time
    // (E-INDEX-OUT-OF-RANGE-RT, the runtime's helpers). `charAt` is not here (a
    // negative `i` is `""`), nor is an index read (`s[-1]` / `xs[-1]` trap,
    // literal or computed — §66.12.8 rule 7).
    fn isPositionArg(op: PrimOp, i: int) -> boolean {
        if (op == PrimOp.StrSlice) return true
        if (op == PrimOp.StrRepeat || op == PrimOp.StrPadStart || op == PrimOp.StrPadEnd) return i == 0
        return false
    }

    // A negative number literal as written: `-` applied to a non-zero literal.
    fn negLiteral(x: AExpr) -> boolean {
        const k: AExprK = x.k
        return match k {
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: zs) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o, e: inner) :> o == UnOp.Neg && positiveLit(inner)
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    fn positiveLit(x: AExpr) -> boolean {
        const k: AExprK = x.k
        return match k {
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> Number(r) > 0
            .Str(v: zs) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    fn negPositionMsg(op: PrimOp) -> string {
        let what: string = "a position"
        let fix: string = "count from the end explicitly: `s.slice(s.length - 1)`"
        if (op == PrimOp.StrRepeat) {
            what = "a count"
            fix = "a count is 0 or more"
        }
        if (op == PrimOp.StrPadStart || op == PrimOp.StrPadEnd) {
            what = "a width"
            fix = "a width is 0 or more"
        }
        return "a negative literal as " + what + " of `." + methodName(op) + "(…)` — no position counts from the end, and a negative one is out of range (Appendix D.1, S469); " + fix
    }

    // s469 — E-STRING-METHOD-UNKNOWN (Appendix D.1, §34): a method that is not
    // in the string table, called on a receiver the binder types `string` (the
    // ONE reader of a receiver's type, as resolveMethod). `not` when the
    // receiver is not provably a string: the probe's facts and reports are
    // dropped, and the call takes the general refusal exactly as before.
    fn unknownStrMethod(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> RX | not {
        const ro: RX = resolveExpr(env, m.obj, not, st0)
        if (!strReceiver(env, m.obj, ro)) return not
        return refuseMethod(env, e, "E-STRING-METHOD-UNKNOWN", strUnknownMsg(m.method), args, ro.st)
    }

    // review F2 — is a receiver provably TEXT, for the unknown-method refusal? Its
    // binder type is `string` or `string | not` (a method outside D.1 does not exist
    // on the string inside, narrowed or not), or — the binder types no call result —
    // it is a call of a declared function whose return type is one of those (the
    // function's own `ret`, the one record of it).
    fn strReceiver(env: Env, obj: AExpr, ro: RX) -> boolean {
        const rt: Type | not = ro.x.ty
        if (rt is given) return isStrOrMaybeStr(rt)
        const c: AExpr | not = calleeOf(obj.k)
        if (c is not) return false
        const f: FnInfo | not = calledFn(env, nameFactIn(ro.st, c.nid))
        if (f is not) return false
        const r: Type | not = f.ret
        if (r is not) return false
        return isStrOrMaybeStr(r)
    }

    fn isStrOrMaybeStr(t: Type) -> boolean {
        if (t == Type.Str) return true
        const i: Type | not = maybeInner(t)
        if (i is not) return false
        return i == Type.Str
    }

    fn strUnknownMsg(n: string) -> string {
        let fix: string = ""
        const near: string = strMethodNearest(n)
        if (near != "") fix = "; write " + near
        return "`." + n + "(…)` is not a string method — a string's methods are Appendix D.1's table, and nothing else is passed to the host: " + strMethodList() + fix
    }

    // s469 — `xs.sort((a, b) => n)`: a NEW tape ordered by the comparator, an
    // arrow function of TWO parameters (both the element type) whose body is a
    // number (S440 #10: "a comparator must return a number"; the typer checks it).
    fn resolveSortBy(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> RX {
        const ro: RX = resolveExpr(env, m.obj, not, st0)
        let st: AS = ro.st
        const ot: Type | not = ro.x.ty
        if (ot is not) return refuseMethod(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`.sort(…)` on a value whose type the compiler cannot resolve — give it a tape type", args, st)
        const elem: Type | not = seqElem(ot)
        if (elem is not) return refuseMethod(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`.sort(…)` on a value that is not a tape (it is `" + typeName(ot) + "`)", args, st)
        const lam: AExpr = args[0]
        const ps: string[] = lambdaParams(lam)
        if (!isLambda(lam) || ps.length != 2) {
            return plain(ot, refuseMethod(env, e, "E-BOOTSTRAP-UNSUPPORTED", "the argument of `.sort(…)` must be a comparator, an arrow function of two parameters `(a, b) => …` returning a number (the bootstrap has no other function value)", args, st).st)
        }
        const rl: RX = resolveLambda(env, lam, ps, elem, not, st)
        return plain(ungranted(ot), addValue(rl.st, e.nid, ValueFact.VSeqCall(SeqFn.SortBy)))
    }

    // s469 — a statement whose call is a JavaScript tape method name, or a
    // `sort` / `reverse` / `fill` / `copyWithin` whose result is DISCARDED (the
    // in-place idiom, which does nothing here: they return a new tape,
    // §66.12.6 rule 3, trigger (b)). Answered only for a tape receiver; `not`
    // otherwise, and the statement is resolved as before.
    fn tapeMethodStmt(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> AS | not {
        const fix: string = tapeJsFix(m.method)
        const discarded: boolean = m.method == "sort" || m.method == "reverse" || m.method == "fill" || m.method == "copyWithin"
        if (fix == "" && !discarded) return not
        const ro: RX = resolveExpr(env, m.obj, not, st0)
        const ot: Type | not = ro.x.ty
        if (ot is not) return not
        if (seqElem(ot) is not) return not
        const at: string = placeKey(m.obj)
        let recv: string = "xs"
        if (at != "") recv = at
        if (fix != "") return refuseMethod(env, e, "E-TAPE-JS-METHOD", "`" + recv + "." + m.method + "(…)` is JavaScript's array method, not a tape method — write " + fix + " (§66.12.6 rule 3: tape methods are named after their grants)", args, ro.st).st
        return refuseMethod(env, e, "E-TAPE-JS-METHOD", discardedMessage(at, m.method, "as a statement"), args, ro.st).st
    }

    // The trigger-(b) message: write-back is offered only for a PLACE receiver
    // (`@xs = @xs.sort(…);`); any other receiver (`@s.split(",").reverse();`)
    // has nothing to write back to — bind the result.
    fn discardedMessage(at: string, method: string, where: string) -> string {
        if (at == "") return "`." + method + "(…)` returns a NEW tape, and its value is discarded " + where + ", so it does nothing (§66.12.6 rule 3) — bind the result (`const t = …." + method + "(…);`)"
        return "`" + at + "." + method + "(…)` returns a NEW tape and leaves `" + at + "` unchanged, and its value is discarded " + where + ", so it does nothing (§66.12.6 rule 3) — write `" + at + " = " + at + "." + method + "(…);` (needs `write`), or bind the result"
    }

    // s469 F/U-4 — a statement whose VALUE is discarded through a ternary or a
    // `&&` / `||` (`@n == 0 ? @xs.sort() : @xs.reverse();`): each branch whose
    // value is dropped is judged as a statement of its own, so a `sort` /
    // `reverse` / `fill` / `copyWithin` there is the same do-nothing idiom
    // (E-TAPE-JS-METHOD trigger (b)). Reports only; the expression is then
    // resolved as before (the receiver peek's state is thrown away).
    fn discardedTapeBranches(env: Env, e: AExpr, st0: AS) -> AS {
        let st: AS = st0
        for (const b of discardedArms(e)) {
            const k: AExprK = b.k
            const callee: AExpr | not = calleeOf(k)
            if (callee is given) {
                const m: MethodCall | not = memberCall(callee)
                if (m is given) {
                    if (m.method == "sort" || m.method == "reverse" || m.method == "fill" || m.method == "copyWithin") {
                        const ot: Type | not = resolveExpr(env, m.obj, not, st).x.ty
                        if (ot is given) {
                            if (seqElem(ot) is given) {
                                st = addDiag(st, env.file, b.span, "E-TAPE-JS-METHOD", discardedMessage(placeKey(m.obj), m.method, "in this branch"))
                            }
                        }
                    }
                }
            }
            st = discardedTapeBranches(env, b, st)
        }
        return st
    }

    // The sub-expressions whose value a discarded expression also discards:
    // both arms of a ternary, the right operand of `&&` / `||`.
    fn discardedArms(e: AExpr) -> AExpr[] {
        const k: AExprK = e.k
        return match k {
            .Ternary(test: t, yes: y, no: n) :> [y, n]
            .Binary(op: o, l: l, r: r) :> andOrRight(o, r)
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: x) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Index(obj: o) :> []
            .Lambda(params: ps) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    fn andOrRight(o: BinOp, r: AExpr) -> AExpr[] {
        if (o == BinOp.And || o == BinOp.Or) return [r]
        return []
    }

    fn oneArg(args: AExpr[]) -> AExpr | not {
        if (args.length != 1) return not
        return args[0]
    }

    fn mappedType(src: Type | not, body: Type | not) -> Type | not {
        if (src is not || body is not) return not
        return mappedOf(src, body)
    }

    fn mappedOf(src: Type, body: Type) -> Type | not {
        return match src {
            .Seq(elem: el, grants: g) :> Type.Seq(body, fixedSeq())
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Named(sym: x) :> not
            .Maybe(inner: i) :> not
        }
    }

    // A lambda: its parameters are minted locals (typed `ty` when known, via
    // the annotation table the typer reads); its body is resolved with them in
    // scope. Answers the body's type.
    fn resolveLambda(env: Env, lam: AExpr, ps: string[], ty: Type | not, want: Type | not, st0: AS) -> RX {
        let st: AS = st0
        let env2: Env = env
        let syms: Sym[] = []
        for (const pn of ps) {
            const rs: RSym = mint(reservedName(st, env.file, lam.span, pn), pn)
            st = rs.st
            syms = syms.concat([rs.s])
            if (ty is given) st = addAnnot(st, rs.s, ty)
            env2 = withLocal(env2, { name: pn, s: rs.s, ty: ty, mutable: false, narrowed: not, nDecl: not, fresh: false })
        }
        st = addValue(st, lam.nid, ValueFact.VLambda(syms))
        const b: AExpr | not = lambdaBody(lam)
        if (b is not) return plain(not, st)
        return resolveExpr(env2, b, want, st)
    }

    fn isLambda(e: AExpr) -> boolean { return lambdaBody(e) is given }

    fn lambdaParams(e: AExpr) -> string[] {
        const k: AExprK = e.k
        return match k {
            .Lambda(params: ps) :> ps
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: x) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps2) :> []
            .Spread(e: x) :> []
            .Index(obj: o) :> []
        }
    }

    fn lambdaBody(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Lambda(params: ps, body: b) :> b
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps2) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
        }
    }

    fn resolveUnary(env: Env, e: AExpr, op: UnOp, x: AExpr, st0: AS) -> RX {
        const isNot: boolean = op == UnOp.Not
        if (isNot) {
            const r: RX = resolveExpr(env, x, Type.Bool, st0)
            return plain(Type.Bool, addValue(r.st, e.nid, ValueFact.VOp(PrimOp.Not)))
        }
        // s460: `x is given` / `x is not` (§42.2.4) — an absence check over a
        // value of any type (IsSome / IsNot: `!= null` / `== null`, so `undefined`
        // is absent too, §42.5)
        const isGiven: boolean = op == UnOp.IsGiven
        const isAbsent: boolean = op == UnOp.IsNot
        if (isGiven || isAbsent) {
            const rp: RX = resolveExpr(env, x, not, st0)
            let prim: PrimOp = PrimOp.IsSome
            if (isAbsent) prim = PrimOp.IsNot
            return plain(Type.Bool, addValue(rp.st, e.nid, ValueFact.VOp(prim)))
        }
        const r2: RX = resolveExpr(env, x, not, st0)
        return plain(r2.x.ty, addValue(r2.st, e.nid, ValueFact.VOp(PrimOp.Neg)))
    }

    // s472: a bare variant `.V`, or a bare construction `.V(…)` — an operand
    // whose enum comes from its position (§14.10).
    fn isBareVariantish(e: AExpr) -> boolean {
        if (isVariantExpr(e)) return true
        const c: AExpr | not = calleeOfCall(e)
        if (c is not) return false
        return bareVariantName(c) != ""
    }

    fn calleeOfCall(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Call(callee: c) :> c
            .Variant(name: n) :> not
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Member(obj: o) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn isVariantExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Variant(name: n) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // `==` is structural (§45): primitive compare for scalars and nullary
    // enums, the runtime's structural equality for structs and sequences.
    // s469 — §45: `==` is EqPrim (JS `===`) only where the operand type is
    // PROVABLY a scalar or an enum of unit variants — a `T | not` of one
    // included (`not` is `null`, which `===` compares exactly). Anything else is
    // EqStruct (the runtime's structural `eq`): a struct, a tape, an enum with
    // a payload variant (its value is an object), a `T | not` of any of those
    // (before s469 `(User | not) == (User | not)` compiled to a REFERENCE
    // compare — the Maybe hid the struct), and a type the binder cannot prove.
    fn isStructural(env: Env, t: Type | not) -> boolean {
        if (t is not) return true
        const inner: Type = unMaybe(t)
        const k: int = kindOf(inner)
        if (k <= 3) return false
        if (k == 5) return true
        const es: Sym | not = isEnumType(env.g.types, inner)
        if (es is given) return hasPayloadVariant(env, es)
        return true
    }

    fn hasPayloadVariant(env: Env, es: Sym) -> boolean {
        for (const v of enumVariantsOf(env.g, es)) {
            if (v.fields.length > 0) return true
        }
        return false
    }

    fn resolveBinary(env: Env, e: AExpr, op: BinOp, l: AExpr, r: AExpr, st0: AS) -> RX {
        // operands: a bare variant takes the OTHER operand's type
        let rl: RX = plain(not, st0)
        let rr: RX = plain(not, st0)
        // s472: a bare CONSTRUCTION `.V(…)` takes the other operand's type as a bare `.V` does (§14.10)
        if (isBareVariantish(l) && !isBareVariantish(r)) {
            rr = resolveExpr(env, r, not, st0)
            rl = resolveExpr(env, l, rr.x.ty, rr.st)
            rr = { x: rr.x, st: rl.st }
        } else {
            rl = resolveExpr(env, l, not, st0)
            rr = resolveExpr(env, r, rl.x.ty, rl.st)
        }
        let st: AS = rr.st
        // s469 #1471 delta review: `x == not` / `x != not` is §45 E-EQ-002 (E-TYPE-042 retired
        // S305 into it) — absence is `x is not` / `x is given`, which test `null` AND `undefined`
        if ((op == BinOp.Eq || op == BinOp.Ne) && (isNotLit(l) || isNotLit(r))) {
            let fix: string = "x is not"
            if (op == BinOp.Ne) fix = "x is given"
            st = addDiag(st, env.file, e.span, "E-EQ-002", "absence is tested with `is not` / `is given`, not equality against `not` — write `" + fix + "` (§45, §42.2)")
        }
        const lt: Type | not = rl.x.ty
        let et: Type | not = lt
        if (et is not) et = rr.x.ty
        return match op {
            .Eq :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(eqOp(isStructural(env, et), true))))
            .Ne :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(eqOp(isStructural(env, et), false))))
            .Add :> plain(lt, addValue(st, e.nid, ValueFact.VOp(addOp(lt, rr.x.ty))))
            .Sub :> plain(lt, addValue(st, e.nid, ValueFact.VOp(PrimOp.Sub)))
            .Mul :> plain(lt, addValue(st, e.nid, ValueFact.VOp(PrimOp.Mul)))
            .Div :> plain(Type.Num, addValue(st, e.nid, ValueFact.VOp(PrimOp.Div)))
            .Mod :> plain(lt, addValue(st, e.nid, ValueFact.VOp(PrimOp.Mod)))
            .Lt :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Lt)))
            .Le :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Le)))
            .Gt :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Gt)))
            .Ge :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Ge)))
            .And :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.And)))
            .Or :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Or)))
            .Pipe :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`|` outside a `rule=` alternation is not in bootstrap slice M2", st)
        }
    }

    fn eqOp(structural: boolean, eq: boolean) -> PrimOp {
        if (structural && eq) return PrimOp.EqStruct
        if (structural) return PrimOp.NeqStruct
        if (eq) return PrimOp.EqPrim
        return PrimOp.NeqPrim
    }

    fn isStrType(t: Type | not) -> boolean {
        if (t is not) return false
        return t == Type.Str
    }

    fn addOp(a: Type | not, b: Type | not) -> PrimOp {
        if (isStrType(a) || isStrType(b)) return PrimOp.Concat
        return PrimOp.Add
    }

    fn resolveTernary(env: Env, e: AExpr, test: AExpr, yes: AExpr, no: AExpr, expected: Type | not, st0: AS) -> RX {
        const rt: RX = plain(Type.Bool, resolveCond(env, test, st0))
        const ry: RX = resolveExpr(withPresent(env, presenceHandle(env, test)), yes, expected, rt.st)
        let want: Type | not = expected
        if (want is not) want = ry.x.ty
        const rn: RX = resolveExpr(env, no, want, ry.st)
        let t: Type | not = ry.x.ty
        if (t is not) t = rn.x.ty
        return plain(t, rn.st)
    }

    // =========================================================================
    // s473 — §23.2 foreign code blocks: the binder's half (SPEC §23.2.4).
    //
    // "A `_{}` foreign code block is valid in EXACTLY THREE forms": (1) the
    // sidecar form, a direct child of a `<program>` (a markup position —
    // parse.scrml skipForeign); (2) "Inline value-returning form — `const x =
    // _={ … }=` (or `let x = …` / `return _={ … }=`) in a server `function`
    // body, with `lang="ts"`/`"js"` only"; (3) "Tool host-I/O form (S238) — a
    // bare non-value-returning `_{}` (as well as the inline value-returning
    // form) in the body of a top-level `function` — including `main` — of a
    // `kind="tool"` program". "A `_{}` block in any OTHER context … SHALL be a
    // compile error (E-FOREIGN-004)" — and dpa-004 C2, quoted there:
    // "host-driving `_{}` is permitted ONLY in server `function` bodies — NOT
    // `fn`/pure helpers, NOT `<cell>` initializers, NOT reactive bindings".
    // The language (§23.2.1, §23.6): the file's `<program lang=>`, or a library
    // file's `<foreign lang=>`; none is E-FOREIGN-003; an inline value-returning
    // block whose language is not ts/js is E-FOREIGN-005.
    // The block's value (§23.2.4a): "The block's OUT value is an UNOWNED foreign
    // value. It is typed `asIs` … by DEFAULT — the compiler does NOT infer the
    // OUT type from the opaque slice" — the resolver gives it no type; the typer
    // gives it VType.Unknown (the bootstrap's untyped value), and a call-site
    // annotation "STATES the intended type and overrides the default".
    // The crossings are reads of the same-named enclosing bindings.
    // =========================================================================

    // Anywhere but the three positions below: a foreign block inside another
    // expression (an operand, an argument, an initializer's part), or one in a
    // position that holds no statement at all.
    fn resolveForeign(env: Env, e: AExpr, f: AForeign, st: AS) -> RX {
        const st1: AS = addDiag(st, env.file, e.span, "E-FOREIGN-004", "a foreign code block is not valid here — its value is bound WHOLE: `const x = _={ … }=`, `let x = _={ … }=` or `return _={ … }=` in a `function` body (§23.2.4). Bind it to a local first, then use the local")
        return plain(not, resolveExprs(env, f.crossings, not, st1))
    }

    // `const x = _={ … }=` / `let x = …` / `return _={ … }=` (bare: false), or
    // a foreign block that is a whole statement (bare: true).
    fn resolveForeignAt(env: Env, e: AExpr, f: AForeign, bare: boolean, st0: AS) -> RX {
        const st: AS = resolveExprs(env, f.crossings, not, st0)
        const tool: boolean = fileIsTool(env.g, env.file)
        if (!env.fx.inFn || env.inEffect) {
            return plain(not, addDiag(st, env.file, e.span, "E-FOREIGN-004", "a foreign code block stands only in a `function` body (§23.2.4: the inline value-returning form is \"in a server `function` body\") — not in a handler, an effect, a cell initializer or a reactive binding. Move the host work into a `function` and call it"))
        }
        if (env.host == HostCtx.HostPure) {
            return plain(not, addDiag(st, env.file, e.span, "E-FOREIGN-004", "a foreign code block in a `fn` body — a `fn` is pure (§48), and host-driving foreign code is permitted \"ONLY in server `function` bodies — NOT `fn`/pure helpers\" (§23.2.4, dpa-004 C2). Declare it `function`"))
        }
        if (bare && !tool) {
            return plain(not, addDiag(st, env.file, e.span, "E-FOREIGN-004", "a bare foreign code block (one whose value is not bound) is valid only in a top-level `function` of a `kind=\"tool\"` program (§23.2.4 form 3, §64). Here bind its value — `const x = _={ … }=` or `return _={ … }=` (§23.2.4a) — or use a `use foreign:` sidecar (§23.4)"))
        }
        const lang: string | not = foreignLangOf(env.g, env.file)
        if (lang is not) {
            return plain(not, addDiag(st, env.file, e.span, "E-FOREIGN-003", "this foreign code block has no language — no `lang=` on the file's `<program>` (§23.2.1), and no `<foreign lang=\"…\">` in a library file (§23.6). Add `lang=\"ts\"` (or `\"js\"`) to the `<program>`"))
        }
        if (lang != "ts" && lang != "js") {
            if (bare) return plain(not, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a `lang=\"" + lang + "\"` foreign block in a tool function — the bootstrap runs only ts/js foreign code in-process"))
            return plain(not, addDiag(st, env.file, e.span, "E-FOREIGN-005", "an inline value-returning foreign block is supported only for `lang=\"ts\"` / `\"js\"`, and this one's language is `" + lang + "` (§23.2.4a: arbitrary-language inline value-flow has no runtime model yet) — use a `use foreign:` sidecar for an out-of-process `" + lang + "` service (§23.4)"))
        }
        // Admitted, checked — and not emitted: the bootstrap has no lowering
        // for the §23.2.3 CG contract (the slice built once as an async
        // function in a SEALED scope of its crossings, called with their
        // values behind a codegen-injected `await`, server-side only), nor the
        // pre-emit checks that ride on it (E-FOREIGN-006 / E-FOREIGN-007).
        // Refused by name, never printed wrong.
        return plain(not, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", foreignEmitMsg()))
    }

    fn foreignEmitMsg() -> string {
        return "a foreign code block — read and checked (§23.2.4), but its emission (a sealed, server-side slice of its `in:{}` crossings, awaited at the boundary, §23.2.3 / §23.2.4a) is not in the bootstrap yet"
    }

    fn foreignOf(e: AExpr) -> AForeign | not {
        const k: AExprK = e.k
        return match k {
            .Foreign(f: f) :> f
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
        }
    }

    // §23.2.1 / §23.6: the language a file's foreign blocks resolve to — its
    // top-level `<program lang=>`, else (a library file) its top-level
    // `<foreign lang=>`. A non-literal `lang=` resolves nothing.
    fn foreignLangOf(g: Globals, file: string) -> string | not {
        for (const fa of g.files) {
            if (fa.path == file) return itemsLang(fa.items)
        }
        return not
    }

    fn itemsLang(items: AItem[]) -> string | not {
        for (const it of items) {
            const p: AProgram | not = programOfItem(it)
            if (p is given) return langAttr(p.attrs)
        }
        for (const it of items) {
            const fe: AElem | not = foreignElemOf(it)
            if (fe is given) return langAttr(fe.attrs)
        }
        return not
    }

    fn quotedAttr(attrs: AAttr[], name: string) -> string | not {
        const a: AAttr | not = attrNamed(attrs, name)
        if (a is not) return not
        return quotedAttrText(a.value)
    }

    // s473-boot-program-attrs-small (S239 review F6): an empty `lang=""` is as
    // if absent (the §40.7 empty-value rule) — so no foreign block sees "".
    fn langAttr(attrs: AAttr[]) -> string | not {
        const v: string | not = quotedAttr(attrs, "lang")
        if (v is given) {
            if (v == "") return not
        }
        return v
    }

    // Is `file`'s top-level `<program>` a `kind="tool"` program (§64)?
    fn fileIsTool(g: Globals, file: string) -> boolean {
        for (const fa of g.files) {
            if (fa.path == file) {
                for (const it of fa.items) {
                    const p: AProgram | not = programOfItem(it)
                    if (p is given) {
                        const k: string | not = quotedAttr(p.attrs, "kind")
                        if (k is given) return k == "tool"
                        return false
                    }
                }
            }
        }
        return false
    }

    fn foreignElemOf(it: AItem) -> AElem | not {
        const k: AItemK = it.k
        return match k {
            .MarkupItem(n: n) :> foreignElemNode(n)
            .ProgramItem(p: x) :> not
            .ImportItem(i: x) :> not
            .TypeItem(t: x) :> not
            .FnItem(f: x) :> not
            .DeclItem(d: x) :> not
            .ConstItem(c: x) :> not
        }
    }

    fn foreignElemNode(n: ANode) -> AElem | not {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> foreignTagged(e)
            .Text(text: t) :> not
            .Interp(e: x) :> not
            .DeclNode(d: x) :> not
            .Effect(w: x) :> not
            .Css(c: x) :> not
            .Gather(f: x) :> not
        }
    }

    fn foreignTagged(e: AElem) -> AElem | not {
        if (e.tag == "foreign") return e
        return not
    }

    // s469 — a logic backtick template (SPEC §14.13.3): "an expression of type
    // `string`". Each slot is resolved as a value with no expected type (a text
    // sink takes any primitive, §14.13.2); the fact records, per slot, whether
    // it is NOT already a `string` — lower converts exactly those to their text
    // (Core Text, §20.7.2). Whether a slot may stand in a text sink at all is
    // the typer's (typeTemplate: E-TEXT-NON-PRIMITIVE, E-OPERAND-NOT-NARROWED).
    fn resolveTemplate(env: Env, e: AExpr, slots: AExpr[], st0: AS) -> RX {
        let st: AS = st0
        let text: boolean[] = []
        for (const s of slots) {
            const r: RX = resolveExpr(env, s, not, st)
            text = text.concat([!isStrType(r.x.ty)])
            st = r.st
        }
        return plain(Type.Str, addValue(st, e.nid, ValueFact.VTemplate(text)))
    }

    fn resolveArray(env: Env, e: AExpr, es: AExpr[], expected: Type | not, st0: AS) -> RX {
        let elem: Type | not = not
        if (expected is given) elem = seqElem(expected)
        const st: AS = resolveExprs(env, es, elem, st0)
        return plain(expected, st)
    }

    // An object literal is a struct VALUE of the type its position expects,
    // constructed by field name (§66.18: never positionally).
    fn resolveObject(env: Env, e: AExpr, ps: AProp[], expected: Type | not, st0: AS) -> RX {
        let st: AS = dupKeys(env, ps, st0)
        const s: Sym | not = namedOf(unMaybe(expectedOr(expected)))
        if (s is not) {
            return diagX(env, e, "E-TYPE-STRUCT-CONTEXT", "an object literal needs a struct type from its position (an annotated declaration or field)", resolvePropValues(env, ps, st))
        }
        const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
        if (ti is not) return diagX(env, e, "E-TYPE-STRUCT-CONTEXT", "`" + s.hint + "` is not a struct type", st)
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return diagX(env, e, "E-TYPE-STRUCT-CONTEXT", "`" + s.hint + "` is not a struct type", st)
        let order: int[] = []
        for (const fd of fs) {
            let at: int = -1
            let j = 0
            for (const p of ps) {
                if (!p.spread && p.name == fd.sym.hint) at = j
                j = j + 1
            }
            if (at < 0) st = addDiag(st, env.file, e.span, "E-TYPE-STRUCT-FIELD", "`" + s.hint + "` value is missing field `" + fd.sym.hint + "`")
            order = order.concat([at])
        }
        let j2 = 0
        for (const p of ps) {
            if (p.spread) {
                st = addDiag(st, env.file, p.span, "E-BOOTSTRAP-UNSUPPORTED", "a spread `...` is in slice M2 only as `@x = { ...@x, f: v }` (a field edit, O58 (b))")
            } else {
                let fty: Type | not = not
                for (const fd of fs) {
                    if (fd.sym.hint == p.name) fty = fd.ty
                }
                if (fty is not) st = addDiag(st, env.file, p.span, "E-TYPE-STRUCT-FIELD", shownStruct(env, s) + " has no field `" + p.name + "`")
                st = resolveExpr(env, p.value, fty, st).st
            }
            j2 = j2 + 1
        }
        return plain(Type.Named(s), addValue(st, e.nid, ValueFact.VStructOf(s, order)))
    }

    // RULED S440 ("duplicate keys are an error in ANY struct literal": "a
    // duplicate key in any struct literal (plain, nested, or the
    // spread-override shape) is a compile error"); SPEC §14.3: "A duplicate
    // key in any struct literal — a plain literal (`@p = { x: 5, x: 6, y: 1,
    // z: 1 }`), a nested one, or the spread-override shape … — is a compile
    // error, **`E-STRUCT-DUPLICATE-KEY`**." One report per repeated key, at
    // the repeat, whatever the literal's type (a nested literal is resolved
    // through here too). The spread-override shape — resolved as field edits,
    // not through here — reports the same code (dupOverride).
    fn dupKeys(env: Env, ps: AProp[], st0: AS) -> AS {
        let st: AS = st0
        let j = 0
        while (j < ps.length) {
            if (!ps[j].spread && keyBefore(ps, j)) st = dupOverride(env, st, ps[j])
            j = j + 1
        }
        return st
    }

    // Is prop `j`'s key named by an earlier (non-spread) prop?
    fn keyBefore(ps: AProp[], j: int) -> boolean {
        let k = 0
        while (k < j) {
            if (!ps[k].spread && ps[k].name == ps[j].name) return true
            k = k + 1
        }
        return false
    }

    fn expectedOr(t: Type | not) -> Type {
        if (t is given) return t
        return Type.Str
    }

    fn resolvePropValues(env: Env, ps: AProp[], st0: AS) -> AS {
        let st: AS = st0
        for (const p of ps) { st = resolveExpr(env, p.value, not, st).st }
        return st
    }

    // =========================================================================
    // Writes — THE EDIT CLASSIFIER (§6.2, §66.11.2).
    // =========================================================================
    // A write target resolved to a PLACE: field `idx` of declaration `decl`
    // through `inst`, then struct steps `path` (a FieldAt when non-empty).
    type WPlace:struct = { decl: DeclInfo, inst: InstRef, idx: int, path: FieldRef[], ty: Type | not, maybe: boolean }
    type RPlace:struct = { place: WPlace | not, local: LocalB | not, st: AS }

    fn noPlace(st: AS) -> RPlace { return { place: not, local: not, st: st } }

    fn resolvePlace(env: Env, t: AExpr, st: AS) -> RPlace {
        const k: AExprK = t.k
        return match k {
            .At(name: n) :> placeAt(env, t, n, st)
            .Member(obj: o, name: n) :> placeMember(env, t, o, n, st)
            .Name(name: n) :> placeName(env, t, n, st)
            .AtItem :> noPlace(addDiag(st, env.file, t.span, "E-WRITE-NOT-GRANTED", "a row value `@.` is a read-only projection of the row"))
            .Num(raw: r) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Str(v: s) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Bool(v: b) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .NotLit :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Recovered :> noPlace(recoveredBackstop(env, t, st))   // s469 r3 F1: the backstop on the place path too
            .Variant(name: n) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Call(callee: c) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Unary(op: o) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Binary(op: o) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Ternary(test: x) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Assign(target: x) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .ArrayLit(elems: es) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .ObjectLit(props: ps) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Spread(e: x) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Index(obj: o) :> noPlace(addDiag(st, env.file, t.span, "E-BOOTSTRAP-UNSUPPORTED", "a write THROUGH a cell's tape position (`@xs[i][j] = v`, `@xs[i].a.b = v`) is not in the bootstrap yet — Core writes a cell tape's position (`@xs[i] = v`, s472) and one field of its element (`@xs[i].f = v`, dpa-052 Q3)"))
            .Lambda(params: ps2) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Sql(q: q) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Handled(h: x) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Template(quasis: qs) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Foreign(f: fb0) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
        }
    }

    // s473 — does `@name` name an INSTANCE here (resolveAt's instance arms)?
    fn namesInstance(env: Env, name: string) -> boolean {
        const nb: NarrowB | not = lookupNarrow(env, name)
        if (nb is given) return true
        const h: HandleInfo | not = lookupHandle(env, name)
        if (h is given) return true
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given) {
            if (!d.isProgram && d.info.sym.hint == name) return true
        }
        const ud: DeclSrc | not = visibleDecl(env, name)
        return ud is given
    }

    fn placeAt(env: Env, t: AExpr, name: string, st: AS) -> RPlace {
        // s444 — O54 (a): `@f` in f's own renders is this instance's field `f`
        const oi: int = ownFieldIndex(env, name)
        if (oi >= 0) {
            const od: DeclSrc | not = ctxDecl(env)
            if (od is given) {
                return { place: { decl: od.info, inst: InstRef.Lexical(0), idx: oi, path: [], ty: od.info.fields[oi].ty, maybe: false },
                         local: not, st: st }
            }
        }
        const pi: DeclInfo | not = programInfo(env)
        if (pi is given && lookupHandle(env, name) is not) {
            const i: int = fieldIndex(pi, name)
            if (i >= 0) {
                return { place: { decl: pi, inst: programInst(env), idx: i, path: [], ty: pi.fields[i].ty, maybe: false },
                         local: not, st: st }
            }
        }
        // s473 (B9) — a name that is no instance in scope (no narrowing, no
        // handle, not the current instance, no visible declaration) is no cell
        // either: §6.1.1 "Bare `@x = expr` writes … without a prior `<x>`
        // declaration in scope are **`E-STATE-UNDECLARED`**" — not a "whole
        // instance" write. (The read side still reports E-SCOPE-001:
        // g-bootstrap-undeclared-cell-read-code-s473.)
        if (!namesInstance(env, name)) return noPlace(addDiag(st, env.file, t.span, "E-STATE-UNDECLARED", "`@" + name + "` is written here, but it is not declared — no cell, declaration or `as=` handle named `" + name + "` is in scope (§6.1.1: a write is not a declaration; declare it, e.g. `let <" + name + ":T=(…)/>`)"))
        return noPlace(addDiag(st, env.file, t.span, "E-BOOTSTRAP-UNSUPPORTED", "`@" + name + " = …` — writing a whole instance is not in bootstrap slice M2 (write a field: `@" + name + ".f = …`)"))
    }

    fn placeName(env: Env, t: AExpr, name: string, st: AS) -> RPlace {
        const l: LocalB | not = lookupLocal(env, name)
        if (l is given) return { place: not, local: l, st: st }
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given && env.inRenders) {
            if (!d.isProgram && fieldIndex(d.info, name) >= 0) {
                return noPlace(addDiag(st, env.file, t.span, "E-DECL-RENDERS-BARE-WRITE", "`" + name + "` inside a `renders` is a read-only projection — write it as `@" + d.info.sym.hint + "." + name + "` (§66.5.2)"))
            }
        }
        // s472: a file-scope constant is not assigned — §50.9: "An assignment to a
        // `const` variable SHALL be a compile error (E-ASSIGN-004), in statement
        // position and in expression position alike." (A function-body `const`
        // takes the bootstrap's older E-ASSIGN-CONST, resolveAssign — not changed here.)
        if (constNamed(env.g, env.file, name) is given) return noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-004", "`" + name + "` is a file-scope `const` — an assignment to a `const` variable is a compile error (§50.9); declare a cell (`<" + name + ":T=…/>`) for a value that changes"))
        return noPlace(addDiag(st, env.file, t.span, "E-SCOPE-001", "`" + name + "` is not a writable local"))
    }

    fn placeMember(env: Env, t: AExpr, obj: AExpr, name: string, st0: AS) -> RPlace {
        // obj names an instance → a field of its declaration
        const ro: RX = resolveHandleSubject(env, obj, st0)
        const st: AS = ro.st
        const inst: InstRef | not = ro.x.inst
        const iDecl: Sym | not = ro.x.iDecl
        if (inst is given && iDecl is given) {
            const d: DeclSrc | not = findDeclSrc(env.g, iDecl)
            if (d is not) return noPlace(st)
            const i: int = fieldIndex(d.info, name)
            if (i < 0 && isSurfaceProp(name) && !d.isProgram) return noPlace(addDiag(st, env.file, t.span, "E-SYNTHESIZED-WRITE", "`@" + d.info.sym.hint + "." + name + "` is a synthesized validity property — read-only (§55.5, §55.7)"))
            if (i < 0) return noPlace(addDiag(st, env.file, t.span, "E-SCOPE-001", "`<" + d.info.sym.hint + ">` has no field `" + name + "`"))
            return { place: { decl: d.info, inst: inst, idx: i, path: [], ty: d.info.fields[i].ty, maybe: ro.x.maybe },
                     local: not, st: st }
        }
        // obj is itself a place of struct type → a FieldAt step
        const rp: RPlace = resolvePlace(env, obj, st0)
        const base: WPlace | not = rp.place
        if (base is not) return rp
        // s449 — a field's surface property is read-only too (§55.5.1 rule 7, §55.7)
        if (isSurfaceProp(name) && base.path.length == 0) {
            const isProg: boolean = base.decl.sym.id == env.g.program.id
            if (!isProg || base.decl.fields[base.idx].vals.length > 0) {
                return noPlace(addDiag(rp.st, env.file, t.span, "E-SYNTHESIZED-WRITE", "`" + exprLabel(obj) + "." + name + "` is a synthesized validity property — read-only (§55.5.1 rule 7, §55.7)"))
            }
        }
        const bt: Type | not = base.ty
        if (bt is given) {
            const s: Sym | not = namedOf(bt)
            if (s is given) {
                const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
                if (ti is given) {
                    const fs: FieldDef[] | not = structFieldDefs(ti.def)
                    if (fs is given) {
                        let i = 0
                        for (const fd of fs) {
                            if (fd.sym.hint == name) {
                                const p: WPlace = { decl: base.decl, inst: base.inst, idx: base.idx,
                                                    path: base.path.concat([{ owner: s, idx: i }]), ty: fd.ty, maybe: base.maybe }
                                return { place: p, local: not, st: rp.st }
                            }
                            i = i + 1
                        }
                    }
                }
            }
        }
        return noPlace(addDiag(rp.st, env.file, t.span, "E-ASSIGN-TARGET", "`." + name + "` is not a field of a struct here"))
    }

    // The FieldDef a FieldAt path ends at.
    fn pathTarget(env: Env, p: WPlace) -> FieldDef | not {
        let target: FieldDef | not = not
        for (const step of p.path) {
            const ti: TypeInfo | not = typeInfoOf(env.g.types, step.owner)
            if (ti is not) return not
            const fs: FieldDef[] | not = structFieldDefs(ti.def)
            if (fs is not) return not
            if (step.idx < 0 || step.idx >= fs.length) return not
            target = fs[step.idx]
        }
        return target
    }

    fn derivedMessage(p: WPlace, f: FieldInfo) -> string {
        const deps: string = f.reads.join(", ")
        // s469 review r2: `let` on a sequence is E-GRANT-LET-ON-SEQUENCE — a tape is never seeded by `let`
        if (seqElem(unMaybe(f.ty)) is given) return "Assignment to derived value `@" + f.sym.hint + "`. `" + f.sym.hint + "` is derived (a locked declaration whose initializer reads " + deps + ") — it recomputes and cannot be written. To change it, write one of its dependencies. A sequence is not made writable by `let` (`let` on a sequence is E-GRANT-LET-ON-SEQUENCE): its grants live on the type (`T[replace]`, §66.12.2, §66.12.3)."
        return "Assignment to derived value `@" + f.sym.hint + "`. `" + f.sym.hint + "` is derived (a locked declaration whose initializer reads " + deps + ") — it recomputes and cannot be written. To change it, write one of its dependencies. If you want a value that STARTS from that expression and is then written independently, declare it `let` — it becomes SEEDED: computed once, and it no longer follows " + deps + " (§66.9)."
    }

    // L8: a transition is Static only when Core can prove the edge — a literal
    // every state may move to; otherwise the edge is checked at runtime.
    // A literal target no state can EVER legally reach (no incoming edge, and
    // not the field's initial state) is refused here (E-ENGINE-INVALID-TRANSITION).
    type RCheck:struct = { check: Check, st: AS }

    fn transitionCheck(env: Env, g: TransitionGraph, value: AExpr, initial: int, st: AS) -> RCheck {
        const k: AExprK = value.k
        const lit: string = variantLitName(k)
        if (lit == "") return { check: Check.RuntimeEdge, st: st }
        const to: int = variantIndex(env.g.types, g.enumSym, lit)
        if (to < 0) return { check: Check.RuntimeEdge, st: st }
        let incoming = false
        for (const e of g.edges) {
            if (e.origin != to && e.targets.indexOf(to) >= 0) incoming = true
        }
        if (!incoming && to != initial) {
            const st2: AS = addDiag(st, env.file, value.span, "E-ENGINE-INVALID-TRANSITION", "`." + lit + "` has no incoming edge in the `rule=` graph and is not the initial state — no write can reach it (§66.13.2)")
            return { check: Check.RuntimeEdge, st: st2 }
        }
        return { check: Check.RuntimeEdge, st: st }
    }

    fn variantLitName(k: AExprK) -> string {
        return match k {
            .Variant(name: n) :> n
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // The initial variant of a graph field (its own value), for the reachability rule.
    fn initialVariant(env: Env, g: TransitionGraph, init: AAttrValue) -> int {
        return match init {
            .Bare(e: e) :> initialOf(env, g, e)
            .Paren(e: e) :> initialOf(env, g, e)
            .NoValue :> -1
            .Quoted(v: s) :> -1
            .Braced(b: b) :> -1
        }
    }

    fn initialOf(env: Env, g: TransitionGraph, e: AExpr) -> int {
        const k: AExprK = e.k
        const n: string = variantLitName(k)
        if (n == "") return -1
        return variantIndex(env.g.types, g.enumSym, n)
    }

    // The checks every write shares: the handle is narrowed (§66.7.5), the field
    // is writable from this file (E2, §66.14).
    fn writeGuards(env: Env, p: WPlace, span: ASpan, st0: AS) -> AS {
        let st: AS = st0
        if (p.maybe) {
            st = addDiag(st, env.file, span, "E-DECL-HANDLE-NOT-NARROWED", "this handle names a conditionally-mounted instance (`" + p.decl.sym.hint + " | not`) — narrow it first: `given c = @handle :> { c.field = … }` (§66.7.5)")
        }
        const f: FieldInfo = p.decl.fields[p.idx]
        if (p.decl.file != env.file && !f.exported) {
            st = addDiag(st, env.file, span, "E-FIELD-PRIVATE-WRITE", "`" + f.sym.hint + "` of `<" + p.decl.sym.hint + ">` is not exported — it is writable only inside its defining file (§66.14)")
        }
        return dbCellWriteGuard(env, p, f, span, st)
    }

    // =========================================================================
    // s473 (Lane B) — THE DB CELL'S WRITE RULE. RULED S472 ("`<db>` body + client
    // reads", item 5): "Only code inside the block writes; locked cells are
    // read-only on the client; `let` stays local." SPEC §8.1.3 items 5–6. Judged
    // here, at the one guard every write place passes (writeGuards — an
    // assignment, an edit call, a removal, an element / position write, a
    // `bind:`, a `reset`):
    //   - a LOCKED db cell — one with no `replace` grant (§66.9 rule 1) — is never
    //     written on the client, whatever other grant its type carries
    //     (E-WRITE-NOT-GRANTED; a locked cell whose type grants nothing is already
    //     refused by its contract, so it is not reported twice);
    //   - a writable db cell (`let`, or a tape whose type grants `replace`) is
    //     written only by code INSIDE its `<db>` element — lexically: a function
    //     declared in the `<db>` body, or a handler in its markup — else
    //     E-DB-CELL-WRITE-OUTSIDE-BLOCK. The write lands locally (no server write).
    // =========================================================================
    fn dbCellWriteGuard(env: Env, p: WPlace, f: FieldInfo, span: ASpan, st: AS) -> AS {
        if (p.decl.sym.id != env.g.program.id) return st
        const c: ADbFn | not = dbCellRecord(env.g, f.nid)
        if (c is not) return st
        // LOCKED = no `replace` grant (§66.9 rule 1) — `let` on a scalar, `[replace]` in a
        // sequence type's grants (O3: the sequence spelling of `let`). A locked db cell's
        // other grants (a tape's `append`, a lifecycle) do not apply on the client.
        if (!grantsAdmit(f.grants, EditKind.Replace)) {
            if (!grantsAny(f.grants)) return st
            return addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "` is a locked `<db>` cell (no `replace` grant) — read-only on the client, whatever else its type grants (S472 ruling item 5, §8.1.3): its value is the server's, loaded per request. Make it writable — `let` on a scalar, `replace` in a tape type's grants — and write it only from code inside its `<db>` (the write lands locally), or change the data on the server with a function and load the page again")
        }
        if (dbFileOf(env.g, c) == env.file && span.start >= c.start && span.end <= c.end) return st
        return addDiag(st, env.file, span, "E-DB-CELL-WRITE-OUTSIDE-BLOCK", "`@" + f.sym.hint + "` is declared in a `<db>` body, and only code inside that `<db>` writes it (S472 ruling item 5, §8.1.3: the block owns its cells). Move this write into a function declared in that `<db>` body and call the function from here")
    }

    // s473 — the FileAst.dbFns record of the db cell whose declaration is `declNid` (`not`: not a db cell).
    fn dbCellRecord(g: Globals, declNid: int) -> ADbFn | not {
        for (const fa of g.files) {
            for (const o of fa.dbFns) { if (o.cell >= 0 && o.cell == declNid) return o }
        }
        return not
    }

    // s473 — the file whose `<db>` the record `c` was read in.
    fn dbFileOf(g: Globals, c: ADbFn) -> string {
        for (const fa of g.files) {
            for (const o of fa.dbFns) { if (o.fn == c.fn) return fa.path }
        }
        return ""
    }

    // s473 — the cell declaration nid of the load function `fnNid` (-1: not a load).
    fn loadCellNid(g: Globals, fnNid: int) -> int {
        for (const fa of g.files) {
            for (const o of fa.dbFns) { if (o.cell >= 0 && o.fn == fnNid) return o.cell }
        }
        return -1
    }

    // s473 — is `nid` a db cell's LOAD function (parse readDbCell)?
    fn isDbLoad(g: Globals, nid: int) -> boolean {
        for (const fa of g.files) {
            for (const o of fa.dbFns) { if (o.cell >= 0 && o.fn == nid) return true }
        }
        return false
    }

    // s473 — is `@name` a program field declared in a `<db>` body?
    fn isDbCellName(g: Globals, name: string) -> boolean {
        const d: DeclSrc | not = findDeclSrc(g, g.program)
        if (d is not) return false
        for (const f of d.info.fields) {
            if (f.sym.hint == name && dbCellRecord(g, f.nid) is given) return true
        }
        return false
    }

    // =========================================================================
    // s473 — EXECUTABLE SINKS IN PLAIN LOGIC (s473-boot-plain-logic-dom-sinks).
    // SPEC §5.2 "Executable sinks in plain logic (S473)" — ruling:user-voice-scrml.md
    // S473 "⭐ RULED — S473 PA recs: host allowlist Q1–Q4, plain-logic DOM sinks,
    // impl#1 transport routing" item 2: "Plain client logic: data written to a known
    // executable sink is a compile ERROR … The set is `innerHTML`, `outerHTML`,
    // `insertAdjacentHTML`, `srcdoc`, `on*` properties and attributes,
    // `document.write`/`writeln`, and `eval`/`Function`/string
    // `setTimeout`/`setInterval`. Every other DOM member stays open" — and the S473
    // PA ruling on the #1663 review (setHTMLUnsafe, createContextualFragment,
    // parseFromString, execCommand insertHTML, an unjudged navigation).
    //
    // The table is url.scrml's (logicWriteSink / logicCallSink — ONE table). The
    // judgment runs on the typer's own path, FIRST in resolveAssign / resolveCallStmt
    // / resolveCallOrConstruct (and resolveName / resolveMember for a bare `eval` /
    // `Function` value), so it holds whatever else the bootstrap does or does not
    // yet support at that site; a refused site gets this one report (no cascade).
    //
    // TWO halves (the #1663 review F1 / F5):
    //   - BY NAME, on any value: `innerHTML` / `outerHTML` (unless a quoted string
    //     literal) and `srcdoc` — a scrml struct field of that name included;
    //   - BY TYPE, fail closed: what a name does not settle — a computed key, the
    //     keys `Object.assign` copies from a non-literal source, an `on…` member,
    //     a navigation — is admitted only on a value whose STATIC TYPE is a scrml
    //     type the typer knows (sinkScrmlTyped: a cell, a typed local, a field or
    //     element of one). A host root, a local initialized from one, an
    //     unannotated parameter, anything the typer cannot type, is refused.
    // Client logic only (§5.2): a server function (env.fx.serverOwn) has no DOM —
    // except `eval` / `Function`, refused everywhere.
    // "" — not a sink; otherwise the reason, for the message.
    // =========================================================================
    type SinkView:struct = { kind: int, name: string, obj: AExpr | not, idx: AExpr | not, elems: AExpr[], props: AProp[] }
    // kind: 0 other · 1 Name · 2 Member · 3 Index · 4 Str · 5 ArrayLit · 6 ObjectLit · 7 Lambda · 8 Spread
    //       · 9 Call · 10 At · 11 an operator form (ternary, `&&` / `||`, unary, assignment, handled)
    //       · 12 a parse-error placeholder (the parser reported it)

    fn sinkV(kind: int, name: string, obj: AExpr | not, idx: AExpr | not) -> SinkView {
        return { kind: kind, name: name, obj: obj, idx: idx, elems: [], props: [] }
    }

    fn sinkElems(es: AExpr[]) -> SinkView {
        return { kind: 5, name: "", obj: not, idx: not, elems: es, props: [] }
    }

    fn sinkProps(ps: AProp[]) -> SinkView {
        return { kind: 6, name: "", obj: not, idx: not, elems: [], props: ps }
    }

    fn sinkView(e: AExpr) -> SinkView {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> sinkV(1, n, not, not)
            .Member(obj: o, name: n) :> sinkV(2, n, o, not)
            .Index(obj: o, idx: ix) :> sinkV(3, "", o, ix)
            .Str(v: s) :> sinkV(4, s, not, not)
            .ArrayLit(elems: es) :> sinkElems(es)
            .ObjectLit(props: ps) :> sinkProps(ps)
            .Lambda(params: lp) :> sinkV(7, "", not, not)
            .Spread(e: x) :> sinkV(8, "", x, not)
            .Call(callee: c) :> sinkV(9, "", c, not)
            .At(name: n) :> sinkV(10, n, not, not)
            .Ternary(test: t) :> sinkV(11, "", not, not)
            .Binary(op: o) :> sinkV(11, "", not, not)
            .Unary(op: o) :> sinkV(11, "", not, not)
            .Assign(target: t) :> sinkV(11, "", not, not)
            .Handled(h: x) :> sinkV(11, "", not, not)
            .AtItem :> sinkV(0, "", not, not)
            .Num(raw: r) :> sinkV(0, "", not, not)
            .Bool(v: b) :> sinkV(0, "", not, not)
            .NotLit :> sinkV(0, "", not, not)
            .Recovered :> sinkV(12, "", not, not)
            .Variant(name: n) :> sinkV(0, "", not, not)
            .Sql(q: q) :> sinkV(0, "", not, not)
            .Template(quasis: qs) :> sinkV(0, "", not, not)
            .Foreign(f: fb0) :> sinkV(0, "", not, not)
        }
    }

    // A value that is the author's own text: a quoted string literal (§5.2 S473's
    // "static" — "a value is *static* only when it is a quoted string literal").
    fn sinkStatic(v: AExpr | not) -> boolean {
        if (v is not) return false
        return sinkView(v).kind == 4
    }

    fn sinkUnMaybe(t: Type) -> Type {
        return match t {
            .Maybe(inner: i) :> sinkUnMaybe(i)
            .Int :> t
            .Num :> t
            .Str :> t
            .Bool :> t
            .Named(sym: s) :> t
            .Seq(elem: el) :> t
        }
    }

    fn sinkSeqElem(t: Type) -> Type | not {
        return match t {
            .Seq(elem: el) :> el
            .Maybe(inner: i) :> sinkSeqElem(i)
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Named(sym: s) :> not
        }
    }

    // A type the typer knows as a scrml type: a primitive, a tape or `T | not` of
    // one, or a named type declared in the program (never a host type).
    fn sinkKnown(env: Env, t: Type) -> boolean {
        return match t {
            .Named(sym: s) :> sinkKnownNamed(env, s)
            .Seq(elem: el) :> sinkKnown(env, el)
            .Maybe(inner: i) :> sinkKnown(env, i)
            .Int :> true
            .Num :> true
            .Str :> true
            .Bool :> true
        }
    }

    // s473-host-allowlist-b: a HOST type — a user `:host` handle or a built-in Appendix H
    // interface (`HTMLElement`, `Event`, …) — is NOT a scrml type for the sink judgment:
    // its values are host objects (invariant (1) below), so a computed key on one stays
    // refused (fail closed), as it was while such a type was unknown.
    fn sinkKnownNamed(env: Env, s: Sym) -> boolean {
        const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
        if (ti is not) return false
        return !isHostDef(ti.def)
    }

    // INVARIANT (the #1663 reviews, F1 / N3) — the by-type half is sound only while
    // BOTH hold: (1) a host value's type is never a `core.scrml` `Type` that
    // sinkKnown accepts; (2) a host value never BINDS to a scrml-typed place — a
    // local or parameter annotated with a scrml type, a cell, a tape element — the
    // annotation refusing it rather than casting it. Today (2) holds because every
    // host root is E-SCOPE-001, `ref=` is E-BOOTSTRAP-UNSUPPORTED and a foreign
    // block is server-placed, so `const w: W = document.body` is already refused;
    // a host-value lowering MUST keep it (g-spec-plain-logic-dom-sinks-unlinted).
    // The static type of a receiver, as far as the sink judgment trusts one: a
    // cell (`@x`, the program's or this instance's own field), a local, and a
    // field or tape element of one. Anything else is `not` (fail closed).
    fn sinkTypeOf(env: Env, e: AExpr) -> Type | not {
        const v: SinkView = sinkView(e)
        if (v.kind == 1) {
            const l: LocalB | not = lookupLocal(env, v.name)
            if (l is given) return l.ty
            return not
        }
        if (v.kind == 10) {
            const oi: int = ownFieldIndex(env, v.name)
            if (oi >= 0) {
                const od: DeclSrc | not = ctxDecl(env)
                if (od is given) return od.info.fields[oi].ty
            }
            const pi: DeclInfo | not = programInfo(env)
            if (pi is given && lookupHandle(env, v.name) is not) {
                const i: int = fieldIndex(pi, v.name)
                if (i >= 0) return pi.fields[i].ty
            }
            return not
        }
        const o: AExpr | not = v.obj
        if (o is not) return not
        const ot: Type | not = sinkTypeOf(env, o)
        if (ot is not) return not
        if (v.kind == 2) {
            const fs: FieldDef[] | not = structFieldsOfType(env, sinkUnMaybe(ot))
            if (fs is not) return not
            for (const f of fs) {
                if (f.sym.hint == v.name) return f.ty
            }
            return not
        }
        if (v.kind == 3) return sinkSeqElem(ot)
        return not
    }

    // A `const` initialized with an object / array literal is a fresh scrml value.
    fn sinkFreshInit(init: AExpr) -> boolean {
        const k: int = sinkView(init).kind
        return k == 5 || k == 6
    }

    fn sinkScrmlTyped(env: Env, e: AExpr) -> boolean {
        const v0: SinkView = sinkView(e)
        if (v0.kind == 1) {
            const l0: LocalB | not = lookupLocal(env, v0.name)
            if (l0 is given) {
                if (l0.fresh) return true
            }
        }
        const t: Type | not = sinkTypeOf(env, e)
        if (t is not) return false
        return sinkKnown(env, t)
    }

    // Does the receiver's scrml STRUCT type declare a field `name`? Then `x.name`
    // is that field, never a DOM handler (the #1663 review F5).
    fn sinkStructField(env: Env, recv: AExpr, name: string) -> boolean {
        const t: Type | not = sinkTypeOf(env, recv)
        if (t is not) return false
        const fs: FieldDef[] | not = structFieldsOfType(env, sinkUnMaybe(t))
        if (fs is not) return false
        for (const f of fs) {
            if (f.sym.hint == name) return true
        }
        return false
    }

    // A navigation's URL (§5.2 rule 3's scheme guard, url.scrml urlValueAdmitted):
    // a static URL is judged now; a data URL is judged by nothing on this path.
    fn sinkNavWhy(what: string, value: AExpr | not) -> string {
        if (value is given) {
            const v: SinkView = sinkView(value)
            if (v.kind == 4) {
                if (urlValueAdmitted("href", v.name)) return ""
                return "navigates (" + what + ") to a URL whose scheme (`" + schemeOfUrl(v.name) + ":`) §5.2 rule 3 does not admit — `javascript:` and its kin run code scrml never checked"
            }
        }
        return "navigates (" + what + ") to a URL from data, and no §5.2 rule 3 scheme guard judges a navigation written in logic yet — data could navigate to `javascript:` (a static `http(s):` / relative URL is admitted)"
    }

    // A write of member `name` on `recv` (`not` — the receiver is not an expression
    // here) with `value` (`not` — a destructured value: data).
    fn sinkWriteWhy(env: Env, recv: AExpr | not, name: string, value: AExpr | not) -> string {
        const kind: string = logicWriteSink(name)
        if (kind == "html" && !sinkStatic(value)) return "writes `" + name + "` from data — HTML parsed from data can carry script"
        if (kind == "exec") return "writes `" + name + "` — an inline HTML document the browser runs, script included (a static `srcdoc` is refused too, §5.2 S464)"
        if (kind == "on") {
            if (recv is given) {
                if (sinkStructField(env, recv, name)) return ""
            }
            return "writes the event-handler member `" + name + "` — handlers are scrml logic, written as `" + name + "=fn()` on the element, never a value written into the page (§5.2 S464)"
        }
        if (kind == "nav") {
            if (recv is given) {
                if (sinkScrmlTyped(env, recv)) return ""
            }
            return sinkNavWhy("`" + name + "`", value)
        }
        return ""
    }

    // The member names along an expression, through calls: `a.b().c[k]` →
    // [a, b, c, [computed]]. A root that is not a name is "" (`@x` is "@").
    fn deepChain(e: AExpr) -> string[] {
        const v: SinkView = sinkView(e)
        if (v.kind == 1) return [v.name]
        if (v.kind == 10) return ["@"]
        const o: AExpr | not = v.obj
        if (o is not) return [""]
        if (v.kind == 2) return deepChain(o).concat([v.name])
        if (v.kind == 9) return deepChain(o)
        if (v.kind == 3) {
            const ix: AExpr | not = v.idx
            if (ix is given) {
                const iv: SinkView = sinkView(ix)
                if (iv.kind == 4) return deepChain(o).concat([iv.name])
            }
            return deepChain(o).concat(["[computed]"])
        }
        return [""]
    }

    // A key that is a number — a numeric literal, or a value whose static type is
    // `int` / `number` — never names a member (`xs[i] = v`): not a computed sink key.
    // `-` `*` `/` `%` always yield a number in JavaScript (never a member name);
    // `+` does when both operands are numeric keys.
    fn sinkNumericOp(env: Env, o: BinOp, l: AExpr, r: AExpr) -> boolean {
        if (o == BinOp.Sub || o == BinOp.Mul || o == BinOp.Div || o == BinOp.Mod) return true
        if (o == BinOp.Add) return sinkNumericKey(env, l) && sinkNumericKey(env, r)
        return false
    }

    fn sinkNumericKey(env: Env, k: AExpr) -> boolean {
        const k0: AExprK = k.k
        const isNum: boolean = match k0 {
            .Num(raw: r) :> true
            .Binary(op: o, l: bl, r: br) :> sinkNumericOp(env, o, bl, br)
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Str(v: x) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
        if (isNum) return true
        const t: Type | not = sinkTypeOf(env, k)
        if (t is not) return false
        return t == Type.Int || t == Type.Num
    }

    // An assignment target (an element of a destructuring target included).
    fn sinkTargetWhy(env: Env, t: AExpr, value: AExpr | not) -> string {
        const v: SinkView = sinkView(t)
        if (v.kind == 1) {
            if (v.name == "location" && lookupLocal(env, v.name) is not) return sinkNavWhy("`location`", value)
            return ""
        }
        if (v.kind == 2) {
            const o: AExpr | not = v.obj
            if (o is given) {
                if (attrNodeValueMember(v.name)) {
                    for (const s of deepChain(o)) {
                        if (attrNodeMember(s)) return "writes `" + v.name + "` of an attribute node reached through `" + s + "` — the attribute could be `srcdoc` or an `on…` handler, so it is refused (fail closed); write the attribute with `setAttribute(\"name\", …)`"
                    }
                }
            }
            return sinkWriteWhy(env, o, v.name, value)
        }
        if (v.kind == 3) {
            const ix: AExpr | not = v.idx
            const o2: AExpr | not = v.obj
            if (ix is given && o2 is given) {
                const iv: SinkView = sinkView(ix)
                if (iv.kind == 4) return sinkWriteWhy(env, o2, iv.name, value)
                if (!sinkNumericKey(env, ix) && !sinkScrmlTyped(env, o2)) return "writes a member by a computed key on a value whose type is not a scrml type — the key could name `innerHTML`, `srcdoc` or an `on…` handler, so it is refused (fail closed)"
            }
            return ""
        }
        if (v.kind == 5) {
            for (const x of v.elems) {
                const w: string = sinkTargetWhy(env, x, not)
                if (w != "") return w
            }
            return ""
        }
        if (v.kind == 6) {
            for (const p of v.props) {
                const w2: string = sinkTargetWhy(env, p.value, not)
                if (w2 != "") return w2
            }
            return ""
        }
        if (v.kind == 8) {
            const inner: AExpr | not = v.obj
            if (inner is given) return sinkTargetWhy(env, inner, not)
        }
        return ""
    }

    // The member names of a callee chain, root first: `window.document.write` →
    // [window, document, write]; `eval.call` → [eval, call]. A root that is not a
    // name (`@el`, a call, a literal) is the placeholder "" — so `@el.setAttribute`
    // is [ "", setAttribute ], a receiver like any other.
    fn calleeChain(c: AExpr) -> string[] {
        const v: SinkView = sinkView(c)
        if (v.kind == 1) return [v.name]
        if (v.kind == 2) {
            const o: AExpr | not = v.obj
            if (o is given) return calleeChain(o).concat([v.name])
            return [v.name]
        }
        if (v.kind == 3) {
            const o2: AExpr | not = v.obj
            const ix: AExpr | not = v.idx
            if (o2 is given && ix is given) {
                const iv: SinkView = sinkView(ix)
                if (iv.kind == 4) return calleeChain(o2).concat([iv.name])
                return calleeChain(o2).concat(["[computed]"])
            }
        }
        return [""]
    }

    // Does `ch` name `what` before position `upto`?
    fn sinkChainHas(ch: string[], upto: int, what: string) -> boolean {
        let i = 0
        while (i < upto && i < ch.length) {
            if (ch[i] == what) return true
            i = i + 1
        }
        return false
    }

    // Is segment `i` of `ch` (`open`) a window's / document's `open`: a bare
    // `open` (no local or declared function shadows it), or one on a receiver
    // that names a window or a document? (`indexedDB.open(name)` is not.)
    fn sinkWindowish(ch: string[], i: int, env: Env) -> boolean {
        if (i == 0) return lookupLocal(env, ch[0]) is not && fnNamed(env.g, env.file, ch[0]) is not
        const r: string = ch[i - 1]
        return r == "window" || r == "globalThis" || r == "self" || r == "top" || r == "parent" || r == "opener"
            || r == "frames" || r == "document" || r == "contentWindow" || r == "defaultView" || r == "ownerDocument"
            || r == "contentDocument" || r == "[computed]"
    }

    // N1 (#1663 re-review): does `e` yield an Attr node (or a collection of them) —
    // a chain through `attributes` / `getNamedItem` / `getAttributeNode` that ends
    // there or in an element access (`[i]`, `.item(i)`), not in a scalar member
    // (`.length`, `.value`, `.name`, …)? Bound to a local, a loop variable or an
    // argument, it would leave the chain the write judgment reads (fail closed).
    fn sinkYieldsAttr(e: AExpr) -> boolean {
        const ch: string[] = deepChain(e)
        let j: int = -1
        let i = 0
        while (i < ch.length) {
            if (attrNodeMember(ch[i])) j = i
            i = i + 1
        }
        if (j < 0) return false
        let k: int = j + 1
        while (k < ch.length) {
            const r: string = ch[k]
            if (r == "length" || r == "name" || r == "localName" || r == "namespaceURI" || r == "prefix" || r == "specified" || attrNodeValueMember(r)) return false
            k = k + 1
        }
        return true
    }

    fn sinkAttrBindWhy(what: string) -> string {
        return "binds an attribute node (reached through `attributes`, `getNamedItem` or `getAttributeNode`) to " + what + " — a later `.value` write there could set `srcdoc` or an `on…` handler unseen, so it is refused (fail closed); write the attribute with `setAttribute(\"name\", …)`"
    }

    fn sinkArg(args: AExpr[], i: int) -> AExpr | not {
        if (i < 0 || i >= args.length) return not
        return args[i]
    }

    // A reference to `eval` / `Function` as a VALUE: the bare name (no local
    // shadows it), or a member `.eval` / `.Function` / `.constructor`.
    fn sinkExecRef(env: Env, a: AExpr) -> string {
        const v: SinkView = sinkView(a)
        if (v.kind == 1 && (v.name == "eval" || v.name == "Function") && lookupLocal(env, v.name) is not) return v.name
        if (v.kind == 2 && logicCallSink(v.name) == "exec") return v.name
        return ""
    }

    // A timer's first argument is a function: an arrow, or a name of a declared
    // function (no local shadows it). Anything else is source text (fail closed).
    fn sinkIsFunction(env: Env, a: AExpr | not) -> boolean {
        if (a is not) return true
        const v: SinkView = sinkView(a)
        if (v.kind == 7) return true
        if (v.kind == 12) return true      // a parse-error placeholder (a braced arrow): the parser reported it
        if (v.kind == 1) return lookupLocal(env, v.name) is not && fnNamed(env.g, env.file, v.name) is given
        return false
    }

    // An object literal's keys written onto `target` (`Object.assign`'s sources,
    // `Object.defineProperties`' map). `typed`: the target is a fresh object
    // literal or a value of a scrml type (sinkScrmlTyped).
    fn sinkPropsWhy(env: Env, target: AExpr, props: AProp[], typed: boolean, described: boolean) -> string {
        for (const p of props) {
            if (p.spread) {
                if (!typed) return "copies the keys of a spread `...` onto a value whose type is not a scrml type — a key could name a sink, so it is refused (fail closed)"
            } else {
                let val: AExpr | not = p.value
                if (described) val = not
                const w: string = sinkWriteWhy(env, target, p.name, val)
                if (w != "") return w
            }
        }
        return ""
    }

    // A computed key on a callee chain (`o[k](…)`, `o[k].call(…)`) is judged at its
    // own receiver: admitted when the key is a number or the receiver is of a scrml
    // type (`@xs[i].trim()`); otherwise it could name `eval` / `insertAdjacentHTML`.
    fn sinkComputedCalleeWhy(env: Env, c: AExpr) -> string {
        const v: SinkView = sinkView(c)
        const o: AExpr | not = v.obj
        if (o is not) return ""
        if (v.kind == 3) {
            const ix: AExpr | not = v.idx
            if (ix is given) {
                if (sinkView(ix).kind != 4 && !sinkNumericKey(env, ix) && !sinkScrmlTyped(env, o)) return "calls a member reached by a computed key on a value whose type is not a scrml type — the key could name `eval`, `insertAdjacentHTML` or `setAttribute`, so it is refused (fail closed)"
            }
            return sinkComputedCalleeWhy(env, o)
        }
        if (v.kind == 2) return sinkComputedCalleeWhy(env, o)
        return ""
    }

    fn sinkCallWhy(env: Env, callee: AExpr, args: AExpr[]) -> string {
        const cv: SinkView = sinkView(callee)
        // the #1663 review F3: a callee that is not a name / member / index chain
        // (`(c ? eval : f)(s)`, `(a && eval)(s)`, `f()(s)`, an arrow) could be `eval`
        if (cv.kind == 11 || cv.kind == 9 || cv.kind == 7) return "calls a value that is not a name or member chain — it could be `eval` or `Function`, so it is refused (fail closed)"
        for (const a of args) {
            const r: string = sinkExecRef(env, a)
            if (r != "") return "passes `" + r + "` as a value — a function that runs source text, refused wherever it is called (`Reflect.apply`, `.map`, a timer)"
            if (!env.fx.serverOwn && sinkYieldsAttr(a)) return sinkAttrBindWhy("an argument")
        }
        const ch: string[] = calleeChain(callee)
        const last: int = ch.length - 1
        const server: boolean = env.fx.serverOwn
        if (!server) {
            const cw: string = sinkComputedCalleeWhy(env, callee)
            if (cw != "") return cw
        }
        let i = 0
        while (i < ch.length) {
            const s: string = ch[i]
            const kind: string = logicCallSink(s)
            const isLast: boolean = i == last
            if (kind == "exec" && (i > 0 || lookupLocal(env, s) is not)) return "calls `" + s + "` — it runs source text as JavaScript, a literal included; scrml never builds or runs code from a string"
            if (!server) {
                if (kind == "html" && i > 0) {
                    if (!isLast) return "reaches `" + s + "` through `." + ch[last] + "` — an alias of an HTML sink is refused (fail closed)"
                    const hx: int = htmlArgIndex(s)
                    if (hx == -2) {
                        for (const a2 of args) {
                            if (!sinkStatic(a2)) return "calls `" + s + "` with data — HTML parsed from data can carry script (any receiver: a Document is reached as `document`, `ownerDocument`, `contentDocument`, `open()`, …)"
                        }
                    } else if (!sinkStatic(sinkArg(args, hx))) {
                        return "calls `" + s + "` with data — HTML parsed from data can carry script"
                    }
                }
                if (kind == "execcmd" && i > 0) {
                    if (!isLast) return "reaches `" + s + "` through `." + ch[last] + "` — an alias of `execCommand` is refused (fail closed)"
                    const cmd: AExpr | not = sinkArg(args, 0)
                    if (cmd is given) {
                        const cmv: SinkView = sinkView(cmd)
                        if (cmv.kind != 4) return "calls `execCommand` with a computed command — it could be `insertHTML`, so it is refused (fail closed)"
                        if (cmv.name.toLowerCase() == "inserthtml" && !sinkStatic(sinkArg(args, 2))) return "calls `execCommand(\"insertHTML\", …)` with data — HTML parsed from data can carry script"
                    }
                }
                if (kind == "timer") {
                    if (!isLast) return "reaches `" + s + "` through `." + ch[last] + "` — a timer reached by an alias may be handed source text (fail closed)"
                    if (!sinkIsFunction(env, sinkArg(args, 0))) return "calls `" + s + "` with a first argument that is not a function — a string there is run as JavaScript. Pass a function: `" + s + "(tick, ms)` or `" + s + "(() => tick(), ms)`"
                }
                if (kind == "attr" && i > 0) {
                    if (!isLast) return "reaches `" + s + "` through `." + ch[last] + "` — an alias of an attribute writer is refused (fail closed)"
                    const na: AExpr | not = sinkArg(args, attrNameArgIndex(s))
                    if (na is given) {
                        const nv: SinkView = sinkView(na)
                        if (nv.kind != 4) return "calls `" + s + "` with a computed attribute name — it could name `srcdoc` or an `on…` handler, so it is refused (fail closed); write the name as a string literal"
                        if (executableAttrName(nv.name)) return "calls `" + s + "` on the attribute `" + nv.name + "` — an inline document or handler text the browser runs (§5.2 S464)"
                        // N2 (S473 PA ruling on the #1663 re-review): a §5.2 rule 3 URL
                        // attribute's value is judged like a navigation
                        if (isUrlAttrName(nv.name)) {
                            const vx: int = attrValueArgIndex(s)
                            if (vx >= 0) {
                                const uw: string = sinkNavWhy("`" + s + "(\"" + nv.name + "\", …)`", sinkArg(args, vx))
                                if (uw != "") return uw
                            }
                        }
                    }
                }
                if (kind == "open" && args.length > 0 && sinkWindowish(ch, i, env)) {
                    if (!isLast) return "reaches `open` through `." + ch[last] + "` — an alias of a navigation is refused (fail closed)"
                    const ow: string = sinkNavWhy("`open(…)`", sinkArg(args, 0))
                    if (ow != "") return ow
                }
                if (kind == "attrnode" && i > 0) return "calls `" + s + "` — it installs an attribute node whose name is not seen here; it could be `srcdoc` or an `on…` handler, so it is refused (fail closed); write the attribute with `setAttribute(\"name\", …)`"
                if (kind == "nav" && i > 0 && sinkChainHas(ch, i, "location")) {
                    if (!isLast) return "reaches `location." + s + "` through `." + ch[last] + "` — an alias of a navigation is refused (fail closed)"
                    const nw: string = sinkNavWhy("`location." + s + "`", sinkArg(args, 0))
                    if (nw != "") return nw
                }
            }
            i = i + 1
        }
        if (server) return ""
        // `Object.assign(target, …sources)` / `Reflect.set(target, key, value)` /
        // `Object.defineProperty` / `Reflect.defineProperty(target, key, desc)` /
        // `Object.defineProperties(target, map)`: a member written through the
        // reflection API. A non-literal key or source is admitted only onto a
        // fresh object or a value of a scrml type (the #1663 review F1).
        if (ch.length == 2 && ch[0] == "Object" && (ch[1] == "assign" || ch[1] == "defineProperties")) {
            const t: AExpr | not = sinkArg(args, 0)
            if (t is given) {
                const typed: boolean = sinkView(t).kind == 6 || sinkScrmlTyped(env, t)
                let j = 1
                while (j < args.length) {
                    const sv: SinkView = sinkView(args[j])
                    if (sv.kind == 6) {
                        const w: string = sinkPropsWhy(env, t, sv.props, typed, ch[1] == "defineProperties")
                        if (w != "") return "`Object." + ch[1] + "` " + w
                    } else if (!typed) {
                        return "`Object." + ch[1] + "` copies keys that are not written out onto a value whose type is not a scrml type — a key could name a sink, so it is refused (fail closed)"
                    }
                    j = j + 1
                }
            }
            return ""
        }
        const reflectSet: boolean = ch.length == 2 && ch[0] == "Reflect" && ch[1] == "set"
        const defProp: boolean = ch.length == 2 && (ch[0] == "Reflect" || ch[0] == "Object") && ch[1] == "defineProperty"
        if (reflectSet || defProp) {
            const t2: AExpr | not = sinkArg(args, 0)
            const key: AExpr | not = sinkArg(args, 1)
            if (t2 is given && key is given) {
                const kv: SinkView = sinkView(key)
                let val: AExpr | not = not
                if (reflectSet) val = sinkArg(args, 2)
                if (kv.kind == 4) {
                    const w3: string = sinkWriteWhy(env, t2, kv.name, val)
                    if (w3 != "") return "`" + ch[0] + "." + ch[1] + "` " + w3
                } else if (!sinkNumericKey(env, key) && !sinkScrmlTyped(env, t2)) {
                    return "`" + ch[0] + "." + ch[1] + "` writes a member by a computed key on a value whose type is not a scrml type — the key could name a sink, so it is refused (fail closed)"
                }
            }
        }
        return ""
    }

    fn sinkMessage(why: string) -> string {
        return "this " + why + ". `innerHTML`, `outerHTML`, `insertAdjacentHTML`, `setHTMLUnsafe`, `createContextualFragment`, `parseFromString`, `srcdoc`, `on…` members and attributes, `document.write` / `writeln`, `execCommand(\"insertHTML\")`, `eval` / `Function` and a string `setTimeout` / `setInterval` are executable sinks, and an unjudged navigation is one too: the browser parses or runs what reaches them without scrml checking it, and data is never written into one (§5.2, S473). Render the content as markup, write plain text with `textContent`, and attach behaviour with an event attribute (`onclick=fn()`)."
    }

    // `target = value` (statement position).
    // s474 (#1700 review F4) — the §5.2 executable-sink judgement of an
    // assignment, ONE function for the statement form and the kept
    // condition-head form (assignAsValue), so the two cannot drift.
    fn assignSinkWhy(env: Env, target: AExpr, value: AExpr) -> string {
        if (env.fx.serverOwn) return ""
        const w: string = sinkTargetWhy(env, target, value)
        if (w != "") return w
        if (sinkYieldsAttr(value)) return sinkAttrBindWhy("a variable")
        return ""
    }

    fn resolveAssign(env: Env, e: AExpr, target: AExpr, value: AExpr, st0: AS) -> AS {
        // s473 — §5.2 "Executable sinks in plain logic (S473)": judged first
        // (client logic only — a server function has no DOM, §5.2)
        const sinkW: string = assignSinkWhy(env, target, value)
        if (sinkW != "") return addDiag(st0, env.file, e.span, "E-LOGIC-EXECUTABLE-SINK", sinkMessage(sinkW))
        // s442: the recognized sequence reassignment shapes (§66.11.2) and an
        // element-field write (dpa-052 Q3).
        // r1 F1: only a CELL / field place — a local (or a place rooted in one)
        // takes the ordinary local path below (E-ASSIGN-CONST, value resolution).
        const shape: int = seqEditShape(target, value)
        if (shape > 0 && !rootIsLocal(env, target)) return resolveSeqShape(env, e, target, value, shape, st0)
        const ef: ElemFieldTarget | not = elemFieldTarget(target)
        if (ef is given) {
            if (!rootIsLocal(env, ef.seq)) return resolveElemFieldWrite(env, e, ef, value, st0)
        }
        // s472 — a write to a PART of a local (`p.f = v`, `xs[i] = v`) — value
        // semantics, judged by the part's own contract / its tape's grants — and a
        // POSITION write of a cell's tape (`@xs[i] = v`, §66.12.6 rule 3)
        const pl: LocalB | not = partLocal(env, target)
        if (pl is given) return resolveLocalPartWrite(env, e, target, value, pl, st0)
        const it: IndexTarget | not = indexTarget(target)
        if (it is given) return resolvePositionWrite(env, e, it, value, st0)
        // `@inst = { ...@inst, f: v }` — the self-spread of an INSTANCE: field
        // edits of that instance (O58 (b)).
        if (isSelfSpread(target, value)) {
            const ri: RX = resolveHandleSubject(env, target, st0)
            const inst: InstRef | not = ri.x.inst
            const iDecl: Sym | not = ri.x.iDecl
            if (inst is given && iDecl is given) return resolveInstanceSpread(env, e, inst, iDecl, ri.x.maybe, value, ri.st)
        }
        const rp: RPlace = resolvePlace(env, target, st0)
        let st: AS = rp.st
        const l: LocalB | not = rp.local
        if (l is given) {
            // s469 review: a write to a PART of a local (`p.name = v`, `ys[0] = v`) is not a
            // rebinding of the local — Core has no field or element write of a local, and
            // lowering it as `p = v` replaced the whole value. Refused, never approximated.
            if (exprName(target) == "") return addDiag(resolveExpr(env, value, not, st).st, env.file, target.span, "E-BOOTSTRAP-UNSUPPORTED", "a write to a part of the local `" + l.name + "` (`" + placeKey(target) + " = …`) is not in the bootstrap yet — Core rebinds a local only as a whole; " + partWriteFix(l))
            if (!l.mutable) st = addDiag(st, env.file, target.span, "E-ASSIGN-CONST", "`" + l.name + "` is not a `let` local")
            // s469-boot-tape-grants: §50 decides whether the name may be rebound (above);
            // whether the tape write the rebinding performs is granted (§66.12.6 rule 4) is
            // the typer's (typeAssign → localTapeProblems), where an inferred type is known
            st = addEffect(st, e.nid, EffectFact.EAssignLocal(l.s, [], not))
            return resolveExpr(env, value, l.ty, st).st
        }
        const p: WPlace | not = rp.place
        if (p is not) return resolveExpr(env, value, not, st).st
        st = writeGuards(env, p, target.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        if (p.path.length == 0 && isSelfSpread(target, value)) return resolveSpread(env, e, p, f, value, st)
        if (p.path.length > 0) return resolveFieldAt(env, e, p, f, value, placeKey(target), st)
        const rv: RX = resolveExpr(env, value, f.ty, st)
        const rw: RWriteFact = wholeFieldWrite(env, p, f, value, placeKey(target), rv.st, e.span)
        const w: WriteFact | not = rw.w
        if (w is given) return addEffect(rw.st, e.nid, EffectFact.EWrite(w))
        return rw.st
    }

    // s469 review r2: the advice depends on whether the local can be rebound —
    // an iterate binder, a parameter, a `const` or a row alias cannot.
    fn partWriteFix(l: LocalB) -> string {
        if (l.mutable) return "build the new value and rebind it (`" + l.name + " = …`), or write the cell it came from"
        return "`" + l.name + "` cannot be rebound (a `const`, a parameter, a loop binder or a row) — copy it into a `let` and rebind that whole, or write the cell it came from"
    }

    // A write of a WHOLE field (§66.11): along its graph (a Transition), a
    // `replace`, or refused — E-DERIVED-WRITE for a derived field (its message
    // names the `let`-seeding trade-off, §66.9 rule 5), E-WRITE-NOT-GRANTED
    // for a locked one (its message names `let`).
    // `key` is the written place's spelling (`@b`, `@h.f`; "" when the value is
    // not a source expression, as for `bind:`): a whole-STRUCT write replaces
    // the struct's tape fields, each judged by its own grants (structTapeWrites,
    // §66.12.6 rule 4), unless the value keeps it (`xs: @b.xs`).
    fn wholeFieldWrite(env: Env, p: WPlace, f: FieldInfo, value: AExpr, key: string, st: AS, span: ASpan) -> RWriteFact {
        const g: TransitionGraph | not = f.graph
        const cap: Sym | not = f.wcap
        if (g is given && cap is given) {
            const rc: RCheck = transitionCheck(env, g, value, initialVariant(env, g, f.init), st)
            return { w: { cap: cap, inst: p.inst, edit: EditKind.Transition, check: rc.check }, st: rc.st }
        }
        if (grantsAdmit(f.grants, EditKind.Replace) && cap is given) {
            const st2: AS = checkStructTapes(env, f.ty, value, key, writtenLabel(key, f.sym.hint), span, st)
            if (st2.diags.length > st.diags.length) return { w: not, st: st2 }
            return { w: { cap: cap, inst: p.inst, edit: EditKind.Replace, check: Check.Static }, st: st2 }
        }
        const isDerived: boolean = f.mode == FieldMode.Derived
        if (isDerived) return { w: not, st: addDiag(st, env.file, span, "E-DERIVED-WRITE", derivedMessage(p, f)) }
        // r2 F6: a field whose contract grants edits but not `replace` is not
        // locked — say which grant this whole-value write needs
        if (grantsHasEdits(f.grants)) return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", replaceNotGrantedMsg(f)) }
        // s469 review: a SEQUENCE is never made writable by `let` (E-GRANT-LET-ON-SEQUENCE,
        // §66.12.3) — its whole-value write is the `replace` grant in its type
        if (seqElem(unMaybe(f.ty)) is given) return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "` is a sequence whose type grants nothing — this whole-value write needs `replace` in the type's grants (`T[replace]`, §66.12.2); its grants live on the type, and `let` on a sequence is E-GRANT-LET-ON-SEQUENCE (§66.12.3)") }
        return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "` is locked — nothing grants this write (a whole-value replace). Declare it `let <" + f.sym.hint + "…/>` (`let` before the `<`, §66.2.5) to make it writable (§66.9, §66.11).") }
    }

    fn replaceNotGrantedMsg(f: FieldInfo) -> string {
        const n: string = f.sym.hint
        let msg: string = "`@" + n + " = …` is a whole-value replace of `@" + n + "`, and its contract does not grant `replace` — it grants edits only (§66.11.2: a whole-value write is checked against the grants, whatever the spelling)"
        if (grantsEditOnly(f.grants, EditKind.RemoveAnywhere)) msg = msg + ". A removal is `@" + n + " = @" + n + ".filter(x => …)` of its OWN value (`remove`)"
        if (seqElem(f.ty) is given) msg = msg + "; to write any value, add `replace` to the type's grants (§66.12.2)"
        return msg
    }


    // `@h = { ...@h, f: v, … }` over an instance: one field write per override,
    // each judged by that field's own contract exactly as `@h.f = v` is.
    fn resolveInstanceSpread(env: Env, e: AExpr, inst: InstRef, iDecl: Sym, maybe: boolean, value: AExpr, st0: AS) -> AS {
        let st: AS = st0
        const d: DeclSrc | not = findDeclSrc(env.g, iDecl)
        if (d is not) return st
        const ps: AProp[] = propsOf(value)
        // the spread operand `...@h` names the instance (a subject, like a
        // write target — no read check; writeGuards reports an un-narrowed
        // handle). lower reads it as the statement's snapshot (S440).
        st = resolveHandleSubject(env, ps[0].value, st).st
        let ws: SpreadWrite[] = []
        let j = 1
        while (j < ps.length) {
            const pr: AProp = ps[j]
            const i: int = fieldIndex(d.info, pr.name)
            if (overriddenBefore(ps, j)) {
                st = dupOverride(env, st, pr)
            } else if (i < 0) {
                st = addDiag(st, env.file, pr.span, "E-SCOPE-001", "`<" + d.info.sym.hint + ">` has no field `" + pr.name + "`")
            } else {
                const f: FieldInfo = d.info.fields[i]
                const p: WPlace = { decl: d.info, inst: inst, idx: i, path: [], ty: f.ty, maybe: maybe }
                st = writeGuards(env, p, pr.span, st)
                st = resolveExpr(env, pr.value, f.ty, st).st
                const okey: string = memberKey(placeKey(ps[0].value), pr.name)
                let rw: RWriteFact = { w: not, st: st }
                if (!isOwnValue(pr.value, okey)) rw = wholeFieldWrite(env, p, f, pr.value, okey, st, pr.span)     // s469 F4: as resolveSpread
                st = rw.st
                const w: WriteFact | not = rw.w
                if (w is given) {
                    const m: RSym = mint(st, pr.name)
                    st = m.st
                    ws = ws.concat([{ w: w, prop: j, tmp: m.s }])
                }
            }
            j = j + 1
        }
        let refs: FieldRef[] = []
        let names: string[] = []
        let fi = 0
        for (const fd of d.info.fields) {
            refs = refs.concat([{ owner: iDecl, idx: fi }])
            names = names.concat([fd.sym.hint])
            fi = fi + 1
        }
        return spreadEffect(st, e, ws, iDecl.hint, refs, names)
    }

    // The spread's effect. `inst` is the local the written instance is resolved
    // into ONCE, before the Commit (lower: `Let inst = Handle(…)`, the writes go
    // through `Narrowed(inst)`), so a flush can never make a later write of the
    // same edit re-resolve a handle to a different instance. Minted here so
    // `lower` still decides nothing.
    // STRICT SNAPSHOT (RULED S440): every `@x` read inside the override values
    // reads a value taken BEFORE any override value is evaluated — so a call in
    // one override that writes `@x` is not seen by another. The snapshot is
    // PER FIELD (`fields`: one local per field of the target, the field's
    // FieldRef beside it), and lower reads only the fields the override values
    // read lexically: taking a whole-value snapshot would `.get()` — and so
    // subscribe to — every field when the spread runs inside an effect (S440
    // re-review N1: a runaway re-run loop). `snap` is the whole-value local,
    // used only when an override value reads the WHOLE `@x` (which reads every
    // field lexically anyway).
    fn spreadEffect(st0: AS, e: AExpr, ws: SpreadWrite[], hint: string, refs: FieldRef[], names: string[]) -> AS {
        const m: RSym = mint(st0, hint)
        const sn: RSym = mint(m.st, "before")
        let st: AS = sn.st
        let fields: SnapField[] = []
        let k = 0
        for (const r of refs) {
            const fm: RSym = mint(st, "before_" + names[k])
            st = fm.st
            fields = fields.concat([{ ref: r, local: fm.s }])
            k = k + 1
        }
        return addEffect(st, e.nid, EffectFact.ESpread(ws, m.s, sn.s, fields))
    }

    // RULED S440: a spread-override literal names each field at most once.
    fn overriddenBefore(ps: AProp[], j: int) -> boolean {
        let k = 1
        while (k < j) {
            if (ps[k].name == ps[j].name) return true
            k = k + 1
        }
        return false
    }

    // A struct literal's repeated key — the spread-override shape and a plain
    // literal alike (RULED S440; SPEC §14.3, §66.11.3; §34 E-STRUCT-DUPLICATE-KEY).
    fn dupOverride(env: Env, st: AS, pr: AProp) -> AS {
        return addDiag(st, env.file, pr.span, "E-STRUCT-DUPLICATE-KEY", "`" + pr.name + "` is named twice in this struct literal — a struct literal names each key at most once (in a spread, an override edits its field once); keep one `" + pr.name + ": …` (§14.3, ruled S440)")
    }

    // A write at a struct path (`@o.s = v`): the TARGET sub-field's own contract.
    fn resolveFieldAt(env: Env, e: AExpr, p: WPlace, f: FieldInfo, value: AExpr, key: string, st0: AS) -> AS {
        const rv: RX = resolveExpr(env, value, p.ty, st0)
        let st: AS = rv.st
        const r: RWriteFact = fieldAtWrite(env, p, f, value, key, st, e.span)
        st = r.st
        const w: WriteFact | not = r.w
        if (w is given) st = addEffect(st, e.nid, EffectFact.EWrite(w))
        return st
    }

    type RWriteFact:struct = { w: WriteFact | not, st: AS }

    // `key`: the written place's spelling (`@b.xs`; "" when there is none).
    fn fieldAtWrite(env: Env, p: WPlace, f: FieldInfo, value: AExpr, key: string, st: AS, span: ASpan) -> RWriteFact {
        const cap: Sym | not = f.wcap
        const target: FieldDef | not = pathTarget(env, p)
        if (target is not || cap is not) {
            return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "` grants no write") }
        }
        const edit: EditKind = EditKind.FieldAt(p.path)
        const label: string = writtenLabel(key, f.sym.hint + "." + target.sym.hint)
        // s469-boot-tape-grants: a TAPE field is judged by its own grants alone —
        // the owning struct's `replace` never admits replacing it (§66.12.6
        // rules 1 and 4; S469 limit on O57). The write is classified first.
        if (seqElem(unMaybe(target.ty)) is given) {
            const shape: int = seqEditShapeKey(key, value)
            let tedit: EditKind = EditKind.Replace
            let what: string = "a `replace` of it (an unclassified whole-value write, §66.11.2)"
            if (shape > 0) {
                tedit = shapeEdit(shape)
                what = shapeWhat(shape)
            }
            if (!grantsAdmit(target.grants, tedit)) {
                return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`" + label + " = …` writes the tape field `" + target.sym.hint + "` (`" + tapeTypeName(target.ty) + "`): it is " + what + ", which the field's type does not grant — a tape field is judged by its OWN grants, never by the struct's `replace` (§66.12.6 rules 1 and 4)") }
            }
            if (!grantsAdmit(target.grants, EditKind.Replace)) {
                return { w: not, st: addDiag(st, env.file, span, "E-BOOTSTRAP-UNSUPPORTED", "`" + label + " = …` is " + what + " of a sub-field tape, which its grants allow — but Core writes a struct field only as a whole (`replace`), so an edit of a sub-field tape is not in the bootstrap yet") }
            }
            // s472-boot-map-grants: Core writes the field WHOLE (a FieldAt), so the write is
            // judged as a whole write of the tape — the tapes its elements hold, at any depth,
            // unless it is a permutation (RULED S472; C3 fieldAtTapeKept is the twin)
            const ed: TapeDiag[] = tapeWriteInnerProblems(env.g.types, key, value, target.ty, label, true)
            if (ed.length > 0) return { w: not, st: addDiag(st, env.file, span, ed[0].code, ed[0].msg) }
            return { w: { cap: cap, inst: p.inst, edit: edit, check: Check.Static }, st: st }
        }
        let granted = false
        if (grantsAdmit(target.grants, EditKind.Replace)) granted = true
        // O57 = no: a contract-free (non-tape) sub-field is written under the owner's `replace`
        if (grantsAdmit(f.grants, EditKind.Replace) && !grantsHasEdits(target.grants)) granted = true
        if (!granted) return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`" + target.sym.hint + "` is not writable here — its contract grants no replace (§66.11.4)") }
        // a struct-typed field: its own tape fields are judged as a whole-struct write's are
        const st2: AS = checkStructTapes(env, target.ty, value, key, label, span, st)
        if (st2.diags.length > st.diags.length) return { w: not, st: st2 }
        return { w: { cap: cap, inst: p.inst, edit: edit, check: Check.Static }, st: st2 }
    }

    // `@x = { ...@x, f: v, … }` — the spread of the SAME place with named
    // overrides is a FIELD EDIT per override (O58 (b), ruled S437): each is
    // judged by `f`'s own contract, exactly as `@x.f = v` is.
    fn isSelfSpread(target: AExpr, value: AExpr) -> boolean {
        const k: AExprK = value.k
        return match k {
            .ObjectLit(props: ps) :> spreadsTarget(target, ps)
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps2) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
        }
    }

    fn spreadsTarget(target: AExpr, ps: AProp[]) -> boolean {
        if (ps.length == 0) return false
        if (!ps[0].spread) return false
        let i = 1
        while (i < ps.length) {
            if (ps[i].spread) return false
            i = i + 1
        }
        return samePlaceSyntax(target, ps[0].value)
    }

    // Two place expressions spelled the same (`@order` / `@order`, `@c.o` / `@c.o`).
    fn samePlaceSyntax(a: AExpr, b: AExpr) -> boolean {
        return placeKey(a) != "" && placeKey(a) == placeKey(b)
    }

    fn placeKey(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> "@" + n
            .Name(name: n) :> n
            .Member(obj: o, name: n) :> memberKey(placeKey(o), n)
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // s469 F4: is `v` the place spelled `key` itself (`xs: @b.xs` in `{ ...@b, … }`)?
    fn isOwnValue(v: AExpr, key: string) -> boolean {
        return key != "" && placeKey(v) == key
    }

    fn memberKey(base: string, n: string) -> string {
        if (base == "") return ""
        return base + "." + n
    }

    fn resolveSpread(env: Env, e: AExpr, p: WPlace, f: FieldInfo, value: AExpr, st0: AS) -> AS {
        let st: AS = st0
        const s: Sym | not = namedOf(f.ty)
        let fs: FieldDef[] = []
        if (s is given) {
            const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
            if (ti is given) {
                const d: FieldDef[] | not = structFieldDefs(ti.def)
                if (d is given) fs = d
            }
        }
        if (s is not || fs.length == 0) return addDiag(st, env.file, e.span, "E-TYPE-STRUCT-CONTEXT", "a spread write needs a struct-typed target")
        const ps: AProp[] = propsOf(value)
        // the spread operand reads the place itself
        st = resolveExpr(env, ps[0].value, f.ty, st).st
        let ws: SpreadWrite[] = []
        let j = 1
        while (j < ps.length) {
            const pr: AProp = ps[j]
            let idx: int = -1
            let i = 0
            for (const fd of fs) {
                if (fd.sym.hint == pr.name) idx = i
                i = i + 1
            }
            if (overriddenBefore(ps, j)) {
                st = dupOverride(env, st, pr)
            } else if (idx < 0) {
                st = addDiag(st, env.file, pr.span, "E-TYPE-STRUCT-FIELD", shownStruct(env, s) + " has no field `" + pr.name + "`")
            } else {
                const sub: WPlace = { decl: p.decl, inst: p.inst, idx: p.idx, path: [{ owner: s, idx: idx }], ty: fs[idx].ty, maybe: p.maybe }
                const rv: RX = resolveExpr(env, pr.value, fs[idx].ty, st)
                const okey: string = memberKey(placeKey(ps[0].value), pr.name)
                // s469 F4: `f: @x.f` names the field's own value — the spread already keeps
                // it, so it is no write at all (never a `replace` of a tape it holds)
                let rw: RWriteFact = { w: not, st: rv.st }
                if (!isOwnValue(pr.value, okey)) rw = fieldAtWrite(env, sub, f, pr.value, okey, rv.st, pr.span)
                st = rw.st
                const w: WriteFact | not = rw.w
                if (w is given) {
                    const m: RSym = mint(st, pr.name)
                    st = m.st
                    ws = ws.concat([{ w: w, prop: j, tmp: m.s }])
                }
            }
            j = j + 1
        }
        let refs: FieldRef[] = []
        let names: string[] = []
        let fi = 0
        for (const fd of fs) {
            refs = refs.concat([{ owner: s, idx: fi }])
            names = names.concat([fd.sym.hint])
            fi = fi + 1
        }
        return spreadEffect(st, e, ws, p.decl.sym.hint, refs, names)
    }

    fn propsOf(v: AExpr) -> AProp[] {
        const k: AExprK = v.k
        return match k {
            .ObjectLit(props: ps) :> ps
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
        }
    }

    // `reset(@x)` (L4): a replace with x's initializer — needs `replace`
    // (§66.11.2: reset IS a replace; O58 (b): it restores the declared initial
    // state authoritatively, bypassing sub-field contracts).
    fn resolveReset(env: Env, e: AExpr, args: AExpr[], st0: AS) -> AS {
        if (args.length != 1) return addDiag(st0, env.file, e.span, "E-RESET-ARG", "`reset` takes one cell: `reset(@x)`")
        const rp: RPlace = resolvePlace(env, args[0], st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, args[0].span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        const cap: Sym | not = f.wcap
        if (p.path.length > 0) return addDiag(st, env.file, e.span, "E-RESET-ARG", "`reset` takes a whole cell, not a sub-field")
        // s473: a db cell's initializer is its server load (§8.1.3) — what a reset of it
        // means on the client (the loaded value again, or a new load) is not built: refused
        if (p.decl.sym.id == env.g.program.id && dbCellRecord(env.g, f.nid) is given) {
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`reset(@" + f.sym.hint + ")` of a `<db>` cell is not in the bootstrap — its initializer is its server load, evaluated per request (§8.1.3), and whether a reset re-applies the loaded value or loads again is not built. Write the value you want with a function declared in its `<db>` body")
        }
        if (!grantsAdmit(f.grants, EditKind.Replace) || cap is not) {
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`reset(@" + f.sym.hint + ")` is a replace (§66.11.2) and `" + f.sym.hint + "` does not grant `replace` — declare it `let`")
        }
        // s469-boot-tape-grants: a reset replaces a tape field that has changed since
        // construction, and that is a `replace` of the FIELD (§66.12.6 rule 4, reset
        // included) — whether it has changed is known only at run time
        const tp: string = resetTapeProblem(env.g.types, f.ty, "@" + f.sym.hint)
        if (tp != "") return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", resetTapeMessage("`reset(@" + f.sym.hint + ")`", tp))

        return addEffect(st, e.nid, EffectFact.EReset({ cap: cap, inst: p.inst, edit: EditKind.Replace, check: Check.Static }, p.decl.sym, p.idx))
    }

    // =========================================================================
    // Statements.
    // =========================================================================
    type RB:struct = { env: Env, st: AS }

    // A statement-position expression: an assignment, a `reset`, or a value.
    fn resolveStmtExpr(env: Env, e: AExpr, st: AS) -> AS {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> resolveAssign(withWholeAt(env, v.nid, "the right-hand side of an assignment"), e, t, v, st)
            .Call(callee: c, args: args) :> resolveCallStmt(env, e, c, args, st)
            .Name(name: n) :> resolveExpr(env, e, not, st).st
            .At(name: n) :> resolveExpr(env, e, not, st).st
            .AtItem :> resolveExpr(env, e, not, st).st
            .Num(raw: r) :> resolveExpr(env, e, not, st).st
            .Str(v: s) :> resolveExpr(env, e, not, st).st
            .Bool(v: b) :> resolveExpr(env, e, not, st).st
            .NotLit :> resolveExpr(env, e, not, st).st
            .Recovered :> resolveExpr(env, e, not, st).st
            .Variant(name: n) :> resolveExpr(env, e, not, st).st
            .Member(obj: o) :> resolveExpr(env, e, not, st).st
            .Unary(op: o) :> resolveExpr(env, e, not, st).st
            .Binary(op: o) :> resolveExpr(env, e, not, discardedTapeBranches(env, e, st)).st      // s469 F/U-4
            .Ternary(test: t) :> resolveExpr(env, e, not, discardedTapeBranches(env, e, st)).st
            .ArrayLit(elems: es) :> resolveExpr(env, e, not, st).st
            .ObjectLit(props: ps) :> resolveExpr(env, e, not, st).st
            .Spread(e: x) :> resolveExpr(env, e, not, st).st
            .Index(obj: o) :> resolveExpr(env, e, not, st).st
            .Lambda(params: ps2) :> resolveExpr(env, e, not, st).st
            .Sql(q: q) :> resolveSql(withWhole(env, e.nid), e, q, true, st).st
            .Handled(h: h) :> resolveHandled(withWhole(env, e.nid), e, h, true, not, st).st   // s451 (Ue)
            .Template(quasis: qs) :> resolveExpr(env, e, not, st).st
            .Foreign(f: fb0) :> resolveForeignAt(env, e, fb0, true, st).st      // s473: a bare foreign block (§23.2.4 form 3)
        }
    }

    fn resolveCallStmt(env: Env, e: AExpr, callee: AExpr, args: AExpr[], st: AS) -> AS {
        // s473 — §5.2 "Executable sinks in plain logic (S473)": judged first (the
        // edit-call paths below would otherwise take a member call before it)
        const sinkS: string = sinkCallWhy(env, callee, args)
        if (sinkS != "") return addDiag(st, env.file, e.span, "E-LOGIC-EXECUTABLE-SINK", sinkMessage(sinkS))
        if (exprName(callee) == "reset") return resolveReset(env, e, args, st)
        // s469: a JavaScript tape method name, or a discarded `sort` / `reverse` (E-TAPE-JS-METHOD)
        const jm: MethodCall | not = memberCall(callee)
        if (jm is given) {
            const tj: AS | not = tapeMethodStmt(env, e, jm, args, st)
            if (tj is given) return tj
        }
        const rmv: MethodCall | not = removeCall(callee)
        if (rmv is given) {
            if (!rootIsLocal(env, rmv.obj)) return resolveRemoveCall(env, e, rmv, args, st)
            return localEditRefused(env, e, rmv.method, args, st)
        }
        const m: MethodCall | not = methodCall(callee)
        if (m is given) {
            // r1 F1 (the same deletion, pre-existing M2 shape): an edit call on a LOCAL
            if (rootIsLocal(env, m.obj)) return localEditRefused(env, e, m.method, args, st)
        }
        if (m is given) return resolveEditCall(env, e, m, args, st)
        return resolveExpr(withStmtCall(env, e.nid), e, not, st).st
    }

    // `@x.append(v)` / `@x.prepend(v)` — a sequence EDIT named by its method
    // (§66.11.2 classifies mutating method calls): end-append / front-prepend.
    // s469: tape methods are named after their grants (§66.12.6 rule 3);
    // JavaScript's `push` / `unshift` are E-TAPE-JS-METHOD (tapeMethodStmt).
    type MethodCall:struct = { obj: AExpr, method: string }

    fn methodCall(callee: AExpr) -> MethodCall | not {
        const k: AExprK = callee.k
        return match k {
            .Member(obj: o, name: n) :> methodOf(o, n)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn methodOf(o: AExpr, n: string) -> MethodCall | not {
        if (n == "append" || n == "prepend") return { obj: o, method: n }
        return not
    }

    fn resolveEditCall(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, m.obj, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, m.obj.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        let elem: Type | not = not
        const pt: Type | not = p.ty
        if (pt is given) elem = seqElem(pt)
        if (args.length != 1) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`." + m.method + "` with other than one element is not in bootstrap slice M2")
        st = resolveExpr(env, args[0], elem, st).st
        if (p.path.length > 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "an edit of a sub-field sequence is not in bootstrap slice M2")
        let edit: EditKind = EditKind.Append
        let what: string = "an end-append"
        if (m.method == "prepend") {
            edit = EditKind.Prepend
            what = "a front-prepend"
        }
        const cap: Sym | not = f.wcap
        const granted: boolean = grantsAdmit(f.grants, edit)
        // r1 F7: a granted edit that GROWS a fixed-length sequence breaks its length invariant
        if (granted && growsFixed(p.ty)) return addDiag(st, env.file, e.span, "E-WRITE-INVARIANT", fixedLengthMessage(f.sym.hint, what))
        if (granted && cap is given) {
            return addEffect(st, e.nid, EffectFact.EWrite({ cap: cap, inst: p.inst, edit: edit, check: Check.Static }))
        }
        const isDerived: boolean = f.mode == FieldMode.Derived
        if (isDerived) return addDiag(st, env.file, e.span, "E-DERIVED-VALUE-MUTATE", "`@" + f.sym.hint + "` is derived — an in-place edit of a derived value is an error (§6.6.18, §66.9)")
        return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "." + m.method + "(…)` is " + what + ", which `" + f.sym.hint + "`'s type does not grant (§66.12.2)")
    }

    fn hasEditKind(es: EditKind[], k: EditKind) -> boolean {
        for (const x of es) {
            if (x == k) return true
        }
        return false
    }

    // =========================================================================
    // s469-boot-tape-grants — THE TAPE GRANT READER (§66.12.3 "Permissions live
    // on the TYPE"; §66.12.6 "No position escapes the grants").
    //
    // `grantsAdmit` is the ONE predicate every write to a tape-typed place is
    // judged by, and `tapeGrants` the one place a tape type's grants are read:
    //   - a cell / declaration field: resolveEditCall, resolveRemoveCall,
    //     resolveSeqShape, wholeFieldWrite (the field's GrantSet, built from its
    //     type in fieldOf);
    //   - a struct field written directly or as a spread override: fieldAtWrite;
    //     an element field: resolveElemFieldWrite (the FieldDef's GrantSet,
    //     built from its type in fieldDefsOf);
    //   - every tape field a WHOLE-STRUCT write replaces (structTapeWrites,
    //     §66.12.6 rule 4) — a cell, a field, an instance-spread override, an
    //     element field, a struct local's rebinding; `reset` / `reset-on=` of
    //     one is refused (the reset's effect on a tape is not static);
    //   - a LOCAL rebinding (localTapeProblems, run by the typer; rule 4 / O63 — `let` gives the tape
    //     nothing);
    //   - a place passed as an argument (argTapeProblem, §66.12.3 subset).
    // `replace` subsumes the edits (§66.11.3). A form that writes a tape and is
    // not judged here is refused (E-BOOTSTRAP-UNSUPPORTED: in-place edits of a
    // local, a parameter or a sub-field tape), never let through.
    // slice-m4/tape-write-forms.test.js enumerates the write forms.
    //
    // s469 F2 — THE RANGE IS STRUCTURAL: outside it a GrantSet is never named,
    // held or read (slice-m4/grant-scan.js, run by tape-write-forms.test.js):
    // `x.grants` appears only as a whole argument of a function declared here,
    // or copied whole into a `grants:` slot; `.replace` / `.edits` are never
    // read; `GrantSet` names only a struct's `grants` field; a GrantSet-
    // returning call (`tapeGrants`, `noGrants`, `fieldGrantSet`, …) is only
    // such an argument or slot value. A new admission decision is a new
    // function HERE.
    // =========================================================================
    // A declaration field's GrantSet (fieldOf): `replace` from `let` / the
    // type's `replace` token, the edits its type and contract grant.
    fn fieldGrantSet(replace: boolean, edits: EditKind[]) -> GrantSet {
        return { replace: replace, edits: edits }
    }

    // A type field's GrantSet (fieldDefsOf). A payload field carries none: an
    // enum payload is a VALUE, not a tape position (RULED S469 — grants do not
    // apply inside an enum payload).
    fn fieldDefGrants(payload: boolean, replace: boolean, edits: EditKind[]) -> GrantSet {
        if (payload) return noGrants()
        return { replace: replace, edits: edits }
    }

    fn grantsAdmit(gs: GrantSet, edit: EditKind) -> boolean {
        return gs.replace || hasEditKind(gs.edits, edit)
    }

    // Does the set grant ANY write (`replace` or an edit)? — who gets a write
    // capability minted (fieldOf), and whether a sub-field is "fixed".
    fn grantsAny(gs: GrantSet) -> boolean {
        return gs.replace || gs.edits.length > 0
    }

    // Does the set grant some EDIT (a contract other than `replace`)? O57: a
    // sub-field with one is not written under its owner's `replace`.
    fn grantsHasEdits(gs: GrantSet) -> boolean {
        return gs.edits.length > 0
    }

    // Does the set name edit `k` itself (not through `replace`)? — message advice only.
    fn grantsEditOnly(gs: GrantSet, k: EditKind) -> boolean {
        return hasEditKind(gs.edits, k)
    }

    // A tape type's grants, read off the TYPE (through `| not`); `not` for a
    // type that is not a tape.
    fn tapeGrants(t: Type) -> GrantSet | not {
        const u: Type = unMaybe(t)
        return match u {
            .Seq(elem: e, grants: g) :> tapeGrantSet(g)
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Named(sym: s) :> not
            .Maybe(inner: i) :> not
        }
    }

    fn tapeGrantSet(g: SeqGrants) -> GrantSet {
        return { replace: g.replace, edits: seqEdits(g) }
    }

    // One tape field a whole-struct write replaces: where it is (for the
    // message), its type, and its OWN grants (the FieldDef's — never the
    // owning struct's `replace`). `inner`: the tape is held by an ELEMENT of a
    // replaced tape (`@g[…]`, `@b.rows[…].kids` — RULED S472, rule 1 recursion),
    // not a field of the written struct itself.
    type TapeHit:struct = { path: string, ty: Type, grants: GrantSet, inner: boolean }

    // §66.12.6 rule 4: the tape fields a whole value `v` of type `ty`, written
    // at the place spelled `key` ("" when it has no spelling), REPLACES. Every
    // tape field reached through struct fields is written, except one the new
    // value leaves as it was — `xs: @b.xs`, or a spread of the place itself
    // that does not override it (§66.11.3 rule 1). A value that is not an
    // object literal (`loadBox()`, a name, …) replaces every tape field; a
    // value that IS the place (`@b`, s469 F4) replaces none. s472-boot-map-grants
    // (RULED S472 "five PA recs" item 1 — "A `replace` (or any whole write) of a
    // tape counts as a `replace` of every tape its elements hold, RECURSIVELY"):
    // a replaced tape — `ty` itself when it is a tape, or a tape field the value
    // does not keep — replaces every tape its ELEMENTS hold, at any depth
    // (innerTapeHits); the replaced tape's OWN grant is judged where it is
    // written (the caller). An ENUM is not walked: a variant payload is a value,
    // not a tape position — grants do not apply inside it (RULED S469, "Not a
    // tape position"), so a whole enum write replaces no tape. `seen` stops a
    // recursive struct.
    fn structTapeWrites(types: TypeInfo[], ty: Type, v: AExpr | not, key: string, label: string, seen: int[]) -> TapeHit[] {
        if (v is given) {
            if (key != "" && placeKey(v) == key) return []
        }
        if (tapeGrants(ty) is given) return innerTapeHits(types, ty, label, seen)
        const s: Sym | not = namedOf(unMaybe(ty))
        if (s is not) return []
        if (seen.indexOf(s.id) >= 0) return []
        const ti: TypeInfo | not = typeInfoOf(types, s)
        if (ti is not) return []
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return []
        let props: AProp[] = []
        if (v is given) props = propsOf(v)
        // a spread of the place itself keeps the fields no LATER property names —
        // only when it is the last spread (`{ ...@b, ...other }`: `other` may override)
        let selfSpread = false
        for (const pr of props) {
            if (pr.spread) selfSpread = key != "" && placeKey(pr.value) == key
        }
        let out: TapeHit[] = []
        for (const fd of fs) {
            const name: string = fd.sym.hint
            const sub: string = memberKey(key, name)
            const at: string = label + "." + name
            let fv: AExpr | not = not
            let kept = false
            const pr: AProp | not = namedProp(props, name)
            if (pr is given) {
                fv = pr.value
                if (sub != "" && placeKey(pr.value) == sub) kept = true
            } else if (selfSpread) {
                kept = true
            }
            if (!kept) {
                if (tapeGrants(fd.ty) is given) {
                    out = out.concat([{ path: at, ty: fd.ty, grants: fd.grants, inner: false }])
                    out = out.concat(innerTapeHits(types, fd.ty, at, seen.concat([s.id])))
                } else {
                    out = out.concat(structTapeWrites(types, fd.ty, fv, sub, at, seen.concat([s.id])))
                }
            }
        }
        return out
    }

    // s472-boot-map-grants (RULED S472 "five PA recs" item 1): every tape the
    // ELEMENTS of tape `tape` hold, at any depth — an element that is itself a
    // tape (and what ITS elements hold), and each tape field reached through an
    // element struct (and what its elements hold). A whole write of `tape` that
    // does not keep its elements replaces each of them, so each needs its own
    // `replace` (§66.12.6 rule 1, "in each position that can hold one"). `seen`
    // stops a recursive struct; an enum element is not walked (RULED S469).
    fn innerTapeHits(types: TypeInfo[], tape: Type, label: string, seen: int[]) -> TapeHit[] {
        const el: Type | not = seqElem(unMaybe(tape))
        if (el is not) return []
        const at: string = label + "[…]"
        const tg: GrantSet | not = tapeGrants(el)
        let out: TapeHit[] = []
        if (tg is given) {
            out = out.concat([{ path: at, ty: el, grants: tg, inner: true }])
            return out.concat(innerTapeHits(types, el, at, seen))
        }
        for (const h of structTapeWrites(types, el, not, "", at, seen)) {
            out = out.concat([{ path: h.path, ty: h.ty, grants: h.grants, inner: true }])
        }
        return out
    }

    // s472-boot-map-grants — a write of a whole TAPE (`label = value`, the place
    // spelled `key`) judged for the tapes its elements hold (innerTapeHits; RULED
    // S472 items 1 and 2):
    //   - a value that IS the place (`xs = xs`) keeps every element: nothing;
    //   - a PERMUTATION written back (`xs = xs.sort(…)`, `.sort()`, `.reverse()`) is
    //     EXEMPT — "they create no new element value" (item 2);
    //   - an append / prepend / filter shape (§66.11.2) keeps each element it does
    //     not add or drop: nothing — unless `whole`: the write lowers to a WHOLE
    //     replace of the tape (a sub-field tape, Core FieldAt), judged as one;
    //   - anything else — a map (a spreading or identity map included: "A map that
    //     rebuilds elements … is not a permutation and stays judged"), a literal, a
    //     name, a helper's result — replaces every element, so every inner tape
    //     needs `replace` (item 1: "or any whole write … RECURSIVELY").
    fn tapeWriteInnerProblems(types: TypeInfo[], key: string, value: AExpr, tape: Type, label: string, whole: boolean) -> TapeDiag[] {
        if (key != "" && placeKey(value) == key) return []
        const shape: int = seqEditShapeKey(key, value)
        if (shape == 4 && seqPermutation(value)) return []
        if (!whole && shape > 0 && shape < 4) return []
        let what: string = "`" + label + " = …` replaces `" + label + "` whole"
        if (shape == 4) what = "`" + label + " = …` is a map written back (§66.11.2: a position write of every position), so it replaces each element of `" + label + "` — the callback is not walked"
        return innerTapeProblems(types, tape, label, what)
    }

    // The first tape the elements of `tape` hold whose type does not grant `replace`.
    fn innerTapeProblems(types: TypeInfo[], tape: Type, label: string, what: string) -> TapeDiag[] {
        for (const h of innerTapeHits(types, tape, label, [])) {
            if (!grantsAdmit(h.grants, EditKind.Replace)) return [innerTapeDiag(what, h)]
        }
        return []
    }

    fn innerTapeDiag(what: string, h: TapeHit) -> TapeDiag {
        return { code: "E-WRITE-NOT-GRANTED", msg: what + " — and so the tape `" + h.path + "` (`" + tapeTypeName(h.ty) + "`) its elements hold, whose type does not grant `replace`. An outer `replace` does not override an inner tape's grants: a whole write of a tape is a `replace` of every tape its elements hold, at any depth (§66.12.6 rule 1, RULED S472). Edit the inner tapes in place, keep the elements (`sort` / `reverse` written back are exempt), or add `replace` to the inner tape's type" }
    }

    // `value` is `x.sort(…)` / `x.sort()` / `x.reverse()` — a permutation of `x`'s
    // elements (§66.12.6 rule 3), read off the parse tree.
    fn seqPermutation(value: AExpr) -> boolean {
        const m: MethodCall | not = callMethod(value)
        if (m is not) return false
        return m.method == "sort" || m.method == "reverse"
    }

    // The (last) non-spread property named `name` of an object literal.
    fn namedProp(ps: AProp[], name: string) -> AProp | not {
        let found: AProp | not = not
        for (const p of ps) {
            if (!p.spread && p.name == name) found = p
        }
        return found
    }

    // A refusal the reader produces, before it is attached to a pass's state
    // (the resolver's AS, the typer's TypeState).
    type TapeDiag:struct = { code: string, msg: string }

    // Each tape field a whole-struct write of `v` at `key` replaces, judged by
    // its own grants (`grantsAdmit(…, Replace)`): E-WRITE-NOT-GRANTED.
    fn structTapeProblems(types: TypeInfo[], ty: Type, v: AExpr | not, key: string, label: string) -> TapeDiag[] {
        let out: TapeDiag[] = []
        for (const h of structTapeWrites(types, ty, v, key, label, [])) {
            if (!grantsAdmit(h.grants, EditKind.Replace) && h.inner) {
                out = out.concat([innerTapeDiag("`" + label + " = …` replaces the tapes inside `" + label + "`", h)])
            } else if (!grantsAdmit(h.grants, EditKind.Replace)) {
                out = out.concat([{ code: "E-WRITE-NOT-GRANTED", msg: "`" + label + " = …` replaces the tape field `" + h.path + "` (`" + tapeTypeName(h.ty) + "`), whose type does not grant `replace` — a whole-struct write that changes a tape field is a `replace` of THAT field, judged by the field's own grants, not the struct's (§66.12.6 rule 4). Keep the field as it was (`" + lastSegment(h.path) + ": " + h.path + "`), or spread the struct (`{ ..." + label + ", f: v }`)" }])
            }
        }
        return out
    }

    fn checkStructTapes(env: Env, ty: Type, v: AExpr | not, key: string, label: string, span: ASpan, st0: AS) -> AS {
        let st: AS = st0
        for (const d of structTapeProblems(env.g.types, ty, v, key, label)) { st = addDiag(st, env.file, span, d.code, d.msg) }
        return st
    }

    // A tape type as written, grants included (`Entry[free, append]`) —
    // typeName prints the element only.
    fn tapeTypeName(t: Type) -> string {
        const i: Type | not = maybeInner(t)
        if (i is given) return tapeTypeName(i) + " | not"
        const u: Type = t
        return match u {
            .Seq(elem: e, grants: g) :> elemName(e) + "[" + grantWords(g).join(", ") + "]"
            .Int :> typeName(t)
            .Num :> typeName(t)
            .Str :> typeName(t)
            .Bool :> typeName(t)
            .Named(sym: s) :> typeName(t)
            .Maybe(inner: x) :> typeName(t)
        }
    }

    fn grantWords(g: SeqGrants) -> string[] {
        let out: string[] = []
        const len: LengthGrant = g.length
        const lw: string = match len {
            .Free :> "free"
            .Bounded(min: a, max: b) :> "" + a + "..=" + b
            .Fixed :> ""
        }
        if (lw != "") out = out.concat([lw])
        for (const a of g.at) { out = out.concat([growWord(a)]) }
        for (const a of g.shrink) { out = out.concat([shrinkWord(a)]) }
        if (g.positionsWritable) out = out.concat(["write"])
        if (g.replace) out = out.concat(["replace"])
        return out
    }

    fn growWord(a: SeqAt) -> string {
        return match a {
            .End :> "append"
            .Front :> "prepend"
            .Anywhere :> "insert"
        }
    }

    fn shrinkWord(a: SeqAt) -> string {
        return match a {
            .End :> "pop"
            .Front :> "shift"
            .Anywhere :> "remove"
        }
    }

    fn resetTapeMessage(what: string, path: string) -> string {
        return what + " replaces the tape field `" + path + "` whenever it has changed since construction, and that field's type does not grant `replace` (§66.12.6 rule 4: a reset does not waive a tape field's grants). Whether the reset changes it is known only at run time, and the bootstrap has no run-time grant check — refused, not approximated (grant `replace` on the field's type, or reset the other fields by name)"
    }

    // The written place as a message names it: its spelling, else `@name`.
    fn writtenLabel(key: string, hint: string) -> string {
        if (key != "") return key
        return "@" + hint
    }

    fn lastSegment(path: string) -> string {
        const i: int = path.lastIndexOf(".")
        if (i < 0) return path
        return path.substring(i + 1)
    }

    // A whole-value write to a struct with a tape field it cannot judge
    // statically (`reset`, `reset-on=`: whether the reset changes a tape field
    // depends on its value at run time) — the first such field, or "".
    fn resetTapeProblem(types: TypeInfo[], ty: Type, label: string) -> string {
        for (const h of structTapeWrites(types, ty, not, "", label, [])) {
            if (!grantsAdmit(h.grants, EditKind.Replace)) return h.path
        }
        return ""
    }

    // §66.12.6 rule 4 / O63 (RULED S469): rebinding a local whose type is a
    // tape IS a tape write — classified by the §66.11.2 shapes (`out = [...out,
    // e]` an end-append, `out = out.filter(…)` a shrink-anywhere, `out =
    // out.map(…)` / `.sort()` / `.reverse()` a position write) or else a
    // `replace`, and judged by the TYPE's grants: a local `let` grants nothing,
    // and an un-annotated local's inferred type carries none (rule 1: inference
    // never invents a grant). A struct local's rebinding replaces its tape
    // fields (structTapeWrites). Run by the TYPER (typeAssign), where an
    // un-annotated local's type is known; a local of unknown type is not judged.
    fn localTapeProblems(types: TypeInfo[], name: string, lt: Type, value: AExpr) -> TapeDiag[] {
        const tg: GrantSet | not = tapeGrants(lt)
        if (tg is not) return structTapeProblems(types, lt, value, name, name)
        const te: TapeDiag[] = localTapeEdit(name, tapeTypeName(lt), tg, growsFixed(lt), value)
        if (te.length > 0) return te
        // s472-boot-map-grants: a whole write replaces the tapes its elements hold (RULED S472)
        return tapeWriteInnerProblems(types, name, value, lt, name, false)
    }

    // The written type of the parameter `s` binds, if `s` is a parameter.
    fn paramTypeOfSym(t: Tables, s: Sym) -> Type | not {
        for (const f of t.binds.facts) {
            const bs: Sym | not = bindSym(f)
            if (bs is given) {
                if (bs.id == s.id) return boundParamType(f)
            }
        }
        return not
    }

    // An un-annotated local's type as §66.12.6 rule 1 reads it: a tape (or a
    // `T | not` of one) with its grants dropped — "inference never invents a grant".
    fn inferredTape(t: Type) -> Type {
        const i: Type | not = maybeInner(t)
        if (i is given) return Type.Maybe(inferredTape(i))
        return ungranted(t)
    }

    // An un-annotated local whose inferred type the typer could not settle
    // (`let ws = s.split(","); ws = [];` joins to unknown) but which the write
    // shows is a tape (an array literal, a recognized shape, a tape value):
    // inferred, so it carries no grant (§66.12.6 rule 1) — fail closed.
    fn inferredTapeProblems(name: string, value: AExpr, vt: Type | not) -> TapeDiag[] {
        let tapeVal: boolean = isArrayLit(value) || seqEditShapeKey(name, value) > 0
        if (vt is given) {
            if (tapeGrants(vt) is given) tapeVal = true
        }
        if (!tapeVal) return []
        return localTapeEdit(name, "inferred: no grants", noGrants(), false, value)
    }

    fn isArrayLit(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: es) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: x) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    fn localTapeEdit(name: string, tyText: string, tg: GrantSet, fixed: boolean, value: AExpr) -> TapeDiag[] {
        const shape: int = seqEditShapeKey(name, value)
        let edit: EditKind = EditKind.Replace
        let what: string = "a `replace` (an unclassified whole-value write, §66.11.2)"
        if (shape > 0) {
            edit = shapeEdit(shape)
            what = shapeWhat(shape)
        }
        if (!grantsAdmit(tg, edit)) {
            return [{ code: "E-WRITE-NOT-GRANTED", msg: "`" + name + " = …` rebinds the local tape `" + name + "` (`" + tyText + "`): it is " + what + ", which its type does not grant — on a local, `let` makes only the NAME rebindable and grants the tape nothing, not even `replace`, and an inferred type carries no grant (§66.12.6 rules 1 and 4, O63 ruled S469); write the grant in the type (`let " + name + ": T[…] = …`)" }]
        }
        // the invariants are checked on every write (§66.11.2): a fixed length never grows or shrinks
        if (fixed && shape > 0 && shape < 4) {
            return [{ code: "E-WRITE-INVARIANT", msg: "`" + name + "`: " + what + " changes the length of the local tape, and its type fixes the length (no `free` grant, §66.12.1–§66.12.2) — the write provably breaks the length invariant (§66.11.2)" }]
        }
        return []
    }

    // s472 — a POSITION write (`xs[i] = v`): granted by `write` (§66.12.2: "`write`
    // | positions may be overwritten in place (`xs[i] = v`; …)"; §66.12.6 rule 3:
    // "`xs[i] = v` | a position write | `write`"), or by `replace`, which subsumes
    // the edits (§66.11.3). `gs`: the written tape's grants — a cell's field
    // GrantSet (built from its type in fieldOf), or a tape TYPE's (below).
    fn positionWriteProblem(gs: GrantSet, label: string, tyText: string) -> TapeDiag[] {
        if (grantsAdmit(gs, EditKind.PositionWrite)) return []
        return [{ code: "E-WRITE-NOT-GRANTED", msg: "`" + label + " = …` is a position write (§66.12.6 rule 3: `xs[i] = v` is granted by `write`), which the tape's type (`" + tyText + "`) does not grant — add `write` to its grants (§66.12.2)" }]
    }

    // s472 r1 F1 — a position write REPLACES the element. When the element is itself a
    // tape (a tape of tapes), that is a `replace` of the inner tape, judged by ITS grants
    // (§66.12.6 rule 1: "A tape's grants govern every write to it … in each position that
    // can hold one"; rule 4's reading, as a struct element's tape fields are judged by
    // checkStructTapes). `elem`: the element type written.
    fn elemTapeReplaceProblem(elem: Type, label: string) -> TapeDiag[] {
        const tg: GrantSet | not = tapeGrants(elem)
        if (tg is not) return []
        if (grantsAdmit(tg, EditKind.Replace)) return []
        return [{ code: "E-WRITE-NOT-GRANTED", msg: "`" + label + " = …` replaces an element that is itself a tape (`" + tapeTypeName(elem) + "`): replacing it is a `replace` of that inner tape, which its type does not grant — a tape's grants govern it in every position, an element of another tape included (§66.12.6 rules 1 and 4); edit it in place (`" + label + "[j] = …`, `.append(…)` where granted) or add `replace` to the inner tape's grants" }]
    }

    // s472 — a position write of a tape held by a local, or reached through one:
    // judged by the tape TYPE's grants (§66.12.3 "Permissions live on the TYPE").
    // `tyText` names the type for the message (an inferred one says so).
    fn tapePositionProblem(t: Type, label: string, tyText: string) -> TapeDiag[] {
        const tg: GrantSet | not = tapeGrants(t)
        if (tg is not) return [{ code: "E-ASSIGN-TARGET", msg: "`" + label + " = …` writes a tape position, and the value written into is not a tape" }]
        return positionWriteProblem(tg, label, tyText)
    }

    // s472 — a write to a FIELD of a local's value (`p.f = v`, `a.b.f = v`,
    // `xs[i].f = v`), judged by the DEEPEST field written (dpa-052 Q6, RULED S440)
    // — its own contract (§66.11.4: "a field write is an edit — a field is writable
    // along its own contract"; dpa-052 Q2 / O14, RULED S440: "Field and tape
    // contracts govern local (non-cell) values too"):
    //   - a TAPE field: the write is classified (§66.11.2) and checked against the
    //     field's OWN grants, never the holder's (§66.12.6 rules 1 and 4);
    //   - a `let` field: its own `replace`;
    //   - a contract-free field: "A contract-free sub-field does not bound a
    //     replace (O57 = no)" — it is written under the replace its root grants.
    //     For a local that is rebinding the local (§66.11.5: "it stays under §50"):
    //     `rootLet` — the local is a `let` — and the write is the same transition as
    //     the rebinding `p = { ...p, f: v }` (§66.11.2: "A write is judged by the
    //     old → new transition it performs, not by how it is spelled"). Not through
    //     a tape position (`inTape`): an element field is judged by its own
    //     contract alone (dpa-052 Q3, RULED S440).
    fn localFieldWriteProblem(types: TypeInfo[], fd: FieldDef, key: string, label: string, value: AExpr, rootLet: boolean, inTape: boolean, root: string) -> TapeDiag[] {
        if (seqElem(unMaybe(fd.ty)) is given) {
            const shape: int = seqEditShapeKey(key, value)
            let edit: EditKind = EditKind.Replace
            let what: string = "a `replace` of it (an unclassified whole-value write, §66.11.2)"
            if (shape > 0) {
                edit = shapeEdit(shape)
                what = shapeWhat(shape)
            }
            if (!grantsAdmit(fd.grants, edit)) {
                return [{ code: "E-WRITE-NOT-GRANTED", msg: "`" + label + " = …` writes the tape field `" + fd.sym.hint + "` (`" + tapeTypeName(fd.ty) + "`): it is " + what + ", which the field's type does not grant — a tape field is judged by its OWN grants, whatever holds it (§66.12.6 rules 1 and 4)" }]
            }
            if (growsFixed(fd.ty) && shape > 0 && shape < 4) {
                return [{ code: "E-WRITE-INVARIANT", msg: "`" + label + "`: " + what + " changes the length of the tape, and its type fixes the length (no `free` grant, §66.12.1–§66.12.2) — the write provably breaks the length invariant (§66.11.2)" }]
            }
            // s472-boot-map-grants: a whole write replaces the tapes its elements hold (RULED S472)
            return tapeWriteInnerProblems(types, key, value, fd.ty, label, false)
        }
        if (grantsAdmit(fd.grants, EditKind.Replace)) return []
        if (rootLet && !inTape && !grantsHasEdits(fd.grants)) return []
        if (inTape) return [{ code: "E-WRITE-NOT-GRANTED", msg: "`" + label + " = …` writes the field `" + fd.sym.hint + "` of a tape element, and `" + fd.sym.hint + "` carries no contract — it is fixed (§66.11.4; an element-field write is judged by that field's own contract alone, dpa-052 Q3): declare it `let " + fd.sym.hint + "` in its struct" }]
        return [{ code: "E-WRITE-NOT-GRANTED", msg: "`" + label + " = …` writes the field `" + fd.sym.hint + "`, which carries no contract — it is fixed (§66.11.4), and `" + root + "` cannot be rebound (a `const`, a parameter or a loop binder, §50), so nothing grants the write (dpa-052 Q2: field contracts govern local values) — declare the field `let " + fd.sym.hint + "` in its struct, or copy the value into a `let` local and write that" }]
    }

    // §66.12.3: a callee can do only what its parameter type grants, so a PLACE
    // passed to a tape parameter must grant at least what the parameter does
    // (a more-permissive argument is accepted; ruled S435 "type"). "" when it
    // does, else the first grant it lacks.
    fn argTapeProblem(arg: Type, param: Type) -> string {
        const pg: GrantSet | not = tapeGrants(param)
        const ag: GrantSet | not = tapeGrants(arg)
        if (pg is not || ag is not) return ""
        if (pg.replace && !ag.replace) return "`replace`"
        for (const e of pg.edits) {
            if (!grantsAdmit(ag, e)) return editWord(e)
        }
        return ""
    }

    fn editWord(e: EditKind) -> string {
        return match e {
            .Replace :> "`replace`"
            .Append :> "`append`"
            .Prepend :> "`prepend`"
            .Anywhere :> "`insert`"
            .PositionWrite :> "`write`"
            .RemoveEnd :> "`pop`"
            .RemoveFront :> "`shift`"
            .RemoveAnywhere :> "`remove`"
            .FieldAt(path: p) :> "a field write"
            .Transition :> "a transition"
            .ElemAt(index: i) :> "an element-field write"
            .PositionAt(index: i) :> "`write`"
        }
    }
    // ---- s469 MED-1: the TYPE-derived grants (a tape type's SeqGrants, its written grant words) are read here too ----
    // `T[g, …]` (O10 bracket form, ruled S469): the grant words are permission AXES
    // (§66.12.2). Core's SeqGrants.at holds the GROW places, SeqGrants.shrink
    // the SHRINK places (s444: Core's RemoveEnd / RemoveFront / RemoveAnywhere
    // edits; FieldInfo.shrink stays the analyze-side copy the classifier reads).
    fn resolveSeqType(te: TypeEnv, at: AType, elem: AType, gs: string[], st0: AS) -> RType {
        const re: RType = resolveType(te, elem, st0)
        let st: AS = re.st
        let length: LengthGrant = LengthGrant.Fixed
        let where: SeqAt[] = []
        let shrinks: SeqAt[] = []
        let write = false
        let rep = false
        let seen: string[] = []
        for (const g of gs) {
            const ax: GrantAxis = grantAxis(g)
            // r2 N3: a grant named twice is refused (E-GRANT-UNKNOWN: the list
            // is a SET of axis values; a repeat is not a value of any axis)
            if (seen.indexOf(g) >= 0) {
                st = addDiag(st, te.file, at.span, "E-GRANT-UNKNOWN", "`" + g + "` is granted twice — a grant list names each permission once (§66.12.2)")
            }
            seen = seen.concat([g])
            if (ax == GrantAxis.GFree) {
                length = LengthGrant.Free
            } else if (ax == GrantAxis.GWrite) {
                write = true
            } else if (ax == GrantAxis.GReplace) {
                // s469-boot-tape-grants: on the TYPE too (§66.12.3), so a local's or a
                // parameter's tape carries it; a field's GrantSet reads it as well (seqReplace)
                rep = true
            } else {
                const gp: SeqAt | not = growAt(ax)
                const sp: SeqAt | not = shrinkAt(ax)
                if (gp is given) {
                    where = where.concat([gp])
                } else if (sp is given) {
                    shrinks = shrinks.concat([sp])
                } else {
                    st = addDiag(st, te.file, at.span, "E-GRANT-UNKNOWN", grantUnknownMessage(g, ax))
                }
            }
        }
        return { t: Type.Seq(re.t, { length: length, at: where, shrink: shrinks, replace: rep, positionsWritable: write }), st: st, unresolved: re.unresolved }
    }

    // The SHRINK places a written sequence type grants (`pop` / `shift` / `remove`).
    fn shrinkOf(aty: AType | not) -> SeqAt[] {
        if (aty is not) return []
        return shrinkWords(aty)
    }

    fn shrinkWords(aty: AType) -> SeqAt[] {
        const k: ATypeK = aty.k
        return match k {
            .TSeq(elem: e, grants: gs) :> shrinkList(gs)
            .TName(name: n) :> []
            .TMaybe(inner: i) :> []
        }
    }

    fn shrinkList(gs: string[]) -> SeqAt[] {
        let out: SeqAt[] = []
        for (const g of gs) {
            const a: SeqAt | not = shrinkAt(grantAxis(g))
            if (a is given) out = out.concat([a])
        }
        return out
    }

    // Does a sequence type expression grant `replace` in its brackets?
    fn seqReplace(at: AType) -> boolean {
        const k: ATypeK = at.k
        return match k {
            .TSeq(elem: e, grants: gs) :> gs.indexOf("replace") >= 0
            .TName(name: n) :> false
            .TMaybe(inner: i) :> seqReplace(i)      // s469-boot-tape-grants: `T[replace] | not` grants `replace` (resolveSeqType puts it on the type the same way)
        }
    }

    // The edit grants a (resolved) type carries (§66.12.2 axes → EditKinds).
    fn typeEdits(t: Type) -> EditKind[] {
        return match t {
            .Seq(elem: e, grants: g) :> seqEdits(g)
            .Int :> []
            .Num :> []
            .Str :> []
            .Bool :> []
            .Named(sym: s) :> []
            .Maybe(inner: i) :> []
        }
    }

    fn seqEdits(g: SeqGrants) -> EditKind[] {
        let out: EditKind[] = []
        for (const a of g.at) { out = out.concat([seqAtEdit(a)]) }
        // RULED S442: an anywhere-grow (`insert`) grant admits appends and prepends
        if (hasEditKind(out, EditKind.Anywhere)) {
            if (!hasEditKind(out, EditKind.Append)) out = out.concat([EditKind.Append])
            if (!hasEditKind(out, EditKind.Prepend)) out = out.concat([EditKind.Prepend])
        }
        if (g.positionsWritable) out = out.concat([EditKind.PositionWrite])
        // s444: the SHRINK edits; RULED S442 "anywhere COVERS end and front" —
        // a `remove` grant pops and shifts
        for (const a of g.shrink) { out = addEditOnce(out, seqShrinkEdit(a)) }
        if (hasEditKind(out, EditKind.RemoveAnywhere)) {
            out = addEditOnce(out, EditKind.RemoveEnd)
            out = addEditOnce(out, EditKind.RemoveFront)
        }
        return out
    }

    fn addEditOnce(es: EditKind[], k: EditKind) -> EditKind[] {
        if (hasEditKind(es, k)) return es
        return es.concat([k])
    }

    fn seqShrinkEdit(a: SeqAt) -> EditKind {
        return match a {
            .End :> EditKind.RemoveEnd
            .Front :> EditKind.RemoveFront
            .Anywhere :> EditKind.RemoveAnywhere
        }
    }

    fn seqAtEdit(a: SeqAt) -> EditKind {
        return match a {
            .End :> EditKind.Append
            .Front :> EditKind.Prepend
            .Anywhere :> EditKind.Anywhere
        }
    }

    // The struct sub-field writes a field of struct type grants (M1 D12: a
    // field whose writable part is a sub-field lists `FieldAt(path)`): each
    // sub-field that has its own `let` or `rule=` graph.
    fn subFieldEdits(g: TypeInfo[], ty: Type) -> EditKind[] {
        const s: Sym | not = namedOf(ty)
        if (s is not) return []
        const ti: TypeInfo | not = typeInfoOf(g, s)
        if (ti is not) return []
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return []
        let out: EditKind[] = []
        let i = 0
        for (const fd of fs) {
            if (grantsAdmit(fd.grants, EditKind.Replace)) out = out.concat([EditKind.FieldAt([{ owner: s, idx: i }])])
            i = i + 1
        }
        return out
    }

    // A sequence type with no grant (`T[]`, §66.12.1 — omission is fully constrained).
    fn fixedSeq() -> SeqGrants { return { length: LengthGrant.Fixed, at: [], shrink: [], positionsWritable: false, replace: false } }

    fn anySeqGrants() -> SeqGrants { return { length: LengthGrant.Free, at: [], shrink: [], positionsWritable: false, replace: false } }

    // r1 F7: a sequence type whose length axis is FIXED (no `free` / bound,
    // §66.12.1: omission is fully constrained) cannot grow — provably, so a
    // growing edit is a compile error (§66.11.2 invariants; dpa-052 Q5).
    fn growsFixed(t: Type | not) -> boolean {
        if (t is not) return false
        return seqFixed(t)
    }

    fn isFixedLength(l: LengthGrant) -> boolean {
        return match l {
            .Fixed :> true
            .Free :> false
            .Bounded(min: a, max: b) :> false
        }
    }

    fn seqFixed(t: Type) -> boolean {
        return match t {
            .Seq(elem: el, grants: g) :> isFixedLength(g.length)
            .Int :> false
            .Num :> false
            .Str :> false
            .Bool :> false
            .Named(sym: x) :> false
            .Maybe(inner: i) :> false
        }
    }

    // s474 (client-bang composition, composeFiles): a written tape type `T[g…]` copied into the
    // composed batch's parameter list — its grant words carried whole, as written (no grant is read)
    fn seqAType(r: RTy, sp: ASpan, gs: string[]) -> RTy {
        return { ty: { nid: r.next, span: sp, k: ATypeK.TSeq(r.ty, gs) }, next: r.next + 1 }
    }

    // ---- END OF THE TAPE GRANT READER (tape-write-forms.test.js: no grant is read outside it) ----

    // =========================================================================
    // s442 — recognized sequence edit shapes (§66.11.2: "Edits … are classified
    // at compile time, from mutating method calls AND from recognized
    // reassignment shapes").
    //   1  `@x = [...@x, e1, …]`   an end-append per element
    //   2  `@x = [e1, …, ...@x]`   a front-prepend per element
    //   3  `@x = @x.filter(λ)`     a shrink-anywhere
    //   4  `@x = @x.map(λ)`        a position-write
    // 0 = not a recognized shape (an unclassifiable reassignment is a replace).
    // =========================================================================
    fn seqEditShape(target: AExpr, value: AExpr) -> int {
        return seqEditShapeKey(placeKey(target), value)
    }

    // s469-boot-tape-grants: the classifier over the written place's SPELLING
    // (`@x`, `@b.xs`, a local `out`), so a field write and a local rebinding
    // classify exactly as a cell write does (§66.12.6 rule 4).
    fn seqEditShapeKey(key: string, value: AExpr) -> int {
        if (key == "") return 0
        const es: AExpr[] = arrayElems(value)
        if (es.length >= 2) {
            const first: AExpr | not = spreadInner(es[0])
            const last: AExpr | not = spreadInner(es[es.length - 1])
            if (countSpreads(es) == 1) {
                if (first is given) {
                    if (placeKey(first) == key) return 1
                }
                if (last is given) {
                    if (placeKey(last) == key) return 2
                }
            }
            return 0
        }
        const m: MethodCall | not = callMethod(value)
        if (m is given) {
            if (placeKey(m.obj) == key) {
                if (m.method == "filter") return 3
                if (m.method == "map" || m.method == "sort" || m.method == "reverse") return 4      // s469: sort / reverse keep the length and move positions (§66.12.6 rule 3)
            }
        }
        return 0
    }

    fn countSpreads(es: AExpr[]) -> int {
        let n = 0
        for (const x of es) {
            if (spreadInner(x) is given) n = n + 1
        }
        return n
    }

    fn arrayElems(e: AExpr) -> AExpr[] {
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: es) :> es
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: x) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Index(obj: o) :> []
            .Lambda(params: ps) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    fn spreadInner(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Spread(e: x) :> x
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    // `obj.method(…)` as a value: the call's method, when its callee is a member.
    fn callMethod(e: AExpr) -> MethodCall | not {
        const k: AExprK = e.k
        return match k {
            .Call(callee: c) :> memberCall(c)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn memberCall(c: AExpr) -> MethodCall | not {
        const k: AExprK = c.k
        return match k {
            .Member(obj: o, name: n) :> methodNamed(o, n)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: x) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn methodNamed(o: AExpr, n: string) -> MethodCall { return { obj: o, method: n } }

    fn shapeEdit(shape: int) -> EditKind {
        if (shape == 1) return EditKind.Append
        if (shape == 2) return EditKind.Prepend
        if (shape == 3) return EditKind.RemoveAnywhere      // RULED S442: `filter` SHRINKS anywhere — the `remove` grant
        return EditKind.PositionWrite
    }

    fn shapeWhat(shape: int) -> string {
        if (shape == 1) return "an end-append (§66.11.2: `@x = [...@x, e]` is the same edit as `@x.append(e)`)"
        if (shape == 2) return "a front-prepend (`@x = [e, ...@x]`)"
        if (shape == 3) return "a shrink-anywhere (§66.11.2: `@x = @x.filter(…)`; the `remove` grant)"
        return "a position-write (§66.11.2: `@x = @x.map(…)`, `.sort(…)`, `.reverse()`)"
    }

    fn resolveSeqShape(env: Env, e: AExpr, target: AExpr, value: AExpr, shape: int, st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, target, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, target.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        if (p.path.length > 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "an edit of a sub-field sequence is not in bootstrap slice M2")
        // r1 nit: the shape over a value that is not a sequence is a type error
        const pty: Type | not = p.ty
        if (pty is given) {
            if (seqElem(pty) is not) {
                return addDiag(st, env.file, e.span, "E-TYPE-031", "`@" + f.sym.hint + "` is `" + typeName(pty) + "`, not a sequence — `[…]` is not a value of its type (§66.1 rule 5)")
            }
        }
        const edit: EditKind = shapeEdit(shape)
        const cap: Sym | not = f.wcap
        // RULED S442: `filter` SHRINKS anywhere — the `remove` grant, not `insert` (shapeEdit)
        const isGranted: boolean = grantsAdmit(f.grants, edit)
        // s444: every granted shape lowers, so a granted field always has a
        // write capability (its grants list the edit — seqEdits)
        if (!isGranted || cap is not) {
            const isDerived: boolean = f.mode == FieldMode.Derived
            if (isDerived) return addDiag(st, env.file, e.span, "E-DERIVED-WRITE", derivedMessage(p, f))
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + " = …` is " + shapeWhat(shape) + ", which `" + f.sym.hint + "`'s type does not grant (§66.12.2)")
        }
        // r2 N2: `filter` shrinks — impossible on a fixed-length sequence
        if (shape == 3 && growsFixed(p.ty)) return addDiag(st, env.file, e.span, "E-WRITE-INVARIANT", fixedShrinkMessage(f.sym.hint, shapeWhat(shape)))
        if (shape > 2) {
            // s444: `@x = @x.filter(λ)` — a RemoveAnywhere whose value is the
            // filtered sequence (C9: a filter of the field itself); `@x =
            // @x.map(λ)` — a PositionWrite of the mapped sequence
            const nd: int = st.diags.length
            st = resolveExpr(env, value, p.ty, st).st
            // s472-boot-map-grants: a map written back replaces every element — the
            // tapes they hold, by their own grants, at any depth; a sort / reverse is
            // exempt (RULED S472). After the value resolves, so a more basic refusal
            // of it (a two-parameter callback, a sort with no natural order) comes first.
            if (st.diags.length > nd) return st
            const ed: TapeDiag[] = tapeWriteInnerProblems(env.g.types, placeKey(target), value, f.ty, writtenLabel(placeKey(target), f.sym.hint), false)
            if (ed.length > 0) return addDiag(st, env.file, e.span, ed[0].code, ed[0].msg)
            if (cap is not) return noCapability(env, e, st)
            if (shape == 3) return addEffect(st, e.nid, EffectFact.EWrite({ cap: cap, inst: p.inst, edit: EditKind.RemoveAnywhere, check: Check.Static }))
            return addEffect(st, e.nid, EffectFact.EWrite({ cap: cap, inst: p.inst, edit: EditKind.PositionWrite, check: Check.Static }))
        }
        // r1 F7: growing a FIXED-length sequence breaks its length invariant
        if (growsFixed(p.ty)) return addDiag(st, env.file, e.span, "E-WRITE-INVARIANT", fixedLengthMessage(f.sym.hint, shapeWhat(shape)))
        let elemTy: Type | not = not
        const pt: Type | not = p.ty
        if (pt is given) elemTy = seqElem(pt)
        let elems: AExpr[] = []
        let tmps: Sym[] = []
        for (const x of arrayElems(value)) {
            const inner: AExpr | not = spreadInner(x)
            if (inner is given) {
                // the operand `...@x` reads the target itself (a read, no check)
                st = resolveExpr(env, inner, pt, st).st
            } else {
                st = resolveExpr(env, x, elemTy, st).st
                elems = elems.concat([x])
                // r1 F5/F6: the array is ONE value — every new element is
                // evaluated (left to right) into its local before any write
                const m: RSym = mint(st, "elem")
                st = m.st
                tmps = tmps.concat([m.s])
            }
        }
        const sn: RSym = mint(st, "before_" + f.sym.hint)
        st = sn.st
        const snap: SeqSnap = { local: sn.s, decl: p.decl.sym, idx: p.idx }
        return addEffect(st, e.nid, EffectFact.EEdits({ cap: cap, inst: p.inst, edit: edit, check: Check.Static }, elems, tmps, snap))
    }

    // r1 F1: is the place `e` names rooted in a local (a `let` / `const`, a
    // parameter, a row binding)? Such a place is not a cell: the sequence
    // shapes and edit calls classify CELL writes only.
    fn rootIsLocal(env: Env, e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> lookupLocal(env, n) is given
            .Member(obj: o) :> rootIsLocal(env, o)
            .Index(obj: o) :> rootIsLocal(env, o)
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: x) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // An edit method on a local sequence: its values are resolved, and it is
    // refused — Core has no in-place edit of a local (dpa-052 Q2 puts locals
    // under their type's grants; the bootstrap cannot lower one either way).
    fn localEditRefused(env: Env, e: AExpr, method: string, args: AExpr[], st0: AS) -> AS {
        const st: AS = resolveExprs(env, args, not, st0)
        return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`." + method + "(…)` on a local sequence is not in the bootstrap — Core has no edit of a local (write a new value: `let t = …`)")
    }

    fn fixedShrinkMessage(name: string, what: string) -> string {
        return "`@" + name + "`: " + what + " shrinks the sequence, and its type fixes the length (no `free` grant, §66.12.1–§66.12.2) — the write provably breaks the length invariant (§66.11.2)"
    }

    fn fixedLengthMessage(name: string, what: string) -> string {
        return "`@" + name + "`: " + what + " grows the sequence, and its type fixes the length (no `free` grant, §66.12.1–§66.12.2) — the write provably breaks the length invariant (§66.11.2)"
    }

    fn callMethodName(v: AExpr) -> string {
        const m: MethodCall | not = callMethod(v)
        if (m is given) return m.method
        return "?"
    }

    // s444: a write the classifier GRANTED whose field has no write capability
    // — impossible by construction (a granted edit is in the field's grants,
    // so the field has a capability, §66.11.1 / check.scrml C1). Reported, never
    // dropped silently.
    fn noCapability(env: Env, e: AExpr, st: AS) -> AS {
        return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "internal: this write is granted but its field has no write capability (a bootstrap defect — please report it)")
    }

    // `@x.shift()` / `@x.pop()` — a removal at the front / end (§66.12.2: the
    // "where it changes" axis; `push` + `pop` = "changes at the end").
    fn removeCall(callee: AExpr) -> MethodCall | not {
        const m: MethodCall | not = memberCall(callee)
        if (m is not) return not
        if (m.method == "shift" || m.method == "pop") return m
        return not
    }

    fn resolveRemoveCall(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, m.obj, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, m.obj.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        if (p.path.length > 0) {
            // r3: a removal on a sub-field sequence is judged by THAT field's grants (dpa-052 Q6,
            // the deepest field written) — not tracked here; refused, as `.push` on one is
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + placeKey(m.obj) + "." + m.method + "()` — an edit of a sub-field sequence is not in bootstrap slice M2 (it would be judged by that field's own grants, dpa-052 Q6)")
        }
        let place: SeqAt = SeqAt.Front
        let what: string = "a removal at the front (the `shift` grant)"
        if (m.method == "pop") {
            place = SeqAt.End
            what = "a removal at the end (the `pop` grant)"
        }
        // RULED S442: a removal needs a SHRINK grant there (or `remove`), never the grow grant
        let redit: EditKind = EditKind.RemoveFront
        if (m.method == "pop") redit = EditKind.RemoveEnd
        const isGranted: boolean = grantsAdmit(f.grants, redit)
        // r3 nit: messages name the place written (`@r.xs`), not only its field (`@r`)
        const at: string = placeKey(m.obj)
        if (!isGranted) {
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`" + at + "." + m.method + "()` is " + what + ", which `" + at + "`'s type does not grant (§66.12.2)")
        }
        // r2 N2 (F7's mirror): a removal SHRINKS — impossible on a fixed-length sequence
        if (growsFixed(p.ty)) return addDiag(st, env.file, e.span, "E-WRITE-INVARIANT", fixedShrinkMessage(at.substring(1), what))
        if (args.length > 0) return addDiag(resolveExprs(env, args, not, st), env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + at + "." + m.method + "()` takes no argument")
        // s444: a removal of one element — Core RemoveEnd / RemoveFront (count 1)
        let edit: EditKind = EditKind.RemoveFront
        if (m.method == "pop") edit = EditKind.RemoveEnd
        const cap: Sym | not = f.wcap
        if (cap is not) return noCapability(env, e, st)
        return addEffect(st, e.nid, EffectFact.ERemove({ cap: cap, inst: p.inst, edit: edit, check: Check.Static }))
    }

    // `@xs[i].f = v` (dpa-052 Q3, RULED S440): an edit of field `f` at that
    // position, judged by `f`'s own contract — not a position replace, not the
    // `positions` permission. A field with no contract is fixed (§66.11.4).
    type ElemFieldTarget:struct = { seq: AExpr, index: AExpr, field: string }

    fn elemFieldTarget(t: AExpr) -> ElemFieldTarget | not {
        const k: AExprK = t.k
        return match k {
            .Member(obj: o, name: n) :> indexedField(o, n)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn indexedField(o: AExpr, n: string) -> ElemFieldTarget | not {
        const k: AExprK = o.k
        return match k {
            .Index(obj: s, idx: i) :> elemField(s, i, n)
            .Name(name: x) :> not
            .At(name: x) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: x) :> not
            .Member(obj: x) :> not
            .Call(callee: c) :> not
            .Unary(op: x) :> not
            .Binary(op: x) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn elemField(s: AExpr, i: AExpr, n: string) -> ElemFieldTarget { return { seq: s, index: i, field: n } }

    fn resolveElemFieldWrite(env: Env, e: AExpr, ef: ElemFieldTarget, value: AExpr, st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, ef.seq, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, ef.seq.span, st)
        st = resolveExpr(env, ef.index, Type.Int, st).st
        const f: FieldInfo = p.decl.fields[p.idx]
        let elem: Type | not = not
        const pt: Type | not = p.ty
        if (pt is given) elem = seqElem(pt)
        let target: FieldDef | not = not
        let owner: string = ""
        let elemSym: Sym | not = not
        let targetIdx: int = -1
        if (elem is given) {
            const s: Sym | not = namedOf(elem)
            if (s is given) {
                const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
                if (ti is given) {
                    const fs: FieldDef[] | not = structFieldDefs(ti.def)
                    if (fs is given) {
                        owner = s.hint
                        elemSym = s
                        let k = 0
                        for (const fd of fs) {
                            if (fd.sym.hint == ef.field) {
                                target = fd
                                targetIdx = k
                            }
                            k = k + 1
                        }
                    }
                }
            }
        }
        if (owner == "") return addDiag(st, env.file, e.span, "E-ASSIGN-TARGET", "`@" + f.sym.hint + "[…]." + ef.field + "` — the elements of `@" + f.sym.hint + "` are not structs")
        if (target is not) return addDiag(st, env.file, e.span, "E-SCOPE-001", "`" + owner + "` has no field `" + ef.field + "`")
        st = resolveExpr(env, value, target.ty, st).st
        if (!grantsAny(target.grants)) {
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "[…]." + ef.field + " = …` is an edit of `" + owner + "." + ef.field + "`, which carries no contract — it is fixed (§66.11.4; an element-field write is judged by that field's own contract, dpa-052 Q3)")
        }
        // s444: `= v` REPLACES the element field — its contract must grant `replace`
        // (s469-boot-tape-grants: a tape element field by its own grants, the one reader)
        if (!grantsAdmit(target.grants, EditKind.Replace)) {
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "[…]." + ef.field + " = …` replaces `" + owner + "." + ef.field + "`, whose contract grants edits but no `replace` (§66.11.4, dpa-052 Q3)")
        }
        // a struct-typed element field: its tape fields are replaced with it (§66.12.6 rule 4)
        const stt: AS = checkStructTapes(env, target.ty, value, "", "@" + f.sym.hint + "[…]." + ef.field, e.span, st)
        if (stt.diags.length > st.diags.length) return stt
        const cap: Sym | not = f.wcap
        if (cap is not || elemSym is not) return noCapability(env, e, st)
        return addEffect(st, e.nid, EffectFact.EElemAt(cap, p.inst, ef.index, [{ owner: elemSym, idx: targetIdx }], env.file + ":" + lineOf(env.g, env.file, e.span.start)))
    }

    // =========================================================================
    // s472 — POSITION writes (`@xs[i] = v`) and writes to a PART of a local
    // (`p.f = v`, `xs[i] = v`, `a.b.c = v`, `xs[i].f = v`) — gaps
    // g-boot-position-write-s472, g-boot-local-part-write-s472.
    //
    // SPEC §66.12.6 rule 3: "`xs[i] = v` | a position write | `write`"; §66.12.2:
    // "`write` | positions may be overwritten in place (`xs[i] = v`; …)". Rule 1:
    // a tape's grants govern every write to it in a cell, a struct field, "a local
    // binding: `let`, `const`, or the keywordless binding", "a function parameter";
    // "Inference never invents a grant". §66.11.4: "a field write is an edit — a
    // field is writable along its own contract … a field with no contract is
    // fixed". dpa-052 Q2 (O14, RULED S440): "Field and tape contracts govern local
    // (non-cell) values too"; Q6: "a write is judged by the DEEPEST field written".
    // Every grant decision is made by the ONE tape grant reader (`grantsAdmit`,
    // `positionWriteProblem`, `localFieldWriteProblem` — inside its range).
    //
    // A local part write is VALUE semantics (§66.10): Core rebinds the local to a
    // copy with the part replaced (Stmt.Assign with a path) — no alias of the old
    // value sees the write. An index outside its tape is the
    // E-INDEX-OUT-OF-RANGE-RT trap at run time (§66.12.6 rule 3: a write at or past
    // the end "would create a position that holds no value"; §66.12.8 rule 7: "a
    // negative index WRITE `xs[-1] = v` traps"), and nothing is written.
    // =========================================================================
    type IndexTarget:struct = { seq: AExpr, index: AExpr }

    fn indexTarget(t: AExpr) -> IndexTarget | not {
        const k: AExprK = t.k
        return match k {
            .Index(obj: o, idx: i) :> indexPair(o, i)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn indexPair(o: AExpr, i: AExpr) -> IndexTarget { return { seq: o, index: i } }

    // `@xs[i] = v` — a position write of a CELL's tape (Core PositionAt).
    fn resolvePositionWrite(env: Env, e: AExpr, it: IndexTarget, value: AExpr, st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, it.seq, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        const lc: LocalB | not = rp.local
        if (lc is given) return partRefused(env, value, e.span, "E-ASSIGN-TARGET", "`" + lc.name + "[…] = …` — `" + lc.name + "` names an instance (narrowed by `given`), which has no positions; write one of its fields", st)
        if (p is not) return resolveExpr(env, value, not, resolveExpr(env, it.index, Type.Int, st).st).st
        st = writeGuards(env, p, it.seq.span, st)
        st = resolveExpr(env, it.index, Type.Int, st).st
        const f: FieldInfo = p.decl.fields[p.idx]
        const at: string = writtenLabel(placeKey(it.seq), f.sym.hint)
        const label: string = at + "[…]"
        let elem: Type | not = not
        const pt: Type | not = p.ty
        if (pt is given) elem = seqElem(pt)
        if (pt is given && elem is not) {
            if (maybeInner(pt) is given) return addDiag(resolveExpr(env, value, not, st).st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + label + " = …` writes a position of `" + at + "`, which is `" + typeName(pt) + "` — it may be `not`, so it has no positions; narrow it first")
            return addDiag(resolveExpr(env, value, not, st).st, env.file, e.span, "E-ASSIGN-TARGET", "`" + label + " = …` writes a tape position (§66.12.6 rule 3), and `" + at + "` is `" + typeName(pt) + "`, not a tape")
        }
        if (elem is not) return resolveExpr(env, value, not, st).st
        st = resolveExpr(env, value, elem, st).st
        // a tape reached through a struct field: Core writes a struct field only as a
        // whole (`replace`), as for every other edit of a sub-field tape (fieldAtWrite)
        if (p.path.length > 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + label + " = …` is a position write of a sub-field tape — Core writes a struct field only as a whole (`replace`), so an edit of a sub-field tape is not in the bootstrap yet")
        const pd: TapeDiag[] = positionWriteProblem(f.grants, label, tapeTypeName(f.ty))
        if (pd.length > 0) {
            if (f.mode == FieldMode.Derived) return addDiag(st, env.file, e.span, "E-DERIVED-VALUE-MUTATE", "`@" + f.sym.hint + "` is derived — an in-place edit of a derived value is an error (§6.6.18, §66.9)")
            return addDiag(st, env.file, e.span, pd[0].code, pd[0].msg)
        }
        const ed: TapeDiag[] = elemTapeReplaceProblem(elem, label)
        if (ed.length > 0) return addDiag(st, env.file, e.span, ed[0].code, ed[0].msg)
        // the element is replaced whole: each tape field of it the value changes is a
        // `replace` of that field, judged by its own grants (§66.12.6 rule 4)
        const stt: AS = checkStructTapes(env, elem, value, "", label, e.span, st)
        if (stt.diags.length > st.diags.length) return stt
        const cap: Sym | not = f.wcap
        if (cap is not) return noCapability(env, e, st)
        return addEffect(st, e.nid, EffectFact.EPosition(cap, p.inst, it.index, env.file + ":" + lineOf(env.g, env.file, e.span.start)))
    }

    // The local a PART write writes: the root of a member / index chain
    // (`p.f`, `xs[i]`, `a.xs[i].f`) when it is a local binding — not a bare name
    // (a rebinding), not a `given`-narrowed instance (its fields are cell fields).
    fn partLocal(env: Env, t: AExpr) -> LocalB | not {
        if (exprName(t) != "") return not
        const rn: AExpr | not = partRootName(t)
        if (rn is not) return not
        const l: LocalB | not = lookupLocal(env, exprName(rn))
        if (l is not) return not
        if (l.narrowed is given) return not
        return l
    }

    // The root name node of a member / index chain.
    fn partRootName(t: AExpr) -> AExpr | not {
        const k: AExprK = t.k
        return match k {
            .Name(name: n) :> t
            .Member(obj: o) :> partRootName(o)
            .Index(obj: o) :> partRootName(o)
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    // One source step of a part write, root first: a field `.n`, or a position `[i]`.
    type PartStep:struct = { field: string, index: AExpr | not }

    fn partSteps(t: AExpr) -> PartStep[] {
        const k: AExprK = t.k
        return match k {
            .Member(obj: o, name: n) :> partSteps(o).concat([fieldStep(n)])
            .Index(obj: o, idx: i) :> partSteps(o).concat([indexStep(i)])
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: x) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: x) :> []
            .Assign(target: x) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Lambda(params: ps) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    fn fieldStep(n: string) -> PartStep { return { field: n, index: not } }
    fn indexStep(i: AExpr) -> PartStep { return { field: "", index: i } }

    // The written part as the author spells it, the indices elided (`a.xs[…].f`).
    fn partLabel(root: string, ps: PartStep[]) -> string {
        let out: string = root
        for (const s of ps) {
            if (s.index is given) {
                out = out + "[…]"
            } else {
                out = out + "." + s.field
            }
        }
        return out
    }

    // A local's WRITTEN type: its annotation, or a parameter's type; `not` for an
    // un-annotated local (its type is inferred — §66.12.6 rule 1: "Inference never
    // invents a grant").
    fn writtenLocalType(st: AS, s: Sym) -> Type | not {
        for (const a of st.annots) {
            if (a.sym.id == s.id) return a.ty
        }
        for (const f of st.facts.binds.facts) {
            const bs: Sym | not = bindSym(f)
            if (bs is given) {
                if (bs.id == s.id) return boundParamType(f)
            }
        }
        return not
    }

    // The fields of a struct type (`not` for any other type).
    fn structFieldsOfType(env: Env, t: Type) -> FieldDef[] | not {
        const sy: Sym | not = namedOf(t)
        if (sy is not) return not
        const ti: TypeInfo | not = typeInfoOf(env.g.types, sy)
        if (ti is not) return not
        return structFieldDefs(ti.def)
    }

    fn isRowLocal(env: Env, l: LocalB) -> boolean {
        for (const r of env.rows) {
            if (r.bind.id == l.s.id) return true
        }
        return false
    }

    fn partRefused(env: Env, value: AExpr, span: ASpan, code: string, msg: string, st: AS) -> AS {
        return addDiag(resolveExpr(env, value, not, st).st, env.file, span, code, msg)
    }

    // A write to a PART of the local `l` (Core Assign with a path).
    fn resolveLocalPartWrite(env: Env, e: AExpr, target: AExpr, value: AExpr, l: LocalB, st0: AS) -> AS {
        const ps: PartStep[] = partSteps(target)
        const label: string = partLabel(l.name, ps)
        // an `<each>` row is a projection of its source's element: writing a copy of
        // it would not write the source, and writing the source is not this spelling
        if (isRowLocal(env, l)) return partRefused(env, value, target.span, "E-BOOTSTRAP-UNSUPPORTED", "a write to a part of the row `" + l.name + "` (`" + label + " = …`) is not in the bootstrap — a row is a read-only projection of its source's element; write the source cell", st0)
        // the local's name in the target is an APPEARANCE of the binding (§35.2:
        // "Every appearance of a `lin` identifier in a position that is not a
        // declaration SHALL count as a consumption event") — the same fact a read has
        let st: AS = st0
        const rn: AExpr | not = partRootName(target)
        if (rn is given) st = addName(st, rn.nid, NameFact.NLocal(l.s))
        // the indices are evaluated before the value, in source order
        for (const s of ps) {
            const ix: AExpr | not = s.index
            if (ix is given) st = resolveExpr(env, ix, Type.Int, st).st
        }
        const lt: Type | not = l.ty
        // a position of the local's OWN tape, its type inferred: whatever that type
        // is, inference gives it no grant (§66.12.6 rule 1) — refused as ungranted
        if (lt is not && ps.length > 0 && writtenLocalType(st, l.s) is not) {
            const ix0: AExpr | not = ps[0].index
            if (ix0 is given) {
                const pd0: TapeDiag[] = positionWriteProblem(noGrants(), label, "inferred: no grants — §66.12.6 rule 1; annotate it, `let " + l.name + ": T[write] = …`")
                if (pd0.length > 0) return partRefused(env, value, e.span, pd0[0].code, pd0[0].msg, st)
            }
        }
        if (lt is not) return partRefused(env, value, target.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + label + " = …` writes a part of `" + l.name + "`, whose type is not known here — annotate it (`let " + l.name + ": T = …`)", st)
        const loc: string = env.file + ":" + lineOf(env.g, env.file, e.span.start)
        let t: Type = lt
        let steps: LStep[] = []
        let lastField: FieldDef | not = not
        let lastTape: Type | not = not
        let sawIndex = false
        let fieldInTape = false
        let viaField = false          // a struct field step has been taken
        let tapeViaField = false      // ... before the last tape position
        let at: string = l.name
        for (const s of ps) {
            if (maybeInner(t) is given) return partRefused(env, value, target.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + label + " = …` writes through `" + at + "`, which is `" + typeName(t) + "` — it may be `not`, and a part write through a `T | not` value is not in the bootstrap yet; bind the present value first", st)
            const ix: AExpr | not = s.index
            if (ix is given) {
                const el: Type | not = seqElem(t)
                if (el is not) return partRefused(env, value, target.span, "E-ASSIGN-TARGET", "`" + label + " = …` writes a tape position (§66.12.6 rule 3), and `" + at + "` is `" + typeName(t) + "`, not a tape", st)
                steps = steps.concat([LStep.LIndex(ix, loc)])
                lastTape = t
                tapeViaField = viaField
                lastField = not
                sawIndex = true
                t = el
                at = at + "[…]"
            } else {
                const sy: Sym | not = namedOf(t)
                const fs: FieldDef[] | not = structFieldsOfType(env, t)
                // a named type with no struct fields here (a declaration's value, an
                // enum): not a write Core has — refused, never approximated
                if (sy is given && fs is not) return partRefused(env, value, target.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + label + " = …` writes `." + s.field + "` of `" + at + "`, a `" + sy.hint + "` — a part write of a value of this type (a declaration's value or an enum) is not in the bootstrap yet", st)
                if (sy is not || fs is not) return partRefused(env, value, target.span, "E-ASSIGN-TARGET", "`." + s.field + "` is not a field of a struct here — `" + at + "` is `" + typeName(t) + "`", st)
                let k: int = -1
                let i: int = 0
                for (const fd of fs) {
                    if (fd.sym.hint == s.field) k = i
                    i = i + 1
                }
                if (k < 0) return partRefused(env, value, target.span, "E-SCOPE-001", "`" + sy.hint + "` has no field `" + s.field + "`", st)
                steps = steps.concat([LStep.LField({ owner: sy, idx: k }, s.field)])
                lastField = fs[k]
                lastTape = not
                fieldInTape = sawIndex
                viaField = true
                t = fs[k].ty
                at = at + "." + s.field
            }
        }
        st = resolveExpr(env, value, t, st).st
        const key: string = placeKey(target)
        const tape: Type | not = lastTape
        const fd: FieldDef | not = lastField
        if (tape is given) {
            // a POSITION write, judged by the tape's TYPE. A tape reached through a
            // struct field carries the grants that field's declared type writes. One
            // reached only through positions of the local (the local's own tape, or a
            // tape element of it) is part of the local's type — its WRITTEN type (an
            // annotation, a parameter's) when it has one; an un-annotated local's type
            // is inferred, and "Inference never invents a grant" (§66.12.6 rule 1).
            let judged: Type = tape
            let tyText: string = tapeTypeName(tape)
            if (!tapeViaField && writtenLocalType(st, l.s) is not) {
                judged = ungranted(tape)
                tyText = "inferred: no grants — §66.12.6 rule 1; annotate it, `let " + l.name + ": T[write…] = …`"
            }
            const pd: TapeDiag[] = tapePositionProblem(judged, label, tyText)
            if (pd.length > 0) return addDiag(st, env.file, e.span, pd[0].code, pd[0].msg)
            // r1 F1: an element that is itself a tape is replaced — its own grants
            const ed: TapeDiag[] = elemTapeReplaceProblem(t, label)
            if (ed.length > 0) return addDiag(st, env.file, e.span, ed[0].code, ed[0].msg)
            // the element is replaced whole — its tape fields by their own grants (rule 4)
            const stt: AS = checkStructTapes(env, t, value, "", label, e.span, st)
            if (stt.diags.length > st.diags.length) return stt
        } else if (fd is given) {
            // a FIELD write: the deepest field's own contract (dpa-052 Q6); a
            // contract-free field is written under the local's rebinding (O57 = no,
            // §66.11.5) — only when no tape position lies between (dpa-052 Q3)
            const fp: TapeDiag[] = localFieldWriteProblem(env.g.types, fd, key, label, value, l.mutable, fieldInTape, l.name)
            if (fp.length > 0) return addDiag(st, env.file, e.span, fp[0].code, fp[0].msg)
            if (seqElem(unMaybe(fd.ty)) is not) {
                const stt: AS = checkStructTapes(env, fd.ty, value, key, label, e.span, st)
                if (stt.diags.length > st.diags.length) return stt
            }
        }
        return addEffect(st, e.nid, EffectFact.EAssignLocal(l.s, steps, t))
    }

    fn resolveBlock(env: Env, b: ABlock, st0: AS) -> AS {
        let st: AS = st0
        let env2: Env = env
        for (const s of b.stmts) {
            const r: RB = resolveStmt(env2, s, st)
            env2 = r.env
            st = r.st
        }
        return st
    }

    fn resolveStmt(env: Env, s: AStmt, st: AS) -> RB {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> keepEnv(env, resolveStmtExpr(env, e, st))
            .Local(name: n, mutable: m, ty: y, init: i) :> resolveLocal(env, s, n, m, y, i, st)
            .Return(e: e) :> keepEnv(env, resolveReturnExpr(env, e, st))
            .Fail(f: f) :> keepEnv(env, resolveFail(env, s, f, st))       // s451 (Ue, §19.3)
            .If(cond: c, thenB: t, elseB: el) :> keepEnv(env, resolveIf(env, c, t, el, st))
            .Given(name: n, subject: sub, body: b) :> keepEnv(env, resolveGiven(env, s, n, sub, b, st))
            .For(f: lf) :> resolveForStmt(env, s, lf, st)              // s469: a bound loop binds its name after it (§49.6)
            .Break(label: x) :> keepEnv(env, st)
            .Continue(label: x) :> keepEnv(env, st)
            .Lift(what: w) :> keepEnv(env, resolveLift(env, s, w, st))  // s469 (§49.6.2)
            .EffectStmt(w: w) :> keepEnv(env, effectAsStatement(env, w, st))
            .Defer(body: b, arrayLead: a, bare: bare) :> keepEnv(env, resolveDefer(env, s, b, a, bare, st))
        }
    }

    // s449 — an effect where a STATEMENT stands. Inside an effect body it is
    // E-LIFECYCLE-016 (§6.7.4: "An `<effect>` — or a retiring keyword `when …
    // changes { }` — inside the body of another `<effect>` is E-LIFECYCLE-016").
    // In a function or handler body there is no position in the tree to own it
    // (§6.7.4: an `<effect>` "SHALL appear where a `<request>` may: as a child
    // element of an element scope"); §34 names no code for that, so the
    // bootstrap refuses it rather than guess an owner.
    fn effectAsStatement(env: Env, w: AEffect, st: AS) -> AS {
        if (env.inEffect) return addDiag(st, env.file, w.span, "E-LIFECYCLE-016", "an effect inside another effect's body — an effect body is logic, not a markup position; declare the inner effect as a sibling `<effect>` with its own `deps=` (§6.7.4)")
        return addDiag(st, env.file, w.span, "E-BOOTSTRAP-UNSUPPORTED", "an effect inside a function or handler body has no position in the tree to own it (§6.7.4: an `<effect>` stands where a `<request>` may — a child of an element scope); write it in the program's markup")
    }

    // =========================================================================
    // s451 — `defer` (SPEC §19.16), the scope-exit statement.
    //
    // Exits the bootstrap HAS, all handled by the lowering (print.scrml
    // deferBlockJs — a `try … finally` per block that holds a defer): falling
    // off the end of a block; `return` (after its value is evaluated); (Ue)
    // `fail` and `?` — each a `return` of a failure (print.scrml: `return
    // rt.failure(…)`), so the same `finally` runs the deferred bodies; a host
    // error passing through. Exits the bootstrap does NOT have — loops and
    // `break` / `continue`, the CPS split of a function body — have no source
    // form here (a parse or scope error, so the compile has no Core —
    // lower.scrml's gate), so no `defer` can meet them and be mis-run. For the
    // same reason -DUPLICATE-FUNCTION (no function declaration inside a body)
    // and -SERVER-IN-SPLIT (no split) have no trigger the bootstrap can parse.
    // (Ue) E-DEFER-UNHANDLED-FAILABLE is the binder's (resolveCall /
    // resolveSql / guarded, under FailCtx.defer); `fail` / `?` inside a
    // deferred body are E-DEFER-CONTROL-FLOW (deferBodyRule / deferExprRules).
    //
    // Here: §19.16.3 rule 4 (E-DEFER-OUTSIDE-FUNCTION: "`defer` SHALL appear
    // only inside the body of a function DECLARATION … It is
    // E-DEFER-OUTSIDE-FUNCTION in every other position"), §19.16.2
    // E-DEFER-UNSUPPORTED-SITE ("a `defer` that is the whole UNBRACED body of
    // an `if` / `else` … SHALL be a compile error"), §19.16.1
    // E-DEFER-AMBIGUOUS-LEAD. The block-chain rules (rules 1-2, LATER-SHADOW)
    // are `deferChecks`, run once per function body.
    // =========================================================================
    fn inFnBody(env: Env) -> boolean {
        const c: CtxK = env.ctx
        return match c {
            .InFn :> !env.inEffect
            .InDecl(owner: o) :> false
        }
    }

    fn resolveDefer(env: Env, s: AStmt, body: ABlock, arrayLead: boolean, bare: boolean, st0: AS) -> AS {
        if (!inFnBody(env)) {
            return addDiag(st0, env.file, s.span, "E-DEFER-OUTSIDE-FUNCTION", "`defer` stands only in the body of a function declaration (`function` / `fn`) — a handler, an effect or the program has no single block exit to attach the deferred statement to (§19.16.3 rule 4); move the body into a named function and call it")
        }
        // §19.16.1: "Where a binding named `defer` is in scope, a single-statement
        // `defer` led by an array literal SHALL be a compile error naming both spellings"
        if (arrayLead && deferBound(env)) {
            return addDiag(st0, env.file, s.span, "E-DEFER-AMBIGUOUS-LEAD", "`defer [` reads two ways while a binding named `defer` is in scope (§19.16.1): write `defer[…]` (no space) to index the binding, or `defer { […]… }` to defer the statement")
        }
        let st: AS = st0
        if (bare) st = addDiag(st, env.file, s.span, "E-DEFER-UNSUPPORTED-SITE", "a `defer` that is the whole unbraced arm of an `if` / `else` has no written block to belong to (§19.16.2) — brace the arm (`{ defer … }`) or move the `defer` to the enclosing block")
        // The deferred body sees the bindings in scope at the `defer` (§19.16.2
        // "Evaluation time"); its own locals stay inside it. (Ue) A failable in
        // it is handled in place (§19.16.3 rule 3).
        return resolveBlock(withDeferFx(env), body, st)
    }

    // Is a binding named `defer` VISIBLE here (§19.16.1: a parameter, an
    // earlier local, a `given` binding, a file-level function)?
    fn deferBound(env: Env) -> boolean {
        if (lookupLocal(env, "defer") is given) return true
        if (lookupHandle(env, "defer") is given) return true
        return fnNamed(env.g, env.file, "defer") is given
    }

    // A `let` / `const` written AFTER a position in a block of the function.
    type DeferLater:struct = { name: string, span: ASpan }

    // §19.16.3 rules 1-2 and §19.16.2 E-DEFER-LATER-SHADOW, over one function
    // body. `later` = the declarations in force at the exit of the block
    // being walked that were written after the current position — in that
    // block or in any enclosing block of the same function ("a `let` / `const`
    // / `lin` declaration written AFTER the `defer` — in its own block or in
    // any enclosing block of the same function").
    fn deferChecks(file: string, body: ABlock, st: AS) -> AS {
        return deferChecksIn(file, body, [], st)
    }

    fn deferChecksIn(file: string, b: ABlock, outer: DeferLater[], st0: AS) -> AS {
        let st: AS = st0
        let i = 0
        for (const s of b.stmts) {
            st = deferChecksStmt(file, s, outer.concat(laterLocals(b, i + 1)), st)
            i = i + 1
        }
        return st
    }

    fn laterLocals(b: ABlock, from: int) -> DeferLater[] {
        let out: DeferLater[] = []
        let i = 0
        for (const s of b.stmts) {
            if (i >= from) {
                const n: string = localNameOf(s)
                if (n != "") out = out.concat([{ name: n, span: s.span }])
            }
            i = i + 1
        }
        return out
    }

    fn deferChecksStmt(file: string, s: AStmt, later: DeferLater[], st: AS) -> AS {
        const k: AStmtK = s.k
        return match k {
            .Defer(body: d) :> deferShadow(file, s, d, later, deferBodyRules(file, d, st))
            .If(cond: c, thenB: t, elseB: el) :> deferChecksElse(file, el, later, deferChecksIn(file, t, later, st))
            .Given(name: n, body: d) :> deferChecksIn(file, d, later, st)
            .For(f: lf) :> deferChecksBlocks(file, forExprBlocks(lf), later, deferChecksIn(file, lf.body, later, st))
            .Break(label: x) :> st
            .Continue(label: x) :> st
            .Lift(what: w) :> deferChecksBlocks(file, liftBlocks(w), later, st)
            .Eval(e: e) :> deferChecksBlocks(file, allExprBlocks(e), later, st)        // s451 (Ue): a braced arm block is a defer site (§19.16.2)
            .Local(name: n, init: i) :> deferChecksBlocks(file, allExprBlocks(i), later, st)
            .Return(e: e) :> deferChecksBlocks(file, maybeExprBlocks(e), later, st)
            .EffectStmt(w: w) :> st
            .Fail(f: f) :> st
        }
    }

    fn deferChecksBlocks(file: string, bs: ABlock[], later: DeferLater[], st0: AS) -> AS {
        let st: AS = st0
        for (const b of bs) { st = deferChecksIn(file, b, later, st) }
        return st
    }

    fn deferChecksElse(file: string, el: ABlock | not, later: DeferLater[], st: AS) -> AS {
        if (el is not) return st
        return deferChecksIn(file, el, later, st)
    }

    // Rules 1-2 inside a deferred body, at every depth: no `return`, `fail` or
    // `?` (E-DEFER-CONTROL-FLOW — "A deferred body SHALL NOT contain a
    // `return`, a `fail`, a `?` propagation"), no `defer` (E-DEFER-NESTED —
    // "A deferred body SHALL NOT contain a `defer` statement"), the arms of a
    // handling form included (s451 Ue). The bootstrap parses no `yield` and no
    // nested function body (a lambda body is an expression), so a `return`
    // here always leaves the deferred body.
    // s471 — `break` / `continue`: "A `break`/`continue` that targets a loop
    // INSIDE the deferred body is permitted" (§19.16.3 rule 1). `loops` holds
    // the labels of the loops inside the deferred body that enclose the
    // statement ("" for an unlabelled one); a jump is legal iff it names one
    // of them (an unlabelled jump: the innermost, so any). check.scrml C19
    // re-checks the Core (a Defer body is a jump boundary).
    fn deferBodyRules(file: string, b: ABlock, st0: AS) -> AS {
        return deferBodyRulesIn(file, b, [], st0)
    }

    fn deferBodyRulesIn(file: string, b: ABlock, loops: string[], st0: AS) -> AS {
        let st: AS = st0
        for (const s of b.stmts) { st = deferBodyRule(file, s, loops, st) }
        return st
    }

    fn deferJumpStays(label: string, loops: string[]) -> boolean {
        if (label == "") return loops.length > 0
        return loops.indexOf(label) >= 0
    }

    fn deferBodyRule(file: string, s: AStmt, loops: string[], st: AS) -> AS {
        const k: AStmtK = s.k
        return match k {
            .Return(e: e) :> addDiag(st, file, s.span, "E-DEFER-CONTROL-FLOW", "a deferred statement cannot contain a `return` — it runs while its block is already exiting, after the function's return value is computed (§19.16.3 rule 1)")
            .Defer(body: d) :> addDiag(st, file, s.span, "E-DEFER-NESTED", "a deferred statement cannot contain a `defer` — there is no block to attach it to that is not already exiting (§19.16.3 rule 2)")
            .If(cond: c, thenB: t, elseB: el) :> deferBodyElse(file, el, loops, deferBodyRulesIn(file, t, loops, st))
            .Given(name: n, body: d) :> deferBodyRulesIn(file, d, loops, st)
            .For(f: lf) :> deferForRules(file, lf, loops, st)
            .Break(label: l) :> deferJump(file, s, l, "break", loops, st)
            .Continue(label: l) :> deferJump(file, s, l, "continue", loops, st)
            // s471 review F2 — RULED (user-voice S471, "your recs"): §19.16.3 rule 1 gains
            // `lift` — a deferred body SHALL NOT append to an enclosing value-bound loop
            .Lift(what: w) :> deferLiftRules(file, liftExprs(w), loops, addDiag(st, file, s.span, "E-DEFER-CONTROL-FLOW", "a deferred statement cannot contain a `lift` (nor a `return`, a `fail`, a `?` propagation or a `break`/`continue` that leaves it) — it runs while its block is already exiting (§19.16.3 rule 1)"))
            .Eval(e: e) :> deferExprRules(file, e, loops, st)
            .Local(name: n, init: i) :> deferExprRules(file, i, loops, st)
            .EffectStmt(w: w) :> st
            .Fail(f: x) :> addDiag(st, file, s.span, "E-DEFER-CONTROL-FLOW", "a deferred statement cannot contain a `fail` — it runs while its block is already exiting; a failure here would replace the function's real result (§19.16.3 rule 1)")
        }
    }

    // s471 review F3: a loop in a deferred body — its head runs inside the deferred
    // body too (its init block and head expressions are checked as the body is;
    // a jump there names no loop of its own — the head is outside the loop).
    fn deferForRules(file: string, lf: AFor, loops: string[], st0: AS) -> AS {
        let st: AS = deferBodyRulesIn(file, forInitBlock(lf), loops, st0)
        for (const e of forHeadExprs(lf)) { st = deferExprRules(file, e, loops, st) }
        return deferBodyRulesIn(file, lf.body, loops.concat([lf.label]), st)
    }

    fn deferJump(file: string, s: AStmt, label: string, kw: string, loops: string[], st: AS) -> AS {
        if (deferJumpStays(label, loops)) return st
        return addDiag(st, file, s.span, "E-DEFER-CONTROL-FLOW", "a deferred statement cannot contain a `" + kw + "` that leaves it — it runs while its block is already exiting; a `" + kw + "` may target only a loop inside the deferred statement (§19.16.3 rule 1)")
    }

    // s451 (Ue) — rule 1 inside a deferred statement's expressions: no `?`
    // (§19.16.3 rule 1: "a `?` propagation"), and the arms of a handling form
    // obey the deferred-body rules ("The rule reaches EVERY statement position
    // inside the deferred body, including … the arms of a `!{}` handler").
    fn deferLiftRules(file: string, es: AExpr[], loops: string[], st0: AS) -> AS {
        let st: AS = st0
        for (const e of es) { st = deferExprRules(file, e, loops, st) }
        return st
    }

    fn deferExprRules(file: string, e: AExpr, loops: string[], st0: AS) -> AS {
        let st: AS = st0
        const h: AHandled | not = handledOf(e.k)
        if (h is given) {
            const how: AHow = h.how
            if (how == AHow.Propagate) st = addDiag(st, file, e.span, "E-DEFER-CONTROL-FLOW", "a deferred statement cannot contain a `?` propagation — it runs while its block is already exiting (§19.16.3 rule 1); handle the failure in place with `!{ … | _ :> … }`")
        }
        for (const x of exprKids(e)) { st = deferExprRules(file, x, loops, st) }
        for (const b of exprBlocks(e)) { st = deferBodyRulesIn(file, b, loops, st) }
        return st
    }

    fn deferBodyElse(file: string, el: ABlock | not, loops: string[], st: AS) -> AS {
        if (el is not) return st
        return deferBodyRulesIn(file, el, loops, st)
    }

    // E-DEFER-LATER-SHADOW (§19.16.2): "If the deferred body reads a name that
    // such a later declaration (re)binds, the program SHALL be rejected …
    // The diagnostic names the binding and both sites". A name the deferred
    // body binds itself (a local, a `given` name, a lambda parameter) is its
    // own; every other bare name it mentions — read, written or called — is
    // resolved at the `defer`, so a later binding of it is the hazard.
    fn deferShadow(file: string, s: AStmt, body: ABlock, later: DeferLater[], st0: AS) -> AS {
        let st: AS = st0
        const used: string[] = blockNameRefs(body, [])
        let reported: string[] = []
        for (const l of later) {
            if (used.indexOf(l.name) >= 0 && reported.indexOf(l.name) < 0) {
                reported = reported.concat([l.name])
                st = addDiag(st, file, l.span, "E-DEFER-LATER-SHADOW", "`" + l.name + "` is declared here, after the `defer` at " + offsetOf(s.span) + " whose deferred statement reads `" + l.name + "` — at the block's exit it would read this later binding, not the one in scope at the `defer` (§19.16.2); rename one of them")
            }
        }
        return st
    }

    // The bare names a block mentions that it does not bind itself.
    fn blockNameRefs(b: ABlock, bound0: string[]) -> string[] {
        let bound: string[] = bound0
        let out: string[] = []
        for (const s of b.stmts) {
            out = out.concat(stmtNameRefs(s, bound))
            const n: string = localNameOf(s)
            if (n != "") bound = bound.concat([n])
        }
        return out
    }

    fn stmtNameRefs(s: AStmt, bound: string[]) -> string[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> exprNameRefs(e, bound)
            .Local(name: n, init: i) :> exprNameRefs(i, bound)
            .Return(e: e) :> maybeNameRefs(e, bound)
            .If(cond: c, thenB: t, elseB: el) :> exprNameRefs(c, bound).concat(blockNameRefs(t, bound)).concat(elseNameRefs(el, bound))
            .Given(name: n, subject: sub, body: d) :> exprNameRefs(sub, bound).concat(blockNameRefs(d, bound.concat([n])))
            .For(f: lf) :> forNameRefs(lf, bound)
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> exprsNameRefs(liftExprs(w), bound)
            .EffectStmt(w: w) :> []
            .Defer(body: d) :> blockNameRefs(d, bound)
            .Fail(f: f) :> exprsNameRefs(failExprs(f), bound)
        }
    }

    fn maybeNameRefs(e: AExpr | not, bound: string[]) -> string[] {
        if (e is not) return []
        return exprNameRefs(e, bound)
    }

    fn elseNameRefs(el: ABlock | not, bound: string[]) -> string[] {
        if (el is not) return []
        return blockNameRefs(el, bound)
    }

    // s451 (Ue): a handling form — its subject, then each arm with the arm's
    // own binders bound.
    fn handledNameRefs(h: AHandled, bound: string[]) -> string[] {
        let out: string[] = exprNameRefs(h.subject, bound)
        for (const a of handledArms(h)) {
            const ab: string[] = bound.concat(armBindNames(a.pat))
            const body: AArmBody = a.body
            for (const x of armExprOf(body)) { out = out.concat(exprNameRefs(x, ab)) }
            for (const b of armBlockOf(body)) { out = out.concat(blockNameRefs(b, ab)) }
        }
        return out
    }

    fn armBindNames(p: APat) -> string[] {
        return match p {
            .PName(binds: bs) :> bindNames(bs)
            .PWild :> []
            .PWhole(bind: b) :> [b.name]
            .PBare(bind: b) :> [b.name]
            .PNot :> []
            .PLit(e: x) :> []
        }
    }

    fn bindNames(bs: ABind[]) -> string[] {
        let out: string[] = []
        for (const b of bs) { out = out.concat([b.name]) }
        return out
    }

    fn exprsNameRefs(es: AExpr[], bound: string[]) -> string[] {
        let out: string[] = []
        for (const x of es) { out = out.concat(exprNameRefs(x, bound)) }
        return out
    }

    fn exprNameRefs(e: AExpr, bound0: string[]) -> string[] {
        const h: AHandled | not = handledOf(e.k)
        if (h is given) return handledNameRefs(h, bound0)
        const bound: string[] = bound0.concat(lambdaParams(e))
        let out: string[] = []
        const n: string = exprName(e)
        if (n != "" && bound.indexOf(n) < 0) out = [n]
        for (const x of exprKids(e)) { out = out.concat(exprNameRefs(x, bound)) }
        return out
    }

    // =========================================================================
    // s451 (Ue) — THE ERROR MODEL (SPEC §19), in the binder.
    //
    // §19.4.3 "A call to a `!` function SHALL NOT be ignored. The caller MUST"
    // match / propagate with `?` / catch with `!{}` / … — "Failing to handle
    // the result of a `!` function call in any of these ways SHALL be a
    // compile error: E-ERROR-002" — at EVERY position the binder resolves (a
    // call, an event-handler call and an event-handler REFERENCE, S439/S441);
    // §19.8.3 (R11) the same for a `?{}` outside a `!` function. A handling
    // form resolves its subject with `subject` set, so that one node is not
    // reported. Inside a deferred body the code is E-DEFER-UNHANDLED-FAILABLE
    // (§19.16.3 rule 3: "Inside a deferred body this code REPLACES
    // E-ERROR-002").
    //
    // Slice limit (Ue2): a handling form stands only as a statement's WHOLE
    // value — `f() !{ … }` / `match f() { … }` alone, `let x = …`, `x = …`,
    // `@c = …`, `return …`, or an arm's value — so its Attempt is a statement
    // that runs where the source evaluates it. Inside a larger expression it
    // would need ordered hoisting (an argument, an operand, a condition, an
    // interpolation): refused.
    // =========================================================================
    fn ue2Reason() -> string {
        return "is in the bootstrap only as a statement's whole value (`f() !{ … }` / `match f() { … }` alone, `let x = …`, `x = …`, `@c = …`, `return …`) — inside a larger expression (an argument, an operand, a condition, an interpolation or an initializer) it arrives with slice Ue2 (ordered hoisting)"
    }

    // A call of a `!` function, not the subject of a handling form.
    fn unhandledCall(env: Env, e: AExpr, name: string, st: AS) -> AS {
        if (env.fx.defer) return addDiag(st, env.file, e.span, "E-DEFER-UNHANDLED-FAILABLE", "`" + name + "(…)` is failable and this is a deferred statement — handle it in place with a total `!{ … | _ :> … }` (or an exhaustive `match`): the block is already exiting, so there is no caller-bound path left for its error, and an enclosing `!` does not cover it (§19.16.3 rule 3)")
        if (env.fx.inFn) return addDiag(st, env.file, e.span, "E-ERROR-002", "Result of failable function '" + name + "' is not handled. Either match the result, propagate with '?' (inside a `!` function), or catch with '!{}' (§19.4.3)")
        return addDiag(st, env.file, e.span, "E-ERROR-002", "Result of failable function '" + name + "' is not handled here. Catch it with '!{}' (e.g. '" + name + "(…) !{ | .Variant :> … }'), match the result, or call it from a function that handles it — `?` needs an enclosing `!` function, and the bootstrap has no `<errorBoundary>` (§19.4.3)")
    }

    // A failable function passed as an event-handler REFERENCE (S441: "SHALL
    // be E-ERROR-002, exactly like `onclick=risky()`").
    // `onclick={ risky }` is a reference too (S441: "the bare `onclick=risky`,
    // `onclick=${risky}`, or `onclick={ risky }`").
    fn bracedHandler(env: Env, b: ABlock, st: AS) -> AS {
        const r: AExpr | not = blockReference(b)
        if (r is not) return loopChecks(env.file, b, resolveBlock(withLift(env, LiftCtx.NoLift), b, st))   // s469: a handler block is a loop-control boundary (and a `lift` one)
        return handlerReference(env, r, resolveBlock(withFnRef(withLift(env, LiftCtx.NoLift), r.nid), b, st))
    }

    // The one name a braced handler body consists of, else not.
    export fn blockReference(b: ABlock) -> AExpr | not {
        if (b.stmts.length != 1) return not
        const k: AStmtK = b.stmts[0].k
        const e: AExpr | not = match k {
            .Eval(e: x) :> x
            .Local(name: n) :> not
            .Return(e: x) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .For(f: lf) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: x) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: d) :> not
            .Fail(f: x) :> not
        }
        if (e is not) return not
        if (exprName(e) == "") return not
        return e
    }

    // An event-handler REFERENCE (`onclick=f`): the event calls `f` (s451 Ue,
    // review HIGH-2 — before, it was lowered as `null` and called nothing).
    // A `!` function there is E-ERROR-002 (S441); a function with parameters
    // would receive the event, which the bootstrap does not model — refused.
    fn handlerReference(env: Env, e: AExpr, st: AS) -> AS {
        if (exprName(e) == "") return st
        const f: FnInfo | not = calledFn(env, nameFactIn(st, e.nid))
        if (f is not) return st
        // s454 (U1b) — §19.9.10 scope 2: "in an event-handler value, as a call or
        // as a handler reference (§19.4.3 … apply unchanged — a server function is
        // now a failable function for both)"; design §2.2: "a handler REFERENCE
        // `onclick=saveNote` → E-ERROR-002 … the dispatcher discards the result".
        if (f.serverOwn && !f.failable) return addDiag(st, env.file, e.span, "E-ERROR-002", "Server function '" + f.name + "' is passed as an event-handler reference: the event would call it on the client and discard the result, but a client call of a server function can fail on the wire (§19.9.10). Call it in a handler that handles it (e.g. '{ " + f.name + "() !{ .Transport(t) :> … } }'), or wire a function that handles it (§19.4.3)")
        if (!f.failable) {
            if (f.arity == 0) return st
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "an event-handler reference to `" + f.name + "`, which takes parameters — the event would be its argument, which the bootstrap does not model; write the call: `{ " + f.name + "(…) }`")
        }
        return addDiag(st, env.file, e.span, "E-ERROR-002", "Failable function '" + f.name + "' is passed as an event-handler reference, so the event would call it and discard its error. Call it in a handler that handles the result (e.g. '{ " + f.name + "() !{ | .Variant :> … } }'), or wire a function that handles it (§19.4.3, S441)")
    }

    // The `!` function a call names, else not.
    fn failableCallee(env: Env, st: AS, e: AExpr) -> FnInfo | not {
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return not
        const f: FnInfo | not = calledFn(env, nameFactIn(st, c.nid))
        if (f is not) return not
        if (!f.failable) return not
        return f
    }

    // The name a handled subject is reported by.
    fn subjectName(e: AExpr) -> string {
        const c: AExpr | not = calleeOf(e.k)
        if (c is given) {
            const n: string = exprName(c)
            if (n != "") return n + "(…)"
        }
        if (sqlOfK(e.k) is given) return "the `" + sqlSigil() + "}` query"
        return "this expression"
    }

    // `subject?` / `subject !{ … }` / `match subject { … }`. `stmt`: the form
    // stands as a statement (its arms yield no value).
    // s454 (U1b): a subject that calls a server-triggered function (§12.2 T1/T4,
    // FnInfo.serverOwn) from a site that is (or may be) on the client is judged
    // against the CLIENT call's failure set (§19.9.10) — remoteHandled.
    fn resolveHandled(env: Env, e: AExpr, h: AHandled, stmt: boolean, expected: Type | not, st0: AS) -> RX {
        let st: AS = st0
        const subj: AExpr = h.subject
        const sc: FnInfo | not = serverCalleeNamed(env, subj)
        const site: SiteK = siteOf(env)
        // (fix round 1: an own-trigger server site too — its arms resolve against the client
        // set, and SiteLocal reports a `.Transport` arm as dead handling, §19.9.10, as a T5 site does)
        if (sc is given) {
            const rs0: RX = resolveExpr(withSubject(withWhole(env, -1), subj.nid), subj, not, st)
            const hm: AHow = h.how
            const ty: Type | not = match hm {
                .Propagate :> rs0.x.ty
                .Guard(arms: x) :> rs0.x.ty
                .MatchOn(arms: x) :> not
            }
            return plain(ty, remoteHandled(env, e, h, subj, sc, site, stmt, noSuccessUse(env, e, h, sc, stmt, rs0.st)))
        }
        // s469 — the §18 plain-value `match`: a subject that is not a failable result
        const pma: AArm[] | not = matchArmsOf(h.how)
        if (pma is given && !failableSubjectNamed(env, subj)) return plainMatch(env, e, subj, pma, stmt, expected, st)
        if (!stmt && env.fx.whole != e.nid) st = addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a handled failable (`?`, `!{ … }`, `match`) " + ue2Reason())
        const rs: RX = resolveExpr(withSubject(withWhole(env, -1), subj.nid), subj, not, st)
        st = rs.st
        const f: FnInfo | not = failableCallee(env, st, subj)
        let failable = false
        let err: Sym | not = not
        if (f is given) {
            failable = true
            err = f.err
        } else if (sqlOfK(subj.k) is given) {
            failable = true
            err = env.g.sqlErrorSym
        }
        // s469 (#1471 round-2 MED-2): a `!` function that never returns a value has NO success
        // value — reading it (the handled form's value, or a `.Ok(v)` binder) would be `undefined`
        if (f is given) st = noSuccessUse(env, e, h, f, stmt, st)
        const how: AHow = h.how
        return match how {
            .Propagate :> plain(rs.x.ty, propagate(env, e, subj, failable, err, stmt, st))
            .Guard(arms: arms) :> plain(rs.x.ty, guarded(env, e, subj, arms, failable, err, false, stmt, st))
            .MatchOn(arms: arms) :> plain(not, guarded(env, e, subj, arms, failable, err, true, stmt, st))
        }
    }

    // §19.5.4: "`?` SHALL be valid only inside a `!` function body … E-ERROR-003";
    // "`?` SHALL be valid only when applied to a call to a `!` function …
    // E-ERROR-004"; §19.5.3 compatibility (E-ERROR-010).
    fn propagate(env: Env, e: AExpr, subj: AExpr, failable: boolean, err: Sym | not, stmt: boolean, st0: AS) -> AS {
        if (!failable) return addDiag(st0, env.file, e.span, "E-ERROR-004", e004Msg(subj))
        if (!env.fx.failable) return addDiag(st0, env.file, e.span, "E-ERROR-003", e003Msg(env))
        return propagationFact(env, e, err, stmt, st0)
    }

    fn e004Msg(subj: AExpr) -> string {
        return "'?' applied to " + subjectName(subj) + ", which is not a call of a failable function. Only '!' functions (and `" + sqlSigil() + "}` queries) can be propagated with '?' (§19.5.4)"
    }

    fn e003Msg(env: Env) -> string {
        let where: string = "this handler or markup, which is not a function"
        if (env.fx.inFn) where = "function '" + env.fx.fnName + "', which is not declared as failable"
        return "'?' propagation operator used in " + where + ". Add '!' to the function signature or handle the error with 'match' or '!{}' (§19.5.4)"
    }

    // The re-fail of a propagation: each variant of `err` re-fails as the
    // SAME-NAMED variant of the enclosing function's enum with the same
    // payload (§19.5.2's desugaring constructs it positionally, so the
    // payloads must agree in count and type); otherwise E-ERROR-010 (§19.5.3:
    // "the compiler SHALL emit a compile error (E-ERROR-010) identifying the
    // incompatible variants" — §19.8.4 the same for a `?{}`).
    fn propagationFact(env: Env, e: AExpr, err: Sym | not, stmt: boolean, st0: AS) -> AS {
        const into: Sym | not = env.fx.err
        if (err is not || into is not) return st0          // an error type that is not an enum: E-ERROR-011 reported
        const rt: RRetag = retagInto(env, err, into, 0, -1, st0)
        if (rt.bad.length > 0) return addDiag(rt.st, env.file, e.span, "E-ERROR-010", e010Msg(env, err, into, rt.bad))
        return handledFact(env, e, err, stmt, into, rt.retag, not, rt.st)
    }

    fn e010Msg(env: Env, err: Sym, into: Sym, bad: string[]) -> string {
        return "propagating `" + err.hint + "` into `" + env.fx.fnName + "(…)! " + into.hint + "` would drop the variant(s) " + bad.join(", ") + " — every variant the callee can fail with must exist in the enclosing function's error type with the same payload (§19.5.3). Add them to `" + into.hint + "`, or handle the call with `!{ … }` / `match`"
    }

    // The retag of variants [from, upto) of `err` into `into` (upto -1: all),
    // and the names of those `into` cannot take (missing, or another payload).
    type RRetag:struct = { retag: Retag[], bad: string[], st: AS }

    fn retagInto(env: Env, err: Sym, into: Sym, from: int, upto: int, st0: AS) -> RRetag {
        let st: AS = st0
        const vs: VariantDef[] = enumVariantsOf(env.g, err)
        const to: VariantDef[] = enumVariantsOf(env.g, into)
        let bad: string[] = []
        let retag: Retag[] = []
        let i = 0
        for (const v of vs) {
            if (i >= from && (upto < 0 || i < upto)) {
                const j: int = variantIndex(env.g.types, into, v.sym.hint)
                if (j < 0 || !samePayload(v, to[j])) {
                    bad = bad.concat([v.sym.hint])
                } else {
                    let binds: Sym[] = []
                    for (const fd of v.fields) {
                        const rb: RSym = mint(st, fd.sym.hint)
                        st = rb.st
                        binds = binds.concat([rb.s])
                    }
                    retag = retag.concat([{ from: i, to: j, binds: binds }])
                }
            }
            i = i + 1
        }
        return { retag: retag, bad: bad, st: st }
    }

    fn samePayload(a: VariantDef, b: VariantDef) -> boolean {
        if (a.fields.length != b.fields.length) return false
        let i = 0
        while (i < a.fields.length) {
            if (!(a.fields[i].ty == b.fields[i].ty)) return false
            i = i + 1
        }
        return true
    }

    fn enumVariantsOf(g: Globals, s: Sym) -> VariantDef[] {
        const t: TypeInfo | not = typeInfoOf(g.types, s)
        if (t is not) return []
        return enumVariants(t.def)
    }

    // The fact lower reads: the result / raw-result locals, minted here.
    // s454 (U1b): `outcome` — the Suspend's bind when the call turns out to
    // suspend (a client call of a server function, or a call of a waiting
    // client function, design §2.1); `remote` — the client-call facts.
    fn handledFact(env: Env, e: AExpr, err: Sym, stmt: boolean, into: Sym | not, retag: Retag[], remote: RemoteFact | not, st0: AS) -> AS {
        const rr: RSym = mint(st0, "handled")
        const ro: RSym = mint(rr.st, "outcome")
        const rs: RSym = mint(ro.st, "settled")
        return addFail(rs.st, e.nid, FailFact.FHandled({ err: err, result: rr.s, ok: ro.s, stmt: stmt, into: into, retag: retag,
                                                           outcome: rs.s, remote: remote }))
    }

    fn noSuccessUse(env: Env, e: AExpr, h: AHandled, f: FnInfo, stmt: boolean, st: AS) -> AS {
        if (!f.failable) return st
        if (!isVoidFn(env.g, f.sym.id)) return st
        // `?` / `!{}` in a value position yield the success value; a `match`'s value is its arms'
        // (it reads the success value only through a bound `.Ok(v)`)
        let reads: boolean = !stmt
        const arms: AArm[] | not = matchArmsOf(h.how)
        if (arms is given) {
            reads = false
            for (const a of arms) {
                const pn: PatName | not = patName(a.pat)
                if (pn is given) {
                    if (pn.name == "Ok") {
                        for (const b of pn.binds) {
                            if (b.name != "_") reads = true
                        }
                    }
                }
            }
        }
        if (!reads) return st
        return addDiag(st, env.file, e.span, "E-TYPE-001", "`" + f.name + "(…)` succeeds with no value (no path of it returns one) — its success value cannot be read here (§18.3: void is not assignable); handle it as a statement (`" + f.name + "(…) !{ … }` alone), or bind `.Ok` with `_`")
    }



    // `!{ arms }` / `match subject { arms }`.
    fn guarded(env: Env, e: AExpr, subj: AExpr, arms: AArm[], failable: boolean, err: Sym | not, isMatch: boolean, stmt: boolean, st0: AS) -> AS {
        let st: AS = st0
        if (!failable) {
            if (isMatch) st = plainMatchBinderDiags(env, arms, st)
            if (!isMatch) st = deadHandlerBinderDiags(env, arms, st)
            if (isMatch) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a `match` over " + subjectName(subj) + " — a value that is not a failable result — is not in the bootstrap; it arrives with the §18 `match` unit (here `match` is admitted on a call of a `!` function or a `" + sqlSigil() + "}` query, §19.7.1)")
            return deadHandler(env, e, subj, st)
        }
        if (err is not) return st                          // E-ERROR-011 reported: no variant set to check against
        if (isMatch && variantIndex(env.g.types, err, "Ok") >= 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", okVariantMsg(err))
        const ra: RArms = resolveArms(env, subj, arms, err, isMatch, stmt, st)
        st = ra.st
        for (const d of coverDiags(env, e, subj, err, isMatch, ra, -1, err.hint)) { st = withDiag(st, d) }
        return handledFact(env, e, err, stmt, not, [], not, st)
    }

    // =========================================================================
    // s469 — THE §18 PLAIN-VALUE `match` (SPEC §18; today-scrml-distance
    // blocker 5): a `match` whose subject is NOT a failable result — an enum, a
    // `T | not`, a string / number / bool (§18.16). It lowers to Core's
    // `Expr.Match` (a value) or, as a statement, to one `Match` that picks the
    // arm followed by an `if` chain on its index; an arm is chosen by its own
    // test — the variant TAG (§45: a nullary variant compares by value, a
    // payload variant by its `variant` tag), the absence check, or `===` on a
    // literal — never by falling through to the last arm.
    //   - variant arms bind their payload positionally (§18.7, E-TYPE-021);
    //   - a literal arm over an enum is E-TYPE-028 (§18.16.2);
    //   - exhaustiveness (§18.8.1): an enum match that misses a variant and has
    //     no wildcard is E-TYPE-020; a `T | not` match with no `not` arm and no
    //     wildcard is E-MATCH-012 (§42.7); a string / number match, or a bool
    //     match missing a value, with no wildcard is W-MATCH-002 (§18.16.2);
    //     a wildcard after full coverage is W-MATCH-001 (§18.6);
    //   - duplicate arms E-TYPE-023, an arm after the wildcard E-SYNTAX-010;
    //   - a struct subject E-TYPE-024 (§18.8.2); a tape subject is refused
    //     (fail closed: a tape — `T[g…] | not` included — never reaches a
    //     match, so no unwrapped tape loses its grants here).
    // Slice limit: in a VALUE position an arm is one expression (Core's Match
    // arm is an Expr) — a `{ … }` arm with statements, or a leaving arm, is
    // refused there; as a statement every arm form is admitted.
    // =========================================================================
    fn matchArmsOf(how: AHow) -> AArm[] | not {
        return match how {
            .MatchOn(arms: a) :> a
            .Propagate :> not
            .Guard(arms: x) :> not
        }
    }

    // Is the subject a failable — a `?{}`, or a call of a `!` function — by the
    // binder's own name rule (a local of that name shadows the function)?
    fn failableSubjectNamed(env: Env, subj: AExpr) -> boolean {
        if (sqlOfK(subj.k) is given) return true
        const c: AExpr | not = calleeOf(subj.k)
        if (c is not) return false
        const n: string = exprName(c)
        if (n == "") return false
        if (lookupLocal(env, n) is given) return false
        const f: FnInfo | not = fnNamed(env.g, env.file, n)
        if (f is not) return false
        return f.failable
    }

    type PSubj:struct = { kind: int, es: Sym | not, maybe: boolean, known: boolean, code: string, msg: string }

    fn psubj(kind: int, es: Sym | not, maybe: boolean, known: boolean) -> PSubj {
        return { kind: kind, es: es, maybe: maybe, known: known, code: "", msg: "" }
    }

    fn psubjBad(code: string, msg: string) -> PSubj {
        return { kind: 4, es: not, maybe: true, known: true, code: code, msg: msg }
    }

    // What the subject is, from its type — or, when the binder does not know
    // it (a call's result, an unannotated local), from the arms (§18.13: a
    // shorthand variant resolves against the one enum that has it).
    fn plainSubject(env: Env, subj: AExpr, ty: Type | not, arms: AArm[]) -> PSubj {
        if (ty is not) return armsSubject(env, callEnumOf(env, subj), arms)
        const inner: Type = unMaybe(ty)
        const maybe: boolean = maybeInner(ty) is given
        const k: int = kindOf(inner)
        if (k == 0 || k == 1) return psubj(2, not, maybe, true)
        if (k == 2) return psubj(1, not, maybe, true)
        if (k == 3) return psubj(3, not, maybe, true)
        if (k == 5 || k == 6) return psubjBad("E-BOOTSTRAP-UNSUPPORTED", "a `match` over a tape (`" + typeName(ty) + "`) — §18 matches an enum, a `T | not`, or a string, number or bool; a tape is none of those (read it with `.length`, `.filter`, `.map` or `<each>`)")
        const es: Sym | not = isEnumType(env.g.types, inner)
        if (es is given) return psubj(0, es, maybe, true)
        // a `S | not` of a struct: a presence `match` (`not :>` / `else :>`, §18.8.2 "union types") — kind 4
        if (maybe) return psubj(4, not, maybe, true)
        return psubjBad("E-TYPE-024", "a `match` over `" + typeName(inner) + "`, which is not an enum — a `match` is valid over an enum, a `T | not` and the literal types, not over a struct (§18.8.2)")
    }

    // s472 r1 (F1) — §18.13: "`.VariantName` (shorthand) SHALL be valid when the
    // matched value's type can be inferred by the compiler from context." A call
    // of a function in scope whose DECLARED return type is an enum names that
    // enum by identity — whether or not the enum's NAME is in scope here (the
    // page may import `pick() -> Color` without `Color`). `not` otherwise.
    fn callEnumOf(env: Env, subj: AExpr) -> Sym | not {
        const c: AExpr | not = calleeOf(subj.k)
        if (c is not) return not
        const n: string = exprName(c)
        if (n == "") return not
        if (lookupLocal(env, n) is given) return not
        const f: FnInfo | not = fnNamed(env.g, env.file, n)
        if (f is not) return not
        const r: Type | not = f.ret
        if (r is not) return not
        return isEnumType(env.g.types, unMaybe(r))
    }

    // `pref`: the subject's enum when it is known by identity (callEnumOf) —
    // a shorthand arm that names one of its variants resolves to it. Else the
    // enums in scope in this file; else (s472 r1, F1: the subject's type may be
    // an enum whose name is not imported — an unannotated local holding a
    // call's result) every user enum of the program. A pick that is not the
    // subject's type is caught by the typer's subject-vs-arms check
    // (plainSubjectCheck: "the arms are variants of `E`, but the subject is
    // `F`", by Sym identity), so the widened search cannot mis-link silently.
    fn armsSubject(env: Env, pref: Sym | not, arms: AArm[]) -> PSubj {
        let maybe = false
        for (const a of arms) {
            if (isNotPat(a.pat)) maybe = true
        }
        for (const a2 of arms) {
            const pn: PatName | not = patName(a2.pat)
            if (pn is given) {
                if (pn.qual != "") {
                    const qs: Sym | not = typeNamedHere(env, pn.qual)
                    if (qs is given) {
                        const qe: Sym | not = isEnumType(env.g.types, Type.Named(qs))
                        if (qe is given) return psubj(0, qe, maybe, false)
                    }
                    return psubjBad("E-TYPE-VARIANT", "`" + pn.qual + "." + pn.name + "` — `" + pn.qual + "` is not an enum type in scope (§18.13)")
                }
                if (pref is given) {
                    if (variantIndex(env.g.types, pref, pn.name) >= 0) return psubj(0, pref, maybe, false)
                }
                let r: EnumOf = enumHaving(env, pn.name, true)
                if (r.n == 0) r = enumHaving(env, pn.name, false)
                if (r.n == 1) return psubj(0, r.es, maybe, false)
                if (r.n == 0) return psubjBad("E-TYPE-VARIANT", "`." + pn.name + "` is not a variant of any enum in scope")
                return psubjBad("E-VARIANT-AMBIGUOUS", "`." + pn.name + "` is a variant of more than one enum, and the subject's type is not known here — give the subject a declared type (§18.13)")
            }
            const lit: AExpr | not = litPatOf(a2.pat)
            if (lit is given) {
                const li: LitInfo = litInfo(lit)
                if (li.kind > 0) return psubj(li.kind, not, maybe, false)
            }
        }
        return psubj(4, not, maybe, false)
    }

    type EnumOf:struct = { es: Sym | not, n: int }

    // Does `qual` name an enum that declares `name` (a qualified pattern, §18.13)?
    fn qualNames(env: Env, qual: string, name: string) -> boolean {
        const qs: Sym | not = typeNamedHere(env, qual)
        if (qs is not) return false
        return variantIndex(env.g.types, qs, name) >= 0
    }

    // `scoped`: only the enums in scope in this file; else every user enum.
    fn enumHaving(env: Env, name: string, scoped: boolean) -> EnumOf {
        let found: Sym | not = not
        let n = 0
        for (const t of env.g.types) {
            const s: Sym = typeDefSym(t.def)
            if (t.file != builtinFile() && (!scoped || typeInScope(env, t)) && variantIndex(env.g.types, s, name) >= 0) {
                found = s
                n = n + 1
            }
        }
        return { es: found, n: n }
    }

    // s472: is the user type `t` the one its name denotes in `env.file`? (The
    // enums remoteEnums mints live in the built-in file — never searched here.)
    fn typeInScope(env: Env, t: TypeInfo) -> boolean {
        return inScope(env.g.te.link, env.file, NameKind.KType, t.name, t.file)
    }

    fn isNotPat(p: APat) -> boolean {
        return match p {
            .PNot :> true
            .PName(name: n) :> false
            .PWild :> false
            .PWhole(bind: b) :> false
            .PBare(bind: b) :> false
            .PLit(e: x) :> false
        }
    }

    fn litPatOf(p: APat) -> AExpr | not {
        return match p {
            .PLit(e: x) :> x
            .PNot :> not
            .PName(name: n) :> not
            .PWild :> not
            .PWhole(bind: b) :> not
            .PBare(bind: b) :> not
        }
    }

    // A literal arm's kind (1 string, 2 number, 3 bool; 0 not a literal) and its
    // duplicate key.
    type LitInfo:struct = { kind: int, key: string }

    fn litOf(kind: int, key: string) -> LitInfo { return { kind: kind, key: key } }

    fn litInfo(x: AExpr) -> LitInfo {
        const k: AExprK = x.k
        return match k {
            .Str(v: s) :> litOf(1, "s:" + s)
            .Num(raw: r) :> litOf(2, "n:" + Number(r))
            .Bool(v: b) :> litOf(3, "b:" + boolText(b))
            .Name(name: n) :> litOf(0, "")
            .At(name: n) :> litOf(0, "")
            .AtItem :> litOf(0, "")
            .NotLit :> litOf(0, "")
            .Recovered :> litOf(0, "")
            .Variant(name: n) :> litOf(0, "")
            .Member(obj: o) :> litOf(0, "")
            .Call(callee: c) :> litOf(0, "")
            .Unary(op: o) :> litOf(0, "")
            .Binary(op: o) :> litOf(0, "")
            .Ternary(test: t) :> litOf(0, "")
            .Assign(target: t) :> litOf(0, "")
            .ArrayLit(elems: es) :> litOf(0, "")
            .ObjectLit(props: ps) :> litOf(0, "")
            .Spread(e: sx) :> litOf(0, "")
            .Index(obj: ix) :> litOf(0, "")
            .Lambda(params: lp) :> litOf(0, "")
            .Sql(q: q) :> litOf(0, "")
            .Handled(h: hx) :> litOf(0, "")
            .Template(quasis: qs) :> litOf(0, "")
            .Foreign(f: fb0) :> litOf(0, "")
        }
    }

    fn kindLabel(k: int) -> string {
        if (k == 0) return "an enum"
        if (k == 1) return "a string"
        if (k == 2) return "a number"
        if (k == 3) return "a bool"
        return "a value that is neither an enum nor a literal type"
    }

    type RPArm:struct = { idx: int, key: string, env: Env, st: AS }

    fn rparm(idx: int, key: string, env: Env, st: AS) -> RPArm { return { idx: idx, key: key, env: env, st: st } }

    // One arm's pattern: its FArm index, its literal key, the env its body is
    // resolved in (payload binders bound, §18.7).
    fn plainArm(env: Env, a: AArm, sk: PSubj, vs: VariantDef[], st0: AS) -> RPArm {
        let st: AS = st0
        const armEnv: Env = withSubject(withWhole(env, -1), -1)
        const p: APat = a.pat
        const pn: PatName | not = patName(p)
        if (pn is given) {
            const es: Sym | not = sk.es
            if (es is not) {
                if (sk.code == "" && (sk.kind != 4 || sk.known)) st = addDiag(st, env.file, a.span, "E-TYPE-VARIANT", "`." + pn.name + "` is a variant pattern, but the subject is " + kindLabel(sk.kind) + " — match it with literal arms (§18.16)")
                const rb0: RBinds = bindArm(armEnv, pn.binds, [], st)
                return rparm(-3, "", rb0.env, rb0.st)
            }
            const i: int = variantIndex(env.g.types, es, pn.name)
            if (pn.qual != "") {
                const qs: Sym | not = typeNamedHere(env, pn.qual)
                let same = false
                if (qs is given) same = qs.id == es.id
                if (!same) st = addDiag(st, env.file, a.span, "E-TYPE-VARIANT", "`" + pn.qual + "." + pn.name + "` names `" + pn.qual + "`, but the subject is `" + es.hint + "` (§18.13)")
            }
            if (i < 0) {
                st = addDiag(st, env.file, a.span, "E-TYPE-VARIANT", "`." + pn.name + "` is not a variant of `" + es.hint + "` (its variants: " + variantNamesOf(vs).join(", ") + ")")
                const rb1: RBinds = bindArm(armEnv, pn.binds, [], st)
                return rparm(-3, "", rb1.env, rb1.st)
            }
            const fs: FieldDef[] = vs[i].fields
            if (pn.parens && pn.binds.length != fs.length) st = addDiag(st, env.file, a.span, "E-TYPE-021", "`." + pn.name + "` carries " + fs.length + " value(s) but the pattern binds " + pn.binds.length + " — bind one name (or `_`) per payload field, in declaration order (§18.7)")
            const rb: RBinds = bindArm(armEnv, pn.binds, fs, st)
            return rparm(i, "", rb.env, rb.st)
        }
        const lit: AExpr | not = litPatOf(p)
        if (lit is given) {
            st = resolveExpr(armEnv, lit, not, st).st
            const li: LitInfo = litInfo(lit)
            if (sk.code == "" && sk.kind == 0) {
                const en: Sym | not = sk.es
                let nm: string = "an enum"
                if (en is given) nm = "`" + en.hint + "`"
                st = addDiag(st, env.file, a.span, "E-TYPE-028", "the literal arm `" + subjectLabel(lit) + "` is not valid over the enum type " + nm + " — write `.Variant` arms (§18.16.2)")
            } else if (sk.code == "" && (sk.kind != 4 || sk.known) && li.kind != sk.kind) {
                st = addDiag(st, env.file, a.span, "E-TYPE-001", "the literal arm `" + subjectLabel(lit) + "` is " + kindLabel(li.kind) + ", but the subject is " + kindLabel(sk.kind) + " (§18.16)")
            }
            return rparm(-6, li.key, armEnv, st)
        }
        if (isNotPat(p)) {
            // s469 (review L1): a `not` arm on a subject that can never be `not` is dead
            // — the E-TYPE-044 rule (§17.6: a presence test on a type without `| not`)
            // (review L1: a dead `not` arm is the typer's — plainSubjectCheck — which sees a refused type as Unknown, Rule C)
            return rparm(-5, "", armEnv, st)
        }
        const wb: WholePat | not = wholePatOf(p)
        if (wb is given) {
            // E-MATCH-BARE-BINDER is reported (plainMatchBinderDiags): bound, and
            // counted as the wildcard — one report, no cascade
            const rw: RBinds = bindArm(armEnv, [wb.b], [], st)
            return rparm(-1, "", rw.env, rw.st)
        }
        return rparm(-1, "", armEnv, st)
    }

    // An arm's value (the value form): one expression — an expression arm, or
    // a `{ e }` block of one expression.
    fn plainArmValue(env: Env, a: AArm, want: Type | not, st: AS) -> RX {
        const body: AArmBody = a.body
        return match body {
            .ArmExpr(e: x) :> plainValueExpr(env, x, want, st)
            .ArmBlock(b: b) :> plainValueBlock(env, a, b, want, st)
        }
    }

    fn plainValueExpr(env: Env, x: AExpr, want: Type | not, st: AS) -> RX {
        if (isWriteExpr(x)) return plain(not, addDiag(resolveStmtExpr(env, x, st), env.file, x.span, "E-BOOTSTRAP-UNSUPPORTED", "a write as an arm of a `match` whose value is used — use the `match` as a statement (each arm a write), or write the `match`'s value: `@x = match … { … }`"))
        return resolveExpr(env, x, want, st)
    }

    fn plainValueBlock(env: Env, a: AArm, b: ABlock, want: Type | not, st: AS) -> RX {
        if (b.stmts.length == 1) {
            const x: AExpr | not = evalOf(b.stmts[0])
            if (x is given) return plainValueExpr(env, x, want, st)
        }
        // s469 (§18.5): a statement-holding arm whose value is a bare last expression —
        // after the §19.16.2 `defer` rule, in the order armBlock judges them (one report)
        const dsp: AStmt | not = directDefer(b)
        if (dsp is given) return plain(not, addDiag(resolveArmStmts(env, a, b, st), env.file, dsp.span, "E-DEFER-UNSUPPORTED-SITE", "a `defer` directly in an arm whose result is used as a value (a `match` whose value is used) — the deferred block would capture the arm's result (§19.16.2). Use the `match` as a statement and keep the `defer` in its arm, or move the `defer` to the enclosing block"))
        const bare: AExpr | not = bareTail(a, b)
        if (bare is given) return plain(not, addDiag(resolveBlock(env, b, st), env.file, bare.span, "E-ARM-TAIL-VALUE", armTailMsg()))
        return plain(not, addDiag(resolveArmStmts(env, a, b, st), env.file, b.span, "E-BOOTSTRAP-UNSUPPORTED", "a `{ … }` arm with statements, or a leaving arm (`return`, `fail`), in a `match` whose value is used — Core's `match` arm is one expression; compute the value before the `match`, or use the `match` as a statement and write the result in each arm"))
    }

    fn plainMatch(env: Env, e: AExpr, subj: AExpr, arms: AArm[], stmt: boolean, expected: Type | not, st0: AS) -> RX {
        let st: AS = plainMatchBinderDiags(env, arms, st0)
        const rs: RX = resolveExpr(withWhole(env, -1), subj, not, st)
        st = rs.st
        const sk: PSubj = plainSubject(env, subj, rs.x.ty, arms)
        if (sk.code != "") st = addDiag(st, env.file, subj.span, sk.code, sk.msg)
        let vs: VariantDef[] = []
        const es0: Sym | not = sk.es
        if (es0 is given) vs = enumVariantsOf(env.g, es0)
        let covered: int[] = []
        let lits: string[] = []
        let wild = false
        let notSeen = false
        let want: Type | not = expected
        let result: Type | not = not
        let parms: PlainArm[] = []
        for (const a of arms) {
            if (a.legacy) st = addDiag(st, env.file, a.span, "W-MATCH-ARROW-LEGACY", "the arm separator `=>` / `->` is deprecated — write `:>` (§18.2; `bun scrml migrate --fix` rewrites it)")
            if (wild) st = addDiag(st, env.file, a.span, "E-SYNTAX-010", afterWildMsg(false))
            const ra: RPArm = plainArm(env, a, sk, vs, st)
            st = ra.st
            const idx: int = ra.idx
            let dup = false
            if (idx >= 0) {
                if (covered.indexOf(idx) >= 0) dup = true
                covered = covered.concat([idx])
            }
            if (idx == -5) {
                if (notSeen) dup = true
                notSeen = true
            }
            if (idx == -6 && ra.key != "") {
                if (lits.indexOf(ra.key) >= 0) dup = true
                lits = lits.concat([ra.key])
            }
            if (dup && !wild) st = addDiag(st, env.file, a.span, "E-TYPE-023", "a second arm for the same case — the first arm already takes it, so this one is unreachable (§18.14.2 E-TYPE-023: duplicate match arm)")
            if (idx == -1) wild = true
            st = addFail(st, a.nid, FailFact.FArm(idx))
            let inner: Sym[] = []
            if (stmt) {
                for (const b of patBindsOf(a.pat)) {
                    const rb: RSym = mint(reservedName(st, env.file, b.span, b.name), b.name)
                    st = rb.st
                    inner = inner.concat([rb.s])
                }
            }
            parms = parms.concat([{ nid: a.nid, inner: inner }])
            if (stmt) {
                st = resolveArmBody(ra.env, a, a.body, { stmt: true, subj: subj, isMatch: true, what: "" }, st)
            } else {
                const rv: RX = plainArmValue(ra.env, a, want, st)
                st = rv.st
                if (want is not) want = rv.x.ty
                if (result is not) result = rv.x.ty
            }
        }
        const maybe: boolean = sk.maybe || notSeen
        const absentDone: boolean = !maybe || notSeen || wild
        let exh: boolean = wild
        if (sk.code == "") {
            if (sk.kind == 0) {
                let missing: string[] = []
                let i = 0
                for (const v of vs) {
                    if (covered.indexOf(i) < 0) missing = missing.concat(["." + v.sym.hint])
                    i = i + 1
                }
                let en: string = "the enum"
                if (es0 is given) en = "`" + es0.hint + "`"
                if (!wild && missing.length > 0) st = addDiag(st, env.file, e.span, "E-TYPE-020", "this `match` over " + en + " is not exhaustive: it does not cover " + missing.join(", ") + " — add those arms, or end with `else :>` (§18.8.1)")
                if (missing.length == 0 && absentDone) exh = true
                if (wild && missing.length == 0 && (!maybe || notSeen)) st = addDiag(st, env.file, e.span, "W-MATCH-001", "the wildcard arm is unreachable: every case of " + en + " already has an arm (§18.6)")
            }
            if (sk.kind == 3) {
                const both: boolean = lits.indexOf("b:true") >= 0 && lits.indexOf("b:false") >= 0
                if (both && absentDone) exh = true
                if (wild && both && (!maybe || notSeen)) st = addDiag(st, env.file, e.span, "W-MATCH-001", "the wildcard arm is unreachable: `true` and `false` both have an arm (§18.6)")
                if (!wild && !both) st = addDiag(st, env.file, e.span, "W-MATCH-002", "this `match` over a bool does not cover both `true` and `false` — a value with no arm gives `not`; add the other arm, or an `else` arm (§18.16.2)")
            }
            if ((sk.kind == 1 || sk.kind == 2) && !wild) st = addDiag(st, env.file, e.span, "W-MATCH-002", "this `match` over " + kindLabel(sk.kind) + " has no `else` arm — a value with no arm gives `not`; consider adding `else :>` (§18.16.2)")
            if (maybe && !notSeen && !wild) st = addDiag(st, env.file, e.span, "E-MATCH-012", "this `match` is over a `T | not` value but has no `not` arm and no `else` arm — add `not :> …` so the absent case is handled (§42.7)")
        }
        const r1: RSym = mint(st, "subject")
        const r2: RSym = mint(r1.st, "arm")
        st = addFail(r2.st, e.nid, FailFact.FPlain({ es: sk.es, kind: sk.kind, maybe: maybe, known: sk.known, wild: wild, exhaustive: exh, notArm: notSeen,
                                                      stmt: stmt, scrut: r1.s, pick: r2.s, arms: parms }))
        if (!exh && result is given) result = Type.Maybe(unMaybe(result))
        return plain(result, st)
    }

    fn okVariantMsg(err: Sym) -> string {
        return "`" + err.hint + "` has a variant named `Ok`, which a `match` on a failable result reserves for the success value (§19.7.3) — rename the variant"
    }

    // The arms of a `!{}` / `match`, resolved against enum `err` — what does
    // not depend on WHICH failure set the call has: every arm's pattern,
    // binders and body, a duplicate (E-TYPE-023), an arm after the wildcard
    // (E-SYNTAX-010). `covered`: the variant indices named; `wild`: a
    // wildcard arm (plain `_` / `else`, or `_ err`); `okSeen`: `.Ok`, or a
    // PLAIN wildcard (§18.6.1: `_ err` never takes `.Ok`).
    type RArms:struct = { st: AS, covered: int[], wild: boolean, okSeen: boolean }

    fn resolveArms(env: Env, subj: AExpr, arms: AArm[], err: Sym, isMatch: boolean, stmt: boolean, st0: AS) -> RArms {
        let st: AS = st0
        const vs: VariantDef[] = enumVariantsOf(env.g, err)
        let covered: int[] = []
        let wild = false          // a wildcard arm: plain `_` / `else`, or `_ err` — every remaining ERROR
        let okSeen = false        // `.Ok`, or a PLAIN wildcard (§18.6.1: `_ err` never takes `.Ok`)
        let wildWhole = false     // the first wildcard was `_ err`
        for (const a of arms) {
            const ra: RArm = resolveArm(env, a, err, vs, isMatch, { stmt: stmt, subj: subj, isMatch: isMatch, what: env.fx.wholeWhat }, st)
            st = ra.st
            // review MED-1 / LOW-1 — §18.8.1: "Duplicate variant arms (two arms for
            // the same variant) SHALL be a compile error (E-TYPE-023 …). The second
            // arm is unreachable." (`!{}` arms follow the match rule, §19 alias
            // note.) s452 r2 (LOW-3): an arm AFTER a wildcard is E-SYNTAX-010 —
            // §18.6 "The `else` arm SHALL be the last arm. An `else` arm that is
            // not the last arm SHALL be a compile error (E-SYNTAX-010)" (`_` is its
            // alias), and §18.6.1 for the whole-error binder: "it is the wildcard
            // for the last-arm position (E-SYNTAX-010)". After `_ err` the reason
            // is the position rule, NOT unreachability (`_ err` never takes `.Ok`).
            if (wild) {
                st = addDiag(st, env.file, a.span, "E-SYNTAX-010", afterWildMsg(wildWhole))
            } else if ((ra.idx >= 0 && covered.indexOf(ra.idx) >= 0) || (ra.idx == -2 && okSeen)) {
                st = addDiag(st, env.file, a.span, "E-TYPE-023", "a second arm for the same variant — the first arm already takes it, so this one is unreachable (§18.8.1 E-TYPE-023: duplicate match arm)")
            }
            if (ra.idx == -1) {
                wild = true
                okSeen = true                // a plain wildcard takes the success value too (§19.7.3)
            }
            if (ra.idx == -4 && !wild) {
                wild = true                  // `_ err`: every remaining error, never `.Ok` (§18.6.1)
                wildWhole = true
            }
            if (ra.idx == -2) okSeen = true
            if (ra.idx >= 0) covered = covered.concat([ra.idx])
        }
        return { st: st, covered: covered, wild: wild, okSeen: okSeen }
    }

    // What the failure set decides about resolved arms: totality over the
    // FIRST `upto` variants of `err` (-1: all of them) — E-TYPE-080 (`!{}`) /
    // E-TYPE-020 (`match`, which also owes `.Ok`) — and, in a deferred
    // statement, the catch-all §19.16.3 rule 3 requires.
    fn coverDiags(env: Env, e: AExpr, subj: AExpr, err: Sym, isMatch: boolean, ra: RArms, upto: int, label: string) -> Diag[] {
        const vs: VariantDef[] = enumVariantsOf(env.g, err)
        let missing: string[] = []
        if (isMatch && !ra.okSeen) missing = ["Ok"]
        if (!ra.wild) {
            let i = 0
            for (const v of vs) {
                if ((upto < 0 || i < upto) && ra.covered.indexOf(i) < 0) missing = missing.concat([v.sym.hint])
                i = i + 1
            }
        }
        if (!ra.wild && !isMatch && env.fx.defer) {
            return [newDiag("E-DEFER-UNHANDLED-FAILABLE", "a `!{ … }` handler in a deferred statement SHALL carry a catch-all `| _ :> …` arm (§19.16.3 rule 3) — listing every variant of `" + label + "` is not enough: a failure outside the declared enum would otherwise leave the `finally`", env.file, e.span)]
        }
        if (missing.length == 0) return []
        if (isMatch) return [newDiag("E-TYPE-020", "this `match` over the result of " + subjectName(subj) + " is not exhaustive: it does not cover " + missing.join(", ") + " — a `match` on a failable result covers `.Ok` and every variant of `" + label + "`, or ends with `else :>` / `_ :>` (§19.7.1)", env.file, e.span)]
        return [newDiag("E-TYPE-080", "this `!{ … }` handler on " + subjectName(subj) + " is not exhaustive: it does not cover " + missing.join(", ") + " of `" + label + "` — add those arms, or a catch-all `| _ :> …` (§19.7)", env.file, e.span)]
    }

    // How a client call's failure set is named in a message: the minted enum's
    // hint already reads `E + Transport` (`Transport` alone for a callee not
    // declared `!`); the wrapper's payload is spelled out. A declared enum that
    // IS the set (it declares the wrapper) is named as written.
    fn setLabel(env: Env, f: FnInfo, rset: Sym) -> string {
        const e: Sym | not = f.err
        if (e is given) {
            if (e.id == rset.id) return rset.hint
        }
        return rset.hint + "(t: ServerCallError)"
    }

    fn ownLabel(f: FnInfo) -> string {
        const e: Sym | not = f.err
        if (e is given) return e.hint
        return f.name
    }

    // =========================================================================
    // s454 (U1b) — A CALL OF A SERVER FUNCTION, JUDGED BY ITS SITE (§19.9.10).
    // "The rule applies to a call when both hold: 1. The callee is server-
    // placed … 2. The call is evaluated on the client". The callee half is
    // known here: its OWN body places it on the server (FnInfo.serverOwn —
    // §12.2 T1/T4; a callee placed only by Trigger 5 calls in place wherever
    // it is called from, so it is never the callee of a client call — design
    // §1.6). The caller half — the SITE:
    //   SiteLocal    a function whose own body places it on the server: the
    //                call is server→server ("Not affected"), judged as a local
    //                call (its failure set is the callee's own);
    //   SiteRemote   an event handler, an `<effect>` body: client by position;
    //   SitePending  a function with no server trigger of its own: whether it
    //                is client-placed is a WHOLE-PROGRAM fact (§19.9.10 "An
    //                implementation SHALL decide 'remote' from the resolved
    //                whole-program placement" — Trigger 5) — decided after the
    //                effect summary (rulesPass, PendRule.RemoteOr);
    //   SiteValue    a value position (an initializer, markup, an attribute
    //                value): E-VALUE-SERVER-CALL (§13.7), "not reported a
    //                second time as E-ERROR-002" — nothing here.
    // =========================================================================
    type SiteK:enum = { SiteLocal, SiteRemote, SitePending, SiteValue }

    fn siteOf(env: Env) -> SiteK {
        const h: HostCtx = env.host
        if (h == HostCtx.HostNo) return SiteK.SiteValue
        if (!env.fx.inFn) return SiteK.SiteRemote
        if (env.fx.serverOwn) return SiteK.SiteLocal
        return SiteK.SitePending
    }

    // The server-triggered function a call subject names, else not — by the
    // binder's own name rule (a local of that name shadows it; resolveName),
    // so it is known BEFORE the subject is resolved.
    fn serverCalleeNamed(env: Env, e: AExpr) -> FnInfo | not {
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return not
        const n: string = exprName(c)
        if (n == "") return not
        if (lookupLocal(env, n) is given) return not
        const f: FnInfo | not = fnNamed(env.g, env.file, n)
        if (f is not) return not
        if (!f.serverOwn) return not
        return f
    }

    // Report diagnostics that hold only when the site is a CLIENT call
    // (`remote`) or only when it is server→server (`local`), by the site.
    fn bySite(env: Env, site: SiteK, remote: Diag[], local: Diag[], st: AS) -> AS {
        if (site == SiteK.SiteRemote) return withDiags(st, remote)
        if (site == SiteK.SiteLocal) return withDiags(st, local)
        if (site == SiteK.SitePending) {
            if (remote.length == 0 && local.length == 0) return st
            return addPending(st, PendRule.RemoteOr(env.fx.fnSym, remote, local))
        }
        return st
    }

    fn withDiags(st: AS, ds: Diag[]) -> AS {
        let out: AS = st
        for (const d of ds) { out = withDiag(out, d) }
        return out
    }

    // A server function called and NOT handled: on the client it "SHALL be
    // E-ERROR-002" (§19.9.10 the rule) — in a deferred statement
    // E-DEFER-UNHANDLED-FAILABLE (§19.16.3 rule 3 "REPLACES E-ERROR-002"); a
    // server→server call of a function not declared `!` is valid ("An
    // unhandled server→server call stays valid"). (A `!` callee's unhandled
    // call is E-ERROR-002 everywhere — unhandledCall.)
    fn remoteUnhandled(env: Env, e: AExpr, f: FnInfo, st: AS) -> AS {
        const site: SiteK = siteOf(env)
        return bySite(env, site, [unhandledRemoteDiag(env, e, f)].concat(conflictDiags(env, f, e)), [], st)
    }

    fn unhandledRemoteDiag(env: Env, e: AExpr, f: FnInfo) -> Diag {
        if (env.fx.defer) return newDiag("E-DEFER-UNHANDLED-FAILABLE", "`" + f.name + "(…)` is a server function and this call is made on the client, so it can fail on the wire (§19.9.10) — and this is a deferred statement: handle it in place with a total `!{ … | _ :> … }` (§19.16.3 rule 3)", env.file, e.span)
        if (env.fx.inFn) return newDiag("E-ERROR-002", "Result of failable call '" + f.name + "(…)' is not handled: '" + f.name + "' is a server function and this call is made on the client, so it can fail on the wire (§19.9.10). Handle it: '" + f.name + "(…) !{ .Transport(t) :> … }', a 'match' on the result, or '?' inside a '!' function whose error enum declares 'Transport(t: ServerCallError)'", env.file, e.span)
        let owner: string = "an event handler"
        if (env.inEffect) owner = "an `<effect>` body"
        return newDiag("E-ERROR-002", "Result of failable call '" + f.name + "(…)' is not handled here: '" + f.name + "' is a server function and " + owner + " runs on the client, so the call can fail on the wire (§19.9.10). Catch it with '!{}' (e.g. '{ " + f.name + "(…) !{ .Transport(t) :> … } }'), match the result, or call it from a function that handles it (§19.4.3)", env.file, e.span)
    }

    // E-ERROR-016 at a client call site (transportConflict's rule), as a diagnostic list.
    fn conflictDiags(env: Env, f: FnInfo, e: AExpr) -> Diag[] {
        const st: AS = transportConflict(env.g, f, env.file, e.span, emptyAS())
        return st.diags
    }

    fn emptyAS() -> AS {
        return { facts: noFacts(), diags: [], nextSym: 0, annots: [], bad: { params: [], fields: [] }, effects: [], pend: [], lifts: [] }
    }

    // `f(…)?` / `f(…) !{ … }` / `match f(…) { … }` where `f` is server-
    // triggered and the site is (or may be) a client call. The failure set of
    // a client call is `f`'s declared variants plus `Transport(t:
    // ServerCallError)` (FnInfo.rerr — E's variants first, so an arm resolved
    // against it reads the same in E); of a server→server call, `f`'s own.
    fn remoteHandled(env: Env, e: AExpr, h: AHandled, subj: AExpr, f: FnInfo, site: SiteK, stmt: boolean, st0: AS) -> AS {
        let st: AS = st0
        const rset: Sym | not = f.rerr
        const how: AHow = h.how
        if (rset is not) {
            // no client failure set: E's `Transport` collides (E-ERROR-016 on a client
            // call), or E is not an enum (E-ERROR-011, reported). Judged as the local call.
            st = bySite(env, site, conflictDiags(env, f, e), [], st)
            return match how {
                .Propagate :> propagate(env, e, subj, f.failable, f.err, stmt, st)
                .Guard(arms: arms) :> guarded(env, e, subj, arms, f.failable, f.err, false, stmt, st)
                .MatchOn(arms: arms) :> guarded(env, e, subj, arms, f.failable, f.err, true, stmt, st)
            }
        }
        // Ue2 (a handled form nested in a larger expression): on a client call the
        // suspension plan lowers it (ANF, design §2.2) or refuses it by position; a
        // server→server call stays a local handled form, which this slice keeps whole.
        if (!stmt && env.fx.whole != e.nid) st = bySite(env, site, [], [newDiag("E-BOOTSTRAP-UNSUPPORTED", "a handled failable (`?`, `!{ … }`, `match`) " + ue2Reason(), env.file, e.span)], st)
        const nE: int = localCount(env, f)
        return match how {
            .Propagate :> remotePropagate(env, e, subj, f, rset, nE, site, stmt, st)
            .Guard(arms: arms) :> remoteGuarded(env, e, subj, arms, f, rset, nE, false, site, stmt, st)
            .MatchOn(arms: arms) :> remoteGuarded(env, e, subj, arms, f, rset, nE, true, site, stmt, st)
        }
    }

    // How many leading variants of the client set are `f`'s own: all of them
    // when `f`'s enum IS the set (it declares the wrapper), else its enum's
    // count (0 for a callee not declared `!`).
    fn localCount(env: Env, f: FnInfo) -> int {
        const e: Sym | not = f.err
        const r: Sym | not = f.rerr
        if (e is not || r is not) return 0
        if (e.id == r.id) return enumVariantsOf(env.g, r).length
        return enumVariantsOf(env.g, e).length
    }

    fn remoteFact(env: Env, f: FnInfo, retagT: Retag[]) -> RemoteFact {
        return { callee: f.sym, caller: env.fx.fnSym, local: f.err, retagT: retagT }
    }

    // `?` on the call — §19.9.10 "`?` on a client server call": "the enclosing
    // function's enum SHALL declare `Transport(t: ServerCallError)` — plus `f`'s
    // declared variants, as for any `?` — or the `?` is **E-ERROR-010**. For an
    // `f` not declared `!` this is `?` on a failable call (the call is failable
    // by this section), so E-ERROR-004 does not apply to it. The E-ERROR-010
    // message SHALL name the line to add". Server→server, the set is `f`'s own:
    // E-ERROR-004 for a callee not declared `!`.
    fn remotePropagate(env: Env, e: AExpr, subj: AExpr, f: FnInfo, rset: Sym, nE: int, site: SiteK, stmt: boolean, st0: AS) -> AS {
        if (!env.fx.failable) return addDiag(st0, env.file, e.span, "E-ERROR-003", e003Msg(env))
        const into: Sym | not = env.fx.err
        if (into is not) return st0                        // E-ERROR-011 reported
        // the callee's own variants: owed by both sets
        const own: RRetag = retagInto(env, rset, into, 0, nE, st0)
        let st: AS = own.st
        if (own.bad.length > 0) return addDiag(st, env.file, e.span, "E-ERROR-010", e010Msg(env, rset, into, own.bad))
        // the wire's `Transport`: owed by a client call only
        const tr: RRetag = retagInto(env, rset, into, nE, -1, st)
        st = tr.st
        let remote: Diag[] = []
        if (tr.bad.length > 0) remote = [newDiag("E-ERROR-010", "`" + f.name + "` is a server function: a call to it from the client can also fail on the wire. Add `Transport(t: ServerCallError)` to `" + into.hint + "`, or handle the call with `!{ … .Transport(t) :> … }` (§19.9.10, §19.5.3)", env.file, e.span)]
        let local: Diag[] = []
        if (!f.failable) local = [newDiag("E-ERROR-004", e004Msg(subj) + " — `" + f.name + "` is a server function called server→server here, so the call cannot fail on the wire (§19.9.10)", env.file, e.span)]
        st = bySite(env, site, remote.concat(conflictDiags(env, f, e)), local, st)
        return handledFact(env, e, rset, stmt, into, own.retag, remoteFact(env, f, tr.retag), st)
    }

    // `!{}` / `match` on the call: the arms resolve against the CLIENT set (the
    // maximal one — design F5 a); its totality is owed on a client call, the
    // callee's own on a server→server call — where a `.Transport` arm handles
    // nothing (§19.9.10: "When the callee is not declared `!`, the whole handler
    // is attached to a call that cannot fail and is **E-ERROR-013**. When the
    // callee is declared `!`, only the `.Transport` arm is dead; it SHALL be
    // reported as dead handling in the manner of E-ERROR-013 (the message names
    // the callee and says the call is server→server)").
    fn remoteGuarded(env: Env, e: AExpr, subj: AExpr, arms: AArm[], f: FnInfo, rset: Sym, nE: int, isMatch: boolean, site: SiteK, stmt: boolean, st0: AS) -> AS {
        let st: AS = st0
        if (isMatch && variantIndex(env.g.types, rset, "Ok") >= 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", okVariantMsg(rset))
        const ra: RArms = resolveArms(env, subj, arms, rset, isMatch, stmt, st)
        st = ra.st
        const remote: Diag[] = coverDiags(env, e, subj, rset, isMatch, ra, -1, setLabel(env, f, rset)).concat(conflictDiags(env, f, e))
        let local: Diag[] = []
        if (!f.failable) {
            let form: string = "'!{}' handler"
            if (isMatch) form = "'match'"
            local = [newDiag("E-ERROR-013", form + " on '" + f.name + "(…)', which cannot fail here: '" + f.name + "' is a server function, but this call is made on the SERVER (server→server, §19.9.10 \"Not affected\") — the callee runs in place, nothing crosses the wire, and '" + f.name + "' is not declared '!', so none of the handler's arms can run. Remove the handler", env.file, e.span)]
        } else {
            local = coverDiags(env, e, subj, rset, isMatch, ra, nE, ownLabel(f))
            if (nE < enumVariantsOf(env.g, rset).length && ra.covered.indexOf(nE) >= 0) {
                local = local.concat([newDiag("E-ERROR-013", "the `.Transport` arm handles nothing: `" + f.name + "` is called server→server here (§19.9.10 \"Not affected\": the callee runs in place, nothing crosses the wire), so the call fails only with `" + f.name + "`'s declared variants. Remove the `.Transport` arm", env.file, e.span)])
            }
        }
        st = bySite(env, site, remote, local, st)
        return handledFact(env, e, rset, stmt, not, [], remoteFact(env, f, []), st)
    }

    // s452 — §19.4.3 ruling 3: "A `!{}` handler SHALL be attached only to an
    // expression that can fail: a call to a function declared `!` (§19.4.1), a
    // call the compiler treats as `!` (a CPS body-split function, §19.9.5; a
    // built-in failable such as `parseVariant`, §41.13), or a `?{}` query … On
    // anything else … That SHALL be a compile error: E-ERROR-013" ("For a
    // handler on a non-call expression the message names the expression
    // instead"). Fail-closed readings (DESIGN.md item 2): a callee whose body
    // can place it on the server may be a client→server call, which §19.9.10
    // makes failable — that depends on where the CALLER runs, and the
    // client→server call is unit U1b: refused, never E-ERROR-013. A callee name
    // that did not resolve was reported (E-SCOPE-001 — the bootstrap has no
    // built-in `parseVariant`): no second report.
    fn deadHandler(env: Env, e: AExpr, subj: AExpr, st: AS) -> AS {
        const c: AExpr | not = calleeOf(subj.k)
        if (c is not) {
            const what: string = subjectLabel(subj)
            return addDiag(st, env.file, e.span, "E-ERROR-013", "'!{}' handler on '" + what + "', which cannot fail: '" + what + "' is not a call of a failable function, so none of its arms can run. Remove the '!{ … }' handler.")
        }
        const nf: NameFact | not = nameFactIn(st, c.nid)
        const f: FnInfo | not = calledFn(env, nf)
        if (f is given) {
            // s454 (U1b): a server-triggered callee reaches here only from a
            // server→server site (a client site is remoteHandled's) — §19.9.10:
            // "When the callee is not declared `!`, the whole handler is attached
            // to a call that cannot fail and is **E-ERROR-013**"
            if (f.serverOwn) return addDiag(st, env.file, e.span, "E-ERROR-013", "'!{}' handler on '" + f.name + "(…)', which cannot fail here: '" + f.name + "' is a server function, but this call is made on the SERVER (server→server, §19.9.10 \"Not affected\") — the callee runs in place, nothing crosses the wire, and '" + f.name + "' is not declared '!', so none of the handler's arms can run. Remove the handler")
            return addDiag(st, env.file, e.span, "E-ERROR-013", deadHandlerMsg(f.name))
        }
        const n: string = exprName(c)
        if (n != "" && nf is not) return st               // the name did not resolve: reported where it stands
        let label: string = n
        if (label == "") label = subjectLabel(c)
        return addDiag(st, env.file, e.span, "E-ERROR-013", deadHandlerMsg(label))
    }

    fn deadHandlerMsg(name: string) -> string {
        return "'!{}' handler on '" + name + "(…)', which cannot fail: '" + name + "' is not a failable function, so none of its arms can run. Remove the '!{ … }' handler, or declare '" + name + "' with '!' if it can fail."
    }

    // An expression as written, for E-ERROR-013's non-call form.
    fn subjectLabel(e: AExpr) -> string {
        const k: AExprK = e.k
        const lit: string = match k {
            .NotLit :> "not"
            .Num(raw: r) :> r
            .Bool(v: b) :> boolText(b)
            .Str(v: sv) :> "\"" + sv + "\""
            .Name(name: n) :> n
            .At(name: n) :> "@" + n
            .AtItem :> "@."
            .Recovered :> ""
            .Variant(name: n) :> "." + n
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: o) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
        if (lit != "") return lit
        const pk: string = placeKey(e)
        if (pk != "") return pk
        return "this expression"
    }

    fn boolText(b: boolean) -> string {
        if (b) return "true"
        return "false"
    }

    // One arm: its pattern's variant (`idx`: -1 wildcard, -2 `.Ok`, -3 none),
    // its binders (locals scoped to the arm), its body.
    type RArm:struct = { idx: int, st: AS }

    fn resolveArm(env: Env, a: AArm, err: Sym, vs: VariantDef[], isMatch: boolean, cx: ArmCx, st0: AS) -> RArm {
        let st: AS = st0
        if (a.legacy) st = addDiag(st, env.file, a.span, "W-MATCH-ARROW-LEGACY", "the arm separator `=>` / `->` is deprecated — write `:>` (§19 alias note; `bun scrml migrate --fix` rewrites it)")
        let armEnv: Env = withSubject(withWhole(env, -1), -1)
        let idx: int = -3
        const p: APat = a.pat
        const pn: PatName | not = patName(p)
        const wb: WholePat | not = wholePatOf(p)
        if (wb is given) {
            // s452 — §18.6.1: `_ err` matches every error variant an earlier arm
            // did not (never `.Ok`) and binds the WHOLE error value, typed as the
            // failure's error type. A bare name (§18.2) and `else err` (§18.6.1)
            // are E-MATCH-BARE-BINDER; they are bound anyway (one report, no
            // E-SCOPE-001 cascade) and count as that wildcard (no E-TYPE-080 one).
            idx = -4
            if (wb.bare) {
                st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", bareBinderFailableMsg(wb.b.name))
            } else if (wb.viaElse) {
                st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", elseBinderMsg(wb.b.name))
            }
            const rw: RBinds = bindWhole(armEnv, wb.b, err, st)
            armEnv = rw.env
            st = rw.st
        } else if (isNotPat(p) || litPatOf(p) is given) {
            // s469 — the §18 plain-value patterns are not patterns over a failure:
            // never read as a wildcard (that would take every case)
            st = addDiag(st, env.file, a.span, "E-TYPE-VARIANT", "`" + patLabel(p) + "` is not a pattern over a failable result — its arms are `.Ok(v)` (in a `match`) and the variants of `" + err.hint + "` (§19.7)")
        } else if (pn is not) {
            idx = -1
        } else if (isMatch && pn.name == "Ok") {
            idx = -2
            if (pn.parens && pn.binds.length != 1) st = addDiag(st, env.file, a.span, "E-TYPE-021", "`.Ok` carries one value (the success value, §19.7.3) — bind it as `.Ok(v)`, not with " + pn.binds.length + " binder(s)")
            const rb: RBinds = bindArm(armEnv, pn.binds, [], st)
            armEnv = rb.env
            st = rb.st
        } else {
            const i: int = variantIndex(env.g.types, err, pn.name)
            // s469 — a qualified `E.V` (§18.13): `E` must name an enum that declares `V`
            if (pn.qual != "" && i >= 0 && !qualNames(env, pn.qual, pn.name)) st = addDiag(st, env.file, a.span, "E-TYPE-VARIANT", "`" + pn.qual + "." + pn.name + "` — `" + pn.qual + "` is not an enum that declares `" + pn.name + "` (the failure here is `" + err.hint + "`, §18.13)")
            if (i < 0) {
                let what: string = "`." + pn.name + "` is not a variant of `" + err.hint + "`"
                if (pn.name == "Ok") what = "`.Ok` is the success value of a `match` — a `!{ … }` handler's arms are failures only"
                st = addDiag(st, env.file, a.span, "E-TYPE-VARIANT", what + " (its variants: " + variantNamesOf(vs).join(", ") + ")")
                const rb0: RBinds = bindArm(armEnv, pn.binds, [], st)     // bound anyway: one report, not a cascade
                armEnv = rb0.env
                st = rb0.st
            } else {
                idx = i
                const fs: FieldDef[] = vs[i].fields
                if (pn.parens && pn.binds.length != fs.length) st = addDiag(st, env.file, a.span, "E-TYPE-021", "`." + pn.name + "` carries " + fs.length + " value(s) but the pattern binds " + pn.binds.length + " — bind one name (or `_`) per payload field, in declaration order (§18.7)")
                // s452 — the legacy paren-free binder `.V m` (a `!{}` arm only, the
                // parser's): §19.4.3 ruling 2 "the same pattern as `| .V(m) :>`: `m`
                // binds the variant's PAYLOAD … under §18.7's positional arity: on a
                // unit variant or a variant with two or more fields it SHALL be E-TYPE-021"
                if (!pn.parens && pn.binds.length == 1 && fs.length != 1) st = addDiag(st, env.file, a.span, "E-TYPE-021", "`." + pn.name + " " + pn.binds[0].name + "` binds ONE payload value (it is `." + pn.name + "(" + pn.binds[0].name + ")`, §19.4.3) but `." + pn.name + "` carries " + fs.length + " — bind every field positionally (`." + pn.name + "(a, b)`), or none (`." + pn.name + "`) (§18.7)")
                const rb2: RBinds = bindArm(armEnv, pn.binds, fs, st)
                armEnv = rb2.env
                st = rb2.st
            }
        }
        st = addFail(st, a.nid, FailFact.FArm(idx))
        const body: AArmBody = a.body
        st = resolveArmBody(armEnv, a, body, cx, st)
        return { idx: idx, st: st }
    }

    type PatName:struct = { name: string, binds: ABind[], parens: boolean, qual: string }

    fn patName(p: APat) -> PatName | not {
        return match p {
            .PName(name: n, binds: bs, parens: pr, qual: q) :> { name: n, binds: bs, parens: pr, qual: q }
            .PWild :> not
            .PWhole(bind: b) :> not
            .PBare(bind: b) :> not
            .PNot :> not
            .PLit(e: x) :> not
        }
    }

    // s452 r2 — E-SYNTAX-010's message, true for both kinds of wildcard.
    fn afterWildMsg(whole: boolean) -> string {
        if (whole) return "an arm after the whole-error binder `_ err` — it is the wildcard and SHALL be the last arm (§18.6.1, §18.6: E-SYNTAX-010). It takes every remaining error but never `.Ok`, so write the `.Ok` arm (and every other arm) before it"
        return "an arm after the wildcard (`_` / `else`) — the wildcard SHALL be the last arm (§18.6: E-SYNTAX-010); it already took every remaining case, so this arm could never run. Move the wildcard last"
    }

    // s452 — an arm whose pattern binds the whole matched value: `_ err`
    // (§18.6.1), `else err` (`viaElse`), or a bare `err` (`bare`, §18.2).
    type WholePat:struct = { b: ABind, viaElse: boolean, bare: boolean }

    fn wholePatOf(p: APat) -> WholePat | not {
        return match p {
            .PWhole(bind: b, viaElse: v) :> { b: b, viaElse: v, bare: false }
            .PBare(bind: b) :> { b: b, viaElse: false, bare: true }
            .PName(name: n) :> not
            .PWild :> not
            .PNot :> not
            .PLit(e: x) :> not
        }
    }

    // The whole-error binder's local: typed as the failure's error enum
    // (§18.6.1 "The binder's type is the type of the failure being handled").
    fn bindWhole(env: Env, b: ABind, err: Sym, st0: AS) -> RBinds {
        const rb: RSym = mint(reservedName(st0, env.file, b.span, b.name), b.name)
        const st: AS = addBind(rb.st, b.nid, BindFact.BBind(rb.s))
        if (b.name == "_") return { env: env, st: st }
        return { env: withLocal(env, { name: b.name, s: rb.s, ty: Type.Named(err), mutable: false, narrowed: not, nDecl: not, fresh: false }), st: st }
    }

    // §18.2's message at a failable site (a `!{}` arm, a `match` on a failable result).
    fn bareBinderFailableMsg(name: string) -> string {
        return "Arm pattern '" + name + "' is a bare name. To bind the whole error, write '_ " + name + "' (e.g. '| _ " + name + " :>'); for a catch-all that binds nothing write '_' (or 'else'); or name the variant ('.V(x)') to bind its payload."
    }

    // §18.2's message in a `match` on any other value.
    fn bareBinderPlainMsg(name: string) -> string {
        return "Arm pattern '" + name + "' is a bare name. A match arm does not bind the whole value: write '_' (or 'else') for a catch-all, or name the variant ('.V(x)') to bind its payload."
    }

    // §18.6.1: `else <name>` — "for the second it offers `_ <name>`".
    fn elseBinderMsg(name: string) -> string {
        return "Arm pattern 'else " + name + "' binds a name to 'else', which binds nothing (§18.6). To bind the whole error, write '_ " + name + "' (e.g. '| _ " + name + " :>'); for a catch-all that binds nothing write 'else' alone."
    }

    // §18.6.1: `_ <name>` on a `match` whose subject is not a failable result —
    // "says that a match arm binds the whole value only where it is an error,
    // and offers `_` / `else` or a named variant".
    fn wholeBinderPlainMsg(name: string) -> string {
        return "Arm pattern '_ " + name + "' binds the whole matched value, which a match arm does only where that value is an error — a '!{}' arm or a 'match' on a failable result (§18.6.1). Here write '_' (or 'else') for a catch-all, or name the variant ('.V(x)') to bind its payload."
    }

    // s452 — E-MATCH-BARE-BINDER for every misplaced binder of a `match` whose
    // subject is NOT a failable result (§18.2, §18.6.1): a bare name, `_ name`,
    // `else name`.
    fn plainMatchBinderDiags(env: Env, arms: AArm[], st0: AS) -> AS {
        let st: AS = st0
        for (const a of arms) {
            const wb: WholePat | not = wholePatOf(a.pat)
            if (wb is given) {
                let m: string = wholeBinderPlainMsg(wb.b.name)
                if (wb.bare) m = bareBinderPlainMsg(wb.b.name)
                if (wb.viaElse) m = elseBinderMsg(wb.b.name)
                st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", m)
            }
        }
        return st
    }

    // The same for a `!{}` on something that cannot fail — a `!{}` arm is a
    // failable site whatever its subject, so `_ name` is legal there; a bare
    // name and `else name` are not (§18.2, §18.6.1).
    fn deadHandlerBinderDiags(env: Env, arms: AArm[], st0: AS) -> AS {
        let st: AS = st0
        for (const a of arms) {
            const wb: WholePat | not = wholePatOf(a.pat)
            if (wb is given) {
                if (wb.bare) st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", bareBinderFailableMsg(wb.b.name))
                if (wb.viaElse) st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", elseBinderMsg(wb.b.name))
            }
        }
        return st
    }

    fn variantNamesOf(vs: VariantDef[]) -> string[] {
        let out: string[] = []
        for (const v of vs) { out = out.concat([v.sym.hint]) }
        return out
    }

    type RBinds:struct = { env: Env, st: AS }

    // The arm's binders: a minted local each (`_` binds nothing visible),
    // typed by the payload field it takes (`.Ok`'s by nothing: the success
    // type is not written, §19.4.1).
    fn bindArm(env0: Env, bs: ABind[], fs: FieldDef[], st0: AS) -> RBinds {
        let env: Env = env0
        let st: AS = st0
        let i = 0
        for (const b of bs) {
            const rb: RSym = mint(reservedName(st, env.file, b.span, b.name), b.name)
            st = addBind(rb.st, b.nid, BindFact.BBind(rb.s))
            let ty: Type | not = not
            if (i < fs.length) ty = fs[i].ty
            if (b.name != "_") env = withLocal(env, { name: b.name, s: rb.s, ty: ty, mutable: false, narrowed: not, nDecl: not, fresh: false })
            i = i + 1
        }
        return { env: env, st: st }
    }

    // s452 — what an arm's body is judged against: `stmt` — the form is a
    // statement (its result is not read); otherwise it stands in a VALUE
    // position `what` (§19.4.3 ruling 1a), and every arm yields a value or leaves.
    type ArmCx:struct = { stmt: boolean, subj: AExpr, isMatch: boolean, what: string }

    // An arm's body. As a statement's arm, an expression is a statement (a
    // write, a call) and an arm MAY fall through. In a value position (§19.4.3
    // ruling 1a) an arm "SHALL either yield a value of the call's success type
    // or leave (`return` / `fail`)": an expression arm is its value, a block
    // arm's value is its last expression (§18.5 "The block's result is its
    // **last expression**"); an arm that does neither falls through —
    // E-ERROR-012. (The bootstrap has no loops, so `break` / `continue` — which
    // §19.4.3 also counts as leaving — have no source form here.)
    fn resolveArmBody(env: Env, a: AArm, body: AArmBody, cx: ArmCx, st: AS) -> AS {
        return match body {
            .ArmExpr(e: x) :> armExpr(env, a, x, cx, st)
            .ArmBlock(b: b) :> armBlock(withLift(env, LiftCtx.LiftInArm), a, b, cx, st)   // s469: no `lift` reaches past an arm (resolveLift)
        }
    }

    fn armExpr(env: Env, a: AArm, x: AExpr, cx: ArmCx, st: AS) -> AS {
        if (cx.stmt) return resolveStmtExpr(withWhole(env, x.nid), x, st)
        return armValueExpr(env, a, x, cx, st)
    }

    // The expression that is an arm's value (an expression arm, or a block
    // arm's last statement): a write is resolved as the statement it is and
    // falls through; a value is resolved as the arm's value (a handling form
    // there is a statement's whole value — its own Attempt, Ue); a call of a
    // function that yields nothing falls through.
    fn armValueExpr(env: Env, a: AArm, x: AExpr, cx: ArmCx, st0: AS) -> AS {
        if (isWriteExpr(x)) return fallsThrough(env, a, cx, resolveStmtExpr(env, x, st0))
        const st: AS = resolveExpr(withStmtCall(withWholeAt(env, x.nid, "the value of an enclosing arm"), x.nid), x, not, st0).st
        return pendNoValue(env, a, cx, x, st)
    }

    // A call of a declared scrml function as the arm's value: whether it yields
    // a value is the effect summary's `noValue` (transitive through
    // `return <call>` — G7), decided by rulesPass (dpa-066 M3).
    fn pendNoValue(env: Env, a: AArm, cx: ArmCx, x: AExpr, st: AS) -> AS {
        const c: AExpr | not = calleeOf(x.k)
        if (c is not) return st
        const f: FnInfo | not = calledFn(env, nameFactIn(st, c.nid))
        if (f is not) return st
        return addPending(st, PendRule.IfNoValue(f.sym.id, fallsThroughDiag(env, a, cx)))
    }

    fn armBlock(env: Env, a: AArm, b: ABlock, cx: ArmCx, st0: AS) -> AS {
        if (cx.stmt) {
            // s469 (§18.5): "In a STATEMENT position a block arm yields nothing and
            // needs no `lift`" — a `lift` there yields to nothing; refused, fail closed
            if (a.lifted) return addDiag(resolveArmStmts(env, a, b, st0), env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "a `lift` in an arm whose value is not used (a statement-position `match` / `!{}`) yields to nothing (§18.5: in a statement position a block arm yields nothing and needs no `lift`) — drop the `lift`, or use the form's value")
            return resolveBlock(env, b, st0)
        }
        // s452 r2 (HIGH-1) — §19.16.2: "The same code covers a `defer` written
        // directly in an arm of a `match` / `if` / `for` that is used for its
        // VALUE … the defer block would capture it" — E-DEFER-UNSUPPORTED-SITE.
        // PA readings (DESIGN.md §3): a `!{}` arm is the same shape (both lower
        // to one Attempt); an arm that LEAVES (`{ defer …; return x }`) is still
        // an arm used for its value — refused too (fail closed, reversible). A
        // `defer` in a STATEMENT-position arm stays legal (above).
        const dsp: AStmt | not = directDefer(b)
        if (dsp is given) return addDiag(resolveArmStmts(env, a, b, st0), env.file, dsp.span, "E-DEFER-UNSUPPORTED-SITE", "a `defer` directly in an arm whose result is used as a value (" + whereLabel(cx.what) + ") — the deferred block would capture the arm's result (§19.16.2). Handle the call as a statement and keep the `defer` in its arm, or move the `defer` to the enclosing block")
        if (blockDiverges(b)) return resolveBlock(env, b, st0)
        const n: int = b.stmts.length
        if (n == 0) return fallsThrough(env, a, cx, st0)
        const last: AExpr | not = evalOf(b.stmts[n - 1])
        if (last is not) return fallsThrough(env, a, cx, resolveBlock(env, b, st0))
        // s469 (§18.5, RULED S469 "block arms yield with `lift`"): a statement-holding
        // block arm yields only by `lift`; a bare last expression is E-ARM-TAIL-VALUE
        // (resolved as before, so it adds no cascade)
        let st1: AS = st0
        const bare: AExpr | not = bareTail(a, b)
        if (bare is given) st1 = addDiag(st0, env.file, bare.span, "E-ARM-TAIL-VALUE", armTailMsg())
        // `{ statement* lift expression }`: the statements in order (their locals in
        // scope for the value), then the lifted expression as the arm's value
        let st: AS = st1
        let env2: Env = env
        let i = 0
        while (i < n - 1) {
            const r: RB = resolveStmt(env2, b.stmts[i], st)
            env2 = r.env
            st = r.st
            i = i + 1
        }
        return armValueExpr(env2, a, last, cx, st)
    }

    // s469 (§18.5) — the BARE last expression of a value-position block arm that
    // holds a statement: two or more statements, the last an expression, not
    // written `lift`. A single-expression `{ e }` is that expression (unchanged:
    // the §17.6.10 single-expression reading, which S469 keeps for a branch);
    // `not` otherwise.
    fn bareTail(a: AArm, b: ABlock) -> AExpr | not {
        if (a.lifted || b.stmts.length < 2) return not
        const x: AExpr | not = evalOf(b.stmts[b.stmts.length - 1])
        if (x is not) return not
        // review F4: only an expression that could be a value — never a write (an
        // assignment, a recognized edit), whose arm falls through (E-ERROR-012 says so)
        if (isWriteExpr(x)) return not
        return x
    }

    // review F5 — an arm block resolved where its value is refused (or yields to
    // nothing): its statements in order, then a `lift` operand resolved as the VALUE it
    // is — never as a statement, so a `match` there keeps its value position and its
    // own arms are not judged as statement-position arms (no second, misleading report).
    fn resolveArmStmts(env: Env, a: AArm, b: ABlock, st0: AS) -> AS {
        if (!a.lifted || b.stmts.length == 0) return resolveBlock(env, b, st0)
        const n: int = b.stmts.length
        const last: AExpr | not = evalOf(b.stmts[n - 1])
        if (last is not) return resolveBlock(env, b, st0)
        let st: AS = st0
        let env2: Env = env
        let i = 0
        while (i < n - 1) {
            const r: RB = resolveStmt(env2, b.stmts[i], st)
            env2 = r.env
            st = r.st
            i = i + 1
        }
        return resolveExpr(withWholeAt(env2, last.nid, "the value of an enclosing arm"), last, not, st).st
    }

    fn armTailMsg() -> string {
        return "a block arm whose value is used ends in a bare expression — a block arm that holds a statement yields its value with `lift` (§18.5, ruled S469: \"Block arms yield with lift\"); write `lift <expr>` as its last statement"
    }

    // The first `defer` written directly in `b` (not in a nested block), else not.
    fn directDefer(b: ABlock) -> AStmt | not {
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const isD: boolean = match k {
                .Defer(body: d) :> true
                .Eval(e: x) :> false
                .Local(name: n) :> false
                .Return(e: x) :> false
                .If(cond: c) :> false
                .Given(name: n) :> false
                .For(f: lf) :> false
                .Break(label: x) :> false
                .Continue(label: x) :> false
                .Lift(what: x) :> false
                .EffectStmt(w: w) :> false
                .Fail(f: x) :> false
            }
            if (isD) return s
        }
        return not
    }

    fn evalOf(s: AStmt) -> AExpr | not {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: x) :> x
            .Local(name: n) :> not
            .Return(e: x) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .For(f: lf) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: x) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: d) :> not
            .Fail(f: x) :> not
        }
    }

    // A write in expression form — an assignment, `reset(@x)`, or an edit call
    // on a reactive place (`@xs.push(v)`, `@xs.pop()`): it produces no value.
    fn isWriteExpr(x: AExpr) -> boolean {
        if (assignValue(x) is given) return true
        const c: AExpr | not = calleeOf(x.k)
        if (c is not) return false
        if (exprName(c) == "reset") return true
        const m: MethodCall | not = methodCall(c)
        if (m is given) return isReactiveRoot(placeRoot(m.obj))
        const rm: MethodCall | not = removeCall(c)
        if (rm is given) return isReactiveRoot(placeRoot(rm.obj))
        return false
    }

    // What "yields a value" reads in a body (ownNoValue, the effect summary's
    // own fact; the rule is stated there).
    fn declaresVoid(t: AType) -> boolean {
        const k: ATypeK = t.k
        return match k {
            .TName(name: n) :> n == "void"
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
        }
    }

    // Does SOME statement of `b` return a value on every path through it (the
    // first such statement ends every path that reaches it)?
    fn blockYieldsOnAllPaths(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtYieldsOnAllPaths(s)) return true
        }
        return false
    }

    fn stmtYieldsOnAllPaths(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> x is given
            .If(cond: c, thenB: t, elseB: el) :> blockYieldsOnAllPaths(t) && maybeBlockYields(el)
            .Given(name: n) :> false
            .For(f: lf) :> loopNeverCompletes(lf)
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: x) :> false
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false
            .Fail(f: x) :> false
        }
    }

    fn maybeBlockYields(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockYieldsOnAllPaths(b)
    }

    // A `return` with no value anywhere in `b` (s452 r3 MED-B).
    fn blockHasBareReturn(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtHasBareReturn(s)) return true
        }
        return false
    }

    fn stmtHasBareReturn(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> returnIsBare(x)
            .If(cond: c, thenB: t, elseB: el) :> exprHasBareReturn(c) || blockHasBareReturn(t) || maybeBlockHasBareReturn(el)
            .Given(name: n, subject: x, body: b) :> exprHasBareReturn(x) || blockHasBareReturn(b)
            .For(f: lf) :> forHasBareReturn(lf)
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: w) :> liftHasBareReturn(w)
            .Eval(e: x) :> exprHasBareReturn(x)
            .Local(name: n, init: i) :> exprHasBareReturn(i)
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false                       // a deferred body holds no `return` (§19.16.3 rule 1)
            .Fail(f: x) :> false
        }
    }

    fn returnIsBare(x: AExpr | not) -> boolean {
        if (x is not) return true
        return exprHasBareReturn(x)
    }

    fn maybeBlockHasBareReturn(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockHasBareReturn(b)
    }

    // ... inside a handling form's arm block in `e`, at any depth.
    fn liftHasBareReturn(w: ALift) -> boolean {
        for (const e of liftExprs(w)) {
            if (exprHasBareReturn(e)) return true
        }
        return false
    }

    fn exprHasBareReturn(e: AExpr) -> boolean {
        for (const b of exprBlocks(e)) {
            if (blockHasBareReturn(b)) return true
        }
        for (const x of exprKids(e)) {
            if (exprHasBareReturn(x)) return true
        }
        return false
    }

    // E-ERROR-012 (§19.4.3 ruling 1a), with the SPEC's message.
    fn fallsThrough(env: Env, a: AArm, cx: ArmCx, st: AS) -> AS {
        return withDiag(st, fallsThroughDiag(env, a, cx))
    }

    fn fallsThroughDiag(env: Env, a: AArm, cx: ArmCx) -> Diag {
        const pat: string = patLabel(a.pat)
        const where: string = whereLabel(cx.what)
        const form: string = handledFormLabel(cx)
        const n: string = exprName(maybeCallee(cx.subj))
        if (n != "") {
            return newDiag("E-ERROR-012", "Arm '" + pat + "' of the " + form + " on '" + n + "(…)' produces no value, but the " + form + "'s result is used here (" + where + "). In a value position every arm must yield a value of '" + n + "'s success type or leave with 'return' / 'fail'. End the arm with a fallback value (e.g. '| " + pat + " :> { @phase = …; fallback }'), leave with 'return', or call '" + n + "(…) !{ … }' as a statement and keep the writes in its arms.", env.file, a.span)
        }
        return newDiag("E-ERROR-012", "Arm '" + pat + "' of the " + form + " on " + subjectName(cx.subj) + " produces no value, but the " + form + "'s result is used here (" + where + "). In a value position every arm must yield a value of its success type (a `" + sqlSigil() + "}` query's is its terminator's, §44.3: `.get()` → `Row | not`, `.all()` → `Row[]`) or leave with 'return' / 'fail'. End the arm with a fallback value (e.g. '| " + pat + " :> { @phase = …; fallback }'), leave with 'return', or handle it as a statement and keep the writes in its arms.", env.file, a.span)
    }

    fn maybeCallee(e: AExpr) -> AExpr {
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return e
        return c
    }

    fn handledFormLabel(cx: ArmCx) -> string {
        if (cx.isMatch) return "match"
        return "handler"
    }

    fn whereLabel(what: string) -> string {
        if (what == "") return "a value position"
        return what
    }

    // An arm's pattern, as written (for messages).
    fn patLabel(p: APat) -> string {
        return match p {
            .PName(name: n, binds: bs, parens: pr) :> patNameLabel(n, bs, pr)
            .PWild :> "_"
            .PWhole(bind: b, viaElse: v) :> wholeLabel(b.name, v)
            .PBare(bind: b) :> b.name
            .PNot :> "not"
            .PLit(e: x) :> subjectLabel(x)
        }
    }

    fn patNameLabel(n: string, bs: ABind[], parens: boolean) -> string {
        if (!parens) return "." + n
        return "." + n + "(" + bindNames(bs).join(", ") + ")"
    }

    fn wholeLabel(name: string, viaElse: boolean) -> string {
        if (viaElse) return "else " + name
        return "_ " + name
    }

    // Does every path through `b` leave the function (`return` / `fail`)?
    fn blockDiverges(b: ABlock) -> boolean {
        if (b.stmts.length == 0) return false
        return stmtDiverges(b.stmts[b.stmts.length - 1])
    }

    fn stmtDiverges(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> true
            .Fail(f: x) :> true
            .If(cond: c, thenB: t, elseB: el) :> blockDiverges(t) && elseDiverges(el)
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .Given(name: n) :> false
            .For(f: lf) :> loopNeverCompletes(lf)
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: x) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: x) :> false
        }
    }

    fn elseDiverges(el: ABlock | not) -> boolean {
        if (el is not) return false
        return blockDiverges(el)
    }

    // §19.8.3 (R11) / §19.8.2 — a `?{}` no handling form takes. In a function
    // body: outside a `!` function E-ERROR-002; inside one it propagates
    // implicitly ("The `?{}` expression behaves as if it were a `!` function
    // call") — §19.8.4 "propagated if the enclosing function's error type is
    // compatible, or SHALL be a compile error if incompatible" (E-ERROR-010).
    // Elsewhere (a handler, an effect, markup) a query is refused by placement
    // (U1d / E-VALUE-SERVER-CALL) — placePass's.
    fn resolveSql(env: Env, e: AExpr, q: ASql, stmt: boolean, st0: AS) -> RX {
        const st: AS = resolveExprs(env, q.params, not, st0)
        if (!env.fx.inFn || q.handled) return plain(not, st)
        if (env.fx.defer) return plain(not, addDiag(st, env.file, e.span, "E-DEFER-UNHANDLED-FAILABLE", "this `" + sqlSigil() + "}` query is failable and stands in a deferred statement — handle it in place with a total `!{ … | _ :> … }` (§19.16.3 rule 3); an enclosing `!` does not cover it"))
        if (!env.fx.failable) return plain(not, addDiag(st, env.file, e.span, "E-ERROR-002", "this `" + sqlSigil() + "}` query is failable (§19.8.3, S451): outside a `!` function it must be handled at the site — a `!{ … }` handler on the query, or a `match` on its result — or moved into a `!` function, where a failure propagates (§19.8.2). (\"No row\" is not a failure: `.get()` returns `not`, `.all()` `[]`.)"))
        if (!stmt && env.fx.whole != e.nid) return plain(not, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a `" + sqlSigil() + "}` query that a `!` function propagates implicitly (§19.8.2) " + ue2Reason()))
        return plain(not, propagationFact(env, e, env.g.sqlErrorSym, stmt, st))
    }

    // §19.3 — `fail …`. §19.3.3: "`fail` SHALL be valid only inside a function
    // body declared with the `!` modifier … E-ERROR-001"; "The variant
    // specified in the `fail` statement SHALL be a valid variant of that error
    // enum type … E-ERROR-009 … a variant undeclared by the declared enum, a
    // `fail` naming a foreign enum entirely, and a `fail` target that is not an
    // enum variant"; the bare form resolves against the declared type; a valid
    // variant with the wrong payload count is E-TYPE-082 ("never double-fire").
    // s469 (§7.2.2 rule 10): `fail` is a keyword at statement start regardless of line,
    // so its operand may have been read from the next line (`fail⏎h(1);`) — say so.
    fn failSplitNote(f: AFail) -> string {
        if (f.split) return " — note: the operand of `fail` was read from the next line (`fail` is a keyword at statement start, §7.2.2 rule 10); if this line was meant to stand on its own, give `fail` its variant on its own line"
        return ""
    }

    fn resolveFail(env: Env, s: AStmt, f: AFail, st0: AS) -> AS {
        let st: AS = resolveExprs(env, f.args, not, st0)
        const t: AExpr | not = f.target
        if (t is given) st = resolveExpr(env, t, not, st).st
        if (!env.fx.failable) {
            let where: string = "outside any function (a handler, an effect or markup)"
            if (env.fx.inFn) where = "in function '" + env.fx.fnName + "', which is not declared as failable"
            return addDiag(st, env.file, s.span, "E-ERROR-001", "'fail' used " + where + ". Add '!' to the function signature: 'function " + env.fx.fnName + "(...)! ErrorType' (§19.3.3)" + failSplitNote(f))
        }
        const err: Sym | not = env.fx.err
        if (err is not) return st                          // E-ERROR-011 reported
        const vs: VariantDef[] = enumVariantsOf(env.g, err)
        const valid: string = variantNamesOf(vs).join(", ")
        if (t is given) return addDiag(st, env.file, s.span, "E-ERROR-009", "'fail' names something that is not a variant of the declared error type '" + err.hint + "' for function '" + env.fx.fnName + "'. Valid variants: " + valid + " (§19.3.3)" + failSplitNote(f))
        if (f.enumName != "") {
            const named: Sym | not = typeNamedHere(env, f.enumName)
            let same = false
            if (named is given) same = named.id == err.id
            if (!same) return addDiag(st, env.file, s.span, "E-ERROR-009", "'fail' names variant '" + f.enumName + "." + f.variant + "', which is not a valid variant of the declared error type '" + err.hint + "' for function '" + env.fx.fnName + "' — '" + f.enumName + "' is a different type. Valid variants: " + valid + " (§19.3.3)" + failSplitNote(f))
        }
        const idx: int = variantIndex(env.g.types, err, f.variant)
        if (idx < 0) return addDiag(st, env.file, s.span, "E-ERROR-009", "'fail' names variant '" + f.variant + "' which is not a valid variant of the declared error type '" + err.hint + "' for function '" + env.fx.fnName + "'. Valid variants: " + valid + " (§19.3.3)" + failSplitNote(f))
        const n: int = vs[idx].fields.length
        if (n != f.args.length) return addDiag(st, env.file, s.span, "E-TYPE-082", "`" + err.hint + "." + f.variant + "` carries " + n + " payload value(s) but this `fail` supplies " + f.args.length + " — one argument per declared field, in order (§19.3.3, §14.4)")
        return addFail(st, s.nid, FailFact.FFail(err, idx))
    }

    // The type a name denotes where `env` stands (user types first, so a user
    // `Error` shadows the built-in), else not.
    fn typeNamedHere(env: Env, name: string) -> Sym | not {
        const s: TypeStub | not = stubNamed(teAt(env.g.te, env.file), name)   // s472: in THIS file's scope
        if (s is not) return not
        return s.sym
    }

    // =========================================================================
    // s449 — a reactive effect (SPEC §6.7.4), `<effect deps=[…]>${ … }</>` or
    // its soft-deprecated keyword spelling, where markup stands: the `<program>`
    // body, an `if=` element, an `<each>` row. Codes here:
    //   E-EFFECT-NO-DEPS — "An `<effect>` with no `deps=`, or with `deps=[]`,
    //     never runs (it does not run on mount) and is E-EFFECT-NO-DEPS";
    //   E-LIFECYCLE-007 — "Every `deps=` entry SHALL be a declared, mutable
    //     reactive cell in scope at the `<effect>`. An undeclared name, a
    //     non-`@` name, or a derived cell … is E-LIFECYCLE-007";
    //   W-LIFECYCLE-010 — "An empty body … is W-LIFECYCLE-010";
    //   W-WHEN-EFFECT-DEPRECATED — the keyword spelling, "with
    //     W-WHEN-EFFECT-DEPRECATED at every site".
    // The no-write rule (E-EFFECT-WRITES-STATE / E-EFFECT-WRITE-UNPROVEN) needs
    // every function's write summary, so the effect is recorded here and judged
    // by effectPass once all bodies are bound.
    // Refused (E-BOOTSTRAP-UNSUPPORTED, fail closed): an effect in a user
    // declaration's `renders` (which scope owns it — the instance or the render
    // site — is not settled), and a dependency naming a whole instance.
    // =========================================================================
    fn resolveEffect(env: Env, w: AEffect, st0: AS) -> AS {
        let st: AS = st0
        if (!inProgramCtx(env) || env.own != "") {
            return addDiag(st, env.file, w.span, "E-BOOTSTRAP-UNSUPPORTED", "an effect inside a declaration's `renders` is not in the bootstrap — which scope owns it (the instance or the render site) is not settled (§6.7.4 / §66); write it in the program's markup")
        }
        if (w.keyword) {
            st = addDiag(st, env.file, w.span, "W-WHEN-EFFECT-DEPRECATED", "`when … changes { … }` is the soft-deprecated spelling of an `<effect>` — write " + effectSpelling(w) + " (`scrml fix` rewrites a body that writes no reactive cell; §6.7.4, §63)")
        }
        if (w.deps.length == 0 && !w.keyword) {
            st = addDiag(st, env.file, w.span, "E-EFFECT-NO-DEPS", "this `<effect>` lists no dependency — an effect does not run on mount, so with no `deps=[…]` it never runs (§6.7.4); list the cells whose changes should run it, and put logic that runs once in `on mount { }` or a bare expression")
        }
        for (const d of w.deps) { st = resolveEffectDep(env, d, st) }
        if (w.body.stmts.length == 0) {
            st = addDiag(st, env.file, w.span, "W-LIFECYCLE-010", "this effect has an empty body — its trigger fires and does nothing (§6.7.4); add a body or remove it")
        }
        st = resolveBlock(effectBodyEnv(env), w.body, st)
        st = loopChecks(env.file, w.body, st)            // s469: an effect body is a loop-control boundary
        return addEffectSrc(st, w, env.file)
    }

    // `<effect deps=[@a, @b]>` — the canonical spelling of an effect, for a message.
    fn effectSpelling(w: AEffect) -> string {
        let names: string[] = []
        for (const d of w.deps) {
            const n: string = atName(d)
            if (n != "") names = names.concat(["@" + n])
        }
        return "`<effect deps=[" + names.join(", ") + "]>" + interpOpen() + " … }</>`"
    }

    // `$` + `{` — never written whole in a string literal here (it would open
    // an interpolation, progress.md F9).
    fn interpOpen() -> string { return "$" + "{" }

    fn resolveEffectDep(env: Env, d: AExpr, st: AS) -> AS {
        const name: string = atName(d)
        // fix round (LOW b): a field path (`@signup.email`) is ⚑ OPEN in §6.7.4 — refused, not decided
        if (name == "" && memberName(d.k) != "" && isReactiveRoot(placeRoot(d))) {
            return addDiag(st, env.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "a field path as an effect dependency is not in the bootstrap — whether a §66 field path (`@signup.email`) may be a dep entry is OPEN (§6.7.4); list a cell `@name`")
        }
        if (name == "") return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "an effect dependency is a cell written `@name` (§6.7.4) — this entry is not one")
        const r: RX = resolveExpr(env, d, not, st)
        if (r.st.diags.length > st.diags.length) {
            return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "`@" + name + "` in an effect's dependency list is not a declared `@variable` in scope (§6.7.4)")
        }
        const f: NameFact | not = nameFactIn(r.st, d.nid)
        if (f is not) return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "`@" + name + "` in an effect's dependency list is not a declared `@variable` in scope (§6.7.4)")
        return depOfFact(env, d, name, f, r.st)
    }

    // F17: arms return through a function, never an object literal.
    fn depOfFact(env: Env, d: AExpr, name: string, f: NameFact, st: AS) -> AS {
        return match f {
            .NField(decl: ds, inst: i, idx: idx) :> depField(env, d, name, ds, idx, st)
            .NInst(decl: ds) :> addDiag(st, env.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`@" + name + "` names a whole instance — an effect dependency naming one is not in the bootstrap (whether a declaration's value is a \"declared mutable reactive cell\", §6.7.4, is not settled); list its fields' cells")
            .NLocal(sym: s) :> notMutableDep(env, d, name, st)
            .NStruct(owner: o) :> notMutableDep(env, d, name, st)
            .NFn(sym: s) :> notMutableDep(env, d, name, st)
            .NLength :> notMutableDep(env, d, name, st)
            .NSurface(of: x) :> notMutableDep(env, d, name, st)
            .NConst(sym: s) :> notMutableDep(env, d, name, st)
        }
    }

    fn notMutableDep(env: Env, d: AExpr, name: string, st: AS) -> AS {
        return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "`@" + name + "` in an effect's dependency list is not a declared mutable `@variable` (§6.7.4)")
    }

    fn depField(env: Env, d: AExpr, name: string, ds: Sym, idx: int, st: AS) -> AS {
        const di: DeclInfo | not = declInfoIn(env.g, ds)
        if (di is not || idx < 0 || idx >= di.fields.length) return st
        const fi: FieldInfo = di.fields[idx]
        const w: Sym | not = fi.wcap
        if (w is given) return st
        const m: FieldMode = fi.mode
        const why: string = match m {
            .Derived :> "a DERIVED cell (its initializer reads cells) — it has no change event of its own; list the `@variables` it is computed from and read `@" + name + "` in the body (§6.7.4)"
            .Locked :> "a LOCKED field (no `let`) — it never changes; declare it `let` to make it a mutable cell"
            .Let :> "not writable"
            .Seeded :> "not writable"
        }
        return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "`@" + name + "` in an effect's dependency list is " + why)
    }

    fn declInfoIn(g: Globals, s: Sym) -> DeclInfo | not {
        const ds: DeclSrc | not = findDeclSrc(g, s)
        if (ds is not) return not
        return ds.info
    }

    // F17: a match arm whose body is an object literal loses its named payload
    // bindings — arms return through this constructor instead.
    fn keepEnv(env: Env, st: AS) -> RB { return { env: env, st: st } }

    fn resolveMaybeExpr(env: Env, e: AExpr | not, st: AS) -> AS {
        if (e is not) return st
        // s469 (#1471 r3): in a VOID function, `return f()` passes `void` on (not a value use);
        // anywhere else a `return` operand is a value position
        let renv: Env = withWholeAt(env, e.nid, "a `return` operand")
        if (env.fx.fnSym >= 0 && isVoidFn(env.g, env.fx.fnSym)) renv = withStmtCall(renv, e.nid)
        return resolveExpr(renv, e, not, st).st
    }

    // `let a[: T] = init`. An annotation is the local's type (and the
    // initializer's expected type); it is recorded in `Tables.annots`.
    // s473: `return _={ … }=` is a foreign block's bound form (§23.2.4)
    fn resolveReturnExpr(env: Env, e: AExpr | not, st: AS) -> AS {
        if (e is given) {
            const f: AForeign | not = foreignOf(e)
            if (f is given) return resolveForeignAt(env, e, f, false, st).st
        }
        return resolveMaybeExpr(env, e, st)
    }


    // s473 (ruled refusals) — §7.6 (S473 D14): "a LOCAL — a `let` / `const` /
    // `lin` declared inside a function body (at any nesting depth) — with the
    // name of a reactive cell in scope is `E-NAME-COLLIDES-STATE` (§6.1.3),
    // exactly as at file scope. (Parameters and nested `function` declarations
    // are not decided by this ruling.)" The cells in scope of a function body:
    // its file's program cells (programInfo — §7.6.1 "in the same file").
    fn localCellClash(env: Env, span: ASpan, name: string, st: AS) -> AS {
        if (!isFnCtx(env)) return st
        const pi: DeclInfo | not = programInfo(env)
        if (pi is not) return st
        for (const f of pi.fields) {
            if (f.sym.hint == name) return addDiag(st, env.file, span, "E-NAME-COLLIDES-STATE", "the local `" + name + "` takes the name of the cell `@" + name + "` — a local declared in a function body cannot take the name of a cell in scope (§7.6, §6.1.3; ruled S473 D14: function scoping does not license it). Rename the local")
        }
        return st
    }

    fn isFnCtx(env: Env) -> boolean {
        const c: CtxK = env.ctx
        return match c {
            .InDecl(owner: o) :> false
            .InFn :> true
        }
    }

    fn resolveLocal(env: Env, s: AStmt, name: string, mutable: boolean, aty: AType | not, init: AExpr, st0: AS) -> RB {
        let st: AS = localCellClash(env, s.span, name, st0)
        let annot: Type | not = not
        if (aty is given && !hasErrIn(fileErrs(env.g.files, env.file), aty.span)) {
            const te: TypeEnv = teAt(env.g.te, env.file)
            const rt: RType = resolveType(te, aty, st)
            // r8: an annotation that did not resolve is not the local's type
            if (!rt.unresolved) annot = rt.t
            st = rt.st
        }
        // s473 N1 (#1663 re-review): an attribute node bound to a local leaves the
        // chain the sink judgment reads (fail closed)
        if (!env.fx.serverOwn && sinkYieldsAttr(init)) st = addDiag(st, env.file, s.span, "E-LOGIC-EXECUTABLE-SINK", sinkMessage(sinkAttrBindWhy("the local `" + name + "`")))
        let ri: RX = plain(not, st)
        const fi: AForeign | not = foreignOf(init)
        if (fi is given) {
            ri = resolveForeignAt(env, init, fi, false, st)      // s473: `const x = _={ … }=` (§23.2.4)
        } else {
            ri = resolveExpr(withWholeAt(env, init.nid, "the initializer of `" + name + "`"), init, annot, st)
        }
        const rs: RSym = mint(reservedName(ri.st, env.file, s.span, name), name)
        st = addBind(rs.st, s.nid, BindFact.BBind(rs.s))
        let lty: Type | not = ri.x.ty
        if (annot is given) {
            lty = annot
            st = addAnnot(st, rs.s, annot)
        }
        const l: LocalB = { name: name, s: rs.s, ty: lty, mutable: mutable, narrowed: not, nDecl: not, fresh: !mutable && sinkFreshInit(init) }
        return { env: withLocal(env, l), st: st }
    }

    fn resolveIf(env: Env, c: AExpr, t: ABlock, el: ABlock | not, st0: AS) -> AS {
        let st: AS = resolveCond(env, c, st0)
        st = resolveBlock(withPresent(env, presenceHandle(env, c)), t, st)
        if (el is given) st = resolveBlock(env, el, st)
        return st
    }

    // L11: `given c = @handle :> { … }` binds the INSTANCE (§66.7.5, O56 narrow).
    fn resolveGiven(env: Env, s: AStmt, name: string, subject: AExpr, body: ABlock, st0: AS) -> AS {
        const rs0: RX = resolveHandleSubject(env, subject, st0)
        let st: AS = rs0.st
        const inst: InstRef | not = rs0.x.inst
        const iDecl: Sym | not = rs0.x.iDecl
        if (inst is not || iDecl is not) {
            return addDiag(st, env.file, s.span, "E-BOOTSTRAP-UNSUPPORTED", "`given` over a value that is not an instance handle is not in bootstrap slice M2 (O56: writes through it would be errors)")
        }
        const rs: RSym = mint(reservedName(st, env.file, s.span, name), name)
        st = addBind(rs.st, s.nid, BindFact.BGiven(rs.s, inst))
        const narrowed: InstRef = InstRef.Narrowed(rs.s)
        const l: LocalB = { name: name, s: rs.s, ty: rs0.x.ty, mutable: false, narrowed: narrowed, nDecl: iDecl, fresh: false }
        let inner: Env = withLocal(env, l)
        // the subject handle itself is narrowed inside the block too (§66.7.5)
        const hn: string = atName(subject)
        if (hn != "") inner = withNarrow(inner, { name: hn, ty: rs0.x.ty, inst: narrowed, iDecl: iDecl })
        return resolveBlock(inner, body, st)
    }

    // =========================================================================
    // s469 — THE ONE LOOP (SPEC §49 "one `for`").
    //
    // THE BINDER (resolveFor). A loop binds its label Sym (BLoop on the AFor —
    // every Break / Continue names its loop by it), its head, and its body with
    // the binder in scope. A loop widens nothing (§49.3.5: "Every write in a loop
    // body — to the iterated tape, to an outer local, to a cell — is checked
    // against the target's grants exactly as anywhere else (§66.12.6)"): the
    // body is resolved by resolveBlock, the one statement path, so every write
    // in it is classified — and refused or granted — exactly where it would be
    // outside a loop. The heads:
    //   for { … } / for (;;)   nothing to resolve
    //   for (cond)              a condition (§49.2.3: the `if` rule — resolveCond,
    //                           the typer's checkCond)
    //   for (init; cond; step)  `init` once: `let` declarators (in scope for the
    //                           head and the body) or assignments of outer locals;
    //                           `step` assignments of locals ("A counted head's
    //                           counters are local bindings rebound by `step` …
    //                           They are not tape writes and need no grant",
    //                           §49.3.2). A cell write, an edit, a call or a
    //                           handled failable there is not in the bootstrap:
    //                           refused (the body is where effects go).
    //   for (x of xs)           the iterable once; `x` per element — a tape's
    //                           element type, a string's code point (a string);
    //                           `let x` is a mutable binder (§49.3.5)
    //   for (i of a..b)         both bounds `int` (the typer: E-RANGE-BOUND-NOT-INT);
    //   for (i of a..=b)        `i` an int. `end` (the once-evaluated upper bound,
    //                           §49.2.5) and, for a `let` binder, the loop's own
    //                           `counter` are minted HERE — lower names them,
    //                           never mints (core.scrml, the binder's obligation).
    // =========================================================================
    fn resolveFor(env: Env, s: AStmt, f: AFor, st0: AS) -> AS {
        let hint: string = f.label
        if (hint == "") hint = "loop"
        const rl: RSym = mint(st0, hint)
        const plain0: AS = addBind(rl.st, f.nid, BindFact.BLoop(rl.s, not, not, not))
        const h: AForHead = f.head
        return match h {
            .HForever :> resolveBlock(env, f.body, plain0)
            .HCond(cond: c) :> resolveBlock(env, f.body, resolveCond(env, c, plain0))
            .HCounted(init: i, cond: c, step: sp) :> resolveCounted(env, f, i, c, sp, plain0)
            .HIter(bind: b, mutable: m, src: src, key: ky) :> resolveIter(env, f, rl.s, b, m, src, ky, rl.st)
        }
    }

    // =========================================================================
    // s469 — THE VALUE FORM (SPEC §49.6): a loop bound as a value, from any
    // head. `const xs = for (…) { … lift e; … };` binds `xs` — in scope AFTER
    // the loop, never in its own body — to a FRESH tape with no grants (rule 2:
    // immutable, `fixedSeq`), of the values its `lift`s appended in the order
    // they ran (rule 3); zero lifts at run time give `[]` (rule 4). The binder's
    // Sym is minted before the body, so every `lift` the body holds names it
    // (resolveLift: BJump on the statement — lower's Lift target). Its type
    // here is the join of the lifts' (rule 2); the typer decides it for good
    // (typeForStmt). A loop bound as a value whose body holds no `lift` at all
    // is E-LOOP-007 (§49.4.4). `break` keeps the prefix (rule 5) and the body
    // is a break boundary (rule 6, E-LOOP-005) — the loop-control pass.
    // =========================================================================
    fn resolveForStmt(env: Env, s: AStmt, f: AFor, st00: AS) -> RB {
        const b: AForBound | not = f.bound
        const st0: AS = keyOffMarkup(env, f, st00)
        if (b is not) return keepEnv(env, resolveFor(env, s, f, st0))
        let st: AS = st0
        let annot: Type | not = not
        const aty: AType | not = b.ty
        if (aty is given && !hasErrIn(fileErrs(env.g.files, env.file), aty.span)) {
            const te: TypeEnv = teAt(env.g.te, env.file)
            const rt: RType = resolveType(te, aty, st)
            if (!rt.unresolved) annot = rt.t
            st = rt.st
        }
        const rs: RSym = mint(reservedName(st, env.file, b.span, b.name), b.name)
        st = addBind(rs.st, b.nid, BindFact.BBind(rs.s))
        if (annot is given) st = addAnnot(st, rs.s, annot)
        const n0: int = st.lifts.length
        st = resolveFor(withLift(env, LiftCtx.LiftTo(rs.s, false)), s, f, st)
        const lr: LiftsOf = liftsInto(st, n0, rs.s)
        if (lr.count == 0 || !liftReachable(f.body)) st = addDiag(st, env.file, f.span, "E-LOOP-007", "The loop bound to `" + b.name + "` lifts nothing on any path, so its value is always an empty tape. Add `lift <value>;` where the loop produces an element, or write the loop as a statement (§49.4.4, §49.6)")
        if (boundLoopExitless(f)) st = addDiag(st, env.file, f.span, "E-LOOP-008", "The loop bound to `" + b.name + "` never ends: its head never stops it, and no path in its body reaches a `break` that leaves it, a `return`, a `fail` or a `?` — so its value is never produced and this code never continues (a `break` inside an inner loop leaves only that loop). Add `if (<done>) { break; }` where the loop has lifted its last element, or give it a head that ends (`for (x of xs)`, `for (cond)`) (§49.6 rule 10)")
        if (boundLoopStranded(f)) st = addDiag(st, env.file, f.span, "E-LOOP-008", "The loop bound to `" + b.name + "` never finishes an iteration: every path through its body runs into an inner loop that never ends (`for { }`, `for (;;)`, `for (true)` with no `break` of its own), and no path reaches a `continue` of this loop, a `break` that leaves it, a `return`, a `fail` or a `?` — so its value is never produced and this code never continues. Give the inner loop a `break` (`if (<done>) { break; }`), or leave this loop from it (`break <label>`, `continue <label>`) (§49.6 rule 10, S473)")
        let lty: Type | not = lr.elem
        if (lty is given) lty = Type.Seq(lty, fixedSeq())
        if (annot is given) lty = annot
        const l: LocalB = { name: b.name, s: rs.s, ty: lty, mutable: b.mutable, narrowed: not, nDecl: not, fresh: false }
        return { env: withLocal(env, l), st: st }
    }

    // s474 — the header `key` (§17.4b) names the ROWS a markup loop renders,
    // for keyed reconciliation. The bootstrap builds it on a Tier-0
    // `${ for … }` in markup (resolveTier0 — not through here); on a statement
    // loop or a loop bound as a value (here, a nested loop inside a Tier-0 body
    // included) there are no rows of its own to reconcile, so the clause is
    // refused by name rather than evaluated and dropped (fail closed, D28).
    fn keyOffMarkup(env: Env, f: AFor, st: AS) -> AS {
        const ky: AExpr | not = forKey(f)
        if (ky is not) return st
        return addDiag(st, env.file, ky.span, "E-BOOTSTRAP-UNSUPPORTED", "a header `key` names the rows a `" + "$" + "{ for … }` in markup renders (keyed reconciliation, §17.4b); this loop is a statement or a loop bound as a value, which renders no rows of its own — the bootstrap builds the `key` only on the markup loop itself. Drop the `key` here, or move it to the `" + "$" + "{ for … }` that renders the rows")
    }

    fn forKey(f: AFor) -> AExpr | not {
        const h: AForHead = f.head
        return match h {
            .HIter(bind: b, key: ky) :> ky
            .HForever :> not
            .HCond(cond: c) :> not
            .HCounted(init: i) :> not
        }
    }

    // §49.4.4: "a `lift` reachable on some path" — a `lift` into THIS loop that
    // some path reaches: through `if` / `given` blocks and statement loops (a
    // nested bound loop captures its own, rule 7); a statement after one that
    // always leaves its block (`break`, `continue`, `return`, `fail`, an `if`
    // both of whose branches leave, a loop that never completes) is not reached.
    fn liftReachable(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtLiftReachable(s)) return true
            if (stmtEndsPath(s)) return false
        }
        return false
    }

    fn liftReachableMaybe(b: ABlock | not) -> boolean {
        if (b is not) return false
        return liftReachable(b)
    }

    fn stmtLiftReachable(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Lift(what: x) :> true
            .If(cond: c, thenB: tb, elseB: el) :> liftReachable(tb) || liftReachableMaybe(el)
            .Given(name: n, body: gb) :> liftReachable(gb)
            .For(f: lf) :> lf.bound is not && liftReachable(lf.body)
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .Return(e: x) :> false
            .EffectStmt(w: x) :> false
            .Defer(body: x) :> false
            .Fail(f: x) :> false
            .Break(label: x) :> false
            .Continue(label: x) :> false
        }
    }

    // Does every path through `s` leave its block (nothing after it runs)?
    fn stmtEndsPath(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Break(label: x) :> true
            .Continue(label: x) :> true
            .Return(e: x) :> true
            .Fail(f: x) :> true
            .If(cond: c, thenB: tb, elseB: el) :> blockEndsPath(tb) && blockEndsPathMaybe(el)
            .For(f: lf) :> loopNeverCompletes(lf)
            .Given(name: n) :> false
            .Eval(e: x) :> matchEndsPath(x)
            .Local(name: n) :> false
            .EffectStmt(w: x) :> false
            .Defer(body: x) :> false
            .Lift(what: x) :> false
        }
    }

    // s473 (review #1631 F1) — a statement `match` ends the path when every arm
    // is a block that ends it and the arms take every value. Exhaustiveness is
    // read from the arms, because the tables are not built yet: a wildcard arm;
    // or no literal arm and at least one variant arm (a variant match, whose
    // exhaustiveness is enforced, E-TYPE-020); or literal arms that include both `true` and
    // `false`. A literal match without a wildcard may fall through (W-MATCH-002),
    // so it does not end the path. A `!{}` guard never ends it, because its
    // subject may succeed.
    fn matchEndsPath(e: AExpr) -> boolean {
        const h: AHandled | not = handledOf(e.k)
        if (h is not) return false
        const arms: AArm[] | not = matchArmsOf(h.how)
        if (arms is not) return false
        if (arms.length == 0) return false
        for (const a of arms) {
            const body: AArmBody = a.body
            const ends: boolean = match body {
                .ArmBlock(b: b) :> blockEndsPath(b)
                .ArmExpr(e: x) :> false
            }
            if (!ends) return false
        }
        return armsExhaustive(arms)
    }

    // Reads the arm PATTERNS only. Re-check this when arm guards land: a
    // guarded arm does not take every value its pattern names.
    // No literal arm counts as exhaustive only with at least one VARIANT arm
    // (E-TYPE-020 enforces a variant match); a lone `not :>` arm over
    // `T | not` falls through for a value (W-MATCH-002) — review #1631 r1 R1-1.
    fn armsExhaustive(arms: AArm[]) -> boolean {
        let lits: int = 0
        let variants: int = 0
        let sawTrue: boolean = false
        let sawFalse: boolean = false
        for (const a of arms) {
            const p: APat = a.pat
            const wild: boolean = match p {
                .PWild :> true
                .PWhole(bind: b) :> true
                .PBare(bind: b) :> false
                .PName(name: n) :> false
                .PNot :> false
                .PLit(e: x) :> false
            }
            if (wild) return true
            const isVariant: boolean = match p {
                .PName(name: n) :> true
                .PWild :> false
                .PWhole(bind: b) :> false
                .PBare(bind: b) :> false
                .PNot :> false
                .PLit(e: x) :> false
            }
            if (isVariant) variants = variants + 1
            const lit: AExpr | not = match p {
                .PLit(e: x) :> x
                .PWild :> not
                .PWhole(bind: b) :> not
                .PBare(bind: b) :> not
                .PName(name: n) :> not
                .PNot :> not
            }
            if (lit is given) {
                lits = lits + 1
                if (exprIsTrueLit(lit)) sawTrue = true
                if (exprIsFalseLit(lit)) sawFalse = true
            }
        }
        if (lits == 0) return variants > 0
        return sawTrue && sawFalse
    }

    fn blockEndsPath(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtEndsPath(s)) return true
        }
        return false
    }

    fn blockEndsPathMaybe(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockEndsPath(b)
    }

    // The lifts resolved since `n0` into `into`: how many, and the join of
    // their types (`not` when one is not known, or two do not join).
    type LiftsOf:struct = { count: int, elem: Type | not }

    fn liftsInto(st: AS, n0: int, into: Sym) -> LiftsOf {
        let count: int = 0
        let elem: Type | not = not
        let known = true
        let i: int = n0
        while (i < st.lifts.length) {
            const l: LiftSeen = st.lifts[i]
            if (l.into == into.id) {
                count = count + 1
                const t: Type | not = l.ty
                if (t is not) {
                    known = false
                } else if (elem is not) {
                    elem = t
                } else {
                    const j: Type | not = knownOf(joinTypes(elem, t))
                    if (j is not) known = false
                    elem = j
                }
            }
            i = i + 1
        }
        if (!known) return { count: count, elem: not }
        return { count: count, elem: elem }
    }

    // `lift` (§49.6.2): the nearest enclosing bound loop's tape (BJump on the
    // statement). Refused where there is none (a `lift` outside a bound loop
    // or a Tier-0 loop is not in the bootstrap — §10 lift-to-render-target and
    // the `fn`-body `~` are not built) and inside an arm block (PA reading,
    // S469: §49.6 rule 7 sends it "through … `match` arms and `!{}` arms" to
    // the loop, §18.5 makes a value-position arm block's `lift` the arm's value
    // — the owner's to reconcile; fail closed). Lifted markup only in a Tier-0
    // loop. The operand is resolved either way (its own errors report).
    fn resolveLift(env: Env, s: AStmt, w: ALift, st0: AS) -> AS {
        const lc: LiftCtx = env.lift
        const tgt: Sym | not = match lc {
            .LiftTo(into: i, tier0: t) :> i
            .NoLift :> not
            .LiftInArm :> not
        }
        const tier0: boolean = match lc {
            .LiftTo(into: i, tier0: t) :> t
            .NoLift :> false
            .LiftInArm :> false
        }
        const inArm: boolean = match lc {
            .LiftInArm :> true
            .NoLift :> false
            .LiftTo(into: i) :> false
        }
        // the operand is resolved either way (its own errors report) — a lifted row
        // only where it is a row (a refused `lift` reads no markup)
        const legal: boolean = !inArm && tgt is given && (tier0 || !liftsMarkup(w))
        let r: RX = plain(not, st0)
        if (legal || !liftsMarkup(w)) r = resolveLifted(env, w, st0)
        let st: AS = r.st
        if (inArm) return addDiag(st, env.file, s.span, "E-BOOTSTRAP-UNSUPPORTED", "`lift` is in the bootstrap only as the LAST statement of a `match` / `!{}` arm block (§18.5: `.B :> { log(); lift 2 }`) — a `lift` inside an arm block appends to nothing here: inside a bound loop, §49.6 rule 7 would send it to the loop while §18.5 makes it the arm's value (an open reading) — lift after the `match` / `!{}` instead")
        // §10.4 / §49.6.2: "`lift` inside a loop body inside a bare `function` SHALL be a
        // compile error (E-SYNTAX-002) … unless the loop is bound" — a bare `function` body
        // has no lift target. (A `fn` body's `~`, §48.5, is not in the bootstrap.)
        if (tgt is not && inBareFunction(env)) return addDiag(st, env.file, s.span, "E-SYNTAX-002", "`lift` is not valid inside a bare `function` body (§10.4) — a `function` returns its value. Bind the loop as a value and return it (`const xs = for (…) { … lift e; … }; return xs;`, §49.6), or `return` the value and lift it at the call site")
        if (tgt is not) return addDiag(st, env.file, s.span, "E-BOOTSTRAP-UNSUPPORTED", "`lift` appends to a loop BOUND AS A VALUE (`const xs = for (…) { … lift e; … };`, §49.6) or to a Tier-0 `" + "$" + "{ for … }` in markup (§17.4) — this one stands in neither (lifting into a render target or a `fn` body's `~`, §10 / §48.5, is not in the bootstrap)")
        if (!tier0 && liftsMarkup(w)) return addDiag(st, env.file, s.span, "E-BOOTSTRAP-UNSUPPORTED", "lifted MARKUP is a row of a Tier-0 `" + "$" + "{ for … }` in markup (§17.4) — the nearest bound loop here is `" + tgt.hint + "`, which builds a tape of values")
        st = addBind(st, s.nid, BindFact.BJump(tgt))
        return addLift(st, tgt, r.x.ty)
    }

    // A bare `function` declaration's body (not a `fn`, not a handler / effect / markup).
    fn inBareFunction(env: Env) -> boolean {
        if (!env.fx.inFn || env.inEffect) return false
        const h: HostCtx = env.host
        return match h {
            .HostPure :> false
            .HostOk :> true
            .HostNo :> true
        }
    }

    fn resolveLifted(env: Env, w: ALift, st: AS) -> RX {
        return match w {
            .LiftExpr(e: e) :> resolveExpr(withWholeAt(env, e.nid, "a `lift` operand"), e, not, st)
            .LiftNode(n: n) :> plain(not, resolveRow(env, n, st))
        }
    }

    // A Tier-0 row: markup, resolved where the `lift` stands (the loop's
    // locals in scope). An unfilled stand-in (parse's fillRows found no row at
    // its offset) is a defect, refused.
    fn resolveRow(env: Env, n: ANode, st: AS) -> AS {
        if (n.nid < 0) return addDiag(st, env.file, n.span, "E-BOOTSTRAP-UNSUPPORTED", "internal: a lifted element was not read (a bootstrap defect — please report it)")
        return resolveNodes(withLift(env, LiftCtx.NoLift), [n], liftedKeyDiag(env, n, st))
    }

    // s473 (ruled refusals) — §6.5.3 / §17.4b (S473 review-surfaced 5): "`key=`
    // on the lifted element (§6.5.3) is the LEGACY spelling: an implementation
    // that speaks the ruled dialect (the bootstrap) refuses it with a hint naming
    // the header form". The ruling's scope is the LIFTED element (#1690 review
    // F8): `key=` elsewhere is not judged here. It was written as a DOM
    // attribute (g-boot-lift-key-attr-silently-emitted-s473). s474: the header
    // form is built (keyed reconciliation) — the message names it as the fix.
    fn liftedKeyDiag(env: Env, n: ANode, st: AS) -> AS {
        const k: ANodeK = n.k
        const el: AElem | not = match k {
            .Elem(e: x) :> x
            .Text(text: t) :> not
            .Interp(e: x) :> not
            .DeclNode(d: d) :> not
            .Effect(w: w) :> not
            .Css(c: c) :> not
            .Gather(f: f) :> not
        }
        if (el is not) return st
        for (const a of el.attrs) {
            if (a.name.toLowerCase() == "key") {
                return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`key=` on the lifted `<" + el.tag + ">` is the legacy keyed-iteration spelling (§6.5.3), refused (ruled S473: the loop-header `key` is canonical, §17.4b). Move it into the loop head — `for (const it of @items key it.id)` — and drop the `key=`")
            }
        }
        return st
    }

    fn liftsMarkup(w: ALift) -> boolean {
        return match w {
            .LiftNode(n: x) :> true
            .LiftExpr(e: x) :> false
        }
    }

    // s469 — the Tier-0 loop (§17.4, §49.6.2): the value form whose lifts are
    // the rows the interpolation renders. Its accumulator is minted on the node
    // (lower's View.Gather bind); the loop is a loop-control root of its own
    // (§49.4) and must lift (E-LOOP-007, §49.4.4: "the same value form"). A
    // `return` / `fail` in it has no function to leave — the SPEC gives the
    // position no code: refused by name (PA reading, fail closed).
    fn resolveTier0(env: Env, n: ANode, f: AFor, st0: AS) -> AS {
        const rs: RSym = mint(st0, "rows")
        let st: AS = addBind(rs.st, n.nid, BindFact.BBind(rs.s))
        const fs: AStmt = forAsStmt(f)
        const n0: int = st.lifts.length
        st = resolveFor(withLift(env, LiftCtx.LiftTo(rs.s, true)), fs, f, st)
        if (liftsInto(st, n0, rs.s).count == 0 || !liftReachable(f.body)) st = addDiag(st, env.file, f.span, "E-LOOP-007", "This `" + "$" + "{ for … }` loop lifts nothing, so it always renders nothing. Add `lift <li>…</li>;` (or `lift <value>;`) where the loop produces a row, or compute the loop in a function (§17.4, §49.4.4)")
        if (boundLoopExitless(f)) st = addDiag(st, env.file, f.span, "E-LOOP-008", "This `" + "$" + "{ for … }` loop never ends: its head never stops it, and no path in its body reaches a `break` that leaves it — so the page never finishes rendering (a `break` inside an inner loop leaves only that loop). Add `if (<done>) { break; }` after the last row, or give it a head that ends (`for (x of xs)`, `for (cond)`) (§49.6 rule 10, §17.4)")
        if (boundLoopStranded(f)) st = addDiag(st, env.file, f.span, "E-LOOP-008", "This `" + "$" + "{ for … }` loop never finishes a row: every path through its body runs into an inner loop that never ends (`for { }`, `for (;;)`, `for (true)` with no `break` of its own), and no path reaches a `continue` of this loop or a `break` that leaves it — so the page never finishes rendering. Give the inner loop a `break` (`if (<done>) { break; }`), or leave this loop from it (`break <label>`, `continue <label>`) (§49.6 rule 10, §17.4, S473)")
        for (const rsite of returnSites(f.body)) {
            st = addDiag(st, env.file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "a `return` inside a `" + "$" + "{ for … }` in markup has no function to leave (§49.6 rule 6 names a function's exits; a render position has none) — compute the loop in a function and render its result")
        }
        for (const fsp of failSpansIn(f.body)) {
            st = addDiag(st, env.file, fsp, "E-BOOTSTRAP-UNSUPPORTED", "a `fail` inside a `" + "$" + "{ for … }` in markup has no function to leave (§49.6 rule 6) — compute the loop in a function and render its result")
        }
        // s474 (#1700 review F2): in a KEYED loop a row is named by (key, its
        // template, its place among the iteration's lifts of that template). An
        // inner loop that lifts markup rows gives those rows only positions inside
        // the item, so a row's DOM state would follow the position, not its inner
        // item (the outer key keeps them, the inner list shifts under them). The
        // nested identity is not built — refused by name.
        if (forKey(f) is given) {
            for (const nsp of nestedRowLoops(f.body)) {
                st = addDiag(st, env.file, nsp, "E-BOOTSTRAP-UNSUPPORTED", "this loop lifts markup rows inside a KEYED `" + "$" + "{ for (… key …) }`: the bootstrap names a keyed row by its outer key and its place, so the inner rows would be matched by position and a row's DOM state (typed text) could move to another inner item. A nested keyed list is not in the bootstrap yet — drop the outer `key` (the rows rebuild), or lift the inner rows from their own `" + "$" + "{ for … }` (§17.4b)")
            }
        }
        return loopChecks(env.file, { nid: -1, span: f.span, stmts: [fs] }, st)
    }

    // s474 — the statement loops under `b` (any depth; a bound loop captures
    // its own lifts) whose bodies lift markup rows.
    fn nestedRowLoops(b: ABlock) -> ASpan[] {
        let out: ASpan[] = []
        for (const s of b.stmts) {
            const lf: AFor | not = stmtFor(s)
            if (lf is given && lf.bound is not && gatherRows(lf).length > 0) {
                out = out.concat([lf.span])
            } else {
                for (const nb of nestedBlocks(s)) { out = out.concat(nestedRowLoops(nb)) }
            }
        }
        return out
    }

    fn stmtFor(s: AStmt) -> AFor | not {
        const k: AStmtK = s.k
        return match k {
            .For(f: lf) :> lf
            .Eval(e: x) :> not
            .Local(name: n) :> not
            .Return(e: x) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: b) :> not
            .Fail(f: x) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: x) :> not
        }
    }

    fn forAsStmt(f: AFor) -> AStmt {
        return { nid: f.nid, span: f.span, k: AStmtK.For(f) }
    }

    // The `fail` statements under `b` (statement structure; arm blocks
    // included — an arm's `fail` leaves the function too).
    fn failSpansIn(b: ABlock) -> ASpan[] {
        let out: ASpan[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const own: ASpan[] = match k {
                .Fail(f: x) :> [s.span]
                .Eval(e: x) :> []
                .Local(name: x) :> []
                .Return(e: x) :> []
                .If(cond: x) :> []
                .Given(name: x) :> []
                .EffectStmt(w: x) :> []
                .Defer(body: x) :> []
                .For(f: x) :> []
                .Break(label: x) :> []
                .Continue(label: x) :> []
                .Lift(what: x) :> []
            }
            out = out.concat(own)
            for (const nb of nestedBlocks(s)) { out = out.concat(failSpansIn(nb)) }
        }
        return out
    }

    fn resolveCounted(env0: Env, f: AFor, init: AStmt[], cond: AExpr | not, step: AExpr[], st0: AS) -> AS {
        let env: Env = env0
        let st: AS = st0
        for (const s of init) {
            const r: RB = resolveForInit(env, s, st)
            env = r.env
            st = r.st
        }
        if (cond is given) st = resolveCond(env, cond, st)
        st = resolveBlock(env, f.body, st)
        for (const x of step) { st = resolveForStep(env, x, "step", st) }
        return st
    }

    // An `init` clause: a `let` declarator (a Local) or an assignment (an Eval).
    fn resolveForInit(env: Env, s: AStmt, st: AS) -> RB {
        const k: AStmtK = s.k
        return match k {
            .Local(name: n, mutable: m, ty: y, init: i) :> resolveForLocal(env, s, n, m, y, i, st)
            .Eval(e: x) :> keepEnv(env, resolveForStep(env, x, "init", st))
            .Return(e: x) :> keepEnv(env, st)
            .If(cond: c) :> keepEnv(env, st)
            .Given(name: n) :> keepEnv(env, st)
            .EffectStmt(w: w) :> keepEnv(env, st)
            .Defer(body: d) :> keepEnv(env, st)
            .Fail(f: x) :> keepEnv(env, st)
            .For(f: x) :> keepEnv(env, st)
            .Break(label: x) :> keepEnv(env, st)
            .Continue(label: x) :> keepEnv(env, st)
            .Lift(what: x) :> keepEnv(env, st)
        }
    }

    // `let i = 0` in a counted head — resolveLocal's rule, except that the
    // initializer is NOT a statement's whole value: a handling form there would
    // lower to an Attempt before the loop's `init`, which Core's Counted head
    // cannot hold (check.scrml C19), so it is refused where it stands (ue2).
    // A parameter name as the author writes one (a letter or `_`, then letters,
    // digits, `_`) — anything else is the parser's recovery from a form it does
    // not read (a default value, a rest parameter), not a missing type.
    fn plainParamName(n: string) -> boolean {
        if (n == "") return false
        let i: int = 0
        while (i < n.length) {
            const c: string = n.substring(i, i + 1)
            const letter: boolean = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
            const digit: boolean = c >= "0" && c <= "9"
            if (!letter && !(digit && i > 0)) return false
            i = i + 1
        }
        return true
    }

    fn resolveForLocal(env: Env, s: AStmt, name: string, mutable: boolean, aty: AType | not, init: AExpr, st0: AS) -> RB {
        let st: AS = localCellClash(env, s.span, name, st0)
        let annot: Type | not = not
        if (aty is given && !hasErrIn(fileErrs(env.g.files, env.file), aty.span)) {
            const te: TypeEnv = teAt(env.g.te, env.file)
            const rt: RType = resolveType(te, aty, st)
            if (!rt.unresolved) annot = rt.t
            st = rt.st
        }
        const ri: RX = resolveExpr(env, init, annot, st)
        const rs: RSym = mint(reservedName(ri.st, env.file, s.span, name), name)
        st = addBind(rs.st, s.nid, BindFact.BBind(rs.s))
        let lty: Type | not = ri.x.ty
        if (annot is given) {
            lty = annot
            st = addAnnot(st, rs.s, annot)
        }
        const l: LocalB = { name: name, s: rs.s, ty: lty, mutable: mutable, narrowed: not, nDecl: not, fresh: false }
        return { env: withLocal(env, l), st: st }
    }

    // An `init` assignment / a `step`: a local rebinding (EAssignLocal), and
    // nothing else (above).
    fn resolveForStep(env: Env, x: AExpr, what: string, st0: AS) -> AS {
        const v: AExpr | not = assignValue(x)
        if (v is given) {
            if (handledOf(v.k) is given) return addDiag(resolveExpr(env, v, not, st0), env.file, x.span, "E-BOOTSTRAP-UNSUPPORTED", "a handled failable in a counted head's `" + what + "` is not in the bootstrap yet — handle it in the loop body")
        }
        const st: AS = resolveStmtExpr(env, x, st0)
        if (st.diags.length > st0.diags.length) return st
        if (isLocalRebind(effectFactIn(st, x.nid))) return st
        return addDiag(st, env.file, x.span, "E-BOOTSTRAP-UNSUPPORTED", "a counted head's `" + what + "` rebinds its counters (`i = i + 1`, §49.3.2) — a cell write, an edit or a call there is not in the bootstrap yet; move it into the loop body")
    }

    fn effectFactIn(st: AS, nid: int) -> EffectFact | not {
        const i: int = st.facts.effects.nids.indexOf(nid)
        if (i < 0) return not
        return st.facts.effects.facts[i]
    }

    fn isLocalRebind(f: EffectFact | not) -> boolean {
        return match f {
            .EAssignLocal(sym: s, path: pa) :> pa.length == 0      // s472: a part write rebinds no counter
            .EWrite(w: w) :> false
            .ESpread(ws: ws) :> false
            .EReset(w: w) :> false
            .EEdits(w: w) :> false
            .ERemove(w: w) :> false
            .EElemAt(cap: c) :> false
            .EPosition(cap: c) :> false
            not :> false
        }
    }

    fn resolveIter(env: Env, f: AFor, label: Sym, b: ABind, mutable: boolean, src: AIterSrc, key: AExpr | not, st0: AS) -> AS {
        const rx: RX = resolveIterSrc(env, src, st0)
        let st: AS = rx.st
        let end: Sym | not = not
        let counter: Sym | not = not
        if (isRangeSrc(src)) {
            const re: RSym = mint(st, "end")
            st = re.st
            end = re.s
            if (mutable) {
                const rc: RSym = mint(st, b.name)
                st = rc.st
                counter = rc.s
            }
        }
        st = localCellClash(env, b.span, b.name, st)     // #1690 review F12: a for-of binder is a function-body const/let (§7.6, D14)
        const rb: RSym = mint(reservedName(st, env.file, b.span, b.name), b.name)
        st = addBind(rb.st, b.nid, BindFact.BBind(rb.s))
        const l: LocalB = { name: b.name, s: rb.s, ty: rx.x.ty, mutable: mutable, narrowed: not, nDecl: not, fresh: false }
        const benv: Env = withLocal(env, l)
        // s474 — the header `key` (§17.4b): read in the body's scope (it reads
        // the binder), once per iteration — into a local minted HERE (lower
        // names it; the printer keys the iteration's rows by it)
        let keySym: Sym | not = not
        if (key is given) {
            st = resolveExpr(benv, key, not, st).st
            const rk: RSym = mint(st, "key")
            st = rk.st
            keySym = rk.s
        }
        st = addBind(st, f.nid, BindFact.BLoop(label, end, counter, keySym))
        return resolveBlock(benv, f.body, st)
    }

    // The iterable, resolved; its type is the BINDER's: a tape's element, a
    // string's code point (a string), a range's int. (Whether it is iterable at
    // all is the typer's — iterElemOf — on the settled type.)
    fn resolveIterSrc(env: Env, src: AIterSrc, st: AS) -> RX {
        // s473 N1 (#1663 re-review): `for (const at of el.attributes)` binds each
        // attribute node to the loop variable (fail closed)
        const ia: AExpr | not = iterOfExpr(src)
        if (ia is given && !env.fx.serverOwn && sinkYieldsAttr(ia)) return diagX(env, ia, "E-LOGIC-EXECUTABLE-SINK", sinkMessage(sinkAttrBindWhy("a loop variable")), st)
        return match src {
            .IterOf(e: x) :> iterElemType(resolveExpr(env, x, not, st))
            .IterRange(lo: lo, hi: hi) :> plain(Type.Int, resolveExpr(env, hi, Type.Int, resolveExpr(env, lo, Type.Int, st).st).st)
        }
    }

    fn iterOfExpr(src: AIterSrc) -> AExpr | not {
        return match src {
            .IterOf(e: x) :> x
            .IterRange(lo: lo) :> not
        }
    }

    fn iterElemType(r: RX) -> RX {
        const t: Type | not = r.x.ty
        if (t is not || r.x.inst is given) return plain(not, r.st)
        const el: Type | not = seqElem(t)
        if (el is given) return plain(el, r.st)
        if (t == Type.Str) return plain(Type.Str, r.st)
        return plain(not, r.st)
    }

    fn isRangeSrc(src: AIterSrc) -> boolean {
        return match src {
            .IterRange(lo: lo) :> true
            .IterOf(e: x) :> false
        }
    }

    // ---- s469 — a loop's parts, for every walk over statements ---------------
    // The counted head's `init` statements (none for the other heads).
    fn forInit(f: AFor) -> AStmt[] {
        const h: AForHead = f.head
        return match h {
            .HCounted(init: i) :> i
            .HForever :> []
            .HCond(cond: c) :> []
            .HIter(bind: b) :> []
        }
    }

    fn forInitBlock(f: AFor) -> ABlock {
        return { nid: -1, span: f.span, stmts: forInit(f) }
    }

    // The head's own expressions (not `init`'s): the condition, the steps, the
    // iterable or the range's bounds.
    fn forHeadExprs(f: AFor) -> AExpr[] {
        const h: AForHead = f.head
        return match h {
            .HForever :> []
            .HCond(cond: c) :> [c]
            .HCounted(init: i, cond: c, step: sp) :> maybeExprList(c).concat(sp)
            .HIter(bind: b, src: src, key: ky) :> iterSrcExprs(src).concat(maybeExprList(ky))   // s474: the header `key` (§17.4b)
        }
    }

    fn iterSrcExprs(src: AIterSrc) -> AExpr[] {
        return match src {
            .IterOf(e: x) :> [x]
            .IterRange(lo: lo, hi: hi) :> [lo, hi]
        }
    }

    // s469 — a `lift`'s value operand (none for a lifted row), the arm blocks
    // inside it, and a Tier-0 loop's rows (every lifted element of its body, in
    // source order — where parse's fillRows placed them).
    fn liftExprs(w: ALift) -> AExpr[] {
        return match w {
            .LiftExpr(e: e) :> [e]
            .LiftNode(n: x) :> []
        }
    }

    fn liftBlocks(w: ALift) -> ABlock[] {
        let out: ABlock[] = []
        for (const e of liftExprs(w)) { out = out.concat(allExprBlocks(e)) }
        return out
    }

    fn gatherRows(f: AFor) -> ANode[] {
        return rowsOfBlock(f.body)
    }

    fn rowsOfBlock(b: ABlock) -> ANode[] {
        let out: ANode[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const own: ANode[] = match k {
                .Lift(what: w) :> liftRowOf(w)
                .If(cond: c, thenB: tb, elseB: el) :> rowsOfBlock(tb).concat(rowsOfMaybe(el))
                .Given(name: n, body: gb) :> rowsOfBlock(gb)
                .For(f: lf) :> rowsOfBlock(lf.body)
                .Defer(body: db) :> rowsOfBlock(db)
                .Eval(e: x) :> []
                .Local(name: n) :> []
                .Return(e: x) :> []
                .EffectStmt(w: x) :> []
                .Fail(f: x) :> []
                .Break(label: x) :> []
                .Continue(label: x) :> []
            }
            out = out.concat(own)
        }
        return out
    }

    fn rowsOfMaybe(b: ABlock | not) -> ANode[] {
        if (b is not) return []
        return rowsOfBlock(b)
    }

    fn liftRowOf(w: ALift) -> ANode[] {
        return match w {
            .LiftNode(n: n) :> [n]
            .LiftExpr(e: x) :> []
        }
    }

    // Every expression the head evaluates — `init`'s included.
    fn forExprs(f: AFor) -> AExpr[] {
        let out: AExpr[] = []
        for (const s of forInit(f)) { out = out.concat(stmtExprs(s)) }
        return out.concat(forHeadExprs(f))
    }

    fn forExprBlocks(f: AFor) -> ABlock[] {
        let out: ABlock[] = []
        for (const x of forExprs(f)) { out = out.concat(allExprBlocks(x)) }
        return out
    }

    // The blocks nested in a loop statement: `init` (its own block — a name it
    // binds is the loop's), the head's arm blocks, and the body (a nested block:
    // it may shadow a name the head binds, §7.3.3).
    fn forNestedBlocks(f: AFor) -> ABlock[] {
        let out: ABlock[] = [forInitBlock(f)]
        for (const x of forHeadExprs(f)) { out = out.concat(allExprBlocks(x)) }
        return out.concat([f.body])
    }

    // The names a loop binds for its head and body: the binder, the `init` locals.
    fn forBoundNames(f: AFor) -> string[] {
        let out: string[] = []
        const h: AForHead = f.head
        const b: ABind | not = match h {
            .HIter(bind: bb) :> bb
            .HForever :> not
            .HCond(cond: c) :> not
            .HCounted(init: i) :> not
        }
        if (b is given) out = [b.name]
        for (const s of forInit(f)) {
            const n: string = localNameOf(s)
            if (n != "") out = out.concat([n])
        }
        return out
    }

    // The binder as the return-inference walk's scope entry (retsIn): a range's
    // binder is an `int`; an element's type is not proven there.
    fn forBinderParam(f: AFor) -> ParamT[] {
        const h: AForHead = f.head
        return match h {
            .HIter(bind: b, src: src) :> [{ name: b.name, ty: rangeBinderType(src), param: false }]
            .HForever :> []
            .HCond(cond: c) :> []
            .HCounted(init: i) :> []
        }
    }

    fn rangeBinderType(src: AIterSrc) -> Type | not {
        if (isRangeSrc(src)) return Type.Int
        return not
    }

    fn retsFor(cx: InferCx, f: AFor, sc: ParamT[], stack: string[], done: OwnT[]) -> RRets {
        let out: RetAt[] = []
        let d: OwnT[] = done
        for (const x of forHeadExprs(f)) {
            const r: RRets = retsInExpr(cx, x, sc, stack, d)
            out = out.concat(r.rs)
            d = r.done
        }
        const scope: ABlock = { nid: -1, span: f.span, stmts: forInit(f).concat(f.body.stmts) }
        const rb: RRets = retsIn(cx, scope, sc.concat(forBinderParam(f)), stack, d)
        return { rs: out.concat(rb.rs), done: rb.done }
    }

    fn forNameRefs(f: AFor, bound: string[]) -> string[] {
        const inner: string[] = bound.concat(forBoundNames(f))
        return exprsNameRefs(forExprs(f), inner).concat(blockNameRefs(f.body, inner))
    }

    fn forHasBareReturn(f: AFor) -> boolean {
        for (const x of forExprs(f)) {
            if (exprHasBareReturn(x)) return true
        }
        return blockHasBareReturn(f.body)
    }

    fn forRetCalls(t: Tables, f: AFor) -> int[] {
        let out: int[] = []
        for (const x of forExprs(f)) { out = out.concat(retCallsExpr(t, x)) }
        return out.concat(retCallsBlock(t, f.body))
    }

    fn forReturnSites(f: AFor) -> ReturnSite[] {
        let out: ReturnSite[] = []
        for (const x of forExprs(f)) { out = out.concat(returnSitesIn(x)) }
        return out.concat(returnSites(f.body))
    }

    // Does the loop never complete normally — an infinite head (`for { … }`, or
    // a counted head with no condition) whose body holds no `break` that leaves
    // it? Then nothing after it runs: it ends every path through its block,
    // exactly as a `return` does (the fall-off and divergence rules).
    fn loopNeverCompletes(f: AFor) -> boolean {
        if (!headAlwaysTrue(f.head)) return false
        return !blockBreaksTo(f.body, f.label, true)
    }

    // One definition of a head that never ends the loop (review #1631 F2):
    // E-LOOP-008's `headNeverEnds` (`for { }`, no condition, a literal `true`).
    fn headAlwaysTrue(h: AForHead) -> boolean {
        return headNeverEnds(h)
    }

    // Does `b` hold a `break` that leaves the loop labelled `label` — an
    // unlabelled one not inside a nested loop (`direct`), or `break label`?
    fn blockBreaksTo(b: ABlock, label: string, direct: boolean) -> boolean {
        for (const s of b.stmts) {
            if (stmtBreaksTo(s, label, direct)) return true
        }
        return false
    }

    fn stmtBreaksTo(s: AStmt, label: string, direct: boolean) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Break(label: l) :> (l == "" && direct) || (l != "" && l == label)
            .Continue(label: l) :> false
            .Lift(what: x) :> false
            .For(f: lf) :> blockBreaksTo(lf.body, label, false)
            .Eval(e: x) :> blocksBreakTo(nestedBlocks(s), label, direct)
            .Local(name: n) :> blocksBreakTo(nestedBlocks(s), label, direct)
            .Return(e: x) :> blocksBreakTo(nestedBlocks(s), label, direct)
            .If(cond: c) :> blocksBreakTo(nestedBlocks(s), label, direct)
            .Given(name: n) :> blocksBreakTo(nestedBlocks(s), label, direct)
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> blockBreaksTo(d, label, direct)
            .Fail(f: x) :> false
        }
    }

    fn blocksBreakTo(bs: ABlock[], label: string, direct: boolean) -> boolean {
        for (const b of bs) {
            if (blockBreaksTo(b, label, direct)) return true
        }
        return false
    }

    // =========================================================================
    // s473 — AN EXIT-LESS BOUND LOOP (SPEC §49.6 rule 10, RULED S472 "five PA
    // recs" item 5: "An exit-less bound or Tier-0 loop is a compile error …
    // with no reachable `break`/`return`; a statement-position `for { }` stays
    // legal"). A loop bound as a value (a `for-binding`, a Tier-0 `${ for … }`)
    // whose head never ends it can produce its value only by leaving its body:
    // a `break` that leaves THIS loop, or a `return`, a `fail` or a `?` (the
    // ways out of an infinite head, §49.3.6). With none that a path reaches, its
    // value is never produced — a call never returns, a render never finishes:
    // E-LOOP-008.
    //
    // "Reachable", for the forever heads named below (a SYNTACTIC guard — a
    // non-literal always-true head such as `for (true && true)` is not read):
    //   - an unlabelled `break` inside an inner loop leaves that loop only; a
    //     `break label` counts only when the label is this loop's;
    //   - a statement after one that always leaves its block is not reached
    //     (stmtEndsPath, shared with E-LOOP-007: an `if` both of whose
    //     branches leave, a `match` that takes every value and every arm of
    //     which leaves (matchEndsPath, review #1631 F1), a loop whose head
    //     never ends it — the same headNeverEnds, review #1631 F2);
    //   - a `defer` body runs as its scope ends, so it is no way out;
    //   - an arrow function's body is another function (§49.4.3): a `?` in it
    //     leaves that function, not this loop;
    //   - a nested `fn` / `function` declaration has no source form in a body.
    // The bootstrap folds no constants: `if (false) { break; }` counts (the
    // condition is not read). A head that never ends is `for { }`, a counted
    // head with no condition, and a condition that is the literal `true` (read
    // as written — a literal, not a fold).
    // =========================================================================
    fn boundLoopExitless(f: AFor) -> boolean {
        if (!headNeverEnds(f.head)) return false
        return !blockWayOut(f.body, f.label, true, false)
    }

    // s473 — RULED S473 "owner questions round 2, PA recs" item 4: "The
    // exit-less loop rule (E-LOOP-008) widens to catch an inner forever loop."
    // A bound loop whose head DOES end it (`for (x of xs)`, `for (cond)`, a
    // counted head with a condition) still never produces its value when no
    // path through its body finishes an iteration: every path runs into a
    // statement that ends it (stmtEndsPath) and none reaches a `continue` of
    // this loop or a way out of it. Such a statement is either an inner loop
    // that never completes (loopNeverCompletes: a forever head no `break`
    // leaves) — the inner-forever strand (review #1631 F3: `for (y of ys) {
    // lift y; for { } }` hung) — or a labelled `break` / `continue` that
    // crosses this loop to a loop outside it, which is already E-LOOP-005
    // (or E-LOOP-003): a bound loop is a wall (§49.6 rule 6). With such a
    // crossing exit anywhere in the body this check stays quiet, so the
    // refused program gets that one error, not a second one naming an inner
    // loop that may not exist (review #1638 F2). A forever head is
    // boundLoopExitless's, so the two never both fire.
    fn boundLoopStranded(f: AFor) -> boolean {
        if (headNeverEnds(f.head)) return false
        if (!blockEndsPath(f.body)) return false
        if (blockCrossesOut(f.body, [f.label])) return false
        return !blockWayOut(f.body, f.label, true, true)
    }

    // Does `b` hold a labelled `break` / `continue` naming no loop in `owned`
    // (this loop and the loops inside it, at any depth)? Reachability is not
    // read: every such exit is an error of its own (E-LOOP-005 / -003), so
    // staying quiet here never lets a program compile.
    fn blockCrossesOut(b: ABlock, owned: string[]) -> boolean {
        for (const s of b.stmts) {
            if (stmtCrossesOut(s, owned)) return true
        }
        return false
    }

    fn stmtCrossesOut(s: AStmt, owned: string[]) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Break(label: l) :> l != "" && !labelOwned(l, owned)
            .Continue(label: l) :> l != "" && !labelOwned(l, owned)
            .For(f: lf) :> blockCrossesOut(lf.body, owned.concat([lf.label]))
            .Lift(what: w) :> blocksCrossOut(nestedBlocks(s), owned)
            .Eval(e: x) :> blocksCrossOut(nestedBlocks(s), owned)
            .Local(name: n) :> blocksCrossOut(nestedBlocks(s), owned)
            .Return(e: x) :> blocksCrossOut(nestedBlocks(s), owned)
            .If(cond: c) :> blocksCrossOut(nestedBlocks(s), owned)
            .Given(name: n) :> blocksCrossOut(nestedBlocks(s), owned)
            .Defer(body: d) :> blockCrossesOut(d, owned)
            .EffectStmt(w: w) :> false
            .Fail(f: x) :> false
        }
    }

    fn blocksCrossOut(bs: ABlock[], owned: string[]) -> boolean {
        for (const b of bs) {
            if (blockCrossesOut(b, owned)) return true
        }
        return false
    }

    fn labelOwned(l: string, owned: string[]) -> boolean {
        for (const o of owned) {
            if (o == l) return true
        }
        return false
    }

    fn headNeverEnds(h: AForHead) -> boolean {
        return match h {
            .HForever :> true
            .HCounted(init: i, cond: c) :> condNeverEnds(c)
            .HCond(cond: c) :> exprIsTrueLit(c)
            .HIter(bind: b) :> false
        }
    }

    fn condNeverEnds(c: AExpr | not) -> boolean {
        if (c is not) return true
        return exprIsTrueLit(c)
    }

    fn exprIsFalseLit(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Bool(v: v) :> !v
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: h) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    fn exprIsTrueLit(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Bool(v: v) :> v
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: h) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // Does a path through `b` reach a way out of the loop labelled `label`
    // (`direct`: `b` is that loop's own body, not an inner loop's)? With
    // `cont`, a `continue` of that loop counts too: it finishes the iteration
    // (boundLoopStranded — an ending head then gets to stop the loop).
    fn blockWayOut(b: ABlock, label: string, direct: boolean, cont: boolean) -> boolean {
        for (const s of b.stmts) {
            if (stmtWayOut(s, label, direct, cont)) return true
            if (stmtEndsPath(s)) return false
        }
        return false
    }

    fn blockWayOutMaybe(b: ABlock | not, label: string, direct: boolean, cont: boolean) -> boolean {
        if (b is not) return false
        return blockWayOut(b, label, direct, cont)
    }

    fn stmtWayOut(s: AStmt, label: string, direct: boolean, cont: boolean) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Break(label: l) :> (l == "" && direct) || (l != "" && l == label)
            .Continue(label: l) :> cont && ((l == "" && direct) || (l != "" && l == label))
            .Return(e: x) :> true
            .Fail(f: x) :> true
            .Eval(e: e) :> exprWayOut(e, label, direct, cont)
            .Local(name: n, init: i) :> exprWayOut(i, label, direct, cont)
            .Lift(what: w) :> exprsWayOut(liftExprs(w), label, direct, cont)
            .If(cond: c, thenB: t, elseB: el) :> exprWayOut(c, label, direct, cont) || blockWayOut(t, label, direct, cont) || blockWayOutMaybe(el, label, direct, cont)
            .Given(name: n, subject: x, body: gb) :> exprWayOut(x, label, direct, cont) || blockWayOut(gb, label, direct, cont)
            .For(f: lf) :> exprsWayOut(forExprs(lf), label, false, cont) || blockWayOut(lf.body, label, false, cont)
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false
        }
    }

    // A `?` reached in the expression (it leaves the function), or a way out
    // in one of its handling arms' blocks — never through an arrow function.
    fn exprWayOut(e: AExpr, label: string, direct: boolean, cont: boolean) -> boolean {
        if (lambdaBody(e) is given) return false
        const h: AHandled | not = handledOf(e.k)
        if (h is given) {
            if (howPropagates(h.how)) return true
            for (const b of exprBlocks(e)) {
                if (blockWayOut(b, label, direct, cont)) return true
            }
        }
        return exprsWayOut(exprKids(e), label, direct, cont)
    }

    fn exprsWayOut(es: AExpr[], label: string, direct: boolean, cont: boolean) -> boolean {
        for (const x of es) {
            if (exprWayOut(x, label, direct, cont)) return true
        }
        return false
    }

    fn howPropagates(how: AHow) -> boolean {
        return match how {
            .Propagate :> true
            .Guard(arms: a) :> false
            .MatchOn(arms: a) :> false
        }
    }

    // =========================================================================
    // s469 — THE LOOP-CONTROL PASS (§49.4; §49.10: "reported after AST
    // construction and scope resolution, in the loop control-flow validation
    // pass"). One walk per body ROOT — a function body, an event-handler
    // block, an effect body; each is a boundary (§49.4.3). The bootstrap has no
    // nested function declaration and no statement-bodied lambda, so nothing
    // here can cross one: E-LOOP-005 has no source form yet.
    //   E-LOOP-001 / -002   `break` / `continue` with no enclosing loop
    //   E-LOOP-003 / -004   `break l` / `continue l` naming no enclosing loop
    //                       ("any ancestor loop within the same function body",
    //                       §49.3.3 — a sibling loop's label is not one)
    //   E-LOOP-006          two loops of one body share a label (§49.2.2)
    // Each accepted `break` / `continue` gets its target (BJump: the loop's
    // label Sym), which lower turns into a Core Break / Continue.
    // Refused (not in the bootstrap — fail closed): a `defer` inside a loop
    // body, and a loop inside a deferred body. The deferred exit is a block's
    // `try … finally`, which a `break` would run correctly in JS, but neither
    // has been graded with loop control.
    // =========================================================================
    // s469 — `wall`: the frame is a loop BOUND AS A VALUE (§49.6 rule 6): a
    // `break` / `continue` below it may name it or a loop inside it, never a
    // loop outside it (E-LOOP-005).
    type LoopFrame:struct = { label: string, sym: Sym, wall: boolean }
    type LabelAt:struct = { name: string, span: ASpan }

    fn loopChecks(file: string, b: ABlock, st0: AS) -> AS {
        const st: AS = loopDupLabels(file, loopLabelsIn(b), st0)
        return loopCopyStmts(file, b.stmts, loopBlock(file, b, [], false, st))
    }

    // =========================================================================
    // s473 — THE LOOP-COPY LINT (SPEC §66.10, ruled S473 "A write to a loop
    // copy that changes nothing: W- lint"). A `for … of` binder is a COPY of
    // the element (§66.10: "a loop binder … is a copy"), so a part write to it
    // (`p.name = v`, accepted by resolveLocalPartWrite — Core Assign with a
    // path) changes the copy only. When no later read of the binder can see
    // the write, it changes nothing: W-LOOP-COPY-WRITE-UNREAD, at the write.
    // A read "can see" it when it is outside the write's own expression (the
    // value and the indices are evaluated BEFORE the write) and either follows
    // the write in source order or — the write sitting inside a loop nested in
    // the body, which re-runs earlier statements — anywhere in the body. A body
    // whose reads the walk cannot enumerate (a lifted markup row, an effect, a
    // `defer`) silences the lint for that loop: a lint never guesses. Facts are
    // read by Sym (the binder's BBind; each Name's NLocal), so shadowing by an
    // inner binder of the name is exact.
    // =========================================================================
    type CopyWrite:struct = { root: int, span: ASpan, deep: boolean, label: string }
    type CopyRead:struct = { nid: int, start: int }
    type CopyWalk:struct = { writes: CopyWrite[], reads: CopyRead[], opaque: boolean }

    fn loopCopyStmts(file: string, ss: AStmt[], st0: AS) -> AS {
        let st: AS = st0
        for (const s of ss) {
            const k: AStmtK = s.k
            const f: AFor | not = forOf(k)
            if (f is given) st = loopCopyFor(file, f, st)
            for (const nb of nestedBlocks(s)) { st = loopCopyStmts(file, nb.stmts, st) }
        }
        return st
    }

    fn loopCopyFor(file: string, f: AFor, st0: AS) -> AS {
        const h: AForHead = f.head
        const bnd: ABind | not = match h {
            .HIter(bind: b) :> b
            .HForever :> not
            .HCond(cond: c) :> not
            .HCounted(init: i) :> not
        }
        if (bnd is not) return st0
        const bi: int = st0.facts.binds.nids.indexOf(bnd.nid)
        if (bi < 0) return st0
        const bf: BindFact = st0.facts.binds.facts[bi]
        const sym: Sym | not = match bf {
            .BBind(sym: s) :> s
            .BParam(sym: s) :> not
            .BGiven(sym: s) :> not
            .BLoop(label: l) :> not
            .BJump(target: t) :> not
        }
        if (sym is not) return st0
        // s473 review LOW-2: a body that already holds an error is skipped — a refused
        // statement records no Name facts, so its reads of the binder would vanish and the
        // lint would claim "nothing reads" beside the error
        if (errorWithin(st0, file, f.span)) return st0
        const w: CopyWalk = copyWalkStmts(st0, sym, f.body.stmts, false, { writes: [], reads: [], opaque: false })
        if (w.opaque) return st0
        let roots: int[] = []
        for (const cw of w.writes) { roots = roots.concat([cw.root]) }
        const src: string = iterSrcLabel(h)
        let st: AS = st0
        for (const cw of w.writes) {
            let seen = false
            for (const r of w.reads) {
                if (roots.indexOf(r.nid) < 0 && (r.start < cw.span.start || r.start >= cw.span.end)) {
                    if (cw.deep || r.start >= cw.span.end) seen = true
                }
            }
            if (!seen) {
                st = addDiag(st, file, cw.span, "W-LOOP-COPY-WRITE-UNREAD", "`" + cw.label + " = …` writes `" + bnd.name + "`, the loop's COPY of an element of " + src + " (a loop binder is a copy, §66.10), and nothing reads `" + bnd.name + "` after it — the write changes nothing. To change the source, write it (`@xs[i].f = …` in a counted loop, or rebuild it with `.map(…)`); to keep the changed copy, read it (`lift " + bnd.name + "`, or pass it on)")
            }
        }
        return st
    }

    fn errorWithin(st: AS, file: string, sp: ASpan) -> boolean {
        for (const d of st.diags) {
            if (d.file == file && d.span.start >= sp.start && d.span.start < sp.end) {
                const sev: Severity = d.severity
                const isErr: boolean = match sev {
                    .Error :> true
                    .Warning :> false
                    .Info :> false
                }
                if (isErr) return true
            }
        }
        return false
    }

    fn iterSrcLabel(h: AForHead) -> string {
        return match h {
            .HIter(src: src) :> iterOfLabel(src)
            .HForever :> "the iterable"
            .HCond(cond: c) :> "the iterable"
            .HCounted(init: i) :> "the iterable"
        }
    }

    fn iterOfLabel(src: AIterSrc) -> string {
        return match src {
            .IterOf(e: x) :> atLabelOr(x)
            .IterRange(lo: lo) :> "the range"
        }
    }

    fn atLabelOr(e: AExpr) -> string {
        const a: string = atName(e)
        if (a != "") return "`@" + a + "`"
        const n: string = exprName(e)
        if (n != "") return "`" + n + "`"
        return "the iterable"
    }

    // A statement whose reads this walk cannot see: a lifted markup row (its
    // interpolations read names), an effect body, a deferred body.
    fn copyOpaque(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Lift(what: w) :> liftExprs(w).length == 0
            .EffectStmt(w: w) :> true
            .Defer(body: d) :> true
            .For(f: lf) :> false
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .Return(e: x) :> false
            .If(cond: c) :> false
            .Given(name: n) :> false
            .Fail(f: x) :> false
        }
    }

    fn copyWalkStmts(st: AS, sym: Sym, ss: AStmt[], deep: boolean, acc0: CopyWalk) -> CopyWalk {
        let acc: CopyWalk = acc0
        for (const s of ss) {
            if (copyOpaque(s)) acc = { writes: acc.writes, reads: acc.reads, opaque: true }
            const k: AStmtK = s.k
            const ev: AExpr | not = match k {
                .Eval(e: e) :> e
                .For(f: lf) :> not
                .Break(label: x) :> not
                .Continue(label: x) :> not
                .Lift(what: w) :> not
                .Local(name: n) :> not
                .Return(e: x) :> not
                .If(cond: c) :> not
                .Given(name: n) :> not
                .EffectStmt(w: w) :> not
                .Defer(body: d) :> not
                .Fail(f: x) :> not
            }
            if (ev is given) acc = copyWriteOf(st, sym, ev, deep, acc)
            for (const x of stmtExprs(s)) { acc = copyReadsIn(st, sym, x, acc) }
            const inner: boolean = deep || forOf(k) is given
            for (const nb of nestedBlocks(s)) { acc = copyWalkStmts(st, sym, nb.stmts, inner, acc) }
        }
        return acc
    }

    // `e` a part write of the binder that the binder ACCEPTED (its effect is a
    // local Assign of `sym` with a path) — a refused write has its error only.
    fn copyWriteOf(st: AS, sym: Sym, e: AExpr, deep: boolean, acc: CopyWalk) -> CopyWalk {
        const t: AExpr | not = assignedTarget(e)
        if (t is not) return acc
        const rn: AExpr | not = partRootName(t)
        if (rn is not) return acc
        const ef: EffectFact | not = effectFactIn(st, e.nid)
        const ok: boolean = match ef {
            .EAssignLocal(sym: s, path: pa) :> s.id == sym.id && pa.length > 0
            .EWrite(w: x) :> false
            .ESpread(ws: x) :> false
            .EReset(w: x) :> false
            .EEdits(w: x) :> false
            .ERemove(w: x) :> false
            .EElemAt(cap: c) :> false
            .EPosition(cap: c) :> false
            not :> false
        }
        if (!ok) return acc
        const cw: CopyWrite = { root: rn.nid, span: e.span, deep: deep, label: partLabel(exprName(rn), partSteps(t)) }
        return { writes: acc.writes.concat([cw]), reads: acc.reads, opaque: acc.opaque }
    }

    // Every Name in `e` (at any depth) that names the binder `sym`.
    fn copyReadsIn(st: AS, sym: Sym, e: AExpr, acc0: CopyWalk) -> CopyWalk {
        let acc: CopyWalk = acc0
        if (exprName(e) != "") {
            const nf: NameFact | not = nameFactIn(st, e.nid)
            const hit: boolean = match nf {
                .NLocal(sym: s) :> s.id == sym.id
                .NField(decl: d) :> false
                .NInst(decl: d) :> false
                .NStruct(owner: o) :> false
                .NFn(sym: s) :> false
                .NLength :> false
                .NSurface(of: o) :> false
                .NConst(sym: s) :> false
                not :> false
            }
            if (hit) acc = { writes: acc.writes, reads: acc.reads.concat([{ nid: e.nid, start: e.span.start }]), opaque: acc.opaque }
        }
        for (const x of exprKids(e)) { acc = copyReadsIn(st, sym, x, acc) }
        return acc
    }

    fn loopLabelsIn(b: ABlock) -> LabelAt[] {
        let out: LabelAt[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const f: AFor | not = forOf(k)
            if (f is given) {
                if (f.label != "") out = out.concat([{ name: f.label, span: f.span }])
            }
            for (const nb of nestedBlocks(s)) { out = out.concat(loopLabelsIn(nb)) }
        }
        return out
    }

    fn forOf(k: AStmtK) -> AFor | not {
        return match k {
            .For(f: lf) :> lf
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: x) :> not
            .Eval(e: x) :> not
            .Local(name: n) :> not
            .Return(e: x) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: d) :> not
            .Fail(f: x) :> not
        }
    }

    fn loopDupLabels(file: string, ls: LabelAt[], st0: AS) -> AS {
        let st: AS = st0
        let j: int = 0
        while (j < ls.length) {
            let i: int = 0
            let dup = false
            while (i < j) {
                if (!dup && ls[i].name == ls[j].name) {
                    st = addDiag(st, file, ls[j].span, "E-LOOP-006", "the label `" + ls[j].name + "` is already used by the loop at " + offsetOf(ls[i].span) + " in this body — loop labels are unique within a function body (§49.2.2, §49.4.2); rename one")
                    dup = true
                }
                i = i + 1
            }
            j = j + 1
        }
        return st
    }

    fn loopBlock(file: string, b: ABlock, stack: LoopFrame[], inDefer: boolean, st0: AS) -> AS {
        let st: AS = st0
        for (const s of b.stmts) { st = loopStmt(file, s, stack, inDefer, st) }
        return st
    }

    fn loopBlocks(file: string, bs: ABlock[], stack: LoopFrame[], inDefer: boolean, st0: AS) -> AS {
        let st: AS = st0
        for (const b of bs) { st = loopBlock(file, b, stack, inDefer, st) }
        return st
    }

    fn loopStmt(file: string, s: AStmt, stack: LoopFrame[], inDefer: boolean, st: AS) -> AS {
        const k: AStmtK = s.k
        return match k {
            .For(f: lf) :> loopFor(file, lf, stack, inDefer, st)
            .Break(label: l) :> loopJump(file, s, l, true, stack, inDefer, st)
            .Continue(label: l) :> loopJump(file, s, l, false, stack, inDefer, st)
            .Lift(what: w) :> loopBlocks(file, liftBlocks(w), stack, inDefer, st)
            .Defer(body: d) :> loopDefer(file, s, d, stack, st)
            .EffectStmt(w: w) :> loopBlock(file, w.body, [], inDefer, st)
            .Eval(e: x) :> loopBlocks(file, nestedBlocks(s), stack, inDefer, st)
            .Local(name: n) :> loopBlocks(file, nestedBlocks(s), stack, inDefer, st)
            .Return(e: x) :> loopBlocks(file, nestedBlocks(s), stack, inDefer, st)
            .If(cond: c) :> loopBlocks(file, nestedBlocks(s), stack, inDefer, st)
            .Given(name: n) :> loopBlocks(file, nestedBlocks(s), stack, inDefer, st)
            .Fail(f: x) :> st
        }
    }

    fn loopFor(file: string, f: AFor, stack: LoopFrame[], inDefer: boolean, st0: AS) -> AS {
        let st: AS = boundLoopDefers(file, f, st0)
        // s471: a statement loop inside a deferred body is built (its jumps stay
        // inside it — §19.16.3 rule 1, deferBodyRule); a loop BOUND AS A VALUE
        // there is not yet (Core C16 has no Gather in a Defer body)
        if (inDefer && f.bound is given) st = addDiag(st, file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "a loop bound as a value inside a deferred body is not in the bootstrap yet — move the loop into a function and call it from the `defer`")
        // the head runs around the body: a `break` in it names an enclosing loop
        st = loopBlock(file, forInitBlock(f), stack, inDefer, st)
        for (const x of forHeadExprs(f)) { st = loopBlocks(file, allExprBlocks(x), stack, inDefer, st) }
        const sym: Sym | not = loopSymIn(st, f.nid)
        if (sym is not) return loopBlock(file, f.body, [], inDefer, addDiag(st, file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "internal: this loop was not bound (a bootstrap defect — please report it)"))
        return loopBlock(file, f.body, stack.concat([{ label: f.label, sym: sym, wall: f.bound is given }]), inDefer, st)
    }

    fn loopJump(file: string, s: AStmt, label: string, isBreak: boolean, stack: LoopFrame[], inDefer: boolean, st: AS) -> AS {
        let kw: string = "continue"
        if (isBreak) kw = "break"
        if (label == "") {
            if (stack.length > 0) return addBind(st, s.nid, BindFact.BJump(stack[stack.length - 1].sym))
            if (inDefer) return st          // E-DEFER-CONTROL-FLOW: the deferred-body rule's (deferBodyRule)
            let code: string = "E-LOOP-002"
            if (isBreak) code = "E-LOOP-001"
            return addDiag(st, file, s.span, code, "`" + kw + "` is not inside any loop — `" + kw + "` may only appear inside a `for` loop body (§49.4.1)")
        }
        let i: int = stack.length - 1
        let crossed = false
        while (i >= 0) {
            if (stack[i].label == label) {
                // s469 (§49.6 rule 6): past a bound loop's own frame, a label names a loop outside it
                if (crossed) return addDiag(st, file, s.span, "E-LOOP-005", "`" + kw + " " + label + "` attempts to exit a loop outside the bound loop that contains it — `" + kw + "` cannot leave a loop bound as a value for a loop outside it (§49.4.3, §49.6 rule 6). Restructure so the loop control is not inside the bound loop, or lift a signal value and handle it after the loop")
                return addBind(st, s.nid, BindFact.BJump(stack[i].sym))
            }
            if (stack[i].wall) crossed = true
            i = i - 1
        }
        if (inDefer) return st          // s471: a label naming no loop inside the deferred body leaves it — E-DEFER-CONTROL-FLOW (deferJump)
        let lcode: string = "E-LOOP-004"
        if (isBreak) lcode = "E-LOOP-003"
        return addDiag(st, file, s.span, lcode, "`" + kw + " " + label + "` names no enclosing loop — " + labelsHere(stack) + "; a label names a `for` that encloses the `" + kw + "` in the same body (§49.3.3, §49.4.2)")
    }

    fn labelsHere(stack: LoopFrame[]) -> string {
        let names: string[] = []
        for (const fr of stack) {
            if (fr.label != "") names = names.concat(["`" + fr.label + "`"])
        }
        if (names.length == 0) return "no enclosing loop here has a label"
        return "the labels of the loops enclosing it are " + names.join(", ")
    }

    // s471 — a `defer` in a loop body is a defer site (§19.16.2: "Registration.
    // … the innermost statement list that contains the `defer`: … a loop body
    // (once per iteration)"). The body is its own Core Block, which the printer
    // wraps in its own try/finally, so each iteration runs its deferred bodies
    // at that iteration's exit — falling off the end, `continue`, `break`,
    // `return`, `fail` (§19.16.6: "A loop body is its own block, so each
    // iteration has its own stack instance"). Was refused (E-BOOTSTRAP-UNSUPPORTED)
    // before s471. A `defer` DIRECTLY in the body of a loop bound as a value is
    // E-DEFER-UNSUPPORTED-SITE (loopFor — §19.16.2).
    fn loopDefer(file: string, s: AStmt, d: ABlock, stack: LoopFrame[], st0: AS) -> AS {
        return loopBlock(file, d, [], true, st0)
    }

    // s471 — §19.16.2 E-DEFER-UNSUPPORTED-SITE: "The same code covers a `defer`
    // written directly in an arm of a `match` / `if` / `for` that is used for its
    // VALUE". A bound loop's body (`const xs = for (…) { … lift e; };`) is such
    // an arm; a `defer` in a statement block nested in it (an `if` branch) is
    // not — that block is a defer site of its own.
    fn boundLoopDefers(file: string, f: AFor, st0: AS) -> AS {
        let st: AS = st0
        if (f.bound is not) return st
        for (const s of f.body.stmts) {
            if (isDeferStmt(s)) st = addDiag(st, file, s.span, "E-DEFER-UNSUPPORTED-SITE", "a `defer` directly in the body of a `for` bound as a value — the body is an arm whose result is used as a value (§19.16.2). Put the `defer` in a block nested in the body (an `if` branch), move it to the enclosing block, or use the loop as a statement")
        }
        return st
    }

    fn isDeferStmt(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Defer(body: d) :> true
            .Local(name: n) :> false
            .Return(e: x) :> false
            .If(cond: c) :> false
            .Given(name: n) :> false
            .For(f: x) :> false
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .EffectStmt(w: w) :> false
            .Eval(e: x) :> false
            .Fail(f: x) :> false
            .Lift(what: x) :> false
        }
    }

    fn loopSymIn(st: AS, nid: int) -> Sym | not {
        const i: int = st.facts.binds.nids.indexOf(nid)
        if (i < 0) return not
        return loopLabelOf(st.facts.binds.facts[i])
    }

    fn loopLabelOf(f: BindFact) -> Sym | not {
        return match f {
            .BLoop(label: l) :> l
            .BBind(sym: x) :> not
            .BParam(sym: x) :> not
            .BGiven(sym: x) :> not
            .BJump(target: x) :> not
        }
    }

    // =========================================================================
    // s469 — INDEX READS (§49.13). `xs[i]` has type `T`; out of range it is
    // the E-INDEX-OUT-OF-RANGE-RT trap at run time (§19.17 — the printer's
    // `rt.index`, which never yields `undefined`, naming the index and the
    // length). `xs.at(i)` has type `T | not` and never traps (a negative `i`
    // is out of range — not counted from the end). Only a provable tape is
    // indexed: a `T[] | not` must be narrowed first, and `s[i]` on a string is
    // OPEN in §49.13 — refused. (An index WRITE is §66.12.6's — unchanged.)
    // =========================================================================
    fn resolveIndexRead(env: Env, e: AExpr, o: AExpr, ix: AExpr, st0: AS) -> RX {
        const ro: RX = resolveExpr(env, o, not, st0)
        const st: AS = resolveExpr(env, ix, Type.Int, ro.st).st
        const t: Type | not = ro.x.ty
        if (t is not || ro.x.inst is given) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "an index read `xs[i]` is in the bootstrap on a value of tape type (`T[…]`) — this value's type is not known to be one; annotate it", st)
        const el: Type | not = seqElem(t)
        if (el is given) return plain(el, addValue(st, e.nid, ValueFact.VIndex(env.file + ":" + lineOf(env.g, env.file, e.span.start))))
        // s469 — `s[i]` on a string (§66.12.8 rule 6, RULED S469): the code point at
        // position `i`, a `string`; out of range — a negative `i` included, literal or
        // computed (rule 7) — the same E-INDEX-OUT-OF-RANGE-RT trap (the runtime's ONE
        // `indexRead`, which counts a string's positions in code points)
        if (t == Type.Str) return plain(Type.Str, addValue(st, e.nid, ValueFact.VIndex(env.file + ":" + lineOf(env.g, env.file, e.span.start))))
        if (maybeInner(t) is given) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "this value is `" + typeName(t) + "` — it may be `not`, so it cannot be indexed; narrow it first (`if (xs is given) { … xs[i] … }`)", st)
        return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`[i]` reads a tape by position (§49.13), and this value is `" + typeName(t) + "`", st)
    }

    fn resolveAtCall(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> RX | not {
        const ro: RX = resolveExpr(env, m.obj, not, st0)
        const t: Type | not = ro.x.ty
        if (t is not || ro.x.inst is given) return not
        const el: Type | not = seqElem(t)
        if (el is not) return not
        if (args.length != 1) return diagX(env, e, "E-CALL-ARITY", "`.at(…)` takes one argument, the index (§49.13); " + args.length + " given", resolveExprs(env, args, not, ro.st))
        const st: AS = resolveExpr(env, args[0], Type.Int, ro.st).st
        let rt: Type = Type.Maybe(el)
        if (maybeInner(el) is given) rt = el
        return plain(rt, addValue(st, e.nid, ValueFact.VAt))
    }

    fn isIndexExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Index(obj: o) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // ---- the typer ------------------------------------------------------------
    // The index is an `int` (§49.13 rule 4: E-TYPE-031); the read is the element.
    // Only a READ the binder accepted (VIndex) is typed so — an index that is a
    // write target (`@xs[i].f = v`) is judged by the write's own rule.
    fn typeIndexRead(env: TEnv, vf: ValueFact | not, o: AExpr, i: AExpr, ts0: TypeState) -> RVT {
        const ro: RVT = typeExpr(env, o, ts0)
        const ri: RVT = typeExpr(env, i, ro.ts)
        if (indexLocOfFact(vf) == "") return rvt(VType.Unknown, ri.ts)
        const ts: TypeState = checkValue(env, ri.vt, Type.Int, i.span, "the index of `xs[i]` (an `int`, §49.13)", ri.ts)
        const t: Type | not = knownOf(ro.vt)
        if (t is not) return rvt(VType.Unknown, ts)
        if (t == Type.Str) return rvt(known(Type.Str), ts)     // s469: `s[i]` is one code point (§66.12.8 rule 6)
        const el: Type | not = seqElem(t)
        if (el is not) return rvt(VType.Unknown, ts)
        return rvt(known(el), ts)
    }

    fn atCallType(ts: TypeState, callee: AExpr) -> VType {
        const obj: AExpr | not = memberObj(callee)
        if (obj is not) return VType.Unknown
        const t: Type | not = knownOf(exprType0(ts, obj.nid))
        if (t is not) return VType.Unknown
        const el: Type | not = seqElem(t)
        if (el is not) return VType.Unknown
        if (maybeInner(el) is given) return known(el)
        return known(Type.Maybe(el))
    }

    fn atArgCheck(env: TEnv, e: AExpr, args: AExpr[], ts: TypeState) -> TypeState {
        if (args.length != 1) return ts
        if (!isAtFact(valueFact(env.t.values, e.nid))) return ts
        return checkValue(env, exprType0(ts, args[0].nid), Type.Int, args[0].span, "the index of `xs.at(i)` (an `int`, §49.13)", ts)
    }

    fn indexLocOfFact(f: ValueFact | not) -> string {
        return match f {
            .VIndex(loc: l) :> l
            .VAt :> ""
            .VTemplate(text: tx) :> ""
            .VToEnum(enumSym: s) :> ""
            .VMethod(op: zm) :> ""
            .VLit(lit: l) :> ""
            .VVariant(enumSym: s) :> ""
            .VStructOf(ty: s) :> ""
            .VConstruct(enumSym: s) :> ""
            .VOp(op: o) :> ""
            .VHost(call: c) :> ""
            .VSeqCall(op: o) :> ""
            .VLambda(params: ps) :> ""
            not :> ""
        }
    }

    fn isAtFact(f: ValueFact | not) -> boolean {
        return match f {
            .VAt :> true
            .VTemplate(text: tx) :> false
            .VIndex(loc: x) :> false
            .VToEnum(enumSym: s) :> false
            .VMethod(op: zm) :> false
            .VLit(lit: l) :> false
            .VVariant(enumSym: s) :> false
            .VStructOf(ty: s) :> false
            .VConstruct(enumSym: s) :> false
            .VOp(op: o) :> false
            .VHost(call: c) :> false
            .VSeqCall(op: o) :> false
            .VLambda(params: ps) :> false
            not :> false
        }
    }

    // s469 — a loop. Its body runs again after its own writes, so no narrowing
    // a write in the body could undo holds in the head or the body: only a
    // never-rebound local's survives into the loop (tDeferEnv's rule — fail
    // closed: a dropped narrowing makes a read unproven, never silently `T`),
    // and the same holds after it (a `break` leaves from anywhere in the body).
    // s469 — a loop bound as a value (§49.6 rule 2): its binder's type is a
    // tape with no grants whose element is the join of the lifted values'
    // types ("values of different types give their union" — a union tape is
    // not in the bootstrap's type system: refused by name). A written type
    // is the binder's; every lifted value is checked against its element.
    fn typeForStmt(env: TEnv, s: AStmt, f: AFor, ts0: TypeState) -> RTEnv {
        const r: RTEnv = typeFor(env, s, f, ts0)
        const b: AForBound | not = f.bound
        if (b is not) return r
        const sym: Sym | not = bindSym(bindFact(env.t.binds, b.nid))
        if (sym is not) return r
        let ts: TypeState = r.ts
        const lifts: AExpr[] = liftOperands(f.body)
        const annot: Type | not = annotOf(env.t, sym)
        if (annot is given) {
            const ae: Type | not = seqElem(annot)
            if (ae is not) {
                ts = report(ts, env, f.span, "E-TYPE-031", "`" + b.name + "` is written `" + typeName(annot) + "`, but a loop bound as a value is a tape (§49.6 rule 2: a fresh tape of the lifted values) — write `" + b.name + ": T[]`")
            } else {
                for (const e of lifts) {
                    if (!hasErrIn(env.errs, e.span)) ts = checkValue(env, exprType0(ts, e.nid), ae, e.span, "a value the loop bound to `" + b.name + "` lifts", ts)
                }
            }
            return keepTEnv(tWithLocal(r.env, sym, known(annot)), ts)
        }
        let vt: VType = VType.Unknown
        let first = true
        let allKnown = true
        for (const e of lifts) {
            const x: VType = exprType0(ts, e.nid)
            if (knownOf(x) is not && oneOfMembers(x).length == 0) allKnown = false      // s472: a choice is known
            if (first) {
                vt = x
                first = false
            } else {
                vt = joinVT(vt, x)
            }
        }
        const el: Type | not = knownOf(vt)
        if (el is not) {
            if (lifts.length > 1 && allKnown) ts = report(ts, env, f.span, "E-BOOTSTRAP-UNSUPPORTED", "the loop bound to `" + b.name + "` lifts values of different types — its value is a tape of their union (§49.6 rule 2), and a union tape is not in the bootstrap's type system; lift one type, or write the type: `const " + b.name + ": T[] = for …`")
            return keepTEnv(tWithLocal(r.env, sym, VType.Unknown), ts)
        }
        const bvt: VType = known(Type.Seq(el, fixedSeq()))
        return keepTEnv(tWithLocal(r.env, sym, bvt), contribute(ts, sym, bvt))
    }

    // A lifted value is typed as any expression; a lifted row as markup where
    // it stands (§17.4). A lifted VALUE is not judged as text here: whether it
    // is text depends on its SINK, which the lift does not know. A lift that
    // appends to a bound value loop is a tape element (§49.6 rule 2: "Its element
    // type is the type of the lifted values") and a `{ lift … }` match arm is the
    // arm's value — neither is a §14.13.1 text sink. A lift that appends to a
    // MARKUP gather (`${ for … { lift e; } }`, §17.4) IS markup text: judged
    // once, at the gather (typeGather). s473 r1 HIGH-1 (review of #1621).
    fn typeLift(env: TEnv, w: ALift, ts: TypeState) -> TypeState {
        return match w {
            .LiftExpr(e: e) :> typeExpr(env, e, ts).ts
            .LiftNode(n: n) :> typeNode(env, n, ts)
        }
    }

    // The value operands of the `lift`s that append to THIS loop: through
    // `if` / `given` blocks and statement loops, not into a nested bound loop
    // (rule 7: it captures its own) or an arm block (refused there).
    fn liftOperands(b: ABlock) -> AExpr[] {
        let out: AExpr[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const own: AExpr[] = match k {
                .Lift(what: w) :> liftExprs(w)
                .If(cond: c, thenB: tb, elseB: el) :> liftOperands(tb).concat(liftOperandsMaybe(el))
                .Given(name: n, body: gb) :> liftOperands(gb)
                .For(f: lf) :> nestedLiftOperands(lf)
                .Eval(e: x) :> []
                .Local(name: n) :> []
                .Return(e: x) :> []
                .EffectStmt(w: x) :> []
                .Defer(body: x) :> []
                .Fail(f: x) :> []
                .Break(label: x) :> []
                .Continue(label: x) :> []
            }
            out = out.concat(own)
        }
        return out
    }

    fn liftOperandsMaybe(b: ABlock | not) -> AExpr[] {
        if (b is not) return []
        return liftOperands(b)
    }

    fn nestedLiftOperands(f: AFor) -> AExpr[] {
        if (f.bound is given) return []
        return liftOperands(f.body)
    }

    fn typeFor(env: TEnv, s: AStmt, f: AFor, ts0: TypeState) -> RTEnv {
        const entry: TEnv = tDeferEnv(env)
        const h: AForHead = f.head
        const ts: TypeState = match h {
            .HForever :> typeBlock(entry, f.body, ts0)
            .HCond(cond: c) :> typeLoopCond(entry, c, f.body, ts0)
            .HCounted(init: i, cond: c, step: sp) :> typeCounted(entry, i, c, sp, f.body, ts0)
            .HIter(bind: b, src: src, key: ky) :> typeIter(entry, b, src, ky, f.body, ts0)
        }
        return keepTEnv(tDeferEnv(env), ts)
    }

    fn typeLoopCond(env0: TEnv, c: AExpr, body: ABlock, ts0: TypeState) -> TypeState {
        const env: TEnv = tKeptUnnarrow(env0, c)      // s474 (§50, D10)
        const rc: RVT = typeExpr(env, c, ts0)
        const ts: TypeState = checkCond(env, c, rc.vt, "a `for` condition", rc.ts)
        const n: Narrowing = condNarrowing(env, c)
        return typeBlock(tCallUnnarrow(tNarrow(env, n.yes), c), body, ts)
    }

    fn typeCounted(env0: TEnv, init: AStmt[], cond: AExpr | not, step: AExpr[], body: ABlock, ts0: TypeState) -> TypeState {
        const ib: ABlock = { nid: -1, span: body.span, stmts: init }
        const ri: RTEnv = typeBlockEnv(env0, ib, ts0)
        const env: TEnv = tDeferEnv(ri.env)
        let ts: TypeState = ri.ts
        let benv: TEnv = env
        if (cond is given) {
            const rc: RVT = typeExpr(env, cond, ts)
            ts = checkCond(env, cond, rc.vt, "a `for` condition", rc.ts)
            benv = tCallUnnarrow(tNarrow(env, condNarrowing(env, cond).yes), cond)
        }
        ts = typeBlock(benv, body, ts)
        for (const x of step) { ts = typeEvalStmt(env, x, ts).ts }
        return ts
    }

    fn typeIter(env: TEnv, b: ABind, src: AIterSrc, key: AExpr | not, body: ABlock, ts0: TypeState) -> TypeState {
        const r: RVT = typeIterSrc(env, src, ts0)
        let ts: TypeState = r.ts
        const sym: Sym | not = bindSym(bindFact(env.t.binds, b.nid))
        if (sym is not) return typeBlock(env, body, ts)
        // the binder's type is the element's — and an assignment to a `let`
        // binder joins with it (contribute), never replaces it
        ts = contribute(ts, sym, r.vt)
        const benv: TEnv = tWithLocal(env, sym, r.vt)
        if (key is given) ts = typeLoopKey(benv, key, ts)
        return typeBlock(benv, body, ts)
    }

    // s474 — the header `key` (§17.4b) reads the binder. Its value identifies
    // a row across updates, so it is a string or a number: E-KEY-001 (§34: "The
    // keyed-iteration runtime requires primitive keys for stable diffing" — the
    // §6.5.3 rule, carried to the canonical header form, S473 review-surfaced
    // 5). A key whose type is not known fails closed (an object key would never
    // match itself across updates); one blamed on an earlier error is not
    // reported again (Rule C).
    fn typeLoopKey(env: TEnv, key: AExpr, ts0: TypeState) -> TypeState {
        const rk: RVT = typeExpr(env, key, ts0)
        if (hasErrIn(env.errs, key.span) || condBlamed(env, key, rk.ts)) return rk.ts
        const t: Type | not = knownOf(rk.vt)
        if (t is given) {
            const k: int = kindOf(t)
            if (k <= 2) return rk.ts
            return report(rk.ts, env, key.span, "E-KEY-001", "a loop `key` is a string or a number — it names the row across updates, and this one is `" + typeName(t) + "`. Key by a primitive field (`key x.id`) (§17.4b, §6.5.3)")
        }
        if (isOneOfVT(rk.vt)) return report(rk.ts, env, key.span, "E-KEY-001", "a loop `key` is ONE of a string or a number — it names the row across updates, and this one may be any of `" + oneOfNames(rk.vt) + "`. Key by a single primitive field (`key x.id`) (§17.4b, §6.5.3)")
        if (isAbsentVT(rk.vt)) return report(rk.ts, env, key.span, "E-KEY-001", "a loop `key` is a string or a number — it names the row across updates, and this one is `not`. Key by a primitive field (`key x.id`) (§17.4b, §6.5.3)")
        return report(rk.ts, env, key.span, "E-KEY-001", "the type of this loop `key` is not known — a `key` is a string or a number (it names the row across updates); key by a primitive field (`key x.id`) or annotate what it reads (§17.4b, §6.5.3)")
    }

    fn oneOfNames(v: VType) -> string {
        const ts: Type[] = match v {
            .OneOf(ts: xs) :> xs
            .Known(t: x) :> [x]
            .Absent :> []
            .Unknown :> []
        }
        let out: string[] = []
        for (const t of ts) { out = out.concat([typeName(t)]) }
        return out.join(" | ")
    }

    fn isOneOfVT(v: VType) -> boolean {
        return match v {
            .OneOf(ts: x) :> true
            .Known(t: x) :> false
            .Absent :> false
            .Unknown :> false
        }
    }

    fn typeIterSrc(env: TEnv, src: AIterSrc, ts: TypeState) -> RVT {
        return match src {
            .IterOf(e: x) :> iterElemOf(env, x, typeExpr(env, x, ts))
            .IterRange(lo: lo, hi: hi) :> rangeBounds(env, lo, hi, ts)
        }
    }

    // The iterable's element: a tape's element; a string's code point (a
    // string — §49.3.5 leaves it ⚑ OPEN; the S469 brief reads code points, as
    // the printed `for…of` does). Anything not PROVABLY a tape or a string is
    // refused — `not`, an instance, a number, a type the compiler cannot
    // resolve: iterating it would be the host's `for…of`, not §49.3.5's.
    fn iterElemOf(env: TEnv, x: AExpr, r: RVT) -> RVT {
        if (hasErrIn(env.errs, x.span)) return rvt(VType.Unknown, r.ts)
        const t: Type | not = knownOf(r.vt)
        if (t is given) {
            const el: Type | not = seqElem(t)
            if (el is given) return rvt(known(el), r.ts)
            if (kindOf(t) == 2) return rvt(known(Type.Str), r.ts)
            let hint: string = ""
            if (maybeInner(t) is given) hint = " — it may be `not`: narrow it first (`if (xs is given) { for (x of xs) { … } }`)"
            return rvt(VType.Unknown, report(r.ts, env, x.span, "E-BOOTSTRAP-UNSUPPORTED", "a `for (x of …)` iterable is a tape or a string in the bootstrap (§49.3.5), and this value is `" + typeName(t) + "`" + hint))
        }
        if (condBlamed(env, x, r.ts)) return rvt(VType.Unknown, r.ts)
        if (isAbsentVT(r.vt)) return rvt(VType.Unknown, report(r.ts, env, x.span, "E-BOOTSTRAP-UNSUPPORTED", "`for (x of not)` — `not` is not a tape (§49.3.5)"))
        return rvt(VType.Unknown, report(r.ts, env, x.span, "E-BOOTSTRAP-UNSUPPORTED", "the type of this `for (x of …)` iterable is not known — annotate it (a tape `T[]`, or a `string`); the bootstrap iterates only what it can prove is one (§49.3.5)"))
    }

    // §49.2.5: "Both bounds SHALL be `int`. A bound of any other type is
    // E-RANGE-BOUND-NOT-INT" — a bound whose type does not resolve included
    // (fail closed, as the S460 condition rule: provable or an error).
    fn rangeBounds(env: TEnv, lo: AExpr, hi: AExpr, ts0: TypeState) -> RVT {
        const rl: RVT = typeExpr(env, lo, ts0)
        let ts: TypeState = rangeBound(env, lo, rl.vt, "lower", rl.ts)
        const rh: RVT = typeExpr(env, hi, ts)
        ts = rangeBound(env, hi, rh.vt, "upper", rh.ts)
        return rvt(known(Type.Int), ts)
    }

    fn rangeBound(env: TEnv, x: AExpr, v: VType, which: string, ts: TypeState) -> TypeState {
        if (hasErrIn(env.errs, x.span)) return ts
        const t: Type | not = knownOf(v)
        if (t is given) {
            if (kindOf(t) == 0) return ts
            return report(ts, env, x.span, "E-RANGE-BOUND-NOT-INT", "the " + which + " bound of this range has type `" + typeName(t) + "` — range bounds are `int` (§49.2.5)")
        }
        if (condBlamed(env, x, ts)) return ts
        return report(ts, env, x.span, "E-RANGE-BOUND-NOT-INT", "the " + which + " bound of this range has a type the compiler cannot resolve — range bounds are `int`; annotate it (§49.2.5)")
    }

    // ---- the suspension plan -------------------------------------------------------
    // s471 — a loop BODY may wait (§49.12.7: "A server call in a loop body of a
    // function is awaited once per iteration (§13)"; §13.8 (i): a function
    // body, a handler, an effect body are action positions). The body is
    // planned as any statement list (its `if`s get their joins, its handling
    // forms their outcomes); a loop whose body holds a suspension point gets an
    // EXIT continuation — a join on the `for` statement, whatever follows it:
    // lower's continuation pass moves the rest of the block into it, and the
    // body's every path ends in a Continue / Break of the loop (check.scrml C12).
    // §49.3.7 ("A compiler that splits the body across a suspension (§13.2)
    // SHALL preserve this") is the printer's: each iteration is one call whose
    // parameters are its bindings (print.scrml cycleJs, runtime `cycle`).
    // Still refused, by name (g-bootstrap-loop-wait-and-defer-s469, remainder):
    // a wait in a loop HEAD (the iterable / bounds / `init` run once before the
    // loop, the condition / step per iteration — neither is split yet), and a
    // wait in a loop bound as a value (§49.6 — its Gather is no continuation).
    fn planLoop(cx: PCx, s: AStmt, f: AFor, ps0: PS) -> PS {
        const pos: Pos = { refused: "a `for` loop's head — a loop head cannot wait for the server yet (the suspension split reaches a loop's body, not its head; §49.12.7). Make the call before the loop (`const xs = load() !{ … };`), or in the body" }
        let ps: PS = ps0
        for (const e of forHeadExprs(f)) { ps = planExpr(cx, e, pos, ps).ps }
        ps = planLoopBlock(cx, forInitBlock(f), pos, ps)
        if (f.bound is given) {
            const bpos: Pos = { refused: "a loop bound as a value (`const xs = for (…) { … }`, §49.6) — a bound loop cannot wait for the server yet (its value is built in one synchronous run). Use a statement loop that appends to a tape, or make the call before the loop" }
            return planLoopBlock(cx, f.body, bpos, ps)
        }
        const before: int = ps.plan.at.length
        ps = planBlock(cx, f.body, ps)
        if (ps.plan.at.length > before) {
            const rk: RPSym = pmint(ps, "loop_exit")
            ps = rk.ps
            ps = withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps, joins: ps.plan.joins.concat([{ nid: s.nid, k: rk.s }]), waiting: ps.plan.waiting, rets: ps.plan.rets })
        }
        return ps
    }

    fn planLoopBlock(cx: PCx, b: ABlock, pos: Pos, ps0: PS) -> PS {
        let ps: PS = ps0
        for (const s of b.stmts) {
            for (const e of stmtExprs(s)) { ps = planExpr(cx, e, pos, ps).ps }
            for (const nb of loopPlanBlocks(s)) { ps = planLoopBlock(cx, nb, pos, ps) }
        }
        return ps
    }

    // The statement blocks nested in `s` (not the arm blocks of its
    // expressions — planExpr walks those with the expression).
    fn loopPlanBlocks(s: AStmt) -> ABlock[] {
        const k: AStmtK = s.k
        return match k {
            .If(cond: c, thenB: t, elseB: el) :> thenElse(t, el)
            .Given(name: n, body: b) :> [b]
            .For(f: lf) :> [forInitBlock(lf), lf.body]
            .Defer(body: b) :> [b]
            .EffectStmt(w: w) :> []
            .Eval(e: x) :> []
            .Local(name: n) :> []
            .Return(e: x) :> []
            .Fail(f: x) :> []
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: x) :> []
        }
    }

    // =========================================================================
    // Views (markup).
    // =========================================================================
    fn resolveNodes(env: Env, ns: ANode[], st0: AS) -> AS {
        let st: AS = st0
        for (const n of ns) { st = resolveNode(env, n, st) }
        return chainCheck(env, ns, st)
    }

    // ---- s451: `if=` / `else-if=` / `else` chains (§17.1.1) ------------------
    // A chain is the maximal run of SIBLINGS: one `if=` element, then zero or
    // more `else-if=` elements, then at most one `else` element; whitespace-only
    // text between members does not break it (§17.1.1 Syntax). Exactly the
    // first true branch is in the DOM (lower.scrml `chainView`: ONE View.Cond).
    // The structure rules are LOCAL — each looks only at the immediately
    // preceding element at the same level (§17.1.1 Normative Rules):
    //   E-CTRL-001  `else` not preceded by an `if=` / `else-if=` element
    //   E-CTRL-002  `else-if=` not preceded by an `if=` / `else-if=` element
    //   E-CTRL-003  an `else-if=` / `else` element right after an `else` element
    //               (extends a chain past its terminal `else`; the element is
    //               also not preceded by `if=` / `else-if=`, so 001/002 fire too)
    //   E-CTRL-005  `else` / `else-if=` on the same element as `if=`
    // E-CTRL-004 (a state object opener) cannot arise: no state opener reaches
    // markup here (a declaration in markup is refused, resolveNode). An `if=`
    // after an `else` opens a NEW chain (the grammar's `if-element` begins one).
    // Fail closed (refused, never ignored): a chain attribute on an element the
    // chain lowering does not wrap (only HTML elements and uses are wrapped); an
    // `if=` / `else-if=` whose value is not an expression (quoted, valueless or
    // braced — it used to render unconditionally); `else` with a value; and
    // `else` + `else-if=` on one element (the SPEC names no rule for it).
    fn chainCheck(env: Env, ns: ANode[], st0: AS) -> AS {
        let st: AS = st0
        let prev: int = 0               // the preceding sibling element: 0 none / not a member, 1 `if=` or `else-if=`, 2 `else`
        for (const n of ns) {
            const k: ANodeK = n.k
            const e: AElem | not = match k {
                .Elem(e: x) :> x
                .Text(text: t) :> not
                .Interp(e: x) :> not
                .DeclNode(d: d) :> not
                .Css(c: c) :> not
                .Gather(f: x) :> not
                .Effect(w: w) :> not
            }
            if (e is given) {
                st = chainMember(env, e, prev, st)
                st = showHostCheck(env, e, st)
                st = attrCaseDiags(env, e, st)
                prev = chainRoleAfter(e)
            } else if (!blankNode(n) && !isCssNode(n)) {
                prev = 0
            }
        }
        return st
    }

    // What an element is to the NEXT sibling: 1 it carries `if=` or `else-if=`,
    // 2 it carries `else` (only), 0 neither.
    fn chainRoleAfter(e: AElem) -> int {
        if (attrNamed(e.attrs, "if") is given || attrNamed(e.attrs, "else-if") is given) return 1
        if (attrNamed(e.attrs, "else") is given) return 2
        return 0
    }

    fn chainMember(env: Env, e: AElem, prev: int, st0: AS) -> AS {
        let st: AS = st0
        const ia: AAttr | not = attrNamed(e.attrs, "if")
        const ea: AAttr | not = attrNamed(e.attrs, "else-if")
        const la: AAttr | not = attrNamed(e.attrs, "else")
        if (ia is not && ea is not && la is not) return st
        if (ia is given && (ea is given || la is given)) {
            st = addDiag(st, env.file, e.span, "E-CTRL-005", "`else` (or `else-if=`) and `if=` cannot appear on the same element `<" + e.tag + ">`. An element either opens a new chain (`if=`) or continues one (`else-if=` / `else`), not both (§17.1.1)")
        } else if (ea is given && la is given) {
            st = addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + e.tag + ">` carries both `else-if=` and `else` — §17.1.1 gives an element one chain role; the bootstrap refuses the combination rather than pick one")
        } else if (ea is given) {
            if (prev == 2) st = addDiag(st, env.file, e.span, "E-CTRL-003", "The element `<" + e.tag + " else-if=…>` tries to extend a chain that already ended with `else`. Once `else` appears, no further `else-if=` or `else` is allowed in the same chain (§17.1.1)")
            if (prev != 1) st = addDiag(st, env.file, ea.span, "E-CTRL-002", "`else-if=` on `<" + e.tag + ">` has no preceding `if=` element at the same level. An `else-if=` block must immediately follow an element with `if=` or `else-if=` (§17.1.1)")
        } else if (la is given) {
            if (prev == 2) st = addDiag(st, env.file, e.span, "E-CTRL-003", "The element `<" + e.tag + " else>` tries to extend a chain that already ended with `else`. Once `else` appears, no further `else-if=` or `else` is allowed in the same chain (§17.1.1)")
            if (prev != 1) st = addDiag(st, env.file, la.span, "E-CTRL-001", "`else` on `<" + e.tag + ">` has no preceding `if=` element at the same level. An `else` block must immediately follow an element with `if=` or `else-if=` (§17.1.1)")
        }
        // the condition's value: an expression (a quoted, valueless or braced
        // condition used to render the element unconditionally — fail-open)
        st = chainCondValue(env, e, ia, st)
        st = chainCondValue(env, e, ea, st)
        if (la is given && !isNoValue(la.value)) {
            st = addDiag(st, env.file, la.span, "E-BOOTSTRAP-UNSUPPORTED", "`else` on `<" + e.tag + ">` takes no value — it is a bare attribute (§17.1.1)")
        }
        // the host: only an HTML element or a use is wrapped by the chain
        // lowering. `<each>` and `<errors>` refuse the attribute themselves; a
        // refused element has no fact. Anything else would IGNORE it.
        const f: ElemFact | not = elemFactNow(st, e.nid)
        if (f is given && !chainHost(f)) {
            st = chainHostRefused(env, e, ia, st)
            st = chainHostRefused(env, e, ea, st)
            st = chainHostRefused(env, e, la, st)
        }
        return st
    }

    // s451 — `show=` (§17.2) is implemented on an HTML element only
    // (resolveShow). On a USE §17.1.1 lets a component carry it ("An `else` or
    // `else-if=` element MAY also carry `show=`"), but a use has no single
    // element to toggle in the bootstrap (refused in resolveUse, where a field
    // named `show` is told apart); `<*x/>` and `<slot>` read no attributes at
    // all. Each would IGNORE it — refused here. `<each>` and `<errors>`
    // refuse it themselves; a refused element has no fact.
    fn showHostCheck(env: Env, e: AElem, st: AS) -> AS {
        const a: AAttr | not = attrNamed(e.attrs, "show")
        if (a is not) return st
        const f: ElemFact | not = elemFactNow(st, e.nid)
        if (f is not) return st
        if (!showRefusedOn(f)) return st
        let tag: string = e.tag
        if (e.star) tag = "*" + e.tag
        return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`show=` on `<" + tag + ">` is not in the bootstrap — only an HTML element is shown / hidden (§17.2); the attribute would be ignored and the content always visible")
    }

    // s451 fix round (S239 MED) — every reader of an element's scrml attributes
    // matches the name EXACTLY (`if`, `else-if`, `else`, `show`, `on…`,
    // `bind:…`, `as`, `in`, `key`, `of`, `all`, `deps`, `rule`), so a case
    // variant (`SHOW=`, `If=`, `Else-If=`, `onClick=`, `BIND:value`) fell
    // through to a plain HTML attribute and did nothing. The SPEC names no rule
    // for the case of an attribute name (§4, §5, §24 searched; §13.x makes only
    // ELEMENT names case-insensitive), so a case variant of a scrml control
    // name is refused on every element that is not a USE (a use's names are
    // its declaration's field names — case-sensitive, `a` and `A` distinct).
    // `ref=` (§6.7.1a, an element-reference binding) is not in the bootstrap:
    // on an HTML element it would be a plain `ref="…"` attribute — refused.
    // On an HTML element, two names equal up to case are one HTML attribute
    // (HTML attribute names are case-insensitive): the second is a repeat
    // (exact repeats are the parser's, repeatedAttrDiags).
    fn attrCaseDiags(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        const f: ElemFact | not = elemFactNow(st, e.nid)
        if (f is not) return st
        if (isUseFact(f)) return st
        const html: boolean = isHtmlFact(f)
        let seen: string[] = []
        let seenExact: string[] = []
        let tag: string = e.tag
        if (e.star) tag = "*" + e.tag
        for (const a of e.attrs) {
            const lower: string = a.name.toLowerCase()
            if (eventName(lower) != "" && quotedNoInterp(a.value)) {
                // s464 — §5.2 "Quoted event-handler attributes (S464)": a quoted
                // value with no `${…}` on an event-handler attribute (any case)
                // "SHALL be a compile error (E-ATTR-QUOTED-HANDLER)". The
                // bootstrap lowered the lowercase form to an empty listener with
                // no diagnostic (a case variant was E-BOOTSTRAP-UNSUPPORTED).
                st = addDiag(st, env.file, a.span, "E-ATTR-QUOTED-HANDLER", "the quoted `" + a.name + "=\"…\"` attribute on `<" + tag + ">` is an event handler written as a string. scrml does not hand quoted text to the browser to run as JavaScript — an event attribute takes logic, unquoted: a call `" + a.name + "=fn()`, an inline block `" + a.name + "={ … }`, or an expression `" + a.name + "=$" + "{…}` (§5.2, §5.2.3).")
            } else if (lower != a.name && eventName(lower) != "" && (parenValue(a.value) || quotedHasInterp(a.value))) {
                // s462 — §5.2 rule 2 "Event-handler text from data": a case
                // variant of an `on…` name with an EXPRESSION value
                // (`ONCLICK=(@code)`) is a value written as handler text, not a
                // handler — refused, as impl#1 refuses it. (A bare reference or
                // call, `onClick=go(2)`, is a handler form impl#1 wires; the
                // bootstrap does not wire a case variant, so that one stays the
                // case-variant refusal below.) A quoted `${…}` value is the
                // parser's refusal (reported once).
                if (parenValue(a.value)) {
                    st = addDiag(st, env.file, a.span, "E-ATTR-INTERP-EXECUTABLE", "the `" + a.name + "=` attribute on `<" + tag + ">` takes its value from data (an expression), and it would be written as event-handler TEXT, which the browser compiles as JavaScript. JavaScript is never built from data. Write the event attribute in lowercase (`" + lower + "=f(x)`) so it is wired as a listener (§5.2).")
                }
            } else if (lower != a.name && isControlAttrName(lower)) {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on `<" + tag + ">` is a case variant of the scrml attribute `" + lower + "` — the bootstrap reads scrml attribute names exactly, so it would be a plain HTML attribute that does nothing; write `" + lower + "`")
            } else if (html && a.name == "ref") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`ref=` on `<" + tag + ">` (§6.7.1a, an element-reference binding) is not in the bootstrap — it would be emitted as a plain `ref` attribute and bind nothing")
            } else if (html && seen.indexOf(lower) >= 0 && seenExact.indexOf(a.name) < 0) {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is written twice on `<" + tag + ">` (HTML attribute names are case-insensitive) — the bootstrap reads one, so the other would be silently dropped; the SPEC names no rule for a repeated attribute, so it is refused: write it once")
            }
            seen = seen.concat([lower])
            seenExact = seenExact.concat([a.name])
        }
        return st
    }

    // The attribute names a scrml reader of an element dispatches on (lower
    // case): the control attributes, the event prefix `on`, any namespaced
    // `x:y` name (`bind:`, `class:`, `style:`, …).
    fn isControlAttrName(n: string) -> boolean {
        if (n.indexOf(":") >= 0) return true
        if (n.length > 2 && n.substring(0, 2) == "on" && !isNonEventOnWord(n)) return true
        return n == "if" || n == "else-if" || n == "else" || n == "show" || n == "ref" || n == "as" ||
               n == "in" || n == "key" || n == "of" || n == "all" || n == "deps" || n == "rule"
    }

    // =========================================================================
    // s468 — STATIC EXECUTABLE VALUES (SPEC §5.2 "Static executable values
    // (S464)"): "Two static attribute values (no `${…}`) the browser runs
    // without scrml checking them SHALL each be a compile error
    // (E-ATTR-STATIC-EXECUTABLE), reported once per emitted attribute, in every
    // position rule 2 below names":
    //   1. "Any static `srcdoc` (any case)" — "A bare `<iframe srcdoc>` (no
    //      value) is an empty document, runs nothing, and stays legal";
    //   2. "A static navigate / load attribute whose scheme is not admitted" —
    //      ONLY the attributes the browser navigates to or loads, element-scoped
    //      as rule 3 scopes them, and the SVG animation values `to` / `from` /
    //      `by` / `values` "when `attributeName` names one of them or is not a
    //      static string"; the schemes are "rule 2's fail-closed ALLOW-list,
    //      read by the same scheme reader (one definition)" (url.scrml), a
    //      raster `data:image/…` admitted on every attribute that loads an image.
    // "A component call's prop is not an element attribute (judged where the
    // component writes it)" — a use's own attributes are not judged; its slot
    // content is. A declaration's markup is judged once, at the definition.
    // The bootstrap wrote both as the author wrote them (gap
    // g-bootstrap-static-executable-values-not-refused-s464). The decision
    // is url.scrml `classifyStatic` (impl#1's attr-injection-sink.ts
    // `classifyStaticExecutableAttr`), the one decision check.scrml C18 asks too.
    // =========================================================================
    fn staticExecPass(g: Globals, t: Tables) -> Diag[] {
        let out: Diag[] = []
        for (const ds of g.decls) {
            for (const n of declMarkup(ds)) { out = out.concat(staticExecIn(t, ds.file, n, "")) }
        }
        return out
    }

    // `parent`: the tag of the nearest enclosing element ("" — none).
    fn staticExecRows(t: Tables, file: string, rows: ANode[], parent: string) -> Diag[] {
        let out: Diag[] = []
        for (const r of rows) { out = out.concat(staticExecIn(t, file, r, parent)) }
        return out
    }

    fn staticExecIn(t: Tables, file: string, n: ANode, parent: string) -> Diag[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> staticExecElem(t, file, e, parent)
            .Text(text: x) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Css(c: c) :> []
            .Gather(f: lf) :> staticExecRows(t, file, gatherRows(lf), parent)
            .Effect(w: w) :> []
        }
    }

    fn staticExecElem(t: Tables, file: string, e: AElem, parent: string) -> Diag[] {
        let out: Diag[] = []
        // only an HTML element writes its attributes into output: a use's are
        // props, and `<db src=…>`, `<each>`, `<errors>`, `<slot>`, a state view
        // and `<*x>` emit none of their own
        if (isHtmlFact(elemFact(t.elems, e.nid))) {
            const ua: UrlAttr[] = urlAttrsOf(e.attrs)
            for (const a of e.attrs) {
                const value: string | not = staticQuotedText(a.value)
                if (value is given) {
                    const sink: StaticSink | not = classifyStatic(e.tag, a.name, value, ua, parent, true)
                    if (sink is given) out = out.concat([newDiag("E-ATTR-STATIC-EXECUTABLE", staticExecMessage(sink, a.name, e.tag), file, a.span)])
                }
            }
        }
        for (const kid of e.kids) { out = out.concat(staticExecIn(t, file, kid, e.tag)) }
        return out
    }

    // The attributes as url.scrml's decision reads them: a quoted value with
    // no `${…}` is static text; a presence attribute has none; anything else
    // (an expression, a reference, a call, a quoted `${…}`) is computed.
    fn urlAttrsOf(attrs: AAttr[]) -> UrlAttr[] {
        let out: UrlAttr[] = []
        for (const a of attrs) {
            const s: string | not = staticQuotedText(a.value)
            const computed: boolean = s is not && !isNoValue(a.value)
            out = out.concat([{ name: a.name, text: s, computed: computed }])
        }
        return out
    }

    // The static text of a quoted value with no `${…}` (`not` — any other value).
    fn staticQuotedText(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> staticQuoted(s)
            .NoValue :> not
            .Bare(e: x) :> not
            .Paren(e: x) :> not
            .Braced(b: b) :> not
        }
    }

    fn staticQuoted(s: string) -> string | not {
        if (s.indexOf("$" + "{") >= 0) return not
        return s
    }

    fn isBracedValue(v: AAttrValue) -> boolean {
        return match v {
            .Braced(b: b) :> true
            .NoValue :> false
            .Quoted(v: s) :> false
            .Bare(e: x) :> false
            .Paren(e: x) :> false
        }
    }

    fn isUseFact(f: ElemFact) -> boolean {
        return match f {
            .MUse(decl: d) :> true
            .MHtml :> false
            .MEach(bind: b) :> false
            .MErrors(of: x) :> false
            .MSlot :> false
            .MDb :> false
            .MStateView(v: v) :> false
            .MInline(v: v) :> false
            .MStar(decl: d) :> false
        }
    }

    fn showRefusedOn(f: ElemFact) -> boolean {
        return match f {
            .MHtml :> false
            .MUse(decl: d) :> false           // resolveUse: a field named `show` constructs; else refused there
            .MEach(bind: b) :> false          // refuses `show` itself (resolveEach)
            .MErrors(of: x) :> false          // refuses it itself (resolveErrors)
            .MSlot :> true
            .MDb :> true
            .MStateView(v: v) :> true
            .MInline(v: v) :> true
            .MStar(decl: d) :> true
        }
    }

    fn chainCondValue(env: Env, e: AElem, a: AAttr | not, st: AS) -> AS {
        if (a is not) return st
        if (valueExpr(a.value) is given) return st
        return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` on `<" + e.tag + ">` needs a condition expression — `" + a.name + "=@x` or `" + a.name + "=(@n >= 3)`; a quoted, valueless or braced condition is not in the bootstrap (§17.1, §5.2) — it would render the element unconditionally")
    }

    fn chainHostRefused(env: Env, e: AElem, a: AAttr | not, st: AS) -> AS {
        if (a is not) return st
        let tag: string = e.tag
        if (e.star) tag = "*" + e.tag
        return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on `<" + tag + ">` is not in the bootstrap — only an HTML element or a use of a declaration is conditionally rendered (§17.1); the attribute would be ignored and the element always rendered")
    }

    fn chainHost(f: ElemFact) -> boolean {
        return match f {
            .MHtml :> true
            .MUse(decl: d) :> true
            .MEach(bind: b) :> true          // refuses `if=` / `else-if=` / `else` itself (resolveEach)
            .MErrors(of: x) :> true          // refuses them itself (resolveErrors)
            .MSlot :> false
            .MDb :> false
            .MStateView(v: v) :> false
            .MInline(v: v) :> false
            .MStar(decl: d) :> false
        }
    }

    // The element fact recorded so far for `nid` (the dense index is built
    // after resolution, so this scans).
    fn elemFactNow(st: AS, nid: int) -> ElemFact | not {
        const t: ElemTable = st.facts.elems
        let i: int = t.nids.length - 1
        while (i >= 0) {
            if (t.nids[i] == nid) return t.facts[i]
            i = i - 1
        }
        return not
    }

    // An element's condition attribute: its `if=`, else its `else-if=` (the
    // condition its branch is shown under; an `else` branch has none).
    fn condAttrOf(attrs: AAttr[]) -> AAttr | not {
        const a: AAttr | not = attrNamed(attrs, "if")
        if (a is given) return a
        return attrNamed(attrs, "else-if")
    }

    fn isChainAttr(name: string) -> boolean {
        return name == "if" || name == "else-if" || name == "else"
    }

    fn resolveNode(env: Env, n: ANode, st: AS) -> AS {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> resolveElem(env, e, st)
            .Text(text: t) :> st
            .Interp(e: e) :> resolveExpr(env, e, not, st).st
            .DeclNode(d: d) :> addDiag(st, env.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "a declaration inside markup is not in bootstrap slice M2")
            .Css(c: c) :> st
            .Effect(w: w) :> resolveEffect(env, w, st)
            .Gather(f: lf) :> resolveTier0(env, n, lf, st)                 // s469 (§17.4)
        }
    }

    fn isChildRole(r: FieldRole) -> boolean {
        return match r {
            .Child :> true
            .Attribute :> false
        }
    }

    fn resolveElem(env: Env, e: AElem, st0: AS) -> AS {
        // s473 — §17.4: a bare control-flow statement in a markup body
        // (E-CONTROL-FLOW-IN-MARKUP). `<pre>` / `<code>` bodies are display
        // text (§4.17); a `<db>` body is a code-default body (§4.18.1).
        let st: AS = st0
        if (!e.star && e.tag != "pre" && e.tag != "code" && e.tag != "db") st = controlFlowInMarkup(env, e.kids, st)
        if (e.star) return resolveStar(env, e, st)
        if (e.tag == "each") return resolveEach(env, e, st)
        if (e.tag == "slot") return resolveSlot(env, e, st)
        // A user declaration in scope wins over every built-in reading of the
        // tag — HTML and (r2 F2) the structural-refusal list alike.
        const d: DeclSrc | not = declNamed(env.g, env.file, e.tag)
        // s472: a declaration of another file that is not in scope here is not
        // an unknown HTML element (that would render it silently empty) — the
        // tag names it, so it is refused by name, saying where it is declared
        if (d is not && declAnywhere(env.g, e.tag)) {
            return addDiag(resolveNodes(env, e.kids, st), env.file, e.span, "E-SCOPE-001", "`<" + e.tag + ">` is not declared" + elsewhereNote(env.g.te.link, env.file, NameKind.KDecl, false, e.tag))
        }
        if (d is given) {
            // O55 RULED (bryan S442): a plain use of a `single` declaration is an
            // error; `<*x/>` is the only way to render it (§66.13.3).
            if (d.info.single) return singleInstantiated(env, e, st)
            return resolveUse(env, e, d, st)
        }
        // the same for a program cell declared `single` (§66.19.6 `<phase/>`)
        const sd: ADecl | not = singleProgramField(env, e.tag)
        if (sd is given) return singleInstantiated(env, e, st)
        // s449 — `<errors of=…/>` (§55.8), when no declaration takes the name
        if (e.tag == "errors") return resolveErrors(env, e, st)
        // s452 — `<db src=…>` (§4 state block; §8.1.1 database scope)
        if (e.tag == "db") return resolveDb(env, e, st)
        // s444 (PA): a scrml STRUCTURAL element the bootstrap does not
        // implement is never an HTML element (§4.15, §24.4 "These element names
        // SHALL NOT be treated as HTML elements") — refused, not rendered as
        // markup (it used to fall through to MHtml with no diagnostic). Only
        // when no declaration of that name is in scope (above).
        const owner: string = structuralOwner(e.tag)
        if (owner != "") {
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + e.tag + ">` is a scrml structural element (" + owner + "), not an HTML element (§4.15, §24.4) — it is not in the bootstrap")
        }
        // s473 — §4.1: "A name that is not a known HTML element and not a
        // defined component SHALL be a compile error (E-MARKUP-001)". It used to
        // be emitted as an inert unknown element, with no diagnostic (gap
        // g-bootstrap-unknown-tags-resolved-as-html). A bare tag naming a field
        // of the enclosing declaration is E-DECL-FIELD-TAG-NEEDS-STAR instead
        // (resolveHtml) — one report per fault. So is an element the PARSER has
        // already refused (a parse error inside its span: the nameless recovery
        // after E-PARSE-TAG "expected a tag name", `<program>` inside markup —
        // E-PARSE-PROGRAM —, a misplaced `<host>` — E-HOST-BINDING-PLACEMENT),
        // and a name imported from a module that resolves to nothing (that
        // import's refusal). Each of those is an error already, so the compile
        // is refused either way: never fail-open.
        // A CAPITALISED tag is an element only when its lowercase form is an HTML
        // element name (`<DIV>` is `<div>`, §4.3) — never by folding onto an
        // SVG / MathML name: `<Unknown/>` (SVG legacy `unknown`), `<Set/>`,
        // `<View/>`, `<Filter/>` are undeclared components, E-COMPONENT-035
        // (S473 #1678 review F1; #1675's isCapitalTag rule).
        // s473 (boot-failclosed-sql-protect, #1675) — a CAPITALIZED tag that names no
        // declaration is never HTML. Its worst reading: a §52.3 state type
        // declaration — `<User authority="server" table="users" protect="passwordHash">`
        // + a field list — which the bootstrap does not model; rendered as an HTML
        // element its `protect=` was DROPPED and the protected column served to the
        // client (§14.8.9; audit S473 probe s148/t10). Refused, never rendered: with a
        // §52 attribute it is named as that declaration (E-BOOTSTRAP-UNSUPPORTED);
        // without one, as an undeclared component (E-COMPONENT-035). Its attributes
        // are not judged again (one report per fault). A field tag / parser-refused /
        // unresolved-import tag keeps its own report (below).
        if (isCapitalTag(e.tag) && !namesOwnField(env, e.tag) && !unknownExcused(env, e)) return addDiag(resolveNodes(env, e.kids, st), env.file, e.span, capitalTagCode(e), capitalTagWhy(e))
        if (!markupElementName(e.tag) && !namesOwnField(env, e.tag)) {
            if (unknownExcused(env, e)) return resolveHtml(env, e, st)
            return unknownElement(env, e, st)
        }
        return resolveHtml(env, e, st)
    }

    // s473 (#1678 review F9) — an unquoted value that reads as a hyphenated word
    // (`class=foo-bar`) is a subtraction of names; the parser left it here
    // (ast isHyphenWordExpr). Its names resolving to nothing is already
    // E-SCOPE-001; when they all resolve, it is E-ATTR-UNQUOTED-OPERATOR (§5.2:
    // an unquoted value holds no operator) — one report per fault.
    fn hyphenWordValue(env: Env, a: AAttr, before: int, st: AS) -> AS {
        const v: AAttrValue = a.value
        const x: AExpr | not = match v {
            .Bare(e: e) :> e
            .NoValue :> not
            .Paren(e: e) :> not
            .Quoted(v: s) :> not
            .Braced(b: b) :> not
        }
        if (x is not || !isHyphenWordExpr(x)) return st
        const k: AExprK = x.k
        const binary: boolean = match k {
            .Name(name: n) :> false
            .Binary(op: o) :> true
            .Recovered :> false
            .Sql(q: q) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: s) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Handled(h: h) :> false
        }
        if (!binary) return st
        let i: int = before
        while (i < st.diags.length) {
            if (st.diags[i].code == "E-SCOPE-001") return st
            i = i + 1
        }
        return addDiag(st, env.file, a.span, "E-ATTR-UNQUOTED-OPERATOR", "`" + a.name + "=…` — this unquoted value is a subtraction (`-` between names), and an unquoted attribute value holds no operator: it is an identifier, a member chain or a call (§5.1, §5.2). Quote a literal (`" + a.name + "=\"a-b\"`) or parenthesize an expression")
    }

    // s473 — an unknown element whose fault is already reported elsewhere (see resolveElem).
    fn unknownExcused(env: Env, e: AElem) -> boolean {
        return e.tag == "" || hasErrIn(fileErrs(env.g.files, env.file), e.span) || importsNameUnresolved(env.g.files, env.file, e.tag)
    }

    // #1675 — a capitalized tag that is not a case variant of an HTML element
    // (HTML tag names are case-insensitive: `<FORM>` is `<form>`). The HTML list is
    // elements.scrml's (one list, #1678 F2).
    fn isCapitalTag(tag: string) -> boolean {
        const c: string = tag.substring(0, 1)
        return c != "" && "ABCDEFGHIJKLMNOPQRSTUVWXYZ".indexOf(c) >= 0 && !isHtmlElementName(tag)
    }

    // #1675 — `protect=` / `authority=` / `table=`: the §52.3.1 state-type attributes
    fn stateTypeAttr(e: AElem) -> string {
        for (const a of e.attrs) {
            const n: string = a.name.toLowerCase()
            if (n == "protect" || n == "authority" || n == "table") return a.name
        }
        return ""
    }

    fn capitalTagCode(e: AElem) -> string {
        if (stateTypeAttr(e) != "") return "E-BOOTSTRAP-UNSUPPORTED"
        return "E-COMPONENT-035"
    }

    fn capitalTagWhy(e: AElem) -> string {
        const a: string = stateTypeAttr(e)
        if (a != "") return "`<" + e.tag + " " + a + "=…>` is a §52.3 state type declaration (`authority=` / `table=` / `protect=` and a field list), which is not in the bootstrap — refused, never rendered as an HTML element: its `protect=` would be dropped and the protected fields served to the client (§14.8.9). Keep secret columns out of the `SELECT` list of every query that answers the client"
        return "`<" + e.tag + ">` names no declaration in scope — a capitalized tag is a component or a §52.3 state type declaration, never an HTML element (§15.14.2: an unresolved component is E-COMPONENT-035). Declare `" + e.tag + "`, import it, or write the HTML element in lower case"
    }

    // s473 — a tag that names a registry element (§4.1, §24.1): lowercase-initial
    // → any HTML / SVG / MathML / custom element name; capitalised → only an
    // HTML element name, case-folded (review F1).
    fn markupElementName(tag: string) -> boolean {
        const first: string = tag.substring(0, 1)
        if (first != "" && first != first.toLowerCase()) return isHtmlElementName(tag)
        return isKnownElementName(tag)
    }

    // s473 — an element attribute that is a scrml directive the bootstrap does
    // not carry: refused by name, never written to the DOM ("" = not one).
    //  - `fixed` — RETIRED (ruling S473 D26): it used to leak as `fixed=""`.
    //  - `protect=` / `authority=` — §14.8.9 / §52 confidentiality and authority
    //    controls the bootstrap does not enforce (ruling S473 D2: "so is any
    //    element carrying protect= / authority= that the bootstrap doesn't
    //    enforce"; S473 D1: refuse rather than drop a guarantee). On an HTML or
    //    custom element they would be written out as plain attributes, the
    //    guarantee silently gone.
    fn refusedDirectiveAttr(name: string, tag: string) -> string {
        const n: string = name.toLowerCase()
        if (n == "fixed") return "`fixed` on `<" + tag + ">` is retired (ruling S473 D26 — §15.7's non-overridable subtree has no meaning under §66, where a use cannot override a `renders` element, §66.6.9); remove it. It is not an HTML attribute and is never written to the page"
        if (n == "protect" || n == "authority") return "`" + name + "=` on `<" + tag + ">` is a scrml " + (n == "protect" ? "confidentiality" : "authority") + " control (§14.8.9, §52) that the bootstrap does not enforce — refused, never dropped (ruling S473 D1 / D2): written out as a plain attribute it would guarantee nothing"
        return ""
    }

    // s473 — a bare tag that names a child field of the enclosing declaration —
    // the program's cells included (R4: they are the program's fields), except a
    // program cell spelled like a markup element. RULED (bryan, user-voice S473
    // "review-surfaced decisions" item 3): that collision is refused at the
    // CELL (E-DECL-ELEMENT-NAME-COLLIDES, namedInstanceDiags), so the tag is not
    // reported a second time here — one report per fault. Inside a user
    // declaration the field reading has always won (and still does).
    fn namesOwnField(env: Env, tag: string) -> boolean {
        const cd: DeclSrc | not = ctxDecl(env)
        if (cd is not) return false
        const i: int = fieldIndex(cd.info, tag)
        if (i < 0 || !isChildRole(cd.info.fields[i].role)) return false
        return !cd.isProgram || !markupElementName(tag)
    }

    // s473 — an element name that resolves to nothing (§4.1, §24.1). §34's
    // retired E-STATE-001 row: "a PascalCase name surfaces as E-COMPONENT-035,
    // a lowercase-HTML name as E-MARKUP-001". Its attributes and children are
    // still resolved (as an element's), so their own faults are reported too.
    fn unknownElement(env: Env, e: AElem, st0: AS) -> AS {
        const first: string = e.tag.substring(0, 1)
        let st: AS = st0
        if (first != first.toLowerCase()) {
            st = addDiag(st, env.file, e.span, "E-COMPONENT-035", "`<" + e.tag + ">` names no declaration in scope — nothing of that name is declared or imported here, so it would be emitted as an inert, unknown element (§15.14, §4.1). Declare it (`<" + e.tag + " …/>` with a `renders` clause) or import it")
        } else {
            st = addDiag(st, env.file, e.span, "E-MARKUP-001", "`<" + e.tag + ">` is not an HTML, SVG or MathML element, a custom element (a lowercase name holding a hyphen, `<my-widget>`), or a declaration in scope (§4.1, §24.1) — it would be emitted as an inert, unknown element. Check the spelling, or declare it")
        }
        return resolveHtml(env, e, st)
    }

    // s473 — §17.4 "The `${ ... }` wrapper is mandatory (S203)": "A bare
    // control-flow statement written directly in a markup body (no surrounding
    // `${ ... }`) … is E-CONTROL-FLOW-IN-MARKUP". §34's row: "`for (...) { ... }`,
    // `if (...) { ... }`, or `while (...) { ... }`" — the BRACED forms (S383: the
    // `{` is the whole discriminator between code and prose; the braceless
    // hole stays open, as on impl#1). The bootstrap shipped the statement as
    // page text and rendered the markup it gated UNCONDITIONALLY (probe
    // p17-cfmarkup2: `<div> if (@flag) { <p>secret</p> } </div>`). impl#1's
    // recognizer (ast-builder.js BARE_CONTROL_FLOW_IN_MARKUP_RE) is applied to
    // each text run of the body: a run starts at a text node that opens the body
    // or follows an element, and runs through text and `${…}` interpolations up
    // to the next element. One report per run.
    fn controlFlowInMarkup(env: Env, kids: ANode[], st0: AS) -> AS {
        let st: AS = st0
        let run = ""
        let runSpan: ASpan = mkSpan(0, 0)
        let inRun = false
        let i: int = 0
        while (i <= kids.length) {
            let piece = ""
            let isText = false
            if (i < kids.length) {
                const k: ANodeK = kids[i].k
                const t: string | not = textRunPiece(k)
                if (t is given) {
                    isText = true
                    piece = t
                }
            }
            if (isText) {
                if (!inRun) {
                    inRun = true
                    run = ""
                    runSpan = kids[i].span
                }
                run = run + piece
            } else if (inRun) {
                const kw: string = controlFlowHead(run)
                if (kw != "") st = addDiag(st, env.file, runSpan, "E-CONTROL-FLOW-IN-MARKUP", "a bare `" + kw + " … { … }` statement in a markup body is not logic — it would be written into the page as text, and the markup inside its braces would render unconditionally. Control flow in markup lives in a `$" + "{ … }` logic block (§17.4, §7) — `$" + "{ for (x of @items) { lift <li>$" + "{x}</li>; } }` — or is an `if=` on the element (§17.1), or `<each in=@items>` (§17.7)")
                inRun = false
            }
            i = i + 1
        }
        return st
    }

    // A node's text in a markup text run: a text node's text; an interpolation
    // stands for a value. `not` for a node that ends the run (an element, …).
    fn textRunPiece(k: ANodeK) -> string | not {
        return match k {
            .Text(text: t) :> t
            .Interp(e: x) :> ""
            .Elem(e: x) :> not
            .DeclNode(d: d) :> not
            .Css(c: c) :> not
            .Effect(w: w) :> not
            .Gather(f: f) :> not
        }
    }

    // The control-flow statement a markup text run holds, by its keyword ("" =
    // none). §17.4 / §34 E-CONTROL-FLOW-IN-MARKUP: control flow in a markup body
    // is logic; S383: the `{` is the whole discriminator between code and prose,
    // so every form here needs its brace. impl#1's recognizer
    // (BARE_CONTROL_FLOW_IN_MARKUP_RE) anchors at the run start; this one finds
    // the statement ANYWHERE in the run (#1678 review F4: `Hello. if (@f) {
    // <p>secret</p> }` rendered `<p>` unconditionally), at a word boundary:
    //   `for` / `while` / `if` / `switch` `(…)` then `{` after a `)`;
    //   `else {`, `else if (…) {`, `do {`;
    //   `match @x … {` / `match (…) … {` (§18 — a subject, then its arms' brace).
    // An interpolation stands for nothing in the run (textRunPiece), so
    // `if (@a) ${…} {` is caught too. Prose with no brace after the head —
    // "Tap if (and only if) ready" — is never refused.
    fn controlFlowHead(t: string) -> string {
        let i: int = 0
        while (i < t.length) {
            if (i == 0 || !isWordChar(t.substring(i - 1, i))) {
                const kw: string = cfKeywordAt(t, i)
                if (kw != "" && cfStatementAt(t, i + kw.length, kw)) return kw
            }
            i = i + 1
        }
        return ""
    }

    fn cfKeywordAt(t: string, i: int) -> string {
        for (const kw of ["switch", "while", "match", "else", "for", "if", "do"]) {
            const j: int = i + kw.length
            if (t.substring(i, j) == kw && (j >= t.length || !isWordChar(t.substring(j, j + 1)))) return kw
        }
        return ""
    }

    // After the keyword `kw` (ending at `j0`): does its braced statement follow?
    fn cfStatementAt(t: string, j0: int, kw: string) -> boolean {
        const j: int = skipBlank(t, j0)
        if (j >= t.length) return false
        const c: string = t.substring(j, j + 1)
        if (kw == "else") {
            if (c == "{") return true
            if (cfKeywordAt(t, j) == "if") return cfStatementAt(t, j + 2, "if")
            return false
        }
        if (kw == "do") return c == "{"
        if (kw == "match") {
            if (c != "@" && c != "(") return false
            return t.indexOf("{", j) >= 0
        }
        if (c != "(") return false
        let k: int = t.indexOf(")", j + 1)
        while (k >= 0) {
            const m: int = skipBlank(t, k + 1)
            if (m < t.length && t.substring(m, m + 1) == "{") return true
            k = t.indexOf(")", k + 1)
        }
        return false
    }

    fn skipBlank(t: string, from: int) -> int {
        let m: int = from
        while (m < t.length && t.substring(m, m + 1).trim() == "") { m = m + 1 }
        return m
    }

    // A regex `\w` character.
    fn isWordChar(c: string) -> boolean {
        return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"
    }

    // s452 — a `<db src=…>` state block. §4: "A state block is a first-class
    // context" — s472 (S472 ruling Q3, §4.18.1): its body is a code-default
    // ITEM body, read by the parser (parseDbBody): `e.kids` holds its markup
    // and display literals; its functions and types were hoisted into the
    // program's items (FileAst.dbFns keeps their block); its declarations and
    // statements were refused there. §8.1.1: a `<db src=>` is a
    // database scope for the `?{}` blocks inside it (placePass's dbsPass
    // resolves which database every query runs on, and checks `src=` —
    // E-SQL-005). It is not an HTML element: its children render in place.
    // Its other attributes are REFUSED, never ignored: `tables=` generates
    // types (§14.8.4) and `protect=` keeps columns off the client (§14.8.9 — a
    // confidentiality control), neither in the bootstrap.
    fn resolveDb(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        let src = false
        for (const a of e.attrs) {
            if (a.name == "src") {
                src = true
            } else if (isChainAttr(a.name) || a.name == "show") {
                // s452 r2 (NIT): `if=` / `else-if=` / `else` / `show=` are judged —
                // and refused on a `<db>` — by the chain and `show=` rules (MDb is
                // no chain host, show= is refused on it): one report, not two
            } else if (a.name == "tables") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<db tables=…>` generates a type per table from the schema (§14.8.4), which is not in the bootstrap — it would be ignored")
            } else if (a.name == "protect") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<db protect=…>` keeps the named columns off the client (§14.8.9), which is not in the bootstrap — a confidentiality control is refused, never ignored")
            } else {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` on `<db>` is not in the bootstrap (it takes `src=`, §8.1.1) — it would be ignored")
            }
        }
        if (!src) st = addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a `<db>` without `src=` names no database (§8.1.1: a database scope is a `<db src=>`) — the bootstrap has no other reading of it")
        // s472 r1 (MED-1): a function declared in this body is the PROGRAM's
        // function (the parser hoists it — the program-wide reading, pending
        // bryan's ruling on db-body function visibility). Where this `<db>` stands
        // inside a scope that binds names — an `<each>` row, a loop or arm binder,
        // a component's `renders` / body, an engine state child, a child field's
        // renders — the hoisted function would silently lose those names (or bind
        // the program's of the same spelling), so it is refused, fail closed,
        // under either reading of the ruling.
        const where: string = nameScopeHere(env)
        if (where != "") {
            for (const id of dbOwnedFns(env.g, env.file, e.nid)) {
                st = addDiag(st, env.file, id.span, "E-BOOTSTRAP-UNSUPPORTED", dbNestedWhy(id, where))
            }
        }
        return addElem(resolveNodes(env, e.kids, st), e.nid, ElemFact.MDb)
    }

    // s472 r1 — the name-binding scope this position stands in ("" — the
    // program body or plain markup under it, where a hoisted function loses nothing).
    fn nameScopeHere(env: Env) -> string {
        if (env.rows.length > 0) return "an `<each>` row (its row binder)"
        if (env.locals.length > 0) return "a loop or arm body (its binders)"
        if (env.own != "") return "a child field's `renders` (`@" + env.own + "` and the instance's fields)"
        const k: CtxK = env.ctx
        const inProgram: boolean = match k {
            .InDecl(owner: o, isProgram: p) :> p
            .InFn :> false
        }
        if (!inProgram) return "a declaration's `renders` or state-child body (a component's or an engine's fields)"
        return ""
    }

    // s472 r1 — every `<db>` element in a program-level engine's state-child
    // body (through plain markup; an `<each>` row or a Tier-0 row is judged by
    // resolveDb itself, which sees its binders): its functions are refused.
    fn refuseStateChildDbFns(g: Globals, file: string, nodes: ANode[], st0: AS) -> AS {
        let st: AS = st0
        for (const n of nodes) {
            const e: AElem | not = elemOfANode(n)
            if (e is given) {
                if (!e.star && e.tag == "db") {
                    for (const f of dbOwnedFns(g, file, e.nid)) {
                        st = addDiag(st, file, f.span, "E-BOOTSTRAP-UNSUPPORTED", dbNestedWhy(f, "an engine state child"))
                    }
                }
                if (e.star || e.tag != "each") st = refuseStateChildDbFns(g, file, e.kids, st)
            }
        }
        return st
    }

    // Why a db-body function (or s473: a db cell, by its load `@name`) in a `<db>`
    // nested inside the name-binding scope `where` is refused. A db cell is the
    // PROGRAM's cell (hoisted, as a db-body function is): one for the whole program,
    // not one per row / instance / state, and its value would lose the scope's names
    // — the Lane A pattern (S472 "functions in a `<db>` body: visibility").
    fn dbNestedWhy(f: AFn, where: string) -> string {
        if (isLoadName(f.name)) return "a `<db>` cell (`" + f.name + "`) declared in a `<db>` that stands inside " + where + " is not in the bootstrap — a `<db>` cell is the program's cell (hoisted to program scope, §8.1.3), so there would be ONE for the whole program, not one per row or instance, and its value would lose the names " + where + " binds. Declare the cell in a `<db>` at the `<program>` level"
        return "a function in a `<db>` body that stands inside " + where + " is not in the bootstrap — a `<db>`-body function is the program's function (hoisted to program scope), so it would lose the names " + where + " binds (or bind the program's names of the same spelling). Declare the function in a `<db>` at the `<program>` level, or pass the values it needs as arguments"
    }

    // The functions the parser hoisted out of the `<db>` element `dbNid`'s body.
    fn dbOwnedFns(g: Globals, file: string, dbNid: int) -> AFn[] {
        let ids: int[] = []
        for (const f of g.files) {
            if (f.path == file) {
                for (const o of f.dbFns) { if (o.db == dbNid) ids = ids.concat([o.fn]) }
            }
        }
        let out: AFn[] = []
        for (const fs of g.fns) {
            if (ids.indexOf(fs.f.nid) >= 0) out = out.concat([fs.f])
        }
        return out
    }

    // s449 — `<errors of=expr/>` (§55.8): "`of=expr` REQUIRED — References a
    // per-field cell (`@signup.name`), a compound cell (`@signup`), or a
    // validated top-level value (`@email`)"; `all` (optional flag) renders
    // the full array. `of=` missing → E-ERRORS-001; not a `@`-rooted
    // reference to one of those → E-ERRORS-002; a top-level value with no
    // validators has no surface → E-VALIDITY-NO-SURFACE (§55.8, the S442 (5)
    // read rule applied to the convention). The body override (`<errors
    // of=…>${(err) => …}</>`) is not in the bootstrap — refused, never
    // dropped. Any other attribute is refused (it would be ignored).
    fn resolveErrors(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        let of: AAttr | not = not
        let all = false
        for (const a of e.attrs) {
            if (a.name == "of") {
                of = a
            } else if (a.name == "all" && isNoValue(a.value)) {
                all = true
            } else {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is not an attribute of `<errors>` — it takes `of=` and the `all` flag (§55.8); it would be ignored")
            }
        }
        for (const k of e.kids) {
            if (!blankNode(k)) {
                return addDiag(st, env.file, k.span, "E-BOOTSTRAP-UNSUPPORTED", "a body inside `<errors of=…>` (the §55.8 body override) is not in the bootstrap — it would be dropped silently; write `<errors of=…/>` (the default rendering)")
            }
        }
        if (of is not) return addDiag(st, env.file, e.span, "E-ERRORS-001", "`<errors>` needs `of=` — the value whose errors it renders: `<errors of=@signup.email/>` (§55.8)")
        const x: AExpr | not = valueExpr(of.value)
        if (x is not || !isReactiveRoot(placeRoot(x))) {
            return addDiag(st, env.file, of.span, "E-ERRORS-002", "`<errors of=…>` takes a `@`-rooted reference — a field (`@signup.email`), a declaration (`@signup`) or a validated top-level value (`@email`) (§55.8)")
        }
        const r: RX = resolveExpr(env, x, not, st)
        if (r.st.diags.length > st.diags.length) return r.st
        const nf: NameFact | not = nameFactIn(r.st, x.nid)
        const where: int = fieldReadKind(env, nf)
        const fv: ValidityOf | not = fieldValidity(nf)
        if (fv is given) {
            if (where == 2 && fieldValidatorsRefused(env, fv)) return r.st
            if (where == 2 && !fieldCarriesValidators(env, fv)) {
                return addDiag(r.st, env.file, of.span, "E-VALIDITY-NO-SURFACE", "`<errors of=" + exprLabel(x) + "/>` — `" + exprLabel(x) + "` is a top-level value that carries no validators, so it has no validity surface and no `errors` (§55.5.1 rule 2, §55.8)")
            }
            return addElem(r.st, e.nid, ElemFact.MErrors(fv, all))
        }
        const dv: ValidityOf | not = declValidity(env, nf)
        if (dv is given) return addElem(r.st, e.nid, ElemFact.MErrors(dv, all))
        return addDiag(r.st, env.file, of.span, "E-ERRORS-002", "`<errors of=" + exprLabel(x) + "/>` — `" + exprLabel(x) + "` is not a field, a declaration or a validated top-level value, so it has no `errors` (§55.8)")
    }

    fn isNoValue(v: AAttrValue) -> boolean {
        return match v {
            .NoValue :> true
            .Bare(e: x) :> false
            .Paren(e: x) :> false
            .Quoted(v: s) :> false
            .Braced(b: b) :> false
        }
    }

    // An instance of a USER declaration → its compound surface (§55.5).
    fn declValidity(env: Env, nf: NameFact | not) -> ValidityOf | not {
        return match nf {
            .NInst(decl: d, inst: i) :> userCompound(env, d, i)
            .NField(decl: d) :> not
            .NLocal(sym: s) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            .NConst(sym: s) :> not
            not :> not
        }
    }

    fn userCompound(env: Env, d: Sym, i: InstRef) -> ValidityOf | not {
        if (d.id == env.g.program.id) return not
        return ValidityOf.OfDecl(d, i)
    }

    // s449 (from U0 review r2 N2): `<slot>` CONTENT (fallback for a use with no
    // children). SPEC §66.15.2 rules only "use-site children → `<slot/>`" and
    // says nothing of content written inside `<slot>…</slot>`; Core `View.Slot`
    // carries no fallback. It used to be dropped unvisited — an effect there
    // never ran, an unresolved `${@nope}` raised nothing. Fail closed: any
    // content other than whitespace is refused.
    // s473 (ruled refusals) — §66.15.2 slot multiplicity (S473 D11), rules 2
    // and 3 (rule 1 is the use's — resolveUse): "More than one unnamed slot — a
    // declaration's `renders` holds more than one unnamed `<slot/>`:
    // E-COMPONENT-020" (s474 F7: counted per render path — reported at each
    // slot some path reaches with a slot already rendered, excessSlotsIn); "A slot outside
    // `renders` — a `<slot/>` anywhere but inside a declaration's `renders` (a
    // program or page body, a plain markup body, a declaration body outside
    // `renders`): E-DECL-SLOT-OUTSIDE-RENDERS". A slot is inside a renders when
    // it is one of the `<slot/>`s of the enclosing declaration's own `renders`
    // element (slotsIn) — the program has none, and a state-child body or a
    // child field's renders is not the declaration's. A NAMED slot
    // (`<slot name=…>`) is ⚑ O9 (§66.15.2, not ruled): refused, never read as
    // the unnamed one.
    fn resolveSlot(env: Env, e: AElem, st0: AS) -> AS {
        // s473 (#1678 review F6) — S473 D1 / D2 / D26 hold on `<slot>` too: a
        // `protect=` / `authority=` / `fixed` here was dropped silently.
        let st: AS = st0
        for (const a of e.attrs) {
            const directive: string = refusedDirectiveAttr(a.name, e.tag)
            if (directive != "") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", directive)
            } else if (a.name.toLowerCase() == "name") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "a named slot (`<slot name=…>`) is ⚑ O9 (§66.15.2: named and parametric slots are not ruled) — not in the bootstrap; it would be read as the unnamed `<slot/>`. Use one unnamed `<slot/>`")
            }
        }
        // a named slot is refused above (O9) — one code for it, not a second (#1690 review F6)
        if (namedSlot(e)) return addElem(st, e.nid, ElemFact.MSlot)
        let own: int[] = []
        let looped: int[] = []
        let excess: int[] = []
        const cd: DeclSrc | not = ctxDecl(env)
        if (cd is given && !cd.isProgram) {
            own = slotsIn(rendersNodes(cd))
            looped = loopSlotsIn(rendersNodes(cd))
            excess = excessSlotsIn(rendersNodes(cd))
        }
        const at: int = own.indexOf(e.nid)
        if (looped.indexOf(e.nid) >= 0) {
            // #1690 review F6: a `<slot/>` lifted in a loop of the renders is inside it — and renders once per row
            st = addDiag(st, env.file, e.span, "E-COMPONENT-020", "a `<slot/>` inside a loop of this `renders` (a `${ for … lift }` or an `<each>` row) — a use's content would render once per row (§66.15.2 rule 2, S473 D11). Place the `<slot/>` outside the loop")
        } else if (at < 0) {
            st = addDiag(st, env.file, e.span, "E-DECL-SLOT-OUTSIDE-RENDERS", "`<slot/>` stands outside a declaration's `renders` — it names no use, so it would render nothing (§66.15.2 rule 3, S473 D11). A slot marks where a USE's content goes; put it inside the `renders` of the declaration whose uses carry content")
        } else if (excess.indexOf(e.nid) >= 0) {
            st = addDiag(st, env.file, e.span, "E-COMPONENT-020", "a second unnamed `<slot/>` on one render path of this `renders` — a use's content would render once per slot (§66.15.2 rule 2, S473 D11). Keep one `<slot/>` per path: one in each branch of an `if=` / `else-if=` / `else` chain is legal, because only one branch renders (S474 F7)")
        }
        for (const k of e.kids) {
            if (!blankNode(k)) {
                return addElem(addDiag(st, env.file, k.span, "E-BOOTSTRAP-UNSUPPORTED", "content inside `<slot>…</slot>` (fallback content for a use with no children) is not in the bootstrap — SPEC §66.15.2 rules only `<slot/>`; the content would be dropped silently. Write `<slot/>` and render a default outside it"), e.nid, ElemFact.MSlot)
            }
        }
        return addElem(st, e.nid, ElemFact.MSlot)
    }

    // The unnamed `<slot/>` elements of a markup tree, in document order
    // (s473: §66.15.2 multiplicity). A slot with a `name=` is not counted (O9 — refused).
    fn slotsIn(ns: ANode[]) -> int[] { return slotsWalk(ns, false, false) }

    // The unnamed `<slot/>`s lifted inside a Tier-0 loop or an `<each>` row (they render once per row).
    fn loopSlotsIn(ns: ANode[]) -> int[] { return slotsWalk(ns, true, false) }

    // `wantLooped`: collect the slots under a loop (true) or the ones outside every loop (false).
    fn slotsWalk(ns: ANode[], wantLooped: boolean, inLoop: boolean) -> int[] {
        let out: int[] = []
        for (const n of ns) {
            const k: ANodeK = n.k
            const kids: int[] = match k {
                .Elem(e: el) :> slotsInElem(el, wantLooped, inLoop)
                .Text(text: t) :> []
                .Interp(e: x) :> []
                .DeclNode(d: dd) :> []
                .Effect(w: w) :> []
                .Css(c: c) :> []
                .Gather(f: f) :> slotsWalk(gatherRows(f), wantLooped, true)
            }
            out = out.concat(kids)
        }
        return out
    }

    fn slotsInElem(el: AElem, wantLooped: boolean, inLoop: boolean) -> int[] {
        if (el.tag == "slot") {
            if (namedSlot(el) || inLoop != wantLooped) return []
            return [el.nid]
        }
        // s474: an `<each>` row repeats like a Tier-0 loop row (§66.15.2 "Exclusive branches", repeating regions)
        if (el.tag == "each" && !el.star) return slotsWalk(el.kids, wantLooped, true)
        return slotsWalk(el.kids, wantLooped, inLoop)
    }

    // s474 (F7, §66.15.2 "Exclusive branches") — rule 2 counts unnamed slots
    // PER RENDER PATH, not in total: "on every render path through a `renders`,
    // at most one unnamed `<slot/>` SHALL render". The exclusive sets the
    // bootstrap has are the `if=` / `else-if=` / `else` chains (§17.1.1, read
    // as chainCheck reads them: whitespace and `#{}` do not break a chain, any
    // other non-element node does, an `else` ends it); a lifting `${ if … }`
    // and `<match>` are not in the bootstrap. A slot is EXCESS when some path
    // reaches it with a slot already rendered — each excess slot is reported
    // once (E-COMPONENT-020). Looped slots are not walked (loopSlotsIn — they
    // are refused as once-per-row); a named slot is O9, refused, not counted.
    type SlotPath:struct = { n: int, bad: int[] }

    fn excessSlotsIn(ns: ANode[]) -> int[] { return slotPathWalk(ns, 0).bad }

    // `before` — the most slots any path has rendered on reaching `ns`.
    fn slotPathWalk(ns: ANode[], before: int) -> SlotPath {
        let n: int = before
        let bad: int[] = []
        let inChain: boolean = false     // inside an `if=` chain
        let base: int = 0                // the count each member of the open chain starts from
        let most: int = 0                // the open chain's max over its members (and the no-member path)
        for (const node of ns) {
            const k: ANodeK = node.k
            const e: AElem | not = match k {
                .Elem(e: x) :> x
                .Text(text: t) :> not
                .Interp(e: x) :> not
                .DeclNode(d: d) :> not
                .Css(c: c) :> not
                .Gather(f: x) :> not
                .Effect(w: w) :> not
            }
            if (e is given) {
                const opens: boolean = attrNamed(e.attrs, "if") is given
                const continues: boolean = !opens && (attrNamed(e.attrs, "else-if") is given || attrNamed(e.attrs, "else") is given)
                if (inChain && continues) {
                    const r: SlotPath = slotPathElem(e, base)
                    bad = bad.concat(r.bad)
                    if (r.n > most) most = r.n
                    if (attrNamed(e.attrs, "else") is given) {
                        n = most
                        inChain = false
                    }
                } else {
                    if (inChain) n = most
                    inChain = false
                    if (opens) {
                        base = n
                        const r: SlotPath = slotPathElem(e, base)
                        bad = bad.concat(r.bad)
                        most = r.n
                        inChain = true
                    } else {
                        const r: SlotPath = slotPathElem(e, n)
                        bad = bad.concat(r.bad)
                        n = r.n
                    }
                }
            } else if (!blankNode(node) && !isCssNode(node)) {
                if (inChain) n = most
                inChain = false
            }
        }
        if (inChain) n = most
        return { n: n, bad: bad }
    }

    fn slotPathElem(el: AElem, before: int) -> SlotPath {
        if (el.tag == "slot") {
            if (namedSlot(el)) return { n: before, bad: [] }
            if (before > 0) return { n: before + 1, bad: [el.nid] }
            return { n: before + 1, bad: [] }
        }
        if (el.tag == "each" && !el.star) return { n: before, bad: [] }   // its slots are looped (loopSlotsIn)
        return slotPathWalk(el.kids, before)
    }

    fn namedSlot(el: AElem) -> boolean {
        for (const a of el.attrs) {
            if (a.name.toLowerCase() == "name") return true
        }
        return false
    }

    // Does a use carry content between its tags (anything but whitespace)?
    fn hasContentKids(ns: ANode[]) -> boolean {
        for (const n of ns) {
            if (!blankNode(n)) return true
        }
        return false
    }

    // s469 — a `#{…}` block renders nothing where it stands: it does not break
    // an `if=` / `else` chain (lower.scrml blankText agrees).
    fn isCssNode(n: ANode) -> boolean {
        const k: ANodeK = n.k
        return match k {
            .Css(c: c) :> true
            .Gather(f: x) :> false
            .Text(text: t) :> false
            .Elem(e: e) :> false
            .Interp(e: e) :> false
            .DeclNode(d: d) :> false
            .Effect(w: w) :> false
        }
    }

    fn blankNode(n: ANode) -> boolean {
        const k: ANodeK = n.k
        return match k {
            .Text(text: t) :> t.trim() == ""
            .Elem(e: e) :> false
            .Interp(e: e) :> false
            .DeclNode(d: d) :> false
            .Css(c: c) :> false
            .Gather(f: x) :> false
            .Effect(w: w) :> false
        }
    }

    // s444 (PA): the scrml structural / directive tags (§4.15, §24.4 and impl#1's
    // name-resolver SCRML_NON_ELEMENT_TAGS: the placement table, §65, the
    // document roots, definition blocks, directive sugar, the lifecycle tags,
    // §36 input-state tags) the bootstrap does NOT implement — each with its
    // owning section. `each` and `slot` are implemented (resolveElem); `<theme>`
    // is refused by the parser; `<program>` parses as the program. Compared
    // lowercase (`errorBoundary`, `onTransition`). "" = not one.
    fn structuralOwner(tag: string) -> string {
        const t: string = tag.toLowerCase()
        return match t {
            "request"       :> "§6.7.7 async request"
            "poll"          :> "§6.7 lifecycle"
            "timer"         :> "§6.7 lifecycle"
            "timeout"       :> "§6.7.8 lifecycle"
            "machine"       :> "§6.7 lifecycle"
            "errorboundary" :> "§19 error boundary"
            "schema"        :> "§39.2"
            "channel"       :> "§38"
            "onchange"      :> "§38.13"
            "auth"          :> "§40.9.5"
            "page"          :> "§40"
            "engine"        :> "§51.0 (retired into `single` declarations, §66.13.3)"
            "ontransition"  :> "§51.0.H"
            "ontimeout"     :> "§51.0.M"
            "onidle"        :> "§51.0.R"
            "match"         :> "§18.0.1"
            "empty"         :> "§17.7 `<each>` fallback"
            "render"        :> "§19.15"
            "outlet"        :> "§20.8"
            "column"        :> "§41.14"
            "formfor"       :> "§41.14"
            "tablefor"      :> "§41.14"
            "if"            :> "a retired control-flow tag"
            "else"          :> "a retired control-flow tag"
            "else-if"       :> "a retired control-flow tag"
            "component"     :> "§15"
            "snippet"       :> "§16"
            "partial"       :> "§16"
            "foreign"       :> "§23.6"
            "endpoint"      :> "§61"
            "api"           :> "§60"
            "markup"        :> "a legacy document root"
            "defaults"      :> "§65.3.3"
            // s473 — §4.15 registers these two (Nominal), and the bootstrap
            // has neither: `<onMount>` rendered as an element and its body ran
            // as a render interpolation (gap g-bootstrap-onmount-owed); `<md>`
            // showed its markdown as page text (g-bootstrap-md-static-owed-s462)
            "onmount"       :> "§6.7.1a lifecycle"
            "md"            :> "§67 markdown"
            "keyboard"      :> "§36 input state"
            "mouse"         :> "§36 input state"
            "gamepad"       :> "§36 input state"
            _               :> ""
        }
    }

    // `<*x …/>` (§66.6.2): the existing instance.
    fn resolveStar(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        // s442: `<*f/>` naming a FIELD of the enclosing declaration (the
        // program's cells included, R4) — THIS instance's own field (§66.6.2).
        const sf: StarField | not = starField(env, e.tag)
        if (sf is given) return resolveStarField(env, e, sf, st)
        const d: DeclSrc | not = declNamed(env.g, env.file, e.tag)
        if (d is not && declAnywhere(env.g, e.tag)) {
            return addDiag(st, env.file, e.span, "E-SCOPE-001", "`<*" + e.tag + "/>` — `<" + e.tag + ">` is not declared" + elsewhereNote(env.g.te.link, env.file, NameKind.KDecl, false, e.tag))
        }
        if (d is not) {
            // r1 nit: a field of SOME user declaration, named out of its scope
            const owner: string = fieldOwnerName(env.g, e.tag)
            if (owner != "") {
                return addDiag(st, env.file, e.span, "E-SCOPE-001", "`<*" + e.tag + "/>` — `" + e.tag + "` is a field of `<" + owner + ">`; `<*" + e.tag + "/>` names it only inside `<" + owner + ">`'s renders (§66.6.2)")
            }
            return addDiag(st, env.file, e.span, "E-DECL-STAR-PREDEFINED", "`<*" + e.tag + "/>` — a predefined (HTML) declaration has no shared instance (§66.6.5)")
        }
        st = starRefAttrs(env, e, fieldNames(d.info), st)
        if (st.diags.length == st0.diags.length) {
            // s442: the shared instance, inlined (resolveStarShared)
            st = resolveStarShared(env, e, d, st)
        }
        return st
    }

    // s462 (O18 RULED, SPEC §66.6.9 rule 3): the attributes of a `<*x>`
    // reference. One naming a field of the referenced instance would write it —
    // E-DECL-STAR-REF-ATTR-WRITE (§66.6.7). `if=` / `else-if=` / `else` are the
    // open residue O18-r: left to the conditional-host check, which refuses them
    // on a reference (chainHostRefused). Any other — `as=`, `class`, `style`,
    // `key=`, `show=`, `on…` … — is undeclared, E-DECL-USE-ATTR: a reference
    // makes no instance, binds no handle and writes no element. (Before s462 a
    // non-field attribute here was dropped silently.)
    fn starRefAttrs(env: Env, e: AElem, written: string[], st0: AS) -> AS {
        let st: AS = st0
        for (const a of e.attrs) {
            if (nameIn(written, a.name)) {
                st = addDiag(st, env.file, a.span, "E-DECL-STAR-REF-ATTR-WRITE", "`" + a.name + "=` on `<*" + e.tag + ">` would write the referenced instance — a `<*x>` reference is read-only; write through logic (§66.6.7)")
            } else if (a.name == "as") {
                st = addDiag(st, env.file, a.span, "E-DECL-USE-ATTR", "`as=` on `<*" + e.tag + ">` — a `<*x>` reference is the instance that already exists, not a new one, and binds no handle; address it from logic as `@" + e.tag + "` (§66.6.9, §66.7.1)")
            } else if (!isChainAttr(a.name)) {
                st = addDiag(st, env.file, a.span, "E-DECL-USE-ATTR", "`<*" + e.tag + ">` has no attribute `" + a.name + "` — a `<*x>` reference carries no undeclared attribute, and nothing it writes reaches an element of the renders (§66.6.9)")
            }
        }
        return st
    }

    fn nameIn(names: string[], n: string) -> boolean {
        for (const x of names) {
            if (x == n) return true
        }
        return false
    }

    fn fieldNames(d: DeclInfo) -> string[] {
        let out: string[] = []
        for (const f of d.fields) { out = out.concat([f.sym.hint]) }
        return out
    }

    // The attributes and child fields of the field declared by the ADecl
    // `fieldNid` in `ds` — what a `<*f>` reference of that field could write.
    fn fieldSubNames(ds: DeclSrc, fieldNid: int) -> string[] {
        for (const fd of fieldDecls(ds)) {
            if (fd.nid == fieldNid) {
                let out: string[] = []
                for (const a of fd.attrs) { out = out.concat([a.name]) }
                for (const c of childFields(fd.body)) { out = out.concat([c.name]) }
                return out
            }
        }
        return []
    }

    // ---- s442: `<*f/>` of a field, and state-child bodies ----------------------
    // The field `<*name/>` names from here: a field of the enclosing user
    // declaration (its renders), else a cell of the program visible here.
    type StarField:struct = { decl: DeclInfo, inst: InstRef, idx: int, src: DeclSrc }

    fn starField(env: Env, name: string) -> StarField | not {
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given) {
            if (!d.isProgram) {
                const i: int = fieldIndex(d.info, name)
                if (i >= 0) return { decl: d.info, inst: InstRef.Lexical(0), idx: i, src: d }
            }
        }
        const pi: DeclInfo | not = programInfo(env)
        const ps: DeclSrc | not = findDeclSrc(env.g, env.g.program)
        if (pi is given && ps is given) {
            const j: int = fieldIndex(pi, name)
            if (j >= 0) return { decl: pi, inst: programInst(env), idx: j, src: ps }
        }
        return not
    }

    // A field with a `rule=` graph whose state-children carry bodies renders
    // the body of the variant it holds (O5 (1i)). Anything else a `<*f/>` could
    // mean — a child declaration's own `renders`, a field with no markup
    // (⚑ O51) — is outside this construct and reported.
    fn resolveStarField(env: Env, e: AElem, sf: StarField, st0: AS) -> AS {
        let st: AS = st0
        const f: FieldInfo = sf.decl.fields[sf.idx]
        st = starRefAttrs(env, e, fieldSubNames(sf.src, f.nid), st)
        if (st.diags.length > st0.diags.length) return st
        // s442: a child field with its own `renders` (§66.4 rule 2: "a field that
        // needs its own … `renders` … is a CHILD declaration") renders it here,
        // for THIS instance (§66.6.2) — resolved in this declaration's context.
        const own: ANode[] = fieldRenders(sf.src, f.nid)
        if (own.length > 0) return addElem(st, e.nid, ElemFact.MInline({ nodes: own, subst: not }))
        const g: TransitionGraph | not = f.graph
        const children: AStateChild[] = fieldStateChildren(sf.src, f.nid)
        let arms: StateArm[] = []
        if (g is given) {
            for (const c of children) {
                const v: int = variantIndex(env.g.types, g.enumSym, c.name)
                if (v >= 0 && c.body.length > 0) arms = arms.concat([{ variant: v, body: c.body }])
            }
            if (arms.length > 0) {
                const sv: StateView = { decl: sf.decl.sym, inst: sf.inst, idx: sf.idx, enumSym: g.enumSym, arms: arms }
                return addElem(st, e.nid, ElemFact.MStateView(sv))
            }
        }
        return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<*" + e.tag + "/>` — rendering a field is in the bootstrap only for a `rule=` graph field whose state-children have bodies (O5 (1i)); `" + e.tag + "` has none (a field with no markup of its own is ⚑ O51)")
    }

    // The state-children of the field declared by the ADecl `fieldNid` inside
    // the declaration `ds` (a program cell, or a user declaration's child).
    fn fieldStateChildren(ds: DeclSrc, fieldNid: int) -> AStateChild[] {
        for (const fd of fieldDecls(ds)) {
            if (fd.nid == fieldNid) {
                let out: AStateChild[] = []
                for (const c of fd.body) { out = out.concat(stateChildOf(c)) }
                return out
            }
        }
        return []
    }

    // The `renders` of the field declared by the ADecl `fieldNid` in `ds` (as
    // one node, nid -1 — the renders AElem carries the facts), else none.
    fn fieldRenders(ds: DeclSrc, fieldNid: int) -> ANode[] {
        for (const fd of fieldDecls(ds)) {
            if (fd.nid == fieldNid) return rendersOf(fd)
        }
        return []
    }

    // s442: `<*x/>` of a user declaration at program top level — its shared
    // instance (§66.6.2, §66.6.4), rendered by inlining its renders.
    fn resolveStarShared(env: Env, e: AElem, d: DeclSrc, st: AS) -> AS {
        if (!inProgramCtx(env)) {
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<*" + e.tag + "/>` inside a declaration's `renders` (the lexically nearest `" + e.tag + "`, §66.6.2) is not in the bootstrap — only a child field (`<*f/>`) or, at program top level, the shared instance")
        }
        const nodes: ANode[] = rendersNodes(d)
        if (nodes.length == 0) {
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<*" + e.tag + "/>` — `<" + e.tag + ">` has no `renders` (a use of a declaration with no markup is ⚑ O51)")
        }
        // r1 G3: an attribute with no default (⚑ O33) has no value in the shared
        // instance — provably, since a `<*x/>` reference sets nothing (§66.6.7).
        for (const f of d.info.fields) {
            if (isAttributeRole(f.role) && !hasOwnValue(f.init)) {
                return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<*" + e.tag + "/>` — `<" + e.tag + ">`'s attribute `" + f.sym.hint + "` has no default, and a `<*x/>` reference sets none: its value in the shared instance is ⚑ O33 (not ruled)")
            }
        }
        // s444: Core View.Star renders the existing instance with its own
        // renders — its uses, `as=` handles and `<slot/>` included (M1 D4 closed)
        return addElem(st, e.nid, ElemFact.MStar(d.info.sym, InstRef.Shared(d.info.sym)))
    }

    fn useSets(attrs: AAttr[], name: string) -> boolean {
        for (const a of attrs) {
            if (a.name == name) return true
        }
        return false
    }

    fn isAttributeRole(r: FieldRole) -> boolean {
        return match r {
            .Attribute :> true
            .Child :> false
        }
    }

    // The ADecls that are fields of `ds`: the program's cells (its body's
    // declarations that are not nested user declarations), or a user
    // declaration's child fields.
    fn fieldDecls(ds: DeclSrc) -> ADecl[] {
        const p: AProgram | not = ds.p
        if (p is given) {
            let out: ADecl[] = []
            for (const it of p.items) {
                for (const d of declsOfItem(it)) {
                    if (!isNestedUserDecl(d)) out = out.concat([d])
                }
            }
            return out
        }
        const ud: ADecl | not = ds.d
        if (ud is given) return childFields(ud.body)
        return []
    }

    // Every state-child body of `ds`'s fields, resolved in `ds`'s context (O5
    // (1i): the body is that variant's markup, like the declaration's renders).
    fn stateBodyLists(ds: DeclSrc) -> ANode[][] {
        let out: ANode[][] = []
        for (const fd of fieldDecls(ds)) {
            for (const c of fd.body) {
                for (const sc of stateChildOf(c)) { out = out.concat([sc.body]) }
            }
        }
        return out
    }

    fn stateBodies(ds: DeclSrc) -> ANode[] {
        let out: ANode[] = []
        for (const fd of fieldDecls(ds)) {
            for (const c of fd.body) {
                for (const sc of stateChildOf(c)) { out = out.concat(sc.body) }
            }
        }
        return out
    }

    fn fieldOwnerName(g: Globals, name: string) -> string {
        for (const d of g.decls) {
            if (!d.isProgram && fieldIndex(d.info, name) >= 0) return d.info.sym.hint
        }
        return ""
    }

    // s442: the program's cell `name` when it was declared `single` (§66.13.3).
    fn singleProgramField(env: Env, name: string) -> ADecl | not {
        if (programInfo(env) is not) return not
        const ps: DeclSrc | not = findDeclSrc(env.g, env.g.program)
        if (ps is not) return not
        for (const d of fieldDecls(ps)) {
            if (d.name == name && hasFlag(d.mods, "single")) return d
        }
        return not
    }

    fn singleInstantiated(env: Env, e: AElem, st: AS) -> AS {
        return addDiag(st, env.file, e.span, "E-DECL-SINGLE-INSTANTIATED", "`<" + e.tag + "/>` makes a new instance of `" + e.tag + "`, which is declared `single` — it has exactly one instance; render that one with `<*" + e.tag + "/>` (§66.13.3, O55 ruled S442)")
    }

    fn eventName(attr: string) -> string {
        if (isNonEventOnWord(attr)) return ""
        if (attr.length > 2 && attr.substring(0, 2) == "on") return attr.substring(2)
        return ""
    }

    // s462 — §5.2 rule 1: an `on…` name is an event handler "EXCEPT the named
    // non-event words `one`, `online` and `onboarding`, matched by exact whole
    // name … The three exempt words are ordinary attributes". The exemption
    // names the SAFE words; every other `on…` name is a handler (fail closed).
    fn isNonEventOnWord(n: string) -> boolean {
        return n == "one" || n == "online" || n == "onboarding"
    }

    // A handler value is a statement (or a block of them).
    fn resolveHandler(env: Env, v: AAttrValue, st: AS) -> AS {
        return match v {
            .Bare(e: e) :> handlerReference(env, e, resolveStmtExpr(withFnRef(env, e.nid), e, st))
            .Paren(e: e) :> handlerReference(env, e, resolveStmtExpr(withFnRef(env, e.nid), e, st))
            .Braced(b: b) :> bracedHandler(env, b, st)
            .Quoted(v: s) :> st
            .NoValue :> st
        }
    }

    fn valueExpr(v: AAttrValue) -> AExpr | not {
        return match v {
            .Bare(e: e) :> e
            .Paren(e: e) :> e
            .Quoted(v: s) :> not
            .NoValue :> not
            .Braced(b: b) :> not
        }
    }

    // s473 — does this `<link>`'s `rel` load (or may it load) a stylesheet? Ruled
    // S472 (user-voice-scrml.md "five PA recs" item 3): "A data-bound `href` on a
    // `<link>` whose `rel` contains `stylesheet` (or is computed) is REFUSED." A
    // `rel` that is not a static quoted string (`rel=@r`, `rel=(…)`, `{…}`) is
    // computed. A static one is matched ASCII case-insensitively for the text
    // `stylesheet` anywhere (a superset of the HTML token test — `alternate
    // stylesheet`, any whitespace — fail closed). A `&` (a character reference
    // the browser decodes: `style&#115;heet`) or a `$` + `{` (a template) makes
    // the static text unprovable: treated as computed.
    fn linkRelLoadsSheet(attrs: AAttr[]) -> boolean {
        for (const a of attrs) {
            if (a.name.toLowerCase() == "rel") {
                const sheet: boolean = match a.value {
                    .Quoted(v: s) :> s.toLowerCase().indexOf("stylesheet") >= 0 || s.indexOf("&") >= 0 || s.indexOf("$" + "{") >= 0
                    .NoValue :> false
                    .Bare(e: x) :> true
                    .Paren(e: x) :> true
                    .Braced(b: b) :> true
                }
                if (sheet) return true
            }
        }
        return false
    }

    // s462 — an attribute's parenthesized expression value `name=(…)`.
    fn parenValue(v: AAttrValue) -> boolean {
        return match v {
            .Paren(e: e) :> true
            .Bare(e: e) :> false
            .Quoted(v: s) :> false
            .NoValue :> false
            .Braced(b: b) :> false
        }
    }

    // s473 — §5.2 "Data never chooses where a form posts or where the page
    // goes (S473)". Ruled (user-voice-scrml.md "S473 owner questions round 2"
    // items 1 and 2): "Form `action` / `formaction` from data: REFUSED unless
    // static." and "`<meta http-equiv=\"refresh\">` from data: REFUSED." The
    // code a data-bound value of `a` on `e` is refused with, or "" when none:
    //   - `action` (any case) on a `<form>` (any case) — the element scope
    //     §5.2 rule 3 gives `action`; `formaction` (any case) on ANY element
    //     (it is inert off `<button>` / `<input>`; refusing it there loses
    //     nothing — fail closed): E-ATTR-FORM-ACTION;
    //   - `form` (any case) on ANY element — the form owner: data never
    //     chooses which form a control is submitted with (S473 PA ruling,
    //     extends round 2 item 1; review of #1641 F1, Chromium: a data
    //     `form=` moved a password into an author-written off-origin form):
    //     E-ATTR-FORM-ACTION;
    //   - on a `<meta>`: `http-equiv` (data never chooses a pragma — it could
    //     become `refresh`), and `content` when the `http-equiv` refreshes or
    //     is computed (`metaEquivRefreshes`): E-ATTR-META-REFRESH.
    fn navSinkCode(e: AElem, a: AAttr) -> string {
        return navSinkCodeOf(e.tag, a.name, e.attrs)
    }

    fn navSinkCodeOf(tag: string, name: string, attrs: AAttr[]) -> string {
        const n: string = name.toLowerCase()
        const t: string = tag.toLowerCase()
        if (n == "formaction" || n == "form" || (n == "action" && t == "form")) return "E-ATTR-FORM-ACTION"
        if (t == "meta" && (n == "http-equiv" || (n == "content" && metaEquivRefreshes(attrs)))) return "E-ATTR-META-REFRESH"
        return ""
    }

    // The markup attribute walk's other data refusals, as predicates the `<host>` walk calls too
    // (s473-host-allowlist-b, #1674 review F1 — one test, not a second list):
    //   §65.4.2 `style` from data (E-STYLE-VALUE-NOT-STYLE); §5.2 a `<base>` `href` (E-ATTR-BASE-HREF);
    //   §5.2 a stylesheet `<link>` `href` (E-ATTR-STYLESHEET-HREF).
    fn styleAttrFromData(name: string) -> boolean { return name.toLowerCase() == "style" }
    fn baseHrefFromData(tag: string, name: string) -> boolean { return name.toLowerCase() == "href" && tag.toLowerCase() == "base" }
    fn sheetHrefFromData(tag: string, name: string, attrs: AAttr[]) -> boolean {
        return name.toLowerCase() == "href" && tag.toLowerCase() == "link" && linkRelLoadsSheet(attrs)
    }

    // THE markup walk's refusal of a DATA value for the attribute `name` on a `<tag>` ("" — admitted;
    // otherwise the code markup reports). `srcdoc` and event handlers are refused from data in every form
    // too (url.scrml executableAttrName, asked separately by both walks).
    fn dataAttrRefusal(tag: string, name: string, attrs: AAttr[]) -> string {
        if (name.toLowerCase() == "srcdoc") return "E-ATTR-INTERP-EXECUTABLE"
        const nav: string = navSinkCodeOf(tag, name, attrs)
        if (nav != "") return nav
        if (styleAttrFromData(name)) return "E-STYLE-VALUE-NOT-STYLE"
        if (baseHrefFromData(tag, name)) return "E-ATTR-BASE-HREF"
        if (sheetHrefFromData(tag, name, attrs)) return "E-ATTR-STYLESHEET-HREF"
        return ""
    }

    // s473 — does this `<meta>`'s `http-equiv` refresh (or may it)? A value
    // that is not a static quoted string is computed. A static one is matched
    // ASCII case-insensitively for the text `refresh` anywhere (a superset of
    // the browser's keyword test — surrounding whitespace included, fail
    // closed). A `&` (a character reference the browser decodes:
    // `ref&#114;esh`) or a `$` + `{` (a template) makes the text unprovable:
    // treated as computed. (The shape of #1635's `linkRelLoadsSheet`.)
    fn metaEquivRefreshes(attrs: AAttr[]) -> boolean {
        for (const a of attrs) {
            if (a.name.toLowerCase() == "http-equiv") {
                const r: boolean = match a.value {
                    .Quoted(v: s) :> s.toLowerCase().indexOf("refresh") >= 0 || s.indexOf("&") >= 0 || s.indexOf("$" + "{") >= 0
                    .NoValue :> false
                    .Bare(e: x) :> true
                    .Paren(e: x) :> true
                    .Braced(b: b) :> true
                }
                if (r) return true
            }
        }
        return false
    }

    fn navSinkMessage(code: string, a: AAttr, e: AElem) -> string {
        const head: string = "`" + a.name + "=` on `<" + e.tag + ">` takes its value from data (an expression, a variable, a call or a field)"
        if (code == "E-ATTR-FORM-ACTION" && a.name.toLowerCase() == "form") return head + " — data never chooses where a form posts: `form=` picks the form this control is submitted with, so data would send its value (a password included) to another form's URL. Write `form=` as a static string naming one form (`form=\"login\"`), or put the control inside its `<form>` (§5.2)"
        if (code == "E-ATTR-FORM-ACTION") return head + " — data never chooses where a form is sent: the submission carries every field of the form, a password included, to whatever URL the value names (§5.2 rule 3 admits any `https:` origin). Write the `" + a.name + "` as a static string (`" + a.name + "=\"/login\"`), or switch between static forms with `if=` (§5.2)"
        return head + " — data never navigates the page: a `<meta http-equiv=\"refresh\">` sends the whole page to the URL in its `content`, and `http-equiv` chooses that pragma. Write `http-equiv` and a refresh's `content` as static strings (`content=\"30;url=/next\"`) (§5.2)"
    }

    // s462 — a quoted value holding `${…}` (the parser refuses it).
    fn quotedHasInterp(v: AAttrValue) -> boolean {
        return match v {
            .Quoted(v: s) :> s.indexOf("$" + "{") >= 0
            .Bare(e: e) :> false
            .Paren(e: e) :> false
            .NoValue :> false
            .Braced(b: b) :> false
        }
    }

    // s464 — a quoted value holding no `${…}` (a static string).
    fn quotedNoInterp(v: AAttrValue) -> boolean {
        return match v {
            .Quoted(v: s) :> s.indexOf("$" + "{") < 0
            .Bare(e: e) :> false
            .Paren(e: e) :> false
            .NoValue :> false
            .Braced(b: b) :> false
        }
    }

    fn resolveValue(env: Env, v: AAttrValue, expected: Type | not, st: AS) -> AS {
        const e: AExpr | not = valueExpr(v)
        if (e is not) return st
        return resolveExpr(env, e, expected, st).st
    }

    // An element's `if=` value: a condition (resolveCond). `elemPresentEnv`:
    // the env its other attributes and its children see — the conditional
    // handle its `if=` tests for presence is mounted there (ruled S442).
    fn resolveIfValue(env: Env, v: AAttrValue, st: AS) -> AS {
        const x: AExpr | not = valueExpr(v)
        if (x is not) return st
        return resolveCond(env, x, st)
    }

    fn elemPresentEnv(env: Env, e: AElem) -> Env {
        const a: AAttr | not = condAttrOf(e.attrs)
        if (a is not) return env
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return env
        return withPresent(env, presenceHandle(env, x))
    }

    // s473 (ruled refusals) — §26.2 amendment (S473 D13): "When a static
    // `class=` token of a compiled program matches the Tailwind utility grammar
    // (§26.3–§26.4), the bootstrap SHALL report one Info diagnostic for the
    // compile, I-TAILWIND-NOT-BUILT (§34), saying that utility classes are
    // passed through unstyled and naming the first matching class. The class
    // token is still written to the element unchanged and the compile does not
    // fail." Once per compile: the first match reports, later ones see it.
    fn tailwindInfo(env: Env, a: AAttr, st: AS) -> AS {
        const v: AAttrValue = a.value
        const text: string = match v {
            .Quoted(v: q) :> q
            .NoValue :> ""
            .Bare(e: x) :> ""
            .Paren(e: x) :> ""
            .Braced(b: b) :> ""
        }
        if (text == "") return st
        for (const d of st.diags) {
            if (d.code == "I-TAILWIND-NOT-BUILT") return st
        }
        for (const tok of classTokens(text)) {
            if (tok.indexOf("$" + "{") < 0 && isTailwindClass(tok)) {
                return addDiag(st, env.file, a.span, "I-TAILWIND-NOT-BUILT", "`" + tok + "` is a Tailwind utility class, and the bootstrap does not build Tailwind (§26): utility classes are passed through unstyled — written to the element unchanged, with no CSS (§26.2, S473 D13). Style with a `#{…}` block (§9.1) for the bootstrap. (Reported once per compile.)")
            }
        }
        return st
    }

    // The whitespace-separated tokens of a static `class=` value.
    fn classTokens(text: string) -> string[] {
        let out: string[] = []
        let cur: string = ""
        let i: int = 0
        while (i < text.length) {
            const c: string = text.substring(i, i + 1)
            if (c == " " || c == "\t" || c == "\n" || c == "\r") {
                if (cur != "") out = out.concat([cur])
                cur = ""
            } else {
                cur = cur + c
            }
            i = i + 1
        }
        if (cur != "") out = out.concat([cur])
        return out
    }

    // s473 — the Tailwind utility grammar, as far as the D13 Info needs it
    // (§26.3 variant prefixes, §26.4 arbitrary values, and the common utility
    // families with a Tailwind value): `md:hover:bg-blue-500`, `p-4`,
    // `w-[37px]`, `flex`, `-mt-2`, `text-sm`, `items-center`. A token whose
    // variant prefix is not one §26.3 lists does not match (impl#1 reports it as
    // W-TAILWIND-001); an author class such as `card` or `btn-primary` does not.
    fn isTailwindClass(tok0: string) -> boolean {
        if (tok0 == "") return false
        const parts: string[] = tok0.split(":")
        let i: int = 0
        while (i < parts.length - 1) {
            if (!isTwVariant(parts[i])) return false
            i = i + 1
        }
        let base: string = parts[parts.length - 1]
        if (base.substring(0, 1) == "!") base = base.substring(1)
        if (base.substring(0, 1) == "-") base = base.substring(1)
        if (base == "") return false
        if (twWords().indexOf(base) >= 0) return true
        // arbitrary value: `<prefix>-[<value>]` (§26.4)
        const lb: int = base.indexOf("-[")
        if (lb > 0 && base.substring(base.length - 1) == "]") return twArbitraryPrefixes().indexOf(base.substring(0, lb)) >= 0
        // `<prefix>-<value>`, the longest listed prefix first
        for (const pre of twPrefixes()) {
            if (base.length > pre.length + 1 && base.substring(0, pre.length + 1) == pre + "-") {
                if (isTwValue(base.substring(pre.length + 1))) return true
            }
        }
        return false
    }

    fn isTwVariant(v: string) -> boolean {
        const states: string[] = ["hover", "focus", "active", "disabled", "visited", "first", "last", "odd", "even", "focus-within", "focus-visible"]
        if (["sm", "md", "lg", "xl", "2xl", "dark", "print", "motion-safe", "motion-reduce"].indexOf(v) >= 0) return true
        if (states.indexOf(v) >= 0) return true
        if (v.substring(0, 6) == "group-") return states.indexOf(v.substring(6)) >= 0
        return false
    }

    fn twWords() -> string[] {
        return ["flex", "grid", "block", "inline", "inline-block", "inline-flex", "inline-grid", "hidden", "contents", "table", "flow-root",
                "container", "relative", "absolute", "fixed", "sticky", "static", "italic", "not-italic", "underline", "line-through", "no-underline",
                "uppercase", "lowercase", "capitalize", "normal-case", "truncate", "grow", "shrink", "border", "rounded", "shadow", "transition",
                "prose", "group", "sr-only", "not-sr-only", "visible", "invisible", "antialiased", "subpixel-antialiased", "isolate", "outline",
                "ring", "blur", "filter", "transform", "flex-row", "flex-col", "flex-wrap", "flex-nowrap", "flex-1", "flex-auto", "flex-none",
                "mx-auto", "my-auto", "m-auto", "w-full", "h-full", "w-screen", "h-screen", "min-h-screen", "select-none", "cursor-pointer",
                "pointer-events-none", "overflow-hidden", "overflow-auto", "overflow-scroll", "whitespace-nowrap", "break-words", "list-none",
                "object-cover", "object-contain", "aspect-square", "aspect-video", "shadow-none", "rounded-full", "rounded-none", "resize", "resize-none"]
    }

    fn twArbitraryPrefixes() -> string[] {
        return ["p", "px", "py", "pt", "pr", "pb", "pl", "m", "mx", "my", "mt", "mr", "mb", "ml", "gap", "gap-x", "gap-y", "w", "h", "min-w",
                "max-w", "min-h", "max-h", "top", "right", "bottom", "left", "inset", "text", "leading", "tracking", "bg", "border", "rounded",
                "opacity", "shadow", "z", "grid-cols", "grid-rows", "col-span", "row-span", "col-start", "col-end", "row-start", "row-end", "flex",
                "grow", "shrink", "order", "basis", "aspect", "content", "font"]
    }

    // the utility families (longest first, so `gap-x` is tried before `gap`)
    fn twPrefixes() -> string[] {
        return ["underline-offset", "pointer-events", "grid-cols", "grid-rows", "col-start", "row-start", "col-span", "row-span", "col-end",
                "row-end", "space-x", "space-y", "divide-x", "divide-y", "translate-x", "translate-y", "min-w", "max-w", "min-h", "max-h",
                "gap-x", "gap-y", "inset-x", "inset-y", "rounded-t", "rounded-b", "rounded-l", "rounded-r", "border-t", "border-b", "border-l",
                "border-r", "border-x", "border-y", "line-clamp", "decoration", "whitespace", "transition", "placeholder", "duration", "tracking",
                "leading", "overflow", "opacity", "justify", "content", "rounded", "outline", "shadow", "scale", "rotate", "origin", "object",
                "cursor", "select", "items", "inset", "order", "basis", "break", "delay", "ease", "flex", "font", "from", "grow", "list", "ring",
                "self", "skew", "text", "bg", "border", "place", "shrink", "stroke", "fill", "via", "to", "top", "right", "bottom", "left", "gap",
                "px", "py", "pt", "pr", "pb", "pl", "mx", "my", "mt", "mr", "mb", "ml", "p", "m", "w", "h", "z", "columns", "aspect", "animate",
                "blur", "align"]
    }

    fn isTwValue(v: string) -> boolean {
        if (isTwNumber(v)) return true
        const words: string[] = ["px", "xs", "sm", "md", "lg", "xl", "2xl", "3xl", "4xl", "5xl", "6xl", "7xl", "8xl", "9xl", "base", "full",
                                 "screen", "auto", "min", "max", "fit", "none", "prose", "left", "center", "right", "justify", "start", "end",
                                 "between", "around", "evenly", "stretch", "baseline", "thin", "extralight", "light", "normal", "medium", "semibold",
                                 "bold", "extrabold", "black", "white", "transparent", "current", "inherit", "wrap", "nowrap", "row", "col",
                                 "row-reverse", "col-reverse", "hidden", "visible", "scroll", "x", "y", "pointer", "default", "not-allowed", "text",
                                 "all", "colors", "transform", "in", "out", "in-out", "linear", "spin", "ping", "pulse", "bounce", "tight", "snug",
                                 "relaxed", "loose", "wide", "wider", "widest", "tighter", "cover", "contain", "sans", "serif", "mono", "inner",
                                 "dashed", "dotted", "solid", "double", "top", "bottom", "middle", "words", "all", "disc", "decimal", "square",
                                 "video", "clip", "ellipsis", "lg", "offset", "dvh", "svh", "lvh", "first", "last"]
        if (words.indexOf(v) >= 0) return true
        // a palette colour with a shade: `blue-500`, `slate-50`, `red-500/50`
        const slash: int = v.indexOf("/")
        let c: string = v
        if (slash > 0) c = v.substring(0, slash)
        const dash: int = c.lastIndexOf("-")
        if (dash > 0) {
            const palette: string[] = ["slate", "gray", "zinc", "neutral", "stone", "red", "orange", "amber", "yellow", "lime", "green", "emerald",
                                       "teal", "cyan", "sky", "blue", "indigo", "violet", "purple", "fuchsia", "pink", "rose"]
            const shades: string[] = ["50", "100", "200", "300", "400", "500", "600", "700", "800", "900", "950"]
            if (palette.indexOf(c.substring(0, dash)) >= 0 && shades.indexOf(c.substring(dash + 1)) >= 0) return true
        }
        // a size step with an edge (`rounded-t-lg`, `border-b-2`): its last segment
        if (dash > 0) return isTwNumber(c.substring(dash + 1))
        return false
    }

    // `4`, `0.5`, `1/2`, `px`-free digits only
    fn isTwNumber(v: string) -> boolean {
        if (v == "") return false
        let i: int = 0
        let digits: int = 0
        while (i < v.length) {
            const c: string = v.substring(i, i + 1)
            if ("0123456789".indexOf(c) >= 0) {
                digits = digits + 1
            } else if (c != "." && c != "/") {
                return false
            }
            i = i + 1
        }
        return digits > 0
    }

    fn resolveHtml(env: Env, e: AElem, st0: AS) -> AS {
        const penv: Env = elemPresentEnv(env, e)
        let st: AS = addElem(st0, e.nid, ElemFact.MHtml)
        // E-DECL-FIELD-TAG-NEEDS-STAR: a bare tag naming a CHILD field of the
        // enclosing declaration (§66.6.6).
        // s473: the program's cells too (R4 — they are the program's fields).
        // §66.6.6: the render-by-tag uses (`<count/>` as a view of a shared
        // cell) migrate to `<*count/>` "in the SAME arc … there is NO
        // deprecation window in which `<x/>` silently changes meaning". The
        // program was exempt, and `<count/>` rendered an inert `<count>` element.
        // (namesOwnField: a program cell spelled like an element does not take
        // the element's tag — `let <p:P/>` beside `<p>…</p>`.)
        const cd: DeclSrc | not = ctxDecl(env)
        if (cd is given && namesOwnField(env, e.tag)) {
            const owner: string = cd.isProgram ? "the program (the cell `@" + e.tag + "`)" : "`<" + cd.info.sym.hint + ">`"
            st = addDiag(st, env.file, e.span, "E-DECL-FIELD-TAG-NEEDS-STAR", "`<" + e.tag + "/>` names a field of " + owner + " — did you mean `<*" + e.tag + "/>`? A plain tag makes a new instance (§66.6.6); to show the value, interpolate it: `$" + "{@" + e.tag + "}`")
        }
        for (const a of e.attrs) {
            const ev: string = eventName(a.name)
            const directive: string = refusedDirectiveAttr(a.name, e.tag)
            if (a.name.toLowerCase() == "class") st = tailwindInfo(env, a, st)
            if (directive != "") {
                // s473 — S473 D26 (`fixed`), S473 D1 / D2 (`protect=` / `authority=`)
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", directive)
            } else if (isChainAttr(a.name)) {
                // s451: `if=` / `else-if=` / `else` (§17.1.1) — chain attributes (chainCheck)
                st = resolveIfValue(env, a.value, st)
                st = addAttr(st, a.nid, AttrKind.AIf)
            } else if (a.name == "show") {
                st = resolveShow(penv, e, a, st)
            } else if (ev != "") {
                st = resolveHandler(withHost(penv, HostCtx.HostOk), a.value, st)
                st = addAttr(st, a.nid, AttrKind.AOn(ev))
            } else if (a.name.substring(0, 5) == "bind:") {
                // r2 F6: one element writes back to ONE place — a second
                // `bind:` on it (two cells fed from one input) is refused
                // (⚑ PA: the SPEC (§5.4) does not say; no code names it).
                const first: AAttr | not = firstBind(e.attrs)
                if (first is given && first.nid != a.nid) {
                    // s451: the same `bind:` name twice is the parser's
                    // repeated-attribute refusal — one diagnostic per fault
                    if (first.name.toLowerCase() != a.name.toLowerCase()) {
                        st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is a second `bind:` on this `<" + e.tag + ">` (after `" + first.name + "`) — one element writes back to one place; bind each place on its own element (§5.4)")
                    }
                } else {
                    st = resolveBind(penv, e, a, st)
                }
            } else if (a.name.indexOf(":") >= 0) {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is not in bootstrap slice M2")
            } else if (isBracedValue(a.value)) {
                // s468 — a `{…}` value on an attribute that is not an event
                // handler is ONE expression (§5.2.4: "A `(…)`, `{…}` or `${…}`
                // value of an attribute that is not an event handler … SHALL be
                // exactly one expression"). The bootstrap does not lower it: it
                // was filed static and written as `attr=""`, the author's value
                // dropped with no diagnostic (gap
                // g-bootstrap-braced-nonhandler-value-and-quoted-handler-silently-empty-s462).
                // Refused, never dropped: `srcdoc={…}` is data written into an
                // HTML document — §5.2 rule 2 "`srcdoc` in every form" (the
                // expression form is named) — and any other name is a value
                // form the bootstrap does not implement.
                if (a.name.toLowerCase() == "srcdoc") {
                    st = addDiag(st, env.file, a.span, "E-ATTR-INTERP-EXECUTABLE", "the `" + a.name + "=` attribute on `<" + e.tag + ">` takes its value from data (a `{…}` expression), and `srcdoc` is an HTML document — data written there can carry script. A `srcdoc` value is never data. Build the frame from a URL (`src=`) or render the content as markup in the page (§5.2).")
                } else {
                    st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "={…}` on `<" + e.tag + ">` — a `{…}` value on an attribute that is not an event handler is one expression (§5.2.4), which the bootstrap does not lower; it would be written as `" + a.name + "=\"\"` and the value dropped. Write the expression in parentheses: `" + a.name + "=(…)`")
                }
            } else if (valueExpr(a.value) is given && a.name.toLowerCase() == "srcdoc") {
                // s462 — §5.2 rule 2 "`srcdoc` in every form": a `srcdoc` whose
                // value is not a static string "SHALL be a compile error
                // (E-ATTR-INTERP-EXECUTABLE)" — data is never written into an
                // HTML document. In a declaration's body it is reported once,
                // at the definition (a field supplies the value).
                st = resolveValue(penv, a.value, not, st)
                st = addDiag(st, env.file, a.span, "E-ATTR-INTERP-EXECUTABLE", "the `" + a.name + "=` attribute on `<" + e.tag + ">` takes its value from data (an expression, a variable, a call or a field), and `srcdoc` is an HTML document — data written there can carry script. A `srcdoc` value is a static string only (no `$" + "{…}`). Build the frame from a URL (`src=`) or render the content as markup in the page (§5.2).")
            } else if (valueExpr(a.value) is given && navSinkCode(e, a) != "") {
                // s473 — §5.2 "Data never chooses where a form posts or where
                // the page goes (S473)": a data `action` on a `<form>`, a data
                // `formaction`, a data `http-equiv` on a `<meta>`, or a data
                // `content` on a refresh `<meta>` "SHALL be a compile error"
                // (E-ATTR-FORM-ACTION / E-ATTR-META-REFRESH). Chromium-proven:
                // the form posts its fields (password included) off-origin; the
                // meta navigates the page off-origin. In a declaration's body it
                // is reported once, at the definition.
                const code: string = navSinkCode(e, a)
                st = resolveValue(penv, a.value, not, st)
                st = addDiag(st, env.file, a.span, code, navSinkMessage(code, a, e))
            } else if (valueExpr(a.value) is given && styleAttrFromData(a.name)) {
                // s472 — §65.4.2: "`style=<expr>` where `<expr>` is neither a
                // quoted string literal nor a `style`-typed value/list SHALL
                // emit `E-STYLE-VALUE-NOT-STYLE`. Dynamic raw CSS is **only**
                // the quoted-literal form — you cannot apply an arbitrary
                // runtime string as a style-value (that would reopen the
                // injection surface)." The bootstrap has no `style` type (a
                // `#{}` in expression position, §65.4.1, is not in it), so no
                // expression here is a style-value: every `style=(…)` /
                // `style=@x` / `style=name` is refused. It was written into
                // `style` unguarded (gap
                // g-bootstrap-style-attr-bound-value-unguarded-s469:
                // `background: url(…)` fetched on first paint). The guarded
                // channel for a cell's value into CSS is `@name` in a `#{}`
                // (§25.7 bridge, the runtime's cssValueOf). It is NOT the only
                // one: a bound SVG presentation attribute (`fill=` `filter=`
                // `mask=` `cursor=` … and SMIL `to=` animating one) writes data
                // as CSS — judged at runtime by the same cssValueOf (s473, gap
                // g-boot-svg-presentation-attr-css-url-unguarded-s472). In a
                // declaration's body it is reported once, at the definition.
                st = resolveValue(penv, a.value, not, st)
                st = addDiag(st, env.file, a.span, "E-STYLE-VALUE-NOT-STYLE", "`" + a.name + "=` on `<" + e.tag + ">` takes its value from data (an expression, a variable, a call or a field), and only a quoted string literal or a `style`-typed value applies a style — an arbitrary runtime string written into `style` is CSS built from data (`url(…)` fetches, `@import`, overlays). Write the style as a static `style=\"…\"`, put the dynamic part in a `#" + "{…}` rule as `@cell` (§25.7 — the bridge admits only a plain CSS value), or switch a class with `class=(…)` (§65.4.2)")
            } else if (valueExpr(a.value) is given && baseHrefFromData(e.tag, a.name)) {
                // s473 — §5.2 "Data never moves the document base (S473)": "A
                // `<base>` … whose `href` (any case) is not a static string …
                // SHALL be a compile error (E-ATTR-BASE-HREF)." The base URL
                // resolves every relative URL on the page, and the §5.2 URL
                // guard admits it (https): a data base moved `document.baseURI`
                // to another origin and the runtime's server call followed it
                // (gap g-boot-base-href-from-data-retargets-server-calls-s473, Chromium).
                // In a declaration's body it is reported once, at the definition.
                st = resolveValue(penv, a.value, not, st)
                st = addDiag(st, env.file, a.span, "E-ATTR-BASE-HREF", "`" + a.name + "=` on `<" + e.tag + ">` takes its value from data (an expression, a variable, a call or a field) — data never chooses the document's base URL: it resolves every relative URL on the page (links, forms, fetches), so a data base moves them to another origin. Write the `href` as a static string (`href=\"/app/\"`), or build the URLs that need a varying prefix where they are used (§5.2)")
            } else if (valueExpr(a.value) is given && sheetHrefFromData(e.tag, a.name, e.attrs)) {
                // s473 — §5.2 "Data-supplied stylesheets (S472)": "A `<link>`
                // whose `href` is not a static string … and whose `rel` contains
                // the text `stylesheet` … or is not a static string SHALL
                // be a compile error (E-ATTR-STYLESHEET-HREF)". A whole sheet a
                // cell chooses can do more than inline `style` (attribute-
                // selector exfiltration, page-wide overlays); the §5.2 URL guard
                // admits it (https). Gap g-boot-link-stylesheet-href-from-data-s472.
                // In a declaration's body it is reported once, at the definition.
                st = resolveValue(penv, a.value, not, st)
                st = addDiag(st, env.file, a.span, "E-ATTR-STYLESHEET-HREF", "`" + a.name + "=` on `<" + e.tag + ">` takes its value from data (an expression, a variable, a call or a field), and this `<link>`'s `rel` loads a stylesheet (it contains `stylesheet`, or is computed) — data never chooses a stylesheet: a whole sheet can read the page (attribute-selector `url(…)` fetches) and cover it. Write the `href` as a static string (`href=\"/theme.css\"`), switch between static `<link>`s with `if=`, or put the dynamic part in a `#" + "{…}` rule as `@cell` (§25.7) (§5.2)")
            } else if (valueExpr(a.value) is given) {
                const before: int = st.diags.length
                st = resolveValue(penv, a.value, not, st)
                st = hyphenWordValue(env, a, before, st)
                st = addAttr(st, a.nid, AttrKind.ABound)
            } else {
                st = addAttr(st, a.nid, AttrKind.AStatic)
            }
        }
        return resolveNodes(penv, e.kids, st)
    }

    // s451 — `show=cond` on an HTML element (§17.2): "The element EXISTS in the
    // DOM regardless of `expr`. When `expr` evaluates to false, the element is
    // hidden. The compiler generates a CSS `display: none` toggle." It is a
    // condition like `if=` (the typer's checkCond: a `bool` or a `T | not`
    // presence test; §5.2's atomic-only-when-bare rule is shared with `if=` —
    // a bare operator is refused in the parser for both: a spaced one
    // (`show=@n == 3`) ends the value and the rest of the tag is E-PARSE-TAG; an
    // unspaced one (`show=@n==3`, `if=@a&&@b`) is read whole and refused as
    // E-ATTR-UNQUOTED-OPERATOR (s473, parse.scrml unquotedOperatorDiag)), resolved
    // in the env the element's other attributes see (inside its `if=`). It
    // does NOT narrow the children — they exist while it is false.
    // §17.1.1: "`if=`, `else-if=`, and `else` MAY coexist on the same element
    // with `show=` … The two attributes compose without conflict" — the chain
    // arm decides presence, this decides visibility (lower: Attr.Show inside
    // the arm). Fail closed: a quoted / valueless / braced condition is
    // refused (as for `if=`, #1254). §5.5.4 / E-ATTR-WRITER-CONFLICT (a
    // WHOLESALE `style=(expr)` "with `if=`/`show=`") is not checked here: s472
    // refuses every non-static `style=` (§65.4.2, E-STYLE-VALUE-NOT-STYLE), so
    // the conflict cannot arise in a program that builds — one diagnostic per
    // fault. It returns with a `style`-typed value (Wave 2). On any other host
    // (`<each>`, a use, `<*x>`, `<errors>`, `<slot>`, a state-child) `show=`
    // is refused (showHostCheck), never ignored.
    fn resolveShow(env: Env, e: AElem, a: AAttr, st0: AS) -> AS {
        let st: AS = st0
        if (valueExpr(a.value) is not) {
            return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`show=` on `<" + e.tag + ">` needs a condition expression — `show=@x` or `show=(@n >= 3)`; a quoted, valueless or braced condition is not in the bootstrap (§17.2, §5.2) — it would never hide the element")
        }
        st = resolveIfValue(env, a.value, st)
        return addAttr(st, a.nid, AttrKind.AShow)
    }

    // s444 — `bind:value=@place` / `bind:checked=@place` (§5.4): the element
    // shows the place and writes it back. The write is judged exactly as
    // `@place = v` is (the place's own contract; writeGuards); the value it
    // writes is the element's — a string (`value`) or a boolean (`checked`).
    fn resolveBind(env: Env, e: AElem, a: AAttr, st0: AS) -> AS {
        let st: AS = st0
        let kind: BindKind = BindKind.Value
        if (a.name == "bind:checked") {
            kind = BindKind.Checked
        } else if (a.name != "bind:value") {
            if (a.name == "bind:selected" || a.name == "bind:group" || a.name == "bind:files") {
                return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` (§5.4) is not in the bootstrap — only `bind:value` and `bind:checked`")
            }
            return addDiag(st, env.file, a.span, "E-ATTR-011", "`" + a.name + "` — `bind:` is valid only on `value`, `checked`, `selected` and `group` (§5.4)")
        }
        const isValue: boolean = kind == BindKind.Value
        if (isValue && e.tag != "input" && e.tag != "textarea" && e.tag != "select") {
            return addDiag(st, env.file, a.span, "E-ATTR-011", "`bind:value` is valid on `<input>`, `<textarea>` and `<select>` (§5.4), not on `<" + e.tag + ">`")
        }
        if (!isValue && (e.tag != "input" || staticAttrText(e.attrs, "type") != "checkbox")) {
            return addDiag(st, env.file, a.span, "E-ATTR-011", "`bind:checked` is valid on `<input type=\"checkbox\">` (§5.4)")
        }
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return addDiag(st, env.file, a.span, "E-ATTR-010", "`" + a.name + "` requires a reactive `@` place: `" + a.name + "=@x` (§5.4)")
        if (!atRooted(x)) return addDiag(st, env.file, a.span, "E-ATTR-010", "`" + a.name + "` requires a reactive `@` place — a plain value is not written back (§5.4)")
        const rp: RPlace = resolvePlace(env, x, st)
        st = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, x.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        const pt: Type | not = p.ty
        if (pt is given) {
            const bad: string = bindTypeProblem(kind, pt)
            if (bad == "coerce") return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`bind:value` to a `" + typeName(pt) + "` place needs a number coercion of the element's text, which is not in the bootstrap (only string places)")
            if (bad != "") return addDiag(st, env.file, a.span, "E-TYPE-031", "`" + a.name + "` writes " + bad + ", and `" + placeKey(x) + "` is `" + typeName(pt) + "` (§5.4)")
        }
        let rw: RWriteFact = { w: not, st: st }
        if (p.path.length == 0) {
            rw = wholeFieldWrite(env, p, f, x, "", st, a.span)
        } else {
            rw = fieldAtWrite(env, p, f, x, "", st, a.span)
        }
        st = rw.st
        const w: WriteFact | not = rw.w
        if (w is not) return st
        // s444 Phase B (RULED S442 (2)): the target field's validators land on
        // this native element — "wherever the bind is written"; a hand-written
        // attribute of the same name wins (it is the element's markup)
        let vattrs: HtmlAttrPair[] = []
        if (p.path.length == 0) {
            const lb: RPairs = bindValAttrs(env, e, a, f, kind, st)
            vattrs = lb.ps
            st = lb.st
        }
        const m: RSym = mint(st, "v")
        return addAttr(m.st, a.nid, AttrKind.ABind(kind, w, p.decl.sym, p.idx, m.s, vattrs))
    }

    fn firstBind(attrs: AAttr[]) -> AAttr | not {
        for (const a of attrs) {
            if (a.name.substring(0, 5) == "bind:") return a
        }
        return not
    }

    type RPairs:struct = { ps: HtmlAttrPair[], st: AS }

    // Each validator's HTML attributes, where they apply to this element (HTML's
    // own applicability: `required` on text-like inputs / textarea / select;
    // `minlength` / `maxlength` / `pattern` on text-like inputs (and textarea
    // for the lengths); `min` / `max` on number / range / date-time inputs).
    // s449: an attribute HTML does not apply to THIS element is simply not
    // written (§55.17.1: "No other validator is lowered") — the validator is
    // not inert: the §55 surface evaluates it and the §55.17 gate enforces it.
    // (Was: refused, when the HTML attribute was the only enforcement.)
    //
    // s468 — several validators lowering to ONE attribute name: the attribute
    // states their INTERSECTION, never the first one's bound. §55.12:
    // "Validators on a single cell COMPOSE" — the value must pass every one —
    // and §55.17.1 item 1 lowers each (`length(>=N)` → `minlength="N"`,
    // `length(<=N)` → `maxlength="N"`, `min(n)` → `min`, `max(n)` → `max`).
    // So `length(>2) length(==4)` is `minlength="4" maxlength="4"` (the
    // tightest of each bound: the largest `minlength` / `min`, the smallest
    // `maxlength` / `max`). The bootstrap kept the first pair of a name, so
    // that pair wrote `minlength="3"` — the browser's constraint looser than the
    // declaration (gap g-bootstrap-two-validators-same-html-attr-first-wins).
    // `required` repeats as itself. Two DIFFERENT `pattern`s cannot be stated by
    // one HTML `pattern` (an intersection of two regexes is not a regex the
    // attribute can carry exactly — §55.17.1 lowers `pattern` "only when the
    // lowering is exact") — refused, never one silently kept. A hand-written
    // attribute is judged against the combined value (handAttrConflict).
    fn bindValAttrs(env: Env, e: AElem, a: AAttr, f: FieldInfo, kind: BindKind, st0: AS) -> RPairs {
        let st: AS = st0
        let out: HtmlAttrPair[] = []
        const itype: string = inputType(e)
        for (const v of f.vals) {
            for (const h of v.attrs) {
                if (htmlApplies(h.name, e.tag, itype, kind)) {
                    const prev: HtmlAttrPair | not = pairNamed(out, h.name)
                    if (prev is not) {
                        out = out.concat([h])
                    } else if (h.name == "pattern" && h.value != prev.value) {
                        st = addDiag(st, env.file, v.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + f.sym.hint + "` has two `pattern(…)` validators, and one HTML `pattern` attribute on this `<" + e.tag + ">` cannot state both (§55.12: validators compose; §55.17.1 lowers `pattern` only when exact) — the bootstrap would keep one and the browser's constraint would be looser than the declaration; combine them into one pattern")
                    } else {
                        out = replacePair(out, { name: h.name, value: tighterBound(h.name, prev.value, h.value) })
                    }
                }
            }
        }
        for (const h of out) {
            if (attrNamed(e.attrs, h.name) is given) st = handAttrConflict(env, e, f, validatorsLowering(f, h.name), h, st)
        }
        let ps: HtmlAttrPair[] = []
        for (const h of out) {
            if (attrNamed(e.attrs, h.name) is not) ps = ps.concat([h])
        }
        return { ps: ps, st: st }
    }

    fn pairNamed(ps: HtmlAttrPair[], n: string) -> HtmlAttrPair | not {
        for (const p of ps) {
            if (p.name == n) return p
        }
        return not
    }

    fn replacePair(ps: HtmlAttrPair[], h: HtmlAttrPair) -> HtmlAttrPair[] {
        let out: HtmlAttrPair[] = []
        for (const p of ps) {
            if (p.name == h.name) {
                out = out.concat([h])
            } else {
                out = out.concat([p])
            }
        }
        return out
    }

    // The tighter of two lowered bounds of one attribute: the larger lower bound
    // (`minlength`, `min`), the smaller upper bound (`maxlength`, `max`); any
    // other attribute (`required`, an equal `pattern`) is the same text.
    fn tighterBound(name: string, a: string, b: string) -> string {
        const x: number = Number(a)
        const y: number = Number(b)
        if (name == "minlength" || name == "min") {
            if (y > x) return b
            return a
        }
        if (name == "maxlength" || name == "max") {
            if (y < x) return b
            return a
        }
        return a
    }

    // The names of the validators of `f` that lower to attribute `name`, for a message.
    fn validatorsLowering(f: FieldInfo, name: string) -> string {
        let names: string[] = []
        for (const v of f.vals) {
            if (pairNamed(v.attrs, name) is given && names.indexOf(v.name) < 0) names = names.concat([v.name])
        }
        return names.join("` + `")
    }

    // r2 F6: a hand-written attribute of a lowered validator's name. The same
    // static text is the same constraint (the element's markup renders it); a
    // different one (`minlength="1"` against `length(>=3)`), or a computed one,
    // contradicts the declaration's contract on the one element the browser
    // checks — refused, never silently one or the other (fail-closed; ⚑ PA:
    // §55 does not say which wins — §53.7.1's analogous `type` rule lets the
    // derived attribute win with a warning).
    fn handAttrConflict(env: Env, e: AElem, f: FieldInfo, vname: string, h: HtmlAttrPair, st: AS) -> AS {
        const ha: AAttr | not = attrNamed(e.attrs, h.name)
        if (ha is not) return st
        if (isStaticAttr(ha.value) && staticAttrText(e.attrs, h.name) == h.value) return st
        return addDiag(st, env.file, ha.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + h.name + "` is written by hand on this `<" + e.tag + ">`, and `" + f.sym.hint + "`'s validator `" + vname + "` lowers to `" + h.name + "=\"" + h.value + "\"` here — the two disagree on the constraint the browser checks; remove the hand-written `" + h.name + "` (the declaration's validator is the contract, dpa-058 RULED S442 (2))")
    }

    fn isStaticAttr(v: AAttrValue) -> boolean {
        return match v {
            .Quoted(v: s) :> true
            .NoValue :> true
            .Bare(e: x) :> false
            .Paren(e: x) :> false
            .Braced(b: b) :> false
        }
    }

    fn inputType(e: AElem) -> string {
        if (e.tag != "input") return ""
        const t: string = staticAttrText(e.attrs, "type")
        if (t == "") return "text"
        return t.toLowerCase()
    }

    fn isTextInput(t: string) -> boolean {
        return t == "text" || t == "search" || t == "url" || t == "tel" || t == "email" || t == "password"
    }

    fn isRangedInput(t: string) -> boolean {
        return t == "number" || t == "range" || t == "date" || t == "month" || t == "week" || t == "time" || t == "datetime-local"
    }

    fn htmlApplies(name: string, tag: string, itype: string, kind: BindKind) -> boolean {
        const isValue: boolean = kind == BindKind.Value
        if (!isValue) return false
        if (name == "required") return tag == "textarea" || tag == "select" || (tag == "input" && (isTextInput(itype) || isRangedInput(itype)))
        if (name == "minlength" || name == "maxlength") return tag == "textarea" || (tag == "input" && isTextInput(itype))
        if (name == "pattern") return tag == "input" && isTextInput(itype)
        if (name == "min" || name == "max") return tag == "input" && isRangedInput(itype)
        return false
    }

    // "" = the value a bind writes fits the place; "coerce" = a numeric place
    // (bind:value); else what the bind writes.
    fn bindTypeProblem(kind: BindKind, t: Type) -> string {
        let inner: Type = t
        const mi: Type | not = maybeInner(t)
        if (mi is given) inner = mi
        const isValue: boolean = kind == BindKind.Value
        if (isValue) {
            if (inner == Type.Str) return ""
            if (inner == Type.Int || inner == Type.Num) return "coerce"
            return "a string"
        }
        if (inner == Type.Bool) return ""
        return "a boolean"
    }

    // Is `e` a place rooted in `@` (`@x`, `@x.f`, `@h.f.g`)?
    fn atRooted(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> true
            .Member(obj: o) :> atRooted(o)
            .AtItem :> true
            .Name(name: n) :> false
            .Num(raw: r) :> false
            .Str(v: x) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // A static attribute's text ("" when absent or not a quoted literal).
    fn staticAttrText(attrs: AAttr[], name: string) -> string {
        const a: AAttr | not = attrNamed(attrs, name)
        if (a is not) return ""
        const v: AAttrValue = a.value
        return match v {
            .Quoted(v: s) :> s
            .NoValue :> ""
            .Bare(e: x) :> exprName(x)
            .Paren(e: x) :> ""
            .Braced(b: b) :> ""
        }
    }

    fn handleByOwnerName(env: Env, owner: int, name: string) -> HandleInfo | not {
        for (const h of env.g.handles) {
            if (h.owner == owner && h.name == name) return h
        }
        return not
    }

    // A USE of a declaration (§66.6.1): a new instance; its attributes are
    // construction (§66.14 rule 4, L6 / O60 — the printer seeds a field with a
    // capability and derives one without).
    fn resolveUse(env: Env, e: AElem, d: DeclSrc, st0: AS) -> AS {
        const penv: Env = elemPresentEnv(env, e)
        let st: AS = st0
        let alias: Sym | not = not
        for (const a of e.attrs) {
            if (a.name == "as") {
                const n: string = bareName(a.value)
                const h: HandleInfo | not = lookupHandle(env, n)
                if (h is given) alias = h.sym
                st = addAttr(st, a.nid, AttrKind.AAs)
            } else if (isChainAttr(a.name)) {
                st = resolveIfValue(env, a.value, st)
                st = addAttr(st, a.nid, AttrKind.AIf)
            } else {
                const i: int = fieldIndex(d.info, a.name)
                if (i < 0 && a.name == "show") {
                    // s451: §17.2 `show=` hides an ELEMENT; a use is not one.
                    // s462 (O18 RULED, §66.6.9 rule 2): an undeclared attribute on a
                    // use — E-DECL-USE-ATTR (was E-BOOTSTRAP-UNSUPPORTED).
                    st = addDiag(st, env.file, a.span, "E-DECL-USE-ATTR", "`<" + e.tag + ">` has no attribute `show` — a use is not an element, so `show=` (§17.2) has nothing to hide; wrap the use in one: `<div show=…><" + e.tag + " …/></div>` (§66.6.9)")
                } else if (i < 0 && a.name == "key") {
                    // s462 (§66.6.9 rule 4, dpa-069 D-7): never a DOM attribute, never a reconciliation key
                    st = addDiag(st, env.file, a.span, "E-DECL-USE-ATTR", "`<" + e.tag + ">` has no attribute `key` — `key=` on a use is neither a DOM attribute nor a reconciliation key; an instance in an `<each>` row is keyed by the row's `key=` (§66.6.9, §66.7.3)")
                } else if (i < 0) {
                    // s462 (O18 RULED, §66.6.9 rule 2): every undeclared attribute —
                    // `class`, `style`, `id`, `aria-*`, `data-*`, `on…`, `bind:…`,
                    // `key=`, a misspelled field — is refused; nothing falls through
                    // to an element of the renders.
                    st = addDiag(st, env.file, a.span, "E-DECL-USE-ATTR", "`<" + e.tag + ">` has no attribute `" + a.name + "` — a use carries only its declaration's declared attributes and fields, `as=`, and `if=` / `else-if=` / `else`; nothing it writes reaches an element of the renders (§66.6.9)")
                } else {
                    const f: FieldInfo = d.info.fields[i]
                    st = resolveConstructValue(penv, a.value, f.ty, st)
                    st = addAttr(st, a.nid, AttrKind.AConstruct(i))
                }
            }
        }
        // s473 (g-boot-no-value-cell-runtime-throw-s473, the use-site limb): an attribute
        // declared with no default that this use does not set has no value when the
        // instance is constructed — it compiled clean and threw at construction (the
        // printer's `noDefault`). Whether such an attribute is REQUIRED at every use (the
        // §15.10 E-COMPONENT-010 analog) or takes a canonical empty is ⚑ O33 (OPEN, §66.3):
        // refused at compile time, by name, as resolveStarShared does for `<*x/>`.
        // (a declaration that did not parse whole is its parse error's — not judged here; nor
        // is a use whose attributes were just refused — a misspelled or `bind:` attribute is
        // E-DECL-USE-ATTR's, #1676 review F5)
        const declErrs: boolean = hasErrIn(fileErrs(env.g.files, d.file), d.info.span) || errorWithin(st, env.file, e.span)
        for (const f of d.info.fields) {
            if (!declErrs && isAttributeRole(f.role) && !hasOwnValue(f.init) && !useSets(e.attrs, f.sym.hint)) {
                st = addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + e.tag + ">`'s attribute `" + f.sym.hint + "` has no default, and this use does not set it — whether an attribute without a default is required at every use or takes a canonical empty is ⚑ O33 (OPEN, §66.3); set it here (`" + f.sym.hint + "=…`) or give it a default")
            }
        }
        // s473 (ruled refusals) — §66.6.8 interim (S473 D12): "Until O51 is
        // ruled, an implementation of the §66 dialect SHALL refuse BOTH a plain
        // use `<x/>` and a reference `<*x/>` of a declaration that has no
        // `renders`, with a named refusal that cites O51 … An `as=`-bound use is
        // the same plain use and is refused with it". (`<*x/>`: resolveStarShared.)
        // (a declaration file that did not parse whole — its `renders` may be what was dropped — is its errors')
        const rn: ANode[] = rendersNodes(d)
        if (rn.length == 0 && fileErrs(env.g.files, d.file).length == 0) {
            st = addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + e.tag + "/>` — `<" + e.tag + ">` has no `renders`, and a use of a declaration with no `renders` is ⚑ O51 (§66.6.8, not ruled: an error, or a data-only instance). Until O51 is ruled it is refused, `as=`-bound uses included (S473 D12); give `<" + e.tag + ">` a `renders`, or keep its state in program cells")
        } else if (hasContentKids(e.kids) && slotsIn(rn).length == 0 && loopSlotsIn(rn).length == 0) {
            // §66.15.2 rule 1 (S473 D11): children with no slot
            st = addDiag(st, env.file, e.span, "E-COMPONENT-021", "`<" + e.tag + ">` is given content between its tags, but its `renders` holds no `<slot/>` — the content would have nowhere to go (§66.15.2 rule 1, S473 D11). Add `<slot/>` to `<" + e.tag + ">`'s `renders` where the content belongs, or remove the content")
        }
        st = addElem(st, e.nid, ElemFact.MUse(d.info.sym, alias))
        // s449 (from U0 review F1): an effect in USE-SITE SLOT CONTENT (§66.15.2)
        // is rendered wherever the declaration's `renders` places `<slot/>` —
        // zero times (the effect would be dropped) or several (it would run once
        // per placement). Which scope owns slot content is not settled, so the
        // bootstrap refuses it, as it refuses an effect in a `renders`.
        for (const sp of kidEffectSpans(e.kids)) {
            st = addDiag(st, env.file, sp, "E-BOOTSTRAP-UNSUPPORTED", "an effect in the slot content of `<" + e.tag + ">` is not in the bootstrap — slot content is rendered once per `<slot/>` in its `renders` (possibly never, possibly twice), and which scope owns it is not settled (§6.7.4 / §66.15.2); write the effect outside the use")
        }
        return resolveNodes(penv, e.kids, st)
    }

    fn resolveConstructValue(env: Env, v: AAttrValue, t: Type, st: AS) -> AS {
        return match v {
            .Quoted(v: s) :> st
            .Bare(e: e) :> resolveExpr(env, e, t, st).st
            .Paren(e: e) :> resolveExpr(env, e, t, st).st
            .NoValue :> st
            .Braced(b: b) :> addDiag(st, env.file, b.span, "E-DECL-USE-ATTR", "a construction value is an expression, not a block")
        }
    }

    // `<each in=… key=… as name>` (§17.7): a row scope with its own binding and handles (§66.7.4).
    fn resolveEach(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        let srcTy: Type | not = not
        let asName: string = ""
        for (const a of e.attrs) {
            if (a.name == "in") {
                const ex: AExpr | not = valueExpr(a.value)
                if (ex is given) {
                    const r: RX = resolveExpr(env, ex, not, st)
                    st = r.st
                    srcTy = r.x.ty
                }
                st = addAttr(st, a.nid, AttrKind.AEachIn)
            } else if (a.name == "as") {
                asName = bareName(a.value)
                st = addAttr(st, a.nid, AttrKind.AEachAs)
            }
        }
        if (asName == "") asName = "item"
        let elemTy: Type | not = not
        if (srcTy is given) elemTy = seqElem(unMaybe(srcTy))    // `S | not` iterates `S` (§17.7.2)
        const rs: RSym = mint(reservedName(st, env.file, e.span, asName), asName)
        st = rs.st
        let rowHandles: HandleInfo[] = []
        let hsyms: Sym[] = []
        for (const h of env.g.handles) {
            if (h.owner == e.nid) {
                rowHandles = rowHandles.concat([h])
                hsyms = hsyms.concat([h.sym])
            }
        }
        const row: RowB = { bind: rs.s, ty: elemTy }
        const renv: Env = withRow(env, row, asName, rowHandles)
        // `key=` is an attribute of `<each>`, not part of the row TEMPLATE: it
        // reads the row's item, never an `as=` handle of the row it keys
        // (§66.7.3 an instance is "keyed by the row's `key=`"; §66.7.4 a row
        // handle is visible "within that row's template only").
        const kenv: Env = withRow(env, row, asName, [])
        for (const a of e.attrs) {
            if (a.name == "key") {
                st = resolveValue(kenv, a.value, not, st)
                st = addAttr(st, a.nid, AttrKind.AEachKey)
            } else if (a.name != "in" && a.name != "as") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<each " + a.name + "=>` is not in bootstrap slice M2")
            }
        }
        st = eachShapeDiags(env, e, st)
        st = addElem(st, e.nid, ElemFact.MEach(rs.s, hsyms))
        return resolveNodes(renv, e.kids, st)
    }

    // s473 — §17.7.2: "An `<each>` opener SHALL carry exactly one of `in=expr`
    // or `of=expr` (`E-EACH-ITER-SHAPE`)", and "An `<each>` with no body
    // content is `E-EACH-EMPTY-BODY`". Neither was checked: `<each>` with no
    // `in=` compiled to `rt.each(() => null, …)` and threw at mount; an empty
    // body rendered nothing. `of=` itself is refused above (not in the
    // bootstrap); an `in=` without an expression (quoted, valueless, braced)
    // names no sequence, so it is the same fault.
    fn eachShapeDiags(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        let ins: int = 0
        let ofs: int = 0
        let inExpr = false
        for (const a of e.attrs) {
            if (a.name == "in") {
                ins = ins + 1
                // a quoted `in="…"` is a string, judged by the typer (E-EACH-NOT-SEQUENCE)
                if (valueExpr(a.value) is given || quotedValue(a.value) is given) inExpr = true
            }
            if (a.name == "of") ofs = ofs + 1
        }
        if (ins + ofs != 1) {
            st = addDiag(st, env.file, e.span, "E-EACH-ITER-SHAPE", "`<each>` carries exactly one of `in=expr` (a sequence) or `of=expr` (a count) (§17.7.2) — this one has " + (ins + ofs == 0 ? "neither" : "more than one") + ": `<each in=@items>…</each>`")
        } else if (ins == 1 && !inExpr) {
            st = addDiag(st, env.file, e.span, "E-EACH-ITER-SHAPE", "`<each in=…>` takes an expression — `in=@items` or `in=(…)`; a valueless or braced `in=` names no sequence (§17.7.2)")
        }
        let body = false
        for (const k of e.kids) { if (!blankNode(k)) body = true }
        if (!body) st = addDiag(st, env.file, e.span, "E-EACH-EMPTY-BODY", "`<each>` has no body — it needs a per-item template (`<li>…</li>`) to render for each item (§17.7.2)")
        return st
    }

    // =========================================================================
    // Phase B driver.
    // =========================================================================
    fn handlesOwnedBy(g: Globals, owner: int) -> HandleInfo[] {
        let out: HandleInfo[] = []
        for (const h of g.handles) {
            if (h.owner == owner) out = out.concat([h])
        }
        return out
    }

    // =========================================================================
    // s472 — FILE-SCOPE CONSTANTS (`[export] const NAME[: T] = init;` at the
    // top level of a `${ }` logic block).
    //
    // SPEC §7.6: "A variable declared with `let` or `const` at the top level of
    // a file-level `${}` block SHALL be in scope for all subsequent `${}` blocks
    // and markup interpolations in the same file"; "Variables declared inside a
    // function body within a `${}` block are scoped to that function" (so a
    // function's own local, or a parameter, of the name SHADOWS it — §7.3.3:
    // "Shadowing in a NESTED block … is legal"). §21.2: `export const Name = …`
    // exports it; §21.3 imports it like any exported name (the s472 file scope:
    // KConst entries, a private constant stays private).
    //
    // WHAT THE BOOTSTRAP BUILDS — a constant whose value is fixed at compile
    // time: its initializer is literals, unit enum variants, other constants,
    // a member read (`S.length`, `E.V`), and the operators over them (unary,
    // binary but `|>`, the conditional, a template). §7.4.2 names exactly this
    // class ("a literal, `const`-bound to a literal, simple arithmetic on
    // constants"): such a value does nothing when evaluated, so evaluating it
    // once at module initialization (§7.6: "it runs ONCE, at file init") in
    // each artifact that reads it is its whole meaning, wherever it is placed.
    // lower puts each constant in Core ONCE (CoreProgram.consts — a read is
    // `Local(sym)`); each printer emits one module-level `const` for every
    // constant its artifact's code reads, transitively (print.scrml
    // constsReadIn) — so the value reaches the client artifact only where
    // client code reads it, and the server artifact only where server code
    // does. (Review #1617 MED-1: the first cut inlined every read, re-lowering
    // initializers recursively — exponential in constant-on-constant depth.)
    //
    // REFUSED BY NAME (E-BOOTSTRAP-UNSUPPORTED, constBlocker) — an initializer
    // that DOES something when evaluated: a call, a cell read, a query, a
    // `match` / handling form, an index, a function value, a tape / struct
    // literal. The SPEC is silent on where such an initializer runs for a
    // file-scope binding (§12.2: route inference places FUNCTIONS — "an `import`
    // is file-scoped and cannot itself be placed"; Trigger 3's S331 note: a
    // server-only reach in a non-function position "does not escalate"), so a
    // file-scope `const` holding a `?{}` result or a server value has no stated
    // home. Fail closed. An initializer reads only the constants initialized
    // BEFORE it (earlier in its file, or in a file it imports — link order), so
    // there is no cycle and no read of an uninitialized binding.
    // =========================================================================
    export type ConstInfo:struct = {
        sym: Sym, nid: int, span: ASpan, file: string, name: string, exported: boolean,
        annot: Type | not,    // the written type, resolved (`not`: none written, or it did not resolve)
        ty: Type | not,       // the constant's type: `annot`, else the initializer's (constPass)
        init: AExpr,
        ready: boolean,       // initialized at this point of constPass (a later one is not)
        ok: boolean,          // admitted (constPass) — a refused one has no value
    }
    type RConsts:struct = { cs: ConstInfo[], st: AS }

    // phaseA: every constant's Sym and written type, in link order then source order.
    fn constStubs(files: FileAst[], te0: TypeEnv, st0: AS) -> RConsts {
        let st: AS = st0
        let out: ConstInfo[] = []
        for (const f of files) {
            const te: TypeEnv = teAt(te0, f.path)
            const errs: ASpan[] = fileErrs(files, f.path)
            for (const c of constItems(f.items)) {
                const rs: RSym = mint(reservedName(st, f.path, c.span, c.name), c.name)
                st = rs.st
                let annot: Type | not = not
                const at: AType | not = c.ty
                if (at is given) {
                    if (!hasErrIn(errs, at.span)) {
                        const rt: RType = resolveType(te, at, st)
                        st = rt.st
                        if (!rt.unresolved) annot = rt.t
                    }
                }
                out = out.concat([{ sym: rs.s, nid: c.nid, span: c.span, file: f.path, name: c.name, exported: c.exported,
                                    annot: annot, ty: annot, init: c.init, ready: true, ok: true }])
            }
        }
        return { cs: out, st: st }
    }

    fn withConsts(g: Globals, cs: ConstInfo[]) -> Globals {
        return { program: g.program, entry: g.entry, te: g.te, types: g.types, decls: g.decls, fns: g.fns, handles: g.handles, files: g.files,
                 errorSym: g.errorSym, sqlErrorSym: g.sqlErrorSym, sceSym: g.sceSym, voids: g.voids, hostSites: g.hostSites, consts: cs }
    }

    fn constAs(c: ConstInfo, ty: Type | not, ready: boolean, ok: boolean) -> ConstInfo {
        return { sym: c.sym, nid: c.nid, span: c.span, file: c.file, name: c.name, exported: c.exported,
                 annot: c.annot, ty: ty, init: c.init, ready: ready, ok: ok }
    }

    // Each constant's initializer, bound in order: while the k-th is bound,
    // the ones from k on are not initialized yet (`ready: false` — a read of
    // one is E-SCOPE-001, resolveName).
    fn constPass(g: Globals, st0: AS) -> RGlobals {
        let st: AS = st0
        let done: ConstInfo[] = []
        let i = 0
        while (i < g.consts.length) {
            let rest: ConstInfo[] = []
            let j = i
            while (j < g.consts.length) {
                rest = rest.concat([constAs(g.consts[j], g.consts[j].ty, false, g.consts[j].ok)])
                j = j + 1
            }
            const r: RConst1 = constValue(withConsts(g, done.concat(rest)), g.consts[i], st)
            st = r.st
            done = done.concat([r.c])
            i = i + 1
        }
        return { g: withConsts(g, done), st: st }
    }

    type RConst1:struct = { c: ConstInfo, st: AS }

    fn constEnv(g: Globals, file: string) -> Env {
        return { g: g, file: file, ctx: CtxK.InFn, locals: [], rows: [], handles: [], inRenders: false, narrows: [], present: [],
                 host: HostCtx.HostNo, own: "", inEffect: false, fx: noFailCtx(), lift: LiftCtx.NoLift }
    }

    fn constValue(g: Globals, c: ConstInfo, st0: AS) -> RConst1 {
        const b: AExpr | not = constBlocker(c.init)
        if (b is given) {
            const st1: AS = addDiag(st0, c.file, b.span, "E-BOOTSTRAP-UNSUPPORTED", "the initializer of the file-scope constant `" + c.name + "` holds " + blockerWhat(b) + " — the bootstrap builds a file-scope `const` whose value is fixed at compile time: literals, unit enum variants, other constants, a member read and the operators over them (§7.4.2: \"a literal, `const`-bound to a literal, simple arithmetic on constants\"). Anything else would have to be evaluated at module initialization, which the bootstrap does not build for a file-scope binding" + blockerWhy(b) + ". Compute the value in a function and call it where it is needed")
            return { c: constAs(c, c.annot, true, false), st: st1 }
        }
        const env: Env = withWholeAt(constEnv(g, c.file), c.init.nid, "the initializer of `" + c.name + "`")
        const ri: RX = resolveExpr(env, c.init, c.annot, st0)
        let st: AS = addBind(ri.st, c.nid, BindFact.BBind(c.sym))
        let ty: Type | not = c.annot
        if (ty is not) ty = ri.x.ty
        if (ty is not) {
            // (not when binding the initializer already failed — that report owns it: no cascade)
            if (!recoveredInit(c.init) && ri.st.diags.length == st0.diags.length) st = addDiag(st, c.file, c.span, "E-BOOTSTRAP-UNSUPPORTED", "the type of the file-scope constant `" + c.name + "` is not known from its initializer — write it: `const " + c.name + ": T = …;`")
            return { c: constAs(c, not, true, false), st: st }
        }
        return { c: constAs(c, ty, true, true), st: st }
    }

    fn recoveredInit(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Recovered :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: x) :> false
            .Str(v: x) :> false
            .Bool(v: x) :> false
            .NotLit :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: x) :> false
            .ObjectLit(props: x) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: x) :> false
            .Sql(q: x) :> false
            .Handled(h: x) :> false
            .Template(quasis: x) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // The first sub-expression of a constant's initializer that DOES something
    // when evaluated (see the section header), else `not`. A name is left to
    // the binder (a constant, else whatever it names is refused there: a
    // function named without a call is E-BOOTSTRAP-UNSUPPORTED, an unknown
    // name E-SCOPE-001); a parse-error placeholder is the parser's.
    fn constBlocker(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> not
            .Num(raw: r) :> not
            .Str(v: v) :> not
            .Bool(v: v) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o, name: n) :> constBlocker(o)
            .Unary(op: o, e: x) :> constBlocker(x)
            .Binary(op: o, l: l, r: r) :> binaryBlocker(e, o, l, r)
            .Ternary(test: t, yes: y, no: n) :> firstBlocker([t, y, n])
            .Template(quasis: q, slots: ss) :> firstBlocker(ss)
            .Foreign(f: fb0) :> not      // s473: the binder's E-FOREIGN-004 (§23.2.4), not this refusal
            .At(name: n) :> e
            .AtItem :> e
            .Call(callee: c) :> e
            .Assign(target: t) :> e
            .ArrayLit(elems: x) :> e
            .ObjectLit(props: x) :> e
            .Spread(e: x) :> e
            .Index(obj: o) :> e
            .Lambda(params: x) :> e
            .Sql(q: x) :> e
            .Handled(h: x) :> e
        }
    }

    // `x |> f` is a call (§ pipe); every other operator is a value.
    fn binaryBlocker(e: AExpr, op: BinOp, l: AExpr, r: AExpr) -> AExpr | not {
        if (op == BinOp.Pipe) return e
        return firstBlocker([l, r])
    }

    fn firstBlocker(es: AExpr[]) -> AExpr | not {
        for (const x of es) {
            const b: AExpr | not = constBlocker(x)
            if (b is given) return b
        }
        return not
    }

    fn blockerWhat(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> "a cell read (`@" + n + "`)"
            .AtItem :> "a read of the current `<each>` item (`@.`)"
            .Call(callee: c) :> callWhat(c)
            .Assign(target: t) :> "an assignment"
            .ArrayLit(elems: x) :> "a tape literal (a file-scope tape constant is not in the bootstrap yet)"
            .ObjectLit(props: x) :> "a struct literal (a file-scope struct constant is not in the bootstrap yet)"
            .Spread(e: x) :> "a spread"
            .Index(obj: o) :> "an index read"
            .Lambda(params: x) :> "a function value"
            .Sql(q: x) :> "a query (`" + sqlSigil() + " … }`)"
            .Handled(h: x) :> "a `match` or a handling form"
            .Binary(op: o) :> "a pipe (`|>`, a call)"
            .Name(name: n) :> "`" + n + "`"
            .Num(raw: r) :> "a number"
            .Str(v: v) :> "a string"
            .Bool(v: v) :> "a boolean"
            .NotLit :> "`not`"
            .Recovered :> "an unparsed expression"
            .Variant(name: n) :> "a variant"
            .Member(obj: o) :> "a member read"
            .Unary(op: o) :> "an operator"
            .Ternary(test: t) :> "a conditional"
            .Template(quasis: q) :> "a template"
            .Foreign(f: fb0) :> "a foreign code block"
        }
    }

    // Why the blocked initializer has no file-scope evaluation: a cell read
    // has its meaning (§6.6.2 — a snapshot at declaration time) but the
    // bootstrap has no module-init evaluation; for the rest the SPEC does not
    // say where a file-scope initializer runs (g-spec-file-scope-binding-placement-s472).
    fn blockerWhy(b: AExpr) -> string {
        if (atName(b) != "") return " (§6.6.2: `const x = @c` is a snapshot taken at declaration time; for a value that follows `@c`, declare a derived cell `<x:T = @c/>`)"
        return " — and the SPEC does not say where such an initializer runs: the client, the server, or both (§12 places functions, not bindings)"
    }

    // s472 (after #1608): `.V(args)` / `E.V(args)` is a payload-variant VALUE, not a call.
    fn callWhat(callee: AExpr) -> string {
        const k: AExprK = callee.k
        const variant: boolean = match k {
            .Variant(name: n) :> true
            .Member(obj: o) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: x) :> false
            .Str(v: x) :> false
            .Bool(v: x) :> false
            .NotLit :> false
            .Recovered :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: x) :> false
            .ObjectLit(props: x) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: x) :> false
            .Sql(q: x) :> false
            .Handled(h: x) :> false
            .Template(quasis: x) :> false
            .Foreign(f: fb0) :> false
        }
        if (variant) return "a call or a payload-variant value (a file-scope payload-variant constant is not in the bootstrap yet)"
        return "a call"
    }

    // The constant `name` denotes in `file` (declared there, or imported from a
    // file that exports it), else `not`.
    fn constNamed(g: Globals, file: string, name: string) -> ConstInfo | not {
        const from: string = scopeFrom(g.te.link, file, NameKind.KConst, name)
        if (from == "") return not
        const orig: string = scopeOrig(g.te.link, file, NameKind.KConst, name)   // s474: an alias names its export
        for (const c of g.consts) {
            if (c.file == from && c.name == orig) return c
        }
        return not
    }

    fn declEnv(g: Globals, ds: DeclSrc, inRenders: boolean) -> Env {
        return { g: g, file: ds.file, ctx: CtxK.InDecl(ds.info.sym, ds.isProgram), locals: [], rows: [],
                 handles: handlesOwnedBy(g, ds.info.nid), inRenders: inRenders, narrows: [], present: [],
                 host: HostCtx.HostNo, own: "", inEffect: false, fx: noFailCtx(), lift: LiftCtx.NoLift }
    }

    fn phaseB(g: Globals, st0: AS) -> AS {
        let st: AS = st0
        for (const ds of g.decls) {
            // initializers (L2: the instance under construction is Lexical(0))
            const ienv: Env = declEnv(g, ds, false)
            for (const f of ds.info.fields) {
                st = resolveValue(ienv, f.init, f.ty, st)
            }
            // renders
            const renv: Env = declEnv(g, ds, true)
            st = resolveNodes(renv, rendersNodes(ds), st)
            // s442: state-child bodies (O5 (1i)), in the same context
            for (const sb of stateBodyLists(ds)) {
                st = resolveNodes(renv, sb, st)   // s451: one sibling list each (if-chains)
                // s472 r1 (MED-1): a program-level engine's state child resolves in the
                // program context, so resolveDb cannot see it — judged here
                if (ds.isProgram) st = refuseStateChildDbFns(g, ds.file, sb, st)
            }
            // s442: a child field's own renders (§66.4 rule 2), in the same context;
            // s444: with `@<field>` naming that field of this instance (O54 = (a))
            if (ds.p is not) {
                for (const fd of fieldDecls(ds)) { st = resolveNodes(withOwn(renv, fd.name), rendersOf(fd), st) }
            }
        }
        const prog: DeclSrc | not = findDeclSrc(g, g.program)
        let progHandles: HandleInfo[] = []
        if (prog is given) progHandles = handlesOwnedBy(g, prog.info.nid)
        for (const fs of g.fns) {
            let hs: HandleInfo[] = []
            if (fs.info.file == g.entry) hs = progHandles
            let host: HostCtx = HostCtx.HostOk
            if (fs.info.pure) host = HostCtx.HostPure
            const fx: FailCtx = { inFn: true, fnName: fs.info.name, failable: fs.info.failable, err: fs.info.err, defer: false, subject: -1, whole: -1, fnRef: -1, wholeWhat: "",
                                  fnSym: fs.info.sym.id, serverOwn: fs.info.serverOwn, stmtCall: -1 }
            let env: Env = { g: g, file: fs.info.file, ctx: CtxK.InFn, locals: [], rows: [], handles: hs, inRenders: false, narrows: [], present: [], host: host, own: "", inEffect: false, fx: fx, lift: LiftCtx.NoLift }
            const fte: TypeEnv = teAt(g.te, fs.info.file)
            for (const p of fs.f.params) {
                const rs: RSym = mint(reservedName(st, fs.info.file, p.span, p.name), p.name)
                st = rs.st
                let pty: Type = Type.Str
                let proven: boolean = false
                const at: AType | not = p.ty
                if (at is given) {
                    // a type that failed to parse is not resolved (its parse
                    // error is the diagnostic; the typer treats it as unproven)
                    if (!hasErrIn(fileErrs(g.files, fs.info.file), at.span)) {
                        const rt: RType = resolveType(fte, at, st)
                        pty = rt.t
                        const unresolved: boolean = rt.unresolved
                        st = rt.st
                        if (unresolved) st = badParam(st, p.nid)     // r8: never checked against
                        if (!unresolved) proven = true
                    }
                } else {
                    // s473 (ruled refusals): §7.5 (S469) — the SPEC's code, not E-BOOTSTRAP-UNSUPPORTED.
                    // A NAMELESS parameter is the parser's reading of a form it does not read (a default
                    // value or a rest parameter — g-boot-param-default-and-rest-s473), not a missing type.
                    if (!plainParamName(p.name)) {
                        st = addDiag(st, fs.info.file, p.span, "E-BOOTSTRAP-UNSUPPORTED", "a parameter the bootstrap cannot read (a default value `b: int = 1` or a rest parameter `...xs: T[]` is not in the bootstrap) — write a plain `name: Type` parameter")
                    } else st = addDiag(st, fs.info.file, p.span, "E-PARAM-TYPE-REQUIRED", "the parameter `" + p.name + "` has no type — every function parameter carries `: T` (§7.5, S469): write `" + p.name + ": Type`. A default does not stand in for the type (`n = 1` → `n: int = 1`)")
                }
                st = addBind(st, p.nid, BindFact.BParam(rs.s, pty))
                // s473 (#1663 F1): a parameter whose type is unwritten or did not resolve
                // (a host type such as `Event`) has NO known type here — its `string`
                // placeholder is not a type the sink judgment may trust (fail closed)
                let lty: Type | not = not
                if (proven) lty = pty
                env = withLocal(env, { name: p.name, s: rs.s, ty: lty, mutable: false, narrowed: not, nDecl: not, fresh: false })
            }
            st = resolveBlock(env, fs.f.body, st)
            st = loopChecks(fs.info.file, fs.f.body, st)     // s469: §49.4 loop control (a function body is a boundary)
            st = deferChecks(fs.info.file, fs.f.body, st)    // s451: §19.16 block-chain rules
        }
        return st
    }

    // =========================================================================
    // THE SCOPE PASS (M3 item 1) — a scope binds each name once.
    //
    // Reads the binder's tables, and the function / handler BODIES of the
    // FileAst for the block rule. Codes, as resolved by the governing-sentence
    // gate (docs/changes/s439-bootstrap-m3-typer/progress.md):
    //   - a FILE-SCOPE duplicate — two cells of the program, two functions of
    //     one file — is E-SCOPE-010 (§7.3.3: "File-scope duplicates are
    //     E-SCOPE-010 (§7.6)"; §7.6.1: a file-level cell declaration takes
    //     part in file scope "identically to file-level `let`/`const`");
    //   - a `let` / `const` that redeclares a name of the SAME block of a
    //     function body (or, in its top-level block, a parameter) is
    //     E-SCOPE-REDECLARE (§7.3.3). A nested block may shadow.
    //   - two `as=` of one name in one scope, or a handle named like a cell:
    //     E-HANDLE-REDECLARE (ruled S440 #5 / #7; SPEC §66.7.2) — dupHandles;
    //   - a duplicate top-level `function`: E-SCOPE-010 (ruled S440 #6; SPEC
    //     §7.6) — dupFns;
    //   - s473: one file-scope name bound twice in one file, WHATEVER the two
    //     name — a user declaration, a type, a function, a constant, in any
    //     pairing (`<card>` beside `fn card`, `type T` beside `fn T`, two
    //     declarations, two types): E-SCOPE-010 (§7.6, ruled S473 "`<card>`
    //     beside `fn card`: REFUSED") — fileNameClashes, dupConsts;
    //   - s474 (door 3, "Same-name components across files, and two files
    //     exporting one name: INTERIM … always per-file qualified"): two files
    //     may each declare or export one name — a component included; a user
    //     declaration's output is keyed by its file (core.scrml scopeKey). Two
    //     same-named exports imported into ONE file: E-SCOPE-010 at the later
    //     import (linkage). (Was S473: E-SCOPE-010 at the second exporter, and
    //     E-COMPONENT-NAME-DUPLICATE for two components.) dupDecls keeps only
    //     the fail-closed file-tag collision (E-BOOTSTRAP-UNSUPPORTED);
    //   - where no ruling / SPEC sentence names one — a handle or a program
    //     cell named like a visible declaration, two fields of one
    //     declaration, two parameters of one name, a redeclaration inside an
    //     inline handler block — the bootstrap-local E-BOOTSTRAP-REDECLARE
    //     (each owes a ruling).
    // =========================================================================
    fn mkDiag(file: string, span: ASpan, code: string, msg: string) -> Diag {
        return newDiag(code, msg, file, span)
    }

    fn offsetOf(span: ASpan) -> string { return "offset " + span.start }

    // The index of the first of `names[0 .. j)` equal to `names[j]`, else -1.
    fn earlierSame(names: string[], j: int) -> int {
        let i = 0
        while (i < j) {
            if (names[i] == names[j]) return i
            i = i + 1
        }
        return -1
    }

    fn checkScopes(files: FileAst[], t: Tables, lk: Linkage) -> Diag[] {
        let out: Diag[] = dupFields(files, t, lk).concat(dupDecls(files, t, lk)).concat(builtinRedeclares(t)).concat(fileNameClashes(files, t, lk)).concat(dupFns(t)).concat(dupHandles(files, t, lk)).concat(dupConsts(files, t))
        for (const f of files) {
            for (const af of fnItems(f.items)) {
                out = out.concat(dupParams(f.path, af.params))
                out = out.concat(blockRedeclares(f.path, af.body, af.params, true))
            }
            out = out.concat(handlerRedeclares(f.path, fileMarkup(f.items)))
        }
        return out
    }

    // Two fields of one declaration. The program's fields ARE the file-scope
    // cells (R4), so a duplicate there is E-SCOPE-010.
    fn dupFields(files: FileAst[], t: Tables, lk: Linkage) -> Diag[] {
        let out: Diag[] = []
        for (const d of t.decls) {
            let names: string[] = []
            for (const f of d.fields) { names = names.concat([f.sym.hint]) }
            let j = 0
            while (j < names.length) {
                const i: int = earlierSame(names, j)
                if (i >= 0) {
                    const f: FieldInfo = d.fields[j]
                    const first: string = offsetOf(d.fields[i].span)
                    if (d.sym.id == t.program.id) {
                        out = out.concat([mkDiag(d.file, f.span, "E-SCOPE-010", "`" + names[j] + "` is already declared at file scope (at " + first + ") — a file-scope name is bound once: duplicate binding in file scope (§7.6, §7.6.1)")])
                    } else {
                        out = out.concat([mkDiag(d.file, f.span, "E-BOOTSTRAP-REDECLARE", "`<" + d.sym.hint + ">` already has a field `" + names[j] + "` (at " + first + ") — a declaration's fields are named once (the SPEC names no code for this; bootstrap-local)")])
                    }
                } else if (d.sym.id == t.program.id && visibleDeclNamed(lk, t, d.file, names[j])) {
                    // `@x` would name both the cell and `<x>`'s shared instance (§66.7.1)
                    out = out.concat([mkDiag(d.file, d.fields[j].span, "E-SCOPE-010", "`" + names[j] + "` — `@" + names[j] + "` already names the shared instance of `<" + names[j] + ">` (§66.7.1); a program cell cannot take that name (a cell named like a visible declaration is E-SCOPE-010, ruled S442)")])
                }
                j = j + 1
            }
        }
        return out
    }

    // Is a user declaration named `name` VISIBLE in `file` — declared there,
    // or imported into it (§21.3)? Only a visible one claims `@name` there.
    // s472: through the file's scope — declared there, or imported FROM ITS
    // FILE (was: any import of the name, whichever file it named).
    fn visibleDeclNamed(lk: Linkage, t: Tables, file: string, name: string) -> boolean {
        // s474: `name` as written here — an alias denotes its export (scopeOrig)
        const from: string = scopeFrom(lk, file, NameKind.KDecl, name)
        if (from == "") return false
        const orig: string = scopeOrig(lk, file, NameKind.KDecl, name)
        for (const d of t.decls) {
            if (d.sym.id != t.program.id && d.sym.hint == orig && d.file == from) return true
        }
        return false
    }

    // s473 — ONE name, ONE binding, in a file, whatever it names. §7.6 (S473): "A
    // file-scope name is bound once in its file, whatever it names". (S473 round 2
    // #5's program-wide rule for EXPORTED names — "two user files exporting the
    // same name is E-SCOPE-010" — is lifted by s474, door 3: "two files exporting
    // one name: INTERIM"; see bindingsClash. Importing two of them into one file
    // is linkage's E-SCOPE-010.) The bindings: a user declaration, a type, a
    // function, a file-scope constant, a program cell (never exported). Two
    // bindings CLASH when they share a name and sit in one file.
    // Each binding after the first of a clash gets ONE report, here, unless:
    //   - another pass already reports AT it (s473 r2 review LOW-1: no two reports
    //     at one span): dupFns (a later function in one file),
    //     dupFields (a later cell, or a cell named like a visible declaration),
    //     dupConsts (a constant beside a cell of its file, E-NAME-COLLIDES-STATE);
    //   - its file imports the name (from a user or a stdlib file) and it is a
    //     kind linkage knows: linkage's report at the import is the one ("an
    //     imported name colliding with a local declaration stays E-SCOPE-010").
    //     A program cell is not such a kind, so a cell beside an import of its
    //     name, from ANY source, is reported here, at the cell (review MED-1);
    //   - every earlier binding it clashes with is a pair another pass reports
    //     (an OWNED pair): a cell and a visible declaration (dupFields, at the
    //     cell), a constant and a cell of one file (dupConsts, at the constant).
    // One owned pair never hides an unowned one (review LOW-1). The report names
    // the first binding it clashes with, by file:line:col (review LOW-5). A local,
    // a parameter, a loop binder shadow (§7.3.3) and are never compared; a host
    // binding's local name is stdlib-only (§21.3.1 — linkage).
    type FileName:struct = { name: string, file: string, span: ASpan, what: string, kind: string, nid: int, exported: boolean }

    // Is the declaration `<name>` of `file` exported (§21.2)?
    fn declExported(lk: Linkage, file: string, name: string) -> boolean {
        for (const o of lk.own) {
            if (o.file == file && o.name == name && o.kind == NameKind.KDecl) return o.exported
        }
        return false
    }

    fn fileNames(t: Tables, lk: Linkage) -> FileName[] {
        let out: FileName[] = []
        for (const d of t.decls) {
            if (d.sym.id != t.program.id) out = out.concat([{ name: d.sym.hint, file: d.file, span: d.span, what: "the declaration `<" + d.sym.hint + ">`", kind: "decl", nid: d.nid, exported: declExported(lk, d.file, d.sym.hint) }])
        }
        for (const ti of t.types) {
            if (ti.file != builtinFile()) out = out.concat([{ name: ti.name, file: ti.file, span: ti.span, what: "the type `" + ti.name + "`", kind: "type", nid: ti.nid, exported: ti.exported }])
        }
        for (const f of t.fns) {
            if (f.host is not) out = out.concat([{ name: f.name, file: f.file, span: f.span, what: "the function `" + f.name + "`", kind: "fn", nid: f.nid, exported: f.exported }])
        }
        // s473 review LOW-1: a constant is one more file-scope binding
        for (const c of t.consts) {
            out = out.concat([{ name: c.name, file: c.file, span: c.span, what: "the constant `" + c.name + "`", kind: "const", nid: c.nid, exported: c.exported }])
        }
        // a program cell (`<count:int=0/>`) — a file-scope binding (§7.6.1), never exported
        for (const d of t.decls) {
            if (d.sym.id == t.program.id) {
                for (const fi of d.fields) {
                    out = out.concat([{ name: fi.sym.hint, file: d.file, span: fi.span, what: "the cell `@" + fi.sym.hint + "`", kind: "cell", nid: fi.nid, exported: false }])
                }
            }
        }
        return out
    }

    // The position of `file` in link order (`files`); an unknown file sorts last.
    fn fileRank(files: FileAst[], file: string) -> int {
        let i = 0
        while (i < files.length) {
            if (files[i].path == file) return i
            i = i + 1
        }
        return files.length
    }

    // Does `m` come before `n` (link order, then source order in one file)?
    fn bindsBefore(files: FileAst[], m: FileName, n: FileName) -> boolean {
        if (m.file == n.file) return m.span.start < n.span.start
        return fileRank(files, m.file) < fileRank(files, n.file)
    }

    // Do `m` and `n` (one name) clash? Only in ONE file. s474 (door 3, "two files exporting one
    // name: INTERIM"): two files may each export a name — each import names its file, so it
    // resolves to one of them; the output names each per file (print.scrml's NameSupply mints
    // one JS name per Sym; a declaration's names carry its file key). Two of them imported into
    // ONE file is the collision, reported there (linkage).
    fn bindingsClash(m: FileName, n: FileName) -> boolean {
        return m.file == n.file
    }

    // "file:line:col" of `offset` in `file` (parse.scrml records each file's line starts).
    fn placeIn(files: FileAst[], file: string, offset: int) -> string {
        for (const f of files) {
            if (f.path == file) {
                let line: int = 0
                let start: int = 0
                for (const st of f.lines) {
                    if (st <= offset) {
                        line = line + 1
                        start = st
                    }
                }
                if (line == 0) return file + " (offset " + offset + ")"
                return file + ":" + line + ":" + (offset - start + 1)
            }
        }
        return file + " (offset " + offset + ")"
    }

    // s473 — does `file` import `name` through an import whose module resolves to
    // no file in the build? That import is refused where it is written
    // (importRefusal: E-IMPORT-006, …), so a tag naming it is not reported again
    // as an unknown element (one report per fault). An import that DOES resolve
    // is not excused here: a tag naming a non-declaration it brings in (a
    // function) stays E-MARKUP-001.
    fn importsNameUnresolved(files: FileAst[], file: string, name: string) -> boolean {
        const paths: string[] = filePaths(files)
        for (const f of files) {
            if (f.path == file) {
                for (const imp of importsOfItems(f.items)) {
                    if (importTarget(f.path, imp.from, paths) == "") {
                        for (const x of imp.names) {
                            if (x.name == name) return true
                        }
                    }
                }
            }
        }
        return false
    }

    // The `from` of an import in `file` that brings `name` into its scope — a
    // plain `import` whose target (a user OR a stdlib file) exports it — else "".
    fn importBringing(files: FileAst[], lk: Linkage, file: string, name: string) -> string {
        const paths: string[] = filePaths(files)
        for (const f of files) {
            if (f.path == file) {
                for (const imp of importsOfItems(f.items)) {
                    const target: string = importTarget(f.path, imp.from, paths)
                    if (target != "") {
                        for (const x of imp.names) {
                            if (x.name == name && exportsName(lk.own, target, x.orig)) return imp.from   // s474: `name` is the local (alias) name
                        }
                    }
                }
            }
        }
        return ""
    }

    // Does another pass report AT the binding `n` (see the header)?
    fn reportedElsewhereAt(files: FileAst[], lk: Linkage, t: Tables, ns: FileName[], n: FileName) -> boolean {
        if (n.kind == "fn") {
            for (const m of ns) {
                if (m.kind == "fn" && m.file == n.file && m.name == n.name && m.span.start < n.span.start) return true
            }
            return false
        }
        // (a declaration: dupDecls reports only a CROSS-file pair — s474 — which never clashes here)
        if (n.kind == "const") {
            for (const m of ns) {
                if (m.kind == "cell" && m.file == n.file && m.name == n.name) return true
            }
            return false
        }
        if (n.kind == "cell") {
            for (const m of ns) {
                if (m.kind == "cell" && m.file == n.file && m.name == n.name && m.span.start < n.span.start) return true
            }
            return visibleDeclNamed(lk, t, n.file, n.name)
        }
        return false
    }

    // Is the clash of the earlier `m` with `n` reported by another pass (an OWNED pair)?
    fn pairOwned(files: FileAst[], lk: Linkage, t: Tables, m: FileName, n: FileName) -> boolean {
        if (m.kind == "cell" && n.kind == "decl" && visibleDeclNamed(lk, t, m.file, m.name)) return true
        if (m.kind == "const" && n.kind == "cell" && m.file == n.file) return true
        return false
    }

    fn fileNameClashes(files: FileAst[], t: Tables, lk: Linkage) -> Diag[] {
        const ns: FileName[] = fileNames(t, lk)
        let out: Diag[] = []
        for (const n of ns) {
            if (!reportedElsewhereAt(files, lk, t, ns, n)) {
                const imported: string = importBringing(files, lk, n.file, n.name)
                // linkage reports a known kind beside an import of its name, at the import
                if (n.kind == "cell" || imported == "") {
                    // the first earlier binding `n` clashes with, in a pair no other pass reports
                    let first: FileName | not = not
                    for (const m of ns) {
                        if (m.name == n.name && bindsBefore(files, m, n) && bindingsClash(m, n) && !pairOwned(files, lk, t, m, n)) {
                            const cur: FileName | not = first
                            if (cur is not || bindsBefore(files, m, cur)) first = m
                        }
                    }
                    if (first is given) {
                        out = out.concat([mkDiag(n.file, n.span, "E-SCOPE-010", "`" + n.name + "` is already bound in this file by " + first.what + " (at " + placeIn(files, first.file, first.span.start) + ") — a file-scope name is bound once, whatever it names (a declaration, a type, a function, a constant, a cell): duplicate binding in file scope (§7.6; ruled S473); rename one")])
                    } else if (n.kind == "cell" && imported != "") {
                        // s473 r2 review MED-1: a cell beside an import of its name, whatever the source
                        out = out.concat([mkDiag(n.file, n.span, "E-SCOPE-010", "`" + n.name + "` is imported from `" + imported + "` and also bound in this file by " + n.what + " — a name is bound once in file scope, an import included (§7.6); rename the cell, or drop the import")])
                    }
                }
            }
        }
        return out
    }

    // s451 (Ue) — §19.8.4: "`SqlError` SHALL be a built-in enum type provided by
    // the compiler. The developer SHALL NOT redefine it." (No code is named:
    // the bootstrap-local redeclaration code, as for the other unnamed cases.)
    // A user `Error` is legal: it shadows the built-in by name (§19.4.2 only
    // makes the built-in the bare `!`'s default).
    fn builtinRedeclares(t: Tables) -> Diag[] {
        let out: Diag[] = []
        for (const ti of t.types) {
            if (ti.file != builtinFile() && ti.name == "SqlError") {
                out = out.concat([mkDiag(ti.file, ti.span, "E-BOOTSTRAP-REDECLARE", "`SqlError` is the built-in enum of query failures (§19.8.1) — \"The developer SHALL NOT redefine it\" (§19.8.4); name this type something else")])
            }
            // s454 (U1b) — §19.9.10: "the developer SHALL NOT redefine it"
            // s473-host-allowlist-b (DRAFT §21.3.3 rule 8.1; ruling: user-voice-scrml.md S473 D34): a user STRUCT or
            // ENUM named like an Appendix H interface (`type Node:struct` — a tree node) SHADOWS the
            // built-in host type in its scope, as a user `Error` shadows the built-in enum
            // (resolveTypeName: a user type wins). It is not refused: the design's "SHALL NOT reuse"
            // would break every program with a `Node` / `Event` / `Text` type, and shadowing is
            // fail-closed for rule 8 (a parameter of the user type is no host root,
            // E-HOST-ROOT-OPAQUE). Only `type Name:host` reusing one is E-SCOPE-010 (parse.scrml).
            if (ti.file != builtinFile() && ti.name == serverCallErrorName()) {
                out = out.concat([mkDiag(ti.file, ti.span, "E-BOOTSTRAP-REDECLARE", "`ServerCallError` is the built-in enum of a client call's boundary failures (§19.9.10: `Unreachable`, `Refused(status)`, `ServerFault(status)`, `Malformed(reason)`) — \"the developer SHALL NOT redefine it\"; name this type something else")])
            }
        }
        return out
    }


    // Two parameters of one name (SPEC-silent: bootstrap-local).
    fn dupParams(file: string, ps: AParam[]) -> Diag[] {
        let out: Diag[] = []
        let names: string[] = []
        for (const p of ps) { names = names.concat([p.name]) }
        let j = 0
        while (j < names.length) {
            const i: int = earlierSame(names, j)
            if (i >= 0) {
                out = out.concat([mkDiag(file, ps[j].span, "E-BOOTSTRAP-REDECLARE", "parameter `" + names[j] + "` is already declared (at " + offsetOf(ps[i].span) + ") — a parameter list names each parameter once (the SPEC names no code for this; bootstrap-local)")])
            }
            j = j + 1
        }
        return out
    }

    // Two user declarations of one name in two FILES (one file: fileNameClashes,
    // E-SCOPE-010). s474 (door 3, user-voice-scrml.md "⭐ RULED — permanent-restrictions
    // re-review: the four one-way doors", item 3): "Same-name components across files, and two
    // files exporting one name: INTERIM. The CSS scope key and output names are always per-file
    // qualified, not only on a collision." Every USE resolves per file (s472, declNamed), and
    // every OUTPUT name of a user declaration — its root's `data-scrml`, its sheet's `@scope`,
    // its `<template>` ids, its module-level bindings — is its per-file key `<name>~<file tag>`
    // (core.scrml scopeKey, lower.scrml declKey), so two files may each declare a `<card>`,
    // a component or not, exported or not. (Was: E-COMPONENT-NAME-DUPLICATE for two components,
    // the bootstrap limit for any other pair.)
    // What stays: FAIL CLOSED if two declarations of one name in two files get ONE key — the
    // file tag is a hash of the path (two independent 32-bit hashes, core.scrml fileTag), so two
    // paths can share it; one key would merge their style scopes and their templates. A
    // collision is rare, not unreachable (s474 r1, review F6) — and never silent:
    // E-BOOTSTRAP-UNSUPPORTED, rename one (or move a file).
    fn dupDecls(files: FileAst[], t: Tables, lk: Linkage) -> Diag[] {
        let out: Diag[] = []
        let users: DeclInfo[] = []
        for (const d of t.decls) {
            if (d.sym.id != t.program.id) users = users.concat([d])
        }
        let j = 0
        while (j < users.length) {
            const d: DeclInfo = users[j]
            let i = 0
            let hit = false
            while (i < j && !hit) {
                const m: DeclInfo = users[i]
                const kb: string = t.css.keyBase
                if (m.file != d.file && m.sym.hint == d.sym.hint && declScopeKey(kb, m.file, m.sym.hint) == declScopeKey(kb, d.file, d.sym.hint)) {
                    out = out.concat([mkDiag(d.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + d.sym.hint + ">` is also declared in `" + m.file + "`, and the two files' paths hash to one file tag, so both declarations would get the one output key `" + declScopeKey(kb, d.file, d.sym.hint) + "` (one style scope, one template) — the bootstrap keys a declaration's output by its file (s474); rename one, or move one file")])
                    hit = true
                }
                i = i + 1
            }
            j = j + 1
        }
        return out
    }

    // Two functions of one name. In one file that is a file-scope duplicate:
    // RULED S440 (22-item queue #6, "duplicate top-level `function` →
    // E-SCOPE-010, §7.6 text fixed to name `function`"); SPEC §7.6: "Two
    // top-level `function` declarations of one name SHALL be a compile error
    // (E-SCOPE-010: duplicate binding in file scope)".
    fn dupFns(t: Tables) -> Diag[] {
        let out: Diag[] = []
        let names: string[] = []
        for (const f of t.fns) { names = names.concat([f.name]) }
        let j = 0
        while (j < names.length) {
            const i: int = earlierSame(names, j)
            if (i >= 0) {
                const f: FnInfo = t.fns[j]
                const first: FnInfo = t.fns[i]
                // s472: in two files it is two functions — each call resolves in its own file's scope
                // s473: two `<db>` cells of one name are reported once, as the cells (their loads `@c` follow)
                if (first.file == f.file && !isLoadName(f.name)) {
                    out = out.concat([mkDiag(f.file, f.span, "E-SCOPE-010", "function `" + names[j] + "` is already declared at file scope (at " + offsetOf(first.span) + ") — duplicate binding in file scope (§7.6; ruled S440 #6)")])
                }
            }
            j = j + 1
        }
        return out
    }

    // s472 — a file-scope constant beside a program cell of its name in the same
    // file: §1.6 "Local names cannot shadow registered state names — attempting
    // to declare a local variable with the same name as a registered state cell
    // is `E-NAME-COLLIDES-STATE`"; §7.6.1: "A V5-strict structural cell `<x>` and
    // a local `let x` cannot coexist in the same file scope." Every other
    // file-scope collision of a constant (another constant, a function, a type, a
    // user declaration) is E-SCOPE-010 in fileNameClashes, once per later binding
    // (§7.6, S473; s473 review LOW-1); an IMPORT of the name is linkage's. A
    // function-body local or a parameter of the name SHADOWS it (§7.6 "scoped to
    // that function"; §7.3.3 shadowing in a nested scope is legal) — no report.
    fn dupConsts(files: FileAst[], t: Tables) -> Diag[] {
        let out: Diag[] = []
        for (const c of t.consts) {
            for (const d of t.decls) {
                if (d.file == c.file && d.sym.id == t.program.id) {
                    for (const fi of d.fields) {
                        if (fi.sym.hint == c.name) out = out.concat([mkDiag(c.file, c.span, "E-NAME-COLLIDES-STATE", "`" + c.name + "` is also a cell of the program (`@" + c.name + "`, at " + placeIn(files, c.file, fi.span.start) + ") — a local name cannot take the name of a registered state cell (§1.6, §7.6.1); rename one")])
                    }
                }
            }
        }
        return out
    }

    // `as=` handles: one name per scope (a declaration's renders, or one
    // `<each>` row — §66.7.4), and never a name `@…` already means.
    // RULED S440 (#5 = PA rec: "(i) duplicate `as=` in one scope and (ii) a
    // handle named like a cell are errors under one code
    // (`E-HANDLE-REDECLARE`); (iii) the same name on mutually exclusive `if=`
    // instances is an error for now, logged as a candidate widening"; #7 +
    // SPEC-text OPEN #7: "a row `as=` handle may shadow a program-level
    // HANDLE, not a CELL"). SPEC §66.7.2: "Each of the following is a compile
    // error, `E-HANDLE-REDECLARE`". So:
    //   - two handles of one name in one scope — (i), and (iii) when they sit
    //     under `if=` (exclusive arms are one scope too) — E-HANDLE-REDECLARE;
    //   - a handle in ANY scope — the program, a row (§66.7.4), a
    //     declaration's `renders` — named like a cell VISIBLE in its file —
    //     (ii) — E-HANDLE-REDECLARE. Program cells are visible only in the
    //     program's own file (§7.6.1);
    //   - a row / renders handle named like a PROGRAM handle is legal (#7):
    //     different owners, never compared here.
    // A PROGRAM-scope handle named like a visible declaration (whose `@name`
    // is its shared instance, §66.7.1) is not a cell: no ruling names it, so
    // it stays the bootstrap-local E-BOOTSTRAP-REDECLARE (owes a ruling).
    fn dupHandles(files: FileAst[], t: Tables, lk: Linkage) -> Diag[] {
        let out: Diag[] = []
        let prog: DeclInfo | not = declInfo(t, t.program)
        let cells: string[] = []
        let cellSpans: ASpan[] = []
        let progNid: int = -1
        let progFile: string = ""
        if (prog is given) {
            progNid = prog.nid
            progFile = prog.file
            for (const f of prog.fields) {
                cells = cells.concat([f.sym.hint])
                cellSpans = cellSpans.concat([f.span])
            }
        }
        let j = 0
        while (j < t.handles.length) {
            const h: HandleInfo = t.handles[j]
            let dup: HandleInfo | not = not
            let i = 0
            while (i < j) {
                const o: HandleInfo = t.handles[i]
                if (dup is not && o.owner == h.owner && o.name == h.name) dup = o
                i = i + 1
            }
            if (dup is given) {
                let why: string = ""
                if (h.conditional || dup.conditional) why = " — even under mutually exclusive `if=` conditions (an error for now, ruled S440 #5 (iii))"
                out = out.concat([mkDiag(h.file, h.span, "E-HANDLE-REDECLARE", "`as=" + h.name + "` — a handle `@" + h.name + "` is already bound in this scope (at " + offsetOf(dup.span) + "); a scope binds each handle name once" + why + " (§66.7.2)")])
            } else if (h.file == progFile && cells.indexOf(h.name) >= 0) {
                const cellAt: string = offsetOf(cellSpans[cells.indexOf(h.name)])
                out = out.concat([mkDiag(h.file, h.span, "E-HANDLE-REDECLARE", "the handle `as=" + h.name + "` is named like the cell `@" + h.name + "` (declared at " + cellAt + ") — a handle may not share a cell's name, in any scope (a row handle may shadow a program-level HANDLE, never a cell); rename one of them (§66.7.2, §66.7.4)")])
            } else if (visibleDeclNamed(lk, t, h.file, h.name)) {   // any scope — program, row, renders (r5 R5, ruled S442)
                out = out.concat([mkDiag(h.file, h.span, "E-HANDLE-REDECLARE", "`as=" + h.name + "` — `@" + h.name + "` already names the shared instance of `<" + h.name + ">` (§66.7.1); a handle cannot take that name (a handle named like a visible declaration is E-HANDLE-REDECLARE, ruled S442)")])
            }
            j = j + 1
        }
        return out
    }

    // §7.3.3: a block binds each name once. `params` are the function's own
    // (they share its top-level block); a nested block starts afresh (it may
    // shadow). `inFn` = a function body; else an inline handler block, which
    // §7.3.3 does not name (bootstrap-local code). Only `let` / `const` locals
    // are compared: ruling:user-voice-scrml.md S439 #6 (B1) exempts a nested
    // `function x` over a parameter `x` — the slice's statement grammar has no
    // nested function yet, so that holds by construction; when one parses it
    // must NOT be compared against the parameters here.
    fn blockRedeclares(file: string, b: ABlock, params: AParam[], inFn: boolean) -> Diag[] {
        let out: Diag[] = []
        let names: string[] = []
        let spans: ASpan[] = []
        for (const p of params) {
            names = names.concat([p.name])
            spans = spans.concat([p.span])
        }
        const nParams: int = params.length
        for (const s of b.stmts) {
            const n: string = localNameOf(s)
            if (n != "") {
                const i: int = names.indexOf(n)
                if (i >= 0) out = out.concat([redeclareDiag(file, n, s.span, spans[i], i < nParams, inFn)])
                names = names.concat([n])
                spans = spans.concat([s.span])
            }
            for (const nb of nestedBlocks(s)) { out = out.concat(blockRedeclares(file, nb, [], inFn)) }
        }
        return out
    }

    fn boundNameOf(f: AFor) -> string {
        const b: AForBound | not = f.bound
        if (b is not) return ""
        return b.name
    }

    // s469 — a Tier-0 loop's rows are markup: each row's handler blocks.
    fn rowsRedeclares(file: string, rows: ANode[]) -> Diag[] {
        let out: Diag[] = []
        for (const r of rows) { out = out.concat(nodeHandlerRedeclares(file, r)) }
        return out
    }

    fn redeclareDiag(file: string, name: string, span: ASpan, first: ASpan, isParam: boolean, inFn: boolean) -> Diag {
        let what: string = "a declaration"
        if (isParam) what = "a parameter"
        const msg: string = "`" + name + "` is already bound in this block by " + what + " (at " + offsetOf(first) + ") — a block binds each name once; a NESTED block may shadow it (§7.3.3)"
        if (inFn) return mkDiag(file, span, "E-SCOPE-REDECLARE", msg)
        return mkDiag(file, span, "E-BOOTSTRAP-REDECLARE", msg + " — §7.3.3 names function bodies; the bootstrap applies it to an inline handler block too (bootstrap-local)")
    }

    fn localNameOf(s: AStmt) -> string {
        const k: AStmtK = s.k
        return match k {
            .Local(name: n) :> n
            .Eval(e: e) :> ""
            .Return(e: e) :> ""
            .If(cond: c) :> ""
            .Given(name: n) :> ""
            .For(f: lf) :> boundNameOf(lf)          // s469: a bound loop binds its name (§49.6)
            .Break(label: x) :> ""
            .Continue(label: x) :> ""
            .Lift(what: x) :> ""
            .EffectStmt(w: w) :> ""
            .Defer(body: b) :> ""
            .Fail(f: x) :> ""
        }
    }

    fn nestedBlocks(s: AStmt) -> ABlock[] {
        const k: AStmtK = s.k
        return match k {
            .If(cond: c, thenB: t, elseB: el) :> thenElse(t, el)
            .Given(name: n, body: b) :> [b]
            .For(f: lf) :> forNestedBlocks(lf)
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> liftBlocks(w)
            .EffectStmt(w: w) :> []
            .Eval(e: e) :> allExprBlocks(e)                 // s451 (Ue): a handling form's arm blocks
            .Local(name: n, init: i) :> allExprBlocks(i)
            .Return(e: e) :> maybeExprBlocks(e)
            .Defer(body: b) :> [b]
            .Fail(f: x) :> []
        }
    }

    // s451 (Ue) — every arm block inside an expression, at any depth.
    fn allExprBlocks(e: AExpr) -> ABlock[] {
        let out: ABlock[] = exprBlocks(e)
        for (const x of exprKids(e)) { out = out.concat(allExprBlocks(x)) }
        return out
    }

    fn maybeExprBlocks(e: AExpr | not) -> ABlock[] {
        if (e is not) return []
        return allExprBlocks(e)
    }

    // s451 (Ue) — a `fail`'s expressions: its payload values, or the non-variant target.
    fn failExprs(f: AFail) -> AExpr[] {
        const t: AExpr | not = f.target
        if (t is given) return f.args.concat([t])
        return f.args
    }

    fn thenElse(t: ABlock, el: ABlock | not) -> ABlock[] {
        if (el is given) return [t, el]
        return [t]
    }

    // Every markup tree the binder resolves in a file: the program's body and
    // each declaration's `renders`.
    fn fileMarkup(items: AItem[]) -> ANode[] {
        let out: ANode[] = []
        for (const it of items) { out = out.concat(itemMarkup(it)) }
        return out
    }

    fn itemMarkup(it: AItem) -> ANode[] {
        const k: AItemK = it.k
        return match k {
            .ProgramItem(p: p) :> markupNodes(p.items)
            .ConstItem(c: c) :> []
            .DeclItem(d: d) :> rendersOf(d)
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .MarkupItem(n: n) :> []
        }
    }

    fn rendersOf(d: ADecl) -> ANode[] {
        const r: AElem | not = d.renders
        if (r is not) return []
        return [{ nid: -1, span: r.span, k: ANodeK.Elem(r) }]
    }

    fn handlerRedeclares(file: string, nodes: ANode[]) -> Diag[] {
        let out: Diag[] = []
        for (const n of nodes) { out = out.concat(nodeHandlerRedeclares(file, n)) }
        return out
    }

    fn nodeHandlerRedeclares(file: string, n: ANode) -> Diag[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> elemHandlerRedeclares(file, e)
            .Text(text: t) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Css(c: c) :> []
            .Gather(f: lf) :> blockRedeclares(file, lf.body, [], false).concat(rowsRedeclares(file, gatherRows(lf)))
            // s449: an effect body is a block like an inline handler's
            .Effect(w: w) :> blockRedeclares(file, w.body, [], false)
        }
    }

    fn elemHandlerRedeclares(file: string, e: AElem) -> Diag[] {
        let out: Diag[] = []
        for (const a of e.attrs) {
            const b: ABlock | not = bracedOf(a.value)
            if (b is given && eventName(a.name) != "") out = out.concat(blockRedeclares(file, b, [], false))
        }
        return out.concat(handlerRedeclares(file, e.kids))
    }

    fn bracedOf(v: AAttrValue) -> ABlock | not {
        return match v {
            .Braced(b: b) :> b
            .Bare(e: e) :> not
            .Paren(e: e) :> not
            .Quoted(v: s) :> not
            .NoValue :> not
        }
    }

    // =========================================================================
    // THE TYPER (M3 item 1) — a type per expression node, and the checks.
    //
    // A pass over the FileAst that reads the binder's `Tables` (every name is
    // already a Sym, every write already classified) and produces the typer's
    // own table, `Typing` (one VType per expression NodeId), plus diagnostics.
    // It re-decides no binding, and it never re-scans source text (Rule 7).
    //
    // What it checks, and why (the governing-sentence gate,
    // docs/changes/s439-bootstrap-m3-typer/progress.md):
    //   - WRITES (§66.1 rule 5: "Every cell and field write SHALL be
    //     type-checked against the target's declared type"): a whole-field
    //     replace / transition, a field-at write, each override of a spread
    //     (O58 (b)), an appended / prepended element. A value PROVABLY not of
    //     the target's type is E-TYPE-031; the absence literal `not` into a
    //     type without `| not` is E-TYPE-041 (§42.3.1). RULED S440 (22-item
    //     queue #1, "cell write type mismatch → E-TYPE-031"; SPEC-text OPEN
    //     #1, "a wrong-typed FIELD write is E-TYPE-031 too"): §7.5.1
    //     position 6.
    //   - INITIALIZERS — a declaration's own value / attribute default, and a
    //     use-site construction value, which IS that field's initializer for
    //     that instance (§66.9 rule 8): §7.5.1 position 2 — an `int` /
    //     `number` / `string` / `boolean` ANNOTATION given a literal of a
    //     different primitive is E-TYPE-031 (`int` joined the set: RULED S440,
    //     JS-WAT 7(a)); `not` into a non-optional annotation is E-TYPE-041.
    //   - CALL ARITY: E-CALL-ARITY (ruled S440 #2; SPEC §7.3) — see typeCall.
    //   - `<each in=…>`: E-EACH-NOT-SEQUENCE (ruled S440 #3; SPEC §17.7.2) for
    //     a value provably not a sequence — see checkIterable.
    //   - CONDITIONS (`if`, `if=` / `else-if=`, `show=`, a ternary test): a
    //     `bool` or a `T | not` presence test, else E-COND-NOT-BOOLEAN (ruled
    //     S440 #4 = (c) + Q1) — an UNRESOLVED type included (ruled S460 "a′,
    //     go": conditions are provable-or-ERROR, SPEC §42.4) — see checkCond;
    //     a presence test is recorded for `lower`.
    //   - OPERATORS (ruled S440 Gotcha Q1-Q3, dpa-054 #3): E-OPERATOR-OPERAND-TYPE,
    //     E-OPERAND-NOT-NARROWED, E-INT-DIVISION — see checkOperands; the
    //     narrowing they need — see NARROWING.
    // What it deliberately does NOT check: an ARGUMENT's type (§7.5.1
    // position 3: such a program "SHALL compile") and a return value
    // (position 4) — no ruling widened those.
    //
    // Assignability is PROVABLE-OR-SILENT: a check fires only on `Fails`, and
    // an Unknown value is never an error here. (The one exception is a
    // CONDITION — S460, see checkCond.) `int` is ENFORCED (RULED S440,
    // JS-WAT 7(a)): a `number` into an `int` is `Fails`.
    // =========================================================================
    export fn exprType(t: Tables, nid: int) -> VType {
        const i: int = slotOf(t.typing.at, nid)
        if (i < 0) return VType.Unknown
        return t.typing.exprs[i].vt
    }

    // Is condition node `nid` a presence test (a `T | not` condition)?
    export fn presenceTest(t: Tables, nid: int) -> boolean {
        return t.typing.presence.indexOf(nid) >= 0
    }

    // The settled pass's types, indexed by NodeId (the first entry per node;
    // the same one-pass build as `nidIndex`, over the entries' own nids).
    fn typingOf(exprs: ExprType[], presence: int[]) -> Typing {
        let top: int = -1
        for (const x of exprs) {
            if (x.nid > top) top = x.nid
        }
        let at: int[] = minusOnes(top + 1)
        let i: int = exprs.length - 1
        while (i >= 0) {
            if (exprs[i].nid >= 0) at[exprs[i].nid] = i
            i = i - 1
        }
        return { exprs: exprs, at: at, presence: presence }
    }

    // `contribs`: every value an UNANNOTATED `let` local is given — its
    // initializer and each later assignment (a local's type is their join).
    // `presence`: the presence-test condition nodes (Typing.presence).
    type TypeState:struct = { exprs: ExprType[], diags: Diag[], contribs: LocalT[], presence: int[] }
    type RTyping:struct = { typing: Typing, diags: Diag[] }
    type LocalT:struct = { id: int, vt: VType }
    // The typer's view of where it is: the tables, the file, the locals'
    // types (by Sym id) in scope, and `settled` — the local types the
    // previous pass joined (they win over `locals`, see typeProgram).
    // `narrowed`: the PLACES proven present here (see NARROWING below), by
    // place key — a `T | not` read of one of them is typed `T`.
    // `fnw`: each function's WRITE SET (place keys it may write, transitively
    // through its calls) — a call drops the narrowing of what its callee writes.
    // `blame`: what has already been reported (see Blame) — read only by the
    // condition rule (checkCond), never by another check.
    type TEnv:struct = { t: Tables, file: string, errs: ASpan[], locals: LocalT[], settled: LocalT[], narrowed: string[],
                         fnw: FnW[], rows: Alias[], fret: Type | not, blame: Blame }
    // s460 — §42.4 statement 6 ("no second report"): a CONDITION whose type is
    // unresolved BECAUSE of an error already reported is not reported again.
    // `spans`: the Error diagnostics the passes before the typer (binder, scope,
    // effect, validator) reported in this file; `syms`: the locals whose
    // WRITTEN type was refused (a parameter annotation that failed to parse or
    // to resolve, E-TYPE-UNKNOWN — Rule C for names, r8); `fns`: the functions
    // (by Sym id) whose written return type was refused.
    type Blame:struct = { spans: ASpan[], syms: int[], fns: int[] }
    type RVT:struct = { vt: VType, ts: TypeState }
    type RTEnv:struct = { env: TEnv, ts: TypeState }

    fn tWithRefused(env: TEnv, s: Sym) -> TEnv {
        const b: Blame = { spans: env.blame.spans, syms: env.blame.syms.concat([s.id]), fns: env.blame.fns }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled,
                 narrowed: env.narrowed, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: b }
    }

    fn tWithLocal(env: TEnv, s: Sym, vt: VType) -> TEnv {
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals.concat([{ id: s.id, vt: vt }]), settled: env.settled,
                 narrowed: env.narrowed, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // ---- NARROWING (for the S440 `T | not` operand rule) ------------------------
    // RULED S440 (Gotcha Q3): "a `T | not` operand must be narrowed before `+`,
    // arithmetic, comparison, or use in a template" — so the typer must know
    // where a `T | not` place IS narrowed, or it would refuse correct code.
    // The slice's narrowing forms (it parses no `is some` / `given` over a
    // value): the explicit tests `x is given` / `x is not` (s460, §42.4
    // statement 8), and a bare `T | not` condition `if (x)` (a presence test,
    // truthiness Q1) — narrowing the `if` / `else` branch, the ternary arm,
    // the right operand of `&&` / `||`, an element under `if=` (its other
    // attributes and children), and the rest of a block after an `if` whose
    // other branch always `return`s. They combine through `&&` / `||` and
    // through a `!` applied to one of those BOOLEAN tests (`!(x is not)`);
    // a `!` over a bare `T | not` is not a combination — it is
    // refused (E-OPERATOR-OPERAND-TYPE: `!` takes booleans, S440 Gotcha Q2),
    // because a bare optional is a presence test only as a WHOLE condition.
    // A place is named by its key: a local by its Sym (`#id`), a cell /
    // handle path by its spelling (`@o.v`). A write to the place (or a prefix
    // of it) drops the narrowing for the rest of the block — a bare write, a
    // call whose callee may write it (`fnw`), and a write inside a NESTED
    // block too (an `if` / `given` leaves the JOIN of its paths, r2 F1 / F3).
    type Narrowing:struct = { yes: string[], no: string[] }

    fn noNarrowing() -> Narrowing { return { yes: [], no: [] } }

    // s451 — a deferred body runs at its block's EXIT (§19.16.2), where a
    // narrowing in force at the `defer` may no longer hold. It keeps only the
    // narrowings nothing can undo before that exit: a local (`#id`, not a
    // place under it) that is never rebound — a parameter, a `const`, a
    // `let` with no assignment (no EAssignLocal of it anywhere). A cell's
    // narrowing (`@…`) is dropped: the rest of the block, or any call, may
    // write the cell. Fail closed — a dropped narrowing makes a read in the
    // deferred body unproven, never silently `T`.
    fn tDeferEnv(env: TEnv) -> TEnv {
        let keep: string[] = []
        for (const k of env.narrowed) {
            if (k.indexOf("#") == 0 && k.indexOf(".") < 0 && !reboundLocal(env.t, k.substring(1))) keep = keep.concat([k])
        }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: keep, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // Is the local with Sym id `id` rebound (`x = …`) anywhere?
    fn reboundLocal(t: Tables, id: string) -> boolean {
        for (const f of t.effects.facts) {
            if (reboundId(f) == id) return true
        }
        return false
    }

    fn reboundId(f: EffectFact) -> string {
        return match f {
            .EAssignLocal(sym: s) :> "" + s.id
            .EWrite(w: w) :> ""
            .ESpread(ws: ws) :> ""
            .EReset(w: w) :> ""
            .EEdits(w: w) :> ""
            .ERemove(w: w) :> ""
            .EElemAt(cap: c) :> ""
            .EPosition(cap: c) :> ""
        }
    }

    fn tNarrow(env: TEnv, keys: string[]) -> TEnv {
        let out: string[] = env.narrowed
        for (const k of keys) {
            if (k != "") out = out.concat([k])
        }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: out, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // Drop the narrowing of `key` and of every place under it.
    // (r3 N3) An `<each>` row binding (`rows`: its `#id` key → its source's
    // place key) is an element OF its source: a write to the source (or to a
    // place over / under it) drops the row binding's narrowings too.
    fn tUnnarrow(env: TEnv, key: string) -> TEnv {
        if (key == "") return env
        let drop: string[] = [key]
        // rows are outer-first: one ordered pass also drops a NESTED row whose
        // source lies under an already-dropped row (`<each in=g.kids>`, r5 R1)
        // (A write strictly UNDER a source — `@xs[0].n` — also drops, but the
        // slice parser drops indexing (residue R7), so that limb is unreachable.)
        for (const r of env.rows) {
            if (r.key != "" && (underAny(r.key, drop) || underAny(key, [r.key]))) drop = drop.concat([r.name])
        }
        let out: string[] = []
        for (const k of env.narrowed) {
            if (!underAny(k, drop)) out = out.concat([k])
        }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: out, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // Is `k` one of `keys`, or a place under one?
    fn underAny(k: string, keys: string[]) -> boolean {
        for (const d of keys) {
            if (k == d || k.indexOf(d + ".") == 0) return true
        }
        return false
    }

    fn tWithRow(env: TEnv, bind: Sym, src: string) -> TEnv {
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: env.narrowed,
                 fnw: env.fnw, rows: env.rows.concat([{ name: "#" + bind.id, key: src }]), fret: env.fret, blame: env.blame }
    }

    // A place's key ("" — not a place the typer narrows).
    fn nKey(env: TEnv, e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> localKey(nameFact(env.t.names, e.nid))
            .At(name: n) :> "@" + n
            .Member(obj: o, name: n) :> memberKey(nKey(env, o), n)
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: x) :> ""
            .Assign(target: x, kept: kp) :> keptKey(env, e, kp)     // s474: a kept `(x = e)` is the place `x` (§50)
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // s474 (§50.3.1): the kept assignment's value IS the local's new value, so a
    // presence test of `(m = e)` is a presence test of `m` (`((m = re.exec(s))
    // is given)` narrows `m` in the body).
    // (the local is the one the resolver rebinds — EAssignLocal on the node)
    fn keptKey(env: TEnv, a: AExpr, kept: boolean) -> string {
        if (!kept) return ""
        const s: Sym | not = assignedLocal(effectFact(env.t.effects, a.nid))
        if (s is not) return ""
        return "#" + s.id
    }

    fn localKey(f: NameFact | not) -> string {
        return match f {
            .NLocal(sym: s) :> "#" + s.id
            .NField(decl: d) :> ""
            .NInst(decl: d) :> ""
            .NStruct(owner: o) :> ""
            .NFn(sym: s) :> ""
            .NLength :> ""
            .NSurface(of: x) :> ""
            .NConst(sym: s) :> ""
            not :> ""
        }
    }

    fn isNotLit(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .NotLit :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // What a condition proves present when it is true (`yes`) / false (`no`).
    fn condNarrowing(env: TEnv, c: AExpr) -> Narrowing {
        const k: AExprK = c.k
        return match k {
            .Binary(op: o, l: l, r: r) :> binNarrowing(env, o, l, r)
            .Unary(op: o, e: x) :> unaryNarrowing(env, o, x)
            .Name(name: n) :> placeNarrowing(env, c)
            .At(name: n) :> placeNarrowing(env, c)
            .Member(obj: o) :> placeNarrowing(env, c)
            .AtItem :> noNarrowing()
            .Num(raw: r) :> noNarrowing()
            .Str(v: s) :> noNarrowing()
            .Bool(v: b) :> noNarrowing()
            .NotLit :> noNarrowing()
            .Recovered :> noNarrowing()
            .Variant(name: n) :> noNarrowing()
            .Call(callee: x) :> noNarrowing()
            .Ternary(test: x) :> noNarrowing()
            .Assign(target: x, kept: kp) :> keptPlaceNarrowing(env, c, kp)   // s474: `if ((x = e))` tests `x` (§50)
            .ArrayLit(elems: es) :> noNarrowing()
            .ObjectLit(props: ps) :> noNarrowing()
            .Spread(e: sx) :> noNarrowing()
            .Index(obj: ix) :> noNarrowing()
            .Lambda(params: lp) :> noNarrowing()
            .Sql(q: q) :> noNarrowing()
            .Handled(h: x) :> noNarrowing()
            .Template(quasis: qs) :> noNarrowing()
            .Foreign(f: fb0) :> noNarrowing()
        }
    }

    // A bare place as a condition is a presence test (truthiness Q1): true ⇒ present.
    // (F17: a match arm whose body is an object literal — arms call this instead.)
    fn placeNarrowing(env: TEnv, c: AExpr) -> Narrowing { return { yes: [nKey(env, c)], no: [] } }

    fn keptPlaceNarrowing(env: TEnv, c: AExpr, kept: boolean) -> Narrowing {
        if (!kept) return noNarrowing()
        return placeNarrowing(env, c)
    }

    fn binNarrowing(env: TEnv, op: BinOp, l: AExpr, r: AExpr) -> Narrowing {
        return match op {
            .Ne :> presenceCmp(env, l, r, true)
            .Eq :> presenceCmp(env, l, r, false)
            .And :> andNarrowing(condNarrowing(env, l), condNarrowing(env, r))
            .Or :> orNarrowing(condNarrowing(env, l), condNarrowing(env, r))
            .Add :> noNarrowing()
            .Sub :> noNarrowing()
            .Mul :> noNarrowing()
            .Div :> noNarrowing()
            .Mod :> noNarrowing()
            .Lt :> noNarrowing()
            .Le :> noNarrowing()
            .Gt :> noNarrowing()
            .Ge :> noNarrowing()
            .Pipe :> noNarrowing()
        }
    }

    // A presence comparison against `not` (`x != not` / `x == not`). s469: the binder
    // refuses that spelling (E-EQ-002, §45) — this narrowing only keeps the typer quiet
    // on the refused form (one report, no cascade); `is given` / `is not` are the tests.
    fn presenceCmp(env: TEnv, l: AExpr, r: AExpr, ne: boolean) -> Narrowing {
        let key: string = ""
        if (isNotLit(r)) key = nKey(env, l)
        if (isNotLit(l)) key = nKey(env, r)
        if (ne) return { yes: [key], no: [] }
        return { yes: [], no: [key] }
    }

    fn andNarrowing(a: Narrowing, b: Narrowing) -> Narrowing { return { yes: a.yes.concat(b.yes), no: [] } }
    fn orNarrowing(a: Narrowing, b: Narrowing) -> Narrowing { return { yes: [], no: a.no.concat(b.no) } }

    fn unaryNarrowing(env: TEnv, op: UnOp, x: AExpr) -> Narrowing {
        // s460: `x is given` proves `x` present when true; `x is not` when
        // false (§42.4 statement 8)
        if (op == UnOp.IsGiven) return { yes: [nKey(env, x)], no: [] }
        if (op == UnOp.IsNot) return { yes: [], no: [nKey(env, x)] }
        const isNot: boolean = op == UnOp.Not
        if (!isNot) return noNarrowing()
        const n: Narrowing = condNarrowing(env, x)
        return { yes: n.no, no: n.yes }
    }

    // A place read: its `T | not` type is `T` where the place is narrowed.
    fn narrowRead(env: TEnv, e: AExpr, vt: VType) -> VType {
        const x: Type | not = knownOf(vt)
        if (x is not) return vt
        const inner: Type | not = maybeInner(x)
        if (inner is not) return vt
        const key: string = nKey(env, e)
        if (key != "" && env.narrowed.indexOf(key) >= 0) return known(inner)
        return vt
    }

    // Does a block always leave its function (its last statement a `return`,
    // or an `if` both of whose branches do)?
    fn exits(b: ABlock) -> boolean {
        if (b.stmts.length == 0) return false
        return stmtExits(b.stmts[b.stmts.length - 1])
    }

    fn stmtExits(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: e) :> true
            .If(cond: c, thenB: t, elseB: el) :> bothExit(t, el)
            .Eval(e: e) :> false
            .Local(name: n) :> false
            .Given(name: n) :> false
            .For(f: lf) :> loopNeverCompletes(lf)
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: x) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: b) :> false
            .Fail(f: x) :> true                  // s451 (Ue): `fail` leaves the function (§19.3.2)
        }
    }

    fn bothExit(t: ABlock, el: ABlock | not) -> boolean {
        if (el is not) return false
        return exits(t) && exits(el)
    }

    // ---- WRITE SETS (s442 r2 F1: a call may undo a narrowing) ------------------
    // A function's write set: the place keys (`@o`, `@o.n`, spelled as
    // placeKey spells them) its body writes — an assignment, `reset(@x)`, an
    // edit call `@xs.push(…)` — and, transitively, what the functions it calls
    // write. A `given c = @h` body's `c.f` is `@h.f`. Syntactic and whole
    // program: over-approximate, so it only ever un-narrows MORE (never
    // silences a report). s472 r1 (F3): a call `()name` resolves in the CALLING
    // file's scope (the function the name denotes there — file scope), not to
    // every linked function of that name: another file's private `name` writing
    // a cell (or a server one, "*") no longer ends a narrowing it cannot reach.
    // `nid`: the function's AFn nid (s472: argument checks find THE callee's
    // parameters by it, never by name). `file`: its declaring file.
    type FnW:struct = { name: string, nid: int, file: string, keys: string[], params: int[] }   // `params`: the parameter nids (r4 (c): argument checks)
    type Alias:struct = { name: string, key: string }

    fn exprKids(e: AExpr) -> AExpr[] {
        const k: AExprK = e.k
        return match k {
            .Member(obj: o) :> [o]
            .Call(callee: c, args: a) :> [c].concat(a)
            .Unary(op: o, e: x) :> [x]
            .Binary(op: o, l: l, r: r) :> [l, r]
            .Ternary(test: t, yes: y, no: n) :> [t, y, n]
            .Assign(target: t, value: v) :> [t, v]
            .ArrayLit(elems: es) :> es
            .ObjectLit(props: ps) :> propValueList(ps)
            .Spread(e: x) :> [x]
            .Index(obj: o, idx: i) :> [o, i]
            .Lambda(params: lp, body: b) :> [b]
            .Sql(q: q) :> q.params
            .Handled(h: h) :> handledKids(h)      // s451 (Ue): the subject, then each expression arm (block arms: exprBlocks)
            .Template(quasis: qs, slots: ss) :> ss      // s469: the slots, left to right
            .Foreign(f: fb0) :> fb0.crossings           // s473: the crossings, left to right
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
        }
    }

    // s451 (Ue) — a handling form's expression children: its subject, then
    // each EXPRESSION arm's body. Its arm BLOCKS hold statements — every walk
    // that recurses through exprKids reaches them through exprBlocks.
    fn handledKids(h: AHandled) -> AExpr[] {
        let out: AExpr[] = [h.subject]
        for (const a of handledArms(h)) {
            const b: AArmBody = a.body
            out = out.concat(armExprOf(b))
        }
        return out
    }

    fn handledArms(h: AHandled) -> AArm[] {
        const how: AHow = h.how
        return match how {
            .Propagate :> []
            .Guard(arms: arms) :> arms
            .MatchOn(arms: arms) :> arms
        }
    }

    fn armExprOf(b: AArmBody) -> AExpr[] {
        return match b {
            .ArmExpr(e: x) :> [x]
            .ArmBlock(b: blk) :> []
        }
    }

    fn armBlockOf(b: AArmBody) -> ABlock[] {
        return match b {
            .ArmExpr(e: x) :> []
            .ArmBlock(b: blk) :> [blk]
        }
    }

    // s451 (Ue) — the statement BLOCKS directly inside an expression: a
    // handling form's block arms (no other expression holds statements).
    fn exprBlocks(e: AExpr) -> ABlock[] {
        const h: AHandled | not = handledOf(e.k)
        if (h is not) return []
        let out: ABlock[] = []
        for (const a of handledArms(h)) {
            const b: AArmBody = a.body
            out = out.concat(armBlockOf(b))
        }
        return out
    }

    fn propValueList(ps: AProp[]) -> AExpr[] {
        let out: AExpr[] = []
        for (const p of ps) { out = out.concat([p.value]) }
        return out
    }

    // What an expression writes: place keys, and `()name` for each call of `name`.
    fn exprEffects(e: AExpr) -> string[] {
        let out: string[] = ownEffect(e)
        for (const x of exprKids(e)) { out = out.concat(exprEffects(x)) }
        for (const b of exprBlocks(e)) { out = out.concat(blockEffects(b, [])) }    // s451 (Ue): an arm block's writes
        return out
    }

    fn exprsEffects(es: AExpr[]) -> string[] {
        let out: string[] = []
        for (const x of es) { out = out.concat(exprEffects(x)) }
        return out
    }

    fn ownEffect(e: AExpr) -> string[] {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t) :> [placeKey(t)]
            .Call(callee: c, args: a) :> callEffect(c, a)
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: x) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    fn callEffect(c: AExpr, a: AExpr[]) -> string[] {
        const n: string = exprName(c)
        if (n == "reset") {
            if (a.length == 1) return [placeKey(a[0])]
            return []
        }
        if (n != "") return ["()" + n]
        const m: MethodCall | not = methodCall(c)
        if (m is given) return [placeKey(m.obj)]
        return []
    }

    fn blockEffects(b: ABlock, al: Alias[]) -> string[] {
        let out: string[] = []
        for (const s of b.stmts) { out = out.concat(stmtEffects(s, al)) }
        return out
    }

    fn stmtEffects(s: AStmt, al: Alias[]) -> string[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> aliased(exprEffects(e), al)
            .Local(name: n, init: i) :> aliased(exprEffects(i), al)
            .Return(e: e) :> aliased(maybeEffects(e), al)
            .If(cond: c, thenB: t, elseB: el) :> aliased(exprEffects(c), al).concat(blockEffects(t, al)).concat(elseEffects(el, al))
            .Given(name: n, subject: sub, body: b) :> aliased(exprEffects(sub), al).concat(blockEffects(b, al.concat([aliasOf(n, sub)])))
            .For(f: lf) :> aliased(exprsEffects(forExprs(lf)), al).concat(blockEffects(lf.body, al))
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> aliased(exprsEffects(liftExprs(w)), al)
            .EffectStmt(w: w) :> []              // registers nothing where it stands (refused there) and writes nothing
            .Defer(body: b) :> blockEffects(b, al)   // s451: runs at the block's exit — its writes are the function's
            .Fail(f: f) :> aliased(exprsEffects(failExprs(f)), al)
        }
    }

    fn aliasOf(n: string, sub: AExpr) -> Alias { return { name: n, key: placeKey(sub) } }

    fn maybeEffects(e: AExpr | not) -> string[] {
        if (e is not) return []
        return exprEffects(e)
    }

    fn elseEffects(el: ABlock | not, al: Alias[]) -> string[] {
        if (el is not) return []
        return blockEffects(el, al)
    }

    // `c.f` inside `given c = @h` is `@h.f`.
    fn aliased(keys: string[], al: Alias[]) -> string[] {
        let out: string[] = []
        for (const k of keys) {
            let key: string = k
            for (const a of al) {
                if (a.key != "" && (key == a.name || key.indexOf(a.name + ".") == 0)) key = a.key + key.substring(a.name.length)
            }
            out = out.concat([key])
        }
        return out
    }

    fn fnKeysNamed(ws: FnW[], name: string) -> string[] {
        let out: string[] = []
        for (const w of ws) {
            if (w.name == name) out = out.concat(w.keys)
        }
        return out
    }

    // s462 — §42.3.5 (ruling:user-voice-scrml.md S462 "b"): "A write to the
    // narrowed place — direct, in a nested block, or by a call that writes it
    // or whose write set cannot be determined — ends the narrowing from that
    // point". A call `()name` whose `name` is no function of the linked
    // program has a write set that cannot be determined: its key is UNKNOWN
    // ("*"), which ends every cell narrowing (fail closed). Unreachable in the
    // current slice — function values, function-typed parameters and braced
    // arrows are all refused (E-BOOTSTRAP-UNSUPPORTED / parse) — and kept so
    // the "function values" slice inherits the rule instead of re-deriving it.
    fn hasFnNamed(ws: FnW[], name: string) -> boolean {
        for (const w of ws) {
            if (w.name == name) return true
        }
        return false
    }

    // The write keys of a call of `name`: its function's write set, or UNKNOWN.
    // s472 r1 (F3): the write sets of the functions in scope in `file` — one per
    // name, so `callKeys` over them answers for THE callee a name denotes there.
    fn fnwIn(ws: FnW[], lk: Linkage, file: string) -> FnW[] {
        let out: FnW[] = []
        // s474: one per LOCAL name the function is bound under (an alias: the call writes the alias)
        for (const w of ws) {
            for (const local of boundAs(lk, file, NameKind.KFn, w.name, w.file)) {
                out = out.concat([{ name: local, nid: w.nid, file: w.file, keys: w.keys, params: w.params }])
            }
        }
        return out
    }

    export fn callKeys(ws: FnW[], name: string) -> string[] {
        if (!hasFnNamed(ws, name)) return ["*"]
        return fnKeysNamed(ws, name)
    }

    // s462 Q12 — drop every CELL narrowing (`@…` and places under it); locals and
    // `<each>` row bindings (captured locals) keep theirs. s462 Q18
    // (ruling:user-voice-scrml.md S462 "a") — EXCEPT a cell narrowed by the chain
    // of `if=` / `else-if=` gates enclosing the handler (`gateMark`, set by
    // `typeIfAttr`): render-gating removes the subtree and its listener
    // synchronously on the write that ends the gate's condition. The marks
    // themselves do not enter the handler.
    // s462 round 6 — `gates` false: a handler for an event outside the user-input
    // allow-list (`userInputEvent`) keeps no gate narrowing — a browser may fire it
    // DURING the removal, while the node is still connected.
    fn tDropCellNarrowing(env: TEnv, gates: boolean) -> TEnv {
        let keep: string[] = []
        for (const k of env.narrowed) {
            if (k.indexOf("@") == 0) {
                if (gates && env.narrowed.indexOf(gateMark(k)) >= 0) keep = keep.concat([k])
            } else if (k.indexOf(gateMark("")) != 0) {
                keep = keep.concat([k])
            }
        }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: keep, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // s462 — drop every CELL narrowing (`@…`), and every `<each>` row binding
    // whose source is a cell: an UNKNOWN write may write any of them. A local's
    // narrowing (`#id`) stays: a call cannot rebind a local.
    // s462 Q18 — the mark an `if=` / `else-if=` gate leaves in `narrowed` beside
    // each cell place it narrows (no place key starts with `gate:`; every reader
    // of `narrowed` compares whole keys or `@` / `#` prefixes).
    // s462 round 6 (review #6 ruling) — the ALLOW-list of events a gated handler keeps
    // the gate's narrowing for: fired by the user agent as their own task from direct
    // user input, never synchronously from a DOM mutation or removal (Chromium fires
    // `blur` / `focusout` inside `remove()`). Exact names, ASCII-lowercased (HTML
    // attribute names are case-insensitive); anything else keeps no gate narrowing.
    fn userInputEvent(ev: string) -> boolean {
        let e: string = ev.toLowerCase()
        if (e.indexOf(":") == 0) e = e.substring(1)              // `on:click`
        if (e.indexOf("client:") == 0) e = e.substring(7)        // `onclient:click`
        if (e.indexOf("server:") == 0) e = e.substring(7)        // `onserver:click`
        return ["click", "dblclick", "auxclick", "contextmenu", "input", "beforeinput", "submit", "reset",
                "keydown", "keyup", "keypress", "mousedown", "mouseup", "mousemove", "pointerdown", "pointerup",
                "pointermove", "wheel", "touchstart", "touchmove", "touchend", "dragstart", "drag", "dragend",
                "dragenter", "dragover", "drop"].indexOf(e) >= 0
    }

    fn gateMark(k: string) -> string {
        return "gate:" + k
    }

    fn gateMarks(keys: string[]) -> string[] {
        let out: string[] = []
        for (const k of keys) {
            if (k.indexOf("@") == 0) out = out.concat([gateMark(k)])
        }
        return out
    }

    fn tUnnarrowCells(env: TEnv) -> TEnv {
        let out: TEnv = env
        for (const k of env.narrowed) {
            if (k.indexOf("@") == 0) out = tUnnarrow(out, k)
        }
        for (const r of env.rows) {
            if (r.key.indexOf("@") == 0) out = tUnnarrow(out, r.name)
        }
        return out
    }

    // Every function's write set, closed over its calls (a fixpoint: each pass
    // adds keys, a key set is finite; bounded by the function count + 2).
    fn fnWrites(files: FileAst[], lk: Linkage) -> FnW[] {
        let ws: FnW[] = []
        for (const f of files) {
            // s462 Q11 (ruling:user-voice-scrml.md S462 "a"): a SERVER function's call is a
            // suspension point (the client awaits it; another handler may write any cell
            // meanwhile) — its key set holds UNKNOWN ("*"), so a call of it, or of any
            // function that calls it (the fixpoint below), ends every cell narrowing.
            for (const af of fnItems(f.items)) {
                let own: string[] = blockEffects(af.body, [])
                if (af.server || sqlsInBlock(af.body).length > 0) own = own.concat(["*"])   // serverOwn (§12.2 T1), as the binder decides it
                ws = ws.concat([{ name: af.name, nid: af.nid, file: f.path, keys: own, params: paramNids(af.params) }])
            }
        }
        let changed = true
        let pass = 0
        while (changed && pass < ws.length + 2) {
            changed = false
            let next: FnW[] = []
            for (const w of ws) {
                let keys: string[] = w.keys
                for (const k of w.keys) {
                    if (k.indexOf("()") == 0) {
                        // the callee's own `()` keys name functions in ITS file's scope — they reach
                        // this set already resolved (the callee's closure), never re-read here
                        for (const c of callKeys(fnwIn(ws, lk, w.file), k.substring(2))) {
                            if (keys.indexOf(c) < 0 && c.indexOf("()") != 0) {
                                keys = keys.concat([c])
                                changed = true
                            }
                        }
                    }
                }
                next = next.concat([{ name: w.name, nid: w.nid, file: w.file, keys: keys, params: w.params }])
            }
            ws = next
            pass = pass + 1
        }
        return ws
    }

    // Drop the narrowing of every place a call inside `e` may write. Applied
    // to an expression before it is typed (so a read in it is not narrowed
    // across a call that clears the place — conservatively, a read BEFORE
    // such a call in the same expression is un-narrowed too) and to a
    // statement's continuation.
    fn tCallUnnarrow(env: TEnv, e: AExpr) -> TEnv {
        if (env.narrowed.length == 0) return env
        let out: TEnv = env
        for (const eff of exprEffects(e)) {
            if (eff.indexOf("()") == 0) {
                for (const k of callKeys(env.fnw, eff.substring(2))) {
                    if (k == "*") out = tUnnarrowCells(out)
                    if (k.indexOf("@") == 0) out = tUnnarrow(out, k)
                }
            }
        }
        return out
    }

    fn findLocalT(ls: LocalT[], id: int) -> VType | not {
        let i: int = ls.length - 1
        while (i >= 0) {
            if (ls[i].id == id) return ls[i].vt
            i = i - 1
        }
        return not
    }

    fn tLocal(env: TEnv, s: Sym) -> VType {
        const settled: VType | not = findLocalT(env.settled, s.id)
        if (settled is given) return settled
        const own: VType | not = findLocalT(env.locals, s.id)
        if (own is given) return own
        return VType.Unknown
    }

    fn record(ts: TypeState, nid: int, vt: VType) -> TypeState {
        return { exprs: ts.exprs.concat([{ nid: nid, vt: vt }]), diags: ts.diags, contribs: ts.contribs, presence: ts.presence }
    }

    fn report(ts: TypeState, env: TEnv, span: ASpan, code: string, msg: string) -> TypeState {
        return { exprs: ts.exprs, diags: ts.diags.concat([mkDiag(env.file, span, code, msg)]), contribs: ts.contribs, presence: ts.presence }
    }

    fn contribute(ts: TypeState, s: Sym, vt: VType) -> TypeState {
        return { exprs: ts.exprs, diags: ts.diags, contribs: ts.contribs.concat([{ id: s.id, vt: vt }]), presence: ts.presence }
    }

    fn markPresence(ts: TypeState, nid: int) -> TypeState {
        return { exprs: ts.exprs, diags: ts.diags, contribs: ts.contribs, presence: ts.presence.concat([nid]) }
    }

    // A local's written type (`let a: T = …`), if it has one.
    fn annotOf(t: Tables, s: Sym) -> Type | not {
        for (const a of t.annots) {
            if (a.sym.id == s.id) return a.ty
        }
        return not
    }

    // One type per unannotated local: the join of everything it is given
    // (flow-insensitive). `not` joined with `T` is `T | not` (§42.3.1: "The
    // compiler SHALL infer `T | not` when a variable is initialized with `not`
    // and later assigned a value of type `T`"); an unprovable join is Unknown.
    fn joinContribs(cs: LocalT[]) -> LocalT[] {
        let out: LocalT[] = []
        for (const c of cs) {
            let found = false
            let next: LocalT[] = []
            for (const o of out) {
                if (o.id == c.id) {
                    next = next.concat([{ id: o.id, vt: joinContrib(o.vt, c.vt) }])
                    found = true
                } else {
                    next = next.concat([o])
                }
            }
            if (!found) next = next.concat([c])
            out = next
        }
        return out
    }

    // s472 — two values a local is GIVEN (its initializer, its assignments) are
    // joined flow-insensitively: at any one read it holds the last one given,
    // not "any of them". So a join that makes a NEW choice (`let a = "s"; a =
    // 1`) is unprovable — Unknown, as before — and only a choice one value
    // already was (`let v = c ? "a" : 1`) is carried as one.
    fn joinContrib(a: VType, b: VType) -> VType {
        const j: VType = joinVT(a, b)
        if (oneOfMembers(j).length == 0) return j
        if (sameVT(j, a) || sameVT(j, b)) return j
        return VType.Unknown
    }

    fn sameVT(a: VType, b: VType) -> boolean {
        const x: Type | not = knownOf(a)
        const y: Type | not = knownOf(b)
        if (x is given && y is given) return sameType(x, y)
        if (x is given || y is given) return false
        const xs: Type[] = oneOfMembers(a)
        const ys: Type[] = oneOfMembers(b)
        if (xs.length > 0 || ys.length > 0) return sameMembers(xs, ys) && sameMembers(ys, xs)
        return isAbsentVT(a) == isAbsentVT(b)
    }

    // s472 — every member of `xs` is (the same type as) a member of `ys`.
    fn sameMembers(xs: Type[], ys: Type[]) -> boolean {
        if (xs.length != ys.length) return false
        for (const x of xs) {
            let found = false
            for (const y of ys) {
                if (sameType(x, y)) found = true
            }
            if (!found) return false
        }
        return true
    }

    // A choice's member types ([] for any other VType).
    fn oneOfMembers(v: VType) -> Type[] {
        return match v {
            .OneOf(ts: xs) :> xs
            .Known(t: x) :> []
            .Absent :> []
            .Unknown :> []
        }
    }

    fn isAbsentVT(v: VType) -> boolean {
        return match v {
            .Absent :> true
            .Known(t: x) :> false
            .Unknown :> false
            .OneOf(ts: xs) :> false
        }
    }

    fn sameLocals(a: LocalT[], b: LocalT[]) -> boolean {
        if (a.length != b.length) return false
        for (const x of a) {
            const y: VType | not = findLocalT(b, x.id)
            if (y is not) return false
            if (!sameVT(x.vt, y)) return false
        }
        return true
    }


    fn rvt(vt: VType, ts: TypeState) -> RVT { return { vt: vt, ts: ts } }

    // ---- types as values ------------------------------------------------------
    fn known(ty: Type) -> VType { return VType.Known(ty) }

    fn maybeInner(ty: Type) -> Type | not {
        return match ty {
            .Maybe(inner: i) :> i
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Named(sym: s) :> not
            .Seq(elem: e) :> not
        }
    }

    // `T` for a `T | not`; any other type as it is.
    fn unMaybe(ty: Type) -> Type {
        const i: Type | not = maybeInner(ty)
        if (i is given) return i
        return ty
    }

    fn typeName(ty: Type) -> string {
        return match ty {
            .Int :> "int"
            .Num :> "number"
            .Str :> "string"
            .Bool :> "bool"
            .Named(sym: s) :> s.hint
            .Seq(elem: e) :> elemName(e) + "[]"
            .Maybe(inner: i) :> typeName(i) + " | not"
        }
    }

    // s474 r1 (#1715 review F7) — a type as a diagnostic in `file` names it: a user
    // type that file imports under an alias is written by the alias, and the note
    // (aliasNote) says what it is — two same-named types aliased apart stay apart.
    fn typeNameIn(al: TypeAlias[], file: string, ty: Type) -> string {
        return match ty {
            .Int :> "int"
            .Num :> "number"
            .Str :> "string"
            .Bool :> "bool"
            .Named(sym: s) :> aliasName(al, file, s)
            .Seq(elem: e) :> elemNameIn(al, file, e) + "[]"
            .Maybe(inner: i) :> typeNameIn(al, file, i) + " | not"
        }
    }

    fn elemNameIn(al: TypeAlias[], file: string, e: Type) -> string {
        if (maybeInner(e) is given) return "(" + typeNameIn(al, file, e) + ")"
        return typeNameIn(al, file, e)
    }

    fn aliasName(al: TypeAlias[], file: string, s: Sym) -> string {
        for (const a of al) {
            if (a.file == file && a.sym.id == s.id) return a.local
        }
        return s.hint
    }

    fn innerNamed(ty: Type) -> Sym | not {
        return match ty {
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Named(sym: s) :> s
            .Seq(elem: e) :> innerNamed(e)
            .Maybe(inner: i) :> innerNamed(i)
        }
    }

    // " (`A` is `C`, declared in `b.scrml`)" when `ty`'s user type is aliased in `file`, else "".
    fn aliasNote(al: TypeAlias[], file: string, ty: Type) -> string {
        const s: Sym | not = innerNamed(ty)
        if (s is not) return ""
        for (const a of al) {
            if (a.file == file && a.sym.id == s.id) return " (`" + a.local + "` is `" + a.orig + "`, declared in `" + a.from + "`)"
        }
        return ""
    }

    // A type, in backticks, with its alias note — in a typer diagnostic of `env.file`.
    fn shownT(env: TEnv, ty: Type) -> string {
        return "`" + typeNameIn(env.t.taliases, env.file, ty) + "`" + aliasNote(env.t.taliases, env.file, ty)
    }

    // The same for the binder (Env): the struct type `s` as named in `env.file`.
    fn shownStruct(env: Env, s: Sym) -> string {
        const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
        if (ti is not) return "`" + s.hint + "`"
        const als: string[] = boundAs(env.g.te.link, env.file, NameKind.KType, ti.name, ti.file)
        if (als.length == 0 || als.indexOf(ti.name) >= 0) return "`" + s.hint + "`"
        return "`" + als[0] + "` (`" + ti.name + "`, declared in `" + ti.file + "`)"
    }

    // A sequence's element type as written before `[]`: a `T | not` element is
    // parenthesized — `(int | not)[]`, not `int | not[]` (r7 N2).
    fn elemName(e: Type) -> string {
        if (maybeInner(e) is given) return "(" + typeName(e) + ")"
        return typeName(e)
    }

    // A type's kind, for the assignability table: 0 int · 1 number · 2 string ·
    // 3 bool · 4 named · 5 sequence · 6 maybe.
    fn kindOf(ty: Type) -> int {
        return match ty {
            .Int :> 0
            .Num :> 1
            .Str :> 2
            .Bool :> 3
            .Named(sym: s) :> 4
            .Seq(elem: e) :> 5
            .Maybe(inner: i) :> 6
        }
    }

    // Does a value of type `v` fit a position of type `target`?
    export type Verdict:enum = { Fits, Fails, Unproven }

    fn fitsType(v: Type, target: Type) -> Verdict {
        const ti: Type | not = maybeInner(target)
        const vi: Type | not = maybeInner(v)
        if (ti is given) {
            if (vi is given) return fitsType(vi, ti)
            return fitsType(v, ti)
        }
        if (vi is given) {
            // a `T | not` value into a `T` position: wrong if `T` is; else it
            // may be `not` — not provable here (§42 narrowing is its own rule)
            const r: Verdict = fitsType(vi, target)
            if (r == Verdict.Fails) return Verdict.Fails
            return Verdict.Unproven
        }
        const vk: int = kindOf(v)
        const tk: int = kindOf(target)
        if (tk == 0) {
            // `int` ENFORCED (RULED S440, JS-WAT 7(a): "enforce `int` (bootstrap
            // typer; `7 / 2` into `int` is an error; integer division explicit)";
            // PA note: "§7.5.1's provable domain widens to `int` with it"): a
            // `number` does not narrow to `int` implicitly — only an `int` fits.
            // (int refines number, S404: an `int` into `number` fits, below.)
            if (vk == 0) return Verdict.Fits
            return Verdict.Fails
        }
        if (tk == 1) {
            if (vk == 0 || vk == 1) return Verdict.Fits
            return Verdict.Fails
        }
        if (tk == 4) {
            const vs: Sym | not = namedOf(v)
            const tsym: Sym | not = namedOf(target)
            if (vs is given && tsym is given) {
                if (vs.id == tsym.id) return Verdict.Fits
            }
            return Verdict.Fails
        }
        if (tk == 5) {
            const ve: Type | not = seqElem(v)
            const te: Type | not = seqElem(target)
            if (ve is given && te is given) return fitsType(ve, te)
            return Verdict.Fails
        }
        if (vk == tk) return Verdict.Fits
        return Verdict.Fails
    }

    fn sameType(a: Type, b: Type) -> boolean {
        return fitsType(a, b) == Verdict.Fits && fitsType(b, a) == Verdict.Fits
    }

    fn isNumericKind(ty: Type) -> boolean {
        const k: int = kindOf(ty)
        return k == 0 || k == 1
    }

    // The type two values share (ternary arms, array elements), when provable.
    // s472: two KNOWN types with no common type are a choice of both
    // (`OneOf`) — never Unknown; an Unknown side keeps the join Unknown.
    fn joinVT(a: VType, b: VType) -> VType {
        return match a {
            .Known(t: x) :> joinKnown(x, b)
            .Absent :> joinAbsent(b)
            .Unknown :> VType.Unknown
            .OneOf(ts: xs) :> joinOneOf(xs, b)
        }
    }

    fn joinKnown(x: Type, b: VType) -> VType {
        return match b {
            .Known(t: y) :> joinTypes(x, y)
            .Absent :> known(optional(x))
            .Unknown :> VType.Unknown
            .OneOf(ts: ys) :> joinOneOf(ys, known(x))
        }
    }

    fn joinAbsent(b: VType) -> VType {
        return match b {
            .Known(t: y) :> known(optional(y))
            .Absent :> VType.Absent
            .Unknown :> VType.Unknown
            .OneOf(ts: ys) :> VType.OneOf(optionalAll(ys))
        }
    }

    fn joinOneOf(xs: Type[], b: VType) -> VType {
        return match b {
            .Known(t: y) :> oneOfVT(addMember(xs, y))
            .Absent :> VType.OneOf(optionalAll(xs))
            .Unknown :> VType.Unknown
            .OneOf(ts: ys) :> oneOfVT(addMembers(xs, ys))
        }
    }

    fn addMembers(xs: Type[], ys: Type[]) -> Type[] {
        let out: Type[] = xs
        for (const y of ys) { out = addMember(out, y) }
        return out
    }

    // `y` joined into the first member it shares a type with, else a new member.
    fn addMember(xs: Type[], y: Type) -> Type[] {
        let out: Type[] = []
        let placed = false
        for (const x of xs) {
            const j: Type | not = joinType(x, y)
            if (!placed && j is given) {
                out = out.concat([j])
                placed = true
            } else {
                out = out.concat([x])
            }
        }
        if (!placed) out = out.concat([y])
        return out
    }

    fn optionalAll(xs: Type[]) -> Type[] {
        let out: Type[] = []
        for (const x of xs) { out = out.concat([optional(x)]) }
        return out
    }

    fn oneOfVT(xs: Type[]) -> VType {
        if (xs.length == 1) return known(xs[0])
        return VType.OneOf(xs)
    }

    // The names of a choice's members: "`string` or `int`".
    fn oneOfName(xs: Type[]) -> string {
        let out: string = ""
        let i = 0
        for (const x of xs) {
            if (i > 0 && i == xs.length - 1) {
                out = out + " or "
            } else if (i > 0) {
                out = out + ", "
            }
            out = out + "`" + typeName(x) + "`"
            i = i + 1
        }
        return out
    }

    fn optional(ty: Type) -> Type {
        if (maybeInner(ty) is given) return ty
        return Type.Maybe(ty)
    }

    fn joinTypes(x: Type, y: Type) -> VType {
        const j: Type | not = joinType(x, y)
        if (j is given) return known(j)
        return VType.OneOf([x, y])
    }

    // The one type two known types share, when there is one.
    fn joinType(x: Type, y: Type) -> Type | not {
        if (sameType(x, y)) return x
        if (isNumericKind(x) && isNumericKind(y)) return Type.Num
        if (fitsType(y, x) == Verdict.Fits) return x       // T and T | not → T | not
        if (fitsType(x, y) == Verdict.Fits) return y
        // `T` and `U | not` with `T` and `U` sharing a type → that type `| not`
        const xi: Type | not = maybeInner(x)
        const yi: Type | not = maybeInner(y)
        if (xi is given || yi is given) {
            const k: Type | not = joinType(unMaybe(x), unMaybe(y))
            if (k is given) return optional(k)
        }
        return not
    }

    // Arithmetic (§45 aside, JS semantics): int ∘ int is int, any other
    // numeric pair is number, anything else is unproven.
    fn numJoin(a: VType, b: VType) -> VType {
        const x: Type | not = knownOf(a)
        const y: Type | not = knownOf(b)
        if (x is not || y is not) return VType.Unknown
        if (kindOf(x) == 0 && kindOf(y) == 0) return known(Type.Int)
        if (isNumericKind(x) && isNumericKind(y)) return known(Type.Num)
        return VType.Unknown
    }

    fn knownOf(v: VType) -> Type | not {
        return match v {
            .Known(t: x) :> x
            .Absent :> not
            .Unknown :> not
            .OneOf(ts: xs) :> not
        }
    }


    fn litType(l: Literal) -> VType {
        return match l {
            .Int(v: n) :> known(Type.Int)
            .Num(v: n) :> known(Type.Num)
            .Str(v: s) :> known(Type.Str)
            .Bool(v: b) :> known(Type.Bool)
            .Variant(enumSym: s) :> known(Type.Named(s))
            .Absent :> VType.Absent
        }
    }

    // ---- the binder's facts, as the typer reads them --------------------------
    // Each accessor is total over ONE family (plus `not`: no fact).
    // The value type a NAME denotes (a name / `@x` / `@.` / a member step).
    fn nameType(env: TEnv, f: NameFact | not) -> VType {
        return match f {
            .NLocal(sym: s) :> tLocal(env, s)
            .NField(decl: d, inst: i, idx: x) :> fieldTypeOf(env.t, d, x)
            .NInst(decl: d, inst: i) :> known(instType(env.t, d, i))
            .NStruct(owner: o, idx: x) :> structFieldType(env.t, o, x)
            .NFn(sym: s) :> VType.Unknown
            .NLength :> known(Type.Int)
            .NSurface(of: x, prop: pr) :> surfaceType(pr)
            .NConst(sym: s) :> constVType(env.t, s)
            not :> VType.Unknown
        }
    }

    // s449 — a surface property's value type (§55.5 / §55.6): `isValid`,
    // `touched` and `submitted` are booleans; `errors` (a ValidationError
    // array, or a map of them) is refused as a value before typing.
    fn surfaceType(pr: SurfaceProp) -> VType {
        return match pr {
            .IsValid :> known(Type.Bool)
            .Touched :> known(Type.Bool)
            .Submitted :> known(Type.Bool)
            .Errors :> VType.Unknown
        }
    }

    // Is `c` a bare `@h` naming a CONDITIONALLY-mounted handle?
    fn isCondHandle(env: TEnv, c: AExpr) -> boolean {
        if (atName(c) == "") return false
        return condAlias(env.t, nameFact(env.t.names, c.nid))
    }

    fn condAlias(t: Tables, f: NameFact | not) -> boolean {
        return match f {
            .NInst(decl: d, inst: i) :> condAliasInst(t, i)
            .NLocal(sym: s) :> false
            .NField(decl: d) :> false
            .NStruct(owner: o) :> false
            .NFn(sym: s) :> false
            .NLength :> false
            .NSurface(of: x) :> false
            .NConst(sym: s) :> false
            not :> false
        }
    }

    fn condAliasInst(t: Tables, i: InstRef) -> boolean {
        return match i {
            .Alias(sym: s) :> handleConditional(t, s)
            .Shared(decl: d) :> false
            .Lexical(depth: n) :> false
            .Narrowed(sym: s) :> false
            .Kid(of: o) :> false
            .HandleOf(of: o) :> true
        }
    }

    fn handleConditional(t: Tables, s: Sym) -> boolean {
        for (const h of t.handles) {
            if (h.sym.id == s.id) return h.conditional
        }
        return false
    }

    // An instance's type: a handle to a conditionally-mounted instance is
    // `T | not` (§66.7.5) — so a bare `if=@h` over it is a presence test, and
    // an operator over it is un-narrowed; any other instance is `T`.
    fn instType(t: Tables, d: Sym, i: InstRef) -> Type {
        return match i {
            .Alias(sym: s) :> handleType(t, d, s)
            .Shared(decl: x) :> Type.Named(d)
            .Lexical(depth: n) :> Type.Named(d)
            .Narrowed(sym: s) :> Type.Named(d)
            .Kid(of: o) :> Type.Named(d)
            .HandleOf(of: o, sym: s) :> handleType(t, d, s)
        }
    }

    fn handleType(t: Tables, d: Sym, s: Sym) -> Type {
        for (const h of t.handles) {
            if (h.sym.id == s.id && h.conditional) return Type.Maybe(Type.Named(d))
        }
        return Type.Named(d)
    }

    // The function a callee names.
    fn calleeFn(f: NameFact | not) -> Sym | not {
        return match f {
            .NFn(sym: s) :> s
            .NLocal(sym: s) :> not
            .NField(decl: d) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            .NConst(sym: s) :> not
            not :> not
        }
    }

    // The type of a constant the binder resolved. (An operator's type is
    // computed from its operands, typeBinary / typeUnary.)
    fn valueType(f: ValueFact | not) -> VType {
        return match f {
            .VLit(lit: l) :> litType(l)
            .VVariant(enumSym: s) :> known(Type.Named(s))
            .VStructOf(ty: s) :> known(Type.Named(s))
            .VConstruct(enumSym: s) :> known(Type.Named(s))
            .VOp(op: o) :> VType.Unknown
            .VHost(call: c) :> known(Type.Num)
            .VSeqCall(op: o) :> VType.Unknown
            .VLambda(params: ps) :> VType.Unknown
            .VIndex(loc: x) :> VType.Unknown
            .VAt :> VType.Unknown
            .VTemplate(text: tx) :> known(Type.Str)
            .VToEnum(enumSym: s) :> VType.Unknown
            .VMethod(op: o) :> VType.Unknown
            not :> VType.Unknown
        }
    }

    fn opOf(f: ValueFact | not) -> PrimOp | not {
        return match f {
            .VOp(op: o) :> o
            .VLit(lit: l) :> not
            .VVariant(enumSym: s) :> not
            .VStructOf(ty: s) :> not
            .VConstruct(enumSym: s) :> not
            .VHost(call: c) :> not
            .VSeqCall(op: x) :> not
            .VLambda(params: ps) :> not
            .VIndex(loc: x) :> not
            .VAt :> not
            .VTemplate(text: tx) :> not
            .VToEnum(enumSym: s) :> not
            .VMethod(op: o) :> not
            not :> not
        }
    }

    // The Sym a binder binds (a local, a function, a parameter, a `given`).
    fn bindSym(f: BindFact | not) -> Sym | not {
        return match f {
            .BBind(sym: s) :> s
            .BParam(sym: s) :> s
            .BLoop(label: x) :> not
            .BJump(target: x) :> not
            .BGiven(sym: s) :> s
            not :> not
        }
    }

    // A parameter's (annotated) type.
    fn paramType(f: BindFact | not) -> VType {
        return match f {
            .BParam(sym: s, ty: y) :> known(y)
            .BLoop(label: x) :> VType.Unknown
            .BJump(target: x) :> VType.Unknown
            .BBind(sym: s) :> VType.Unknown
            .BGiven(sym: s) :> VType.Unknown
            not :> VType.Unknown
        }
    }

    // The classified writes a statement carries: a plain write is one
    // (`prop` = -1, the value is the assignment's / call's own), a spread its
    // overrides; anything else none.
    fn effectWrites(f: EffectFact | not) -> SpreadWrite[] {
        return match f {
            .EWrite(w: w) :> [oneWrite(w)]
            .ESpread(ws: ws) :> ws
            .EReset(w: w) :> []
            .EAssignLocal(sym: s) :> []
            .EEdits(w: w) :> [oneWrite(w)]
            .ERemove(w: w) :> [oneWrite(w)]
            .EElemAt(cap: c) :> []
            .EPosition(cap: c) :> []
            not :> []
        }
    }

    fn oneWrite(w: WriteFact) -> SpreadWrite { return { w: w, prop: -1, tmp: not } }

    fn isReset(f: EffectFact | not) -> boolean {
        return match f {
            .EReset(w: w) :> true
            .EWrite(w: w) :> false
            .ESpread(ws: ws) :> false
            .EAssignLocal(sym: s) :> false
            .EEdits(w: w) :> false
            .ERemove(w: w) :> false
            .EElemAt(cap: c) :> false
            .EPosition(cap: c) :> false
            not :> false
        }
    }

    // The local a rebinding `a = v` assigns (§66.11.5).
    fn assignedLocal(f: EffectFact | not) -> Sym | not {
        return match f {
            .EAssignLocal(sym: s) :> s
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EEdits(w: w) :> not
            .ERemove(w: w) :> not
            .EElemAt(cap: c) :> not
            .EPosition(cap: c) :> not
            not :> not
        }
    }

    // The field index a use-site attribute constructs (-1: not a construction).
    fn constructIndex(k: AttrKind | not) -> int {
        return match k {
            .AConstruct(field: i) :> i
            .AStatic :> -1
            .ABound :> -1
            .AOn(event: ev) :> -1
            .AIf :> -1
            .AShow :> -1
            .AAs :> -1
            .AEachIn :> -1
            .AEachKey :> -1
            .AEachAs :> -1
            .ABind(kind: k) :> -1
            not :> -1
        }
    }

    // The declaration a USE constructs.
    fn useDecl(f: ElemFact | not) -> Sym | not {
        return match f {
            .MUse(decl: d) :> d
            .MEach(bind: b) :> not
            .MHtml :> not
            .MSlot :> not
            .MDb :> not
            .MErrors(of: x) :> not
            .MStateView(v: v) :> not
            .MInline(v: v) :> not
            .MStar(decl: d) :> not
            not :> not
        }
    }

    // An `<each>`'s row binding.
    fn eachBind(f: ElemFact | not) -> Sym | not {
        return match f {
            .MEach(bind: b) :> b
            .MUse(decl: d) :> not
            .MHtml :> not
            .MSlot :> not
            .MDb :> not
            .MErrors(of: x) :> not
            .MStateView(v: v) :> not
            .MInline(v: v) :> not
            .MStar(decl: d) :> not
            not :> not
        }
    }
    fn fieldTypeOf(t: Tables, d: Sym, idx: int) -> VType {
        const di: DeclInfo | not = declInfo(t, d)
        if (di is not) return VType.Unknown
        if (idx < 0 || idx >= di.fields.length) return VType.Unknown
        // S444 review: a field whose type is untrusted (did not resolve, or failed
        // to parse) is never checked against — a read of it is unknown (r8)
        if (!di.fields[idx].trusted) return VType.Unknown
        return known(di.fields[idx].ty)
    }

    fn structFieldType(t: Tables, owner: Sym, idx: int) -> VType {
        const ti: TypeInfo | not = typeInfoOf(t.types, owner)
        if (ti is not) return VType.Unknown
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return VType.Unknown
        if (idx < 0 || idx >= fs.length) return VType.Unknown
        if (t.unresolved.fields.indexOf(fs[idx].sym.id) >= 0) return VType.Unknown     // r8
        return known(fs[idx].ty)
    }

    // The field a write capability belongs to (a capability is minted for one
    // field, core.scrml THE BINDER'S OBLIGATION).
    fn fieldOfCap(t: Tables, cap: Sym) -> FieldInfo | not {
        for (const d of t.decls) {
            for (const f of d.fields) {
                const c: Sym | not = f.wcap
                if (c is given) {
                    if (c.id == cap.id) return f
                }
            }
        }
        return not
    }

    // The type the written VALUE must have: the field's (replace, transition),
    // the sub-field's at the end of a FieldAt path, the element's for an edit.
    fn writeValueType(t: Tables, w: WriteFact) -> Type | not {
        const f: FieldInfo | not = fieldOfCap(t, w.cap)
        if (f is not) return not
        const e: EditKind = w.edit
        return match e {
            .Replace :> f.ty
            .Transition :> f.ty
            .FieldAt(path: p) :> pathType(t, p)
            .Append :> seqElem(f.ty)
            .Prepend :> seqElem(f.ty)
            .Anywhere :> seqElem(f.ty)
            .PositionWrite :> f.ty                   // s444: `@x = @x.map(λ)` writes the whole mapped sequence
            .RemoveEnd :> Type.Int                   // s444: the count removed
            .RemoveFront :> Type.Int
            .RemoveAnywhere :> f.ty                  // s444: `@x = @x.filter(λ)` writes the whole filtered sequence
            .ElemAt(index: x, path: p) :> pathType(t, p)
            .PositionAt(index: x) :> seqElem(f.ty)       // s472: `@xs[i] = v` writes one element
        }
    }

    fn pathType(t: Tables, path: FieldRef[]) -> Type | not {
        if (path.length == 0) return not
        const last: FieldRef = path[path.length - 1]
        return knownOf(structFieldType(t, last.owner, last.idx))
    }

    // ---- the checks ------------------------------------------------------------
    // A value into a typed position (a write): E-TYPE-031 when it provably
    // does not fit, E-TYPE-041 for `not` into a type without `| not`.
    // s472 audit (g-boot-mixed-arm-type-unresolved-fail-open-s472): `Unknown`
    // stays provable-or-silent here — it is a value the typer was never given a
    // type for (a call of a function with no written return type, a host
    // value, a `?{}` row, a `!{}` / `?` success type …). A value whose
    // branches the typer DID resolve, to types with no common type, is a
    // `OneOf`, never an Unknown: each member is checked (checkOneOf).
    fn checkValue(env: TEnv, v: VType, target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: x) :> checkKnown(env, x, target, span, what, ts)
            .Absent :> checkAbsent(env, target, span, what, ts)
            .Unknown :> ts
            .OneOf(ts: xs) :> checkOneOf(env, xs, target, span, what, ts)
        }
    }

    // A choice into a typed position: each branch is the value when it is
    // taken, so each must fit (§66.1 rule 5; §17.6's union rule).
    fn checkOneOf(env: TEnv, xs: Type[], target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        for (const x of xs) {
            if (mayBeNot(x, target) || fitsType(x, target) == Verdict.Fails) {
                return report(ts, env, span, "E-TYPE-031", what + " expects " + shownT(env, target) + ", and this value may be " + shownT(env, x) + " — it is one of " + oneOfName(xs) + " (a choice whose branches have different types: each branch is the value when it is taken, and each must fit; §66.1 rule 5: every cell and field write is type-checked against the target's declared type)" + intHint(unMaybe(x), unMaybe(target)))
            }
        }
        return ts
    }

    fn checkKnown(env: TEnv, x: Type, target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        if (mayBeNot(x, target)) {
            return report(ts, env, span, "E-TYPE-031", what + " expects " + shownT(env, target) + ", and this value is " + shownT(env, x) + " — a `T | not` is not a `T`: it may be `not`; narrow it first (`if (x is given) { … }`) (§34 E-TYPE-031; ruled S442: \"`T | not` into `T` is an error for all types\")")
        }
        if (fitsType(x, target) != Verdict.Fails) return ts
        return report(ts, env, span, "E-TYPE-031", what + " expects " + shownT(env, target) + ", and this value is " + shownT(env, x) + " (§66.1 rule 5: every cell and field write is type-checked against the target's declared type)" + intHint(unMaybe(x), unMaybe(target)) + sameNameNote(env, target, x))
    }

    // s472 r1 (F4): two different types that print alike (`Color` from two files —
    // file scope lets each file declare its own) are told apart by declaring file.
    fn sameNameNote(env: TEnv, target: Type, x: Type) -> string {
        if (typeName(target) != typeName(x)) return ""
        const a: Sym | not = namedOf(unMaybe(target))
        const b: Sym | not = namedOf(unMaybe(x))
        if (a is not) return ""
        if (b is not) return ""
        if (a.id == b.id) return ""
        const ta: TypeInfo | not = typeInfoOf(env.t.types, a)
        if (ta is not) return ""
        const tb: TypeInfo | not = typeInfoOf(env.t.types, b)
        if (tb is not) return ""
        return " — these are two different types named `" + ta.name + "`: the expected one is declared in `" + ta.file + "`, this value's in `" + tb.file + "`"
    }

    // An UN-NARROWED `T | not` into a non-optional `T` position — at any depth
    // of sequence elements (`[@o.n]` into `int[]`). RULED S442 (dpa-058 list
    // item 4): "`T | not` into `T` is an error for EVERY type … A `T | not`
    // isn't a `T`" — bryan: "if the lifecycle says T | not then it can only
    // end as not". Supersedes the S439 "unproven, not wrong" reading. (A
    // narrowed value reads as `T` and never reaches here as `T | not`; a value
    // whose `T` itself does not fit is fitsType's plain Fails.)
    fn mayBeNot(x: Type, target: Type) -> boolean {
        const xi: Type | not = maybeInner(x)
        const ti: Type | not = maybeInner(target)
        if (xi is given) {
            // both optional: the outer `not` is admitted — look inside (r7 B)
            if (ti is given) return mayBeNot(xi, ti)
            return fitsType(xi, target) != Verdict.Fails
        }
        // an optional TARGET admits the outer `not`, not a `not` element
        // inside (`[@o.n]` into `int[] | not`, r7 B)
        if (ti is given) return mayBeNot(x, ti)
        const xe: Type | not = seqElem(x)
        const te: Type | not = seqElem(target)
        if (xe is given && te is given) return mayBeNot(xe, te)
        return false
    }

    // A `number` into an `int` (RULED S440, JS-WAT 7(a)): say why and what to write.
    fn intHint(x: Type, target: Type) -> string {
        if (kindOf(target) == 0 && kindOf(x) == 1) return " — `int` is enforced: a `number` is not implicitly an `int` (integer division is explicit: `div(a, b, .Mode)`; ruled S440, JS-WAT 7(a))"
        return ""
    }

    fn checkAbsent(env: TEnv, target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        if (maybeInner(target) is given) return ts
        return report(ts, env, span, "E-TYPE-041", "`not` is assigned to " + what + " of non-optional type `" + typeName(target) + "` — only a `" + typeName(target) + " | not` position holds `not` (§42.3.1)")
    }

    // §7.5.1 positions 1 / 2 (and §66.9 rule 8 at a use site): an ANNOTATED
    // `number` / `string` / `boolean` — and, RULED S440 (JS-WAT 7(a), "enforce
    // `int`"; PA note: "§7.5.1's provable domain widens to `int` with it"),
    // `int` — given a literal of a different primitive. An `int` takes an
    // INTEGER literal only (`1.5` is not an `int`); a `number` takes either.
    // (SPEC §7.5.1 still says `int` is "deliberately OUTSIDE" the set — the
    // S440 ruling widens it; SPEC pass 2 owes the text.)
    // 0 non-integer number literal · 4 integer literal · 1 string literal ·
    // 2 boolean literal · 3 `not` · -1 other.
    fn literalKind(e: AExpr) -> int {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> numLitKind(r)
            .Str(v: s) :> 1
            .Bool(v: b) :> 2
            .NotLit :> 3
            .Recovered :> -1
            .Unary(op: o, e: x) :> negLiteralKind(o, x)
            .Name(name: n) :> -1
            .At(name: n) :> -1
            .AtItem :> -1
            .Variant(name: n) :> -1
            .Member(obj: o) :> -1
            .Call(callee: c) :> -1
            .Binary(op: o) :> -1
            .Ternary(test: x) :> -1
            .Assign(target: x) :> -1
            .ArrayLit(elems: es) :> -1
            .ObjectLit(props: ps) :> -1
            .Spread(e: sx) :> -1
            .Index(obj: ix) :> -1
            .Lambda(params: lp) :> -1
            .Sql(q: q) :> -1
            .Handled(h: x) :> -1
            .Template(quasis: qs) :> -1
            .Foreign(f: fb0) :> -1
        }
    }

    fn numLitKind(raw: string) -> int {
        const t: Type = numType(raw)
        const isInt: boolean = t == Type.Int
        if (isInt) return 4
        return 0
    }

    // `-5` is a number literal; `!true` is an operator applied to one.
    fn negLiteralKind(o: UnOp, x: AExpr) -> int {
        const isNeg: boolean = o == UnOp.Neg
        if (!isNeg) return -1
        const lk: int = literalKind(x)
        if (lk == 0 || lk == 4) return lk
        return -1
    }

    fn primitiveOfLiteral(lk: int) -> string {
        if (lk == 0) return "non-integer number"
        if (lk == 4) return "number"
        if (lk == 1) return "string"
        return "boolean"
    }

    // Does an initializer literal of kind `lk` fit an annotation of kind `tk`?
    // (-1: the annotation is outside the checked set — a named type, a
    // sequence, `T | not` — and is not judged here.)
    fn literalFits(tk: int, lk: int) -> int {
        if (tk == 0) {
            if (lk == 4) return 1
            return 0
        }
        if (tk == 1) {
            if (lk == 0 || lk == 4) return 1
            return 0
        }
        if (tk == 2) {
            if (lk == 1) return 1
            return 0
        }
        if (tk == 3) {
            if (lk == 2) return 1
            return 0
        }
        return -1
    }

    fn checkInit(env: TEnv, target: Type, lk: int, span: ASpan, what: string, ts: TypeState) -> TypeState {
        if (lk < 0) return ts
        if (lk == 3) return checkAbsent(env, target, span, what, ts)
        if (literalFits(kindOf(target), lk) != 0) return ts
        let lit: string = primitiveOfLiteral(lk)
        if (kindOf(target) == 0 && lk == 0) lit = "non-integer number"
        return report(ts, env, span, "E-TYPE-031", what + " is annotated `" + typeName(target) + "`, and its initializer is a " + lit + " literal (§7.5.1: an annotated `let` / `const` or declaration whose initializer is a literal of a different primitive; a use-site value is that field's initializer, §66.9 rule 8; `int` enforced, ruled S440 JS-WAT 7(a))")
    }

    fn attrLiteralKind(v: AAttrValue) -> int {
        return match v {
            .Quoted(v: s) :> 1
            .Bare(e: e) :> literalKind(e)
            .Paren(e: e) :> literalKind(e)
            .NoValue :> -1
            .Braced(b: b) :> -1
        }
    }

    // ---- expressions -----------------------------------------------------------
    fn typeExprs(env: TEnv, es: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const e of es) { ts = typeExpr(env, e, ts).ts }
        return ts
    }

    fn typeExpr(env: TEnv, e: AExpr, ts: TypeState) -> RVT {
        const r: RVT = typeExprK(tCallUnnarrow(env, e), e, ts)
        return rvt(r.vt, record(r.ts, e.nid, r.vt))
    }

    // s451: each expression typed in order (a query's bound values).
    fn typeExprList(env: TEnv, es: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const e of es) { ts = typeExpr(env, e, ts).ts }
        return ts
    }

    fn typeExprK(env: TEnv, e: AExpr, ts: TypeState) -> RVT {
        const nf: NameFact | not = nameFact(env.t.names, e.nid)
        const vf: ValueFact | not = valueFact(env.t.values, e.nid)
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> rvt(narrowRead(env, e, nameType(env, nf)), ts)
            .At(name: n) :> rvt(narrowRead(env, e, nameType(env, nf)), ts)
            .AtItem :> rvt(nameType(env, nf), ts)
            .Num(raw: r) :> rvt(valueType(vf), ts)
            .Str(v: s) :> rvt(valueType(vf), ts)
            .Bool(v: b) :> rvt(valueType(vf), ts)
            .NotLit :> rvt(VType.Absent, ts)
            .Recovered :> rvt(VType.Unknown, ts)                 // a parse-error placeholder is never typed
            .Variant(name: n) :> rvt(valueType(vf), ts)
            .Member(obj: o, name: n) :> typeMember(env, e, nf, o, ts)
            .Call(callee: c, args: args) :> typeCall(env, e, c, args, ts)
            .Unary(op: o, e: x) :> typeUnary(env, e, o, x, ts)
            .Binary(op: o, l: l, r: r) :> typeBinary(env, e, vf, o, l, r, ts)
            .Ternary(test: x, yes: y, no: n) :> typeTernary(env, x, y, n, ts)
            .Assign(target: x, value: v, kept: kp) :> typeAssignValue(env, e, x, v, kp, ts)   // s474 (§50, D10)
            .ArrayLit(elems: es) :> typeArray(env, es, ts)
            .ObjectLit(props: ps) :> rvt(valueType(vf), typePropValues(env, ps, ts))
            .Spread(e: x) :> rvt(VType.Unknown, typeExpr(env, x, ts).ts)
            .Index(obj: o, idx: i) :> typeIndexRead(env, vf, o, i, ts)   // s469 (§49.13)
            .Lambda(params: ps2, body: b) :> typeLambda(env, e, b, ts)
            .Handled(h: h) :> typeHandled(env, e, h, ts)   // s451 (Ue)
            .Template(quasis: qs, slots: ss) :> typeTemplate(env, ss, ts)   // s469 (§14.13.3)
            .Foreign(f: fb0) :> typeForeign(env, fb0, ts)                  // s473 (§23.2.4a)
            .Sql(q: q) :> rvt(VType.Unknown, typeExprList(env, q.params, ts))   // s451: no row type yet (§14.8 schema types are not in the bootstrap)
        }
    }

    // s444 — a lambda: its body typed with its parameters bound (their types
    // are the binder's annotations — the sequence's element type).
    fn typeLambda(env: TEnv, e: AExpr, body: AExpr, ts: TypeState) -> RVT {
        let env2: TEnv = env
        for (const s of lambdaSyms(valueFact(env.t.values, e.nid))) {
            const a: Type | not = annotOf(env.t, s)
            let vt: VType = VType.Unknown
            if (a is given) vt = known(a)
            env2 = tWithLocal(env2, s, vt)
        }
        return rvt(VType.Unknown, typeExpr(env2, body, ts).ts)
    }

    fn lambdaSyms(f: ValueFact | not) -> Sym[] {
        return match f {
            .VLambda(params: ps) :> ps
            .VIndex(loc: x) :> []
            .VAt :> []
            .VTemplate(text: tx) :> []
            .VToEnum(enumSym: s) :> []
            .VMethod(op: o) :> []
            .VLit(lit: l) :> []
            .VVariant(enumSym: s) :> []
            .VStructOf(ty: s) :> []
            .VConstruct(enumSym: s) :> []
            .VOp(op: o) :> []
            .VHost(call: c) :> []
            .VSeqCall(op: o) :> []
            not :> []
        }
    }

    // s444 — the type of a call that names no function: a host call's, or a
    // filter's (the sequence it filters — the same type).
    fn builtinCallType(env: TEnv, e: AExpr, callee: AExpr, ts: TypeState) -> VType {
        const f: ValueFact | not = valueFact(env.t.values, e.nid)
        return match f {
            .VHost(call: c) :> known(Type.Num)
            .VSeqCall(op: o) :> seqCallType(ts, o, callee)
            .VLit(lit: l) :> VType.Unknown
            .VVariant(enumSym: s) :> VType.Unknown
            .VStructOf(ty: s) :> VType.Unknown
            .VConstruct(enumSym: s) :> VType.Unknown
            .VOp(op: o) :> VType.Unknown
            .VLambda(params: ps) :> VType.Unknown
            .VIndex(loc: x) :> VType.Unknown
            .VAt :> atCallType(ts, callee)
            .VTemplate(text: tx) :> VType.Unknown
            .VToEnum(enumSym: s) :> known(Type.Maybe(Type.Named(s)))
            .VMethod(op: o) :> methodType(ts, o, callee)
            not :> VType.Unknown
        }
    }

    // s469 — a typed built-in method's value: methodResult over the receiver's
    // type (the binder admitted the call only for a receiver of a known type).
    fn methodType(ts: TypeState, op: PrimOp, callee: AExpr) -> VType {
        if (isParseOp(op)) return known(methodResult(op, Type.Str))    // `int.parse(s)`: the receiver is a type, not a value
        const obj: AExpr | not = memberObj(callee)
        if (obj is not) return VType.Unknown
        const rt: Type | not = knownOf(exprType0(ts, obj.nid))
        if (rt is not) return VType.Unknown
        return known(methodResult(op, rt))
    }

    // s469 — a typed built-in method's ARGUMENTS against its signature
    // (methodSig, the one table): a value of another type is E-TYPE-031; one
    // whose type is not known is refused (a built-in's argument is never
    // handed to the host unchecked — fail closed). Also a comparator's body
    // (`xs.sort((a, b) => n)`) is a number (S440 #10).
    fn methodArgCheck(env: TEnv, e: AExpr, args: AExpr[], ts0: TypeState) -> TypeState {
        const f: ValueFact | not = valueFact(env.t.values, e.nid)
        const op: PrimOp | not = methodOfFact(f)
        if (op is not) return comparatorCheck(env, f, args, ts0)
        const sig: Type[] = methodSig(op)
        let ts: TypeState = ts0
        let i = 0
        for (const a of args) {
            if (i < sig.length) {
                const vt: VType = exprType0(ts, a.nid)
                const what: string = "argument " + (i + 1) + " of `." + methodName(op) + "(…)`"
                if (knownOf(vt) is not && !isAbsentVT(vt)) {
                    if (!hasErrIn(env.errs, a.span)) ts = report(ts, env, a.span, "E-BOOTSTRAP-UNSUPPORTED", what + " has a type the compiler cannot resolve — a built-in method's argument must be a `" + typeName(sig[i]) + "` the compiler can see; annotate it")
                } else {
                    ts = checkValue(env, vt, sig[i], a.span, what + " (a `" + typeName(sig[i]) + "`)", ts)
                }
            }
            i = i + 1
        }
        return ts
    }

    fn comparatorCheck(env: TEnv, f: ValueFact | not, args: AExpr[], ts: TypeState) -> TypeState {
        if (!isSortByFact(f) || args.length != 1) return ts
        const body: AExpr | not = lambdaBody(args[0])
        if (body is not) return ts
        const bt: Type | not = knownOf(exprType0(ts, body.nid))
        if (bt == Type.Int || bt == Type.Num) return ts
        if (hasErrIn(env.errs, body.span)) return ts
        if (bt is not) return report(ts, env, body.span, "E-BOOTSTRAP-UNSUPPORTED", "the comparator of `.sort(…)` returns a value whose type the compiler cannot resolve — it must return a number (negative: `a` first; positive: `b` first; zero: keep their order)")
        return report(ts, env, body.span, "E-TYPE-031", "the comparator of `.sort(…)` must return a number (negative: `a` first; positive: `b` first; zero: keep their order), and this one returns `" + typeName(bt) + "` (S440 #10)")
    }

    fn isSortByFact(f: ValueFact | not) -> boolean {
        return match f {
            .VSeqCall(op: o) :> o == SeqFn.SortBy
            .VMethod(op: o) :> false
            .VToEnum(enumSym: s) :> false
            .VIndex(loc: zl) :> false
            .VAt :> false
            .VTemplate(text: tx) :> false
            .VLit(lit: l) :> false
            .VVariant(enumSym: s) :> false
            .VStructOf(ty: s) :> false
            .VConstruct(enumSym: s) :> false
            .VOp(op: o) :> false
            .VHost(call: c) :> false
            .VLambda(params: ps) :> false
            not :> false
        }
    }

    fn methodOfFact(f: ValueFact | not) -> PrimOp | not {
        return match f {
            .VMethod(op: o) :> o
            .VToEnum(enumSym: s) :> not
            .VIndex(loc: zl) :> not
            .VAt :> not
            .VTemplate(text: tx) :> not
            .VLit(lit: l) :> not
            .VVariant(enumSym: s) :> not
            .VStructOf(ty: s) :> not
            .VConstruct(enumSym: s) :> not
            .VOp(op: o) :> not
            .VHost(call: c) :> not
            .VSeqCall(op: o) :> not
            .VLambda(params: ps) :> not
            not :> not
        }
    }

    // s469 — `E.toEnum(s)`'s signature is `string -> E | not` (§14.4.1).
    fn toEnumArgCheck(env: TEnv, e: AExpr, args: AExpr[], ts: TypeState) -> TypeState {
        if (args.length != 1) return ts
        if (!isToEnumFact(valueFact(env.t.values, e.nid))) return ts
        return checkValue(env, exprType0(ts, args[0].nid), Type.Str, args[0].span, "the argument of `E.parse` / `E.toEnum` (a string, §14.13.4)", ts)
    }

    fn isVariantFact(f: ValueFact | not) -> boolean {
        return match f {
            .VVariant(enumSym: s) :> true
            .VToEnum(enumSym: s) :> false
            .VMethod(op: o) :> false
            .VLit(lit: l) :> false
            .VStructOf(ty: s) :> false
            .VConstruct(enumSym: s) :> false
            .VOp(op: o) :> false
            .VHost(call: c) :> false
            .VSeqCall(op: o) :> false
            .VLambda(params: ps) :> false
            .VIndex(loc: x) :> false
            .VAt :> false
            .VTemplate(text: tx) :> false
            not :> false
        }
    }

    fn isToEnumFact(f: ValueFact | not) -> boolean {
        return match f {
            .VToEnum(enumSym: s) :> true
            .VMethod(op: o) :> false
            .VLit(lit: l) :> false
            .VVariant(enumSym: s) :> false
            .VStructOf(ty: s) :> false
            .VConstruct(enumSym: s) :> false
            .VOp(op: o) :> false
            .VHost(call: c) :> false
            .VSeqCall(op: o) :> false
            .VLambda(params: ps) :> false
            .VIndex(loc: x) :> false
            .VAt :> false
            .VTemplate(text: tx) :> false
            not :> false
        }
    }

    fn seqCallType(ts: TypeState, o: SeqFn, callee: AExpr) -> VType {
        const isFilter: boolean = o == SeqFn.Filter || o == SeqFn.SortBy
        if (!isFilter) return VType.Unknown
        const obj: AExpr | not = memberObj(callee)
        if (obj is not) return VType.Unknown
        const rt: Type | not = knownOf(exprType0(ts, obj.nid))
        if (rt is not) return VType.Unknown
        return known(ungranted(rt))      // s469 F/U-5: a new tape carries its own type's grants — none
    }

    fn typeMember(env: TEnv, e: AExpr, f: NameFact | not, obj: AExpr, ts: TypeState) -> RVT {
        // s469: a qualified unit variant `E.V` (the binder's VVariant; `E` is a type, not typed)
        const vf: ValueFact | not = valueFact(env.t.values, e.nid)
        if (isVariantFact(vf)) return rvt(valueType(vf), ts)
        const ro: RVT = typeExpr(env, obj, ts)
        return rvt(narrowRead(env, e, nameType(env, f)), ro.ts)
    }

    fn typePropValues(env: TEnv, ps: AProp[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const p of ps) { ts = typeExpr(env, p.value, ts).ts }
        return ts
    }

    fn typeUnary(env: TEnv, e: AExpr, o: UnOp, x: AExpr, ts: TypeState) -> RVT {
        const r: RVT = typeExpr(env, x, ts)
        // s460: `x is given` / `x is not` is a `bool` over an operand of any
        // type (§42.2.4) — the operand needs no narrowing; it is what narrows
        if (o == UnOp.IsGiven || o == UnOp.IsNot) return rvt(known(Type.Bool), r.ts)
        const isNot: boolean = o == UnOp.Not
        if (hasErrIn(env.errs, e.span)) {
            // Rule C: an operation holding a parser error is not judged
            if (isNot) return rvt(known(Type.Bool), r.ts)
            return rvt(VType.Unknown, r.ts)
        }
        if (isNot) return rvt(known(Type.Bool), checkBoolOperand(env, x, r.vt, "`!`", r.ts))
        const ts2: TypeState = checkNumOperand(env, x, r.vt, "unary `-`", r.ts)
        if (ts2.diags.length > r.ts.diags.length) return rvt(VType.Unknown, ts2)
        const xt: Type | not = knownOf(r.vt)
        if (xt is given && isNumericKind(xt)) return rvt(r.vt, ts2)
        return rvt(VType.Unknown, ts2)
    }

    // `&&` / `||`: the right operand is evaluated only when the left one is
    // true / false, so it is typed under that narrowing (`x is given && x > 0`).
    fn typeBinary(env: TEnv, e: AExpr, f: ValueFact | not, bop: BinOp, l: AExpr, r: AExpr, ts: TypeState) -> RVT {
        const rl: RVT = typeExpr(env, l, ts)
        let renv: TEnv = env
        const isAnd: boolean = bop == BinOp.And
        const isOr: boolean = bop == BinOp.Or
        if (isAnd) renv = tCallUnnarrow(tNarrow(env, condNarrowing(env, l).yes), l)   // r3 N1: what the left operand's calls write is not narrowed
        if (isOr) renv = tCallUnnarrow(tNarrow(env, condNarrowing(env, l).no), l)
        const rr: RVT = typeExpr(renv, r, rl.ts)
        const op: PrimOp | not = opOf(f)
        if (op is not) return rvt(VType.Unknown, rr.ts)
        const ts2: TypeState = checkOperands(env, e, op, l, r, rl.vt, rr.vt, rr.ts)
        // a refused operation has no type to pass on (no second report downstream)
        if (ts2.diags.length > rr.ts.diags.length) return rvt(VType.Unknown, ts2)
        return rvt(binaryType(op, rl.vt, rr.vt), ts2)
    }

    // ---- OPERATORS AND CONDITIONS (RULED S440) ----------------------------------
    // Gotcha Q1: "arithmetic and relational operators take NUMBERS only; `+`
    // takes two numbers or two strings; string ordering goes through an
    // explicit compare." Gotcha Q2: "`!`, `&&`, `||` (and `and`/`or`) take
    // booleans only; defaults use `??`." Gotcha Q3: "a `T | not` operand must
    // be narrowed before `+`, arithmetic, comparison, or use in a template."
    // Truthiness Q2: "an immediate error wherever the violation is PROVABLE,
    // silence where the type is unknown (provable-or-silent)" — still the rule
    // for every OPERAND here; superseded for CONDITIONS by S460 (checkCond).
    // dpa-054 #3: "`/`
    // between two `int`s … is a compile error naming the fix".
    // No SPEC text or code exists yet for these (SPEC pass 2 owes both), so the
    // codes are PROPOSED here and flagged: E-OPERATOR-OPERAND-TYPE (an operand
    // of a type the operator does not take), E-OPERAND-NOT-NARROWED (a `T |
    // not` operand, un-narrowed, whose `T` the operator would take),
    // E-INT-DIVISION (`/` on two `int`s), E-COND-NOT-BOOLEAN (a condition that
    // is neither a `bool` nor a `T | not` presence test).
    // `==` / `!=` are out of this rule (§45.3 E-EQ-001 is its own conformance
    // item); a `T | not` compared with `not` is how a presence test is spelled.
    fn checkOperands(env: TEnv, e: AExpr, op: PrimOp, l: AExpr, r: AExpr, a: VType, b: VType, ts: TypeState) -> TypeState {
        // Rule C (S439): nothing is checked against what failed to parse — an
        // operation whose own span holds a parser error is not judged.
        if (hasErrIn(env.errs, e.span)) return ts
        return match op {
            .Add :> checkPlus(env, e, l, r, a, b, ts)
            .Concat :> checkPlus(env, e, l, r, a, b, ts)
            .Sub :> checkNumPair(env, e, l, r, a, b, "`-`", ts)
            .Mul :> checkNumPair(env, e, l, r, a, b, "`*`", ts)
            .Mod :> checkNumPair(env, e, l, r, a, b, "`%`", ts)
            .Div :> checkDiv(env, e, l, r, a, b, ts)
            .Lt :> checkNumPair(env, e, l, r, a, b, "`<`", ts)
            .Le :> checkNumPair(env, e, l, r, a, b, "`<=`", ts)
            .Gt :> checkNumPair(env, e, l, r, a, b, "`>`", ts)
            .Ge :> checkNumPair(env, e, l, r, a, b, "`>=`", ts)
            .And :> checkBoolOperand(env, r, b, "`&&`", checkBoolOperand(env, l, a, "`&&`", ts))
            .Or :> checkBoolOperand(env, r, b, "`||`", checkBoolOperand(env, l, a, "`||`", ts))
            .EqPrim :> checkEqTypes(env, e, a, b, ts)
            .NeqPrim :> checkEqTypes(env, e, a, b, ts)
            .EqStruct :> checkEqTypes(env, e, a, b, ts)
            .NeqStruct :> checkEqTypes(env, e, a, b, ts)
            .IsSome :> ts
            .IsNot :> ts
            .Not :> ts
            .Neg :> ts
            .Length :> ts
            .StrUpper :> ts
            .StrLower :> ts
            .StrTrim :> ts
            .StrSlice :> ts
            .StrCharAt :> ts
            .StrLength :> ts
            .StrIncludes :> ts
            .StrStartsWith :> ts
            .StrEndsWith :> ts
            .StrSplit :> ts
            .SortNum :> ts
            .SortStr :> ts
            .Reverse :> ts
            .Join :> ts
            .IndexRead :> ts
            .AtRead :> ts
            .StrIndexOf :> ts
            .StrLastIndexOf :> ts
            .StrReplace :> ts
            .StrReplaceAll :> ts
            .StrPadStart :> ts
            .StrPadEnd :> ts
            .StrRepeat :> ts
            .StrTrimStart :> ts
            .StrTrimEnd :> ts
            .ParseInt :> ts
            .ParseNum :> ts
            .ParseBool :> ts
            .Text :> ts
        }
    }

    fn checkNumPair(env: TEnv, e: AExpr, l: AExpr, r: AExpr, a: VType, b: VType, what: string, ts: TypeState) -> TypeState {
        return checkNumOperand(env, r, b, what, checkNumOperand(env, l, a, what, ts))
    }

    // `/` is float-only (dpa-054 #3): two provable `int`s are refused, naming `div`.
    fn checkDiv(env: TEnv, e: AExpr, l: AExpr, r: AExpr, a: VType, b: VType, ts0: TypeState) -> TypeState {
        const ts: TypeState = checkNumPair(env, e, l, r, a, b, "`/`", ts0)
        if (ts.diags.length > ts0.diags.length) return ts
        const x: Type | not = knownOf(a)
        const y: Type | not = knownOf(b)
        if (x is given && y is given) {
            if (kindOf(unMaybe(x)) == 0 && kindOf(unMaybe(y)) == 0) {
                return report(ts, env, e.span, "E-INT-DIVISION", "`/` between two `int`s — `/` is float-only (it divides `number`s); integer division is explicit: `div(a, b, .Mode)`, the rounding mode required (dpa-054 #3, ruled S440; `int` enforced, JS-WAT 7(a)). (`div` itself is not in the bootstrap yet.)")
            }
        }
        return ts
    }

    // An arithmetic / relational operand: a number.
    fn checkNumOperand(env: TEnv, x: AExpr, v: VType, what: string, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: t) :> numKnown(env, x, t, what, ts)
            .Absent :> operandType(env, x, "not", what, "numbers", ts)
            .Unknown :> ts
            .OneOf(ts: xs) :> numOneOf(env, x, xs, what, ts)
        }
    }

    // s472 — a choice operand: each member is the operand when its branch is taken.
    fn numOneOf(env: TEnv, x: AExpr, xs: Type[], what: string, ts: TypeState) -> TypeState {
        for (const t of xs) {
            const r: TypeState = numKnown(env, x, t, what, ts)
            if (r.diags.length > ts.diags.length) return r
        }
        return ts
    }

    fn numKnown(env: TEnv, x: AExpr, t: Type, what: string, ts: TypeState) -> TypeState {
        if (isNumericKind(t)) return ts
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            if (isNumericKind(inner)) return notNarrowed(env, x, t, what, ts)
        }
        return operandType(env, x, typeName(t), what, "numbers", ts)
    }

    // A `!` / `&&` / `||` operand: a bool.
    fn checkBoolOperand(env: TEnv, x: AExpr, v: VType, what: string, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: t) :> boolKnown(env, x, t, what, ts)
            .Absent :> operandType(env, x, "not", what, "booleans", ts)
            .Unknown :> ts
            .OneOf(ts: xs) :> boolOneOf(env, x, xs, what, ts)
        }
    }

    fn boolOneOf(env: TEnv, x: AExpr, xs: Type[], what: string, ts: TypeState) -> TypeState {
        for (const t of xs) {
            const r: TypeState = boolKnown(env, x, t, what, ts)
            if (r.diags.length > ts.diags.length) return r
        }
        return ts
    }

    fn boolKnown(env: TEnv, x: AExpr, t: Type, what: string, ts: TypeState) -> TypeState {
        if (kindOf(t) == 3) return ts
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            if (kindOf(inner) == 3) return notNarrowed(env, x, t, what, ts)
        }
        return operandType(env, x, typeName(t), what, "booleans", ts)
    }

    // `+`: two numbers or two strings. Each operand first (a `T | not`, a
    // bool, a struct … is refused whatever the other is), then the pair.
    // s469 (templates review r2 — found by the end-to-end fuzz: `0 != ""` compiled
    // clean and ran strict, where a JavaScript reader means loose equality) —
    // §45 E-EQ-001: "`==` applied to incompatible types. The type system prevents
    // cross-type comparison before the operator is evaluated." Judged where both
    // operand types are PROVABLE and of different kinds (`int` and `number` are
    // one kind for this; a primitive, a named type and a tape are three) —
    // provable-or-silent, as every operand check here.
    fn checkEqTypes(env: TEnv, e: AExpr, a: VType, b: VType, ts: TypeState) -> TypeState {
        const x0: Type | not = knownOf(a)
        const y0: Type | not = knownOf(b)
        // s473 (§21.3.3 rule 15): "It is not comparable: `==` or `!=` on a type that
        // contains a declared `:host` type SHALL be `E-EQ-003`, as for a function (§45.2)"
        let hosty: boolean = false
        if (x0 is given) hosty = containsHost(env.t.types, x0, 0)
        if (y0 is given && !hosty) hosty = containsHost(env.t.types, y0, 0)
        if (hosty) return report(ts, env, e.span, "E-EQ-003", "equality on a value of a declared `:host` handle type — a host handle is not comparable (§21.3.3 rule 15, §45.2: there is no identity comparison in scrml, §45.6); test it with `is given` / `is not`, or declare a binding that compares on the host side")
        if (x0 is not || y0 is not) return ts
        const x: Type = unMaybe(x0)
        const y: Type = unMaybe(y0)
        if (eqSameType(env, x, y)) return ts
        return report(ts, env, e.span, "E-EQ-001", "`==` compares values of one type, and this is `" + typeName(x) + "` with `" + typeName(y) + "` — convert one first (`T.parse(s)`, or a template for text) (§45, §14.13.1)")
    }

    // RULED (user-voice S469, bryan: "Ratify: same type only (Rec)"): `==` / `!=`
    // compares two values of the SAME type only — an enum against a string
    // included; `int` and `number` count as one kind. Two named types are the
    // same when they name the same declaration; two tapes when their elements
    // are (a `T | not` element read as its `T`, as an operand is). A DECLARATION's
    // type (an instance / cell of a user declaration, §66.8) is not judged here:
    // its reads have their own §45.6 rules, and a shared cell's read can stand for
    // its value (`@mode == .Dark`, §66.19.4) — provable-or-silent.
    fn eqSameType(env: TEnv, x: Type, y: Type) -> boolean {
        if (isNumericKind(x) && isNumericKind(y)) return true
        const kx: int = kindOf(x)
        if (kx != kindOf(y)) return false
        if (kx == 4) {
            const sx: Sym | not = namedOf(x)
            const sy: Sym | not = namedOf(y)
            if (sx is not || sy is not) return true            // not provable: silent
            if (isDeclSym(env, sx) || isDeclSym(env, sy)) return true
            return sx.id == sy.id
        }
        if (kx == 5) {
            const ex: Type | not = seqElem(x)
            const ey: Type | not = seqElem(y)
            if (ex is not || ey is not) return true
            return eqSameType(env, unMaybe(ex), unMaybe(ey))
        }
        return true
    }

    fn isDeclSym(env: TEnv, s: Sym) -> boolean {
        for (const d of env.t.decls) {
            if (d.sym.id == s.id) return true
        }
        return false
    }

    fn checkPlus(env: TEnv, e: AExpr, l: AExpr, r: AExpr, a: VType, b: VType, ts0: TypeState) -> TypeState {
        const ts: TypeState = plusOperand(env, r, b, plusOperand(env, l, a, ts0))
        if (ts.diags.length > ts0.diags.length) return ts
        const x0: Type | not = knownOf(a)
        const y0: Type | not = knownOf(b)
        if (x0 is not || y0 is not) return ts
        // an operand the check above let through as `T | not` (a joined local) counts as its `T`
        const x: Type = unMaybe(x0)
        const y: Type = unMaybe(y0)
        if (isNumericKind(x) && isNumericKind(y)) return ts
        if (kindOf(x) == 2 && kindOf(y) == 2) return ts
        return report(ts, env, e.span, "E-OPERATOR-OPERAND-TYPE", "`+` takes two numbers or two strings, and this is `" + typeName(x) + " + " + typeName(y) + "` — convert explicitly (ruled S440, Gotcha Q1)")
    }

    fn plusOperand(env: TEnv, x: AExpr, v: VType, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: t) :> plusKnown(env, x, t, ts)
            .Absent :> operandType(env, x, "not", "`+`", "two numbers or two strings", ts)
            .Unknown :> ts
            .OneOf(ts: xs) :> plusOneOf(env, x, xs, ts)
        }
    }

    // s472 — a choice operand of `+`: each member must be an operand of `+`,
    // and the members cannot mix a number with a string (which `+` it is —
    // adding or joining — would depend on the branch taken).
    fn plusOneOf(env: TEnv, x: AExpr, xs: Type[], ts: TypeState) -> TypeState {
        let num = false
        let str = false
        for (const t of xs) {
            const r: TypeState = plusKnown(env, x, t, ts)
            if (r.diags.length > ts.diags.length) return r
            if (isNumericKind(unMaybe(t))) num = true
            if (kindOf(unMaybe(t)) == 2) str = true
        }
        if (num && str) return report(ts, env, x.span, "E-OPERATOR-OPERAND-TYPE", "`+` takes two numbers or two strings, and this operand may be " + oneOfName(xs) + " — a choice whose branches mix a number and a string (whether `+` adds or joins would depend on the branch taken); give the branches one type (ruled S440, Gotcha Q1 / Q2)")
        return ts
    }

    fn plusKnown(env: TEnv, x: AExpr, t: Type, ts: TypeState) -> TypeState {
        if (isNumericKind(t) || kindOf(t) == 2) return ts
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            if (isNumericKind(inner) || kindOf(inner) == 2) return notNarrowed(env, x, t, "`+`", ts)
        }
        return operandType(env, x, typeName(t), "`+`", "two numbers or two strings", ts)
    }

    fn operandType(env: TEnv, x: AExpr, got: string, what: string, takes: string, ts: TypeState) -> TypeState {
        let hint: string = ""
        if (takes == "booleans") hint = " — compare explicitly (`n > 0`, `s != \"\"`, `x is given`)"
        return report(ts, env, x.span, "E-OPERATOR-OPERAND-TYPE", what + " takes " + takes + ", and this operand is `" + got + "`" + hint + " (ruled S440, Gotcha Q1 / Q2)")
    }

    // A `T | not` operand not narrowed here (the NARROWING above is flow-joined,
    // so a place is narrowed wherever it is provably present). s442 r2: the
    // earlier carve-out for an unannotated local's JOINED `T | not` is gone —
    // with flow narrowing it silenced only reads where the local may really be
    // `not` (`let a = not; if (…) { a = 5 }; a + 1`).
    fn notNarrowed(env: TEnv, x: AExpr, t: Type, what: string, ts: TypeState) -> TypeState {
        return report(ts, env, x.span, "E-OPERAND-NOT-NARROWED", what + " on a `" + typeName(t) + "` operand — it may be `not`; narrow it first (`if (x is given) { … }`, `x is given && …`) (ruled S440, Gotcha Q3)")
    }

    // A condition — `if`, `if=` / `else-if=`, `show=`, a ternary test (SPEC
    // §42.4). RULED S440 #4 = (c): "All conditions require a boolean, or a
    // `T | not` presence test, and the truthiness of numbers and strings goes";
    // Q1: "a bare `@x` of type `T | not` IS a presence test … the compiler
    // emits an absence check, never JS truthiness". RULED S460 ("a′, go"):
    // "a bare `x` whose type the compiler CANNOT resolve is an ERROR naming
    // the fixes (annotate it, or write `x is given` / `x == true`)" — which
    // supersedes S440 Truthiness Q2's provable-or-silent FOR CONDITIONS ONLY:
    // a condition is PROVABLE-OR-ERROR. Every other check here stays
    // provable-or-silent (an Unknown operand, argument, `in=` … is silent).
    fn checkCond(env: TEnv, c: AExpr, v: VType, what: string, ts: TypeState) -> TypeState {
        if (hasErrIn(env.errs, c.span)) return ts          // Rule C: not judged across a parse error
        // r5 R3: a bare conditional-handle presence test stays a presence
        // test inside a region that already narrowed it (trivially true) —
        // ruled S442, "`if=@color` is legal".
        if (isCondHandle(env, c)) return markPresence(ts, c.nid)
        return condOperands(env, c, what, condWhole(env, c, v, what, ts))
    }

    fn condWhole(env: TEnv, c: AExpr, v: VType, what: string, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: t) :> condKnown(env, c, t, what, ts)
            .Absent :> markPresence(ts, c.nid)      // `not` as a condition: a presence test that is always false
            .Unknown :> condUnresolvedWhole(env, c, what, ts)
            // s472: a choice is judged as an unresolved condition was (S460 N1's
            // arm-by-arm rule — strict-direction: it admits nothing more)
            .OneOf(ts: xs) :> condUnresolvedWhole(env, c, what, ts)
        }
    }

    // s460 N1 (PA reading of "a on F2, go": a ternary that IS the condition's
    // value is inside the condition — §42.4 statement 10). Each arm is the
    // condition's value when taken, so a ternary whose type did not resolve is
    // judged ARM BY ARM so the report lands where the cause is: an unresolved
    // or non-bool arm is blamed at the arm. STRICT-DIRECTION ONLY (PA, S460):
    // this admits nothing the whole-ternary rule refused — when no arm is
    // reported (every arm is a legal condition value on its own, e.g. a
    // `bool` arm beside a `T | not` arm, whose join did not resolve), the
    // arms' judgement is discarded and the WHOLE ternary is refused as
    // unresolved, exactly as before (statement 5, blame per statement 6).
    // A ternary whose arms joined to a known type is judged whole (condKnown).
    fn condUnresolvedWhole(env: TEnv, c: AExpr, what: string, ts0: TypeState) -> TypeState {
        const arms: AExpr[] = armsOf(c)
        if (arms.length == 0) return condUnresolved(env, c, what, ts0)
        let ts: TypeState = ts0
        for (const arm of arms) {
            ts = condWhole(env, arm, exprType0(ts, arm.nid), armWhat(what), ts)
        }
        if (ts.diags.length > ts0.diags.length) return ts
        return condUnresolved(env, c, what, ts0)
    }

    // How an arm is named: "a ternary arm of an `if` condition" — once; an arm
    // of a nested ternary is still an arm of the same condition.
    fn armWhat(what: string) -> string {
        if (what.indexOf("a ternary arm of ") == 0) return what
        return "a ternary arm of " + what
    }

    // A ternary's two arms (its test is a condition of its own); [] otherwise.
    fn armsOf(x: AExpr) -> AExpr[] {
        const k: AExprK = x.k
        return match k {
            .Ternary(test: t, yes: y, no: n) :> [y, n]
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: f) :> []
            .Assign(target: x2) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x2) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    // s460 F2 — RULED S460 ("a on F2, go"): "inside a condition, an operand of
    // `!` / `&&` / `||` whose type cannot be resolved is the same ERROR
    // (E-COND-NOT-BOOLEAN, unresolved message) … Operands OUTSIDE conditions
    // stay provable-or-silent (S440 Q2)" (§42.4 statement 10). The walk starts
    // at the condition and goes down through `!` / `&&` / `||` only: a nested
    // logical operator is walked, any other operand (a call, a name, a
    // comparison) is judged by the type the typer recorded for it.
    // So `!(g() && @b)` reaches `g()`; `f(!g())` does not (that `!` is an
    // argument, a value position). Parentheses are not nodes — transparent.
    // A ternary's TEST is a condition of its own (checkCond via typeTernary),
    // so it gets this walk there. s460 N1: a ternary that is the condition's
    // value, or an operand in its `!` / `&&` / `||` chain, has ARMS that are
    // that value when taken — walked like the place they stand in
    // (condUnresolvedWhole, condArmOperands). A ternary in a value position (an
    // argument, an index, an initializer) is not reached: its arms are values.
    // Statement 6 per operand: suppressed when an Error lies within THAT
    // operand (condBlamed); a logical operator the binder never resolved (a
    // refused region) stops the walk. A known non-bool / `not` operand is
    // checkBoolOperand's (E-OPERATOR-OPERAND-TYPE / E-OPERAND-NOT-NARROWED).
    fn condOperands(env: TEnv, c: AExpr, what: string, ts: TypeState) -> TypeState {
        const k: AExprK = c.k
        return match k {
            .Unary(op: o, e: x) :> condNotOperand(env, c, o, x, what, ts)
            .Binary(op: o, l: l, r: r) :> condLogicOperands(env, c, o, l, r, what, ts)
            .Name(name: n) :> ts
            .At(name: n) :> ts
            .AtItem :> ts
            .Num(raw: r) :> ts
            .Str(v: s) :> ts
            .Bool(v: b) :> ts
            .NotLit :> ts
            .Recovered :> ts
            .Variant(name: n) :> ts
            .Member(obj: o) :> ts
            .Call(callee: f) :> ts
            .Ternary(test: x, yes: y, no: n) :> condOperands(env, n, armWhat(what), condOperands(env, y, armWhat(what), ts))
            .Assign(target: x) :> ts
            .ArrayLit(elems: es) :> ts
            .ObjectLit(props: ps) :> ts
            .Spread(e: sx) :> ts
            .Index(obj: ix) :> ts
            .Lambda(params: lp) :> ts
            .Sql(q: q) :> ts
            .Handled(h: x) :> ts
            .Template(quasis: qs) :> ts
            .Foreign(f: fb0) :> ts
        }
    }

    fn condNotOperand(env: TEnv, c: AExpr, o: UnOp, x: AExpr, what: string, ts: TypeState) -> TypeState {
        if (o != UnOp.Not) return ts
        if (refusedRead(env, c)) return ts
        return condOperand(env, x, "`!`", what, ts)
    }

    fn condLogicOperands(env: TEnv, c: AExpr, o: BinOp, l: AExpr, r: AExpr, what: string, ts: TypeState) -> TypeState {
        let opName: string = ""
        if (o == BinOp.And) opName = "`&&`"
        if (o == BinOp.Or) opName = "`||`"
        if (opName == "") return ts
        if (refusedRead(env, c)) return ts
        return condOperand(env, r, opName, what, condOperand(env, l, opName, what, ts))
    }

    // One operand: a nested `!` / `&&` / `||` is walked; anything else is
    // judged — an unresolved one is E-COND-NOT-BOOLEAN unless blamed.
    fn condOperand(env: TEnv, x: AExpr, opName: string, what: string, ts: TypeState) -> TypeState {
        if (isLogical(x)) return condOperands(env, x, what, ts)
        const arms: AExpr[] = armsOf(x)
        if (arms.length > 0) return condArmOperands(env, x, arms, opName, what, ts)
        if (!unresolvedVT(exprType0(ts, x.nid))) return ts
        return condOperandUnresolved(env, x, opName, what, ts)
    }

    fn condOperandUnresolved(env: TEnv, x: AExpr, opName: string, what: string, ts: TypeState) -> TypeState {
        if (condBlamed(env, x, ts)) return ts
        return report(ts, env, x.span, "E-COND-NOT-BOOLEAN", "this operand of " + opName + " in " + what + " is a value whose type the compiler cannot resolve, and `!` / `&&` / `||` in a condition take a `bool` — annotate it (a parameter or return type), or say what you test: `x is given` (is it present?) or `x == true` (is it true?) (ruled S460, \"a on F2, go\")")
    }

    // s460 N1 — a ternary operand of a condition's `!` / `&&` / `||`: each arm
    // is the operand when taken, so each is judged as an operand (walked if
    // logical, blamed if unresolved). When the ternary's own type did not
    // resolve, the typer's bool check on it was silent, so each RESOLVED arm
    // gets that check here (checkBoolOperand); a resolved ternary was already
    // checked whole.
    fn condArmOperands(env: TEnv, x: AExpr, arms: AExpr[], opName: string, what: string, ts0: TypeState) -> TypeState {
        const whole: boolean = unresolvedVT(exprType0(ts0, x.nid))
        let ts: TypeState = ts0
        for (const arm of arms) {
            ts = condOperand(env, arm, opName, armWhat(what), ts)
            if (whole) ts = checkBoolOperand(env, arm, exprType0(ts, arm.nid), opName, ts)
        }
        // strict-direction only: an unresolved ternary operand none of whose
        // arms was reported is refused whole, as before
        if (!whole || ts.diags.length > ts0.diags.length) return ts
        return condOperandUnresolved(env, x, opName, what, ts0)
    }

    fn unresolvedVT(v: VType) -> boolean {
        return match v {
            .Known(t: x) :> false
            .Absent :> false
            .Unknown :> true
            .OneOf(ts: xs) :> true        // s472: no one type — a condition operand is refused as before
        }
    }

    fn isLogical(x: AExpr) -> boolean {
        const k: AExprK = x.k
        return match k {
            .Unary(op: o) :> o == UnOp.Not
            .Binary(op: o) :> o == BinOp.And || o == BinOp.Or
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: f) :> false
            .Ternary(test: x2) :> false
            .Assign(target: x2) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x2) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // s460 — a condition whose type did not resolve is E-COND-NOT-BOOLEAN
    // (§42.4 statement 5), unless an error already reported explains it
    // (statement 6: no second report — see Blame).
    fn condUnresolved(env: TEnv, c: AExpr, what: string, ts: TypeState) -> TypeState {
        if (condBlamed(env, c, ts)) return ts
        return report(ts, env, c.span, "E-COND-NOT-BOOLEAN", what + " is a value whose type the compiler cannot resolve, and a condition must be a `bool` or a `T | not` presence test — annotate it (a parameter or return type), or say what you test: `x is given` (is it present?) or `x == true` (is it true?) (ruled S460, \"a′, go\")")
    }

    // Is condition `c`'s unresolved type already accounted for? An Error the
    // typer (a refused operator, E-CALL-ARITY …) or an earlier pass (an
    // undeclared name, a refused construct) reported inside it; or a read of
    // a local / field whose written type was refused, or a call of a function
    // whose written return type was refused.
    fn condBlamed(env: TEnv, c: AExpr, ts: TypeState) -> boolean {
        if (hasErrIn(env.blame.spans, c.span)) return true
        for (const d of ts.diags) {
            if (d.file == env.file && d.severity == Severity.Error && d.span.start >= c.span.start && d.span.end <= c.span.end) return true
        }
        return refusedRead(env, c)
    }

    fn refusedRead(env: TEnv, c: AExpr) -> boolean {
        const k: AExprK = c.k
        return match k {
            .Name(name: n) :> refusedName(env, nameFact(env.t.names, c.nid))
            .At(name: n) :> refusedName(env, nameFact(env.t.names, c.nid))
            .Member(obj: o) :> refusedName(env, nameFact(env.t.names, c.nid)) || refusedRead(env, o)
            .Call(callee: f) :> refusedCallee(env, calleeFn(nameFact(env.t.names, f.nid))) || unboundCall(env, c, f)
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> true
            .Variant(name: n) :> false
            // an operator the binder never resolved (it stands in a region the
            // binder refused or skipped) — its Unknown is not a type left open
            .Unary(op: o) :> opOf(valueFact(env.t.values, c.nid)) is not
            .Binary(op: o) :> opOf(valueFact(env.t.values, c.nid)) is not
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // A call the binder never resolved: its callee names nothing it bound and
    // it is no built-in (undeclared — the scope rules report it — or inside a
    // region the binder skipped).
    fn unboundCall(env: TEnv, c: AExpr, callee: AExpr) -> boolean {
        if (nameFact(env.t.names, callee.nid) is given) return false
        return valueFact(env.t.values, c.nid) is not
    }

    fn refusedName(env: TEnv, f: NameFact | not) -> boolean {
        return match f {
            .NLocal(sym: s) :> env.blame.syms.indexOf(s.id) >= 0
            .NField(decl: d, inst: i, idx: x) :> refusedDeclField(env.t, d, x)
            .NStruct(owner: o, idx: x) :> refusedStructField(env.t, o, x)
            .NInst(decl: d) :> false
            .NFn(sym: s) :> false
            .NLength :> false
            .NSurface(of: x) :> false
            .NConst(sym: s) :> false
            // a name the binder did not resolve: undeclared (reported by the
            // scope rules) or inside a construct already refused (`if=` on a
            // `<db>`, E-BOOTSTRAP-UNSUPPORTED) — not a type left unresolved
            not :> true
        }
    }

    fn refusedCallee(env: TEnv, s: Sym | not) -> boolean {
        if (s is not) return false
        return env.blame.fns.indexOf(s.id) >= 0
    }

    // A declaration field whose WRITTEN type was refused (FieldInfo.trusted, r8)
    // — or, s462, whose type could not be INFERRED (§66.3 rule 7: the field is
    // untrusted and its own diagnostic, E-DECL-TYPE-NOT-INFERABLE or the cycle
    // code, owns every reader's unresolved type: no cascade).
    fn refusedDeclField(t: Tables, d: Sym, idx: int) -> boolean {
        const di: DeclInfo | not = declInfo(t, d)
        if (di is not) return false
        if (idx < 0 || idx >= di.fields.length) return false
        return !di.fields[idx].trusted
    }

    // A struct field whose type did not resolve (Unresolved.fields, r8).
    fn refusedStructField(t: Tables, owner: Sym, idx: int) -> boolean {
        const ti: TypeInfo | not = typeInfoOf(t.types, owner)
        if (ti is not) return false
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return false
        if (idx < 0 || idx >= fs.length) return false
        return t.unresolved.fields.indexOf(fs[idx].sym.id) >= 0
    }

    fn condKnown(env: TEnv, c: AExpr, t: Type, what: string, ts: TypeState) -> TypeState {
        if (kindOf(t) == 3) return ts
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            // RULED S442 (six typer questions): "a bare `bool | not` in a
            // condition is an ERROR naming both fixes (`@f is some` / `@f ==
            // true`) — the same spelling otherwise flips meaning inside vs
            // outside a narrowing". (A NARROWED `bool | not` reads as `bool`
            // and stays a value test.)
            if (kindOf(inner) == 3) {
                return report(ts, env, c.span, "E-COND-NOT-BOOLEAN", what + " is a bare `bool | not` — ambiguous: say `x is given` (is it present?) or `x == true` (is it true?) (ruled S442)")
            }
            return markPresence(ts, c.nid)
        }
        return report(ts, env, c.span, "E-COND-NOT-BOOLEAN", what + " needs a `bool` (or a `T | not` presence test), and this value is `" + typeName(t) + "` — a condition has no truthiness; compare explicitly (`n > 0`, `s != \"\"`, `xs.length > 0`) (ruled S440 #4 = (c))")
    }
    // `&&` / `||` take booleans only (RULED S440, Gotcha Q2 — superseding
    // §45.9's "JS semantics", where they yield an operand): a legal `&&` / `||`
    // is a `bool`, whatever the typer could prove of its operands.
    fn binaryType(op: PrimOp, a: VType, b: VType) -> VType {
        return match op {
            .EqPrim :> known(Type.Bool)
            .NeqPrim :> known(Type.Bool)
            .EqStruct :> known(Type.Bool)
            .NeqStruct :> known(Type.Bool)
            .Lt :> known(Type.Bool)
            .Le :> known(Type.Bool)
            .Gt :> known(Type.Bool)
            .Ge :> known(Type.Bool)
            .IsSome :> known(Type.Bool)
            .IsNot :> known(Type.Bool)
            .Not :> known(Type.Bool)
            .And :> known(Type.Bool)
            .Or :> known(Type.Bool)
            .Concat :> known(Type.Str)
            .Add :> numJoin(a, b)
            .Sub :> numJoin(a, b)
            .Mul :> numJoin(a, b)
            .Mod :> numJoin(a, b)
            .Div :> divType(a, b)
            .Neg :> numJoin(a, a)
            .Length :> known(Type.Int)
            .StrUpper :> VType.Unknown            // s469: a method call, typed by methodType
            .StrLower :> VType.Unknown
            .StrTrim :> VType.Unknown
            .StrSlice :> VType.Unknown
            .StrCharAt :> VType.Unknown
            .StrLength :> known(Type.Int)
            .StrIncludes :> VType.Unknown
            .StrStartsWith :> VType.Unknown
            .StrEndsWith :> VType.Unknown
            .StrSplit :> VType.Unknown
            .SortNum :> VType.Unknown
            .SortStr :> VType.Unknown
            .Reverse :> VType.Unknown
            .Join :> VType.Unknown
            .IndexRead :> VType.Unknown
            .AtRead :> VType.Unknown
            .StrIndexOf :> VType.Unknown
            .StrLastIndexOf :> VType.Unknown
            .StrReplace :> VType.Unknown
            .StrReplaceAll :> VType.Unknown
            .StrPadStart :> VType.Unknown
            .StrPadEnd :> VType.Unknown
            .StrRepeat :> VType.Unknown
            .StrTrimStart :> VType.Unknown
            .StrTrimEnd :> VType.Unknown
            .ParseInt :> VType.Unknown
            .ParseNum :> VType.Unknown
            .ParseBool :> VType.Unknown
            .Text :> known(Type.Str)
        }
    }


    fn divType(a: VType, b: VType) -> VType {
        const j: VType = numJoin(a, b)
        if (knownOf(j) is given) return known(Type.Num)
        return VType.Unknown
    }

    // The test is a condition (checkCond); each arm is typed under its narrowing.
    fn typeTernary(env: TEnv, test: AExpr, yes: AExpr, no: AExpr, ts: TypeState) -> RVT {
        const rt: RVT = typeExpr(env, test, ts)
        const n: Narrowing = condNarrowing(env, test)
        const ry: RVT = typeExpr(tCallUnnarrow(tNarrow(env, n.yes), test), yes, checkCond(env, test, rt.vt, "a ternary test", rt.ts))
        const rn: RVT = typeExpr(tCallUnnarrow(tNarrow(env, n.no), test), no, ry.ts)
        return rvt(joinVT(ry.vt, rn.vt), rn.ts)
    }

    // s469 — a logic backtick template (SPEC §14.13.3): a `string`, whose every
    // `${…}` slot is a TEXT SINK (§14.13.1). §14.13.2: accepted — `string`,
    // `int`, `number`, `bool`, a unit enum value; a `T | not` "SHALL be narrowed
    // first (E-OPERAND-NOT-NARROWED, §66.20), as for `+` and comparison";
    // refused, E-TEXT-NON-PRIMITIVE — "a struct, a tape, a tuple, a map or set,
    // a payload enum value, a function, … and a value whose type the compiler
    // cannot resolve" (the last limb fails closed). `not` itself is no text.
    // A slot whose unresolved type an error already accounts for is not
    // reported again (condBlamed — §42.4 statement 6's rule, reused).
    fn typeTemplate(env: TEnv, slots: AExpr[], ts0: TypeState) -> RVT {
        let ts: TypeState = ts0
        for (const s of slots) {
            const r: RVT = typeExpr(env, s, ts)
            ts = textSlot(env, s, r.vt, r.ts)
        }
        return rvt(known(Type.Str), ts)
    }

    // s473 — a §23.2 foreign block (§23.2.4a): "The block's OUT value is an
    // UNOWNED foreign value. It is typed `asIs` … by DEFAULT — the compiler
    // does NOT infer the OUT type from the opaque slice". The bootstrap has no
    // `asIs`; its untyped value is VType.Unknown, which every rule that judges
    // an unresolved value already refuses — a condition (E-COND-NOT-BOOLEAN,
    // §42.4 statement 5: "a value that crosses the JavaScript boundary with no
    // scrml type"), a text sink (E-TEXT-NON-PRIMITIVE), an operator. Only the
    // crossings are typed: each is a read like any other.
    fn typeForeign(env: TEnv, f: AForeign, ts0: TypeState) -> RVT {
        let ts: TypeState = ts0
        for (const x of f.crossings) { ts = typeExpr(env, x, ts).ts }
        return rvt(VType.Unknown, ts)
    }

    fn textSlot(env: TEnv, s: AExpr, v: VType, ts: TypeState) -> TypeState {
        if (hasErrIn(env.errs, s.span)) return ts          // Rule C: not judged across a parse error
        return match v {
            .Known(t: t) :> textKnown(env, s, t, ts)
            .Absent :> notText(env, s, "`not` (an absent value has no text)", ts)
            .Unknown :> textUnresolved(env, s, ts)
            .OneOf(ts: xs) :> textOneOf(env, s, xs, ts)
        }
    }

    // s472 — a choice in a template slot: each member is the slot's value when
    // its branch is taken, so each must have one honest text.
    fn textOneOf(env: TEnv, s: AExpr, xs: Type[], ts: TypeState) -> TypeState {
        for (const t of xs) {
            const r: TypeState = textKnown(env, s, t, ts)
            if (r.diags.length > ts.diags.length) return r
        }
        return ts
    }

    fn textUnresolved(env: TEnv, s: AExpr, ts: TypeState) -> TypeState {
        if (condBlamed(env, s, ts)) return ts
        return report(ts, env, s.span, "E-TEXT-NON-PRIMITIVE", "a template slot is text, and the compiler cannot resolve this value's type — only a known `string`, `int`, `number`, `bool` or unit enum value has one honest text (§14.13.2, fail closed). Annotate what it reads (a parameter, a local, a function's return type)")
    }

    fn textKnown(env: TEnv, s: AExpr, t: Type, ts: TypeState) -> TypeState {
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            if (isTextPrimitive(env, inner)) return report(ts, env, s.span, "E-OPERAND-NOT-NARROWED", "a template slot holds a `" + typeName(t) + "` — it may be `not`, which has no text; narrow it first (`if (x is given) { … }`) (§14.13.2, S440 Gotcha Q3)")
            return notText(env, s, "a `" + typeName(t) + "`", ts)
        }
        if (isTextPrimitive(env, t)) return ts
        return notText(env, s, textWhat(env, t), ts)
    }

    // §14.13.1 item 2: "`string`, `int`, `number`, `bool`, or a unit enum value".
    fn isTextPrimitive(env: TEnv, t: Type) -> boolean {
        const k: int = kindOf(t)
        if (k <= 3) return true
        if (k != 4) return false
        const es: Sym | not = isEnumType(env.t.types, t)
        if (es is not) return false
        const ti: TypeInfo | not = typeInfoOf(env.t.types, es)
        if (ti is not) return false
        for (const v of enumVariants(ti.def)) {
            if (v.fields.length > 0) return false
        }
        return true
    }

    fn textWhat(env: TEnv, t: Type) -> string {
        if (kindOf(t) == 5) return "a tape (`" + typeName(t) + "`)"
        const es: Sym | not = isEnumType(env.t.types, t)
        if (es is given) return "a value of `" + typeName(t) + "`, an enum with payload variants"
        return "a `" + typeName(t) + "` value (a struct or an instance)"
    }

    fn notText(env: TEnv, s: AExpr, what: string, ts: TypeState) -> TypeState {
        return report(ts, env, s.span, "E-TEXT-NON-PRIMITIVE", "a template slot is text, and this is " + what + " — only a `string`, `int`, `number`, `bool` or unit enum value has one honest text (§14.13.2). Interpolate a field (`p.name`), a `scrml:format` call, or show it with `log()`")
    }

    fn typeArray(env: TEnv, es: AExpr[], ts0: TypeState) -> RVT {
        let ts: TypeState = ts0
        let elem: VType = VType.Unknown
        let first = true
        for (const e of es) {
            const r: RVT = typeExpr(env, e, ts)
            ts = r.ts
            if (first) {
                elem = r.vt
            } else {
                elem = joinVT(elem, r.vt)
            }
            first = false
        }
        const et: Type | not = knownOf(elem)
        if (et is given) return rvt(known(Type.Seq(et, anySeqGrants())), ts)
        return rvt(VType.Unknown, ts)
    }

    // A call of a named function: its arity against the declaration, and its
    // value is the declared return type.
    // CALL ARITY — RULED S440 (#2 = PA rec: "make extra arguments an error
    // now, and write the callback case down as the one reason that would
    // reopen it"; "too few arguments is an error unless the parameter has a
    // default (§7.3.2)"); SPEC §7.3: "A call that passes MORE arguments than
    // the function declares parameters is a compile error, `E-CALL-ARITY`. A
    // call that passes FEWER is a compile error too, unless each omitted
    // parameter has a default (§7.3.2)." The slice front end parses no
    // default, rest (`...xs`) or `?`-optional parameter: a signature holding
    // one does not parse cleanly, its `arity` is -1, and no call of it is
    // checked (the SPEC's PA reading — rest absorbs extras, `?` counts as
    // defaulted — is honoured by never guessing). Checked only when the
    // callee resolves statically to a function (provable-or-silent).
    fn typeCall(env: TEnv, e: AExpr, callee: AExpr, args: AExpr[], ts0: TypeState) -> RVT {
        let ts: TypeState = typeExprs(env, args, ts0)
        // s472 — a payload-variant construction (resolveConstruct): each argument
        // against its declared field's type, as a `fail`'s payload (typeFail); its
        // type is the enum (§66.3 rule 5: "`E.V(…)` is a call whose declared type is
        // `E`"). The callee names a type and a variant — never a value to type.
        const cf: ValueFact | not = valueFact(env.t.values, e.nid)
        if (isConstructFact(cf)) return rvt(valueType(cf), checkConstructArgs(env, cf, args, ts))
        ts = typePlace(env, callee, VType.Unknown, ts)
        const s: Sym | not = calleeFn(nameFact(env.t.names, callee.nid))
        // merge (s469 strings × loops): three independent argument checks, each keyed on its OWN
        // value fact (VToEnum / VAt / VMethod or a SortBy comparator) and the identity otherwise
        if (s is not) return rvt(builtinCallType(env, e, callee, ts), methodArgCheck(env, e, args, atArgCheck(env, e, args, toEnumArgCheck(env, e, args, ts))))
        const fi: FnInfo | not = fnInfoOf(env.t, s)
        if (fi is not) return rvt(VType.Unknown, ts)
        const n: int = fi.arity
        if (n >= 0 && n != args.length) {
            ts = report(ts, env, e.span, "E-CALL-ARITY", arityMessage(fi.name, n, args.length))
        }
        // (s472: guard (ii) — "a callee whose name is declared in more than one
        // file is mis-linked" — is retired: the binder resolves a call to the
        // function its name denotes in the calling file, so `s` IS the callee)
        if (n >= 0 && n == args.length) ts = checkArgs(env, fi, args, ts)
        const ret: Type | not = fi.ret
        if (ret is given) return rvt(known(ret), ts)
        // s473 (§48.8): an unannotated function's INFERRED return (inferReturn)
        const inf: VType | not = findLocalT(env.settled, retKey(s).id)
        if (inf is given) return rvt(inf, ts)
        return rvt(VType.Unknown, ts)
    }

    // ---- `int` ENFORCEMENT AT EVERY §7.5.1 POSITION (r4 (c)) -------------------
    // RULED S442: "`int` enforcement reaches every §7.5.1 position (returns,
    // arguments, all initializers); `1e3` / `2.0` into `int` stay errors (float
    // literals)". Only an `int`-BEARING target (`int`, `int | not`, a sequence
    // of them) is checked at a return / an argument / a non-literal
    // initializer — the ruling widens `int`, not those positions in general
    // (§7.5.1 positions 3-5 stay unchecked for every other type).
    fn hasInt(t: Type) -> boolean {
        if (kindOf(t) == 0) return true
        const i: Type | not = maybeInner(t)
        if (i is given) return hasInt(i)
        const el: Type | not = seqElem(t)
        if (el is given) return hasInt(el)
        return false
    }

    fn paramNids(ps: AParam[]) -> int[] {
        let out: int[] = []
        for (const p of ps) { out = out.concat([p.nid]) }
        return out
    }

    // Each argument against its parameter (§7.5.1 position 3; every type since r7 A — pa-ruled widening, measured-zero corpus).
    fn checkArgs(env: TEnv, fi: FnInfo, args: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        const name: string = fi.name
        let pnids: int[] = []
        for (const w of env.fnw) {
            if (w.nid == fi.nid) pnids = w.params     // s472: THE callee's parameters (by its node), never the last function of that name
        }
        if (pnids.length != args.length) return ts
        let i = 0
        while (i < args.length) {
            let pt: Type | not = knownOf(paramType(bindFact(env.t.binds, pnids[i])))
            if (env.t.unresolved.params.indexOf(pnids[i]) >= 0) pt = not      // r8: an unresolved parameter type
            if (pt is given) {
                const what: string = "argument " + (i + 1) + " of `" + name + "`"
                // r7 A: full assignability for EVERY parameter type (§7.5.1 position 3)
                ts = checkValue(env, exprType0(ts, args[i].nid), pt, args[i].span, what, ts)
                ts = checkNotElems(env, args[i], pt, ts)
                ts = checkArgTape(env, args[i], pt, what, ts)
            }
            i = i + 1
        }
        return ts
    }

    // s469-boot-tape-grants (g-bootstrap-callsite-grant-subset-unchecked-s469): §66.12.3
    // "permission sets need a subset check at every call" — a PLACE (a cell, a field, a
    // local, a parameter) passed to a tape parameter must grant at least what the
    // parameter does (argTapeProblem, the one reader). The direction is ruled (S435
    // "type"); the CODE is not (the gap's owed ruling), so the refusal is
    // E-BOOTSTRAP-UNSUPPORTED, fail closed. A fresh value (a literal, a call's result)
    // is not checked: it is given the parameter's type as a typed binding is (rule 1).
    fn checkArgTape(env: TEnv, arg: AExpr, pt: Type, what: string, ts: TypeState) -> TypeState {
        if (placeKey(arg) == "") return ts
        const at: Type | not = knownOf(exprType0(ts, arg.nid))
        if (at is not) return ts
        const lack: string = argTapeProblem(at, pt)
        if (lack == "") return ts
        return report(ts, env, arg.span, "E-BOOTSTRAP-UNSUPPORTED", what + " is the tape `" + placeKey(arg) + "`, whose type does not grant " + lack + ", which the parameter's type `" + tapeTypeName(pt) + "` does — a callee can do what its parameter grants, so an argument must grant at least as much (§66.12.3). Which code reports this is not ruled yet; refused, not let through")
    }

    // `return v` against the declared `-> T` (§7.5.1 position 4; every type since r7 A — pa-ruled widening, measured-zero corpus).
    fn typeReturn(env: TEnv, e: AExpr | not, ts0: TypeState) -> TypeState {
        const ts: TypeState = typeMaybeExpr(env, e, ts0)
        if (e is not) return ts
        const rt: Type | not = env.fret
        if (rt is not) return ts
        const ts1: TypeState = checkNotElems(env, e, rt, ts)
        const v: VType = exprType0(ts1, e.nid)
        // s473 D29 — `return not` from a function whose declared return type has no `| not` is
        // §42.3.3 / §17.6 E-TYPE-043 (the more specific code), not the general E-TYPE-041.
        if (isAbsentVT(v) && maybeInner(rt) is not) return report(ts1, env, e.span, "E-TYPE-043", "this function is declared `-> " + typeName(rt) + "` and returns `not` here — a non-optional return type never holds the absence sentinel (§42.3.3). Declare `-> " + typeName(rt) + " | not`, or return a `" + typeName(rt) + "` value")
        // r7 A: full assignability for EVERY return type (§7.5.1 position 4)
        return checkValue(env, v, rt, e.span, "the return value", ts1)
    }

    // A non-literal initializer into an `int`-bearing annotation (a literal is
    // checkInit's; checking it here too would report it twice).
    // The struct literals inside an attribute-valued initializer, field by
    // field (as a write's and an annotated local's are — spelling-independent).
    fn checkAttrLitFields(env: TEnv, v: AAttrValue, target: Type, ts: TypeState) -> TypeState {
        const x: AExpr | not = valueExpr(v)
        if (x is not) return ts
        return checkNotElems(env, x, target, checkLitFields(env, x, ts))
    }

    // r6: at a position checked for `int` only (a return, an argument, a
    // non-literal initializer), a target of any OTHER type is checked for the
    // `T | not` rule alone — "`T | not` into `T` is an error for all types"
    // (ruled S442) decides that question in every position that takes a `T`;
    // no ruling widens those positions for other type mismatches.
    fn checkMaybeNot(env: TEnv, v: VType, target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        // r7 C: the `not` literal itself into a non-optional target — the
        // same failure, reported with the code every other position already
        // uses for it (E-TYPE-041, §42.3.1)
        if (isAbsentVT(v)) return checkAbsent(env, target, span, what, ts)
        const x: Type | not = knownOf(v)
        if (x is not) return ts
        if (!mayBeNot(x, target)) return ts
        return checkKnown(env, x, target, span, what, ts)
    }

    // r7 C: `not` ELEMENTS of an array literal into a sequence whose element
    // type is non-optional (`[not]` into `string[]`). Only when the array's
    // own type is unproven (all elements `not` / unknown) — a typed array
    // (`[1, not]`: `(int | not)[]`) is mayBeNot's, reported once there.
    // s472 (the `.Unknown` audit): an array whose elements have KNOWN types
    // with no common type (`[1, "a"]`) is unproven too — a tape holds one
    // element type, and there is no union tape — so each such element is
    // checked against the element type here, as it is written into it.
    fn checkNotElems(env: TEnv, e: AExpr, target: Type, ts: TypeState) -> TypeState {
        const es: AExpr[] = arrayElems(e)
        if (es.length == 0) return ts
        if (knownOf(exprType0(ts, e.nid)) is given) return ts
        const te: Type | not = seqElem(unMaybe(target))
        if (te is not) return ts
        let out: TypeState = ts
        for (const x of es) {
            const xv: VType = exprType0(out, x.nid)
            if (isNotLit(x)) {
                out = checkAbsent(env, te, x.span, "an element of `" + typeName(target) + "`", out)
            } else if (knownOf(xv) is given || oneOfMembers(xv).length > 0) {
                out = checkValue(env, xv, te, x.span, "an element of `" + typeName(target) + "`", out)
            } else {
                out = checkNotElems(env, x, te, out)
            }
        }
        return out
    }

    // THE INITIALIZER RULE — one rule for every annotated initializer (an
    // annotated `let` / `const` local, a declaration field or cell, a use-site
    // attribute), LITERAL OR NOT, against EVERY annotation type: the rule a
    // return, an argument and a write already use (§7.5.1 positions 1-4, r7 A;
    // §66.1 rule 5; `not` into a non-optional type is E-TYPE-041, §42.3.1).
    // s472 r1 F2 (review of #1608) widened the NON-literal limb; s472
    // (g-boot-literal-init-non-primitive-annotation-unchecked-s472) closes the
    // literal limb: a literal into a `T | not`, an enum, a struct or a tape was
    // judged by neither checkInit (its §7.5.1 table covers the four primitive
    // annotations only) nor the non-literal limb, so `let <admin:bool |
    // not="false"/>` compiled and `if (@admin)` took the true branch. A literal
    // into a primitive annotation keeps checkInit's §7.5.1 message.
    fn checkAnnotInit(env: TEnv, target: Type, lk: int, v: VType, span: ASpan, what: string, ts: TypeState) -> TypeState {
        if (lk == 3) return checkAbsent(env, target, span, what, ts)
        if (lk >= 0 && literalFits(kindOf(target), lk) >= 0) return checkInit(env, target, lk, span, what, ts)
        if (lk >= 0) return checkValue(env, literalVT(lk), target, span, what, ts)
        return checkValue(env, v, target, span, what, ts)
    }

    // A literal's type, by its literalKind (0 non-integer number · 4 integer ·
    // 1 string · 2 boolean · 3 `not`).
    fn literalVT(lk: int) -> VType {
        if (lk == 0) return known(Type.Num)
        if (lk == 4) return known(Type.Int)
        if (lk == 1) return known(Type.Str)
        if (lk == 2) return known(Type.Bool)
        return VType.Absent
    }

    fn arityMessage(name: string, n: int, got: int) -> string {
        if (got > n) return "`" + name + "` takes " + n + " argument(s) and is called with " + got + " — an extra argument is an error (§7.3, E-CALL-ARITY; ruled S440 #2)"
        return "`" + name + "` takes " + n + " argument(s) and is called with " + got + " — a missing argument is an error unless its parameter has a default (§7.3, §7.3.2; ruled S440 #2)"
    }

    fn fnInfoOf(t: Tables, s: Sym) -> FnInfo | not {
        for (const f of t.fns) {
            if (f.sym.id == s.id) return f
        }
        return not
    }

    // ---- statements ------------------------------------------------------------
    fn typeBlock(env: TEnv, b: ABlock, ts0: TypeState) -> TypeState {
        return typeBlockEnv(env, b, ts0).ts
    }

    // A block, and the env its last statement leaves (its narrowing is what
    // an enclosing `if` / `given` joins, s442 r2 F1 / F3).
    fn typeBlockEnv(env: TEnv, b: ABlock, ts0: TypeState) -> RTEnv {
        let ts: TypeState = ts0
        let env2: TEnv = env
        for (const s of b.stmts) {
            const r: RTEnv = typeStmt(env2, s, ts)
            env2 = r.env
            ts = r.ts
        }
        return { env: env2, ts: ts }
    }

    fn keepTEnv(env: TEnv, ts: TypeState) -> RTEnv { return { env: env, ts: ts } }

    // s451 (Ue) — a handling form: its subject, then each arm with its
    // binders typed by the payload field each takes (the binder's FArm /
    // FHandled facts). `?` and `!{}` yield the subject's success type (a `!`
    // signature has no success-type slot, §19.4.1, so it is Unknown unless
    // inference knows it); a `match` yields Unknown (its arms' join is not
    // computed — no check fires on Unknown).
    fn typeHandled(env: TEnv, e: AExpr, h: AHandled, ts0: TypeState) -> RVT {
        const pm: PlainMatch | not = plainFactOf(failFact(env.t.fails, e.nid))
        if (pm is given) return typePlain(env, e, h, pm, ts0)
        const rs: RVT = typeExpr(env, h.subject, ts0)
        let ts: TypeState = rs.ts
        const err: Sym | not = handledErr(failFact(env.t.fails, e.nid))
        for (const a of handledArms(h)) {
            let aenv: TEnv = env
            const fs: FieldDef[] = armFields(env.t, err, failFact(env.t.fails, a.nid))
            const p: APat = a.pat
            // s452: a whole-error arm's binder is the whole error enum (§18.6.1)
            const whole: boolean = armIdx(failFact(env.t.fails, a.nid)) == -4
            let i = 0
            for (const b of patBindsOf(p)) {
                const bs: Sym | not = bindSym(bindFact(env.t.binds, b.nid))
                let vt: VType = VType.Unknown
                if (i < fs.length && env.t.unresolved.fields.indexOf(fs[i].sym.id) < 0) vt = known(fs[i].ty)
                if (whole && err is given) vt = known(Type.Named(err))
                if (bs is given) aenv = tWithLocal(aenv, bs, vt)
                i = i + 1
            }
            const body: AArmBody = a.body
            for (const x of armExprOf(body)) {
                if (assignValue(x) is given) {
                    ts = typeStmtExpr(aenv, x, ts)
                } else {
                    ts = typeExpr(aenv, x, ts).ts
                }
            }
            for (const b2 of armBlockOf(body)) { ts = typeBlock(aenv, b2, ts) }
        }
        const how: AHow = h.how
        if (how == AHow.Propagate) return rvt(rs.vt, ts)
        return rvt(VType.Unknown, ts)
    }

    // s469 — the §18 plain-value `match` (the binder's FPlain fact). Its
    // subject is typed; in every arm but the `not` arm a `T | not` place is
    // narrowed to `T` (§42.7: "`match` … narrowing"; §42.2.3 — "the present
    // case is the arm after `not :>`"); the arms' binders take their payload
    // fields' types; the value is the JOIN of the arms' values (§18.4), and a
    // non-exhaustive match also yields `not` (§18.16.3). Where the binder did
    // not know the subject's type, the arms are checked against it here.
    fn typePlain(env: TEnv, e: AExpr, h: AHandled, m: PlainMatch, ts0: TypeState) -> RVT {
        const rs: RVT = typeExpr(env, h.subject, ts0)
        let ts: TypeState = plainSubjectCheck(env, e, h.subject, m, rs.vt, rs.ts)
        let present: string[] = []
        const st0: Type | not = knownOf(rs.vt)
        let subjMaybe: boolean = m.maybe
        if (st0 is given) {
            if (maybeInner(st0) is given) subjMaybe = true
        }
        if (subjMaybe) present = condNarrowing(env, h.subject).yes
        let vt: VType = VType.Unknown
        let first = true
        let conflict = false
        let prior: string[] = []                              // the value arms before this one, by pattern
        let priorVT: VType[] = []                             // … and the type each produced
        for (const a of handledArms(h)) {
            const af: FailFact | not = failFact(env.t.fails, a.nid)
            let aenv: TEnv = env
            if (armIdx(af) != -5 && present.length > 0) aenv = tNarrow(aenv, present)
            const fs: FieldDef[] = armFields(env.t, m.es, af)
            let i = 0
            for (const b of patBindsOf(a.pat)) {
                const bs: Sym | not = bindSym(bindFact(env.t.binds, b.nid))
                let bvt: VType = VType.Unknown
                if (i < fs.length && env.t.unresolved.fields.indexOf(fs[i].sym.id) < 0) bvt = known(fs[i].ty)
                if (bs is given) aenv = tWithLocal(aenv, bs, bvt)
                i = i + 1
            }
            const body: AArmBody = a.body
            const one: AExpr | not = plainOneExpr(body)
            if (m.stmt || one is not) {
                for (const x of armExprOf(body)) {
                    if (assignValue(x) is given) {
                        ts = typeStmtExpr(aenv, x, ts)
                    } else {
                        ts = typeExpr(aenv, x, ts).ts
                    }
                }
                for (const b2 of armBlockOf(body)) { ts = typeBlock(aenv, b2, ts) }
            } else {
                const r: RVT = typeExpr(aenv, one, ts)
                ts = r.ts
                if (first) {
                    vt = r.vt
                } else if (!conflict) {
                    // s472 (g-boot-mixed-arm-type-unresolved-fail-open-s472) — §18.4
                    // rule 3: "If arms produce types `A` and `B` with no subtype
                    // relationship, this SHALL be a compile error (E-TYPE-001)", and
                    // "If two or more arm bodies produce types that cannot be unified,
                    // the compiler SHALL emit E-TYPE-001 identifying each conflicting
                    // arm". s473 r2 LOW-A: judged PAIRWISE — this arm against EVERY
                    // arm before it, not against their running join (a choice arm
                    // widens the join, so a join-check made the verdict depend on arm
                    // order: {1, "s", (@b ? 1 : "s")} erred in one order of four).
                    // Reported once, at the first arm that conflicts, naming each
                    // earlier arm it conflicts with; the match's value is then
                    // Unknown — this error accounts for it (no second report).
                    let clash: string[] = []
                    let i = 0
                    for (const pv of priorVT) {
                        if (armsConflict(pv, r.vt, joinVT(pv, r.vt))) clash = clash.concat(["`" + prior[i] + "` (" + vtTypesName(pv) + ")"])
                        i = i + 1
                    }
                    if (clash.length > 0) {
                        if (!hasErrIn(env.errs, one.span)) ts = report(ts, env, one.span, "E-TYPE-001", "the arms of this `match` produce types with no subtype relationship — this arm (`" + patLabel(a.pat) + "`) produces " + vtTypesName(r.vt) + ", and so does not unify with the arm(s) " + clash.join(", ") + " — a `match`'s arms produce one type, or types that unify (`T` with `T | not`, `int` with `number`, a type with a choice that holds it) (§18.4 rule 3)")
                        conflict = true
                        vt = VType.Unknown
                    } else {
                        vt = joinVT(vt, r.vt)
                    }
                }
                first = false
                prior = prior.concat([patLabel(a.pat)])
                priorVT = priorVT.concat([r.vt])
            }
        }
        if (m.stmt) return rvt(VType.Unknown, ts)
        if (conflict) return rvt(VType.Unknown, ts)
        if (!m.exhaustive) vt = joinVT(vt, VType.Absent)
        return rvt(vt, ts)
    }

    // s472 — §18.4 rule 3: "If arms produce types `A` and `B` with no subtype
    // relationship, this SHALL be a compile error (E-TYPE-001)" — judged for two
    // ARMS (s473 r2), never an arm and a running join. Their join is a choice
    // that NEITHER side already was: it has more members than
    // either side, so neither side's type holds the other's. An arm that is
    // itself a choice (a ternary, §17.6 union) is judged the same way (s473 r1
    // LOW-1): `int | string` beside `int` unifies (the choice holds it);
    // `int | string` beside `bool` does not.
    fn armsConflict(a: VType, b: VType, j: VType) -> boolean {
        const n: int = oneOfMembers(j).length
        if (n == 0) return false
        return n > vtWidth(a) && n > vtWidth(b)
    }

    // How many types a value may be: a choice's members, else one (a known
    // type) or none (`not` joins into any type; an unresolved one is not judged).
    fn vtWidth(v: VType) -> int {
        return match v {
            .Known(t: x) :> 1
            .Absent :> 0
            .Unknown :> 0
            .OneOf(ts: xs) :> xs.length
        }
    }

    // A value type as a message names it, a choice by every member.
    fn vtTypesName(v: VType) -> string {
        const xs: Type[] = oneOfMembers(v)
        if (xs.length > 0) return oneOfName(xs)
        return "`" + vtName(v) + "`"
    }

    // A value type as a message names it.
    fn vtName(v: VType) -> string {
        return match v {
            .Known(t: x) :> typeName(x)
            .Absent :> "not"
            .Unknown :> "unresolved"
            .OneOf(ts: xs) :> typeName(xs[0])
        }
    }

    // The one expression a value-position arm is (`e`, or `{ e }`), else not.
    fn plainOneExpr(body: AArmBody) -> AExpr | not {
        return match body {
            .ArmExpr(e: x) :> x
            .ArmBlock(b: b) :> oneEvalOf(b)
        }
    }

    fn oneEvalOf(b: ABlock) -> AExpr | not {
        if (b.stmts.length != 1) return not
        return evalOf(b.stmts[0])
    }

    export fn plainFactOf(f: FailFact | not) -> PlainMatch | not {
        return match f {
            .FPlain(m: m) :> m
            .FHandled(h: x) :> not
            .FArm(idx: x) :> not
            .FFail(err: x) :> not
            not :> not
        }
    }

    // The arms against the subject's type, where the binder could not see it
    // (an unannotated local, a call's result): the enum the arms name must be
    // the subject's (E-TYPE-VARIANT), a literal arm's type must be the
    // subject's (E-TYPE-001), and a `T | not` subject owes a `not` arm or a
    // wildcard (E-MATCH-012).
    fn plainSubjectCheck(env: TEnv, e: AExpr, subj: AExpr, m: PlainMatch, v: VType, ts: TypeState) -> TypeState {
        const t: Type | not = knownOf(v)
        if (t is not) return ts
        const inner: Type = unMaybe(t)
        const k: int = kindOf(inner)
        let out: TypeState = ts
        // s469 (review L1): a `not` arm on a subject that cannot be `not` is dead — the
        // E-TYPE-044 rule (§17.6: a presence test on a type without `| not`)
        if (m.notArm && maybeInner(t) is not && k != 5) out = report(out, env, e.span, "E-TYPE-044", "a `not` arm on a subject whose type (`" + typeName(t) + "`) does not include `| not` — the arm can never run; drop it, or widen the subject's type (§17.6, §42.7)")
        if (m.known) return out
        const es: Sym | not = m.es
        if (m.kind == 0 && es is given) {
            const ns: Sym | not = namedOf(inner)
            let same = false
            if (ns is given) same = ns.id == es.id
            if (!same) out = report(out, env, subj.span, "E-TYPE-VARIANT", "the arms are variants of `" + es.hint + "`, but the subject is `" + typeName(t) + "` (§18.13)")
        }
        if (m.kind == 1 && k != 2) out = report(out, env, subj.span, "E-TYPE-001", "the arms are string literals, but the subject is `" + typeName(t) + "` (§18.16)")
        if (m.kind == 2 && k != 0 && k != 1) out = report(out, env, subj.span, "E-TYPE-001", "the arms are number literals, but the subject is `" + typeName(t) + "` (§18.16)")
        if (m.kind == 3 && k != 3) out = report(out, env, subj.span, "E-TYPE-001", "the arms are bool literals, but the subject is `" + typeName(t) + "` (§18.16)")
        if (k == 5) out = report(out, env, subj.span, "E-BOOTSTRAP-UNSUPPORTED", "a `match` over a tape (`" + typeName(t) + "`) — §18 matches an enum, a `T | not`, or a string, number or bool")
        if (maybeInner(t) is given && !m.maybe && !m.wild) out = report(out, env, e.span, "E-MATCH-012", "this `match` is over a `T | not` value (`" + typeName(t) + "`) but has no `not` arm and no `else` arm — add `not :> …` so the absent case is handled (§42.7)")
        return out
    }

    fn handledErr(f: FailFact | not) -> Sym | not {
        return match f {
            .FHandled(h: h) :> h.err
            .FArm(idx: x) :> not
            .FPlain(m: m) :> m.es
            .FFail(err: y) :> not
            not :> not
        }
    }

    // The payload fields an arm's binders take (none for `.Ok` / `_`).
    fn armFields(t: Tables, err: Sym | not, f: FailFact | not) -> FieldDef[] {
        if (err is not) return []
        const idx: int = armIdx(f)
        if (idx < 0) return []
        const ti: TypeInfo | not = typeInfoOf(t.types, err)
        if (ti is not) return []
        const vs: VariantDef[] = enumVariants(ti.def)
        if (idx >= vs.length) return []
        return vs[idx].fields
    }

    fn armIdx(f: FailFact | not) -> int {
        return match f {
            .FArm(idx: i) :> i
            .FHandled(h: x) :> -3
            .FFail(err: x) :> -3
            .FPlain(m: pm) :> -3
            not :> -3
        }
    }

    fn patBindsOf(p: APat) -> ABind[] {
        return match p {
            .PName(binds: bs) :> bs
            .PWild :> []
            .PWhole(bind: b) :> [b]
            .PBare(bind: b) :> [b]
            .PNot :> []
            .PLit(e: x) :> []
        }
    }

    // s451 (Ue) — `fail E.V(args)`: each payload value against its field's
    // type (§19.3.3: the `fail` is "a variant CONSTRUCTION", typed as one).
    fn typeFail(env: TEnv, s: AStmt, f: AFail, ts0: TypeState) -> TypeState {
        let ts: TypeState = typeExprList(env, failExprs(f), ts0)
        const ff: FailFact | not = failFact(env.t.fails, s.nid)
        const fs: FieldDef[] = failFields(env.t, ff)
        let i = 0
        for (const a of f.args) {
            if (i < fs.length && env.t.unresolved.fields.indexOf(fs[i].sym.id) < 0) {
                ts = checkValue(env, exprType0(ts, a.nid), fs[i].ty, a.span, "payload value " + (i + 1) + " of this `fail`", ts)
            }
            i = i + 1
        }
        return ts
    }

    // s472 — a construction's arguments against the variant's declared fields
    // (§14.4: one positional argument per declared field, in declaration order;
    // the count is resolveConstruct's E-TYPE-082). An unresolved field type
    // (already reported) is not checked, as in typeFail.
    fn checkConstructArgs(env: TEnv, f: ValueFact | not, args: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        const fs: FieldDef[] = constructFields(env.t, f)
        let i = 0
        for (const a of args) {
            if (i < fs.length && env.t.unresolved.fields.indexOf(fs[i].sym.id) < 0) {
                ts = checkValue(env, exprType0(ts, a.nid), fs[i].ty, a.span, "payload value " + (i + 1) + " (`" + fs[i].sym.hint + "`) of this construction", ts)
                // r1 F1: a struct literal's FIELD values (in a tape, a ternary, nested) against
                // their declared fields — the literal's own type is the expected struct, so the
                // whole-value check alone never sees `{ x: "s" }` into `{ x: int }` (§66.1 rule 5)
                ts = checkNotElems(env, a, fs[i].ty, checkLitFields(env, a, ts))
            }
            i = i + 1
        }
        return ts
    }

    fn constructFields(t: Tables, f: ValueFact | not) -> FieldDef[] {
        return match f {
            .VConstruct(enumSym: s, idx: i) :> armFields(t, s, FailFact.FArm(i))
            .VLit(lit: l) :> []
            .VVariant(enumSym: s) :> []
            .VStructOf(ty: s) :> []
            .VOp(op: o) :> []
            .VHost(call: c) :> []
            .VSeqCall(op: o) :> []
            .VLambda(params: ps) :> []
            .VIndex(loc: x) :> []
            .VAt :> []
            .VTemplate(text: tx) :> []
            .VToEnum(enumSym: s) :> []
            .VMethod(op: o) :> []
            not :> []
        }
    }

    fn isConstructFact(f: ValueFact | not) -> boolean {
        return match f {
            .VConstruct(enumSym: s) :> true
            .VLit(lit: l) :> false
            .VVariant(enumSym: s) :> false
            .VStructOf(ty: s) :> false
            .VOp(op: o) :> false
            .VHost(call: c) :> false
            .VSeqCall(op: o) :> false
            .VLambda(params: ps) :> false
            .VIndex(loc: x) :> false
            .VAt :> false
            .VTemplate(text: tx) :> false
            .VToEnum(enumSym: s) :> false
            .VMethod(op: o) :> false
            not :> false
        }
    }

    fn failFields(t: Tables, f: FailFact | not) -> FieldDef[] {
        return match f {
            .FFail(err: e, idx: i) :> armFields(t, e, FailFact.FArm(i))
            .FHandled(h: x) :> []
            .FArm(idx: x) :> []
            .FPlain(m: pm) :> []
            not :> []
        }
    }

    // Each statement's continuation env: the narrowing a statement's CALLS
    // may undo (a callee that writes the place, r2 F1) is dropped, and an
    // `if` / `given` leaves the JOIN of its paths (r2 F1 / F3).
    fn typeStmt(env: TEnv, s: AStmt, ts: TypeState) -> RTEnv {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> typeEvalStmt(env, e, ts)
            .Local(name: n, init: i) :> typeLocal(tCallUnnarrow(env, i), s, n, i, ts)
            .Return(e: e) :> keepTEnv(env, typeReturn(env, e, ts))
            .If(cond: c, thenB: tb, elseB: el) :> typeIf(env, c, tb, el, ts)
            .Given(name: n, subject: sub, body: b) :> typeGiven(env, s, sub, b, ts)
            .For(f: lf) :> typeForStmt(env, s, lf, ts)
            .Break(label: x) :> keepTEnv(env, ts)
            .Continue(label: x) :> keepTEnv(env, ts)
            .Lift(what: w) :> keepTEnv(env, typeLift(env, w, ts))       // s469 (§49.6.2)
            .EffectStmt(w: w) :> keepTEnv(env, ts)     // refused by the binder (E-LIFECYCLE-016 / E-BOOTSTRAP-UNSUPPORTED)
            .Defer(body: b) :> keepTEnv(env, typeBlock(tDeferEnv(env), b, ts))   // s451: typed at its exit, not where it stands
            .Fail(f: f) :> keepTEnv(env, typeFail(env, s, f, ts))               // s451 (Ue)
        }
    }

    // `p = v`: drops the narrowing of `p` (and under it) — and, when `v` is
    // PROVABLY present (a known type, not `T | not`), narrows `p` (r2 F3).
    fn typeEvalStmt(env: TEnv, e: AExpr, ts0: TypeState) -> RTEnv {
        const ts: TypeState = typeStmtExpr(env, e, ts0)
        const key: string = writtenKey(env, e)
        const out: TEnv = tUnnarrow(tCallUnnarrow(env, e), key)
        if (key != "" && writesPresent(e, ts)) return keepTEnv(tNarrow(out, [key]), ts)
        return keepTEnv(out, ts)
    }

    fn writesPresent(e: AExpr, ts: TypeState) -> boolean {
        const v: AExpr | not = assignValue(e)
        if (v is not) return false
        const x: Type | not = knownOf(exprType0(ts, v.nid))
        if (x is not) return false
        return maybeInner(x) is not
    }

    fn assignValue(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> v
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    // A statement `p = v` / `reset(p)` writes place `p`.
    fn writtenKey(env: TEnv, e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t) :> assignKey(env, e, t)
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c, args: a) :> resetKey(env, c, a)
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: x) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // A bare local target `a = v` carries no name fact (the binder records the
    // rebinding as an effect of the statement): its key is the effect's local.
    fn assignKey(env: TEnv, e: AExpr, t: AExpr) -> string {
        if (exprName(t) != "") {
            const s: Sym | not = assignedLocal(effectFact(env.t.effects, e.nid))
            if (s is given) return "#" + s.id
            return ""
        }
        // s472: a write to a part of a local drops the narrowing of that part (and
        // under it) — up to the first tape position (a position is not a key)
        const pk: string = localPartKey(effectFact(env.t.effects, e.nid))
        if (pk != "") return pk
        return nKey(env, t)
    }

    fn localPartKey(f: EffectFact | not) -> string {
        return match f {
            .EAssignLocal(sym: s, path: pa) :> partKeyOf(s, pa)
            .EWrite(w: w) :> ""
            .ESpread(ws: ws) :> ""
            .EReset(w: w) :> ""
            .EEdits(w: w) :> ""
            .ERemove(w: w) :> ""
            .EElemAt(cap: c) :> ""
            .EPosition(cap: c) :> ""
            not :> ""
        }
    }

    fn partKeyOf(s: Sym, pa: LStep[]) -> string {
        if (pa.length == 0) return ""
        let k: string = "#" + s.id
        for (const st of pa) {
            const n: string = lstepName(st)
            if (n == "") return k
            k = k + "." + n
        }
        return k
    }

    fn lstepName(st: LStep) -> string {
        return match st {
            .LField(ref: r, name: n) :> n
            .LIndex(index: ix) :> ""
        }
    }

    fn resetKey(env: TEnv, c: AExpr, a: AExpr[]) -> string {
        if (exprName(c) == "reset" && a.length == 1) return nKey(env, a[0])
        return ""
    }

    // The narrowing an `if` leaves: the INTERSECTION of what each path leaves
    // (a path that always `return`s leaves nothing to join — the other path's
    // narrowing holds, e.g. after `if (x is not) { return }`). The env's own
    // locals and settled types stay the enclosing block's.
    fn joinPaths(env: TEnv, a: TEnv, aExits: boolean, b: TEnv, bExits: boolean) -> TEnv {
        if (aExits && !bExits) return withNarrowed(env, b.narrowed)
        if (bExits && !aExits) return withNarrowed(env, a.narrowed)
        if (aExits && bExits) return env
        let both: string[] = []
        for (const k of a.narrowed) {
            if (b.narrowed.indexOf(k) >= 0) both = both.concat([k])
        }
        return withNarrowed(env, both)
    }

    fn withNarrowed(env: TEnv, keys: string[]) -> TEnv {
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: keys,
                 fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    fn typeMaybeExpr(env: TEnv, e: AExpr | not, ts: TypeState) -> TypeState {
        if (e is not) return ts
        return typeExpr(env, e, ts).ts
    }

    // `let a[: T] = init`: an annotated local IS its annotation; an
    // unannotated one contributes its initializer to its joined type.
    // §7.5.1 position 1: an ANNOTATED local's literal initializer is checked
    // against its annotation (`number` / `string` / `boolean`; `not` into a
    // non-optional type is E-TYPE-041, §42.3.1), and every struct literal in
    // it field by field (§66.1 rule 5's rule, spelling-independent).
    fn typeLocal(env: TEnv, s: AStmt, name: string, init: AExpr, ts: TypeState) -> RTEnv {
        const r: RVT = typeExpr(env, init, ts)
        const sym: Sym | not = bindSym(bindFact(env.t.binds, s.nid))
        if (sym is not) return keepTEnv(env, r.ts)
        const annot: Type | not = annotOf(env.t, sym)
        if (annot is given) {
            let ts2: TypeState = checkAnnotInit(env, annot, literalKind(init), r.vt, init.span, "`" + name + "`", r.ts)
            ts2 = checkNotElems(env, init, annot, checkLitFields(env, init, ts2))
            return keepTEnv(tWithLocal(env, sym, known(annot)), ts2)
        }
        return keepTEnv(tWithLocal(env, sym, r.vt), contribute(r.ts, sym, r.vt))
    }

    // s472 — a file-scope constant's type (constPass): its written type, else
    // its initializer's; Unknown for a refused one (no check fires on it).
    fn constVType(t: Tables, s: Sym) -> VType {
        for (const c of t.consts) {
            if (c.sym.id == s.id) {
                const ty: Type | not = c.ty
                if (ty is given && c.ok) return known(ty)
                return VType.Unknown
            }
        }
        return VType.Unknown
    }

    fn constByNid(t: Tables, nid: int) -> ConstInfo | not {
        for (const c of t.consts) {
            if (c.nid == nid) return c
        }
        return not
    }

    // s472 — a file-scope constant's initializer, typed where it stands (file
    // scope: no locals), and checked against its written type exactly as a
    // local's is (typeLocal): §7.5.1's positions include a declaration's
    // initializer. A refused constant (constPass) is not typed.
    fn typeConst(env0: TEnv, c: AConst, ts0: TypeState) -> TypeState {
        const ci: ConstInfo | not = constByNid(env0.t, c.nid)
        if (ci is not) return ts0
        if (!ci.ok) return ts0
        const env: TEnv = { t: env0.t, file: env0.file, errs: env0.errs, locals: [], settled: env0.settled, narrowed: [], fnw: env0.fnw, rows: [], fret: not, blame: env0.blame }
        const r: RVT = typeExpr(env, c.init, ts0)
        const annot: Type | not = ci.annot
        if (annot is not) return r.ts
        const ts: TypeState = checkAnnotInit(env, annot, literalKind(c.init), r.vt, c.init.span, "`" + c.name + "`", r.ts)
        return checkNotElems(env, c.init, annot, checkLitFields(env, c.init, ts))
    }

    // The condition is checked (checkCond, ruled S440 #4 = (c)); each branch
    // is typed under the condition's narrowing (less what the condition's own
    // calls may undo); the statement leaves the join of both paths.
    fn typeIf(env0: TEnv, c: AExpr, tb: ABlock, el: ABlock | not, ts0: TypeState) -> RTEnv {
        const env: TEnv = tKeptUnnarrow(env0, c)      // s474 (§50, D10): the head rebinds its kept locals
        const rc: RVT = typeExpr(env, c, ts0)
        let ts: TypeState = checkCond(env, c, rc.vt, "an `if` condition", rc.ts)
        const n: Narrowing = condNarrowing(env, c)
        const rt: RTEnv = typeBlockEnv(tCallUnnarrow(tNarrow(env, n.yes), c), tb, ts)
        const noEnv: TEnv = tCallUnnarrow(tNarrow(env, n.no), c)
        if (el is not) return keepTEnv(joinPaths(env, rt.env, exits(tb), noEnv, false), rt.ts)
        const re: RTEnv = typeBlockEnv(noEnv, el, rt.ts)
        return keepTEnv(joinPaths(env, rt.env, exits(tb), re.env, exits(el)), re.ts)
    }

    // The body may not run: what it leaves is joined with the path around it.
    fn typeGiven(env: TEnv, s: AStmt, subject: AExpr, body: ABlock, ts: TypeState) -> RTEnv {
        const r: RVT = typeExpr(env, subject, ts)
        const sym: Sym | not = bindSym(bindFact(env.t.binds, s.nid))
        const around: TEnv = tCallUnnarrow(env, subject)
        let inner: TEnv = around
        if (sym is given) inner = tWithLocal(around, sym, r.vt)
        const rb: RTEnv = typeBlockEnv(inner, body, r.ts)
        return keepTEnv(joinPaths(env, rb.env, false, around, false), rb.ts)
    }

    // A statement-position expression: a write is checked against the
    // classified target (the binder's WriteFact), per override for a spread.
    fn typeStmtExpr(env: TEnv, e: AExpr, ts: TypeState) -> TypeState {
        const k: AExprK = e.k
        return match k {
            .Assign(target: x, value: v) :> typeAssign(env, e, x, v, ts)
            .Call(callee: c, args: args) :> typeCallStmt(env, e, c, args, ts)
            .Name(name: n) :> typeExpr(env, e, ts).ts
            .At(name: n) :> typeExpr(env, e, ts).ts
            .AtItem :> typeExpr(env, e, ts).ts
            .Num(raw: r) :> typeExpr(env, e, ts).ts
            .Str(v: s) :> typeExpr(env, e, ts).ts
            .Bool(v: b) :> typeExpr(env, e, ts).ts
            .NotLit :> typeExpr(env, e, ts).ts
            .Recovered :> typeExpr(env, e, ts).ts
            .Variant(name: n) :> typeExpr(env, e, ts).ts
            .Member(obj: o) :> typeExpr(env, e, ts).ts
            .Unary(op: o) :> typeExpr(env, e, ts).ts
            .Binary(op: o) :> typeExpr(env, e, ts).ts
            .Ternary(test: x) :> typeExpr(env, e, ts).ts
            .ArrayLit(elems: es) :> typeExpr(env, e, ts).ts
            .ObjectLit(props: ps) :> typeExpr(env, e, ts).ts
            .Spread(e: x) :> typeExpr(env, e, ts).ts
            .Index(obj: o) :> typeExpr(env, e, ts).ts
            .Lambda(params: ps2) :> typeExpr(env, e, ts).ts
            .Sql(q: q) :> typeExpr(env, e, ts).ts
            .Handled(h: x) :> typeExpr(env, e, ts).ts
            .Template(quasis: qs) :> typeExpr(env, e, ts).ts
            .Foreign(f: fb0) :> typeExpr(env, e, ts).ts
        }
    }

    // s474 (§50.4.1): "The type of `x = value` is the type of `value`, which must
    // be assignable to the declared type of `x`" — the kept condition-head
    // assignment is typed as the statement form (typeAssign: the value against
    // the local's written type, or joined into its inferred one), and its value
    // is the value's. A refused (not kept) one is Unknown.
    fn typeAssignValue(env: TEnv, e: AExpr, target: AExpr, value: AExpr, kept: boolean, ts0: TypeState) -> RVT {
        if (!kept) return rvt(VType.Unknown, typeExpr(env, value, ts0).ts)
        const ts: TypeState = typeAssign(env, e, target, value, ts0)
        return rvt(exprType0(ts, value.nid), ts)
    }

    // s474 — a condition head's kept assignments rebind their locals before the
    // head's test is decided: a narrowing of the local from before the head no
    // longer holds (the head's own test narrows it again, condNarrowing).
    fn tKeptUnnarrow(env: TEnv, c: AExpr) -> TEnv {
        let out: TEnv = env
        for (const a of keptAssigns(c)) { out = tUnnarrow(out, nKey(env, a)) }
        return out
    }

    // The kept assignments of a condition head (parse.scrml keptHead's places:
    // the root, and operands through unary / binary operators).
    fn keptAssigns(c: AExpr) -> AExpr[] {
        const k: AExprK = c.k
        return match k {
            .Assign(target: t, kept: kp) :> keptAssignOf(c, kp)
            .Unary(op: o, e: x) :> keptAssigns(x)
            .Binary(op: o, l: l, r: r) :> keptAssigns(l).concat(keptAssigns(r))
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: x) :> []
            .Ternary(test: x) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    fn keptAssignOf(a: AExpr, kept: boolean) -> AExpr[] {
        if (kept) return [a]
        return []
    }

    fn typeAssign(env: TEnv, e: AExpr, target: AExpr, value: AExpr, ts0: TypeState) -> TypeState {
        const f: EffectFact | not = effectFact(env.t.effects, e.nid)
        // s472: a write to a PART of a local — each index an `int`, the value against
        // the part's type; `@xs[i] = v` — the index, and the value against the element
        const lp: PartTyping | not = partTypingOf(env, f)
        if (lp is given) {
            let ts3: TypeState = ts0
            for (const ix of lp.indices) {
                const ri: RVT = typeExpr(env, ix, ts3)
                ts3 = checkIndex(env, ri.vt, ix.span, ri.ts)
            }
            const r0: RVT = typeExpr(env, value, ts3)
            ts3 = r0.ts
            const tt: Type | not = lp.ty
            if (tt is given) ts3 = checkNotElems(env, value, tt, checkLitFields(env, value, checkValue(env, r0.vt, tt, value.span, placeLabel(target), ts3)))
            return record(record(ts3, target.nid, VType.Unknown), e.nid, VType.Unknown)
        }
        // s444: `@xs[i].f = v` — the value against the element field's type
        const ea: FieldRef[] | not = elemAtPath(f)
        if (ea is given) {
            const r0: RVT = typeExpr(env, value, ts0)
            let ts3: TypeState = typePlace(env, target, VType.Unknown, r0.ts)
            const tt: Type | not = pathType(env.t, ea)
            if (tt is given) ts3 = checkNotElems(env, value, tt, checkLitFields(env, value, checkValue(env, r0.vt, tt, value.span, placeLabel(target), ts3)))
            // r2 F3: the index names a POSITION — an `int`
            const ix: AExpr | not = elemAtIndex(f)
            if (ix is given) ts3 = checkIndex(env, exprType0(ts3, ix.nid), ix.span, ts3)
            return record(ts3, e.nid, VType.Unknown)
        }
        // s442: a recognized append / prepend shape — each ELEMENT is the written value
        const ed: EditsOf | not = editsOf(f)
        if (ed is given) return typeEditsAssign(env, e, target, value, ed, ts0)
        const ws: SpreadWrite[] = effectWrites(f)
        const ps: AProp[] = propsOf(value)
        if (ws.length > 0 && ws[0].prop >= 0) {
            // a spread: the operand and each override typed; each override checked
            let ts: TypeState = typePlace(env, target, VType.Unknown, typeExpr(env, value, ts0).ts)
            for (const sw of ws) {
                if (sw.prop < ps.length) {
                    const pv: AProp = ps[sw.prop]
                    ts = checkWrite(env, sw.w, exprType0(ts, pv.value.nid), pv.value, "`" + pv.name + "`", ts)
                }
            }
            return record(ts, e.nid, VType.Unknown)
        }
        const r: RVT = typeExpr(env, value, ts0)
        let ts1: TypeState = r.ts
        let placeType: VType = VType.Unknown
        if (ws.length == 1) {
            const wt: Type | not = writeValueType(env.t, ws[0].w)
            if (wt is given) placeType = known(wt)
        } else {
            // a local rebinding (§66.11.5): it widens the local's joined type.
            // Only a BARE local target (`a = v`) is the local itself; `a.n = v`
            // is a field edit of it (§66.11.4) whose field type this path does
            // not compute — unchecked (provable-or-silent), and not joined.
            const ls: Sym | not = assignedLocal(f)
            const bareLocal: boolean = exprName(target) != ""
            if (ls is given) {
                if (bareLocal) placeType = tLocal(env, ls)
                const la: Type | not = annotOf(env.t, ls)
                if (la is given && bareLocal) {
                    // a write to an annotated local: checked like a cell write
                    ts1 = checkLitFields(env, value, checkValue(env, r.vt, la, value.span, placeLabel(target), ts1))
                } else if (la is not && bareLocal) {
                    ts1 = contribute(ts1, ls, r.vt)
                }
                // s469-boot-tape-grants (g-bootstrap-local-tape-rebinding-not-grant-checked-s469):
                // the tape write a local rebinding performs, judged by the local's TYPE grants —
                // its annotation, else its inferred type (which carries none, §66.12.6 rule 1)
                if (bareLocal) {
                    let lt: Type | not = la
                    if (lt is not) lt = paramTypeOfSym(env.t, ls)      // a parameter's type is written, not inferred
                    if (lt is not) {
                        // inferred: the tape the local holds carries NO grant, whatever
                        // value it was given (`let s = @audit`, §66.12.6 rule 1)
                        const inf: Type | not = knownOf(tLocal(env, ls))
                        if (inf is given) lt = inferredTape(inf)
                    }
                    let tds: TapeDiag[] = inferredTapeProblems(exprName(target), value, knownOf(r.vt))
                    if (lt is given) tds = localTapeProblems(env.t.types, exprName(target), lt, value)
                    for (const d of tds) { ts1 = report(ts1, env, target.span, d.code, d.msg) }
                }
            }
        }
        let ts2: TypeState = typePlace(env, target, placeType, ts1)
        for (const sw of ws) { ts2 = checkWrite(env, sw.w, r.vt, value, placeLabel(target), ts2) }
        return record(ts2, e.nid, VType.Unknown)
    }

    // s472 — what the typer checks of a part write / a position write: its index
    // expressions (in order), and the type of the part written (`not`: unchecked).
    type PartTyping:struct = { indices: AExpr[], ty: Type | not }

    fn partTypingOf(env: TEnv, f: EffectFact | not) -> PartTyping | not {
        return match f {
            .EAssignLocal(sym: s, path: pa, ty: ty) :> localPartTyping(pa, ty)
            .EPosition(cap: c, index: ix) :> positionTyping(env, c, ix)
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EEdits(w: w) :> not
            .ERemove(w: w) :> not
            .EElemAt(cap: c) :> not
            not :> not
        }
    }

    fn localPartTyping(pa: LStep[], ty: Type | not) -> PartTyping | not {
        if (pa.length == 0) return not
        let ixs: AExpr[] = []
        for (const st of pa) { ixs = ixs.concat(lstepIndex(st)) }
        return { indices: ixs, ty: ty }
    }

    fn lstepIndex(st: LStep) -> AExpr[] {
        return match st {
            .LIndex(index: ix) :> [ix]
            .LField(ref: r) :> []
        }
    }

    fn positionTyping(env: TEnv, cap: Sym, ix: AExpr) -> PartTyping {
        const fi: FieldInfo | not = fieldOfCap(env.t, cap)
        let et: Type | not = not
        if (fi is given) {
            if (fi.trusted) et = seqElem(fi.ty)
        }
        return { indices: [ix], ty: et }
    }

    // s442 — `@x = [...@x, a, b]`: the array is typed as a value, then each
    // element is checked as the edit's written value (the element type).
    type EditsOf:struct = { w: WriteFact, elems: AExpr[] }

    fn editsOf(f: EffectFact | not) -> EditsOf | not {
        return match f {
            .EEdits(w: w, elems: es) :> editsPair(w, es)
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EAssignLocal(sym: s) :> not
            .ERemove(w: w) :> not
            .EElemAt(cap: c) :> not
            .EPosition(cap: c) :> not
            not :> not
        }
    }

    fn editsPair(w: WriteFact, es: AExpr[]) -> EditsOf { return { w: w, elems: es } }

    fn elemAtIndex(f: EffectFact | not) -> AExpr | not {
        return match f {
            .EElemAt(cap: c, index: x) :> x
            .EPosition(cap: c) :> not
            .EEdits(w: w) :> not
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EAssignLocal(sym: s) :> not
            .ERemove(w: w) :> not
            not :> not
        }
    }

    // r2 F3 — `@xs[i].f = v`: `i` names a position of the sequence, so it is an
    // `int` (`int` enforced, RULED S440 JS-WAT 7(a): a `number` is not
    // implicitly an `int`). ⚑ PA: no SPEC sentence states the index type of a
    // sequence position (§66.12.2's "positions" axis names no type); the
    // bootstrap holds it to `int`. Provable-or-silent, as every check here: an
    // index whose type is unknown is left to the runtime position check.
    fn checkIndex(env: TEnv, v: VType, span: ASpan, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: x) :> checkIndexKnown(env, x, span, ts)
            .Absent :> report(ts, env, span, "E-TYPE-031", "a sequence index is an `int` position, and this index is `not` (§66.12.2 positions; `int` enforced, ruled S440 JS-WAT 7(a))")
            .Unknown :> ts
            .OneOf(ts: xs) :> checkOneOf(env, xs, Type.Int, span, "a sequence index (an `int` position, §66.12.2)", ts)
        }
    }

    fn checkIndexKnown(env: TEnv, x: Type, span: ASpan, ts: TypeState) -> TypeState {
        if (!mayBeNot(x, Type.Int) && fitsType(x, Type.Int) != Verdict.Fails) return ts
        return report(ts, env, span, "E-TYPE-031", "a sequence index is an `int` position, and this index is `" + typeName(x) + "` (§66.12.2 positions; `int` enforced, ruled S440 JS-WAT 7(a): a `number` is not implicitly an `int`)")
    }

    fn elemAtPath(f: EffectFact | not) -> FieldRef[] | not {
        return match f {
            .EElemAt(cap: c, path: p) :> p
            .EPosition(cap: c) :> not
            .EEdits(w: w) :> not
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EAssignLocal(sym: s) :> not
            .ERemove(w: w) :> not
            not :> not
        }
    }

    fn typeEditsAssign(env: TEnv, e: AExpr, target: AExpr, value: AExpr, ed: EditsOf, ts0: TypeState) -> TypeState {
        let ts: TypeState = typePlace(env, target, VType.Unknown, typeExpr(env, value, ts0).ts)
        for (const x of ed.elems) {
            ts = checkWrite(env, ed.w, exprType0(ts, x.nid), x, "an element of this sequence", ts)
        }
        return record(ts, e.nid, VType.Unknown)
    }

    // A write target (a PLACE): recorded with the type the place holds; the
    // instance / struct it is reached through typed as a value.
    fn typePlace(env: TEnv, target: AExpr, placeType: VType, ts: TypeState) -> TypeState {
        let ts2: TypeState = ts
        const obj: AExpr | not = memberObj(target)
        if (obj is given) ts2 = typeExpr(env, obj, ts2).ts
        return record(ts2, target.nid, placeType)
    }

    fn memberObj(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Member(obj: o) :> o
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    // A write whose value is the call's single argument: `@xs.push(v)`.
    fn typeCallStmt(env: TEnv, e: AExpr, callee: AExpr, args: AExpr[], ts0: TypeState) -> TypeState {
        const f: EffectFact | not = effectFact(env.t.effects, e.nid)
        const ws: SpreadWrite[] = effectWrites(f)
        if (ws.length == 0) {
            if (isReset(f)) {
                // `reset(@x)`: its argument is a place, not a value to check
                return record(typePlace(env, callee, VType.Unknown, typeExprs(env, args, ts0)), e.nid, VType.Unknown)
            }
            return typeExpr(env, e, ts0).ts
        }
        let ts: TypeState = typePlace(env, callee, VType.Unknown, typeExprs(env, args, ts0))
        if (args.length == 1) {
            for (const sw of ws) { ts = checkWrite(env, sw.w, exprType0(ts, args[0].nid), args[0], "an element of this sequence", ts) }
        }
        return record(ts, e.nid, VType.Unknown)
    }
    // The type recorded for a node this pass already typed.
    fn exprType0(ts: TypeState, nid: int) -> VType {
        let i: int = ts.exprs.length - 1
        while (i >= 0) {
            if (ts.exprs[i].nid == nid) return ts.exprs[i].vt
            i = i - 1
        }
        return VType.Unknown
    }

    // A write: its value against the target's type, then — however the write
    // is spelled — every struct-literal field inside the value against that
    // struct field's declared type (§66.1 rule 5).
    fn checkWrite(env: TEnv, w: WriteFact, v: VType, value: AExpr, what: string, ts: TypeState) -> TypeState {
        const f: FieldInfo | not = fieldOfCap(env.t, w.cap)
        if (f is not) return ts
        if (!f.trusted) return ts
        const target: Type | not = writeValueType(env.t, w)
        if (target is not) return ts
        return checkNotElems(env, value, target, checkLitFields(env, value, checkValue(env, v, target, value.span, what, ts)))
    }

    // The struct literals inside a written value: each named property against
    // its struct field (the literal's struct is the type the typer recorded).
    fn checkLitFields(env: TEnv, e: AExpr, ts: TypeState) -> TypeState {
        const k: AExprK = e.k
        return match k {
            .ObjectLit(props: ps) :> checkObjFields(env, e, ps, ts)
            .Spread(e: x) :> ts
            .Index(obj: o) :> ts
            .Lambda(params: ps2) :> ts
            .Sql(q: q) :> ts
            .Handled(h: x) :> ts
            .Template(quasis: qs) :> ts
            .Foreign(f: fb0) :> ts
            .ArrayLit(elems: es) :> checkLitList(env, es, ts)
            .Ternary(test: x, yes: y, no: n) :> checkLitFields(env, n, checkLitFields(env, y, ts))
            .Name(name: n) :> ts
            .At(name: n) :> ts
            .AtItem :> ts
            .Num(raw: r) :> ts
            .Str(v: x) :> ts
            .Bool(v: b) :> ts
            .NotLit :> ts
            .Recovered :> ts
            .Variant(name: n) :> ts
            .Member(obj: o) :> ts
            .Call(callee: c) :> ts
            .Unary(op: o) :> ts
            .Binary(op: o) :> ts
            .Assign(target: x) :> ts
        }
    }

    fn checkLitList(env: TEnv, es: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const x of es) { ts = checkLitFields(env, x, ts) }
        return ts
    }

    fn checkObjFields(env: TEnv, e: AExpr, ps: AProp[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        const lt: Type | not = knownOf(exprType0(ts, e.nid))
        if (lt is not) return ts
        const s: Sym | not = namedOf(lt)
        if (s is not) return ts
        const ti: TypeInfo | not = typeInfoOf(env.t.types, s)
        if (ti is not) return ts
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return ts
        for (const p of ps) {
            if (!p.spread) {
                for (const fd of fs) {
                    if (fd.sym.hint == p.name && env.t.unresolved.fields.indexOf(fd.sym.id) < 0) {   // r8: not against an unresolved field type
                        ts = checkValue(env, exprType0(ts, p.value.nid), fd.ty, p.value.span, "`" + s.hint + "." + p.name + "`", ts)
                    }
                }
                ts = checkLitFields(env, p.value, ts)
            }
        }
        return ts
    }

    // How a message names a write target: `@x`, `@x.f`, `c.f`.
    fn placeLabel(e: AExpr) -> string {
        const key: string = placeKey(e)
        if (key == "") return "this write"
        return "`" + key + "`"
    }

    // ---- views -----------------------------------------------------------------
    fn typeNodes(env: TEnv, ns: ANode[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const n of ns) { ts = typeNode(env, n, ts) }
        return ts
    }

    // A markup `${x}`: typed; a `T | not` there is NOT an un-narrowed operand —
    // RULED S442: "`${@o.n}` in markup without narrowing stays SILENT (`${not}`
    // renders nothing); Q3's "use in a template" binds string templates only".
    // s472 (g-boot-markup-interp-non-primitive-unchecked-s472, review O2) — markup
    // text is a TEXT SINK (§14.13.2): "Refused: a struct, a tape, a tuple, a map or
    // set, a payload enum value, a function … In markup text, a quoted attribute or
    // a logic template this SHALL be compile error `E-TEXT-NON-PRIMITIVE`". A KNOWN
    // non-primitive (or a `T | not` of one) and every member of a choice are judged
    // here, as a template slot's are (textKnown). The unresolved-type limb is NOT
    // applied to markup text yet (a template slot refuses it): see `.Unknown` below.
    fn typeInterp(env: TEnv, x: AExpr, ts0: TypeState) -> TypeState {
        const r: RVT = typeExpr(env, x, ts0)
        return markupText(env, x, r.vt, r.ts)
    }

    // A markup gather (`${ for … { lift e; } }`, §17.4): the loop is typed as a
    // statement loop, and every value it lifts INTO THE MARKUP (liftOperands:
    // through `if` / `given` blocks and statement loops, not into a nested bound
    // loop — that loop's lifts are its own tape's elements) is markup text,
    // judged by the type it was given where it stands (exprType0).
    fn typeGather(env: TEnv, lf: AFor, ts0: TypeState) -> TypeState {
        let ts: TypeState = typeFor(env, forAsStmt(lf), lf, ts0).ts
        for (const e of liftOperands(lf.body)) { ts = markupText(env, e, exprType0(ts, e.nid), ts) }
        return keylessObjects(env, lf, ts)
    }

    // s474 — W-KEY-001, the §17.4b header meaning (S473 review-surfaced 5):
    // "When no `key` is declared, the compiler MAY emit W-KEY-001 warning for
    // collections that contain objects." Here: a Tier-0 loop that lifts
    // markup rows over a tape of STRUCTS with no header `key` — an unkeyed
    // loop rebuilds every row when it re-runs, so a row's DOM state (typed
    // text, focus, scroll) is lost rather than carried with its item.
    fn keylessObjects(env: TEnv, lf: AFor, ts: TypeState) -> TypeState {
        const h: AForHead = lf.head
        const src: AExpr | not = match h {
            .HIter(bind: b, src: sr, key: ky) :> keylessIterable(sr, ky)
            .HForever :> not
            .HCond(cond: c) :> not
            .HCounted(init: i) :> not
        }
        if (src is not || gatherRows(lf).length == 0) return ts
        const t: Type | not = knownOf(exprType0(ts, src.nid))
        if (t is not) return ts
        const el: Type | not = seqElem(t)
        if (el is not) return ts
        const s: Sym | not = namedOf(el)
        if (s is not) return ts
        const ti: TypeInfo | not = typeInfoOf(env.t.types, s)
        if (ti is not) return ts
        if (structFieldDefs(ti.def) is not) return ts
        return report(ts, env, src.span, "W-KEY-001", "this loop renders a row per `" + s.hint + "` with no `key`, so every change to what it reads REBUILDS all its rows: a row's DOM state (typed text, focus, scroll) is lost, never carried with its item. Name what identifies an item in the head to keep it — `for (const x of xs key x.id)` (§17.4b)")
    }

    fn keylessIterable(src: AIterSrc, key: AExpr | not) -> AExpr | not {
        if (key is given) return not
        return match src {
            .IterOf(e: x) :> x
            .IterRange(lo: lo) :> not
        }
    }

    // The markup-text sink check (§14.13.2) of a value already typed `v`.
    fn markupText(env: TEnv, x: AExpr, v: VType, ts: TypeState) -> TypeState {
        if (hasErrIn(env.errs, x.span)) return ts             // Rule C: not judged across a parse error
        return match v {
            .Known(t: t) :> markupTextKnown(env, x, t, ts)
            .Absent :> ts                                     // `${not}` renders nothing (§7.4.2)
            // MEASURED s472: refusing the unresolved limb here refuses the SPEC's own
            // §66.19 worked programs (4 interpolations) and the M2 dropdownEarlyRead
            // fixture — `${countryValue()}` of a function with no written return type,
            // whose type §66.3 infers and the bootstrap typer does not yet. A gap of
            // the typer's inference, not a value it resolved: deferred (filed).
            .Unknown :> ts
            .OneOf(ts: xs) :> markupTextOneOf(env, x, xs, ts)
        }
    }

    // (f): a `T | not` of a primitive renders nothing when `not` — silent.
    // A DECLARATION's type (a read of a user declaration's instance or shared
    // cell, §66.8) is not judged here, as `==` does not judge it (eqSameType):
    // a shared cell's read can stand for its value (§66.19.4), and the
    // declaration forms the bootstrap cannot render are refused by name
    // where they are declared (O19).
    fn markupTextKnown(env: TEnv, x: AExpr, t: Type, ts: TypeState) -> TypeState {
        const inner: Type | not = maybeInner(t)
        let u: Type = t
        if (inner is given) u = inner
        if (isTextPrimitive(env, u)) return ts
        const ds: Sym | not = namedOf(u)
        if (ds is given) {
            if (isDeclSym(env, ds)) return ts
        }
        let what: string = textWhat(env, u)
        if (inner is given) what = "a `" + typeName(t) + "`"
        return report(ts, env, x.span, "E-TEXT-NON-PRIMITIVE", "markup text `${…}` is text, and this is " + what + " — only a `string`, `int`, `number`, `bool` or unit enum value has one honest text (§14.13.2). Interpolate a field (`p.name`), a `scrml:format` call, or show it with `log()`")
    }

    fn markupTextOneOf(env: TEnv, x: AExpr, xs: Type[], ts: TypeState) -> TypeState {
        for (const t of xs) {
            const r: TypeState = markupTextKnown(env, x, t, ts)
            if (r.diags.length > ts.diags.length) return r
        }
        return ts
    }

    fn typeNode(env: TEnv, n: ANode, ts: TypeState) -> TypeState {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> typeElem(env, e, ts)
            .Text(text: x) :> ts
            .Interp(e: x) :> typeInterp(env, x, ts)
            .DeclNode(d: d) :> ts
            .Css(c: c) :> ts
            .Effect(w: w) :> typeEffect(env, w, ts)
            .Gather(f: lf) :> typeGather(env, lf, ts)                     // s469 (§17.4); s473 r1
        }
    }

    // s449: an effect's dependencies are typed as reads; its body as a handler
    // block is (it runs only while its scope is mounted, under the same
    // narrowing as the markup around it).
    fn typeEffect(env: TEnv, w: AEffect, ts0: TypeState) -> TypeState {
        const ts: TypeState = typeExprs(env, w.deps, ts0)
        return typeBlock(env, w.body, ts)
    }

    fn typeElem(env: TEnv, e: AElem, ts: TypeState) -> TypeState {
        if (e.star) return ts
        if (e.tag == "each") return typeEach(env, e, ts)
        const u: Sym | not = useDecl(elemFact(env.t.elems, e.nid))
        if (u is given) return typeUse(env, e, u, ts)
        return typeHtml(env, e, ts)
    }

    fn typeAttrValue(env: TEnv, v: AAttrValue, ts: TypeState) -> RVT {
        const x: AExpr | not = valueExpr(v)
        if (x is not) return rvt(VType.Unknown, ts)
        return typeExpr(env, x, ts)
    }

    // s462 Q12 (ruling:user-voice-scrml.md S462 "a"): an event handler is a function
    // body — it runs LATER, after writes the walk does not see — so it does not inherit
    // the narrowing of reactive cells (`@…`): it re-tests. A captured local (`#id`, an
    // `<each>` row) keeps its narrowing.
    fn typeHandlerValue(env0: TEnv, v: AAttrValue, ts: TypeState, ev: string) -> TypeState {
        const env: TEnv = tDropCellNarrowing(env0, userInputEvent(ev))
        return match v {
            .Bare(e: x) :> typeStmtExpr(env, x, ts)
            .Paren(e: x) :> typeStmtExpr(env, x, ts)
            .Braced(b: b) :> typeBlock(env, b, ts)
            .Quoted(v: s) :> ts
            .NoValue :> ts
        }
    }

    // An element's `if=` (L5): a condition (checkCond, ruled S440 #4 = (c)),
    // typed FIRST — the element's other attributes and its children exist
    // only while it holds, so they are typed under its narrowing (`renv`).
    fn typeIfAttr(env: TEnv, e: AElem, ts: TypeState) -> RTEnv {
        const a: AAttr | not = condAttrOf(e.attrs)       // s451: an `else-if=` branch too
        if (a is not) return keepTEnv(env, ts)
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return keepTEnv(env, ts)
        const r: RVT = typeExpr(env, x, ts)
        // s460 N3 — name the attribute the condition stands in (`if=` / `else-if=`)
        // s462 Q18 — the gate also marks the cells it narrows (`gateMark`), so an
        // event handler in the gated subtree keeps them (`tDropCellNarrowing`).
        const yes: string[] = condNarrowing(env, x).yes
        return keepTEnv(tCallUnnarrow(tNarrow(env, yes.concat(gateMarks(yes))), x), checkCond(env, x, r.vt, "`" + a.name + "=`", r.ts))
    }

    fn typeShowAttr(env: TEnv, a: AAttr, ts: TypeState) -> TypeState {
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return ts
        const r: RVT = typeExpr(env, x, ts)
        return checkCond(env, x, r.vt, "`show=`", r.ts)
    }

    fn typeHtml(env: TEnv, e: AElem, ts0: TypeState) -> TypeState {
        const ri: RTEnv = typeIfAttr(env, e, ts0)
        const renv: TEnv = ri.env
        let ts: TypeState = ri.ts
        for (const a of e.attrs) {
            if (isChainAttr(a.name)) {
                // typed above (typeIfAttr); `else` has no value
            } else if (a.name == "show") {
                // s451: §17.2 — a condition (checkCond), under the element's
                // `if=` narrowing; it narrows nothing itself
                ts = typeShowAttr(renv, a, ts)
            } else if (eventName(a.name) != "") {
                ts = typeHandlerValue(renv, a.value, ts, eventName(a.name))
            } else {
                ts = typeAttrValue(renv, a.value, ts).ts
            }
        }
        return typeNodes(renv, e.kids, ts)
    }

    // A USE: each construction value is the field's initializer for this
    // instance (§66.9 rule 8) — the §7.5.1 position-2 rule applies.
    fn typeUse(env: TEnv, e: AElem, decl: Sym, ts0: TypeState) -> TypeState {
        const ri: RTEnv = typeIfAttr(env, e, ts0)
        const renv: TEnv = ri.env
        let ts: TypeState = ri.ts
        const di: DeclInfo | not = declInfo(env.t, decl)
        for (const a of e.attrs) {
            let av: VType = VType.Unknown
            if (a.name != "as" && !isChainAttr(a.name)) {
                const ra: RVT = typeAttrValue(renv, a.value, ts)
                ts = ra.ts
                av = ra.vt
            }
            const i: int = constructIndex(attrFact(env.t.attrs, a.nid))
            if (di is given && i >= 0 && i < di.fields.length) {
                const f: FieldInfo = di.fields[i]
                if (f.annotated && f.trusted) {
                    const what: string = "`" + a.name + "` of `<" + e.tag + ">`"
                    const lk: int = attrLiteralKind(a.value)
                    ts = checkAnnotInit(env, f.ty, lk, av, a.span, what, ts)
                    ts = checkAttrLitFields(env, a.value, f.ty, ts)
                }
            }
        }
        return typeNodes(renv, e.kids, ts)
    }

    // `<each in=…>`: a row scope whose binding is the source's element type.
    fn typeEach(env: TEnv, e: AElem, ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        let src: VType = VType.Unknown
        const inA: AAttr | not = attrNamed(e.attrs, "in")
        if (inA is given) {
            const r: RVT = typeInValue(env, inA.value, ts)
            ts = r.ts
            src = r.vt
            ts = checkIterable(env, src, inA.span, ts)
        }
        let elem: VType = VType.Unknown
        const st: Type | not = knownOf(src)
        if (st is given) {
            const et: Type | not = seqElem(unMaybe(st))
            if (et is given) elem = known(et)
        }
        let renv: TEnv = env
        const bind: Sym | not = eachBind(elemFact(env.t.elems, e.nid))
        if (bind is given) renv = tWithRow(tWithLocal(env, bind, elem), bind, eachSourceKey(env, e))
        const keyA: AAttr | not = attrNamed(e.attrs, "key")
        if (keyA is given) ts = typeAttrValue(renv, keyA.value, ts).ts
        return typeNodes(renv, e.kids, ts)
    }

    // RULED S440 (22-item queue #3, "`<each in=>` over a non-sequence → error,
    // name a code (`E-EACH-NOT-SEQUENCE`)"; SPEC-text OPEN #3, "stay silent
    // under the typer's provable-or-silent rule, and error only when the value
    // is provably not a sequence"); SPEC §17.7.2: "`<each in=expr>` over a
    // value that is not a sequence is a compile error, `E-EACH-NOT-SEQUENCE`
    // … A value typed `S | not`, where `S` is a sequence, is admitted". A
    // value PROVABLY not a sequence (a scalar, a string, a struct, an enum, an
    // instance, or `T | not` over one of those) is refused; `S | not` over a
    // sequence and an unproven value are not. `in="abc"` is a string literal
    // (checked like a string cell); `in=not` is refused (it is never a
    // sequence — kept from S439, the reversible direction).
    fn typeInValue(env: TEnv, v: AAttrValue, ts: TypeState) -> RVT {
        return match v {
            .Quoted(v: s) :> rvt(known(Type.Str), ts)
            .Bare(e: x) :> typeExpr(env, x, ts)
            .Paren(e: x) :> typeExpr(env, x, ts)
            .NoValue :> rvt(VType.Unknown, ts)
            .Braced(b: b) :> rvt(VType.Unknown, ts)
        }
    }

    // The place an `<each in=…>` iterates ("" — not a place: a literal, a call).
    fn eachSourceKey(env: TEnv, e: AElem) -> string {
        const a: AAttr | not = attrNamed(e.attrs, "in")
        if (a is not) return ""
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return ""
        return nKey(env, x)
    }

    fn checkIterable(env: TEnv, v: VType, span: ASpan, ts: TypeState) -> TypeState {
        if (isAbsentVT(v)) {
            return report(ts, env, span, "E-EACH-NOT-SEQUENCE", "`<each in=not>` — `not` is not a sequence (§17.7.2)")
        }
        const x: Type | not = knownOf(v)
        if (x is not) return ts
        let s: Type = x
        const inner: Type | not = maybeInner(x)
        if (inner is given) s = inner                     // `S | not` is admitted when `S` is a sequence (§17.7.4)
        if (kindOf(s) == 5) return ts
        return report(ts, env, span, "E-EACH-NOT-SEQUENCE", "`<each in=…>` iterates a sequence (an array or a tuple), and this value is `" + typeName(x) + "` — for a count, `<each of=N>` (§17.7.2)")
    }

    // ---- the program ------------------------------------------------------------
    // The typer runs whole-program PASSES until every unannotated local's
    // joined type is stable (a local read before a later assignment is typed
    // from the join, not from its initializer alone). Only the settled pass's
    // types and diagnostics are kept. A local's join only moves UP a shallow
    // lattice (a type → `T | not` / `number` → Unknown: at most 3 moves), and a
    // pass that does not settle moves at least one local, so N locals settle
    // within 3N + 2 passes (the bound; a chain of N locals needs N + 1). If
    // the bound is ever hit, only the locals STILL CHANGING become Unknown
    // (silent — provable-or-silent); settled ones keep their type.
    // `prior`: the diagnostics the passes before the typer reported — read only
    // to keep the condition rule from reporting a second time (Blame, s460).
    fn typeProgram(files: FileAst[], t: Tables, prior: Diag[], lk: Linkage) -> RTyping {
        let settled: LocalT[] = []
        let prev: LocalT[] = []
        let pass = 0
        let bound = 2
        while (pass < bound) {
            const ts: TypeState = typePass(files, t, settled, prior, lk)
            const next: LocalT[] = joinContribs(ts.contribs)
            if (pass == 0) bound = 3 * next.length + 2
            if (sameLocals(next, settled)) return { typing: typingOf(ts.exprs, ts.presence), diags: ts.diags }
            prev = settled
            settled = next
            pass = pass + 1
        }
        const last: TypeState = typePass(files, t, unknownWhereChanged(prev, settled), prior, lk)
        return { typing: typingOf(last.exprs, last.presence), diags: last.diags }
    }

    fn unknownWhereChanged(prev: LocalT[], cur: LocalT[]) -> LocalT[] {
        let out: LocalT[] = []
        for (const l of cur) {
            const before: VType | not = findLocalT(prev, l.id)
            let keep = false
            if (before is given) keep = sameVT(before, l.vt)
            if (keep) {
                out = out.concat([l])
            } else {
                out = out.concat([{ id: l.id, vt: VType.Unknown }])
            }
        }
        return out
    }

    fn typePass(files: FileAst[], t: Tables, settled: LocalT[], prior: Diag[], lk: Linkage) -> TypeState {
        let ts: TypeState = { exprs: [], diags: [], contribs: [], presence: [] }
        const fnw: FnW[] = fnWrites(files, lk)
        const fns: int[] = refusedReturns(files, t)
        for (const f of files) {
            const blame: Blame = { spans: errorSpansIn(prior, f.path), syms: [], fns: fns }
            const env: TEnv = { t: t, file: f.path, errs: f.errs, locals: [], settled: settled, narrowed: [], fnw: fnwIn(fnw, lk, f.path), rows: [], fret: not, blame: blame }
            for (const it of f.items) { ts = typeItem(env, it, ts) }
        }
        return ts
    }

    // s460 (Blame.spans): the spans of the Error diagnostics in file `path`.
    fn errorSpansIn(ds: Diag[], path: string) -> ASpan[] {
        let out: ASpan[] = []
        for (const d of ds) {
            if (d.file == path && d.severity == Severity.Error) out = out.concat([d.span])
        }
        return out
    }

    // s460 (Blame.fns): the functions whose WRITTEN return type was refused —
    // it failed to parse or to resolve (fnsOf leaves `ret` unset: guard (i)).
    // (s472: guard (ii), a name declared in two files, is retired — calls
    // resolve per file.)
    fn refusedReturns(files: FileAst[], t: Tables) -> int[] {
        let out: int[] = []
        for (const f of files) {
            for (const af of fnItems(f.items)) {
                const s: Sym | not = bindSym(bindFact(t.binds, af.nid))
                if (s is given) {
                    const fi: FnInfo | not = fnInfoOf(t, s)
                    if (fi is given) {
                        const at: AType | not = af.ret
                        if (at is given && !isVoidType(at) && fi.ret is not) out = out.concat([s.id])
                    }
                }
            }
        }
        return out
    }

    fn typeItem(env: TEnv, it: AItem, ts: TypeState) -> TypeState {
        const k: AItemK = it.k
        return match k {
            .ProgramItem(p: p) :> typeProgramBody(env, p, ts)
            .ConstItem(c: c) :> typeConst(env, c, ts)
            .DeclItem(d: d) :> typeUserDecl(env, d, ts)
            .FnItem(f: f) :> typeFn(env, f, ts)
            .ImportItem(i: i) :> ts
            .TypeItem(t: x) :> ts
            .MarkupItem(n: n) :> ts
        }
    }

    fn declByNid(t: Tables, nid: int) -> DeclInfo | not {
        for (const d of t.decls) {
            if (d.nid == nid) return d
        }
        return not
    }

    fn typeProgramBody(env: TEnv, p: AProgram, ts0: TypeState) -> TypeState {
        let ts: TypeState = typeFieldInits(env, declByNid(env.t, p.nid), ts0)
        for (const it of p.items) { ts = typeProgramItem(env, it, ts) }
        // s442: the program cells' state-child bodies (O5 (1i))
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (!isNestedUserDecl(d)) ts = typeFieldMarkup(env, [d], ts)
            }
        }
        return ts
    }

    // s442: the markup a field carries — its state-child bodies (O5 (1i)) and
    // its own `renders` (a child declaration's, §66.4 rule 2) — typed where
    // the binder resolved it (the declaring declaration's context).
    fn typeFieldMarkup(env: TEnv, fds: ADecl[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const fd of fds) {
            for (const c of fd.body) {
                for (const sc of stateChildOf(c)) { ts = typeNodes(env, sc.body, ts) }
            }
            const r: AElem | not = fd.renders
            if (r is given) ts = typeElem(env, r, ts)
            ts = typeValidatorArgs(env, fd.validators, ts)
        }
        return ts
    }

    // s444 Phase B: a validator's argument expressions are typed as values
    // (the typer covers every expression node; nothing is checked here — the
    // binder judged each validator's applicability, fieldVals).
    fn typeValidatorArgs(env: TEnv, vs: AValidator[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const v of vs) {
            const a: AValArg = v.arg
            ts = typeValArg(env, a, ts)
        }
        return ts
    }

    fn typeValArg(env: TEnv, a: AValArg, ts: TypeState) -> TypeState {
        return match a {
            .Cmp(op: op, e: x) :> typeExpr(env, x, ts).ts
            .Exprs(es: es) :> typeExprs(env, es, ts)
            .NoArgs :> ts
            .Regex(source: s) :> ts
        }
    }

    fn typeProgramItem(env: TEnv, it: AItem, ts: TypeState) -> TypeState {
        const k: AItemK = it.k
        return match k {
            .FnItem(f: f) :> typeFn(env, f, ts)
            .MarkupItem(n: n) :> typeNode(env, n, ts)
            .DeclItem(d: d) :> typeUserDecl(env, d, ts)
            .ProgramItem(p: p) :> ts
            .ConstItem(c: c) :> typeConst(env, c, ts)
            .ImportItem(i: i) :> ts
            .TypeItem(t: x) :> ts
        }
    }

    fn typeUserDecl(env: TEnv, d: ADecl, ts0: TypeState) -> TypeState {
        let ts: TypeState = typeFieldInits(env, declByNid(env.t, d.nid), ts0)
        // s442: its child fields' markup (only a user declaration has child fields)
        if (declByNid(env.t, d.nid) is given) ts = typeFieldMarkup(env, childFields(d.body), ts)
        const r: AElem | not = d.renders
        if (r is not) return ts
        return typeElem(env, r, ts)
    }

    // A declaration's initializers: typed, and an ANNOTATED field's literal
    // initializer checked (§7.5.1 position 2).
    fn typeFieldInits(env: TEnv, di: DeclInfo | not, ts0: TypeState) -> TypeState {
        if (di is not) return ts0
        let ts: TypeState = ts0
        for (const f of di.fields) {
            const before: Diag[] = ts.diags
            const rv: RVT = typeAttrValue(env, f.init, ts)
            ts = rv.ts
            // s473: rule 10 (E-DECL-TYPE-UNPROVEN, originReport) is the initializer's one
            // report — what the typer now knows of an unproven callee's returns (a
            // `function`'s `int | string`, inferReturn) is not reported inside it again
            if (f.annotated && f.trusted && isWrittenUnproven(f.origin)) ts = { exprs: ts.exprs, diags: before, contribs: ts.contribs, presence: ts.presence }
            // s473: an initializer whose value §66.3 rule 10 reports unproven
            // (E-DECL-TYPE-UNPROVEN, originReport) is not ALSO checked against
            // the annotation — the typer may know it as a choice (a `function`'s
            // inferred `int | string`, inferReturn), and one report is the rule's
            if (f.annotated && f.trusted && !isWrittenUnproven(f.origin)) {
                const lk: int = attrLiteralKind(f.init)
                ts = checkAnnotInit(env, f.ty, lk, rv.vt, f.span, "`" + f.sym.hint + "`", ts)
                ts = checkAttrLitFields(env, f.init, f.ty, ts)
            }
        }
        return ts
    }

    fn isWrittenUnproven(o: TypeOrigin) -> boolean {
        return match o {
            .WrittenUnproven(why: w) :> true
            .Written :> false
            .Literal :> false
            .Inferred :> false
            .Blamed :> false
            .Failed(why: w) :> false
            .Cyclic(names: ns) :> false
            .Boundary(where: b) :> false
        }
    }

    // ---- s462 — OWN-VALUE TYPE REPORTS (§66.3 rules 7–10) -----------------------
    // The origin was decided in phase A (ownOrigin / writtenOrigin / boundaryOf);
    // it is REPORTED here, after the binder and every earlier pass, so that
    // "an Error diagnostic already inside the initializer" (rule 7's no-cascade
    // clause, the §42.4 statement 6 discipline) can be honored: condBlamed.
    fn originReport(env: TEnv, di: DeclInfo, f: FieldInfo, ts: TypeState) -> TypeState {
        const o: TypeOrigin = f.origin
        return match o {
            .Written :> ts
            .Literal :> ts
            .Inferred :> ts
            .Blamed :> ts
            .WrittenUnproven(why: w, at: a) :> unprovenReport(env, f, w, a, ts)
            .Failed(why: w, at: a) :> notInferableReport(env, f, w, a, ts)
            .Cyclic(names: ns) :> cycleReport(env, di, f, ns, ts)
            .Boundary(where: b) :> boundaryReport(env, f, b, ts)
        }
    }

    fn initBlamed(env: TEnv, f: FieldInfo, ts: TypeState) -> boolean {
        const e: AExpr | not = valueExpr(f.init)
        if (e is given) return condBlamed(env, e, ts)
        return hasErrIn(env.errs, f.span) || hasErrIn(env.blame.spans, f.span)
    }

    // Fix round 1 (F5): a failure that stands in a FUNCTION (a proof of its
    // return) is owned by an Error already inside that function — a refused
    // construct there is not reported a second time at the own value. Prior
    // passes' Errors are visible for the current file (Blame.spans); the
    // typer's own, for every file (ts.diags).
    fn calleeBlamed(env: TEnv, a: CalleeAt, ts: TypeState) -> boolean {
        if (a.file == "") return false
        const sp: ASpan = mkSpan(a.start, a.end)
        if (a.file == env.file && hasErrIn(env.blame.spans, sp)) return true
        for (const d of ts.diags) {
            if (d.file == a.file && d.severity == Severity.Error && d.span.start >= a.start && d.span.end <= a.end) return true
        }
        return false
    }

    fn notInferableReport(env: TEnv, f: FieldInfo, why: string, a: CalleeAt, ts: TypeState) -> TypeState {
        if (initBlamed(env, f, ts) || calleeBlamed(env, a, ts)) return ts
        const n: string = f.sym.hint
        return report(ts, env, f.span, "E-DECL-TYPE-NOT-INFERABLE", "`" + n + "` has no `:Type`, and its value is not one a type is inferred from — " + why + ". A type is inferred only from literals, typed `@` references, and arithmetic, comparisons, ternaries and `.length` over those, and calls of functions with a declared (or provable) return (§66.3 rules 5–7). Write the type: `" + n + ":T=…`")
    }

    // Rule 8: a derived cycle is E-DERIVED-CIRCULAR-DEP's (derivedCycles); a
    // cycle through a SEEDED member has no cycle code — the inference reports.
    fn cycleReport(env: TEnv, di: DeclInfo, f: FieldInfo, ns: string[], ts: TypeState) -> TypeState {
        let allDerived = true
        for (const n of ns) {
            const i: int = fieldIndex(di, n)
            if (i < 0) {
                allDerived = false
            } else {
                const m: FieldMode = di.fields[i].mode
                if (m != FieldMode.Derived) allDerived = false
            }
        }
        if (allDerived) return ts
        if (initBlamed(env, f, ts)) return ts
        const n2: string = f.sym.hint
        let path: string[] = []
        for (const x of ns) { path = path.concat(["@" + x]) }
        return report(ts, env, f.span, "E-DECL-TYPE-NOT-INFERABLE", "`" + n2 + "` has no `:Type`, and its value reads itself back through " + path.join(" → ") + " — a type is not inferred around a cycle (§66.3 rule 8). Write the type: `" + n2 + ":T=…`")
    }

    fn boundaryReport(env: TEnv, f: FieldInfo, where: string, ts: TypeState) -> TypeState {
        if (initBlamed(env, f, ts)) return ts
        const n: string = f.sym.hint
        let what: string = "exported, so another file reads its type (required while O2 / O39 is open, §66.14)"
        if (where == "persist") what = "`persist=`, so every stored value is decoded against its type on load (§6.14.1 rule 5)"
        if (where == "server") what = "a `server` cell, so its type is the wire contract (§52.4.1)"
        return report(ts, env, f.span, "E-DECL-TYPE-REQUIRED-AT-BOUNDARY", "`" + n + "` is " + what + " — its value is not a literal, so its type must be written, not inferred: `" + n + ":T=…` (§66.3 rule 9)")
    }

    fn unprovenReport(env: TEnv, f: FieldInfo, why: string, a: CalleeAt, ts: TypeState) -> TypeState {
        if (initBlamed(env, f, ts) || calleeBlamed(env, a, ts)) return ts
        const n: string = f.sym.hint
        return report(ts, env, f.span, "E-DECL-TYPE-UNPROVEN", "`" + n + "` is written with a type, but its value's type cannot be resolved — " + why + " — so nothing checks that the value is one (§66.3 rule 10). Declare what is untyped (the function's `-> T`, a parameter's or a local's type)")
    }

    fn typeFn(env: TEnv, af: AFn, ts: TypeState) -> TypeState {
        let fenv: TEnv = env
        for (const p of af.params) {
            const pf: BindFact | not = bindFact(env.t.binds, p.nid)
            const s: Sym | not = bindSym(pf)
            // an untyped parameter, or one whose type failed to parse, is unproven
            let pvt: VType = VType.Unknown
            const trusted: boolean = paramsTrusted(env.errs, [p]) && env.t.unresolved.params.indexOf(p.nid) < 0
            if (trusted) pvt = paramType(pf)
            if (s is given) {
                fenv = tWithLocal(fenv, s, pvt)
                // s460 (Blame.syms): a WRITTEN type that was refused (Rule C);
                // an unannotated parameter is not blamed — its type is simply
                // unresolved, which is what the condition rule reports (§42.4 5)
                if (!trusted && p.ty is given) fenv = tWithRefused(fenv, s)
            }
        }
        return inferReturn(env, af, typeBlock(withRet(fenv, fnRet(env.t, af)), af.body, ts))
    }

    // s473 (p5 hole 1, g-boot-unannotated-return-type-not-inferred-s473) — §48.8
    // "When a return type annotation is absent: … The compiler infers the return
    // type from the `return` statements. … If `return` statements produce
    // different types, E-FN-007 fires." §48.11: "Returns are the same in every
    // form (S469)" — so `fn` AND `function`. Before this a call of an unannotated
    // function was Unknown, and `@n = f()` put a `string` in an `int` cell with no
    // diagnostic.
    // The join of the typer's own types of every `return <expr>` in the body is
    // CONTRIBUTED under the function's return key (retKey) — the typeProgram
    // fixed point carries it to the next pass's `settled`, where typeCall reads
    // it (a callee typed after its caller settles a pass later). Nothing is
    // contributed — the call stays Unknown, as before — for a written return type
    // (a declared one is FnInfo.ret; `-> void` / a refused one are not inferred),
    // a failable function (no success-type slot, §19.4.1), a body with no value
    // `return` or a bare one (E-RETURN-INCOMPLETE's), or a returned value whose
    // type is not proven (Unknown joins to Unknown — provable-or-silent).
    // Two return sites of different types that join to a NEW choice: a `fn` is
    // E-FN-007 (§48.4.1 / §48.8; the call stays Unknown, so the mismatch is not
    // reported twice); a `function`'s call is that choice (`int | string` reads
    // "one of"), checked at every write as any choice is.
    fn inferReturn(env: TEnv, af: AFn, ts: TypeState) -> TypeState {
        if (af.ret is given || af.failable) return ts
        const s: Sym | not = bindSym(bindFact(env.t.binds, af.nid))
        if (s is not) return ts
        const rs: ReturnSite[] = returnSites(af.body)
        if (rs.length == 0) return ts
        let acc: VType = VType.Unknown
        let first = true
        let fresh = false
        for (const r of rs) {
            const x: AExpr | not = r.e
            if (x is not) return ts
            const vt: VType = exprType0(ts, x.nid)
            if (first) {
                acc = vt
                first = false
            } else {
                const j: VType = joinVT(acc, vt)
                if (oneOfMembers(j).length > 0 && !sameVT(j, acc) && !sameVT(j, vt)) fresh = true
                acc = j
            }
        }
        if (fresh && af.pure) {
            const ms: Type[] = oneOfMembers(acc)
            let names: string[] = []
            let bare: string[] = []
            for (const m of ms) {
                names = names.concat(["`" + typeName(m) + "`"])
                bare = bare.concat([typeName(m)])
            }
            const ts1: TypeState = report(ts, env, af.span, "E-FN-007", "`fn " + af.name + "` returns " + names.join(" and ") + " from different `return` statements, and declares no return type (§48.4.1, §48.8: an unannotated `fn`'s return type is inferred from its returns, and they must agree). Make every `return` carry the same type, or declare the union: `fn " + af.name + "(…) -> " + bare.join(" | ") + "`")
            return contribute(ts1, retKey(s), VType.Unknown)
        }
        return contribute(ts, retKey(s), acc)
    }

    // The settled-table key of a function's INFERRED return (inferReturn): a
    // negative id, so it never meets a local's Sym id (every Sym id is >= 0).
    fn retKey(s: Sym) -> Sym {
        return { id: -1 - s.id, hint: s.hint }
    }

    // The declared return type of a function (`not`: none, or untrusted).
    fn fnRet(t: Tables, af: AFn) -> Type | not {
        const s: Sym | not = bindSym(bindFact(t.binds, af.nid))
        if (s is not) return not
        const fi: FnInfo | not = fnInfoOf(t, s)
        if (fi is not) return not
        return fi.ret
    }

    fn withRet(env: TEnv, r: Type | not) -> TEnv {
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: env.narrowed,
                 fnw: env.fnw, rows: env.rows, fret: r, blame: env.blame }
    }

    // =========================================================================
    // s449 — THE NO-WRITE RULE (SPEC §6.7.4, "The no-write rule —
    // E-EFFECT-WRITES-STATE"): "An effect body SHALL NOT write any reactive
    // cell, directly or through a called function. A write found by the
    // analysis below is E-EFFECT-WRITES-STATE; a body the analysis cannot prove
    // write-free is E-EFFECT-WRITE-UNPROVEN."
    //
    // THE WRITE SUMMARY. "The compiler computes, for every scrml function, a
    // write summary: the set of reactive cells its body may write, closed
    // transitively over the static call graph (a fixed point, so recursion is
    // handled)." Here each function's body is SCANNED once over the binder's
    // facts (BodyScan: its direct writes, the scrml functions it calls or hands
    // on as values, and the call sites nothing resolves), and the EFFECT
    // SUMMARY (summarize, below — dpa-066) closes the scans over those
    // references to a fixed point. What a rule reads from it is a WITNESS — the
    // first call chain down to a write (or to an unresolvable call) — because
    // the message "SHALL name the call chain down to the write".
    //
    // The rules, as the bootstrap meets them:
    //  1. a direct write in the body — any write the binder classified (an
    //     assignment to `@x` or a field / element of it, an edit or removal
    //     call, a spread write, `reset(@x)`, an engine transition) and, by its
    //     shape, a write the binder refused and reported (`@x = …`, `reset(…)`,
    //     `@x.push(…)` with no fact) — is E-EFFECT-WRITES-STATE;
    //  2. a call to a statically resolved scrml function (`function` or `fn`,
    //     same file or imported — the bootstrap links every imported module, so
    //     every body is in the compilation) whose summary is non-empty is
    //     E-EFFECT-WRITES-STATE, naming the chain. (The bootstrap has no server
    //     functions and no §52 cells yet: that limb is vacuous here.)
    //  3. a function VALUE — a scrml function named without being called —
    //     counts as called: its summary is added (the receiver may call it). An
    //     arrow function's body is scanned in place (it can only stand as a
    //     `.filter` / `.map` argument in the bootstrap).
    //  4. a call the analysis cannot resolve fails closed, E-EFFECT-WRITE-
    //     UNPROVEN: a call through a local / parameter / field. (`^{ }` is not
    //     parsed in a bootstrap logic body at all, so it never reaches here.)
    //  5. a host call (`Date.now()`, the closed HostCall set) is outside scrml's
    //     state and is not a write.
    //  +  rule 2's "any call the SPEC defines as writing a cell on the caller's
    //     behalf", the bootstrap's implicit ones — what a READ runs: reading a
    //     user declaration's SHARED instance (`@box`, `@box.k`) constructs it on
    //     first reference (§66.6.4), running its field initializers and
    //     constructing the instances its renders mounts unconditionally; reading
    //     a field with no write capability (a derived cell, or a locked one the
    //     printer builds as `rt.derived`) runs its FORMULA (§6.6). Each such read
    //     refers to a CONSTRUCTION / FORMULA summary (over-approximate: whether a
    //     read is the first is not static). SPEC §6.15: "Each value position is
    //     summarized like a function, so a READ of something that evaluates a
    //     value position carries that position's summary … Under this section
    //     every such summary is empty — that is the point", and "§6.7.4's write
    //     summary still follows reads into formulas and constructions — it now
    //     finds nothing there for a well-formed program, and the check stays as
    //     defence in depth." The value positions themselves are judged at their
    //     source (§6.15, below); a chain through one only ECHOES that report, so
    //     it is dropped when the source-side rule has found a root (effectPass).
    // The message names the fix by shape (S447 1a): a write back to the cell's
    // initializer (or `reset(@x)`) → `reset-on=[…]` on the cell; a write of a
    // call's result → a `<request>`; otherwise → move the write to the writer,
    // or derive the value.
    // =========================================================================
    type FixShape:enum = { ResetFix, RequestFix, OtherFix }
    // A write: the cell (`@x`, `@decl.field`), where, and the fix its shape names.
    type WSite:struct = { cell: string, span: ASpan, file: string, fix: FixShape }
    // A call the analysis cannot resolve, and why.
    type USite:struct = { what: string, span: ASpan, file: string }
    // A scrml function the body calls (`asValue` = false) or hands on as a value.
    type FnRef:struct = { sym: int, name: string, span: ASpan, file: string, asValue: boolean }
    type BodyScan:struct = { writes: WSite[], refs: FnRef[], unproven: USite[] }
    // The first chain (display labels — `f()` — outermost first) down to a
    // write / an unresolvable call: what the summary answers (writeWitness).
    type Witness:struct = { chain: string[], site: WSite }
    type UWitness:struct = { chain: string[], site: USite }
    type WCx:struct = { t: Tables, file: string }

    fn emptyScan() -> BodyScan { return { writes: [], refs: [], unproven: [] } }

    fn addWrite(acc: BodyScan, w: WSite) -> BodyScan {
        return { writes: acc.writes.concat([w]), refs: acc.refs, unproven: acc.unproven }
    }

    fn addRef(acc: BodyScan, r: FnRef) -> BodyScan {
        return { writes: acc.writes, refs: acc.refs.concat([r]), unproven: acc.unproven }
    }

    fn addUnproven(acc: BodyScan, u: USite) -> BodyScan {
        return { writes: acc.writes, refs: acc.refs, unproven: acc.unproven.concat([u]) }
    }

    fn scanBlock(cx: WCx, b: ABlock, acc0: BodyScan) -> BodyScan {
        let acc: BodyScan = acc0
        for (const s of b.stmts) { acc = scanStmt(cx, s, acc) }
        return acc
    }

    fn scanStmt(cx: WCx, s: AStmt, acc: BodyScan) -> BodyScan {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> scanExpr(cx, e, acc)      // scanExpr records the write (stmtWrite), at any depth
            .Local(name: n, init: i) :> scanExpr(cx, i, acc)
            .Return(e: e) :> scanMaybe(cx, e, acc)
            .If(cond: c, thenB: t, elseB: el) :> scanElse(cx, el, scanBlock(cx, t, scanExpr(cx, c, acc)))
            .Given(name: n, subject: sub, body: b) :> scanBlock(cx, b, scanExpr(cx, sub, acc))
            .For(f: lf) :> scanBlock(cx, lf.body, scanExprs(cx, forExprs(lf), acc))
            .Break(label: x) :> acc
            .Continue(label: x) :> acc
            .Lift(what: w) :> scanExprs(cx, liftExprs(w), acc)
            .EffectStmt(w: w) :> acc                // refused where it stands (E-LIFECYCLE-016 / E-BOOTSTRAP-UNSUPPORTED)
            .Defer(body: b) :> scanBlock(cx, b, acc)
            .Fail(f: f) :> scanExprs(cx, failExprs(f), acc)
        }
    }

    fn scanMaybe(cx: WCx, e: AExpr | not, acc: BodyScan) -> BodyScan {
        if (e is not) return acc
        return scanExpr(cx, e, acc)
    }

    fn scanElse(cx: WCx, el: ABlock | not, acc: BodyScan) -> BodyScan {
        if (el is not) return acc
        return scanBlock(cx, el, acc)
    }

    fn scanExprs(cx: WCx, es: AExpr[], acc0: BodyScan) -> BodyScan {
        let acc: BodyScan = acc0
        for (const e of es) { acc = scanExpr(cx, e, acc) }
        return acc
    }

    // Every write, call and function value in `e`, at any depth (an arrow
    // function's body included — rule 3). A write is recorded wherever it
    // stands, not only as a statement: a markup interpolation or an
    // initializer (the source-side rule below) has no statement to stand in,
    // and `${ @xs.push(1) }` is a write all the same.
    fn scanExpr(cx: WCx, e: AExpr, acc0: BodyScan) -> BodyScan {
        const acc1: BodyScan = stmtWrite(cx, e, acc0)
        const c: AExpr | not = calleeOf(e.k)
        if (c is given) return scanExprs(cx, exprKids(e).slice(1), scanCall(cx, e, c, acc1))
        let acc: BodyScan = formulaRef(cx, e, constructionRef(cx, e, fnValueRef(cx, e, acc1)))
        for (const x of exprKids(e)) { acc = scanExpr(cx, x, acc) }
        for (const b of exprBlocks(e)) { acc = scanBlock(cx, b, acc) }      // s451 (Ue): an arm block
        return acc
    }

    // A read of a user declaration's SHARED instance may construct it (see the
    // banner): a reference to that declaration's construction summary.
    fn constructionRef(cx: WCx, e: AExpr, acc: BodyScan) -> BodyScan {
        const d: Sym | not = sharedDeclRead(nameFact(cx.t.names, e.nid))
        if (d is not) return acc
        if (d.id == cx.t.program.id) return acc       // the program is constructed at boot, never by a read
        for (const r of acc.refs) {
            if (r.sym == d.id) return acc             // `@box.k` resolves `@box` too: one reference per body
        }
        return addRef(acc, { sym: d.id, name: constructionLabel(d.hint), span: e.span, file: cx.file, asValue: false })
    }

    // s449 fix round (HIGH-1) — a read of a field with NO write capability (a
    // derived cell, or a locked one whose initializer the printer turns into a
    // `rt.derived` — print `fieldCtor`) RUNS ITS FORMULA on the read (lazy pull,
    // §6.6): a reference to that formula's summary. Program-level cells
    // included — `constructionRef` skips the program because it is built at
    // boot, but a derived program cell is still recomputed at its read.
    // Reviewer-measured: `<d:int=(@n + g())/>` read in an effect wrote `@a`.
    fn formulaRef(cx: WCx, e: AExpr, acc: BodyScan) -> BodyScan {
        const fi: FieldInfo | not = formulaFieldRead(cx.t, nameFact(cx.t.names, e.nid))
        if (fi is not) return acc
        for (const r of acc.refs) {
            if (r.sym == fi.sym.id) return acc            // one reference per body
        }
        return addRef(acc, { sym: fi.sym.id, name: formulaLabel(cx.t, fi), span: e.span, file: cx.file, asValue: false })
    }

    fn formulaFieldRead(t: Tables, f: NameFact | not) -> FieldInfo | not {
        const df: DeclField | not = readField(f)
        if (df is not) return not
        const di: DeclInfo | not = declInfo(t, df.decl)
        if (di is not || df.idx < 0 || df.idx >= di.fields.length) return not
        const fi: FieldInfo = di.fields[df.idx]
        const w: Sym | not = fi.wcap
        if (w is given) return not                        // a cell: seeded once, at construction
        return fi
    }

    type DeclField:struct = { decl: Sym, idx: int }

    fn mkDeclField(d: Sym, i: int) -> DeclField { return { decl: d, idx: i } }

    fn readField(f: NameFact | not) -> DeclField | not {
        return match f {
            .NField(decl: d, inst: i, idx: x) :> mkDeclField(d, x)
            .NInst(decl: d) :> not
            .NLocal(sym: s) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            .NConst(sym: s) :> not
            not :> not
        }
    }

    fn formulaLabel(t: Tables, fi: FieldInfo) -> string {
        for (const d of t.decls) {
            for (const f of d.fields) {
                if (f.sym.id == fi.sym.id) {
                    if (d.kind == DeclKind.Program) return "formula of @" + fi.sym.hint
                    return "formula of @" + d.sym.hint + "." + fi.sym.hint
                }
            }
        }
        return "formula of @" + fi.sym.hint
    }

    fn sharedDeclRead(f: NameFact | not) -> Sym | not {
        return match f {
            .NField(decl: d, inst: i) :> sharedOf(i)
            .NInst(decl: d, inst: i) :> sharedOf(i)
            .NLocal(sym: s) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: v) :> sharedOf(validityInst(v))
            .NConst(sym: s) :> not
            not :> not
        }
    }

    fn sharedOf(i: InstRef) -> Sym | not {
        return match i {
            .Shared(decl: d) :> d
            .Lexical(depth: n) :> not
            .Alias(sym: s) :> not
            .Narrowed(sym: s) :> not
            .Kid(of: o) :> sharedOf(o)
            .HandleOf(of: o) :> sharedOf(o)
        }
    }

    fn constructionLabel(name: string) -> string { return "construction of <" + name + ">" }

    fn scanCall(cx: WCx, e: AExpr, callee: AExpr, acc: BodyScan) -> BodyScan {
        // an edit / removal / `reset` call is a WRITE, recorded at its statement
        // (stmtWrite); its receiver is only read
        if (effectFact(cx.t.effects, e.nid) is given || exprName(callee) == "reset" || isEditCallee(callee)) return scanExprs(cx, receiverOf(callee), acc)
        // a host call (`Date.now()`) or a sequence call (`xs.filter(λ)`): the
        // receiver is read; the arrow function is an argument (scanned by the caller)
        if (isHostOrSeq(valueFact(cx.t.values, e.nid))) return scanExprs(cx, receiverOf(callee), acc)
        const f: NameFact | not = nameFact(cx.t.names, callee.nid)
        const s: Sym | not = fnSymOf(f)
        if (s is given) return addRef(acc, { sym: s.id, name: s.hint + "()", span: e.span, file: cx.file, asValue: false })
        // A callee name with no fact was already reported (E-SCOPE-001), and any
        // other callee shape is refused by the binder — only a NAME that resolves
        // to something other than a function reaches here: a local, a parameter,
        // a field. Rule 4: fail closed.
        if (f is given && exprName(callee) != "") {
            return addUnproven(acc, { what: "`" + exprName(callee) + "(…)` calls through `" + exprName(callee) + "`, which is " + calleeKind(f) + ", not a declared scrml function", span: e.span, file: cx.file })
        }
        return scanExprs(cx, receiverOf(callee), acc)
    }

    // Rule 3: a scrml function NAMED without being called.
    fn fnValueRef(cx: WCx, e: AExpr, acc: BodyScan) -> BodyScan {
        if (exprName(e) == "") return acc
        const s: Sym | not = fnSymOf(nameFact(cx.t.names, e.nid))
        if (s is not) return acc
        return addRef(acc, { sym: s.id, name: s.hint, span: e.span, file: cx.file, asValue: true })
    }

    fn fnSymOf(f: NameFact | not) -> Sym | not {
        return match f {
            .NFn(sym: s) :> s
            .NLocal(sym: s) :> not
            .NField(decl: d) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            .NConst(sym: s) :> not
            not :> not
        }
    }

    fn calleeKind(f: NameFact) -> string {
        return match f {
            .NLocal(sym: s) :> "a local or a parameter (a function value the compiler cannot resolve to a known set of scrml functions)"
            .NField(decl: d) :> "a cell"
            .NInst(decl: d) :> "an instance"
            .NStruct(owner: o) :> "a struct field"
            .NLength :> "a length"
            .NSurface(of: x) :> "a validity surface"
            .NConst(sym: s) :> "a file-scope constant"
            .NFn(sym: s) :> "a function"
        }
    }

    fn isHostOrSeq(v: ValueFact | not) -> boolean {
        return match v {
            .VHost(call: c) :> true
            .VSeqCall(op: o) :> true
            .VLit(lit: l) :> false
            .VVariant(enumSym: s) :> false
            .VOp(op: o) :> false
            .VStructOf(ty: t) :> false
            .VConstruct(enumSym: t) :> false
            .VLambda(params: ps) :> false
            .VIndex(loc: x) :> false
            .VAt :> true
            .VTemplate(text: tx) :> false
            .VToEnum(enumSym: s) :> true
            .VMethod(op: o) :> true
            not :> false
        }
    }

    // `@x.push(…)` / `.unshift` / `.pop` / `.shift` on a reactive place — an edit
    // or removal by its method (§66.11.2), whether or not the binder accepted it.
    fn isEditCallee(callee: AExpr) -> boolean {
        const k: AExprK = callee.k
        const n: string = memberName(k)
        if (n != "append" && n != "prepend" && n != "push" && n != "unshift" && n != "pop" && n != "shift") return false
        const r: AExpr[] = receiverOf(callee)
        if (r.length == 0) return false
        return isReactiveRoot(placeRoot(r[0]))
    }

    fn memberName(k: AExprK) -> string {
        return match k {
            .Member(obj: o, name: n) :> n
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: o) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // The receiver of a member callee (`xs` of `xs.filter`), else nothing.
    fn receiverOf(callee: AExpr) -> AExpr[] {
        const k: AExprK = callee.k
        return match k {
            .Member(obj: o) :> [o]
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Index(obj: o) :> []
            .Lambda(params: ps) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    // The base of a place expression: `@x` → "@x", `@.` → "@.", a name → the
    // name, anything else → "".
    fn placeRoot(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> "@" + n
            .AtItem :> "@."
            .Name(name: n) :> n
            .Member(obj: o) :> placeRoot(o)
            .Index(obj: o) :> placeRoot(o)
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    fn isReactiveRoot(root: string) -> boolean { return root.indexOf("@") == 0 }

    // Rule 1 at a statement: the write the binder classified, else a write by
    // its shape that the binder refused (and reported) — still a write.
    fn stmtWrite(cx: WCx, e: AExpr, acc: BodyScan) -> BodyScan {
        const f: EffectFact | not = effectFact(cx.t.effects, e.nid)
        const cap: Sym | not = writtenCap(f)
        if (cap is given) return addWrite(acc, { cell: cellLabel(cx.t, cap), span: e.span, file: cx.file, fix: factFix(cx.t, e, f, cap) })
        const syn: string = syntacticWrite(e)
        if (syn != "") return addWrite(acc, { cell: syn, span: e.span, file: cx.file, fix: shapeFix(e, "") })
        return acc
    }

    // The capability a reactive write uses (`not` for a local rebinding / no write).
    fn writtenCap(f: EffectFact | not) -> Sym | not {
        return match f {
            .EWrite(w: w) :> w.cap
            .ESpread(ws: ws) :> firstSpreadCap(ws)
            .EReset(w: w) :> w.cap
            .EEdits(w: w) :> w.cap
            .ERemove(w: w) :> w.cap
            .EElemAt(cap: c) :> c
            .EPosition(cap: c) :> c
            .EAssignLocal(sym: s) :> not
            not :> not
        }
    }

    fn firstSpreadCap(ws: SpreadWrite[]) -> Sym | not {
        if (ws.length == 0) return not
        return ws[0].w.cap
    }

    fn isResetFact(f: EffectFact | not) -> boolean {
        return match f {
            .EReset(w: w) :> true
            .EWrite(w: w) :> false
            .ESpread(ws: ws) :> false
            .EEdits(w: w) :> false
            .ERemove(w: w) :> false
            .EElemAt(cap: c) :> false
            .EPosition(cap: c) :> false
            .EAssignLocal(sym: s) :> false
            not :> false
        }
    }

    // The cell a capability writes, as the author spells it: `@x` for a program
    // cell, `@decl.field` for a declaration's field.
    fn cellLabel(t: Tables, cap: Sym) -> string {
        for (const d of t.decls) {
            for (const f of d.fields) {
                const w: Sym | not = f.wcap
                if (w is given && w.id == cap.id) {
                    if (d.kind == DeclKind.Program) return "@" + f.sym.hint
                    return "@" + d.sym.hint + "." + f.sym.hint
                }
            }
        }
        return "`" + cap.hint + "`"
    }

    fn factFix(t: Tables, e: AExpr, f: EffectFact | not, cap: Sym) -> FixShape {
        if (isResetFact(f)) return FixShape.ResetFix
        let init: string = ""
        const fi: FieldInfo | not = fieldOfCap(t, cap)
        if (fi is given) init = initKey(fi.init)
        return shapeFix(e, init)
    }

    // The fix a write's SHAPE names: `reset(…)` or a write of the cell's own
    // initializer literal → reset-on=; a write of a call's result → <request>;
    // otherwise → move / derive.
    fn shapeFix(e: AExpr, init: string) -> FixShape {
        if (exprName(callTarget(e)) == "reset") return FixShape.ResetFix
        const v: AExpr | not = assignedValue(e)
        if (v is not) return FixShape.OtherFix
        if (calleeOf(v.k) is given) return FixShape.RequestFix
        if (init != "" && litKey(v) == init) return FixShape.ResetFix
        return FixShape.OtherFix
    }

    fn callTarget(e: AExpr) -> AExpr {
        const c: AExpr | not = calleeOf(e.k)
        if (c is given) return c
        return e
    }

    fn assignedValue(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> v
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    fn assignedTarget(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> t
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    // A literal's identity ("" — not a literal), to compare a written value
    // with a cell's initializer.
    fn litKey(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> "n:" + r
            .Str(v: s) :> "s:" + s
            .Bool(v: b) :> litBoolKey(b)
            .NotLit :> "not"
            .Variant(name: n) :> "v:" + n
            .Unary(op: o, e: x) :> negKey(o, x)
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Recovered :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: o) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    fn litBoolKey(b: boolean) -> string {
        if (b) return "b:true"
        return "b:false"
    }

    fn negKey(o: UnOp, x: AExpr) -> string {
        if (o != UnOp.Neg) return ""
        const inner: string = litKey(x)
        if (inner.indexOf("n:") != 0) return ""
        return "n:-" + inner.substring(2)
    }

    fn initKey(v: AAttrValue) -> string {
        return match v {
            .Bare(e: e) :> litKey(e)
            .Paren(e: e) :> litKey(e)
            .Quoted(v: s) :> "s:" + s
            .NoValue :> ""
            .Braced(b: b) :> ""
        }
    }

    // A write by its SHAPE alone (the cell it names, "" — not a write):
    // `@x… = v`, `reset(@x…)`, `@x….push(v)` and the other edit / removal calls.
    fn syntacticWrite(e: AExpr) -> string {
        const t: AExpr | not = assignedTarget(e)
        if (t is given) {
            const root: string = placeRoot(t)
            if (isReactiveRoot(root)) return root
            return ""
        }
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return ""
        if (exprName(c) == "reset") {
            const args: AExpr[] = exprKids(e).slice(1)
            if (args.length == 1 && isReactiveRoot(placeRoot(args[0]))) return placeRoot(args[0])
            return ""
        }
        if (isEditCallee(c)) return placeRoot(receiverOf(c)[0])
        return ""
    }

    // ---- the scans the summary closes: one per function (scanBlock), one per
    // user declaration (its CONSTRUCTION) and one per formula (a field computed
    // on its read) — see the banner; summarize builds them.

    // What constructing a declaration's instance runs: every field initializer
    // (the declared defaults — a use-site value is evaluated where the use
    // renders, not by a read), and the construction of each declaration its
    // renders uses (L12 (b) builds the unconditional ones with it; every use is
    // counted — over-approximate).
    fn constructionScan(t: Tables, ds: DeclSrc) -> BodyScan {
        const cx: WCx = { t: t, file: ds.file }
        let acc: BodyScan = emptyScan()
        for (const f of ds.info.fields) { acc = scanValue(cx, f.init, acc) }
        const d: ADecl | not = ds.d
        if (d is given) {
            const r: AElem | not = d.renders
            if (r is given) acc = usedDecls(cx, r.kids, acc)
        }
        return acc
    }

    fn scanValue(cx: WCx, v: AAttrValue, acc: BodyScan) -> BodyScan {
        return match v {
            .Bare(e: e) :> scanExpr(cx, e, acc)
            .Paren(e: e) :> scanExpr(cx, e, acc)
            .Braced(b: b) :> scanBlock(cx, b, acc)
            .Quoted(v: s) :> acc
            .NoValue :> acc
        }
    }

    fn usedDecls(cx: WCx, ns: ANode[], acc0: BodyScan) -> BodyScan {
        let acc: BodyScan = acc0
        for (const n of ns) {
            const e: AElem | not = elemOfNode(n.k)
            if (e is given) {
                const used: Sym | not = useOf(elemFact(cx.t.elems, e.nid))
                if (used is given) acc = addRef(acc, { sym: used.id, name: constructionLabel(used.hint), span: e.span, file: cx.file, asValue: false })
                acc = usedDecls(cx, e.kids, acc)
            }
        }
        return acc
    }

    fn useOf(f: ElemFact | not) -> Sym | not {
        return match f {
            .MUse(decl: d) :> d
            .MStar(decl: d) :> d
            .MHtml :> not
            .MEach(bind: b) :> not
            .MSlot :> not
            .MDb :> not
            .MErrors(of: x) :> not
            .MStateView(v: v) :> not
            .MInline(v: v) :> not
            not :> not
        }
    }

    // ---- the queries: the first write / unresolvable call callable `i` reaches
    // (its first atom in the summary's `writes` / `writesOpen`; dpa-066 M1).
    fn writeWitness(s: Summary, i: int) -> Witness | not {
        const a: FxAtom | not = witnessOf(s.writes[i])
        if (a is not) return not
        return { chain: fxChain(s, s.writes, i, a), site: s.nodes[a.root].f.scan.writes[a.pos] }
    }

    fn openWitness(s: Summary, i: int) -> UWitness | not {
        const a: FxAtom | not = witnessOf(s.writesOpen[i])
        if (a is not) return not
        return { chain: fxChain(s, s.writesOpen, i, a), site: s.nodes[a.root].f.scan.unproven[a.pos] }
    }

    // ---- the pass: every accepted effect's body against the summaries ---------
    // (and every value position — §6.15, valueDiags)
    fn effectPass(g: Globals, t: Tables, effects: EffectSrc[], sum: Summary) -> Diag[] {
        const ps: ValuePos[] = valuePositions(g, t)
        let scans: BodyScan[] = []
        for (const p of ps) { scans = scans.concat([scanValue({ t: t, file: p.file }, p.v, emptyScan())]) }
        // The ROOTS: each value position's own writes / write chains (not
        // through another value position). They come first — each is the cause
        // of whatever a reader of that value would report. When there is a
        // root, a chain through a formula / construction is its ECHO and is
        // dropped (`quiet`); when there is none, such a chain means the
        // source-side rule missed a position, and it is reported — the
        // defence in depth §6.15 keeps.
        let roots: Diag[] = []
        let echoes: Diag[] = []
        let i: int = 0
        for (const p of ps) {
            roots = roots.concat(valueDiags(p, scans[i], sum, true))
            echoes = echoes.concat(valueDiags(p, scans[i], sum, false))
            i = i + 1
        }
        const quiet: boolean = roots.length > 0
        let out: Diag[] = roots
        if (!quiet) out = echoes
        for (const es of effects) {
            const scan: BodyScan = scanBlock({ t: t, file: es.file }, es.w.body, emptyScan())
            for (const w of scan.writes) { out = out.concat([writesDirect(es.w, w)]) }
            for (const r of scan.refs) { out = out.concat(refDiags(es.w, r, sum, quiet)) }
            for (const u of scan.unproven) { out = out.concat([unprovenDirect(u)]) }
        }
        return out
    }

    // A chain that runs through a value position (a formula / a construction)
    // — the echo of that position's own report (§6.15).
    fn throughValue(r: FnRef, chain: string[]) -> boolean {
        if (isValueLabel(r.name)) return true
        for (const l of chain) {
            if (isValueLabel(l)) return true
        }
        return false
    }

    fn isValueLabel(l: string) -> boolean {
        return l.indexOf("formula of ") == 0 || l.indexOf("construction of ") == 0
    }

    fn refDiags(w: AEffect, r: FnRef, s: Summary, quiet: boolean) -> Diag[] {
        // fix round (LOW a): a reference with no summary is unresolved — fail closed
        const i: int = nodeIdx(s.nodes, r.sym)
        if (i < 0) return [newDiag("E-EFFECT-WRITE-UNPROVEN", "this effect reaches `" + r.name + "`, which has no write summary — the compiler cannot prove it writes no reactive cell, and the rule fails closed (§6.7.4 rule 4)", r.file, r.span)]
        const sw: Witness | not = writeWitness(s, i)
        if (sw is given) {
            if (quiet && throughValue(r, sw.chain)) return []
            return [writesThrough(w, r, sw)]
        }
        const su: UWitness | not = openWitness(s, i)
        if (su is given) {
            if (quiet && throughValue(r, su.chain)) return []
            return [unprovenThrough(r, su)]
        }
        return []
    }

    fn effectWord(w: AEffect) -> string {
        if (w.keyword) return "this `when … changes` effect"
        return "this `<effect>`"
    }

    fn writesDirect(w: AEffect, site: WSite) -> Diag {
        const msg: string = effectWord(w) + " writes `" + site.cell + "`. An effect drives the outside world and may not write reactive state, directly or through a called function (§6.7.4). " + fixText(w, site)
        return newDiag("E-EFFECT-WRITES-STATE", msg, site.file, site.span)
    }

    fn writesThrough(w: AEffect, r: FnRef, wit: Witness) -> Diag {
        const chain: string = chainText(wit.chain) + " → " + wit.site.cell
        let how: string = " writes `" + wit.site.cell + "` through a call: `" + chain + "`"
        if (r.asValue) how = " hands `" + r.name.replace("()", "") + "` on as a function value — whatever receives it may call it (§6.7.4 rule 3) — and it writes `" + wit.site.cell + "`: `" + chain + "`"
        if (r.name.indexOf("formula of ") == 0) how = " reads a value computed on its read — its formula runs inside the effect and writes `" + wit.site.cell + "`: `" + chain + "`"
        if (r.name.indexOf("construction of ") == 0) how = " reads a shared instance that its first read CONSTRUCTS, running initializers that write `" + wit.site.cell + "`: `" + chain + "`"
        const msg: string = effectWord(w) + how + ". An effect drives the outside world and may not write reactive state, directly or through a called function (§6.7.4). " + fixText(w, wit.site)
        return newDiag("E-EFFECT-WRITES-STATE", msg, r.file, r.span)
    }

    fn unprovenDirect(u: USite) -> Diag {
        const msg: string = u.what + " — the compiler cannot prove this effect writes no reactive cell, and the rule fails closed (§6.7.4 rule 4). Call a declared scrml function by its name"
        return newDiag("E-EFFECT-WRITE-UNPROVEN", msg, u.file, u.span)
    }

    fn unprovenThrough(r: FnRef, wit: UWitness) -> Diag {
        const msg: string = "this effect reaches a call the compiler cannot resolve, through `" + chainText(wit.chain) + "`: " + wit.site.what + " — it cannot prove the effect writes no reactive cell, and the rule fails closed (§6.7.4 rule 4)"
        return newDiag("E-EFFECT-WRITE-UNPROVEN", msg, r.file, r.span)
    }

    fn chainText(labels: string[]) -> string {
        return labels.join(" → ")
    }

    // The fix the message names, by the write's shape (S447 1a).
    fn fixText(w: AEffect, site: WSite) -> string {
        const f: FixShape = site.fix
        return match f {
            .ResetFix :> "To reset `" + site.cell + "` when this effect's dependencies change, declare it on the cell: `reset-on=[" + depNames(w).join(", ") + "]` (§6.8.4)."
            .RequestFix :> "A call result that must land in state is a `<request>`'s job — it owns the result, loading and errors (§6.7.7)."
            .OtherFix :> "Move the write into the code that writes the trigger (the handler or function), or derive the value (§6.6)."
        }
    }

    fn depNames(w: AEffect) -> string[] {
        let out: string[] = []
        for (const d of w.deps) {
            const n: string = atName(d)
            if (n != "") out = out.concat(["@" + n])
        }
        return out
    }

    // =========================================================================
    // s449 — VALUE POSITIONS DO NOT WRITE REACTIVE STATE (SPEC §6.15; bryan,
    // S449, user-voice-scrml.md §S449 item 3). "Evaluating a **value position**
    // SHALL NOT write any reactive cell, directly or through a called function.
    // A write found by the analysis below is **E-VALUE-WRITES-STATE**; a value
    // position the analysis cannot prove write-free is **E-VALUE-WRITE-UNPROVEN**.
    // Both are compile errors."
    //
    // The value positions (§6.15's list), as the bootstrap has them:
    //   1. an initializer — a program cell's own value, a user declaration's own
    //      value, every attribute-field default and child-field initializer (at
    //      any depth), and a use-site construction value (§66.9 rule 8). (§6.8.1
    //      `default=` is not in the bootstrap: an unknown opener word, refused.)
    //   2. a derived formula — a locked initializer that reads cells (§66.9
    //      rule 3; a call counts as a read, as `valueReads` decides the mode).
    //   3. a render expression — a markup interpolation, and every markup
    //      attribute value (`class=`, `title=`, `if=`, `show=`, `<each in=…>` /
    //      `key=`, …), in the program body, a `renders` and a state-child body.
    //      (A multi-statement `${ }`, a Tier-0 `for … lift`, a display-text
    //      interpolation and `<match on=>` are not in the bootstrap.)
    // NOT value positions (§6.15): an event-handler attribute (`on*=`) and a
    // `bind:` binding (action positions), a function body (judged where it is
    // called), an `<effect>` body (§6.7.4 — the walk skips it; `<request>`,
    // `<onMount>`, `<timer>`, engine `effect=` / `<onTransition>` are not in the
    // bootstrap), and a `${ }` at the program body top — in the bootstrap a
    // logic block of items, never an interpolation, so never reached here.
    // An `as=` value is a name the attribute binds, not an expression evaluated.
    //
    // Each position is scanned with the effect rule's scanValue and judged
    // against the SAME write summaries (§6.15: "one summary shared by every
    // rule that uses it"). The message names the position, the written cell,
    // the call chain and the fix by shape (§6.15 "The message names the
    // position and the fix").
    // =========================================================================
    fn valueWritesCode() -> string { return "E-VALUE-WRITES-STATE" }
    fn valueUnprovenCode() -> string { return "E-VALUE-WRITE-UNPROVEN" }

    // Which of §6.15's three kinds a position is — it picks the fix text.
    type ValueKind:enum = { InitKind, FormulaKind, RenderKind }
    // A value position: what it is (for the message), its kind, its value, where.
    type ValuePos:struct = { what: string, vk: ValueKind, v: AAttrValue, span: ASpan, file: string }

    fn valuePositions(g: Globals, t: Tables) -> ValuePos[] {
        let out: ValuePos[] = []
        for (const ds of g.decls) {
            const p: AProgram | not = ds.p
            const d: ADecl | not = ds.d
            if (p is given) {
                for (const fd of fieldDecls(ds)) { out = out.concat(declInits(fd, "@" + fd.name, ds.file)) }
            } else if (d is given) {
                out = out.concat(declInits(d, "@" + d.name, ds.file))
            }
            for (const n of declMarkup(ds)) { out = out.concat(nodePositions(t, n, ds.file)) }
        }
        return out
    }

    // A declaration's own value, its attribute fields' defaults and its child
    // fields' initializers (at any depth); `path` is the cell as the author
    // spells it (`@x`, `@box.k`).
    fn declInits(d: ADecl, path: string, file: string) -> ValuePos[] {
        let out: ValuePos[] = []
        if (computedValue(d.own)) out = out.concat([initPos(d.isLet, d.own, path, d.span, file)])
        for (const a of d.attrs) {
            if (computedValue(a.dflt)) out = out.concat([initPos(a.isLet, a.dflt, path + "." + a.name, a.span, file)])
        }
        for (const c of childFields(d.body)) { out = out.concat(declInits(c, path + "." + c.name, file)) }
        return out
    }

    // A value with something to evaluate (a quoted string is a literal).
    fn computedValue(v: AAttrValue) -> boolean {
        return match v {
            .Bare(e: e) :> true
            .Paren(e: e) :> true
            .Braced(b: b) :> true
            .Quoted(v: s) :> false
            .NoValue :> false
        }
    }

    // A locked initializer that reads cells is a derived FORMULA (§66.9 rule 3);
    // anything else is an initializer (a `let` seed, a locked constant).
    fn initPos(isLet: boolean, v: AAttrValue, path: string, span: ASpan, file: string) -> ValuePos {
        if (!isLet && valueReads(v).length > 0) return { what: "the formula of derived `" + path + "`", vk: ValueKind.FormulaKind, v: v, span: span, file: file }
        return { what: "the initializer of `" + path + "`", vk: ValueKind.InitKind, v: v, span: span, file: file }
    }

    fn nodePositions(t: Tables, n: ANode, file: string) -> ValuePos[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> elemPositions(t, e, file)
            .Interp(e: x) :> [interpPos(x, n.span, file)]
            .Text(text: s) :> []
            .DeclNode(d: d) :> []          // refused where it stands
            .Css(c: c) :> []
            .Effect(w: w) :> []            // a lifecycle body — the effect rule's (§6.7.4), not a value position
            .Gather(f: lf) :> tier0Positions(t, lf, n.span, file)
        }
    }

    // s469 — a Tier-0 `${ for … lift … }` is a render expression (§6.15 item 3:
    // "including … a Tier-0 `${ for … lift … }` block (§17.4)"): its loop —
    // head, body and lifted values — and every render position of its rows.
    fn tier0Positions(t: Tables, f: AFor, span: ASpan, file: string) -> ValuePos[] {
        const loop: ABlock = { nid: -1, span: f.span, stmts: [forAsStmt(f)] }
        let out: ValuePos[] = [{ what: "the `" + "$" + "{ for … }` loop", vk: ValueKind.RenderKind, v: AAttrValue.Braced(loop), span: span, file: file }]
        for (const r of gatherRows(f)) { out = out.concat(nodePositions(t, r, file)) }
        return out
    }

    fn interpPos(x: AExpr, span: ASpan, file: string) -> ValuePos {
        return { what: "the interpolation", vk: ValueKind.RenderKind, v: AAttrValue.Bare(x), span: span, file: file }
    }

    fn elemPositions(t: Tables, e: AElem, file: string) -> ValuePos[] {
        let out: ValuePos[] = []
        for (const a of e.attrs) {
            if (isValueAttr(a.name) && computedValue(a.value)) out = out.concat([attrPos(attrFact(t.attrs, a.nid), e.tag, a, file)])
        }
        for (const k of e.kids) { out = out.concat(nodePositions(t, k, file)) }
        return out
    }

    // A markup attribute whose value is evaluated: every one but an event
    // handler and a `bind:` (action positions, §6.15) and `as=` (a name it
    // binds). Decided by the NAME, not the binder's fact, so an attribute the
    // binder refused is still judged (fail closed).
    fn isValueAttr(name: string) -> boolean {
        if (eventName(name) != "") return false
        if (name.substring(0, 5) == "bind:") return false
        return name != "as"
    }

    fn attrPos(k: AttrKind | not, tag: string, a: AAttr, file: string) -> ValuePos {
        const named: string = "the `" + a.name + "=` value on `<" + tag + ">`"
        const what: string = match k {
            .AIf :> "the `if=` condition on `<" + tag + ">`"
            .AShow :> "the `show=` condition on `<" + tag + ">`"
            .AConstruct(field: i) :> "the use-site value `" + a.name + "=` of `<" + tag + ">`"
            .AEachIn :> "the `<each in=…>` sequence"
            .AEachKey :> "the `<each key=…>` key"
            .AStatic :> named
            .ABound :> named
            .AOn(event: ev) :> named
            .AAs :> named
            .AEachAs :> named
            .ABind(kind: b) :> named
            not :> named
        }
        // a use-site construction value is an initializer of the instance's
        // field (§6.15 list item 1, §66.9 rule 8)
        let vk: ValueKind = ValueKind.RenderKind
        if (isConstructAttr(k)) vk = ValueKind.InitKind
        return { what: what, vk: vk, v: a.value, span: a.span, file: file }
    }

    fn isConstructAttr(k: AttrKind | not) -> boolean {
        return match k {
            .AConstruct(field: i) :> true
            .AIf :> false
            .AShow :> false
            .AEachIn :> false
            .AEachKey :> false
            .AStatic :> false
            .ABound :> false
            .AOn(event: ev) :> false
            .AAs :> false
            .AEachAs :> false
            .ABind(kind: b) :> false
            not :> false
        }
    }

    // Every write / write chain / unresolvable call a position's scan reaches.
    // `rootsOnly`: leave out a chain through another value position (a
    // formula / a construction) — its echo (see effectPass).
    fn valueDiags(p: ValuePos, scan: BodyScan, sum: Summary, rootsOnly: boolean) -> Diag[] {
        let out: Diag[] = []
        for (const w of scan.writes) { out = out.concat([valueWrites(p, "writes `" + w.cell + "`", w.span, w.file)]) }
        for (const r of scan.refs) { out = out.concat(valueRefDiags(p, r, sum, rootsOnly)) }
        for (const u of scan.unproven) { out = out.concat([valueUnproven(p, u.what, u.span, u.file)]) }
        return out
    }

    fn valueRefDiags(p: ValuePos, r: FnRef, s: Summary, rootsOnly: boolean) -> Diag[] {
        const i: int = nodeIdx(s.nodes, r.sym)
        if (i < 0) return [valueUnproven(p, "it reaches `" + r.name + "`, which has no write summary", r.span, r.file)]
        const sw: Witness | not = writeWitness(s, i)
        if (sw is given) {
            if (rootsOnly && throughValue(r, sw.chain)) return []
            const chain: string = chainText(sw.chain) + " → " + sw.site.cell
            let how: string = "writes `" + sw.site.cell + "` through a call: `" + chain + "`"
            if (r.asValue) how = "hands `" + r.name + "` on as a function value — whatever receives it may call it during the evaluation (§6.7.4 rule 3) — and it writes `" + sw.site.cell + "`: `" + chain + "`"
            if (isValueLabel(r.name)) how = "reads a value whose evaluation writes `" + sw.site.cell + "`: `" + chain + "`"
            return [valueWrites(p, how, r.span, r.file)]
        }
        const su: UWitness | not = openWitness(s, i)
        if (su is given) {
            if (rootsOnly && throughValue(r, su.chain)) return []
            return [valueUnproven(p, "it reaches a call the compiler cannot resolve, through `" + chainText(su.chain) + "`: " + su.site.what, r.span, r.file)]
        }
        return []
    }

    // The fix by shape (§6.15, verbatim).
    fn valueFix(vk: ValueKind) -> string {
        return match vk {
            .InitKind :> "an initializer computes the cell's starting value and may not change other cells; load with a `<request>` (§6.7.7), prepare the outside world in an `<onMount>` (§6.7.1a), or move the write into the handler that should cause it"
            .FormulaKind :> "a derived value is computed from other cells and may not change them; derive the other value too (§6.6), or move the write into the handler that writes the formula's inputs"
            .RenderKind :> "rendering shows state and may not change it; move the write into a handler, or derive the displayed value (§6.6)"
        }
    }

    fn valueWrites(p: ValuePos, how: string, span: ASpan, file: string) -> Diag {
        const msg: string = p.what + " " + how + ". A value position may not write reactive state, directly or through a called function (§6.15): " + valueFix(p.vk) + "."
        return newDiag(valueWritesCode(), msg, file, span)
    }

    fn valueUnproven(p: ValuePos, why: string, span: ASpan, file: string) -> Diag {
        const msg: string = p.what + ": " + why + " — the compiler cannot prove it writes no reactive cell, and a value position fails closed (§6.15). Call a declared scrml function by its name."
        return newDiag(valueUnprovenCode(), msg, file, span)
    }

    // =========================================================================
    // s449 — `reset-on=[@a, @b]` (SPEC §6.8.4): "When any listed cell changes
    // … the runtime SHALL perform `reset(@self)`". The static rules — "Rules 2,
    // 3, 5 and 6 are compile-time errors; none of them is deferred to run time":
    //   2  every entry "a declared, mutable, non-derived reactive cell in scope
    //      at the declaration" (an empty list too) — E-RESET-ON-INVALID-ENTRY;
    //   3  the entry → reset-cell graph is acyclic ("including a cell listing
    //      itself") — E-RESET-ON-CYCLE, naming the cells on the cycle;
    //   5  the cell's contract admits the reset write (`reset(@x)` is a replace)
    //      — a locked or derived cell is E-RESET-ON-NOT-WRITABLE;
    //   6  on a cell with a `rule=` graph, "Every state other than the target
    //      itself SHALL admit the target in its `rule=`" — else
    //      E-RESET-ON-ENGINE-REFUSED naming every refusing state and the target;
    //      a non-literal target means every variant is a target (fail closed).
    // The bootstrap reads `reset-on=` on PROGRAM cells (a field of a user
    // declaration is refused — per-instance resets are OPEN, openerWordDiags).
    // A rule that passes is a ResetOnInfo; `rank` orders a chain (rule 4).
    // =========================================================================
    type RResets:struct = { infos: ResetOnInfo[], st: AS }
    type ResetEdge:struct = { target: int, triggers: int[], span: ASpan }

    fn resetOnPass(g: Globals, st0: AS) -> RResets {
        let st: AS = st0
        const prog: DeclSrc | not = findDeclSrc(g, g.program)
        if (prog is not) return { infos: [], st: st }
        const p: AProgram | not = prog.p
        if (p is not) return { infos: [], st: st }
        let edges: ResetEdge[] = []
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (!isNestedUserDecl(d)) {
                    for (const a of d.mods) {
                        if (a.name == "reset-on") {
                            const r: RResetEdge = resetEdgeOf(g, prog, d, a, st)
                            st = r.st
                            const e: ResetEdge | not = r.e
                            if (e is given) edges = edges.concat([e])
                        }
                    }
                }
            }
        }
        // rule 3 — an edge on a cycle is refused (reported once per cycle)
        let onCycle: int[] = []
        for (const e of edges) {
            if (onCycle.indexOf(e.target) < 0) {
                const cyc: int[] = cycleFrom(edges, e.target, e.target, [])
                if (cyc.length > 0) {
                    st = addDiag(st, prog.file, e.span, "E-RESET-ON-CYCLE", "the `reset-on=` rules form a cycle: " + cycleText(prog.info, cyc) + " — a reset chain must end; drop one of these entries (§6.8.4 rule 3)")
                    onCycle = onCycle.concat(cyc)
                }
            }
        }
        let infos: ResetOnInfo[] = []
        for (const e of edges) {
            if (onCycle.indexOf(e.target) < 0) infos = infos.concat([{ target: e.target, triggers: e.triggers, rank: rankOf(edges, e.target, []) }])
        }
        return { infos: infos, st: st }
    }

    type RResetEdge:struct = { e: ResetEdge | not, st: AS }

    fn resetEdgeOf(g: Globals, prog: DeclSrc, d: ADecl, a: AAttr, st0: AS) -> RResetEdge {
        let st: AS = st0
        const target: int = fieldIndex(prog.info, d.name)
        if (target < 0) return { e: not, st: st }
        const es: AExpr[] | not = resetEntries(a.value)
        if (es is not) return { e: not, st: addDiag(st, prog.file, a.span, "E-RESET-ON-INVALID-ENTRY", "`reset-on=` takes a bracketed list of cells, `reset-on=[@a, @b]` (§6.8.4)") }
        if (es.length == 0) return { e: not, st: addDiag(st, prog.file, a.span, "E-RESET-ON-INVALID-ENTRY", "`reset-on=[]` lists no cell — the reset would never happen; list the cells whose changes reset `@" + d.name + "` (§6.8.4 rule 2)") }
        let triggers: int[] = []
        let ok = true
        for (const x of es) {
            const why: string = entryProblem(prog.info, x)
            if (why != "") {
                st = addDiag(st, prog.file, x.span, "E-RESET-ON-INVALID-ENTRY", why + " (§6.8.4 rule 2: every entry is a declared, mutable, non-derived reactive cell in scope)")
                ok = false
            } else {
                triggers = triggers.concat([fieldIndex(prog.info, atName(x))])
            }
        }
        const f: FieldInfo = prog.info.fields[target]
        const gr: TransitionGraph | not = f.graph
        if (gr is given) {
            const refused: string = engineRefusals(g, gr, f.init)
            if (refused != "") {
                st = addDiag(st, prog.file, a.span, "E-RESET-ON-ENGINE-REFUSED", "`reset-on=` on `@" + d.name + "` resets it along its `rule=` graph, and every state other than the reset target must admit the target: " + refused + " (§6.8.4 rule 6) — add the target to those states' `rule=`")
                ok = false
            }
        } else if (!grantsAdmit(f.grants, EditKind.Replace)) {
            st = addDiag(st, prog.file, a.span, "E-RESET-ON-NOT-WRITABLE", notWritableMessage(d.name, f.mode))
            ok = false
        } else {
            // s469-boot-tape-grants: as `reset(@x)` — a reset of a struct with an
            // ungranted tape field is not judged statically (resetTapeMessage)
            const tp: string = resetTapeProblem(g.types, f.ty, "@" + d.name)
            if (tp != "") {
                st = addDiag(st, prog.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", resetTapeMessage("`reset-on=` on `@" + d.name + "`", tp))
                ok = false
            }
        }
        if (!ok) return { e: not, st: st }
        return { e: { target: target, triggers: triggers, span: a.span }, st: st }
    }

    fn resetEntries(v: AAttrValue) -> AExpr[] | not {
        return match v {
            .Bare(e: e) :> arrayItems(e)
            .Paren(e: e) :> not
            .NoValue :> not
            .Quoted(v: s) :> not
            .Braced(b: b) :> not
        }
    }

    fn arrayItems(e: AExpr) -> AExpr[] | not {
        const es: AExpr[] = arrayElems(e)
        if (es.length > 0) return es
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: xs) :> xs
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    // Why `x` is not a valid entry ("" — it is one).
    fn entryProblem(pi: DeclInfo, x: AExpr) -> string {
        const n: string = atName(x)
        if (n == "") return "a `reset-on=` entry is a cell written `@name` — this entry is not one"
        const i: int = fieldIndex(pi, n)
        if (i < 0) return "`@" + n + "` is not a declared cell in scope"
        const f: FieldInfo = pi.fields[i]
        const w: Sym | not = f.wcap
        if (w is given) return ""
        const m: FieldMode = f.mode
        return match m {
            .Derived :> "`@" + n + "` is a DERIVED cell — it has no change event of its own; list the cells it is computed from"
            .Locked :> "`@" + n + "` is a LOCKED cell — it never changes"
            .Let :> "`@" + n + "` is not a mutable cell"
            .Seeded :> "`@" + n + "` is not a mutable cell"
        }
    }

    fn notWritableMessage(name: string, m: FieldMode) -> string {
        const what: string = match m {
            .Derived :> "a DERIVED cell (its value is computed from other cells)"
            .Locked :> "a LOCKED cell (no `let`, so no write is granted)"
            .Let :> "a cell whose contract grants no replace"
            .Seeded :> "a cell whose contract grants no replace"
        }
        return "`reset-on=` on `@" + name + "` — the reset is a write, `reset(@" + name + ")`, a replace (§66.11), and `@" + name + "` is " + what + "; make it writable (`let`) or drop `reset-on=` (§6.8.4 rule 5)"
    }

    // Rule 6: the states that refuse the reset target(s), as a message ("" — none).
    // The target is the initializer's variant; a non-literal initializer makes
    // every variant a possible target (fail closed).
    fn engineRefusals(g: Globals, gr: TransitionGraph, init: AAttrValue) -> string {
        const ti: TypeInfo | not = typeInfoOf(g.types, gr.enumSym)
        if (ti is not) return ""
        const vs: VariantDef[] = enumVariants(ti.def)
        let targets: int[] = []
        const lit: string = initVariant(init)
        const t: int = variantIndex(g.types, gr.enumSym, lit)
        if (lit != "" && t >= 0) {
            targets = [t]
        } else {
            let i = 0
            for (const v of vs) {
                targets = targets.concat([i])
                i = i + 1
            }
        }
        let out: string[] = []
        let s = 0
        for (const v of vs) {
            const admits: int[] = edgeTargets(gr, s)
            for (const tgt of targets) {
                if (tgt != s && admits.indexOf(tgt) < 0) {
                    out = out.concat(["`." + v.sym.hint + "` has " + ruleText(vs, admits) + "; it does not admit the reset target `." + vs[tgt].sym.hint + "`"])
                }
            }
            s = s + 1
        }
        return out.join("; ")
    }

    fn initVariant(v: AAttrValue) -> string {
        return match v {
            .Bare(e: e) :> variantLitName(e.k)
            .Paren(e: e) :> variantLitName(e.k)
            .NoValue :> ""
            .Quoted(v: s) :> ""
            .Braced(b: b) :> ""
        }
    }

    fn edgeTargets(gr: TransitionGraph, origin: int) -> int[] {
        for (const e of gr.edges) {
            if (e.origin == origin) return e.targets
        }
        return []
    }

    fn ruleText(vs: VariantDef[], targets: int[]) -> string {
        if (targets.length == 0) return "no `rule=` (no outgoing edge)"
        let names: string[] = []
        for (const t of targets) { names = names.concat(["." + vs[t].sym.hint]) }
        return "`rule=" + names.join(" | ") + "`"
    }

    // A cycle through `at` back to `start` in the reset-on graph (trigger →
    // reset cell): the cells on it, in order, or [] when there is none.
    fn cycleFrom(edges: ResetEdge[], start: int, at: int, path: int[]) -> int[] {
        for (const e of edges) {
            if (e.triggers.indexOf(at) >= 0) {
                if (e.target == start) return path.concat([at])
                if (path.indexOf(e.target) < 0 && e.target != at) {
                    const c: int[] = cycleFrom(edges, start, e.target, path.concat([at]))
                    if (c.length > 0) return c
                }
            }
        }
        return []
    }

    fn cycleText(pi: DeclInfo, cyc: int[]) -> string {
        let parts: string[] = []
        for (const i of cyc) { parts = parts.concat(["`@" + pi.fields[i].sym.hint + "`"]) }
        if (cyc.length == 1) return parts[0] + " lists itself"
        return parts.join(" → ") + " → " + parts[0]
    }

    // A cell's depth in the (acyclic) reset-on graph: 0 when none of its
    // triggers is itself reset, else one more than the deepest trigger.
    fn rankOf(edges: ResetEdge[], target: int, seen: int[]) -> int {
        let best: int = 0
        for (const e of edges) {
            if (e.target == target) {
                for (const t of e.triggers) {
                    if (seen.indexOf(t) < 0 && isResetTarget(edges, t)) {
                        const r: int = rankOf(edges, t, seen.concat([target])) + 1
                        if (r > best) best = r
                    }
                }
            }
        }
        return best
    }

    fn isResetTarget(edges: ResetEdge[], i: int) -> boolean {
        for (const e of edges) {
            if (e.target == i) return true
        }
        return false
    }

    // =========================================================================
    // s451 — `persist="local" | "session"` + `key=` (SPEC §6.14) on a PROGRAM
    // cell — the §6.8.4 opener position: "In the §66 opener it is a
    // **modifier** — the same class as `debounced=` (§6.13), `persist=` (§6.14)
    // and validators". Governing sentences and every refusal's search are in
    // docs/changes/s451-boot-u5-persist/progress.md. Codes:
    //   E-PERSIST-STORAGE-UNKNOWN  §6.14.1 r1 — a value other than "local" / "session"
    //   E-PERSIST-KEY-REQUIRED     §6.14.1 r2 — `persist=` without `key=`
    //   E-PERSIST-WITH-SERVER      §6.14.3 r3 — `server` on the same cell
    //   E-PREPAINT-WITHOUT-PERSIST §6.14.4.2 r2 — `prepaint` without `persist=`
    //   E-HOLD-WITHOUT-PERSIST     §6.14.4.3 r2 — `hold=@x` naming no `persist=` cell
    // Refused (E-BOOTSTRAP-UNSUPPORTED), never accepted-and-ignored: `prepaint`
    // and `hold=` on a persisted cell (no pre-paint script); a computed `key=`
    // (O-061-9); a locked or derived cell (O-061-10); `"local"` on a cell whose
    // contract refuses a whole-value write, and a `"local"` cell as a
    // `reset-on=` trigger (O-061-5; §6.8.4 rule 7); a type with no §57 wire
    // descriptor or holding a FIXED-length sequence; two cells sharing one
    // storage + key; `key=` without `persist=`.
    // E-PERSIST-LIN / -REVEALED cannot be written in the bootstrap (no `lin`
    // cell, no `reveal`); E-PERSIST-DRAFT-OVERWRITTEN needs `<request>` (refused).
    // =========================================================================
    type RPersists:struct = { infos: PersistInfo[], st: AS }
    type RPersist:struct = { info: PersistInfo | not, st: AS }

    // s473 (p5 hole 5, g-boot-engine-no-initial-compiles-unbootable-s473): a
    // `<program>` declaration with NO value (`<phase:Phase single>` over its
    // state-children, `<count:int/>`, `let <u:User/>`) — the program's instance is
    // built when the page boots and no use site ever supplies one, so the page
    // compiled clean and then threw at boot (the printer's `noDefault` thunk:
    // "has no default and no use-site value (SPEC §66.3 O33 is OPEN)"). §51.0.E's
    // `W-ENGINE-INITIAL-MISSING` + "DEFAULTS to the FIRST state-child's variant" is
    // the `<engine initial=>` spelling's lint; under §66 `initial=` IS the
    // declaration's own value (§66.13.3), and what a declaration without one holds
    // is ⚑ O33 (OPEN, §66.3: "what such an attribute holds in the declaration's
    // shared instance … where no use supplies it"; §6.2 Shape 4's canonical empty
    // is not carried into §66 by any ruling). Refused at compile time, by name —
    // never a boot throw. A `<db>` cell is loaded by the server (its own record,
    // dbCellRecord), and a field whose declaration already carries an error (a
    // refused `timestamp`, a `server` cell) is not reported twice.
    fn programNoValue(g: Globals, st0: AS) -> AS {
        let st: AS = st0
        const prog: DeclSrc | not = findDeclSrc(g, g.program)
        if (prog is not) return st
        const perrs: ASpan[] = fileErrs(g.files, prog.file)
        for (const f of prog.info.fields) {
            if (!hasOwnValue(f.init) && dbCellRecord(g, f.nid) is not && !errorWithin(st, prog.file, f.span) && !hasErrIn(perrs, f.span)) {
                let what: string = "a value"
                if (f.graph is given) what = "an initial state — §51.0.E's `initial=` is the declaration's own value under §66 (§66.13.3): `<" + f.sym.hint + ":T=.Variant single>`"
                st = addDiag(st, prog.file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + f.sym.hint + "` is declared in `<program>` with no value, and no use site ever supplies one — the program's instance is built when the page boots. What a declaration without a default holds is ⚑ O33 (OPEN, §66.3); §51.0.E's default-to-the-first-variant and §6.2's canonical empty are not ruled for the §66 form. Give it " + what)
            }
        }
        return st
    }

    fn persistPass(g: Globals, files: FileAst[], st0: AS) -> RPersists {
        let st: AS = st0
        const prog: DeclSrc | not = findDeclSrc(g, g.program)
        if (prog is not) return { infos: [], st: st }
        const p: AProgram | not = prog.p
        if (p is not) return { infos: [], st: st }
        const errs: ASpan[] = fileErrs(files, prog.file)
        let infos: PersistInfo[] = []
        // every program cell that WRITES `persist=` (accepted or not) — what `hold=` names
        let declared: string[] = []
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (!isNestedUserDecl(d) && !hasErrIn(errs, d.span)) {
                    if (attrNamed(d.mods, "persist") is given) declared = declared.concat([d.name])
                    const r: RPersist = persistOf(g, prog, d, st)
                    st = r.st
                    const pi: PersistInfo | not = r.info
                    if (pi is given) {
                        const other: string = keyHolder(infos, pi.persist)
                        if (other != "") {
                            st = addDiag(st, prog.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`@" + d.name + "` and `@" + other + "` persist under the same key \"" + pi.persist.key + "\" in the same storage — each would restore and overwrite the other's value; the SPEC names no code for it (`key=` is \"an external storage contract\", §6.14.1 rule 2), so the bootstrap refuses it — give each cell its own key")
                        } else {
                            infos = infos.concat([pi])
                        }
                    }
                }
            }
        }
        // §6.8.4 rule 7: "whether a cross-tab `storage`-event write to a
        // trigger is a change follows O-061-5" (OPEN) — refused.
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (!isNestedUserDecl(d)) {
                    for (const a of d.mods) {
                        if (a.name == "reset-on") st = syncedTriggerDiags(prog.file, d, a, infos, st)
                    }
                }
            }
        }
        st = holdDiags(files, declared, st)
        return { infos: infos, st: st }
    }

    fn syncedTriggerDiags(file: string, d: ADecl, a: AAttr, infos: PersistInfo[], st0: AS) -> AS {
        let st: AS = st0
        const es: AExpr[] | not = resetEntries(a.value)
        if (es is not) return st
        for (const x of es) {
            const n: string = atName(x)
            if (n != "" && isSyncedCell(infos, n)) {
                st = addDiag(st, file, x.span, "E-BOOTSTRAP-UNSUPPORTED", "`reset-on=` on `@" + d.name + "` lists `@" + n + "`, a `persist=\"local\"` cell another tab can write — whether that cross-tab write is a change that resets `@" + d.name + "` is OPEN (§6.8.4 rule 7, O-061-5); use `persist=\"" + sessionWord() + "\"` (no cross-tab sync) or drop the entry")
            }
        }
        return st
    }

    fn isSyncedCell(infos: PersistInfo[], name: string) -> boolean {
        for (const i of infos) {
            if (i.sym.hint == name && i.persist.store == PersistStore.Local) return true
        }
        return false
    }

    // The cell already persisted under `ps`'s storage + key ("" — none).
    fn keyHolder(infos: PersistInfo[], ps: Persist) -> string {
        for (const i of infos) {
            if (i.persist.key == ps.key && i.persist.store == ps.store) return i.sym.hint
        }
        return ""
    }

    fn persistOf(g: Globals, prog: DeclSrc, d: ADecl, st0: AS) -> RPersist {
        let st: AS = st0
        const pm: AAttr | not = attrNamed(d.mods, "persist")
        const km: AAttr | not = attrNamed(d.mods, "key")
        const pp: AAttr | not = attrNamed(d.mods, "prepaint")
        if (pm is not) {
            if (pp is given) st = addDiag(st, prog.file, pp.span, "E-PREPAINT-WITHOUT-PERSIST", "`prepaint` on `@" + d.name + "`, which has no `persist=` — REFLECT pre-paints a STORED value, so it needs `persist=\"local\"` or `\"" + sessionWord() + "\"` + `key=` on the same cell (§6.14.4.2 rule 2)")
            if (km is given) st = addDiag(st, prog.file, km.span, "E-BOOTSTRAP-UNSUPPORTED", "`key=` on `@" + d.name + "`, which has no `persist=` — a storage key means nothing without a storage; add `persist=\"local\"` or `\"" + sessionWord() + "\"` (§6.14.1)")
            return { info: not, st: st }
        }
        let ok = true
        const store: PersistStore | not = storeOf(pm.value)
        if (store is not) {
            st = addDiag(st, prog.file, pm.span, "E-PERSIST-STORAGE-UNKNOWN", "`persist=` takes \"local\" (localStorage) or \"" + sessionWord() + "\" (sessionStorage) — " + storeText(pm.value) + " is neither (§6.14.1 rule 1; \"cookie\" is deferred, and IndexedDB is a planned stdlib addition, not a `persist=` value)")
            ok = false
        }
        let key: string = ""
        if (km is not) {
            st = addDiag(st, prog.file, pm.span, "E-PERSIST-KEY-REQUIRED", "`persist=` on `@" + d.name + "` has no `key=` — the storage key is an external contract the author writes, never derived from the cell's name (a rename would silently drop every user's saved value): add `key=\"app." + d.name + "\"` or similar (§6.14.1 rule 2)")
            ok = false
        } else {
            const kv: string | not = quotedOf(km.value)
            if (kv is not) {
                st = addDiag(st, prog.file, km.span, "E-BOOTSTRAP-UNSUPPORTED", "a computed `key=` on `@" + d.name + "` is not in the bootstrap — a per-instance key expression is OPEN (O-061-9); write the key as a quoted string")
                ok = false
            } else if (kv == "") {
                // SPEC silent on an empty key (§6.14.1 r2 only requires one) — refused
                st = addDiag(st, prog.file, km.span, "E-BOOTSTRAP-UNSUPPORTED", "`key=\"\"` on `@" + d.name + "` names no storage key — the SPEC does not say whether an empty key is one (§6.14.1 rule 2), so the bootstrap refuses it; write a non-empty key")
                ok = false
            } else {
                key = kv
            }
        }
        const sv: AAttr | not = attrNamed(d.mods, "server")
        if (sv is given) {
            st = addDiag(st, prog.file, pm.span, "E-PERSIST-WITH-SERVER", "`persist=` on `@" + d.name + "`, a server-authority cell — it is already durable, and browser persistence is legal only where authority is local (§6.14.3 rule 3)")
            ok = false
        }
        if (pp is given) {
            st = addDiag(st, prog.file, pp.span, "E-BOOTSTRAP-UNSUPPORTED", "`prepaint` (REFLECT, §6.14.4.2) is not in the bootstrap — it emits no pre-paint script; drop `prepaint` (the cell restores when the client runs, §6.14.2 rule 7)")
            ok = false
        }
        const i: int = fieldIndex(prog.info, d.name)
        if (i < 0) return { info: not, st: st }
        const f: FieldInfo = prog.info.fields[i]
        const why: string = persistCellProblem(g, f, store, st)
        if (why != "") {
            st = addDiag(st, prog.file, pm.span, "E-BOOTSTRAP-UNSUPPORTED", "`persist=` on `@" + d.name + "` — " + why)
            ok = false
        }
        if (!ok) return { info: not, st: st }
        if (store is given) return { info: { sym: f.sym, persist: { store: store, key: key } }, st: st }
        return { info: not, st: st }
    }

    // Why the bootstrap refuses to persist `f` ("" — it does not).
    fn persistCellProblem(g: Globals, f: FieldInfo, store: PersistStore | not, st: AS) -> string {
        const m: FieldMode = f.mode
        if (f.wcap is not) {
            return match m {
                .Derived :> "a DERIVED cell (its value is computed); persisting one is OPEN (O-061-10)"
                .Locked :> "a LOCKED cell never changes, and no rule says what a restore does to one; make it writable (`let`)"
                .Let :> "a cell whose contract grants no write"
                .Seeded :> "a cell whose contract grants no write"
            }
        }
        if (store is given && store == PersistStore.Local && (f.graph is given || !grantsAdmit(f.grants, EditKind.Replace))) {
            return "another tab's value reaches a `persist=\"local\"` cell as one whole-value write, and this cell's contract refuses one (" + contractText(f) + ") — whether its contract judges that write or it is applied like a restore is OPEN (O-061-5); use `persist=\"" + sessionWord() + "\"` (no cross-tab sync)"
        }
        // s469-boot-tape-grants (review r2 H1): the cross-tab value is a whole-value write of a
        // STRUCT too, so it replaces each tape field it changes (§66.12.6 rule 4) — a struct
        // must not carry an append-only tape past the check above. Which fields change is known
        // only at run time: refused, as `reset` is (resetTapeProblem, the one reader).
        if (store is given && store == PersistStore.Local) {
            const tp: string = resetTapeProblem(g.types, f.ty, "@" + f.sym.hint)
            if (tp != "") return "another tab's value reaches a `persist=\"local\"` cell as one whole-value write, and it would replace the tape field `" + tp + "`, whose type does not grant `replace` (§66.12.6 rule 4: no spelling — a struct around the tape included — gets around a tape's grants); the bootstrap has no run-time grant check, so this is refused, not approximated — use `persist=\"" + sessionWord() + "\"` (no cross-tab sync), or grant `replace` on the field's type"
        }
        // r8: an unresolved type is never checked against
        if (st.bad.fields.indexOf(f.sym.id) >= 0) return ""
        const wb: WireBuild = wireBuild(typesProgram(g), f.ty)
        const wt: WireTable | not = wb.table
        if (wt is not) return "its type has no §57 wire form in the bootstrap codec: " + wb.why.join("; ")
        if (hasFixedLength(wt)) return "its type holds a FIXED-length sequence — the length is fixed by construction, and no rule says whether a restored value may bring another length"
        return ""
    }

    fn contractText(f: FieldInfo) -> string {
        if (f.graph is given) return "a `rule=` graph"
        return "no `replace` grant"
    }

    // The program's type definitions as a CoreProgram — all the codec reads.
    fn typesProgram(g: Globals) -> CoreProgram {
        let defs: TypeDef[] = []
        for (const t of g.types) { defs = defs.concat([t.def]) }
        return { program: g.program, decls: [], types: defs, fns: [], server: [], dbs: [], reset: true, sqlError: not, serverCallError: not, css: not, consts: [], loads: [], envelopes: [], head: plainHead() }
    }

    fn storeOf(v: AAttrValue) -> PersistStore | not {
        const s: string | not = quotedOf(v)
        if (s is not) return not
        if (s == "local") return PersistStore.Local
        if (s == sessionWord()) return PersistStore.Session
        return not
    }

    fn quotedOf(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> s
            .Bare(e: e) :> not
            .Paren(e: e) :> not
            .NoValue :> not
            .Braced(b: b) :> not
        }
    }

    fn storeText(v: AAttrValue) -> string {
        return match v {
            .Quoted(v: s) :> "\"" + s + "\""
            .Bare(e: e) :> "an unquoted value"
            .Paren(e: e) :> "a computed value"
            .NoValue :> "no value"
            .Braced(b: b) :> "a block"
        }
    }

    // §6.14.4.3 rule 2 — `hold=@cell`, wherever markup is written. A cell's
    // own declaration's fields shadow program cells of the same name.
    fn holdDiags(files: FileAst[], declared: string[], st0: AS) -> AS {
        let st: AS = st0
        for (const f of files) {
            for (const it of f.items) { st = holdInItem(f.path, it, declared, [], st) }
        }
        return st
    }

    fn holdInItem(file: string, it: AItem, declared: string[], shadow: string[], st0: AS) -> AS {
        let st: AS = st0
        const k: AItemK = it.k
        const ns: ANode[] = match k {
            .MarkupItem(n: n) :> [n]
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
            .ProgramItem(p: p) :> []
            .ConstItem(c: c) :> []
        }
        for (const n of ns) { st = holdInNode(file, n, declared, shadow, st) }
        for (const d of declsOfItem(it)) { st = holdInDecl(file, d, declared, shadow, st) }
        const ps: AItem[] = match k {
            .ProgramItem(p: p) :> p.items
            .ConstItem(c: c) :> []
            .MarkupItem(n: n) :> []
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
        }
        for (const x of ps) { st = holdInItem(file, x, declared, shadow, st) }
        return st
    }

    fn holdInDecl(file: string, d: ADecl, declared: string[], shadow0: string[], st0: AS) -> AS {
        let st: AS = st0
        let shadow: string[] = shadow0
        if (isNestedUserDecl(d)) {
            for (const a of d.attrs) { shadow = shadow.concat([a.name]) }
            for (const c of childFields(d.body)) { shadow = shadow.concat([c.name]) }
        }
        const r: AElem | not = d.renders
        if (r is given) st = holdInElem(file, r, declared, shadow, st)
        for (const c of d.body) {
            const ch: ADeclChild = c
            const kids: ANode[] = match ch {
                .ChildField(d: x) :> []
                .StateChild(s: s) :> s.body
            }
            for (const n of kids) { st = holdInNode(file, n, declared, shadow, st) }
        }
        for (const c of childFields(d.body)) { st = holdInDecl(file, c, declared, shadow, st) }
        return st
    }

    fn holdInRows(file: string, rows: ANode[], declared: string[], shadow: string[], st0: AS) -> AS {
        let st: AS = st0
        for (const r of rows) { st = holdInNode(file, r, declared, shadow, st) }
        return st
    }

    fn holdInNode(file: string, n: ANode, declared: string[], shadow: string[], st: AS) -> AS {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> holdInElem(file, e, declared, shadow, st)
            .DeclNode(d: d) :> holdInDecl(file, d, declared, shadow, st)
            .Css(c: c) :> st
            .Gather(f: lf) :> holdInRows(file, gatherRows(lf), declared, shadow, st)
            .Text(text: t) :> st
            .Interp(e: x) :> st
            .Effect(w: w) :> st
        }
    }

    fn holdInElem(file: string, e: AElem, declared: string[], shadow: string[], st0: AS) -> AS {
        let st: AS = st0
        for (const a of e.attrs) {
            if (a.name == "hold") st = holdAttrDiag(file, a, declared, shadow, st)
        }
        for (const n of e.kids) { st = holdInNode(file, n, declared, shadow, st) }
        return st
    }

    fn holdAttrDiag(file: string, a: AAttr, declared: string[], shadow: string[], st: AS) -> AS {
        const x: AExpr | not = valueExpr(a.value)
        let n: string = ""
        if (x is given) n = atName(x)
        if (n == "") return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`hold=` takes one persisted cell, `hold=@cell` — any other operand form is OPEN (O-062-10)")
        if (declared.indexOf(n) >= 0 && shadow.indexOf(n) < 0) {
            return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`hold=@" + n + "` (HOLD, §6.14.4.3) is not in the bootstrap — it emits no pre-paint script, so nothing would be held; drop `hold=` (the region shows the default until the client restores `@" + n + "`, §6.14.2 rule 7)")
        }
        return addDiag(st, file, a.span, "E-HOLD-WITHOUT-PERSIST", "`hold=@" + n + "` — `@" + n + "` is not a `persist=` cell, and a region is held only until a STORED value is restored (§6.14.4.3 rule 2); a general \"cloak until rendered\" marker is not this attribute")
    }

    // s449: an effect at FILE level (outside `<program>`) has no element scope to
    // own it — refused, never silently dropped (no pass reaches file-level markup).
    fn strayEffects(files: FileAst[], st0: AS) -> AS {
        let st: AS = st0
        for (const f of files) {
            for (const it of f.items) {
                for (const n of markupOf(it)) {
                    for (const sp of effectSpans(n)) {
                        st = addDiag(st, f.path, sp, "E-BOOTSTRAP-UNSUPPORTED", "an effect outside `<program>` — no element scope owns it (§6.7.4); move it into the program")
                    }
                }
            }
        }
        return st
    }

    fn effectSpans(n: ANode) -> ASpan[] {
        const k: ANodeK = n.k
        return match k {
            .Effect(w: w) :> [w.span]
            .Elem(e: e) :> kidEffectSpans(e.kids)
            .Text(text: t) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Css(c: c) :> []
            .Gather(f: lf) :> kidEffectSpans(gatherRows(lf))
        }
    }

    fn kidEffectSpans(ns: ANode[]) -> ASpan[] {
        let out: ASpan[] = []
        for (const n of ns) { out = out.concat(effectSpans(n)) }
        return out
    }

    // =========================================================================
    // s451 (U1a) — ROUTE PLACEMENT, `?{}` AND THE DATABASES (placePass).
    // Design authority: scrml-support/docs/deep-dives/bootstrap-u1-server-
    // boundary-design-2026-10-03.md §1, §2, §5 — superseded where the S451
    // rulings say so (user-voice-scrml.md §S451; normative in SPEC). The
    // governing sentences, quoted (docs/changes/s451-boot-u1a/progress.md has
    // the full list and every reading this pass takes):
    //  §12.1 "The compiler SHALL decide where each function executes. The
    //        default is client-side execution."
    //  §12.2 "SHALL escalate a function to a server route if ANY of": T1 "The
    //        function accesses a resource not accessible from the client" (a
    //        `?{}` — §8.5.4 "any function that contains a `?{}` block is
    //        server-escalated"); T4 "an explicit `server` annotation (§52.10).
    //        DEPRECATED" (T2 protected fields and T3 server-only stdlib imports
    //        are NOT escalation triggers here — both are REFUSED instead (s473):
    //        every `protect=` — `<db protect=>` (resolveDb), a §52.3 type-level
    //        `<T protect=…>` (resolveElem: a capitalized undeclared tag), a
    //        `protect=` on any element (resolveHtml) — and every import of a
    //        server-only stdlib module (checkImports, isServerOnlyStdlib). stdlib
    //        imports DO exist since s471; T3's escalation is owed (gap
    //        g-boot-trigger-3-server-only-import-escalation-unbuilt-s473). T5 is emission — design §2 "Trigger 5 is emission,
    //        not inference" — and T6/T7/T8 have no bootstrap surface).
    //  §52.10 "During the deprecation window, the parser SHALL accept `server
    //        function` declarations and emit `W-DEPRECATED-SERVER-MODIFIER`."
    //  §19.9.5 "A function whose body mixes a server-trigger statement with a
    //        reactive-assignment statement is split across the client/server
    //        boundary" — the SPLIT (CPS); §6.6.9 "A function that also performs
    //        a reactive assignment (`@cell = …`) is CPS-split — a CLIENT
    //        function with an embedded server round-trip." Detected here,
    //        REFUSED until unit U1d builds the body split.
    //  §6.6.9 "A WHOLLY server-escalated function body that READS a client
    //        cell … SHALL be a compile error, E-REACTIVE-003."
    //  §34 E-RI-002 "Server-escalated function mutates `@` reactive variable"
    //        — a wholly-server body that writes a cell (only the deprecated
    //        `server` modifier makes a writing body wholly server: without it
    //        the write splits the body, §19.9.5).
    //  §12.4 (S451 R2) "A server-escalated function whose static call graph
    //        reaches such an access through a callee, directly or
    //        transitively, SHALL be E-ROUTE-002, and the message SHALL name
    //        the chain down to the function that touches the cell and the
    //        cell itself."
    //  §12.4 (S451 R3) "A function that the compiler cannot fully analyze for
    //        route placement SHALL be a compile error (E-ROUTE-001)."
    //  §12.4 E-ROUTE-005: "A single function whose own body accesses BOTH a
    //        server-only resource … AND a client-only global (a DOM global
    //        with no server-side referent) … The DOM globals recognized … are
    //        … (`document`, `window`); an access rooted at a name bound by an
    //        in-scope local, parameter, or import is a domain object".
    //  §12.5.3 E-ROUTE-003 / E-ROUTE-004: non-serializable return / parameter
    //        types of a server function (judged against the §57 codec).
    //  §13.7 (S451 R1) "A value position … SHALL NOT contain an expression
    //        whose value arrives only after the program waits … E-VALUE-
    //        SERVER-CALL": a server call, a client function that reaches one,
    //        a `?{}` written in the position (a Promise-returning stdlib call
    //        has no source form in the bootstrap).
    //  §19.8.3 (S451 R11) "Outside a `!` function it is treated exactly like a
    //        call to a `!` function whose error type is `SqlError` … an
    //        unhandled `?{}` SHALL be a compile error, E-ERROR-002."
    //  §8.1.1 / §44.2 "If no ancestor `<program>` has a `db=` attribute, the
    //        `?{}` block SHALL be a compile error (E-SQL-004)"; "An
    //        unrecognized prefix SHALL be a compile error (E-SQL-005)".
    // Placement is decided over binder facts (Syms) — never names, never text
    // (§12.4 "SHALL NOT classify a function based on … string-literal
    // contents" holds by construction).
    // =========================================================================
    // A `?{}` site: the node, its query, where.
    type SqlSite:struct = { nid: int, span: ASpan, q: ASql }
    // A client-state access in a body: what (as the author spells it), where.
    type CellUse:struct = { what: string, span: ASpan }
    // One function's direct facts (its own body only).
    type FnFacts:struct = {
        sym: int, name: string, file: string, span: ASpan, nid: int,
        modifier: boolean, failable: boolean,
        sqls: SqlSite[], reads: CellUse[], doms: CellUse[], scan: BodyScan,
        foreigns: ASpan[],      // s473: its foreign blocks (§23.2.4: "an inline `_{}` escalates its enclosing function to the server boundary")
        repeats: ASpan[],       // s473 (ruled refusals): the regions of its body that may run more than once (repeatsInBlock)
    }
    // A chain from a function down to a site (display labels, outermost first).
    type Reach:struct = { chain: string[], what: string }
    type PlaceCx:struct = { t: Tables, g: Globals }
    // `doms`: where an E-ROUTE-005 function names a DOM global — the binder's
    // E-SCOPE-001 for that name is replaced by the placement error (one report).
    type RPlaced:struct = { facts: ServerFacts, doms: int[], st: AS }

    // ---- the direct facts ----------------------------------------------------
    // Every `?{}` in a block / expression, at any depth (a lambda included).
    fn sqlsInBlock(b: ABlock) -> SqlSite[] {
        let out: SqlSite[] = []
        for (const s of b.stmts) { out = out.concat(sqlsInStmt(s)) }
        return out
    }

    fn sqlsInStmt(s: AStmt) -> SqlSite[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> sqlsInExpr(e)
            .Local(name: n, init: i) :> sqlsInExpr(i)
            .Return(e: e) :> sqlsInMaybe(e)
            .If(cond: c, thenB: tb, elseB: eb) :> sqlsInExpr(c).concat(sqlsInBlock(tb)).concat(sqlsInMaybeBlock(eb))
            .Given(name: n, subject: x, body: b) :> sqlsInExpr(x).concat(sqlsInBlock(b))
            .For(f: lf) :> sqlsInExprs(forExprs(lf)).concat(sqlsInBlock(lf.body))
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> sqlsInExprs(liftExprs(w))
            .EffectStmt(w: w) :> sqlsInBlock(w.body)
            .Defer(body: b) :> sqlsInBlock(b)
            .Fail(f: f) :> sqlsInExprs(failExprs(f))
        }
    }

    // s473 — every foreign block in a body, at any depth (§23.2.4: a foreign
    // block makes its function a server function). One walk over the body's
    // expressions; exprKids / exprBlocks descend.
    fn foreignsInBlock(b: ABlock) -> ASpan[] {
        let out: ASpan[] = []
        for (const s of b.stmts) { out = out.concat(foreignsInStmt(s)) }
        return out
    }

    fn foreignsInStmt(s: AStmt) -> ASpan[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> foreignsInExpr(e)
            .Local(name: n, init: i) :> foreignsInExpr(i)
            .Return(e: e) :> foreignsInMaybe(e)
            .If(cond: c, thenB: tb, elseB: eb) :> foreignsInExpr(c).concat(foreignsInBlock(tb)).concat(foreignsInMaybeBlock(eb))
            .Given(name: n, subject: x, body: b) :> foreignsInExpr(x).concat(foreignsInBlock(b))
            .For(f: lf) :> foreignsInExprs(forExprs(lf)).concat(foreignsInBlock(lf.body))
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> foreignsInExprs(liftExprs(w))
            .EffectStmt(w: w) :> foreignsInBlock(w.body)
            .Defer(body: b) :> foreignsInBlock(b)
            .Fail(f: f) :> foreignsInExprs(failExprs(f))
        }
    }

    // s473 (ruled refusals, §8.9.2 interim) — the regions of a body that may
    // run MORE THAN ONCE per call: a loop's body, the condition of a `for (c)`
    // head and the condition and step of a counted head (each evaluated per
    // iteration — an iterable and an `init` are evaluated once), and a
    // lambda (a tape method calls it per element). A `?{}` or a call whose
    // span starts inside one is "inside a loop" for the interim refusal.
    fn repeatsInBlock(b: ABlock) -> ASpan[] {
        let out: ASpan[] = []
        for (const s of b.stmts) { out = out.concat(repeatsInStmt(s)) }
        return out
    }

    fn repeatsInStmt(s: AStmt) -> ASpan[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> repeatsInExpr(e)
            .Local(name: n, init: i) :> repeatsInExpr(i)
            .Return(e: e) :> repeatsInMaybe(e)
            .If(cond: c, thenB: tb, elseB: eb) :> repeatsInExpr(c).concat(repeatsInBlock(tb)).concat(repeatsInMaybeBlock(eb))
            .Given(name: n, subject: x, body: b) :> repeatsInExpr(x).concat(repeatsInBlock(b))
            .For(f: lf) :> repeatsInFor(lf)
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> repeatsInExprs(liftExprs(w))
            .EffectStmt(w: w) :> repeatsInBlock(w.body)
            .Defer(body: b) :> repeatsInBlock(b)
            .Fail(f: f) :> repeatsInExprs(failExprs(f))
        }
    }

    fn repeatsInFor(lf: AFor) -> ASpan[] {
        let out: ASpan[] = [lf.body.span]
        const h: AForHead = lf.head
        const per: AExpr[] = match h {
            .HForever :> []
            .HCond(cond: c) :> [c]
            .HCounted(init: i, cond: c, step: sp) :> maybeExprList(c).concat(sp)
            .HIter(bind: b, src: src, key: ky) :> maybeExprList(ky)      // s474: the header `key`, once per iteration (§17.4b)
        }
        for (const x of per) { out = out.concat([x.span]) }
        return out.concat(repeatsInExprs(forExprs(lf)))
    }

    fn repeatsInMaybe(e: AExpr | not) -> ASpan[] {
        if (e is not) return []
        return repeatsInExpr(e)
    }

    fn repeatsInMaybeBlock(b: ABlock | not) -> ASpan[] {
        if (b is not) return []
        return repeatsInBlock(b)
    }

    fn repeatsInExpr(e: AExpr) -> ASpan[] {
        let out: ASpan[] = []
        if (isLambdaK(e.k)) out = [e.span]
        for (const x of exprKids(e)) { out = out.concat(repeatsInExpr(x)) }
        for (const b of exprBlocks(e)) { out = out.concat(repeatsInBlock(b)) }
        return out
    }

    fn repeatsInExprs(es: AExpr[]) -> ASpan[] {
        let out: ASpan[] = []
        for (const x of es) { out = out.concat(repeatsInExpr(x)) }
        return out
    }

    // Does `sp` start inside one of `rs`?
    fn inRepeat(rs: ASpan[], sp: ASpan) -> boolean {
        for (const r of rs) {
            if (sp.start >= r.start && sp.start < r.end) return true
        }
        return false
    }

    fn foreignsInMaybe(e: AExpr | not) -> ASpan[] {
        if (e is not) return []
        return foreignsInExpr(e)
    }

    fn foreignsInMaybeBlock(b: ABlock | not) -> ASpan[] {
        if (b is not) return []
        return foreignsInBlock(b)
    }

    fn foreignsInExpr(e: AExpr) -> ASpan[] {
        let out: ASpan[] = []
        if (foreignOf(e) is given) out = [e.span]
        for (const x of exprKids(e)) { out = out.concat(foreignsInExpr(x)) }
        for (const b of exprBlocks(e)) { out = out.concat(foreignsInBlock(b)) }
        return out
    }

    fn foreignsInExprs(es: AExpr[]) -> ASpan[] {
        let out: ASpan[] = []
        for (const x of es) { out = out.concat(foreignsInExpr(x)) }
        return out
    }

    fn sqlsInMaybe(e: AExpr | not) -> SqlSite[] {
        if (e is not) return []
        return sqlsInExpr(e)
    }

    fn sqlsInMaybeBlock(b: ABlock | not) -> SqlSite[] {
        if (b is not) return []
        return sqlsInBlock(b)
    }

    fn sqlsInExpr(e: AExpr) -> SqlSite[] {
        let out: SqlSite[] = []
        const q: ASql | not = sqlOfK(e.k)
        if (q is given) out = [{ nid: e.nid, span: e.span, q: q }]
        for (const x of exprKids(e)) { out = out.concat(sqlsInExpr(x)) }
        for (const b of exprBlocks(e)) { out = out.concat(sqlsInBlock(b)) }   // s451 (Ue): an arm block
        return out
    }

    fn sqlsInExprs(es: AExpr[]) -> SqlSite[] {
        let out: SqlSite[] = []
        for (const x of es) { out = out.concat(sqlsInExpr(x)) }
        return out
    }

    fn sqlsInValue(v: AAttrValue) -> SqlSite[] {
        return match v {
            .Bare(e: e) :> sqlsInExpr(e)
            .Paren(e: e) :> sqlsInExpr(e)
            .Braced(b: b) :> sqlsInBlock(b)
            .Quoted(v: s) :> []
            .NoValue :> []
        }
    }

    fn sqlOfK(k: AExprK) -> ASql | not {
        return match k {
            .Sql(q: q) :> q
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
        }
    }

    // s451 (Ue): the handling form an expression is, else not.
    fn handledOf(k: AExprK) -> AHandled | not {
        return match k {
            .Sql(q: q) :> not
            .Handled(h: h) :> h
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
        }
    }

    // Every READ of client state in a body (a cell, an instance, a validity
    // surface) — the binder's name facts. A write's TARGET is not a read (the
    // write is BodyScan's), and neither is the receiver of an edit call.
    fn readsInBlock(t: Tables, b: ABlock) -> CellUse[] {
        let out: CellUse[] = []
        for (const s of b.stmts) { out = out.concat(readsInStmt(t, s)) }
        return out
    }

    fn readsInStmt(t: Tables, s: AStmt) -> CellUse[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> readsInExpr(t, e)
            .Local(name: n, init: i) :> readsInExpr(t, i)
            .Return(e: e) :> readsInMaybe(t, e)
            .If(cond: c, thenB: tb, elseB: eb) :> readsInExpr(t, c).concat(readsInBlock(t, tb)).concat(readsInMaybeBlock(t, eb))
            .Given(name: n, subject: x, body: b) :> readsInExpr(t, x).concat(readsInBlock(t, b))
            .For(f: lf) :> readsInExprs(t, forExprs(lf)).concat(readsInBlock(t, lf.body))
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> readsInExprs(t, liftExprs(w))
            .EffectStmt(w: w) :> []
            .Defer(body: b) :> readsInBlock(t, b)
            .Fail(f: f) :> readsInExprs(t, failExprs(f))
        }
    }

    fn readsInMaybe(t: Tables, e: AExpr | not) -> CellUse[] {
        if (e is not) return []
        return readsInExpr(t, e)
    }

    fn readsInMaybeBlock(t: Tables, b: ABlock | not) -> CellUse[] {
        if (b is not) return []
        return readsInBlock(t, b)
    }

    fn readsInExpr(t: Tables, e: AExpr) -> CellUse[] {
        // an assignment: only its value is read; an edit / reset call: its arguments
        const v: AExpr | not = assignedValue(e)
        if (v is given) return readsInExpr(t, v)
        if (effectFact(t.effects, e.nid) is given) {
            // `reset(@x)`: its argument is the write's target, not a read
            const c: AExpr | not = calleeOf(e.k)
            if (c is given && exprName(c) == "reset") return []
            let acc: CellUse[] = []
            for (const x of exprKids(e).slice(1)) { acc = acc.concat(readsInExpr(t, x)) }
            return acc
        }
        const what: string = clientRead(t, nameFact(t.names, e.nid))
        if (what != "") return [{ what: what, span: e.span }]
        let out: CellUse[] = []
        for (const x of exprKids(e)) { out = out.concat(readsInExpr(t, x)) }
        for (const b of exprBlocks(e)) { out = out.concat(readsInBlock(t, b)) }   // s451 (Ue): an arm block
        return out
    }

    fn readsInExprs(t: Tables, es: AExpr[]) -> CellUse[] {
        let out: CellUse[] = []
        for (const x of es) { out = out.concat(readsInExpr(t, x)) }
        return out
    }

    // The client state a name fact reads ("" — none), as the author spells it.
    fn clientRead(t: Tables, f: NameFact | not) -> string {
        return match f {
            .NField(decl: d, inst: i, idx: x) :> fieldUseLabel(t, d, x)
            .NInst(decl: d) :> "@" + d.hint
            .NSurface(of: v) :> "the validity surface of @" + validityDecl(v).hint
            .NConst(sym: s) :> ""
            .NLocal(sym: s) :> ""
            .NStruct(owner: o) :> ""
            .NFn(sym: s) :> ""
            .NLength :> ""
            not :> ""
        }
    }

    fn fieldUseLabel(t: Tables, d: Sym, idx: int) -> string {
        const di: DeclInfo | not = declInfo(t, d)
        if (di is not || idx < 0 || idx >= di.fields.length) return "@" + d.hint
        const f: FieldInfo = di.fields[idx]
        if (di.kind == DeclKind.Program) return "@" + f.sym.hint
        return "@" + d.hint + "." + f.sym.hint
    }

    // §12.4: a DOM global — `document` / `window` named with NO binding (a
    // local, parameter or import of that name is a domain object, and has a
    // name fact). The bootstrap has no DOM API; the binder reports the name
    // (E-SCOPE-001) — this records it as a client-only access for placement.
    fn domsInBlock(t: Tables, b: ABlock) -> CellUse[] {
        let out: CellUse[] = []
        for (const s of b.stmts) { out = out.concat(domsInStmt(t, s)) }
        return out
    }

    fn domsInStmt(t: Tables, s: AStmt) -> CellUse[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> domsInExpr(t, e)
            .Local(name: n, init: i) :> domsInExpr(t, i)
            .Return(e: e) :> domsInMaybe(t, e)
            .If(cond: c, thenB: tb, elseB: eb) :> domsInExpr(t, c).concat(domsInBlock(t, tb)).concat(domsInMaybeBlock(t, eb))
            .Given(name: n, subject: x, body: b) :> domsInExpr(t, x).concat(domsInBlock(t, b))
            .For(f: lf) :> domsInExprs(t, forExprs(lf)).concat(domsInBlock(t, lf.body))
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> domsInExprs(t, liftExprs(w))
            .EffectStmt(w: w) :> []
            .Defer(body: b) :> domsInBlock(t, b)
            .Fail(f: f) :> domsInExprs(t, failExprs(f))
        }
    }

    fn domsInMaybe(t: Tables, e: AExpr | not) -> CellUse[] {
        if (e is not) return []
        return domsInExpr(t, e)
    }

    fn domsInMaybeBlock(t: Tables, b: ABlock | not) -> CellUse[] {
        if (b is not) return []
        return domsInBlock(t, b)
    }

    fn domsInExpr(t: Tables, e: AExpr) -> CellUse[] {
        const n: string = exprName(e)
        if ((n == "document" || n == "window") && nameFact(t.names, e.nid) is not && bindFact(t.binds, e.nid) is not) {
            return [{ what: "the DOM global `" + n + "`", span: e.span }]
        }
        // s473 (§21.3.3 rule 10): "In any other file [than a compiler-bundled stdlib
        // module], a binding is client-only: a function whose body calls one is
        // client-only for route analysis (§12.4), as a body that reads `document` or
        // `window` is" — a REFERENCE to a `<host>` binding is that use
        const hb: string = hostBindNamed(t, e)
        if (hb != "") return [{ what: "the `<host>` binding `" + hb + "`", span: e.span }]
        let out: CellUse[] = []
        for (const x of exprKids(e)) { out = out.concat(domsInExpr(t, x)) }
        for (const b of exprBlocks(e)) { out = out.concat(domsInBlock(t, b)) }   // s451 (Ue): an arm block
        return out
    }

    // The name of the `<host>` binding `e` references ("" — none).
    fn hostBindNamed(t: Tables, e: AExpr) -> string {
        const nf: NameFact | not = nameFact(t.names, e.nid)
        if (nf is not) return ""
        const s: Sym | not = fnSymOfFact(nf)
        if (s is not) return ""
        for (const f of t.fns) {
            if (f.sym.id == s.id) {
                const h: HostFn | not = f.host
                if (h is given) {
                    if (h.bind is given) return f.name
                }
            }
        }
        return ""
    }

    fn fnSymOfFact(nf: NameFact) -> Sym | not {
        return match nf {
            .NFn(sym: s) :> s
            .NLocal(sym: s) :> not
            .NField(decl: d) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NLength :> not
            .NSurface(of: o) :> not
            .NConst(sym: s) :> not
        }
    }

    fn domsInExprs(t: Tables, es: AExpr[]) -> CellUse[] {
        let out: CellUse[] = []
        for (const x of es) { out = out.concat(domsInExpr(t, x)) }
        return out
    }

    fn fnFacts(cx: PlaceCx, fs: FnSrc) -> FnFacts {
        const scan: BodyScan = scanBlock({ t: cx.t, file: fs.info.file }, fs.f.body, emptyScan())
        return { sym: fs.info.sym.id, name: fs.info.name, file: fs.info.file, span: fs.info.span, nid: fs.info.nid,
                 modifier: fs.f.server, failable: fs.f.failable,
                 sqls: sqlsInBlock(fs.f.body), reads: readsInBlock(cx.t, fs.f.body), doms: domsInBlock(cx.t, fs.f.body), scan: scan,
                 foreigns: foreignsInBlock(fs.f.body), repeats: repeatsInBlock(fs.f.body) }
    }

    // ---- placement -------------------------------------------------------------
    fn serverTriggered(f: FnFacts) -> boolean { return f.sqls.length > 0 || f.foreigns.length > 0 || f.modifier }
    fn clientDirect(f: FnFacts) -> boolean { return f.reads.length > 0 || f.scan.writes.length > 0 || f.doms.length > 0 }

    // §12.2 + §19.9.5 / §6.6.9, by the function's OWN body. Calling a server
    // function does not move the caller (design §2: "Calling a Server fn does
    // NOT change the caller's placement … it makes the caller async-colored");
    // reaching a client-only function DOES pin it to the client (§12.4: a
    // client-only function is "any function determined by route analysis to
    // execute exclusively on the client").
    fn directPlace(f: FnFacts) -> PlaceK {
        if (serverTriggered(f)) {
            // §19.9.5: a server trigger + a reactive assignment splits the body —
            // unless the deprecated `server` modifier declares the WHOLE body
            // server (§52.10: "historically forced server-side execution"); a
            // DOM access makes it unplaceable (E-ROUTE-005, judged first)
            if ((f.sqls.length > 0 || f.foreigns.length > 0) && f.scan.writes.length > 0 && !f.modifier && f.doms.length == 0) return PlaceK.Split
            return PlaceK.Server
        }
        if (clientDirect(f)) return PlaceK.Client
        return PlaceK.Ambient
    }

    fn factsOf(all: FnFacts[], sym: int) -> FnFacts | not {
        for (const f of all) {
            if (f.sym == sym) return f
        }
        return not
    }

    // A symbol no function owns (a declaration a construction reference names)
    // has no placement of its own: Ambient.
    fn placeOf(ps: PlaceFact[], sym: int) -> PlaceK {
        for (const p of ps) {
            if (p.sym == sym) return p.place
        }
        return PlaceK.Ambient
    }

    // The function references (calls and values) a body makes — the scan's
    // refs that name a scrml FUNCTION (a construction / formula reference
    // names a declaration or a field: that is a cell read, recorded already).
    fn fnRefs(all: FnFacts[], f: FnFacts) -> FnRef[] {
        let out: FnRef[] = []
        for (const r of f.scan.refs) {
            if (factsOf(all, r.sym) is given) out = out.concat([r])
        }
        return out
    }

    // THE REACHES — queries over the effect summary (dpa-066 M2; the three
    // fixpoints that computed them are retired). Each is the first chain (the
    // summary's witness) from function `sym` down to:
    //  - clientReachOf (§12.4 R2): a client-state access, through non-server
    //    callees — a server callee is judged on its own (server → server is a
    //    call in place, §13.4); a server function reaches none of its own;
    //  - routeOpenOf (§12.4 R3): a call the analysis cannot resolve, through
    //    non-server callees;
    //  - waitsOf (§13.2, §13.7 item 2): a server or split function — async colour.
    fn clientReachOf(s: Summary, sym: int) -> Reach | not {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return not
        const a: FxAtom | not = witnessOf(s.client[i])
        if (a is not) return not
        return { chain: fxChain(s, s.client, i, a), what: clientWhats(s.nodes[a.root].f)[a.pos] }
    }

    fn routeOpenOf(s: Summary, sym: int) -> Reach | not {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return not
        const a: FxAtom | not = witnessOf(s.routeOpen[i])
        if (a is not) return not
        return { chain: fxChain(s, s.routeOpen, i, a), what: s.nodes[a.root].f.scan.unproven[a.pos].what }
    }

    fn waitsOf(s: Summary, sym: int) -> Reach | not {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return not
        const a: FxAtom | not = witnessOf(s.waits[i])
        if (a is not) return not
        return { chain: fxChain(s, s.waits, i, a), what: "" }
    }

    // s468 (U1c): does `sym` wait when it runs on the server — and through which chain?
    fn swaitsOf(s: Summary, sym: int) -> Reach | not {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return not
        const a: FxAtom | not = witnessOf(s.swaits[i])
        if (a is not) return not
        return { chain: fxChain(s, s.swaits, i, a), what: "" }
    }

    // The functions' own facts, as the summary read them (one scan per body).
    fn fnFactsOf(s: Summary) -> FnFacts[] {
        let out: FnFacts[] = []
        for (const c of s.nodes) {
            if (c.kind == CallableK.KFn) out = out.concat([c.f])
        }
        return out
    }

    // ---- the databases (§8.1.1 as amended S451, §44.2) ----------------------------
    // s452 — §8.1.1: "The compiler SHALL resolve the database for each `?{}`
    // block by finding its closest ancestor **database scope** — a `<program>`
    // element with a `db=` attribute, a `<program>` element whose database a
    // direct-child `<db src=>` supplies …, or a `<db src=>` state block.
    // 'Closest' means fewest nesting levels up the element tree, counting every
    // kind". Ruling 11a: "When a `<program>` element has no `db=` attribute and
    // exactly one `<db src=>` element is its **direct child**, that `<program>`
    // SHALL be a database scope whose database is the `<db>`'s `src=` value";
    // two or more direct-child `<db src=>` → "NONE of them supplies"; "A
    // `<program db=>` is never supplied". E-SQL-004 "whatever the number of
    // database scopes in the file".
    //
    // ONE walk over every file — items, markup, declarations — carrying the
    // nearest database scope. It records each function's scope (a function is
    // an item of a `<program>` body or the file top — s472: one declared in a
    // `<db>` body is hoisted there by the parser and takes THAT block's scope,
    // FileAst.dbFns), each MARKUP-position `?{}` site's scope (an attribute
    // or handler value, an interpolation, an `<effect>` body, a declaration's
    // value), and every scope's database.
    //
    // A database scope: its node (a `<program>` or a `<db>` element), its
    // database (`not` — the value was refused, reported). A `<program>` a
    // `<db>` supplies and that `<db>` share ONE Db (one database).
    type ScopeDb:struct = { nid: int, db: Db | not }
    // Each function's nearest database scope (-1: none).
    type FnDb:struct = { fnid: int, scope: int }
    // Each markup-position `?{}` site's nearest database scope (-1: none).
    type SiteDb:struct = { nid: int, scope: int }
    // s472: `owned` — the current file's FileAst.dbFns (each function declared in a `<db>` body)
    type RDbs:struct = { scopes: ScopeDb[], fns: FnDb[], sites: SiteDb[], st: AS, owned: ADbFn[] }

    fn dbsPass(g: Globals, files: FileAst[], st0: AS) -> RDbs {
        let acc: RDbs = { scopes: [], fns: [], sites: [], st: st0, owned: [] }
        for (const f of files) {
            const withOwned: RDbs = { scopes: acc.scopes, fns: acc.fns, sites: acc.sites, st: acc.st, owned: f.dbFns }
            acc = dbsInItems(g, f.path, f.items, -1, withOwned)
        }
        return acc
    }

    // s472 — the `<db>` whose body declares function `fnid` (its element's nid), else -1.
    fn ownerDb(owned: ADbFn[], fnid: int) -> int {
        for (const o of owned) {
            if (o.fn == fnid) return o.db
        }
        return -1
    }

    fn withScope(acc: RDbs, nid: int, db: Db | not, st: AS) -> RDbs {
        return { scopes: acc.scopes.concat([{ nid: nid, db: db }]), fns: acc.fns, sites: acc.sites, st: st, owned: acc.owned }
    }

    fn withSites(acc: RDbs, ss: SqlSite[], scope: int) -> RDbs {
        let sites: SiteDb[] = acc.sites
        for (const x of ss) { sites = sites.concat([{ nid: x.nid, scope: scope }]) }
        return { scopes: acc.scopes, fns: acc.fns, sites: sites, st: acc.st, owned: acc.owned }
    }

    fn dbsInItems(g: Globals, file: string, items: AItem[], scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = acc0
        for (const it of items) {
            const k: AItemK = it.k
            const f: AFn | not = fnOfItemK(k)
            // s472: a function declared in a `<db>` body (hoisted into this item
            // list by the parser) takes THAT block's scope — dbsInElem records it
            if (f is given && ownerDb(acc.owned, f.nid) < 0) acc = { scopes: acc.scopes, fns: acc.fns.concat([{ fnid: f.nid, scope: scope }]), sites: acc.sites, st: acc.st, owned: acc.owned }
            const p: AProgram | not = programOfK(k)
            if (p is given) acc = dbsInProgram(g, file, p, scope, acc)
            const n: ANode | not = markupOfItemK(k)
            if (n is given) acc = dbsInNode(g, file, n, scope, acc)
            const d: ADecl | not = declOfItemK(k)
            if (d is given) acc = dbsInDecl(g, file, d, scope, acc)
        }
        return acc
    }

    // A `<program>`: a database scope on its own `db=`; else on the `src=` of
    // its single direct-child `<db src=>` (ruling 11a); else not a scope.
    fn dbsInProgram(g: Globals, file: string, p: AProgram, outer: int, acc: RDbs) -> RDbs {
        const a: AAttr | not = attrNamed(p.attrs, "db")
        if (a is given) {
            const rd: RDb = dbOfAttr(file, a, acc.st)
            return dbsInItems(g, file, p.items, p.nid, withScope(acc, p.nid, rd.db, rd.st))
        }
        const sup: AElem | not = supplyingDb(g, file, p.items)
        if (sup is given) {
            const src: AAttr | not = attrNamed(sup.attrs, "src")
            if (src is given) {
                const rs: RDb = dbOfAttr(file, src, acc.st)
                const both: RDbs = withScope(withScope(acc, p.nid, rs.db, rs.st), sup.nid, rs.db, rs.st)
                return dbsInItems(g, file, p.items, p.nid, both)
            }
        }
        return dbsInItems(g, file, p.items, outer, acc)
    }

    // The ONE direct-child `<db src=>` of a program body, else not (none, or
    // two or more — "NONE of them supplies").
    fn supplyingDb(g: Globals, file: string, items: AItem[]) -> AElem | not {
        let found: AElem[] = []
        for (const it of items) {
            const n: ANode | not = markupOfItemK(it.k)
            if (n is given) {
                const e: AElem | not = elemOfANode(n)
                if (e is given) {
                    if (isDbElem(g, file, e) && attrNamed(e.attrs, "src") is given) found = found.concat([e])
                }
            }
        }
        if (found.length == 1) return found[0]
        return not
    }

    // A `<db>` state block (§4 — "`db` is a built-in state type"), unless a
    // user declaration takes the name (the binder's rule: a declaration in
    // scope wins over every built-in reading of a tag).
    fn isDbElem(g: Globals, file: string, e: AElem) -> boolean {
        if (e.star || e.tag != "db") return false
        return declNamed(g, file, e.tag) is not
    }

    fn dbsInNode(g: Globals, file: string, n: ANode, scope: int, acc: RDbs) -> RDbs {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> dbsInElem(g, file, e, scope, acc)
            .Interp(e: x) :> withSites(acc, sqlsInExpr(x), scope)
            .Effect(w: w) :> withSites(acc, sqlsInBlock(w.body), scope)
            .DeclNode(d: d) :> dbsInDecl(g, file, d, scope, acc)
            .Css(c: c) :> acc
            .Gather(f: lf) :> dbsInRows(g, file, gatherRows(lf), scope, withSites(acc, sqlsInStmt(forAsStmt(lf)), scope))
            .Text(text: t) :> acc
        }
    }

    // An element: its attribute values stand in the scope around it; a `<db
    // src=>` is the scope of its children (registered once — a program's
    // supplier is registered with the program).
    fn dbsInRows(g: Globals, file: string, rows: ANode[], scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = acc0
        for (const r of rows) { acc = dbsInNode(g, file, r, scope, acc) }
        return acc
    }

    fn dbsInElem(g: Globals, file: string, e: AElem, scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = acc0
        for (const a of e.attrs) { acc = withSites(acc, sqlsInValue(a.value), scope) }
        let inner: int = scope
        if (isDbElem(g, file, e)) {
            const src: AAttr | not = attrNamed(e.attrs, "src")
            if (src is given) {
                if (scopeDbOf(acc.scopes, e.nid) is not) {
                    const rd: RDb = dbOfAttr(file, src, acc.st)
                    acc = withScope(acc, e.nid, rd.db, rd.st)
                }
                inner = e.nid
            }
        }
        // s472 (S472 ruling Q3) — the functions declared in this `<db>` body:
        // their nearest database scope is this block (§8.1.1). A `<db>` with no
        // `src=` registers no scope (resolveDb refuses it), so their queries
        // resolve to nothing — never to an outer database. A `<db>` a user
        // declaration takes over is that declaration's use, not a database
        // scope: a function in its body has no SPEC reading — refused.
        if (!e.star && e.tag == "db") {
            const isDb: boolean = isDbElem(g, file, e)
            for (const o of acc.owned) {
                if (o.db == e.nid) {
                    if (isDb) {
                        acc = { scopes: acc.scopes, fns: acc.fns.concat([{ fnid: o.fn, scope: e.nid }]), sites: acc.sites, st: acc.st, owned: acc.owned }
                    } else {
                        acc = { scopes: acc.scopes, fns: acc.fns, sites: acc.sites, st: addDiag(acc.st, file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a function in the body of `<db>` — here a use of the declaration `db`, not the `<db>` state block (§4, §8.1.1) — is not in the bootstrap"), owned: acc.owned }
                    }
                }
            }
        }
        for (const c of e.kids) { acc = dbsInNode(g, file, c, inner, acc) }
        return acc
    }

    // A declaration: its own value, its attribute defaults, the opener's other
    // words' values, its validators' arguments, its child fields, its state
    // children, its renders.
    fn dbsInDecl(g: Globals, file: string, d: ADecl, scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = withSites(acc0, sqlsInValue(d.own), scope)
        for (const a of d.attrs) { acc = withSites(acc, sqlsInValue(a.dflt), scope) }
        for (const m of d.mods) { acc = withSites(acc, sqlsInValue(m.value), scope) }
        for (const v of d.validators) { acc = withSites(acc, sqlsInExprs(valArgExprs(v.arg)), scope) }
        for (const c of d.body) {
            const ck: ADeclChild = c
            acc = match ck {
                .ChildField(d: cd) :> dbsInDecl(g, file, cd, scope, acc)
                .StateChild(s: sc) :> dbsInStateChild(g, file, sc, scope, acc)
            }
        }
        const r: AElem | not = d.renders
        if (r is given) acc = dbsInElem(g, file, r, scope, acc)
        return acc
    }

    fn dbsInStateChild(g: Globals, file: string, sc: AStateChild, scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = acc0
        for (const a of sc.attrs) { acc = withSites(acc, sqlsInValue(a.value), scope) }
        for (const n of sc.body) { acc = dbsInNode(g, file, n, scope, acc) }
        return acc
    }

    fn valArgExprs(a: AValArg) -> AExpr[] {
        return match a {
            .NoArgs :> []
            .Cmp(op: o, e: x) :> [x]
            .Exprs(es: es) :> es
            .Regex(source: x) :> []
        }
    }

    fn markupOfItemK(k: AItemK) -> ANode | not {
        return match k {
            .MarkupItem(n: n) :> n
            .FnItem(f: f) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .DeclItem(d: d) :> not
            .ProgramItem(p: p) :> not
            .ConstItem(c: c) :> not
        }
    }

    fn declOfItemK(k: AItemK) -> ADecl | not {
        return match k {
            .DeclItem(d: d) :> d
            .MarkupItem(n: n) :> not
            .FnItem(f: f) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .ProgramItem(p: p) :> not
            .ConstItem(c: c) :> not
        }
    }

    fn elemOfANode(n: ANode) -> AElem | not {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> e
            .Text(text: t) :> not
            .Interp(e: x) :> not
            .DeclNode(d: d) :> not
            .Css(c: c) :> not
            .Gather(f: x) :> not
            .Effect(w: w) :> not
        }
    }

    fn fnOfItemK(k: AItemK) -> AFn | not {
        return match k {
            .FnItem(f: f) :> f
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .DeclItem(d: d) :> not
            .MarkupItem(n: n) :> not
            .ProgramItem(p: p) :> not
            .ConstItem(c: c) :> not
        }
    }

    fn programOfK(k: AItemK) -> AProgram | not {
        return match k {
            .ProgramItem(p: p) :> p
            .ConstItem(c: c) :> not
            .FnItem(f: f) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .DeclItem(d: d) :> not
            .MarkupItem(n: n) :> not
        }
    }

    type RDb:struct = { db: Db | not, st: AS }

    // §8.1.1's driver table (`./path`, `sqlite:`, `:memory:`, `postgres://`,
    // `postgresql://`, `mysql://`; `mongo*` is "NOT VALID for `?{}`"), §44.2,
    // and "A `file:` URI is not a path and SHALL be E-SQL-005". A value that is
    // not a literal is refused (a connection string is configuration, read at
    // compile time).
    fn dbOfAttr(file: string, a: AAttr, st: AS) -> RDb {
        const v: string | not = quotedValue(a.value)
        if (v is not) return { db: not, st: addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` must be a literal connection string (`" + a.name + "=\"./app.db\"`, §8.1.1) — the bootstrap reads it at compile time") }
        const why: string = dbRefusal(v)
        if (why != "") return { db: not, st: addDiag(st, file, a.span, "E-SQL-005", "`" + a.name + "=` (" + dbKind(v) + "): " + why + " (§8.1.1, §44.2). A `" + sqlSigil() + "}` runs on SQLite (`./app.db`, `sqlite:./app.db`, `:memory:`), PostgreSQL (`postgres://…`, `postgresql://…`) or MySQL (`mysql://…`)") }
        const r: RSym = mint(st, "db")
        return { db: { sym: r.s, driver: dbDriver(v), target: dbTarget(v), file: file, owner: false }, st: r.st }
    }

    fn quotedValue(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> s
            .NoValue :> not
            .Bare(e: x) :> not
            .Paren(e: x) :> not
            .Braced(b: b) :> not
        }
    }

    // s452 r3 (LOW-B) — a diagnostic SHALL NOT echo a `db=` / `src=` value at
    // all (credentials hide in too many places: userinfo, `?password=`,
    // `;password=`, a jdbc `&password=`, an unencoded `/`). It names what KIND
    // of value it is instead, from the recognized scheme only.
    fn dbKind(v: string) -> string {
        if (v.trim() == "") return "an empty value"
        const scheme: string = schemeOf(v)
        if (scheme == "") return "a SQLite path"
        if (scheme == "sqlite") return "a `sqlite:` path"
        if (scheme == "postgres" || scheme == "postgresql") return "a PostgreSQL connection string"
        if (scheme == "mysql") return "a MySQL connection string"
        if (scheme == "mongo" || scheme == "mongodb") return "a MongoDB URL"
        if (scheme == "file") return "a `file:` URI"
        return "a connection string with an unrecognized prefix"
    }

    // Why a connection string is not a `?{}` database ("" — it is one).
    fn dbRefusal(v: string) -> string {
        if (v.trim() == "") return "an empty connection string names no database"
        const scheme: string = schemeOf(v)
        if (scheme == "") return ""                      // a plain path: implicit `sqlite:`
        if (scheme == "sqlite") {
            if (sqlitePathOf(v).trim() == "") return "`sqlite:` names no path"
            return ""
        }
        if (scheme == "postgres" || scheme == "postgresql" || scheme == "mysql") {
            if (v.indexOf("://") != scheme.length) return "a `" + scheme + ":` connection string is a URL (`" + scheme + "://…`)"
            return ""
        }
        if (scheme == "mongo" || scheme == "mongodb") return "MongoDB is not a `" + sqlSigil() + "}` database — use a `^{}` meta context"
        if (scheme == "file") return "a `file:` URI is not a path — write the path itself or `sqlite:<path>`"
        return "its prefix is not a recognized database connection prefix"
    }

    // The URI scheme of a value ("" — none: a path, or `:memory:`).
    fn schemeOf(v: string) -> string {
        if (v == ":memory:") return ""
        const colon: int = v.indexOf(":")
        if (colon <= 0) return ""
        const s: string = v.substring(0, colon)
        let i: int = 0
        while (i < s.length) {
            const c: string = s.substring(i, i + 1)
            const ok: boolean = c.toUpperCase() != c.toLowerCase() || "0123456789+.-".indexOf(c) >= 0
            if (!ok) return ""
            i = i + 1
        }
        // a one-letter "scheme" is a Windows drive path (`C:\…`), not a scheme
        if (s.length == 1) return ""
        return s.toLowerCase()
    }

    fn dbDriver(v: string) -> Driver {
        const s: string = schemeOf(v)
        if (s == "postgres" || s == "postgresql") return Driver.Postgres
        if (s == "mysql") return Driver.Mysql
        return Driver.Sqlite
    }

    fn dbTarget(v: string) -> string {
        if (schemeOf(v) == "sqlite") return sqlitePathOf(v)
        return v
    }

    // s474 r2 (review of #1699, item 3) — the path a `sqlite:` value names. §8.1.1 defines
    // `sqlite:<path>` (`sqlite:./app.db`); it is silent on the URL spelling `sqlite://…`. Before r2
    // the bootstrap kept the `//`, so `sqlite://app.db` named `//app.db` — the file `app.db` in the
    // filesystem ROOT. impl#1 (compiler/src/db-target.ts `classifyDbTarget`: `/^sqlite:(?:\/\/)?/`)
    // reads `sqlite://app.db` as `app.db` (relative to the declaring file) and `sqlite:///abs/a.db`
    // as `/abs/a.db`; the bootstrap now reads it the same way (both implementations open one file).
    // The SPEC sentence is owed: g-spec-sqlite-url-form-unspecified-s474.
    fn sqlitePathOf(v: string) -> string {
        const rest: string = v.substring(7)
        if (rest.substring(0, 2) == "//") return rest.substring(2)
        return rest
    }

    fn scopeDbOf(ss: ScopeDb[], nid: int) -> ScopeDb | not {
        for (const x of ss) {
            if (x.nid == nid) return x
        }
        return not
    }

    fn fnScope(fs: FnDb[], fnid: int) -> int {
        for (const f of fs) {
            if (f.fnid == fnid) return f.scope
        }
        return -1
    }

    fn siteScope(ss: SiteDb[], nid: int) -> int {
        for (const x of ss) {
            if (x.nid == nid) return x.scope
        }
        return -1
    }

    // The program's databases, each once (a supplied program shares its `<db>`'s).
    fn scopeDbs(ss: ScopeDb[]) -> Db[] {
        let out: Db[] = []
        let seen: int[] = []
        for (const x of ss) {
            const d: Db | not = x.db
            if (d is given) {
                if (seen.indexOf(d.sym.id) < 0) {
                    out = out.concat([d])
                    seen = seen.concat([d.sym.id])
                }
            }
        }
        return out
    }

    // ---- the action positions (not value positions, §6.15) ------------------------
    // An event-handler value and an `<effect>` body: client code that RUNS (a
    // handler on its event, an effect on its change), so a server call there
    // is a suspension (unit U1b) and a `?{}` there splits the client body
    // around server work (§19.9.5 — unit U1d).
    type ActionPos:struct = { what: string, v: AAttrValue, file: string }

    fn actionPositions(g: Globals) -> ActionPos[] {
        let out: ActionPos[] = []
        for (const ds of g.decls) {
            for (const n of declMarkup(ds)) { out = out.concat(nodeActions(n, ds.file)) }
        }
        return out
    }

    fn nodeActions(n: ANode, file: string) -> ActionPos[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> elemActions(e, file)
            .Effect(w: w) :> [{ what: "this `<effect>` body", v: AAttrValue.Braced(w.body), file: file }]
            .Text(text: s) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Css(c: c) :> []
            .Gather(f: lf) :> rowActions(lf, file)      // s469: a row's handlers (the loop is a value position)
        }
    }

    fn rowActions(f: AFor, file: string) -> ActionPos[] {
        let out: ActionPos[] = []
        for (const r of gatherRows(f)) { out = out.concat(nodeActions(r, file)) }
        return out
    }

    fn elemActions(e: AElem, file: string) -> ActionPos[] {
        let out: ActionPos[] = []
        for (const a of e.attrs) {
            if (eventName(a.name) != "") out = out.concat([{ what: "the `" + a.name + "=` handler on `<" + e.tag + ">`", v: a.value, file: file }])
        }
        for (const k of e.kids) { out = out.concat(nodeActions(k, file)) }
        return out
    }

    // ---- the pass ------------------------------------------------------------------
    fn placePass(g: Globals, t: Tables, st0: AS, sum: Summary) -> RPlaced {
        const cx: PlaceCx = { t: t, g: g }
        let st: AS = st0
        // the functions' own facts and the ONE placement — the effect summary's
        // (dpa-066 M2): each function by its own body, an ambient one that
        // reaches a client-only function made client-only (§12.4)
        const all: FnFacts[] = fnFactsOf(sum)
        const places: PlaceFact[] = sum.places

        // the databases
        const rd: RDbs = dbsPass(g, g.files, st)
        st = rd.st
        const dbs: Db[] = scopeDbs(rd.scopes)

        let servers: int[] = []
        let sqls: SqlInfo[] = []
        let creates: int[] = []
        let doms: int[] = []
        const tq: TxQ = txQuerySets(sum.nodes, places, sum.inherited)     // s473: the transitive query sets (§8.9.2 amendment)
        let jOff: JournalOff[] = []                 // s473: `PRAGMA journal_mode = OFF` sites (journalDiags)
        let bangWrites: int[] = []                  // s473: the databases a `!` function writes
        for (const f of all) {
            const pk: PlaceK = placeOf(places, f.sym)
            if (f.modifier && !isLoadName(f.name) && !isBatchName(f.name)) st = addDiag(st, f.file, f.span, "W-DEPRECATED-SERVER-MODIFIER", "`server function " + f.name + "` — the `server` modifier is deprecated (§52.10, Insight 26): write `function " + f.name + "(…)` and let route inference place it (§12.2 — a `" + sqlSigil() + "}` in its body places it on the server)")
            if (f.doms.length > 0 && serverTriggered(f)) {
                for (const du of f.doms) { doms = doms.concat([du.span.start]) }
                st = addDiag(st, f.file, f.span, "E-ROUTE-005", "`" + f.name + "()` cannot be placed: its own body uses " + serverTrigger(f) + " (server-only) AND " + f.doms[0].what + " (client-only, no server referent) — route analysis can put it on neither side (§12.4). Split it: keep the server work in a server function, move the DOM access into a client function, and have the client function call the server one")
            } else if (pk == PlaceK.Split) {
                st = addDiag(st, f.file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + f.name + "()` both runs a `" + sqlSigil() + "}` query and writes `" + f.scan.writes[0].cell + "`, so it is split across the client/server boundary (§19.9.5: \"A function whose body mixes a server-trigger statement with a reactive-assignment statement is split\") — the body split arrives with unit U1d. Until then: return the value from a server function and write the cell in the caller")
            } else if (pk == PlaceK.Server) {
                servers = servers.concat([f.sym])
                st = serverBodyDiags(cx, f, all, places, sum, st)
            } else if (sum.inherited.indexOf(f.sym) >= 0) {
                // s454 (U1b): server-placed by inheritance (§12.2 T5) — its calls
                // run in place on the server: a waiting client function there is
                // a server-side copy of an ambient function (s468: not built — waitingCallees)
                st = waitingCallees(f, all, places, sum, st)
            }
            // (s454: a client function's call of a server function is judged by the
            // binder — §19.9.10, remoteHandled / remoteUnhandled — and lowered by
            // the suspension plan; the U1a refusal is gone)
            // the queries in its body: database, facts, the failable rule
            if (f.failable) st = envelopeDiags(sum, tq, f, st)
            for (const s of f.sqls) {
                if (!f.failable) st = manualTxDiag(f.file, s, "'" + f.name + "', which is not declared '!'", f.name, st)
                const sr: RSqlSite = sqlSiteFacts(g, rd, f.file, fnScope(rd.fns, f.nid), s, f.failable, st)
                st = sr.st
                const si: SqlInfo | not = sr.info
                if (si is given) {
                    sqls = sqls.concat([si])
                    if (sr.creates) creates = creates.concat([si.db.id])
                    if (f.failable && si.kind == SqlKind.SqlWrite) bangWrites = bangWrites.concat([si.db.id])
                    if (journalOff(s.q.chunks)) jOff = jOff.concat([{ file: f.file, span: s.span, fname: f.name, bang: f.failable, db: si.db.id, sym: f.sym }])
                }
            }
        }
        st = journalDiags(sum.nodes, tq, sqls, jOff, bangWrites, dbs, st)
        // s474 (U1e): the implicit per-handler transactions, built (envelopePass)
        const ep: REnv = envelopePass(sum, tq, all, places, sqls, dbs, rd, st)
        st = ep.st
        // §8.1.1 Ownership: a file owns a SQLite database when a query in it creates a table there
        let owned: Db[] = []
        for (const d of dbs) {
            owned = owned.concat([{ sym: d.sym, driver: d.driver, target: d.target, file: d.file, owner: d.driver == Driver.Sqlite && creates.indexOf(d.sym.id) >= 0 }])
        }

        // value positions (§13.7) and action positions
        st = valueServerDiags(g, t, all, places, sum, rd, st)
        st = actionServerDiags(g, t, all, places, rd, st)
        const rl: RLoads = dbLoads(g, servers, st)
        st = rl.st
        return { facts: { servers: servers, sqls: sqls, dbs: owned, places: places, inherited: sum.inherited, plan: noPlan(), loads: rl.loads, envelopes: ep.envs }, doms: doms, st: st }
    }

    // s473 (ruled refusals) — §8.9.2 amendment (S473 review-surfaced 2): "A
    // `?{PRAGMA journal_mode = OFF}` (any case or spacing) inside a `!` function
    // SHALL be a compile error, E-SQL-JOURNAL-OFF (§34). So SHALL one anywhere
    // else whose connection a `!` function's envelope uses — a program-body
    // statement or a non-`!` function on a database that some `!` function in
    // the compilation writes — because the setting is per connection and
    // disables the journal the rollback needs." A `?{}` in a value or action
    // position is refused already (E-VALUE-SERVER-CALL / the U1d split), so the
    // sites here are the functions'.
    // #1690 review F3: both halves read the transitive reach — a site in a
    // non-`!` function a `!` function calls IS on that `!` function's
    // connection, and a `!` function writes a database through the non-`!`
    // functions it calls too.
    type JournalOff:struct = { file: string, span: ASpan, fname: string, bang: boolean, db: int, sym: int }

    fn journalDiags(nodes: Callable[], tq: TxQ, sqls: SqlInfo[], js: JournalOff[], ownWrites: int[], dbs: Db[], st0: AS) -> AS {
        let st: AS = st0
        const reach: boolean[] = bangReach(nodes, tq)
        let bangWrites: int[] = ownWrites
        let i: int = 0
        while (i < nodes.length) {
            if (nodes[i].kind == CallableK.KFn && nodes[i].f.failable) {
                for (const a of tq.qs[i]) {
                    const site: SqlSite = nodes[a.root].f.sqls[a.pos]
                    for (const si of sqls) {
                        if (si.nid == site.nid && si.kind == SqlKind.SqlWrite) bangWrites = bangWrites.concat([si.db.id])
                    }
                }
            }
            i = i + 1
        }
        for (const j0 of js) {
            const k: int = nodeIdx(nodes, j0.sym)
            let j: JournalOff = j0
            if (k >= 0 && reach[k]) j = { file: j0.file, span: j0.span, fname: j0.fname, bang: true, db: j0.db, sym: j0.sym }
            const why: string = "`PRAGMA journal_mode = OFF` turns off the rollback journal for the whole connection, and a `!` function's all-or-nothing guarantee (§8.9.2, §19.10) needs that journal to roll back"
            if (j.bang) {
                st = addDiag(st, j.file, j.span, "E-SQL-JOURNAL-OFF", "'" + j.fname + "' is declared '!' (or is called by a function declared '!') and runs `PRAGMA journal_mode = OFF` — " + why + " (§8.9.2, S473). Remove it, or use another `journal_mode` (`WAL`, `DELETE`, … stay admitted, §14.8.10)")
            } else if (sameDbIn(dbs, bangWrites, j.db)) {
                st = addDiag(st, j.file, j.span, "E-SQL-JOURNAL-OFF", "`PRAGMA journal_mode = OFF` in '" + j.fname + "' sets the connection a `!` function of this program writes through — " + why + " (§8.9.2, S473). Remove it, or use another `journal_mode` (`WAL`, `DELETE`, … stay admitted, §14.8.10)")
            }
        }
        return st
    }

    // s474 r1 (review F3): `ids` holds a database the same as `id` (dbKey — not the same spelling, the same database).
    fn sameDbIn(dbs: Db[], ids: int[], id: int) -> boolean {
        const want: string = dbKey(dbs, { id: id, hint: "" })
        for (const x of ids) {
            if (dbKey(dbs, { id: x, hint: "" }) == want) return true
        }
        return false
    }

    // s473 (Lane B) — the program's `<db>` cells, each with its load (a server
    // function by construction) and the Sym of the client's module-level value
    // its load answered (CoreProgram.loads; the cell's init is `Local(val)`).
    // A load that is not server-placed (only an erroring program has one) is
    // refused here, fail closed: its value would otherwise be evaluated on the client.
    type RLoads:struct = { loads: DbLoad[], st: AS }

    fn dbLoads(g: Globals, servers: int[], st0: AS) -> RLoads {
        let st: AS = st0
        let out: DbLoad[] = []
        const pd: DeclSrc | not = findDeclSrc(g, g.program)
        if (pd is not) return { loads: out, st: st }
        for (const fs of g.fns) {
            if (isDbLoad(g, fs.f.nid)) {
                if (servers.indexOf(fs.info.sym.id) < 0) {
                    st = addDiag(st, fs.info.file, fs.info.span, "E-BOOTSTRAP-UNSUPPORTED", "the `<db>` cell `" + fs.f.name + "` could not be placed on the server (§8.1.3: its value is evaluated on the server, per request) — refused rather than evaluated on the client")
                } else {
                    let found = false
                    for (const f of pd.info.fields) {
                        if (f.nid == loadCellNid(g, fs.f.nid)) {
                            found = true
                            // s473 r1 (F4): a locked cell's other grants never apply on the client
                            // (§8.1.3 item 5), so an edit grant without `replace` is dead weight — refused
                            // at the declaration, not discovered at the first write
                            if (grantsAny(f.grants) && !grantsAdmit(f.grants, EditKind.Replace)) {
                                st = addDiag(st, fs.info.file, f.span, "E-DB-CELL-EDIT-GRANT", "`@" + f.sym.hint + "` is a locked `<db>` cell whose type grants edits but not `replace` — a locked `<db>` cell is read-only on the client, so those grants can never be used (§8.1.3 item 5). Drop them (a read-only cell), or grant `replace` (a tape written by code inside its `<db>`, landing locally)")
                            }
                            const rv: RSym = mint(st, f.sym.hint + "$db")
                            st = rv.st
                            out = out.concat([{ cell: f.sym, fn: fs.info.sym, val: rv.s }])
                        }
                    }
                    // a cell that is not the top-level program's field (only a `<db>` refused
                    // upstream — at file top level, in a nested `<program>` — has one): fail closed
                    if (!found) st = addDiag(st, fs.info.file, fs.info.span, "E-BOOTSTRAP-UNSUPPORTED", "the `<db>` cell `" + fs.f.name + "` is not a cell of the top-level `<program>` — a `<db>` cell elsewhere is not in the bootstrap (§8.1.3)")
                }
            }
        }
        return { loads: out, st: st }
    }

    // s473: how a server-placed function is named in a message (a `<db>` cell's load by its cell)
    fn serverFnLabel(f: FnFacts) -> string {
        if (isLoadName(f.name)) return "the value of the `<db>` cell `" + f.name + "`"
        return "server function `" + f.name + "()`"
    }

    fn serverTrigger(f: FnFacts) -> string {
        if (f.sqls.length > 0) return "a `" + sqlSigil() + "}` query"
        if (f.foreigns.length > 0) return "a `_={ … }=` foreign code block"
        // s473: a `<db>` cell's load (`@name`) is server code by its placement (§8.1.3)
        if (isLoadName(f.name)) return "being a `<db>` cell's value (evaluated on the server per request, §8.1.3)"
        return "the `server` modifier"
    }

    // s454 (U1b) — E-ERROR-016 (§19.9.10 "A declared variant named
    // `Transport`"): "A declared variant named `Transport` with any other
    // payload (or none) SHALL be a compile error at the client call site …
    // The message names `f`, its enum, and the payload `(t: ServerCallError)`."
    // At a CLIENT call site of `f` only (a server→server call has no transport
    // half, so nothing collides there).
    fn transportConflict(g: Globals, f: FnInfo, file: string, span: ASpan, st: AS) -> AS {
        if (!f.serverOwn || !f.failable) return st
        const e: Sym | not = f.err
        if (e is not) return st
        if (transportShape(g.types, e, g.sceSym) != 1) return st
        return addDiag(st, file, span, "E-ERROR-016", "`" + f.name + "` is a server function and this call is made on the client, so it can also fail on the wire — the call's failure set is `" + e.hint + "`'s variants plus `Transport(t: ServerCallError)` (§19.9.10). But `" + e.hint + "` already declares a variant named `Transport` with a different payload, and the call's `Transport` cannot be both. Declare it as exactly `Transport(t: ServerCallError)` (then it IS the wrapper), or rename it")
    }

    // s454 (U1b) — a function that runs on the server (wholly, or by
    // inheritance) calling a client function that WAITS (it makes a client
    // call of a server function): on the server that callee would have to run
    // its server calls in place, which is the per-side emission of an ambient
    // function. s468 (U1c): U1c emits an ambient function on each side that
    // reaches it (§13.4 "TWO representations") — but THIS one's two
    // representations differ in their bodies (its server calls are client
    // calls on one side and in-place calls on the other), and Core holds one
    // body per function. Still refused, fail closed (a later slice: a binder-
    // minted server copy, lowered under the server plan).
    fn waitingCallees(f: FnFacts, all: FnFacts[], ps: PlaceFact[], sum: Summary, st0: AS) -> AS {
        let st: AS = st0
        for (const r of fnRefs(all, f)) {
            if (placeOf(ps, r.sym) != PlaceK.Server && sum.inherited.indexOf(r.sym) < 0 && !r.asValue) {
                const w: Reach | not = waitsOf(sum, r.sym)
                if (w is given) st = addDiag(st, r.file, r.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + f.name + "()` runs on the server and calls `" + r.name + "`, a client function that waits for the server (`" + w.chain.join(" → ") + "`) — on the server that call would be made in place, which needs a second, server-side copy of `" + r.name + "` whose server calls are made in place (not in the bootstrap: Core holds one body per function — the server artifact emits a shared function as it is, which is right only for one that waits on nothing). Until then call the server function directly")
            }
        }
        return st
    }

    // s473 D29 — `at` lies inside the text of a `?{}` that writes (not a SELECT / WITH … SELECT,
    // sql.scrml `sqlFacts`): a cell read there is one of the query's bound parameters (§52.11).
    fn inWriteSqlSlot(sqls: SqlSite[], at: ASpan) -> boolean {
        for (const q of sqls) {
            if (at.start >= q.span.start && at.end <= q.span.end && sqlFacts(q.q.chunks).kind != SqlKind.SqlSelect) return true
        }
        return false
    }

    // A wholly-server function's own body and call graph (§6.6.9, §12.4, §12.5.3).
    fn serverBodyDiags(cx: PlaceCx, f: FnFacts, all: FnFacts[], ps: PlaceFact[], sum: Summary, st0: AS) -> AS {
        let st: AS = st0
        let seen: string[] = []
        for (const r of f.reads) {
            if (seen.indexOf(r.what) < 0 && r.what.substring(0, 1) == "@" && isDbCellName(cx.g, r.what.substring(1))) {
                // s473 — RULED S472 ("`<db>` body + client reads", item 4): "Server code
                // reading `@x` of a db cell is REFUSED for now (`E-DB-CELL-SERVER-READ`)."
                // §8.1.3 item 6. (A db cell's own value is server code too — its load.)
                seen = seen.concat([r.what])
                const who: string = isLoadName(f.name) ? "the value of the `<db>` cell `" + f.name + "` (its load, run on the server per request)" : "server function `" + f.name + "()`"
                st = addDiag(st, f.file, r.span, "E-DB-CELL-SERVER-READ", who + " reads `" + r.what + "`, a `<db>` cell — on the server `" + r.what + "` would be the browser's copy, which server code never reads (S472 ruling item 4, §8.1.3). Run the query that loads it here instead, or call a function that does")
            } else if (seen.indexOf(r.what) < 0 && !f.modifier && inWriteSqlSlot(f.sqls, r.span)) {
                // s473 D29 ("one code per rule, the more specific winning"): a client cell read as a
                // bound parameter of a `?{}` write outside a `server` function is §52.11 E-AUTH-001 —
                // the specific case of the E-REACTIVE-003 rule (the function is on the server only
                // because of that `?{}`, so the browser's value would never reach it).
                seen = seen.concat([r.what])
                st = addDiag(st, f.file, r.span, "E-AUTH-001", "`" + r.what + "` is client-local and cannot be used as a bound parameter in a `?" + "{}` persistence block (§52.11): `" + f.name + "()` runs on the server because of that `?" + "{}`, where the browser's `" + r.what + "` is never sent. Pass it to a server function as an argument first (a parameter here, `" + f.name + "(" + r.what + ")` at the call site)")
            } else if (seen.indexOf(r.what) < 0) {
                seen = seen.concat([r.what])
                st = addDiag(st, f.file, r.span, "E-REACTIVE-003", serverFnLabel(f) + " (placed on the server by " + serverTrigger(f) + ") reads `" + r.what + "` — a reactive cell lives in the browser (§6.6.9) and is not sent with the call, so on the server it would be `undefined`. Pass the value as an argument (`" + f.name + "(" + r.what + ")` at the call site, a parameter here), or have the server compute it itself inside the query")
            }
        }
        for (const w of f.scan.writes) {
            st = addDiag(st, w.file, w.span, "E-RI-002", "server function `" + f.name + "()` writes `" + w.cell + "` — the `server` modifier runs the whole body on the server, where reactive cells do not exist (§6.6.9), so the write would be lost. Remove the modifier and let the body split around its server work (§19.9.5), or return the value and write the cell in the caller")
        }
        for (const ref of fnRefs(all, f)) {
            if (placeOf(ps, ref.sym) != PlaceK.Server) {
                const c: Reach | not = clientReachOf(sum, ref.sym)
                if (c is given) {
                    st = addDiag(st, ref.file, ref.span, "E-ROUTE-002", "server function `" + f.name + "()` reaches client-only code: `" + [f.name + "()"].concat(c.chain).join(" → ") + "` " + c.what + " (§12.4 — reactive state and the DOM live in the browser, S451 R2). Pass the value in as an argument, extract the shared logic into a pure function (§33) that touches no cell, or duplicate the logic inside `" + f.name + "()`")
                }
                const u: Reach | not = routeOpenOf(sum, ref.sym)
                if (u is given) {
                    st = addDiag(st, ref.file, ref.span, "E-ROUTE-001", "server function `" + f.name + "()` cannot be fully analyzed for route placement: `" + [f.name + "()"].concat(u.chain).join(" → ") + "` — " + u.what + " (§12.4: \"SHALL be a compile error\"). Call a declared scrml function by its name")
                }
            }
        }
        for (const u2 of f.scan.unproven) {
            st = addDiag(st, u2.file, u2.span, "E-ROUTE-001", "server function `" + f.name + "()` cannot be fully analyzed for route placement: " + u2.what + " (§12.4: \"SHALL be a compile error\"). Call a declared scrml function by its name")
        }
        st = waitingCallees(f, all, ps, sum, st)
        return wireDiags(cx, f, st)
    }

    // §12.5.3 E-ROUTE-003 / E-ROUTE-004 against the §57 codec: a declaration's
    // instance (a live state object) is not serializable; a type the codec
    // refuses to describe (codec.scrml `WireBuild.why` — e.g. a struct field
    // named `__scrml_absent`) is refused, not called non-serializable. (s454:
    // payload enums are described — §57.8, S451 R8.)
    fn wireDiags(cx: PlaceCx, f: FnFacts, st0: AS) -> AS {
        let st: AS = st0
        const fs: FnSrc | not = fnSrcOf(cx.g, f.sym)
        if (fs is not) return st
        for (const p of fs.f.params) {
            const pty: Type | not = boundParamType(bindFact(cx.t.binds, p.nid))
            if (pty is given) st = wireDiag(cx, f, pty, "E-ROUTE-004", "parameter `" + p.name + "`", p.span, st)
        }
        const rt: Type | not = fs.info.ret
        if (rt is given) {
            const r: AType | not = fs.f.ret
            let sp: ASpan = f.span
            if (r is given) sp = r.span
            st = wireDiag(cx, f, rt, "E-ROUTE-003", "return type", sp, st)
        }
        return st
    }

    fn wireDiag(cx: PlaceCx, f: FnFacts, ty: Type, code: string, what: string, span: ASpan, st: AS) -> AS {
        const state: string = stateTypeIn(cx.g, ty)
        if (state != "") return addDiag(st, f.file, span, code, "server function `" + f.name + "()`'s " + what + " is not serializable: it holds `" + state + "`, a declaration's instance — a live state object (it has identity; it is not a value), with no wire form (§12.5.3). Pass the values it holds instead")
        const wb: WireBuild = wireBuild(typesProgram(cx.g), ty)
        if (wb.table is not) return addDiag(st, f.file, span, "E-BOOTSTRAP-UNSUPPORTED", "server function `" + f.name + "()`'s " + what + " has no wire descriptor in the bootstrap's codec: " + wb.why.join("; "))
        return st
    }

    // The declaration a type names (directly or inside a sequence / `T | not`), "" — none.
    fn stateTypeIn(g: Globals, ty: Type) -> string {
        return match ty {
            .Named(sym: s) :> declTypeName(g, s)
            .Seq(elem: e) :> stateTypeIn(g, e)
            .Maybe(inner: i) :> stateTypeIn(g, i)
            .Int :> ""
            .Num :> ""
            .Str :> ""
            .Bool :> ""
        }
    }

    fn declTypeName(g: Globals, s: Sym) -> string {
        for (const d of g.decls) {
            if (d.info.sym.id == s.id) return d.info.sym.hint
        }
        return ""
    }

    fn boundParamType(f: BindFact | not) -> Type | not {
        return match f {
            .BParam(sym: s, ty: ty) :> ty
            .BLoop(label: x) :> not
            .BJump(target: x) :> not
            .BBind(sym: s) :> not
            .BGiven(sym: s) :> not
            not :> not
        }
    }

    fn fnSrcOf(g: Globals, sym: int) -> FnSrc | not {
        for (const fs of g.fns) {
            if (fs.info.sym.id == sym) return fs
        }
        return not
    }

    // One `?{}` in a function body: its database (§8.1.1), the failable rule
    // (§19.8.3), and its facts (sql.scrml).
    type RSqlSite:struct = { info: SqlInfo | not, creates: boolean, st: AS }

    fn sqlSiteFacts(g: Globals, rd: RDbs, file: string, scope: int, s: SqlSite, failable: boolean, st0: AS) -> RSqlSite {
        // (s451 Ue: the §19.8.3 failable rule — E-ERROR-002 — is the binder's, resolveSql)
        let st: AS = st0
        if (file != g.entry) {
            st = addDiag(st, file, s.span, "E-BOOTSTRAP-UNSUPPORTED", "a `" + sqlSigil() + "}` in an imported module makes it a module-with-db-context (§44.7.1), which is not in the bootstrap — keep the query in the program's file")
            return { info: not, creates: false, st: st }
        }
        if (scope < 0) {
            st = addDiag(st, file, s.span, "E-SQL-004", sql004Text())
            return { info: not, creates: false, st: st }
        }
        const pd: ScopeDb | not = scopeDbOf(rd.scopes, scope)
        if (pd is not) return { info: not, creates: false, st: st }
        const db: Db | not = pd.db
        if (db is not) return { info: not, creates: false, st: st }   // its `db=` was refused (E-SQL-005, reported)
        // s468 (U1c fix round 1, F4) — §8.1: every `${…}` SHALL be a bound parameter; one
        // inside a quoted run or a comment cannot be (the driver would read its placeholder as
        // text: `LIKE '%?%'` matches a literal `?`, and the value is silently lost)
        const sq: SlotQuote = slotInLiteral(s.q.chunks)
        if (sq.slot >= 0) {
            // s473 (ruled refusals): the S468 code, §8.1 / §34 (was E-BOOTSTRAP-UNSUPPORTED)
            st = addDiag(st, file, s.span, "E-SQL-SLOT-IN-LITERAL", "`" + slotSigil() + "…}` #" + (sq.slot + 1) + " of this `" + sqlSigil() + "}` stands inside " + sq.what + " — there it cannot be a bound parameter (§8.1: every `" + slotSigil() + "…}` SHALL be one): the driver would read it as text and the value would be lost. Build the whole value outside the quotes and bind it — `LIKE " + slotSigil() + "\"%\" + q + \"%\"}`, not `LIKE '%" + slotSigil() + "q}%'`")
            return { info: not, creates: false, st: st }
        }
        st = statementDiags(file, s, st)
        const sf: SqlFacts = sqlFacts(s.q.chunks)
        return { info: { nid: s.nid, db: db.sym, kind: sf.kind, reads: sf.reads, writes: sf.writes, columns: sf.columns }, creates: sf.createsTable, st: st }
    }

    // s473 (boot-failclosed-sql-protect) — what a program-body `?{}` may hold,
    // in a compilation with a database (this site has one: sqlSiteFacts resolved
    // it). §8.1.2: exactly ONE statement (E-SQL-MULTIPLE-STATEMENTS — "The
    // message SHALL name the fix: one `?{}` per statement; statements that must
    // succeed or fail together go in a `transaction { }` block"); §14.8.10 item
    // (1): that statement on the closed allow-list (E-SQL-PROGRAM-STATEMENT-NOT-
    // ADMITTED), and no `tenant_id` column outside the tenant set — which on the
    // bootstrap is EMPTY, since `<schema>` / `<db tables=>` are refused
    // (E-TENANT-UNDECLARED). Both read sql.scrml's one scanner. Before s473 both
    // compiled clean: `INSERT …; DELETE FROM notes` ran its DELETE on SQLite.
    fn statementDiags(file: string, s: SqlSite, st: AS) -> AS {
        const ms: MultiStmt = multiStatement(s.q.chunks)
        if (ms.multi) {
            let why: string = ""
            if (ms.plain) why = " (Found by reading every `;` in the query text as a statement boundary: this query holds a comment or a quoting form the compiler cannot read exactly on every database, so a `;` inside a comment or a string counts too. Drop the comment, or bind the text as a value with `" + slotSigil() + "…}`.)"
            return addDiag(st, file, s.span, "E-SQL-MULTIPLE-STATEMENTS", "this `" + sqlSigil() + "}` holds more than one SQL statement — a `;` followed by more SQL begins a second one, and a program-body query SHALL hold exactly one (§8.1.2): on SQLite every statement after the first runs. Write one `" + sqlSigil() + "}` per statement; statements that must succeed or fail together go in a `transaction { }` block (§8.5.3, §19.10)." + why)
        }
        const v: StmtVerdict = programStatement(s.q.chunks)
        if (v.code == "E-TENANT-UNDECLARED") {
            let rel: string = "a relation"
            if (v.why != "") rel = "`" + v.why + "`"
            return addDiag(st, file, s.span, "E-TENANT-UNDECLARED", "this `" + sqlSigil() + "}` gives " + rel + " a `tenant_id` column, and " + rel + " is not in the compilation's tenant set (§14.8.10 item (1), S456): the tenant floor would not scope it, so every tenant's rows would reach every request. Declare it in `<schema>` so the floor scopes it — `<schema>` / `<db tables=>` are not in the bootstrap yet, so on the bootstrap the tenant set is empty — or, when its rows are not tenant data, rename the column")
        }
        if (v.code != "") {
            return addDiag(st, file, s.span, v.code, "this `" + sqlSigil() + "}` is not on the program-body allow-list (§14.8.10 item (1), S456): " + v.why + ". A program-body query is DML (`SELECT` / `WITH` / `INSERT` / `UPDATE` / `DELETE` / `REPLACE`), a spelled `CREATE [TEMP] TABLE name (…)`, one `ALTER TABLE … ADD [COLUMN]`, an fts5 `CREATE VIRTUAL TABLE`, transaction control, `CREATE [UNIQUE] INDEX`, or an admitted `PRAGMA`. Declare anything else in `<schema>`")
        }
        return st
    }

    // the `${` of a SQL value slot, for messages, in two pieces (as sqlSigil)
    fn slotSigil() -> string { return "$" + "{" }

    fn sql004Text() -> string {
        return "this `" + sqlSigil() + "}` has no database scope (§8.1.1): no `<program db=…>`, no `<program>` whose single direct-child `<db src=…>` supplies its database, and no `<db src=…>` encloses it — whatever the number of databases in the file. Put `db=` on the enclosing `<program>` (`<program db=\"./app.db\">` for SQLite, `<program db=\"postgres://…\">` for PostgreSQL), or move the query inside the `<db>` it means"
    }


    // §19.8.3 (S451 R11): a `?{}` outside any function (a value / action
    // position), not handled at the site. (In a function body the binder
    // reports it — resolveSql — where the enclosing `!` and `defer` are known.)
    fn errorTwo(file: string, s: SqlSite, failable: boolean, st: AS) -> AS {
        if (failable || s.q.handled) return st
        return addDiag(st, file, s.span, "E-ERROR-002", "this `" + sqlSigil() + "}` query is failable (§19.8.3, S451): outside a `!` function it must be handled at the site — a `!{ … }` handler on the query, or a `match` on its result — or moved into a `!` function, where a failure propagates (§19.8.2). An unhandled query is E-ERROR-002. (\"No row\" is not a failure: `.get()` still returns `not`, `.all()` still `[]`.)")
    }

    // s452 — §19.10.4 (S451): manual transaction control (`?{BEGIN}`,
    // `?{COMMIT}`, `?{ROLLBACK}`, `?{SAVEPOINT}`, `?{RELEASE}`, `?{END}`)
    // "written where no enclosing function is declared `!` (in a function
    // without `!`, or at a body top) SHALL be a compile error: E-ERROR-015" —
    // the SPEC's message. `where` names the place; `fname` the function ("" —
    // a body top). E-ERROR-015 is the one transaction diagnostic outside a `!`
    // function, as §19.10.4 requires there. (Inside a `!` function manual
    // transaction control is REFUSED — envelopeDiags.)
    //
    // s473 (boot-failclosed-sql-protect) refused every transaction shape the
    // bootstrap did not build (before s473 they compiled clean and ran
    // non-atomically — audit S473 part 2 §8.9.2, part 3 §19.10). s474 (U1e)
    // BUILDS the implicit per-handler transaction (§8.9.2 / §19.10.5) over the
    // S473 transitive query set, with its §19.10.6 nesting and per-connection
    // gate — envelopePass below. What stays refused here:
    //  §19.10.4 / §19.10.6 (S451 R6) MANUAL transaction control in a `!`
    //        function: "A manual transaction is held by the invocation of the
    //        function that opened it … one still open at the function's return
    //        is rolled back and reported", and an explicit `?{BEGIN}` suppresses
    //        the implicit envelope with W-BATCH-001 (§8.9.2). The runtime's gate
    //        exists now (server-runtime.js), but nothing holds a manual
    //        transaction by its function's invocation or rolls back one left
    //        open at its return — so a `fail` between `?{BEGIN}` and
    //        `?{COMMIT}` would still leave the SHARED connection inside the open
    //        transaction. Outside a `!` function the same SQL is E-ERROR-015
    //        (manualTxDiag) — so manual transaction control is refused in EVERY
    //        server function. No §8 / §19 code names "not built":
    //        E-BOOTSTRAP-UNSUPPORTED.
    //
    // THE TRIGGER IS THE TRANSITIVE QUERY SET (§8.9.2 amendments S473
    // review-surfaced 1 and #1690 review F10): "every `?{}` reached from the
    // `!` body, its own and every function's it calls, `!` or not … A query is
    // counted once per time it is reached". The set is txQuerySets' (one
    // closure over the call graph, effects.scrml closeDim): a call is followed
    // whatever the callee's placement and whether or not it is `!` (an inner
    // `!` runs as a nested savepoint). "Inside a loop" (repeatsInBlock): a
    // query, or a call reaching one, in a region that may run more than once —
    // and a query reached through a recursive function.
    //
    // F11 (ruled S473, #1690 review — a PERMANENT refusal, §19.10.5): "a
    // client-placed `!` function that calls two or more server functions is a
    // PERMANENT named refusal, not an interim one: no transaction can span two
    // requests." Counted: each call of a server function (a remote call — one
    // request) the client-placed body makes, directly or through client-side
    // callees, and one in a repeated region counts twice (remoteRuns).
    fn envelopeDiags(sum: Summary, tq: TxQ, f: FnFacts, st0: AS) -> AS {
        let st: AS = st0
        let manual = false
        for (const s of f.sqls) {
            const kw: string = txControl(s.q.chunks)
            if (kw != "") {
                manual = true
                st = addDiag(st, f.file, s.span, "E-BOOTSTRAP-UNSUPPORTED", "Manual transaction control '" + kw + "' in '" + f.name + "', which is declared '!' — the bootstrap does not build what §19.10.6 requires of it (S451 R6): the transaction held by this invocation behind the database's per-connection gate, and rolled back and reported when the function returns with it still open. Without them a `fail` or an error between `BEGIN` and `COMMIT` leaves the shared connection inside the open transaction, and later requests run in it. Remove the transaction control: the bootstrap builds the implicit per-handler transaction (§8.9.2), so a `!` function whose transitive query set holds two or more queries already runs them all in one transaction, rolled back on a `fail` or an error")
            }
        }
        if (manual) return st
        // s474 (client-bang composition): a client-placed `!` function's two or more server
        // calls are no longer refused here — composePass composes them into one request with
        // one envelope, and refuses (E-TX-CLIENT-MULTI-CALL) only the browser-split residue
        return st
    }

    // =========================================================================
    // s474 (boot-client-bang-composition) — A CLIENT `!` FUNCTION'S SERVER CALLS
    // COMPOSE INTO ONE REQUEST WITH ONE ENVELOPE. Ruling: user-voice-scrml.md S474
    // "permanent-restrictions re-review: the four one-way doors", door 2: "F11
    // becomes INTERIM: a client `!`'s server calls compose into one request with
    // one envelope (planner composition, per §19.9.9.8 rule 1) … Only calls
    // separated by browser work that cannot move stay refused"; and "capability
    // over limitation" item 2: "a client `!` whose one server call is a non-`!`
    // server function running two queries … the compiler wraps that server call in
    // the transaction envelope when the caller is `!`".
    //
    // §19.9.9.8 rule 1: "A statement that calls a function placed on the server
    // SHALL be server-tier at the call site: the callee runs in the same request";
    // rule 2: "every statement between them SHALL join the server batch"; rule 3:
    // "Only movable statements move … A statement that needs the browser … SHALL
    // NOT be relocated"; rule 4: "Statements before the function's first server
    // statement are never moved: `@busy = true` ahead of the query renders before
    // the request leaves."
    //
    // THE BUILD. A client-placed `!` function F whose server calls need one
    // transaction (two or more requests — tq.remote — or one call of a non-`!`
    // server function whose queries need one) is planned here over its TOP-LEVEL
    // statements S[0..n):
    //   - the BATCH is S[lo..hi]: `lo` the first statement that calls a server
    //     function, `hi` the last — extended (rule 1, to a fixpoint) over every later
    //     statement that reads a local the batch declares;
    //   - S[0..lo) stays on the client and runs first (rule 4, the spinner);
    //   - a statement of the batch that only WRITES CELLS (no server call, no cell
    //     read, no exit, reading nothing the batch computes) is DEFERRED: the client
    //     applies it after the batch commits, in source order — its value is the one
    //     the batch would return in the cell envelope (§19.9.9.8 rule 1), computed
    //     from what the client already holds;
    //   - S(hi..n) stays on the client and runs after the batch commits.
    // composeFiles then writes the plan into the program, as the author would by
    // hand ("compose the calls in one server `!` function and call that once"): a
    // server `!` function `#F` (a name no identifier can spell — isBatchName) holding
    // the batch, with F's parameters and the client locals the batch reads, and F's
    // batch replaced by ONE call `#F(…)?` (`return #F(…)?` when the batch returns).
    // analyzeLinked analyzes the composed program again, so the batch is an ordinary
    // routed server `!` function: its envelope is envelopePass's (standalone when its
    // transitive query set needs one — BEGIN IMMEDIATE when a query it reaches
    // writes, S474 ruling 5), its callees run in place (an inner `!` as a savepoint,
    // F10), its failure is the routed `fail` wire shape (with #1703's production
    // blanking of driver text), and F's `?` re-fails it as F's own variant.
    //
    // What stays refused:
    //  - PERMANENT (the residue of F11): a statement of the batch that needs the
    //    browser — a DOM global, a `<host>` binding, a client function reaching one.
    //    Its calls would be two requests, and no transaction spans two requests
    //    (§19.10.5): E-TX-CLIENT-MULTI-CALL, at that statement.
    //  - INTERIM (E-BOOTSTRAP-UNSUPPORTED, the capable form named in each message):
    //    a cell READ in the batch (§6.6.9 marshal into the request), a cell write
    //    that needs a batch value (the cell envelope), a statement after the batch
    //    reading a batch local that cannot join it, a batch `return` with client
    //    work after it, a client function in the batch that reaches client state or
    //    a server call, a top-level `defer` or an effect in the batch, a `lin`
    //    parameter, a parameter or a client local with no nameable type, a `match`
    //    on a non-`!` server call.
    //  - F's error type must hold `Transport(t: ServerCallError)`: the composed
    //    request can fail on the wire (§19.9.10), and F re-fails that failure as its
    //    own (E-ERROR-010 otherwise).
    // =========================================================================
    export type ComposeExtra:struct = { name: string, span: ASpan, ty: AType | not, vt: Type | not }
    // `name`: F's name (analyzeLinked maps the batch's names back to it, review L2); `notes`: the
    // warnings the plan raises (W-TX-FAIL-AFTER-COMMIT, W-TX-ARM-UNREACHABLE — reported with the
    // composed program's diagnostics); `late`: how many of them are W-TX-FAIL-AFTER-COMMIT.
    export type ComposePlan:struct = { fnNid: int, name: string, lo: int, hi: int, deferred: int[], extra: ComposeExtra[], strip: int[], drop: int[], returns: boolean, notes: Diag[], late: int }
    type RCompose:struct = { plans: ComposePlan[], st: AS }
    type RPlan:struct = { plan: ComposePlan | not, st: AS }

    // A synthesized batch function's name: `#` + the client function's (no identifier spells it).
    export fn isBatchName(n: string) -> boolean { return n.substring(0, 1) == "#" }

    fn hasErrorDiag(ds: Diag[]) -> boolean {
        for (const d of ds) {
            if (d.severity == Severity.Error) return true
        }
        return false
    }

    // What one top-level statement does, by the function's own facts (span containment).
    // `remote`: the server functions it calls; `via`: a client function it calls that
    // makes a server call; `browser`: what it uses that needs the browser; `client`: a
    // client function it calls that reaches client state; `read` / `write`: a cell.
    type StmtFx:struct = { remote: string[], via: string, browser: string, client: string, read: string, write: string }

    fn spanIn(sp: ASpan, outer: ASpan) -> boolean { return sp.start >= outer.start && sp.end <= outer.end }

    fn stmtFx(sum: Summary, tq: TxQ, places: PlaceFact[], dr: boolean[], f: FnFacts, sp: ASpan) -> StmtFx {
        let remote: string[] = []
        let via: string = ""
        let browser: string = ""
        let client: string = ""
        let read: string = ""
        let write: string = ""
        for (const r of f.scan.refs) {
            const j: int = nodeIdx(sum.nodes, r.sym)
            if (spanIn(r.span, sp) && isFnNode(sum.nodes, j)) {
                const pk: PlaceK = placeOf(places, sum.nodes[j].f.sym)
                if (isServerPlace(pk)) {
                    const nm: string = "`" + sum.nodes[j].f.name + "`"
                    if (remote.indexOf(nm) < 0) remote = remote.concat([nm])
                } else if (dr[j]) {
                    if (browser == "") browser = "a call of `" + sum.nodes[j].label + "`, which uses the browser"
                } else if (tq.remote[j] > 0) {
                    if (via == "") via = sum.nodes[j].label
                } else if (pk == PlaceK.Client) {
                    if (client == "") client = sum.nodes[j].label
                }
            }
        }
        for (const d of f.doms) {
            if (browser == "" && spanIn(d.span, sp)) browser = d.what
        }
        for (const c of f.reads) {
            if (read == "" && spanIn(c.span, sp)) read = c.what
        }
        for (const w of f.scan.writes) {
            if (write == "" && spanIn(w.span, sp)) write = w.cell
        }
        return { remote: remote, via: via, browser: browser, client: client, read: read, write: write }
    }

    // The callables that reach a DOM global or a `<host>` binding through client-side calls.
    fn domReach(nodes: Callable[], tq: TxQ, places: PlaceFact[]) -> boolean[] {
        let r: boolean[] = []
        for (const c of nodes) { r = r.concat([c.kind == CallableK.KFn && c.f.doms.length > 0]) }
        let changed = true
        while (changed) {
            changed = false
            let i: int = 0
            while (i < nodes.length) {
                if (!r[i]) {
                    for (const j of tq.edges[i]) {
                        if (!r[i] && r[j] && !isServerPlace(placeOf(places, nodes[j].f.sym))) {
                            r = setBoolAt(r, i, true)
                            changed = true
                        }
                    }
                }
                i = i + 1
            }
        }
        return r
    }

    // ---- the composition fold: what a run of statements names ----------------------
    // `names`: every bare-name expression (its nid); `assigns`: the root name of every
    // assignment target; `rets`: a `return`; `exits`: a `fail` or a `?`; `effects`: an
    // effect statement; `handled`: every handling form whose subject is a call of a name.
    type CHand:struct = { nid: int, callee: int, how: int, arms: AArm[] }
    // `clocks` (review L4): every bare `Date` / `performance` name — the browser's clock is not the server's.
    type CFold:struct = { names: int[], assigns: int[], rets: boolean, exits: boolean, effects: boolean, handled: CHand[], clocks: int[] }

    fn cf0() -> CFold { return { names: [], assigns: [], rets: false, exits: false, effects: false, handled: [], clocks: [] } }

    fn cfWith(a: CFold, names: int[], assigns: int[], rets: boolean, exits: boolean, effects: boolean, handled: CHand[]) -> CFold {
        return { names: names, assigns: assigns, rets: rets, exits: exits, effects: effects, handled: handled, clocks: a.clocks }
    }

    fn cfName(a: CFold, nid: int, n: string) -> CFold {
        let c: int[] = a.clocks
        if (n == "Date" || n == "performance") c = c.concat([nid])
        return { names: a.names.concat([nid]), assigns: a.assigns, rets: a.rets, exits: a.exits, effects: a.effects, handled: a.handled, clocks: c }
    }

    fn cfStmts(ss: AStmt[], a0: CFold) -> CFold {
        let a: CFold = a0
        for (const s of ss) { a = cfStmt(s, a) }
        return a
    }

    fn cfMaybeBlock(b: ABlock | not, a: CFold) -> CFold {
        if (b is not) return a
        return cfStmts(b.stmts, a)
    }

    fn cfMaybe(e: AExpr | not, a: CFold) -> CFold {
        if (e is not) return a
        return cfExpr(e, a)
    }

    fn cfExprs(es: AExpr[], a0: CFold) -> CFold {
        let a: CFold = a0
        for (const e of es) { a = cfExpr(e, a) }
        return a
    }

    fn cfRet(a: CFold) -> CFold { return cfWith(a, a.names, a.assigns, true, a.exits, a.effects, a.handled) }
    fn cfExit(a: CFold) -> CFold { return cfWith(a, a.names, a.assigns, a.rets, true, a.effects, a.handled) }
    fn cfEffect(a: CFold) -> CFold { return cfWith(a, a.names, a.assigns, a.rets, a.exits, true, a.handled) }

    fn cfStmt(s: AStmt, a: CFold) -> CFold {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> cfExpr(e, a)
            .Local(name: n, init: i) :> cfExpr(i, a)
            .Return(e: e) :> cfMaybe(e, cfRet(a))
            .If(cond: c, thenB: tb, elseB: eb) :> cfMaybeBlock(eb, cfStmts(tb.stmts, cfExpr(c, a)))
            .Given(name: n, subject: x, body: b) :> cfStmts(b.stmts, cfExpr(x, a))
            .For(f: lf) :> cfStmts(lf.body.stmts, cfExprs(forExprs(lf), a))
            .Break(label: x) :> a
            .Continue(label: x) :> a
            .Lift(what: w) :> cfExprs(liftExprs(w), a)
            .EffectStmt(w: w) :> cfEffect(a)
            .Defer(body: b) :> cfStmts(b.stmts, a)
            .Fail(f: f) :> cfExprs(failExprs(f), cfExit(a))
        }
    }

    fn cfExpr(e: AExpr, a0: CFold) -> CFold {
        let a: CFold = cfOwn(e, a0)
        for (const x of exprKids(e)) { a = cfExpr(x, a) }
        for (const b of exprBlocks(e)) { a = cfStmts(b.stmts, a) }
        return a
    }

    fn cfOwn(e: AExpr, a: CFold) -> CFold {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> cfName(a, e.nid, n)
            .Assign(target: t) :> cfWith(a, a.names, a.assigns.concat([e.nid, rootNameNid(t)]), a.rets, a.exits, a.effects, a.handled)
            .Handled(h: h) :> cfHandled(a, e.nid, h)
            .At(name: n) :> a
            .AtItem :> a
            .Num(raw: r) :> a
            .Str(v: s) :> a
            .Bool(v: b) :> a
            .NotLit :> a
            .Recovered :> a
            .Variant(name: n) :> a
            .Member(obj: o) :> a
            .Call(callee: c) :> a
            .Unary(op: o) :> a
            .Binary(op: o) :> a
            .Ternary(test: x) :> a
            .ArrayLit(elems: es) :> a
            .ObjectLit(props: ps) :> a
            .Spread(e: sx) :> a
            .Index(obj: ix) :> a
            .Lambda(params: lp) :> a
            .Sql(q: q) :> a
            .Template(quasis: qs) :> a
            .Foreign(f: fb0) :> a
        }
    }

    fn cfHandled(a0: CFold, nid: int, h: AHandled) -> CFold {
        let a: CFold = a0
        const how: AHow = h.how
        const hk: int = match how {
            .Propagate :> 0
            .Guard(arms: x) :> 1
            .MatchOn(arms: x) :> 2
        }
        if (hk == 0) a = cfExit(a)
        const c: AExpr | not = calleeOf(h.subject.k)
        if (c is given) {
            if (exprName(c) != "") a = cfWith(a, a.names, a.assigns, a.rets, a.exits, a.effects, a.handled.concat([{ nid: nid, callee: c.nid, how: hk, arms: handledArms(h) }]))
        }
        return a
    }

    // The bare name an assignment target is rooted at (`x`, `x.f`, `x[i]`); -1 for a cell or anything else.
    fn rootNameNid(t: AExpr) -> int {
        const k: AExprK = t.k
        return match k {
            .Name(name: n) :> t.nid
            .Member(obj: o) :> rootNameNid(o)
            .Index(obj: o) :> rootNameNid(o)
            .At(name: n) :> -1
            .AtItem :> -1
            .Num(raw: r) :> -1
            .Str(v: s) :> -1
            .Bool(v: b) :> -1
            .NotLit :> -1
            .Recovered :> -1
            .Variant(name: n) :> -1
            .Call(callee: c) :> -1
            .Unary(op: x) :> -1
            .Binary(op: x) :> -1
            .Ternary(test: x) :> -1
            .Assign(target: x) :> -1
            .ArrayLit(elems: es) :> -1
            .ObjectLit(props: ps) :> -1
            .Spread(e: sx) :> -1
            .Lambda(params: lp) :> -1
            .Sql(q: q) :> -1
            .Handled(h: x) :> -1
            .Template(quasis: qs) :> -1
            .Foreign(f: fb0) :> -1
        }
    }

    // The local Sym id a name expression resolves to (-1: not a local).
    fn localSymAt(t: Tables, nid: int) -> int {
        if (nid < 0) return -1
        const nf: NameFact | not = nameFact(t.names, nid)
        return match nf {
            .NLocal(sym: s) :> s.id
            .NField(decl: d) :> -1
            .NInst(decl: d) :> -1
            .NStruct(owner: o) :> -1
            .NFn(sym: s) :> -1
            .NLength :> -1
            .NSurface(of: o) :> -1
            .NConst(sym: s) :> -1
            not :> -1
        }
    }

    // The local Sym ids the assignments at `nids` rebind (an assignment's nid: its EAssignLocal; a
    // target name's nid: its name fact).
    fn assignedSymsOf(t: Tables, nids: int[]) -> int[] {
        let out: int[] = []
        for (const n of nids) {
            let ef: EffectFact | not = not
            if (n >= 0) ef = effectFact(t.effects, n)
            const s: int = match ef {
                .EAssignLocal(sym: x) :> x.id
                .EWrite(w: w) :> -1
                .ESpread(ws: ws) :> -1
                .EReset(w: w) :> -1
                .EEdits(w: w) :> -1
                .ERemove(w: w) :> -1
                .EElemAt(cap: c) :> -1
                .EPosition(cap: c) :> -1
                not :> localSymAt(t, n)
            }
            if (s >= 0) out = out.concat([s])
        }
        return out
    }

    fn fnSymAt(t: Tables, nid: int) -> Sym | not {
        const nf: NameFact | not = nameFact(t.names, nid)
        if (nf is not) return not
        return fnSymOfFact(nf)
    }

    // The Sym ids a top-level statement declares for the statements after it.
    fn topBinds(t: Tables, s: AStmt) -> int[] {
        const k: AStmtK = s.k
        return match k {
            .Local(name: n) :> symIds(bindSym(bindFact(t.binds, s.nid)))
            .For(f: lf) :> forBoundSyms(t, lf)
            .Eval(e: e) :> []
            .Return(e: e) :> []
            .If(cond: c) :> []
            .Given(name: n) :> []
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> []
            .EffectStmt(w: w) :> []
            .Defer(body: b) :> []
            .Fail(f: f) :> []
        }
    }

    fn forBoundSyms(t: Tables, lf: AFor) -> int[] {
        const b: AForBound | not = lf.bound
        if (b is not) return []
        return symIds(bindSym(bindFact(t.binds, b.nid)))
    }

    fn symIds(s: Sym | not) -> int[] {
        if (s is not) return []
        return [s.id]
    }

    fn anyIn(xs: int[], ys: int[]) -> boolean {
        for (const x of xs) {
            if (ys.indexOf(x) >= 0) return true
        }
        return false
    }

    fn localSymsOf(t: Tables, nids: int[]) -> int[] {
        let out: int[] = []
        for (const n of nids) {
            const s: int = localSymAt(t, n)
            if (s >= 0) out = out.concat([s])
        }
        return out
    }

    fn cpIsDefer(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Defer(body: b) :> true
            .Eval(e: e) :> false
            .Local(name: n) :> false
            .Return(e: e) :> false
            .If(cond: c) :> false
            .Given(name: n) :> false
            .For(f: lf) :> false
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: w) :> false
            .EffectStmt(w: w) :> false
            .Fail(f: f) :> false
        }
    }

    fn isLocalStmt(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Local(name: n) :> true
            .For(f: lf) :> lf.bound is given
            .Defer(body: b) :> false
            .Eval(e: e) :> false
            .Return(e: e) :> false
            .If(cond: c) :> false
            .Given(name: n) :> false
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: w) :> false
            .EffectStmt(w: w) :> false
            .Fail(f: f) :> false
        }
    }

    // A `let` / `const` statement's written type, initializer and `lin` (for a client local the batch reads).
    type LocalDecl:struct = { name: string, ty: AType | not, init: AExpr | not, lin: boolean }
    fn localDeclOf(s: AStmt) -> LocalDecl | not {
        const k: AStmtK = s.k
        return match k {
            .Local(name: n, mutable: m, ty: ty, init: i, lin: l) :> { name: n, ty: ty, init: i, lin: l }
            .For(f: lf) :> forLocalDecl(lf)
            .Defer(body: b) :> not
            .Eval(e: e) :> not
            .Return(e: e) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: w) :> not
            .EffectStmt(w: w) :> not
            .Fail(f: f) :> not
        }
    }

    fn forLocalDecl(lf: AFor) -> LocalDecl | not {
        const b: AForBound | not = lf.bound
        if (b is not) return not
        return { name: b.name, ty: b.ty, init: not, lin: false }
    }

    fn enumHasVariant(t: Tables, e: Sym | not, name: string) -> boolean {
        if (e is not) return false
        const ti: TypeInfo | not = typeInfoOf(t.types, e)
        if (ti is not) return false
        for (const v of enumVariants(ti.def)) {
            if (v.sym.hint == name) return true
        }
        return false
    }

    fn armIsTransport(a: AArm) -> boolean {
        const p: APat = a.pat
        return match p {
            .PName(name: n) :> n == "Transport"
            .PWild :> false
            .PWhole(bind: b) :> false
            .PBare(bind: b) :> false
            .PNot :> false
            .PLit(e: x) :> false
        }
    }

    // A resolved Type the batch's parameter list can spell back (a tape cannot: its grants).
    fn spellable(ty: Type) -> boolean {
        return match ty {
            .Int :> true
            .Num :> true
            .Str :> true
            .Bool :> true
            .Named(sym: s) :> true
            .Seq(elem: e) :> false          // a tape's grants are the reader's (s469 F2) — its type is written, or refused
            .Maybe(inner: i) :> spellable(i)
        }
    }

    // ---- the pass ------------------------------------------------------------------
    // `allow`: the composed program can be written (analyzeLinked has fresh node ids); when
    // false, a function that would compose is refused instead — never compiled as two requests.
    fn composePass(g: Globals, t: Tables, sum: Summary, allow: boolean, st0: AS) -> RCompose {
        let st: AS = st0
        let plans: ComposePlan[] = []
        const places: PlaceFact[] = t.server.places
        const tq: TxQ = txQuerySets(sum.nodes, places, sum.inherited)
        const dr: boolean[] = domReach(sum.nodes, tq, places)
        for (const fs of g.fns) {
            const i: int = nodeIdx(sum.nodes, fs.info.sym.id)
            if (i >= 0 && fs.f.failable && !isServerPlace(placeOf(places, fs.info.sym.id)) && sum.inherited.indexOf(fs.info.sym.id) < 0 && !holdsTxControl(sum.nodes[i].f)) {
                const why: string = composeTrigger(sum, tq, places, i)
                if (why != "") {
                    const r: RPlan = composeOne(g, t, sum, tq, places, dr, fs, i, why, allow, st)
                    st = r.st
                    const p: ComposePlan | not = r.plan
                    if (p is given) plans = plans.concat([p])
                } else if (tq.remote[i] == 1) {
                    const r1: RPlan = composeSingle(g, t, sum, tq, places, dr, fs, i, allow, st)
                    st = r1.st
                    const p1: ComposePlan | not = r1.plan
                    if (p1 is given) plans = plans.concat([p1])
                }
            }
        }
        return { plans: plans, st: st }
    }

    // Why callable i's server calls need composing ("" — they do not): two or more
    // requests (F11's count), or one whose non-`!` server callee runs queries that
    // need one transaction (§8.9.2 wraps only a `!` server function).
    fn composeTrigger(sum: Summary, tq: TxQ, places: PlaceFact[], i: int) -> string {
        if (tq.remote[i] >= 2) return "it makes more than one server call (" + tq.remoteWhy[i] + ")"
        const needs: boolean = tq.qs[i].length >= 2 || tq.runs[i] >= 2 || witnessOf(tq.loops[i]) is given
        if (!needs) return ""
        for (const j of remoteCallees(sum.nodes, tq, places, i)) {
            if (tq.qs[j].length > 0 && !sum.nodes[j].f.failable) return "its queries run in the server function `" + sum.nodes[j].label + "`, which is not declared '!'"
        }
        return ""
    }

    fn composeRefuse(st: AS, file: string, span: ASpan, fname: string, why: string, capable: string) -> RPlan {
        return { plan: not, st: addDiag(st, file, span, "E-BOOTSTRAP-UNSUPPORTED", "'" + fname + "' is declared '!' and runs on the client, and " + why + " — so its server calls must run in ONE request inside ONE transaction (§19.9.9.8 rule 1, §19.10.5; S474 ruling door 2). The bootstrap composes them, but not this shape yet: " + capable) }
    }

    fn composeOne(g: Globals, t: Tables, sum: Summary, tq: TxQ, places: PlaceFact[], dr: boolean[], fs: FnSrc, i: int, why: string, allow: boolean, st0: AS) -> RPlan {
        let st: AS = st0
        const f: FnFacts = sum.nodes[i].f
        const name: string = fs.info.name
        const file: string = fs.info.file
        if (!allow) return composeRefuse(st, file, fs.info.span, name, why, "the composed batch is written with the linker's node ids, which this analysis was not given. Compose the calls in one server `!` function and call that once")
        const ss: AStmt[] = fs.f.body.stmts
        const fx: StmtFx[] = stmtFxs(sum, tq, places, dr, f, t, ss)
        // the batch: first through last statement that calls a server function
        let lo: int = -1
        let hi: int = -1
        let k: int = 0
        while (k < ss.length) {
            if (fx[k].remote.length > 0 || fx[k].via != "") {
                if (lo < 0) lo = k
                hi = k
            }
            k = k + 1
        }
        if (lo < 0) return composeRefuse(st, file, fs.info.span, name, why, "its server calls are not made by its own statements. Compose the calls in one server `!` function and call that once")
        const lastCall: int = hi
        // rule 1, to a fixpoint: a later statement reading a local the batch declares joins it
        let changed = true
        while (changed) {
            changed = false
            let bsyms: int[] = []
            k = lo
            while (k <= hi) {
                bsyms = bsyms.concat(topBinds(t, ss[k]))
                k = k + 1
            }
            k = hi + 1
            while (!changed && k < ss.length) {
                const fk: CFold = cfStmt(ss[k], cf0())
                if (anyIn(localSymsOf(t, fk.names), bsyms)) {
                    hi = k
                    changed = true
                } else if (fk.exits && fx[k].write == "" && movableRun(t, ss, fx, hi + 1, k) && !cpRetsIn(ss, hi + 1, k)) {
                    // s474 r1 (review M2, PA ruling (a)): a later statement that can `fail` / `?` and can
                    // move joins the batch — its failure then rolls the batch's writes back with it
                    hi = k
                    changed = true
                }
                k = k + 1
            }
        }
        let calls: string[] = []
        k = lo
        while (k <= hi) {
            for (const r of fx[k].remote) {
                if (calls.indexOf(r) < 0) calls = calls.concat([r])
            }
            k = k + 1
        }
        // PERMANENT: browser work between the server calls splits them into two requests. (After the
        // last call, a browser statement joined the batch only by reading a value it computes: §19.9.9.8
        // rule 3 permits it on the client — the value comes back — which is INTERIM, below.)
        k = lo
        while (k <= lastCall) {
            if (fx[k].browser != "") {
                return { plan: not, st: addDiag(st, file, ss[k].span, "E-TX-CLIENT-MULTI-CALL", "'" + name + "' is declared '!' and runs on the client; its server calls (" + calls.join(", ") + ") must run in ONE request inside ONE transaction (§19.9.9.8 rule 1, S474) — but this statement (line " + lineOf(g, file, ss[k].span.start) + ") uses " + fx[k].browser + ", which needs the browser and cannot move into the server batch (§19.9.9.8 rule 3), and it stands between them: the calls would be two requests, and no transaction spans two requests, so the all-or-nothing guarantee cannot hold (§19.10.5). Move the browser work before the first server call or after the last one, or split the function") }
            }
            k = k + 1
        }
        // the parameters and client locals the batch can be handed
        let psyms: int[] = []
        for (const p of fs.f.params) {
            if (p.lin) return composeRefuse(st, file, p.span, name, why, "its parameter `" + p.name + "` is `lin` — handing it to the batch is a use the composed form does not count yet")
            if (p.ty is not) return composeRefuse(st, file, p.span, name, why, "its parameter `" + p.name + "` has no written type, and the batch's request encodes its arguments by type (§57). Write the parameter's type")
            psyms = psyms.concat(symIds(bindSym(bindFact(t.binds, p.nid))))
        }
        let presyms: int[] = []
        let prestmt: int[] = []
        k = 0
        while (k < lo) {
            for (const s of topBinds(t, ss[k])) {
                presyms = presyms.concat([s])
                prestmt = prestmt.concat([k])
            }
            k = k + 1
        }
        if (!enumHasVariant(t, fs.info.err, "Transport")) {
            const en: string = fs.info.err is given ? "`" + errName(fs.info.err) + "`" : "its error type"
            return { plan: not, st: addDiag(st, file, fs.info.span, "E-ERROR-010", "'" + name + "' is declared '!' and runs on the client, and " + why + ": the bootstrap composes those calls into ONE request inside ONE transaction (§19.9.9.8 rule 1, S474), and that request can also fail on the wire (§19.9.10). '" + name + "' re-fails that failure as its own, so add `Transport(t: ServerCallError)` to " + en) }
        }
        // the batch's statements: deferred cell writes apart
        let deferred: int[] = []
        let bsyms: int[] = []
        let seenRet = false
        let body: CFold = cf0()
        k = lo
        while (k <= hi) {
            const s: AStmt = ss[k]
            const x: StmtFx = fx[k]
            const one: CFold = cfStmt(s, cf0())
            if (cpIsDefer(s)) return composeRefuse(st, file, s.span, name, why, "this `defer` would run when the server batch ends, not when '" + name + "' returns (§19.16). Move it before the first server call")
            if (x.browser != "") return composeRefuse(st, file, s.span, name, why, "this statement, after the last server call, uses " + x.browser + " and reads a value the batch computes: it stays in the browser, and the value would come back with the batch's result (§19.9.9.8 rule 3). Return the value from '" + name + "' and use it in the browser where it is called")
            if (one.effects) return composeRefuse(st, file, s.span, name, why, "this statement holds an effect, which belongs to the page. Move it out of the function")
            if (x.via != "") return composeRefuse(st, file, s.span, name, why, "this statement calls `" + x.via + "`, a client function that makes a server call: composed, it would run in place in the batch (§19.9.9.8 rule 1). Call the server function from '" + name + "' directly")
            if (x.client != "") return composeRefuse(st, file, s.span, name, why, "this statement calls `" + x.client + "`, which reads or writes client state: composed, it would run in the server batch with its cells marshalled into the request and written back with the result (§6.6.9, §19.9.9.8 rule 1). Move the call before the first server call or after the last one")
            if (x.read != "") return composeRefuse(st, file, s.span, name, why, "this statement reads `" + x.read + "` inside the batch: composed, the read is the client's value at the batch's start, marshalled into the request (§6.6.9, §19.9.9.7). Read it into a local before the first server call (`const v = " + x.read + ";`) and use the local")
            if (x.write != "") {
                // s474 r1 (review L7): a write in the statement that makes the server call — its result
                // assigned to a cell, or a cell written in a handler arm of the call
                if (x.remote.length > 0) return composeRefuse(st, file, s.span, name, why, "this statement makes a server call and writes `" + x.write + "` (the call's result, or a write in one of its handler arms): composed, the write is decided inside the batch and comes back with the result in the cell envelope (§19.9.9.8 rule 1). Keep the call's value in a local and write the cell before the first server call or from what '" + name + "' returns")
                const needsBatch: boolean = one.rets || one.exits || isLocalStmt(s) || anyIn(localSymsOf(t, one.names), bsyms)
                if (needsBatch) return composeRefuse(st, file, s.span, name, why, "this statement writes `" + x.write + "` with a value the batch computes: composed, the write joins the batch and its value comes back with the result in the cell envelope (§19.9.9.8 rule 1). Write the cell after the batch from a value the function returns, or before the first server call")
                if (seenRet) return composeRefuse(st, file, s.span, name, why, "this write follows a `return` inside the batch, so whether it runs is decided on the server (§19.9.9.8 rule 3). Move the write before the first server call")
                deferred = deferred.concat([k])
            } else {
                body = cfStmt(s, body)
                if (one.rets) seenRet = true
            }
            bsyms = bsyms.concat(topBinds(t, s))
            k = k + 1
        }
        // a batch may not assign what the client holds (s474 r2, review N3: the local an assignment
        // rebinds is the assign checker's — EAssignLocal at the assignment — not the target's name fact)
        for (const sym of assignedSymsOf(t, body.assigns)) {
            if (psyms.indexOf(sym) >= 0 || presyms.indexOf(sym) >= 0) return composeRefuse(st, file, fs.info.span, name, why, "the batch assigns a parameter or a local declared before it, whose new value would have to come back from the server. Declare a new local inside the batch")
        }
        // a statement after the batch may not read what it computed (rule 1 joined every one that could)
        k = hi + 1
        while (k < ss.length) {
            if (anyIn(localSymsOf(t, cfStmt(ss[k], cf0()).names), bsyms)) return composeRefuse(st, file, ss[k].span, name, why, "this statement reads a local the batch computes, and it cannot join the batch: the value would come back in the cell envelope as a cell write (§19.9.9.8 rule 1). Write the cells in the batch's place, or return the value")
            k = k + 1
        }
        // the client locals the batch reads, handed to it as arguments
        let extra: ComposeExtra[] = []
        let took: int[] = []
        for (const sym of localSymsOf(t, body.names)) {
            const at: int = presyms.indexOf(sym)
            if (at >= 0 && took.indexOf(sym) < 0) {
                took = took.concat([sym])
                const ds: AStmt = ss[prestmt[at]]
                const ld: LocalDecl | not = localDeclOf(ds)
                if (ld is not) return composeRefuse(st, file, ds.span, name, why, "the batch reads a local this statement declares, which the composed form cannot hand to the batch yet")
                if (ld.lin) return composeRefuse(st, file, ds.span, name, why, "the batch reads the `lin` local `" + ld.name + "` — handing it to the batch is a use the composed form does not count yet")
                let vt: Type | not = not
                if (ld.ty is not) {
                    const ini: AExpr | not = ld.init
                    if (ini is given) vt = knownOf(exprType(t, ini.nid))
                    const v0: Type | not = vt
                    if (v0 is not || !spellable(v0)) return composeRefuse(st, file, ds.span, name, why, "the batch reads `" + ld.name + "`, whose type the bootstrap cannot write into the batch's parameter list. Write its type (`const " + ld.name + ": T = …`)")
                }
                extra = extra.concat([{ name: ld.name, span: ds.span, ty: ld.ty, vt: vt }])
            }
        }
        // the handling forms on server calls inside the batch: a non-`!` callee cannot fail there
        // (server→server, §19.9.10) — its handler or `?` is dropped; a `!` callee's `.Transport`
        // arm is dropped when its own error type has none (the per-call wire is gone)
        let strip: int[] = []
        let drop: int[] = []
        let notes: Diag[] = []
        for (const h of body.handled) {
            const cs: Sym | not = fnSymAt(t, h.callee)
            if (cs is given) {
                if (isServerPlace(placeOf(places, cs.id))) {
                    const fi: FnInfo | not = fnInfoOf(t, cs)
                    if (fi is given) {
                        if (!fi.failable) {
                            if (h.how == 2) return composeRefuse(st, file, fs.info.span, name, why, "the batch `match`es on a call of the non-`!` server function `" + fi.name + "`, which cannot fail inside the server batch (§19.9.10). Use the value directly")
                            strip = strip.concat([h.nid])
                            // (s474 r1, review L1: no warning here — the first pass requires this handler on a
                            // client call, §19.9.10, so the author could not remove it; it is dropped silently)
                        } else {
                            const keep: boolean = enumHasVariant(t, fi.err, "Transport")
                            for (const a of h.arms) {
                                if (armIsTransport(a)) {
                                    if (!keep) drop = drop.concat([a.nid])
                                    notes = notes.concat([newDiag("W-TX-ARM-UNREACHABLE", "this `.Transport` arm on `" + fi.name + "()` cannot run on the wire: '" + name + "' is declared '!', and its server calls now run in ONE composed request (§19.9.9.8 rule 1, S474), where `" + fi.name + "` is called in place — " + (keep ? "the arm runs only when `" + fi.name + "` itself fails with `Transport`" : "the arm is dropped") + ". A wire failure of the composed request reaches the caller of '" + name + "' as its own `Transport` variant. Use `?` or a `_` arm instead", file, a.span)])
                                }
                            }
                        }
                    }
                }
            }
        }
        // does the batch, as it will run (the dropped handlers' arms gone), return?
        let bss: AStmt[] = []
        k = lo
        while (k <= hi) {
            if (deferred.indexOf(k) < 0) bss = bss.concat([ss[k]])
            k = k + 1
        }
        const rets: boolean = cfStmts(mStmts(bss, { strip: strip, drop: drop }), cf0()).rets
        if (rets && (hi + 1 < ss.length || deferred.length > 0)) {
            return composeRefuse(st, file, ss[hi + 1 < ss.length ? hi + 1 : hi].span, name, why, "the batch holds a `return`, and client work follows it: composed, the batch would end the function and hand back its result with an exit flag (§19.9.9.8 rule 3). Move the client work before the first server call, or end the function with the batch")
        }
        // s474 r1 (review M2, PA ruling (b)): a later `fail` / `?` that cannot join the batch runs after it committed
        const late: Diag[] = lateExits(g, t, fs, fx, calls, hi, "")
        return { plan: { fnNid: fs.f.nid, name: name, lo: lo, hi: hi, deferred: deferred, extra: extra, strip: strip, drop: drop, returns: rets, notes: notes.concat(late), late: late.length }, st: st }
    }

    // Each statement's facts, a `Date` / `performance` read counted as browser work (review L4:
    // the browser's clock is not movable — §19.9.9.8 rule 3 names `Math`, `JSON`, `String`).
    fn stmtFxs(sum: Summary, tq: TxQ, places: PlaceFact[], dr: boolean[], f: FnFacts, t: Tables, ss: AStmt[]) -> StmtFx[] {
        let out: StmtFx[] = []
        for (const s of ss) {
            const x: StmtFx = stmtFx(sum, tq, places, dr, f, s.span)
            let clock: string = ""
            for (const n of cfStmt(s, cf0()).clocks) {
                if (clock == "" && localSymAt(t, n) < 0 && fnSymAt(t, n) is not) clock = "the browser's clock (`Date` / `performance`)"
            }
            if (clock != "" && x.browser == "") {
                out = out.concat([{ remote: x.remote, via: x.via, browser: clock, client: x.client, read: x.read, write: x.write }])
            } else {
                out = out.concat([x])
            }
        }
        return out
    }

    // Does a statement of from..to (inclusive) hold a `return`? (s474 r2, review N1: joining it would
    // put a `return` in the batch with client work after it — the exit flag is not built)
    fn cpRetsIn(ss: AStmt[], from: int, to: int) -> boolean {
        let k: int = from
        while (k <= to) {
            if (cfStmt(ss[k], cf0()).rets) return true
            k = k + 1
        }
        return false
    }

    // Can statements from..to (inclusive) all move into the batch? (rule 3: no browser work, no cell
    // read — the marshal is not built — no client function, no effect, no `defer`)
    fn movableRun(t: Tables, ss: AStmt[], fx: StmtFx[], from: int, to: int) -> boolean {
        let k: int = from
        while (k <= to) {
            const x: StmtFx = fx[k]
            if (x.browser != "" || x.read != "" || x.client != "" || x.via != "" || x.remote.length > 0) return false
            if (cfStmt(ss[k], cf0()).effects || cpIsDefer(ss[k])) return false
            k = k + 1
        }
        return true
    }

    // W-TX-FAIL-AFTER-COMMIT for each statement after `from` that can `fail` / `?` (PA ruling, review M2 (b)).
    // `reason0`: why nothing after `from` could join, when the statements do not say it (review N2 / N4).
    fn lateExits(g: Globals, t: Tables, fs: FnSrc, fx: StmtFx[], calls: string[], from: int, reason0: string) -> Diag[] {
        let out: Diag[] = []
        const ss: AStmt[] = fs.f.body.stmts
        const name: string = fs.info.name
        let k: int = from + 1
        let blocked: string = ""
        while (k < ss.length) {
            const x: StmtFx = fx[k]
            if (blocked == "" && x.write != "") blocked = "it writes `" + x.write + "` in the same statement"
            if (blocked == "" && x.client != "") blocked = "it calls `" + x.client + "`, which reads or writes client state"
            if (blocked == "" && x.read != "") blocked = "it reads `" + x.read + "`, which is not marshalled into the batch yet"
            if (x.browser != "") blocked = "it uses " + x.browser + ", which needs the browser"
            const fk: CFold = cfStmt(ss[k], cf0())
            if (fk.exits) {
                let why: string = blocked
                if (why == "") why = reason0
                if (why == "") why = "a statement before it cannot join the batch"
                out = out.concat([newDiag("W-TX-FAIL-AFTER-COMMIT", "this `fail` / `?` (line " + lineOf(g, fs.info.file, ss[k].span.start) + ") runs after '" + name + "''s server work (" + calls.join(", ") + ") has COMMITTED: when it fails, the caller is told '" + name + "' failed, but the batch's writes are already committed and are not rolled back (§19.10.5, S474). It cannot join the server batch because " + why + ". Move the check before the first server call, or into the server function, so it can roll the writes back", fs.info.file, ss[k].span)])
            }
            if (blocked == "" && fk.rets) blocked = "a `return` before it would end the batch with client work after it (the batch's exit flag is not built)"
            k = k + 1
        }
        return out
    }

    // s474 r1 (review M2, PA ruling): ONE server call followed by a `fail` / `?` — composed like two,
    // so a movable check joins the call's request and rolls its writes back. Composed only when every
    // such check joins (otherwise nothing changes): a check that cannot move is W-TX-FAIL-AFTER-COMMIT.
    // A function whose one call is a composed batch's (the composed program's F) is not looked at again.
    fn composeSingle(g: Globals, t: Tables, sum: Summary, tq: TxQ, places: PlaceFact[], dr: boolean[], fs: FnSrc, i: int, allow: boolean, st0: AS) -> RPlan {
        const f: FnFacts = sum.nodes[i].f
        const ss: AStmt[] = fs.f.body.stmts
        const fx: StmtFx[] = stmtFxs(sum, tq, places, dr, f, t, ss)
        let at: int = -1
        let k: int = 0
        while (k < ss.length) {
            if (fx[k].remote.length > 0 || fx[k].via != "") at = k
            k = k + 1
        }
        if (at < 0) return { plan: not, st: st0 }
        // s474 r2 (review N2): the one request is made by a client function — composing it is not built,
        // so a later `fail` / `?` runs after that request committed
        if (fx[at].via != "") {
            let st2: AS = st0
            for (const d of lateExits(g, t, fs, fx, ["`" + fx[at].via + "`"], at, "the server call is made inside `" + fx[at].via + "`, a client function, and composing that call is not built yet (call the server function from '" + fs.info.name + "' directly)")) { st2 = addDiag(st2, d.file, d.span, d.code, d.message) }
            return { plan: not, st: st2 }
        }
        for (const r of fx[at].remote) {
            if (r.substring(0, 2) == "`#") return { plan: not, st: st0 }
        }
        let exits = false
        k = at + 1
        while (k < ss.length) {
            if (cfStmt(ss[k], cf0()).exits) exits = true
            k = k + 1
        }
        if (!exits) return { plan: not, st: st0 }
        const r1: RPlan = composeOne(g, t, sum, tq, places, dr, fs, i, "a statement after its one server call can `fail`", allow, st0)
        const p: ComposePlan | not = r1.plan
        if (p is given) {
            if (p.late == 0) return r1
        }
        // s474 r2 (review N4): the reason composing failed, when it was refused
        let reason: string = ""
        if (p is not && r1.st.diags.length > st0.diags.length) reason = refusalReason(r1.st.diags[r1.st.diags.length - 1])
        let st: AS = st0
        for (const d of lateExits(g, t, fs, fx, fx[at].remote, at, reason)) { st = addDiag(st, d.file, d.span, d.code, d.message) }
        return { plan: not, st: st }
    }

    fn refusalReason(d: Diag) -> string {
        if (d.code == "E-ERROR-010") return "composing the call needs `Transport(t: ServerCallError)` in the function's error type (E-ERROR-010: the composed request can fail on the wire) — add it, and this check joins the batch"
        const at: int = d.message.indexOf("not this shape yet: ")
        if (at >= 0) return "composing the call is not built for this function yet: " + d.message.substring(at + 20)
        return "composing the call is refused (" + d.code + ")"
    }

    fn errName(e: Sym | not) -> string {
        if (e is not) return ""
        return e.hint
    }

    // ---- the composed program (s474, client-bang composition) ------------------------
    // composeFiles writes each plan into its function: F keeps S[0..lo), then ONE call
    // of the batch (`#F(params…, client locals…)?`, or `return #F(…)?;` when the batch
    // returns), then the deferred cell writes, then S(hi..n); the batch function `#F`
    // follows F in the same item list. The moved statements keep their node ids and
    // spans (a later report points at what the author wrote); every synthesized node
    // takes a fresh id from `next` (the linker's first unused id).
    type RFiles:struct = { files: FileAst[], next: int }
    type RItems:struct = { items: AItem[], next: int }
    type RTy:struct = { ty: AType, next: int }
    type RFn2:struct = { fns: AFn[], next: int }
    type CMap:struct = { strip: int[], drop: int[] }

    fn composeFiles(files: FileAst[], plans: ComposePlan[], next0: int) -> FileAst[] {
        let next: int = next0
        let out: FileAst[] = []
        for (const f of files) {
            const r: RItems = composeItems(f.items, plans, next)
            next = r.next
            out = out.concat([{ path: f.path, items: r.items, errs: f.errs, lines: f.lines, dbFns: f.dbFns, hosts: f.hosts }])
        }
        return out
    }

    fn composeItems(items: AItem[], plans: ComposePlan[], next0: int) -> RItems {
        let next: int = next0
        let out: AItem[] = []
        for (const it of items) {
            const k: AItemK = it.k
            const p: AProgram | not = cpProgramOf(k)
            const af: AFn | not = fnOfItem(k)
            if (p is given) {
                const r: RItems = composeItems(p.items, plans, next)
                next = r.next
                out = out.concat([{ nid: it.nid, span: it.span, k: AItemK.ProgramItem({ nid: p.nid, span: p.span, attrs: p.attrs, items: r.items }) }])
            } else if (af is given) {
                const pl: ComposePlan | not = planFor(plans, af.nid)
                if (pl is given) {
                    const r2: RFn2 = composeFn(af, pl, next)
                    next = r2.next
                    out = out.concat([{ nid: it.nid, span: it.span, k: AItemK.FnItem(r2.fns[0]) }])
                    out = out.concat([{ nid: next, span: it.span, k: AItemK.FnItem(r2.fns[1]) }])
                    next = next + 1
                } else {
                    out = out.concat([it])
                }
            } else {
                out = out.concat([it])
            }
        }
        return { items: out, next: next }
    }

    fn planFor(plans: ComposePlan[], nid: int) -> ComposePlan | not {
        for (const p of plans) {
            if (p.fnNid == nid) return p
        }
        return not
    }

    fn cpProgramOf(k: AItemK) -> AProgram | not {
        return match k {
            .ProgramItem(p: p) :> p
            .FnItem(f: f) :> not
            .ConstItem(c: c) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .DeclItem(d: d) :> not
            .MarkupItem(n: n) :> not
        }
    }

    fn fnOfItem(k: AItemK) -> AFn | not {
        return match k {
            .FnItem(f: f) :> f
            .ProgramItem(p: p) :> not
            .ConstItem(c: c) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .DeclItem(d: d) :> not
            .MarkupItem(n: n) :> not
        }
    }

    // [F rewritten, the batch function #F]
    fn composeFn(af: AFn, pl: ComposePlan, next0: int) -> RFn2 {
        let next: int = next0
        const ss: AStmt[] = af.body.stmts
        const cm: CMap = { strip: pl.strip, drop: pl.drop }
        const sp: ASpan = mkSpan(ss[pl.lo].span.start, ss[pl.hi].span.end)
        // the batch's parameters: F's, then the client locals it reads
        let params: AParam[] = []
        let args: AExpr[] = []
        for (const p of af.params) {
            const pt: AType | not = p.ty
            let ty: AType | not = not
            if (pt is given) {
                const r: RTy = copyAType(pt, next)
                next = r.next
                ty = r.ty
            }
            params = params.concat([{ nid: next, span: p.span, name: p.name, ty: ty, lin: false }])
            args = args.concat([{ nid: next + 1, span: sp, k: AExprK.Name(p.name) }])
            next = next + 2
        }
        for (const x of pl.extra) {
            let ty: AType | not = not
            const xt: AType | not = x.ty
            const xv: Type | not = x.vt
            if (xt is given) {
                const r: RTy = copyAType(xt, next)
                next = r.next
                ty = r.ty
            } else if (xv is given) {
                const r2: RTy = typeAType(xv, x.span, next)
                next = r2.next
                ty = r2.ty
            }
            params = params.concat([{ nid: next, span: x.span, name: x.name, ty: ty, lin: false }])
            args = args.concat([{ nid: next + 1, span: sp, k: AExprK.Name(x.name) }])
            next = next + 2
        }
        let et: AType | not = not
        const ae: AType | not = af.err
        if (ae is given) {
            const r3: RTy = copyAType(ae, next)
            next = r3.next
            et = r3.ty
        }
        // the batch body: S[lo..hi] without the deferred writes, its server-call handling adjusted
        let bstmts: AStmt[] = []
        let defs: AStmt[] = []
        let k: int = pl.lo
        while (k <= pl.hi) {
            if (pl.deferred.indexOf(k) >= 0) {
                defs = defs.concat([ss[k]])
            } else {
                bstmts = bstmts.concat([mStmt(ss[k], cm)])
            }
            k = k + 1
        }
        // a batch that returns nothing answers `true` — a client call decodes the answer against
        // the callee's success type (§57.4, S451 R10), and F discards it (`#F(…)?;`)
        if (!pl.returns) {
            const tv: AExpr = { nid: next, span: sp, k: AExprK.Bool(true) }
            bstmts = bstmts.concat([{ nid: next + 1, span: sp, k: AStmtK.Return(tv) }])
            next = next + 2
        }
        const bname: string = "#" + af.name
        const batch: AFn = { nid: next, span: af.span, exported: false, pure: false, name: bname, params: params, ret: not,
                             body: { nid: next + 1, span: sp, stmts: bstmts }, server: true, failable: true, err: et }
        // the one call: `#F(…)?` (`return #F(…)?;` when the batch returns)
        const callee: AExpr = { nid: next + 2, span: sp, k: AExprK.Name(bname) }
        const call: AExpr = { nid: next + 3, span: sp, k: AExprK.Call(callee, args) }
        const prop: AExpr = { nid: next + 4, span: sp, k: AExprK.Handled({ subject: call, how: AHow.Propagate }) }
        let cs: AStmt = { nid: next + 5, span: sp, k: AStmtK.Eval(prop) }
        if (pl.returns) cs = { nid: next + 5, span: sp, k: AStmtK.Return(prop) }
        next = next + 6
        const fstmts: AStmt[] = ss.slice(0, pl.lo).concat([cs]).concat(defs).concat(ss.slice(pl.hi + 1))
        const f2: AFn = { nid: af.nid, span: af.span, exported: af.exported, pure: af.pure, name: af.name, params: af.params, ret: af.ret,
                          body: { nid: af.body.nid, span: af.body.span, stmts: fstmts }, server: af.server, failable: af.failable, err: af.err }
        return { fns: [f2, batch], next: next }
    }

    fn copyAType(t: AType, next: int) -> RTy {
        const k: ATypeK = t.k
        return match k {
            .TName(name: n) :> { ty: { nid: next, span: t.span, k: ATypeK.TName(n) }, next: next + 1 }
            .TSeq(elem: e, grants: gs) :> seqAType(copyAType(e, next), t.span, gs)
            .TMaybe(inner: i) :> maybeAType(copyAType(i, next), t.span)
        }
    }

    fn maybeAType(r: RTy, sp: ASpan) -> RTy {
        return { ty: { nid: r.next, span: sp, k: ATypeK.TMaybe(r.ty) }, next: r.next + 1 }
    }

    // A resolved type spelled back as syntax (composeOne admits only `spellable` ones).
    fn typeAType(ty: Type, sp: ASpan, next: int) -> RTy {
        return match ty {
            .Int :> { ty: { nid: next, span: sp, k: ATypeK.TName("int") }, next: next + 1 }
            .Num :> { ty: { nid: next, span: sp, k: ATypeK.TName("number") }, next: next + 1 }
            .Str :> { ty: { nid: next, span: sp, k: ATypeK.TName("string") }, next: next + 1 }
            .Bool :> { ty: { nid: next, span: sp, k: ATypeK.TName("bool") }, next: next + 1 }
            .Named(sym: s) :> { ty: { nid: next, span: sp, k: ATypeK.TName(s.hint) }, next: next + 1 }
            .Seq(elem: e) :> seqAType(typeAType(e, sp, next), sp, [])
            .Maybe(inner: i) :> maybeAType(typeAType(i, sp, next), sp)
        }
    }

    // ---- the batch's statements, with the server-call handling adjusted (CMap) -------
    fn mStmts(ss: AStmt[], m: CMap) -> AStmt[] {
        let out: AStmt[] = []
        for (const s of ss) { out = out.concat([mStmt(s, m)]) }
        return out
    }

    fn mBlock(b: ABlock, m: CMap) -> ABlock { return { nid: b.nid, span: b.span, stmts: mStmts(b.stmts, m) } }

    fn mMaybeBlock(b: ABlock | not, m: CMap) -> ABlock | not {
        if (b is not) return not
        return mBlock(b, m)
    }

    fn mMaybe(e: AExpr | not, m: CMap) -> AExpr | not {
        if (e is not) return not
        return mExpr(e, m)
    }

    fn mExprs(es: AExpr[], m: CMap) -> AExpr[] {
        let out: AExpr[] = []
        for (const e of es) { out = out.concat([mExpr(e, m)]) }
        return out
    }

    fn mStmt(s: AStmt, m: CMap) -> AStmt {
        const k: AStmtK = s.k
        const k2: AStmtK = match k {
            .Eval(e: e) :> AStmtK.Eval(mExpr(e, m))
            .Local(name: n, mutable: mu, ty: ty, init: i, lin: l) :> AStmtK.Local(n, mu, ty, mExpr(i, m), l)
            .Return(e: e) :> AStmtK.Return(mMaybe(e, m))
            .If(cond: c, thenB: tb, elseB: eb) :> AStmtK.If(mExpr(c, m), mBlock(tb, m), mMaybeBlock(eb, m))
            .Given(name: n, subject: x, body: b) :> AStmtK.Given(n, mExpr(x, m), mBlock(b, m))
            .EffectStmt(w: w) :> k
            .Defer(body: b, arrayLead: al, bare: br) :> AStmtK.Defer(mBlock(b, m), al, br)
            .Fail(f: f) :> AStmtK.Fail(mFail(f, m))
            .For(f: lf) :> AStmtK.For(mFor(lf, m))
            .Break(label: x) :> k
            .Continue(label: x) :> k
            .Lift(what: w) :> AStmtK.Lift(mLift(w, m))
        }
        return { nid: s.nid, span: s.span, k: k2 }
    }

    fn mFail(f: AFail, m: CMap) -> AFail {
        return { enumName: f.enumName, variant: f.variant, args: mExprs(f.args, m), target: mMaybe(f.target, m), split: f.split }
    }

    fn mLift(w: ALift, m: CMap) -> ALift {
        return match w {
            .LiftExpr(e: e) :> ALift.LiftExpr(mExpr(e, m))
            .LiftNode(n: x) :> w
        }
    }

    fn mFor(lf: AFor, m: CMap) -> AFor {
        return { nid: lf.nid, span: lf.span, label: lf.label, head: mHead(lf.head, m), body: mBlock(lf.body, m), bound: lf.bound }
    }

    fn mHead(h: AForHead, m: CMap) -> AForHead {
        return match h {
            .HForever :> h
            .HCond(cond: c) :> AForHead.HCond(mExpr(c, m))
            .HCounted(init: i, cond: c, step: sp) :> AForHead.HCounted(mStmts(i, m), mMaybe(c, m), mExprs(sp, m))
            .HIter(bind: b, mutable: mu, src: src, key: ky) :> AForHead.HIter(b, mu, mIter(src, m), mMaybe(ky, m))
        }
    }

    fn mIter(s: AIterSrc, m: CMap) -> AIterSrc {
        return match s {
            .IterOf(e: e) :> AIterSrc.IterOf(mExpr(e, m))
            .IterRange(lo: l, hi: h, inclusive: inc) :> AIterSrc.IterRange(mExpr(l, m), mExpr(h, m), inc)
        }
    }

    fn mProps(ps: AProp[], m: CMap) -> AProp[] {
        let out: AProp[] = []
        for (const p of ps) { out = out.concat([{ nid: p.nid, span: p.span, spread: p.spread, name: p.name, value: mExpr(p.value, m) }]) }
        return out
    }

    fn mArms(arms: AArm[], m: CMap) -> AArm[] {
        let out: AArm[] = []
        for (const a of arms) {
            if (m.drop.indexOf(a.nid) < 0) out = out.concat([{ nid: a.nid, span: a.span, pat: a.pat, body: mArmBody(a.body, m), legacy: a.legacy, lifted: a.lifted, bare: a.bare }])
        }
        return out
    }

    fn mArmBody(b: AArmBody, m: CMap) -> AArmBody {
        return match b {
            .ArmExpr(e: x) :> AArmBody.ArmExpr(mExpr(x, m))
            .ArmBlock(b: blk) :> AArmBody.ArmBlock(mBlock(blk, m))
        }
    }

    fn mHow(h: AHow, m: CMap) -> AHow {
        return match h {
            .Propagate :> h
            .Guard(arms: a) :> AHow.Guard(mArms(a, m))
            .MatchOn(arms: a) :> AHow.MatchOn(mArms(a, m))
        }
    }

    fn mExpr(e: AExpr, m: CMap) -> AExpr {
        const k: AExprK = e.k
        if (m.strip.indexOf(e.nid) >= 0) {
            const h: AHandled | not = handledOf(k)
            if (h is given) return mExpr(h.subject, m)
        }
        const k2: AExprK = match k {
            .Name(name: n) :> k
            .At(name: n) :> k
            .AtItem :> k
            .Num(raw: r) :> k
            .Str(v: s) :> k
            .Bool(v: b) :> k
            .NotLit :> k
            .Recovered :> k
            .Variant(name: n) :> k
            .Foreign(f: fb0) :> k
            .Member(obj: o, name: n) :> AExprK.Member(mExpr(o, m), n)
            .Call(callee: c, args: a) :> AExprK.Call(mExpr(c, m), mExprs(a, m))
            .Unary(op: o, e: x) :> AExprK.Unary(o, mExpr(x, m))
            .Binary(op: o, l: l, r: r) :> AExprK.Binary(o, mExpr(l, m), mExpr(r, m))
            .Ternary(test: t, yes: y, no: no) :> AExprK.Ternary(mExpr(t, m), mExpr(y, m), mExpr(no, m))
            .Assign(target: t, value: v, paren: p, kept: kp) :> AExprK.Assign(mExpr(t, m), mExpr(v, m), p, kp)
            .ArrayLit(elems: es) :> AExprK.ArrayLit(mExprs(es, m))
            .ObjectLit(props: ps) :> AExprK.ObjectLit(mProps(ps, m))
            .Spread(e: x) :> AExprK.Spread(mExpr(x, m))
            .Index(obj: o, idx: i) :> AExprK.Index(mExpr(o, m), mExpr(i, m))
            .Lambda(params: ps, body: b) :> AExprK.Lambda(ps, mExpr(b, m))
            .Sql(q: q) :> AExprK.Sql({ chunks: q.chunks, params: mExprs(q.params, m), mode: q.mode, nobatch: q.nobatch, handled: q.handled })
            .Handled(h: h) :> AExprK.Handled({ subject: mExpr(h.subject, m), how: mHow(h.how, m) })
            .Template(quasis: qs, slots: ss) :> AExprK.Template(qs, mExprs(ss, m))
        }
        return { nid: e.nid, span: e.span, k: k2 }
    }

    // =========================================================================
    // s474 (U1e) — THE ENVELOPES ARE BUILT. §8.9.2 (as amended S473): "when a `!`
    // server function's transitive query set contains two or more `?{}` queries
    // that do not carry `.nobatch()` (through non-`!` and `!` callees, a query
    // counted once per time it is reached …), the compiler SHALL wrap the
    // handler body in `?{BEGIN DEFERRED}` / `?{COMMIT}` (`?{ROLLBACK}` on an
    // exception or a `fail` exit)"; F10: "An inner `!` function called inside an
    // outer envelope runs as a nested savepoint (§19.10.6), so the outer envelope
    // can roll back the inner's writes." The set is txQuerySets' (unchanged from
    // the s473 interim refusal, which this replaces): its own queries and every
    // callee's, `!` or not, a query reached twice counting twice, one in a loop
    // (or a lambda, or a recursive callee) counting as two.
    //
    // Each `!` function whose set holds a query gets an Envelope (CoreProgram.
    // envelopes): `standalone` when the set needs a transaction of its own (the
    // trigger above), else `false` — it is then a savepoint inside an enclosing
    // envelope and runs as written outside one. The server printer wraps the
    // body (print.scrml envelopedFnJs); the runtime holds the transaction across
    // the body's waits behind the §19.10.6 per-connection gate
    // (server-runtime.js `envelope`).
    //
    // What is NOT built stays a NAMED refusal (S473 D1: "refuse code whose
    // server guarantee it does not build … never compile it without the
    // guarantee"), each checked only where an envelope is needed:
    //  - a write to another database inside the envelope — §8.9.2 (S451 ruling
    //    4a) names it: E-SQL-011 (the SPEC's text);
    //  - a read of another database inside the envelope — the SPEC allows it;
    //    the bootstrap does not prove two connection gates deadlock-free (a
    //    request holding A's gate waiting on B's while another holds B's waiting
    //    on A — §19.10.6 leaves cross-database deadlock uncovered):
    //    E-BOOTSTRAP-UNSUPPORTED;
    //  - an envelope on a Postgres / MySQL database — §19.10.6 "A transaction
    //    SHALL run on one connection taken from the pool for it alone"; the
    //    bootstrap's server runtime reserves no pool connection:
    //    E-BOOTSTRAP-UNSUPPORTED;
    //  - a CLIENT-placed `!` function (its one server call — two are the
    //    permanent E-TX-CLIENT-MULTI-CALL) whose queries run in a server
    //    function that is not `!`: that function runs them with no envelope of
    //    its own, and none can span the request: E-BOOTSTRAP-UNSUPPORTED naming
    //    the fix (declare it `!`, so its own envelope holds them).
    // Manual transaction control in a `!` function stays refused
    // (envelopeDiags): such a function gets no envelope here.
    // =========================================================================
    type REnv:struct = { envs: Envelope[], st: AS }

    fn envelopePass(sum: Summary, tq: TxQ, all: FnFacts[], places: PlaceFact[], sqls: SqlInfo[], dbs: Db[], rd: RDbs, st0: AS) -> REnv {
        let st: AS = st0
        let envs: Envelope[] = []
        for (const f of all) {
            const i: int = nodeIdx(sum.nodes, f.sym)
            if (f.failable && i >= 0 && !holdsTxControl(f) && tq.remote[i] < 2) {
                const r: REnv = envelopeOf(sum, tq, f, i, places, sqls, dbs, rd, st)
                st = r.st
                envs = envs.concat(r.envs)
            }
        }
        return { envs: envs, st: st }
    }

    fn holdsTxControl(f: FnFacts) -> boolean {
        for (const s of f.sqls) {
            if (txControl(s.q.chunks) != "") return true
        }
        return false
    }

    // One `!` function's envelope (none when its set is empty), or its refusal.
    fn envelopeOf(sum: Summary, tq: TxQ, f: FnFacts, i: int, places: PlaceFact[], sqls: SqlInfo[], dbs: Db[], rd: RDbs, st0: AS) -> REnv {
        let st: AS = st0
        const qs: FxAtom[] = tq.qs[i]
        if (qs.length == 0) return { envs: [], st: st }
        // the facts of each query the set COUNTS (the trigger), and of every query the envelope
        // REACHES — `.nobatch()` ones included (s474 r1, review F1/F2: §8.9.5 opts a query out of
        // the count, not out of the envelope's extent); a site with no facts was refused where it stands
        const infos: SqlInfo[] = atomInfos(sum, qs, sqls)
        const reached: FxAtom[] = tq.all[i]
        const rinfos: SqlInfo[] = atomInfos(sum, reached, sqls)
        if (infos.length < qs.length || rinfos.length < reached.length) return { envs: [], st: st }
        const fsym: Sym = { id: f.sym, hint: f.name }
        // S474 ruling 5: the envelope opens with BEGIN IMMEDIATE when a query it reaches writes
        // (core.scrml Envelope.writes) — every query of `rinfos` runs inside it, `.nobatch()` included
        let writes: boolean = false
        for (const wi of rinfos) {
            if (wi.kind == SqlKind.SqlWrite) writes = true
        }
        // s474 r2 (review N5) — PA reading S474, M2: a `!` that fails leaves no writes. A composed batch
        // (`#F`) whose set WRITES (the same fail-closed write test as `writes` above) holds its queries in
        // a transaction of its own even when it reaches ONE, so a `fail` / `?` it joined after the write
        // rolls the write back. A read-only batch opens none (its reads stay off the §19.10.6 gate).
        const needs: boolean = qs.length >= 2 || tq.runs[i] >= 2 || witnessOf(tq.loops[i]) is given || (isBatchName(f.name) && writes)
        if (!needs) return { envs: [{ fn: fsym, db: infos[0].db, standalone: false, writes: writes }], st: st }
        // a client-placed `!` function: its queries run in the server function(s) it calls, each in
        // that function's own envelope — it holds no transaction itself. s474 r2 (review item 2): so
        // the one-database checks below do not apply to it (a client `!` calling one `!` function of
        // `<db src=b>` is not E-SQL-011) — unless a server-run function calls it in place, where its
        // server copy runs its own envelope and the checks hold for that copy.
        const pk: PlaceK = placeOf(places, f.sym)
        if (!isServerPlace(pk) && sum.inherited.indexOf(f.sym) < 0) {
            // s474 (client-bang composition): a non-`!` server callee whose queries need one
            // transaction is composed (composePass) — its call runs inside the composed batch's envelope
            if (!calledInPlace(sum, tq, places, i)) return { envs: [], st: st }
        }
        // the envelope's database: §8.9.2 "on the database of their function's `?{}` sites — the
        // function's nearest database scope (§8.1.1)"; a function with none, its set's first
        let home: Sym = infos[0].db
        const sc: int = fnScope(rd.fns, f.nid)
        if (sc >= 0) {
            const pd: ScopeDb | not = scopeDbOf(rd.scopes, sc)
            if (pd is given) {
                const d0: Db | not = pd.db
                if (d0 is given) home = d0.sym
            }
        }
        // §8.9.2: "'B other than A' compares databases, not spellings: scopes naming the same
        // database are the same database" (s474 r1, review F3) — dbKey, the resolved target
        const homeKey: string = dbKey(dbs, home)
        const homeName: string = dbLabel(dbs, home)
        let k: int = 0
        let readElse: int = -1
        while (k < rinfos.length) {
            if (dbKey(dbs, rinfos[k].db) != homeKey) {
                if (rinfos[k].kind == SqlKind.SqlWrite) {
                    const path: string = sqlPathOf(sum, tq.all, i, reached[k])
                    const other: string = dbLabel(dbs, rinfos[k].db)
                    return { envs: [], st: addDiag(st, f.file, f.span, "E-SQL-011", "'" + f.name + "' holds a transaction on " + homeName + " (§8.9.2), and " + path + " writes " + other + ". A transaction covers one database: a 'fail' or an error would roll back " + homeName + " and leave the write to " + other + " in place. Move the write to " + other + " out of '" + f.name + "' (call it after '" + f.name + "' returns), or remove the envelope ('.nobatch()' on every query of the envelope, §8.9.5) if the writes need not be atomic.") }
                }
                if (readElse < 0) readElse = k
            }
            k = k + 1
        }
        if (readElse >= 0) {
            const path2: string = sqlPathOf(sum, tq.all, i, reached[readElse])
            return { envs: [], st: addDiag(st, f.file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "'" + f.name + "' is declared '!' and needs the implicit per-handler transaction (§8.9.2) on " + homeName + ", and " + path2 + " reads " + dbLabel(dbs, rinfos[readElse].db) + " while it is open (a `.nobatch()` query included: it opts out of the count, not out of the envelope). The SPEC allows that read (§8.9.2: reading database B inside the envelope is allowed), but the bootstrap does not build it: a request holding one database's transaction gate while it waits on another's can deadlock against a request holding them the other way round (§19.10.6). Read the other database before calling '" + f.name + "' and pass the value in") }
        }
        if (!sqliteDb(dbs, home)) {
            return { envs: [], st: addDiag(st, f.file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "'" + f.name + "' is declared '!' and its transitive query set (§8.9.2, S473) needs the implicit per-handler transaction on " + homeName + ", a pooled (Postgres / MySQL) database. §19.10.6 runs such a transaction on one connection taken from the pool for it alone, which the bootstrap's server runtime does not reserve — refused, never compiled non-atomic (S473 D1). Use a SQLite database, or mark each query that need not be atomic with `.nobatch()` (§8.9.5)") }
        }
        // the connection the envelope opens: one a reached query of the home database uses (a
        // second scope naming the same file is the same database — and the server runtime the same
        // connection, server-runtime.js `connection` — but only a used scope is printed)
        let envDb: Sym = home
        let found = false
        for (const ri of rinfos) {
            if (!found && dbKey(dbs, ri.db) == homeKey) {
                envDb = ri.db
                found = true
            }
        }
        return { envs: [{ fn: fsym, db: envDb, standalone: true, writes: writes }], st: st }
    }

    // The SqlInfo of each atom's site, in atom order (an atom whose site has none is skipped).
    fn atomInfos(sum: Summary, atoms: FxAtom[], sqls: SqlInfo[]) -> SqlInfo[] {
        let out: SqlInfo[] = []
        for (const a of atoms) {
            const site: SqlSite = sum.nodes[a.root].f.sqls[a.pos]
            for (const si of sqls) {
                if (si.nid == site.nid) out = out.concat([si])
            }
        }
        return out
    }

    // s474 r1 (review F3) — a database's IDENTITY, for "the same database" (§8.9.2: "compares
    // databases, not spellings: scopes naming the same database are the same database"): the driver
    // and the resolved target — a relative SQLite path joined to its declaring file's directory and
    // normalized (`./`, `.` and `..` segments), exactly as the server runtime resolves it
    // (server-runtime.js `connKey`, which opens ONE connection, with ONE gate, per key). `:memory:`
    // is a database of its own per scope (each connection to it is a fresh one).
    fn dbKey(dbs: Db[], d: Sym) -> string {
        for (const x of dbs) {
            if (x.sym.id == d.id) return dbKeyOf(x)
        }
        return "?" + d.id
    }

    fn dbKeyOf(x: Db) -> string {
        if (x.driver != Driver.Sqlite) return driverKey(x.driver) + ":" + x.target
        if (x.target == ":memory:") return "sqlite::memory:#" + x.sym.id
        let path: string = x.target
        if (path.substring(0, 1) != "/") {
            const slash: int = x.file.lastIndexOf("/")
            if (slash >= 0) path = x.file.substring(0, slash) + "/" + path
        }
        return "sqlite:" + normPath(path)
    }

    fn driverKey(d: Driver) -> string {
        return match d {
            .Sqlite :> "sqlite"
            .Postgres :> "postgres"
            .Mysql :> "mysql"
        }
    }

    // `a/./b/../c` → `a/c`; a leading `/` kept; a `..` past the start kept.
    fn normPath(p: string) -> string {
        const abs: boolean = p.substring(0, 1) == "/"
        let out: string[] = []
        for (const seg of p.split("/")) {
            if (seg != "" && seg != ".") {
                if (seg == ".." && out.length > 0 && out[out.length - 1] != "..") {
                    out = out.slice(0, out.length - 1)
                } else {
                    out = out.concat([seg])
                }
            }
        }
        if (abs) return "/" + out.join("/")
        return out.join("/")
    }

    // s474 r2: some server-run function (server-placed, or server-only by §12.2 T5) calls callable i in place.
    fn calledInPlace(sum: Summary, tq: TxQ, places: PlaceFact[], i: int) -> boolean {
        let m: int = 0
        while (m < sum.nodes.length) {
            if (sum.nodes[m].kind == CallableK.KFn && tq.edges[m].indexOf(i) >= 0) {
                if (isServerPlace(placeOf(places, sum.nodes[m].f.sym)) || sum.inherited.indexOf(sum.nodes[m].f.sym) >= 0) return true
            }
            m = m + 1
        }
        return false
    }

    // The server-placed functions client-placed callable i calls (through client-side callees).
    fn remoteCallees(nodes: Callable[], tq: TxQ, places: PlaceFact[], i: int) -> int[] {
        let out: int[] = []
        let seen: int[] = [i]
        let todo: int[] = [i]
        while (todo.length > 0) {
            const m: int = todo[0]
            todo = todo.slice(1)
            for (const j of tq.edges[m]) {
                if (seen.indexOf(j) < 0) {
                    seen = seen.concat([j])
                    if (isServerPlace(placeOf(places, nodes[j].f.sym))) {
                        out = out.concat([j])
                    } else {
                        todo = todo.concat([j])
                    }
                }
            }
        }
        return out
    }

    // How a query of the set is reached, for a message: "its own `?{}`" or "`f() → g()`".
    fn sqlPathOf(sum: Summary, dim: FxAtom[][], i: int, a: FxAtom) -> string {
        const ch: string[] = fxChain(sum, dim, i, a)
        if (ch.length <= 1) return "its own `" + sqlSigil() + "}`"
        return "`" + ch.join(" → ") + "`"
    }

    fn dbLabel(dbs: Db[], d: Sym) -> string {
        for (const x of dbs) {
            if (x.sym.id == d.id) return "`" + x.target + "`"
        }
        return "`" + d.hint + "`"
    }

    fn sqliteDb(dbs: Db[], d: Sym) -> boolean {
        for (const x of dbs) {
            if (x.sym.id == d.id) return x.driver == Driver.Sqlite
        }
        return false
    }

    // Where a query of a transitive query set stands, for a message.
    fn txWhere(sum: Summary, dim: FxAtom[][], i: int, a: FxAtom) -> string {
        const ch: string[] = fxChain(sum, dim, i, a)
        if (ch.length <= 1) return "one in its own body"
        return "one through `" + ch.join(" → ") + "`"
    }

    // s473 — the TRANSITIVE QUERY SETS of the §8.9.2 amendment, per callable:
    // `qs[i]` — every `?{}` (none `.nobatch()`) callable i runs or reaches
    // through calls of non-`!` functions; `loops[i]` — a witness that one of
    // them may run more than once (`loopWhy[root]` says how).
    // `runs[i]` — how many query RUNS callable i reaches along its calls (a
    // query reached through two calls counts twice — #1690 review F1), capped at
    // 2; `edges` — the non-`!` call edges the sets are closed over (journalDiags
    // reads them: what a `!` function reaches).
    // `remote[i]` — the server calls (requests) client-placed callable i makes, capped at 2; `remoteWhy[i]` names them.
    // `all[i]` (s474 r1, review F1/F2) — EVERY `?{}` callable i reaches, `.nobatch()` ones included:
    // §8.9.5 makes `.nobatch()` opt a query out of the COUNT (the trigger), not out of what an open
    // envelope reaches — so the one-database checks (E-SQL-011, the cross-database read) read `all`.
    type TxQ:struct = { qs: FxAtom[][], all: FxAtom[][], loops: FxAtom[][], loopWhy: string[], runs: int[], edges: int[][], remote: int[], remoteWhy: string[] }

    fn txQuerySets(nodes: Callable[], places: PlaceFact[], inherited: int[]) -> TxQ {
        let own: FxAtom[][] = []
        let ownAll: FxAtom[][] = []
        let edges: int[][] = []
        let i: int = 0
        for (const c of nodes) {
            let q: FxAtom[] = []
            let qa: FxAtom[] = []
            let e: int[] = []
            if (c.kind == CallableK.KFn) {
                let p: int = 0
                for (const s of c.f.sqls) {
                    if (!s.q.nobatch) q = q.concat([ownAtom("q" + i + "." + p, i, p)])
                    qa = qa.concat([ownAtom("q" + i + "." + p, i, p)])
                    p = p + 1
                }
                // F10 (ruled S473, #1690 review): `!` callees count too — an inner `!` runs
                // as a nested savepoint inside the outer envelope (§19.10.6)
                for (const r of c.f.scan.refs) {
                    const j: int = nodeIdx(nodes, r.sym)
                    if (isFnNode(nodes, j)) e = e.concat([j])
                }
            }
            own = own.concat([q])
            ownAll = ownAll.concat([qa])
            edges = edges.concat([e])
            i = i + 1
        }
        const qs: FxAtom[][] = closeDim(own, edges)
        // recursion: a callable in a cycle of calls runs its queries any number of times
        let cyc: boolean[] = []
        for (const c of nodes) { cyc = cyc.concat([false]) }
        for (const scc of sccOrder(edges)) {
            for (const m of scc) {
                if (scc.length > 1 || edges[m].indexOf(m) >= 0) cyc = setBoolAt(cyc, m, true)
            }
        }
        let ownL: FxAtom[][] = []
        let why: string[] = []
        i = 0
        for (const c of nodes) {
            let w: string = ""
            if (c.kind == CallableK.KFn) {
                for (const s of c.f.sqls) {
                    if (w == "" && !s.q.nobatch && inRepeat(c.f.repeats, s.span)) w = "a `" + sqlSigil() + "}` inside a loop (or a lambda) in `" + c.label + "`"
                }
                for (const r of c.f.scan.refs) {
                    const j: int = nodeIdx(nodes, r.sym)
                    if (w == "" && isFnNode(nodes, j) && qs[j].length > 0 && inRepeat(c.f.repeats, r.span)) w = "a call of `" + nodes[j].label + "`, which runs a query, inside a loop (or a lambda) in `" + c.label + "`"
                }
                if (w == "" && cyc[i] && qs[i].length > 0) w = "`" + c.label + "` runs a query and is recursive (it calls itself, directly or through other functions)"
            }
            let l: FxAtom[] = []
            if (w != "") l = [ownAtom("L" + i, i, 0)]
            ownL = ownL.concat([l])
            why = why.concat([w])
            i = i + 1
        }
        // the runs: own queries plus each call's runs, callees first (a cycle is the loop clause's)
        let runs: int[] = []
        for (const c of nodes) {
            let n: int = 0
            if (c.kind == CallableK.KFn) {
                for (const q of c.f.sqls) {
                    if (!q.q.nobatch) n = n + 1
                }
            }
            runs = runs.concat([n])
        }
        let own2: int[] = runs
        for (const scc of sccOrder(edges)) {
            for (const m of scc) {
                let n: int = own2[m]
                for (const j of edges[m]) { n = n + runs[j] }
                if (n > 2) n = 2
                runs = runs.slice(0, m).concat([n]).concat(runs.slice(m + 1))
            }
        }
        // the remote calls of client-placed callables, callees first
        let remote: int[] = []
        let rwhy: string[] = []
        for (const c of nodes) {
            remote = remote.concat([0])
            rwhy = rwhy.concat([""])
        }
        for (const scc of sccOrder(edges)) {
            for (const m of scc) {
                const c: Callable = nodes[m]
                if (c.kind == CallableK.KFn && !isServerPlace(placeOf(places, c.f.sym)) && inherited.indexOf(c.f.sym) < 0) {   // s474: a server-only (inherited, §12.2 T5) function calls in place
                    let n: int = 0
                    let names: string[] = []
                    for (const r of c.f.scan.refs) {
                        const j: int = nodeIdx(nodes, r.sym)
                        if (isFnNode(nodes, j)) {
                            let k: int = 0
                            if (isServerPlace(placeOf(places, nodes[j].f.sym))) {
                                k = 1
                            } else {
                                k = remote[j]
                            }
                            if (k > 0 && inRepeat(c.f.repeats, r.span)) k = 2
                            if (k > 0) names = names.concat(["`" + nodes[j].label + "`"])
                            n = n + k
                        }
                    }
                    if (n > 2) n = 2
                    remote = remote.slice(0, m).concat([n]).concat(remote.slice(m + 1))
                    rwhy = rwhy.slice(0, m).concat([names.join(", ")]).concat(rwhy.slice(m + 1))
                }
            }
        }
        return { qs: qs, all: closeDim(ownAll, edges), loops: closeDim(ownL, edges), loopWhy: why, runs: runs, edges: edges, remote: remote, remoteWhy: rwhy }
    }

    fn isServerPlace(pk: PlaceK) -> boolean {
        return pk == PlaceK.Server || pk == PlaceK.Split
    }

    // The callables a `!` function reaches along non-`!` calls — itself included.
    fn bangReach(nodes: Callable[], tq: TxQ) -> boolean[] {
        let r: boolean[] = []
        for (const c of nodes) { r = r.concat([c.kind == CallableK.KFn && c.f.failable]) }
        let changed = true
        while (changed) {
            changed = false
            let i: int = 0
            while (i < nodes.length) {
                if (r[i]) {
                    for (const j of tq.edges[i]) {
                        if (!r[j]) {
                            r = setBoolAt(r, j, true)
                            changed = true
                        }
                    }
                }
                i = i + 1
            }
        }
        return r
    }

    fn setBoolAt(xs: boolean[], i: int, v: boolean) -> boolean[] {
        return xs.slice(0, i).concat([v]).concat(xs.slice(i + 1))
    }

    fn manualTxDiag(file: string, s: SqlSite, where: string, fname: string, st: AS) -> AS {
        const kw: string = txControl(s.q.chunks)
        if (kw == "") return st
        let fix: string = "Move it into a function declared with '!' and use 'transaction { … }' (§19.10.2), which commits or rolls back on every exit."
        if (fname != "") fix = "Declare '" + fname + "' with '!' and use 'transaction { … }' (§19.10.2), which commits or rolls back on every exit."
        // s452 r3/r4 (MED-A): found only by the fail-closed plain `;` split — say why
        let why: string = ""
        if (txControlAware(s.q.chunks) == "") why = " (Found by reading every `;` in the query text as a statement boundary — quoting and commenting differ between databases, so the check does not trust them. The transaction-control word may be inside a quoted string or a comment; if so, move the query into a function declared '!', where manual transaction control is allowed, or bind the text as a value with `${…}`.)"
        return addDiag(st, file, s.span, "E-ERROR-015", "Manual transaction control '" + kw + "' in " + where + ". A transaction is '!'-gated (§19.10.4): its rollback promise needs a failure path. " + fix + why)
    }

    // §13.7 (S451 R1): a value position that would have to WAIT.
    fn valueServerDiags(g: Globals, t: Tables, all: FnFacts[], ps: PlaceFact[], sum: Summary, rd: RDbs, st0: AS) -> AS {
        let st: AS = st0
        for (const p of valuePositions(g, t)) {
            for (const s of sqlsInValue(p.v)) {
                st = errorTwo(p.file, s, false, st)
                st = manualTxDiag(p.file, s, p.what + ", which is not a function declared '!'", "", st)
                st = positionDb(g, rd, p.file, s, st)
                st = addDiag(st, p.file, s.span, "E-VALUE-SERVER-CALL", p.what + " runs a `" + sqlSigil() + "}` query — the query runs on the server, and " + waitFix())
            }
            const scan: BodyScan = scanValue({ t: t, file: p.file }, p.v, emptyScan())
            for (const r of scan.refs) {
                const pk: PlaceK = placeOf(ps, r.sym)
                const c: Reach | not = waitsOf(sum, r.sym)
                if (pk == PlaceK.Server) {
                    st = addDiag(st, r.file, r.span, "E-VALUE-SERVER-CALL", p.what + " calls the server function `" + r.name + "` — " + waitFix())
                } else if (c is given) {
                    st = addDiag(st, r.file, r.span, "E-VALUE-SERVER-CALL", p.what + " calls `" + r.name + "`, which reaches a server call (`" + c.chain.join(" → ") + "`) — " + waitFix())
                }
            }
        }
        return st
    }

    fn waitFix() -> string {
        return "a value position cannot wait for the server (§13.7). Load the value with a `<request>` (§6.7.7) into a cell and read the cell here — or, where the cell is server-authoritative, a `<x server>` declaration (§52)"
    }

    // E-SQL-004 for a `?{}` that stands in no function: its OWN nearest
    // database scope (s452 — the scope pass recorded it by position).
    fn positionDb(g: Globals, rd: RDbs, file: string, s: SqlSite, st: AS) -> AS {
        if (file != g.entry) return st
        const scope: int = siteScope(rd.sites, s.nid)
        if (scope >= 0 && scopeDbOf(rd.scopes, scope) is given) return st
        return addDiag(st, file, s.span, "E-SQL-004", sql004Text())
    }

    // The action positions: a `?{}` there is client code doing server work (a
    // split — U1d); a server call there is a suspension (U1b).
    fn actionServerDiags(g: Globals, t: Tables, all: FnFacts[], ps: PlaceFact[], rd: RDbs, st0: AS) -> AS {
        let st: AS = st0
        for (const a of actionPositions(g)) {
            for (const s of sqlsInValue(a.v)) {
                st = errorTwo(a.file, s, false, st)
                st = manualTxDiag(a.file, s, a.what + ", which is not a function declared '!'", "", st)
                st = positionDb(g, rd, a.file, s, st)
                st = addDiag(st, a.file, s.span, "E-BOOTSTRAP-UNSUPPORTED", a.what + " runs a `" + sqlSigil() + "}` query — client code that does server work is split around it (§19.9.5), and the body split arrives with unit U1d. Until then: put the query in a function")
            }
        }
        return st
    }

    // =========================================================================
    // s452 (dpa-066, RATIFIED S452 "all your recs" item 3) — THE EFFECT
    // SUMMARY. One record per CALLABLE — a scrml function, a user
    // declaration's CONSTRUCTION, a FORMULA (a field computed on its read) —
    // computed once, after binding, over the binder's Syms, and closed over
    // the call graph by effects.scrml (strongly connected components,
    // bottom-up; ruling 3.1). Every rule that asks "what does this callable
    // transitively do?" reads it.
    //
    // The OWN facts of a callable come from its body, read once: the write
    // scan (BodyScan — writes, references, unresolvable calls; the no-write
    // rule's banner above), its `?{}` sites, its client reads and DOM globals
    // (placement), whether it reads the clock, and whether a call of it yields
    // a value. The DIMENSIONS, each closed over the references that carry it
    // (per-dimension knowledge, ruling 3.2 — known facts and open reasons are
    // separate dimensions; no global TOP):
    //   writes      §6.7.4 / §6.15 — the cells it may write; every reference
    //               (calls, function values — rule 3 —, the construction a
    //               shared-instance read runs, the formula a derived read runs)
    //   writesOpen  §6.7.4 rule 4 — the calls the analysis cannot resolve; the same references
    //   client      §12.4 R2 — a client-only access (DOM global, cell write,
    //               cell read) of a NON-server function, through non-server
    //               functions: a server callee is judged on its own
    //   routeOpen   §12.4 R3 — the unresolvable calls of a function, through non-server functions
    //   waits       §13.2 / §13.7 item 2 — async colour: a server or split
    //               function, through every function reference
    //   swaits      s468 (U1c, the S467 §13 gate) — it WAITS WHEN IT RUNS ON THE
    //               SERVER: its own body runs a `?{}` query (§13.8 item 2), or it
    //               CALLS a function that does (in place — §13.4), transitively.
    //               ONE place computes it; the suspension plan turns it into a
    //               Suspend at each such call in a server-side body, lower attaches
    //               it as ServerFn.waits / Fn.waits, check.scrml C-S8s re-verifies.
    //   clock       §48.6 / §33.3 item 7 — a body that reads the clock, through
    //               function CALLS (§48.6.2 is a rule about calls; a function
    //               value is refused in the bootstrap)
    //   noValue     §19.4.3 ruling 1a — a call of it yields no value: its own
    //               body (a bare `return`, a path that falls off, `-> void`),
    //               or a `return <call>` of a function that yields none (G7 —
    //               ruling 3.4/3.6: "returns a value" is in the summary)
    // and the ONE placement (§12.2): each function by its own body, an
    // ambient one that reaches client-only code made client (§12.4).
    // =========================================================================
    type CallableK:enum = { KFn, KConstruct, KFormula }
    // `f`: the own facts (a construction / formula has no `?{}`, client read or
    // DOM access of its own here — its reads are cell reads, recorded by the
    // reads that reach it). `clock` / `noValue` / `rets`: functions only.
    type Callable:struct = { kind: CallableK, label: string, f: FnFacts, clock: boolean, noValue: boolean, rets: int[] }
    type Summary:struct = {
        nodes: Callable[],
        writes: FxAtom[][],
        writesOpen: FxAtom[][],
        places: PlaceFact[],
        client: FxAtom[][],
        routeOpen: FxAtom[][],
        waits: FxAtom[][],
        swaits: FxAtom[][],
        clock: FxAtom[][],
        noValue: FxAtom[][],
        // s454 (U1b): the functions server-placed by INHERITANCE (§12.2 Trigger 5),
        // and why each still client-placed helper a server function calls is so
        inherited: int[],
        causes: Cause[],
    }

    fn summarize(g: Globals, t: Tables) -> Summary {
        const cx: PlaceCx = { t: t, g: g }
        let nodes: Callable[] = []
        for (const fs of g.fns) {
            nodes = nodes.concat([{ kind: CallableK.KFn, label: fs.info.name + "()", f: fnFacts(cx, fs), clock: blockClock(fs.f.body),
                                    noValue: ownNoValue(fs), rets: retCallsOf(t, fs) }])
        }
        for (const ds of g.decls) {
            if (!ds.isProgram) {
                const label: string = constructionLabel(ds.info.sym.hint)
                nodes = nodes.concat([{ kind: CallableK.KConstruct, label: label, f: valueFacts(ds.info.sym.id, label, ds.file, ds.info.span, ds.info.nid, constructionScan(t, ds)),
                                        clock: false, noValue: false, rets: [] }])
            }
            for (const fi of ds.info.fields) {
                const w: Sym | not = fi.wcap
                if (w is not) {
                    const flabel: string = formulaLabel(t, fi)
                    const fscan: BodyScan = scanValue({ t: t, file: ds.file }, fi.init, emptyScan())
                    nodes = nodes.concat([{ kind: CallableK.KFormula, label: flabel, f: valueFacts(fi.sym.id, flabel, ds.file, fi.span, fi.nid, fscan),
                                            clock: false, noValue: false, rets: [] }])
                }
            }
        }
        // the references: every one (the write dimensions), those to a function
        // (called or handed on as a value), and the CALLS of a function (the clock)
        let all: int[][] = []
        let fnE: int[][] = []
        let callE: int[][] = []
        for (const c of nodes) {
            all = all.concat([refTargets(nodes, c.f.scan.refs, false)])
            fnE = fnE.concat([refTargets(nodes, c.f.scan.refs, true)])
            callE = callE.concat([callTargets(nodes, c.f.scan.refs)])
        }
        // writes / writesOpen
        let ownW: FxAtom[][] = []
        let ownU: FxAtom[][] = []
        let i: int = 0
        for (const c of nodes) {
            ownW = ownW.concat([writeAtoms(c.f.scan.writes, i)])
            ownU = ownU.concat([openAtoms(c.f.scan.unproven, i)])
            i = i + 1
        }
        // the placement: each function by its own body …
        let direct: PlaceFact[] = []
        for (const c of nodes) {
            if (c.kind == CallableK.KFn) direct = direct.concat([{ sym: c.f.sym, name: c.f.name, place: directPlace(c.f) }])
        }
        // … client reach: non-server functions, through non-server functions
        let ownC: FxAtom[][] = []
        let edgeC: int[][] = []
        i = 0
        for (const c of nodes) {
            if (c.kind == CallableK.KFn && placeOf(direct, c.f.sym) != PlaceK.Server) {
                ownC = ownC.concat([clientAtoms(c.f, i)])
                edgeC = edgeC.concat([notServer(nodes, direct, fnE[i])])
            } else {
                ownC = ownC.concat([[]])
                edgeC = edgeC.concat([[]])
            }
            i = i + 1
        }
        const client: FxAtom[][] = closeDim(ownC, edgeC)
        // … and an ambient function that reaches client-only code is client (§12.4)
        let places: PlaceFact[] = []
        for (const p of direct) {
            let pk: PlaceK = p.place
            if (pk == PlaceK.Ambient && client[nodeIdx(nodes, p.sym)].length > 0) pk = PlaceK.Client
            places = places.concat([{ sym: p.sym, name: p.name, place: pk }])
        }
        // s454 (U1b) — §12.2 Trigger 5 (inheritance) and the client cause (below)
        const prefs: PosRef[] = positionRefs(g, t)
        const rev: int[][] = referrers(nodes, all)
        const inherited: int[] = inheritedFns(nodes, places, rev, prefs)
        const causes: Cause[] = clientCauses(g, nodes, places, rev, prefs, inherited)
        // routeOpen / waits / clock / noValue — functions only
        let ownR: FxAtom[][] = []
        let edgeR: int[][] = []
        let ownA: FxAtom[][] = []
        let edgeF: int[][] = []
        let ownK: FxAtom[][] = []
        let edgeK: int[][] = []
        let ownV: FxAtom[][] = []
        let edgeV: int[][] = []
        let ownQ: FxAtom[][] = []
        i = 0
        for (const c of nodes) {
            // s468 (U1c): a server-side wait — its own `?{}` (closed over CALLS below)
            let q: FxAtom[] = []
            if (c.kind == CallableK.KFn && (c.f.sqls.length > 0 || c.f.foreigns.length > 0)) q = [ownAtom("q", i, 0)]   // s473: a foreign block's value is awaited (§23.2.4a)
            ownQ = ownQ.concat([q])
            if (c.kind == CallableK.KFn) {
                const pk: PlaceK = placeOf(places, c.f.sym)
                ownR = ownR.concat([openAtoms(c.f.scan.unproven, i)])
                edgeR = edgeR.concat([notServer(nodes, places, fnE[i])])
                let a: FxAtom[] = []
                if (pk == PlaceK.Server || pk == PlaceK.Split) a = [ownAtom("s", i, 0)]
                ownA = ownA.concat([a])
                // s454 (U1b): a function server-placed by inheritance calls in place
                // (§13.4) — its calls make nothing wait (they are not client calls)
                if (inherited.indexOf(c.f.sym) >= 0) {
                    edgeF = edgeF.concat([[]])
                } else {
                    edgeF = edgeF.concat([fnE[i]])
                }
                let k: FxAtom[] = []
                if (c.clock) k = [ownAtom("c", i, 0)]
                ownK = ownK.concat([k])
                edgeK = edgeK.concat([callE[i]])
                let v: FxAtom[] = []
                if (c.noValue) v = [ownAtom("v", i, 0)]
                ownV = ownV.concat([v])
                edgeV = edgeV.concat([fnTargets(nodes, c.rets)])
            } else {
                ownR = ownR.concat([[]])
                edgeR = edgeR.concat([[]])
                ownA = ownA.concat([[]])
                edgeF = edgeF.concat([[]])
                ownK = ownK.concat([[]])
                edgeK = edgeK.concat([[]])
                ownV = ownV.concat([[]])
                edgeV = edgeV.concat([[]])
            }
            i = i + 1
        }
        return { nodes: nodes, writes: closeDim(ownW, all), writesOpen: closeDim(ownU, all), places: places,
                 client: client, routeOpen: closeDim(ownR, edgeR), waits: closeDim(ownA, edgeF), swaits: closeDim(ownQ, callE),
                 clock: closeDim(ownK, edgeK), noValue: closeDim(ownV, edgeV), inherited: inherited, causes: causes }
    }

    // =========================================================================
    // s454 (U1b) — §12.2 TRIGGER 5 (INHERITANCE), over the summary's reference
    // graph. §19.9.10 "Which call sites are remote — placement is whole-
    // program": "a helper with no server trigger of its own is server-placed by
    // inheritance (Trigger 5) when every caller is server-placed, and a call
    // inside it is then server→server and not failable on the wire … An
    // implementation SHALL decide 'remote' from the resolved whole-program
    // placement — not from the caller's own body alone."
    //
    // A function is INHERITED when its own body is ambient (no server trigger,
    // no client-only access — PlaceK.Ambient after client reach), it has at
    // least one referrer other than itself, and EVERY referrer is a function
    // that is server-placed or itself inherited — a greatest fixpoint (a cycle
    // of helpers called only from the server is server-placed). Disqualified
    // by any CLIENT referrer: an event handler, an `<effect>` body, a value
    // position (markup, an initializer, an attribute value — positionRefs), a
    // construction or a formula (evaluated on the client), or a function that
    // is not server-placed. A function nobody references is client (§12.1 "The
    // default is client-side execution").
    // =========================================================================
    // A client position's reference to a function: what the position is, where.
    type PosRef:struct = { sym: int, what: string, file: string, span: ASpan }
    // Why a function is client-placed although a server function calls it.
    type Cause:struct = { sym: int, note: string }

    fn positionRefs(g: Globals, t: Tables) -> PosRef[] {
        let out: PosRef[] = []
        for (const a of actionPositions(g)) {
            for (const r of scanValue({ t: t, file: a.file }, a.v, emptyScan()).refs) { out = out.concat([{ sym: r.sym, what: a.what, file: r.file, span: r.span }]) }
        }
        for (const p of valuePositions(g, t)) {
            for (const r of scanValue({ t: t, file: p.file }, p.v, emptyScan()).refs) { out = out.concat([{ sym: r.sym, what: p.what, file: r.file, span: r.span }]) }
        }
        return out
    }

    // rev[j]: the callables whose references name callable j, in node order.
    fn referrers(nodes: Callable[], all: int[][]) -> int[][] {
        let rev: int[][] = []
        let j: int = 0
        for (const c of nodes) {
            let rs: int[] = []
            let i: int = 0
            for (const es of all) {
                if (es.indexOf(j) >= 0) rs = rs.concat([i])
                i = i + 1
            }
            rev = rev.concat([rs])
            j = j + 1
        }
        return rev
    }

    fn posRefTo(prefs: PosRef[], sym: int) -> PosRef | not {
        for (const r of prefs) {
            if (r.sym == sym) return r
        }
        return not
    }

    fn inheritedFns(nodes: Callable[], places: PlaceFact[], rev: int[][], prefs: PosRef[]) -> int[] {
        let inh: int[] = []
        let j: int = 0
        for (const c of nodes) {
            if (c.kind == CallableK.KFn && placeOf(places, c.f.sym) == PlaceK.Ambient && posRefTo(prefs, c.f.sym) is not) {
                let others = false
                let fnsOnly = true
                for (const i of rev[j]) {
                    if (i != j) others = true
                    if (nodes[i].kind != CallableK.KFn) fnsOnly = false
                }
                if (others && fnsOnly) inh = inh.concat([c.f.sym])
            }
            j = j + 1
        }
        let changed = true
        while (changed) {
            changed = false
            let keep: int[] = []
            for (const sym of inh) {
                const k: int = nodeIdx(nodes, sym)
                let ok = true
                for (const i of rev[k]) {
                    const isym: int = nodes[i].f.sym
                    if (i != k && placeOf(places, isym) != PlaceK.Server && inh.indexOf(isym) < 0) ok = false
                }
                if (ok) {
                    keep = keep.concat([sym])
                } else {
                    changed = true
                }
            }
            inh = keep
        }
        return inh
    }

    // §19.9.10: "When a helper's placement flips because a client caller was
    // added — the helper was server-placed by inheritance, and a new client
    // call to it makes it client-placed, so its own server calls become client
    // calls — any diagnostic this rule then raises inside the helper … SHALL
    // name that client caller (file and line) as the cause". A helper whose own
    // body is ambient, that a server-placed (or inherited) function calls, and
    // that is still client-placed: the FIRST client referrer is the cause.
    fn clientCauses(g: Globals, nodes: Callable[], places: PlaceFact[], rev: int[][], prefs: PosRef[], inh: int[]) -> Cause[] {
        let out: Cause[] = []
        let j: int = 0
        for (const c of nodes) {
            if (c.kind == CallableK.KFn && placeOf(places, c.f.sym) == PlaceK.Ambient && inh.indexOf(c.f.sym) < 0) {
                let serverSide = false
                let who: string = ""
                let at: string = ""
                for (const i of rev[j]) {
                    const n: Callable = nodes[i]
                    const isym: int = n.f.sym
                    const onServer: boolean = n.kind == CallableK.KFn && (placeOf(places, isym) == PlaceK.Server || inh.indexOf(isym) >= 0)
                    if (i != j && onServer) serverSide = true
                    if (i != j && !onServer && who == "") {
                        who = "`" + n.label + "`"
                        at = refSiteIn(g, n.f.scan.refs, c.f.sym)
                    }
                }
                const pr: PosRef | not = posRefTo(prefs, c.f.sym)
                if (pr is given && who == "") {
                    who = pr.what
                    at = pr.file + ":" + lineOf(g, pr.file, pr.span.start)
                }
                if (serverSide && who != "") {
                    out = out.concat([{ sym: c.f.sym, note: " — `" + c.f.name + "()` is client-placed because " + who + " calls it (" + at + "); called only from server functions it would be server-placed (§12.2 Trigger 5) and this call would be made in place on the server (§19.9.10 \"placement is whole-program\")" }])
                }
            }
            j = j + 1
        }
        return out
    }

    // "file:line" of the first reference in `refs` to function `sym`.
    fn refSiteIn(g: Globals, refs: FnRef[], sym: int) -> string {
        for (const r of refs) {
            if (r.sym == sym) return r.file + ":" + lineOf(g, r.file, r.span.start)
        }
        return ""
    }

    // The 1-based line of `offset` in `file` (parse.scrml records each file's line starts).
    fn lineOf(g: Globals, file: string, offset: int) -> int {
        for (const f of g.files) {
            if (f.path == file) {
                let n: int = 0
                for (const st of f.lines) {
                    if (st <= offset) n = n + 1
                }
                return n
            }
        }
        return 0
    }

    // ---- the rules pass's client-call queries --------------------------------------
    // Is a call made in function `caller` a CLIENT call? (-1: an event handler or
    // an effect body — client by position.) Server-placed by its own body, or by
    // inheritance: no.
    fn callerRemote(s: Summary, caller: int) -> boolean {
        if (caller < 0) return true
        if (placeOf(s.places, caller) == PlaceK.Server) return false
        return s.inherited.indexOf(caller) < 0
    }

    fn remoteOr(s: Summary, caller: int, r: Diag[], l: Diag[]) -> Diag[] {
        if (!callerRemote(s, caller)) return l
        let note: string = ""
        for (const c of s.causes) {
            if (c.sym == caller) note = c.note
        }
        if (note == "") return r
        let out: Diag[] = []
        for (const d of r) { out = out.concat([newDiag(d.code, d.message + note, d.file, d.span)]) }
        return out
    }

    // The own facts of a construction / a formula: its scan only.
    fn valueFacts(sym: int, label: string, file: string, span: ASpan, nid: int, scan: BodyScan) -> FnFacts {
        return { sym: sym, name: label, file: file, span: span, nid: nid, modifier: false, failable: false,
                 sqls: [], reads: [], doms: [], scan: scan, foreigns: [], repeats: [] }
    }

    // The callable a Sym names (-1: none — a reference with no summary).
    fn nodeIdx(nodes: Callable[], sym: int) -> int {
        let i: int = 0
        for (const c of nodes) {
            if (c.f.sym == sym) return i
            i = i + 1
        }
        return -1
    }

    fn isFnNode(nodes: Callable[], i: int) -> boolean {
        if (i < 0) return false
        return nodes[i].kind == CallableK.KFn
    }

    // The callables a body's references name, in source order (`fnOnly`: functions only).
    fn refTargets(nodes: Callable[], refs: FnRef[], fnOnly: boolean) -> int[] {
        let out: int[] = []
        for (const r of refs) {
            const j: int = nodeIdx(nodes, r.sym)
            if (j >= 0 && (!fnOnly || isFnNode(nodes, j))) out = out.concat([j])
        }
        return out
    }

    // The functions a body CALLS (§48.6.2's purity rule is about calls, and a
    // function value is refused in the bootstrap — the clock follows calls).
    fn callTargets(nodes: Callable[], refs: FnRef[]) -> int[] {
        let out: int[] = []
        for (const r of refs) {
            const j: int = nodeIdx(nodes, r.sym)
            if (!r.asValue && isFnNode(nodes, j)) out = out.concat([j])
        }
        return out
    }

    fn fnTargets(nodes: Callable[], syms: int[]) -> int[] {
        let out: int[] = []
        for (const s of syms) {
            const j: int = nodeIdx(nodes, s)
            if (isFnNode(nodes, j)) out = out.concat([j])
        }
        return out
    }

    // The references to a function NOT placed on the server (a server callee is judged on its own).
    fn notServer(nodes: Callable[], ps: PlaceFact[], es: int[]) -> int[] {
        let out: int[] = []
        for (const j of es) {
            if (placeOf(ps, nodes[j].f.sym) != PlaceK.Server) out = out.concat([j])
        }
        return out
    }

    fn writeAtoms(ws: WSite[], i: int) -> FxAtom[] {
        let out: FxAtom[] = []
        let k: int = 0
        for (const w of ws) {
            out = out.concat([ownAtom("w:" + w.cell, i, k)])
            k = k + 1
        }
        return out
    }

    fn openAtoms(us: USite[], i: int) -> FxAtom[] {
        let out: FxAtom[] = []
        let k: int = 0
        for (const u of us) {
            out = out.concat([ownAtom("u:" + u.file + ":" + u.span.start, i, k)])
            k = k + 1
        }
        return out
    }

    // A function's own client-only accesses, in §12.4's order of report: its
    // DOM globals, then its cell writes, then its cell reads.
    fn clientWhats(f: FnFacts) -> string[] {
        let out: string[] = []
        for (const d of f.doms) { out = out.concat([d.what]) }
        for (const w of f.scan.writes) { out = out.concat(["writes `" + w.cell + "`"]) }
        for (const r of f.reads) { out = out.concat(["reads `" + r.what + "`"]) }
        return out
    }

    fn clientAtoms(f: FnFacts, i: int) -> FxAtom[] {
        let out: FxAtom[] = []
        let k: int = 0
        for (const w of clientWhats(f)) {
            out = out.concat([ownAtom("c:" + w, i, k)])
            k = k + 1
        }
        return out
    }

    // ---- the own "yields a value" fact (§19.4.3 ruling 1a) -----------------------
    // Does a call of the function produce no value, by its OWN body? A declared
    // return type does produce one (`-> void` declares that it does not, §7.5 —
    // FnInfo.ret is `not` for it); a `!` function's result is handled, never
    // read as a value; otherwise the body decides — a value on EVERY path,
    // proven syntactically, FAIL CLOSED:
    //   - s452 r3 (MED-B): a bare `return` ANYWHERE in the body (any depth — an
    //     `if` branch, a `given` body, a handling form's arm block) is a path
    //     with no value;
    //   - otherwise the statements are walked in order and the FIRST one that
    //     returns a value on every path through it decides (s452 r3 LOW-C — what
    //     follows it is dead): `return <expr>`, or an `if` / `else` both of whose
    //     blocks do. Reaching the end of the body is no value.
    //   - A `fn` / `function` body's tail EXPRESSION is not a value: the
    //     bootstrap gives neither implicit tail return (`fn h() { "a" }` prints
    //     `function h() { "a"; }` — returns nothing; checked s452 r3).
    // Unprovable, so judged "no value": a `given` (its body runs only when the
    // value is present), a statement-position handling form whose arms return,
    // an `if` without `else`. What a `return <call>` returns is the CALLEE's
    // (retCallsOf — the summary closes it, G7).
    fn ownNoValue(fs: FnSrc) -> boolean {
        if (fs.info.ret is given || fs.info.failable) return false
        const r: AType | not = fs.f.ret
        if (r is given) return declaresVoid(r)
        if (blockHasBareReturn(fs.f.body)) return true
        return !blockYieldsOnAllPaths(fs.f.body)
    }

    // G7 (dpa-066): every `return <call of a scrml function>` in a function's
    // body, at any depth — the value it returns is that callee's, so a callee
    // that yields none makes this a path with no value. (A `!` function's
    // result is handled: none. A `-> void` function yields none already.)
    fn retCallsOf(t: Tables, fs: FnSrc) -> int[] {
        if (fs.info.failable) return []
        return retCallsBlock(t, fs.f.body)
    }

    // r2 LOW-1: the s452 r3 rule — an earlier statement that leaves on every
    // path decides; the dead code after it is not a return path (so
    // `{ return "x"; return nothing() }` yields a value).
    fn retCallsBlock(t: Tables, b: ABlock) -> int[] {
        let out: int[] = []
        for (const s of b.stmts) {
            out = out.concat(retCallsStmt(t, s))
            if (leavesOnAllPaths(s)) return out
        }
        return out
    }

    // Does `s` leave the function on every path through it (`return`, `fail`,
    // or an `if` / `else` both of whose blocks do)?
    fn leavesOnAllPaths(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> true
            .Fail(f: x) :> true
            .If(cond: c, thenB: tb, elseB: eb) :> blockLeaves(tb) && maybeBlockLeaves(eb)
            .Given(name: n) :> false
            .For(f: lf) :> loopNeverCompletes(lf)
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: x) :> false
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false
        }
    }

    fn blockLeaves(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (leavesOnAllPaths(s)) return true
        }
        return false
    }

    fn maybeBlockLeaves(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockLeaves(b)
    }

    fn retCallsStmt(t: Tables, s: AStmt) -> int[] {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> retCallsReturn(t, x)
            .If(cond: c, thenB: tb, elseB: eb) :> retCallsExpr(t, c).concat(retCallsBlock(t, tb)).concat(retCallsElse(t, eb))
            .Given(name: n, subject: x, body: b) :> retCallsExpr(t, x).concat(retCallsBlock(t, b))
            .For(f: lf) :> forRetCalls(t, lf)
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> liftRetCalls(t, w)
            .Eval(e: x) :> retCallsExpr(t, x)
            .Local(name: n, init: i) :> retCallsExpr(t, i)
            .EffectStmt(w: w) :> []
            .Defer(body: d) :> []                       // a deferred body holds no `return` (§19.16.3 rule 1)
            .Fail(f: x) :> []
        }
    }

    fn retCallsElse(t: Tables, b: ABlock | not) -> int[] {
        if (b is not) return []
        return retCallsBlock(t, b)
    }

    fn retCallsReturn(t: Tables, x: AExpr | not) -> int[] {
        if (x is not) return []
        let out: int[] = retCallsExpr(t, x)
        const c: AExpr | not = calleeOf(x.k)
        if (c is given) {
            const s: Sym | not = fnSymOf(nameFact(t.names, c.nid))
            if (s is given) out = [s.id].concat(out)
        }
        return out
    }

    // ... a `return` inside a handling form's arm block in `e`, at any depth.
    fn liftRetCalls(t: Tables, w: ALift) -> int[] {
        let out: int[] = []
        for (const e of liftExprs(w)) { out = out.concat(retCallsExpr(t, e)) }
        return out
    }

    fn retCallsExpr(t: Tables, e: AExpr) -> int[] {
        let out: int[] = []
        for (const b of exprBlocks(e)) { out = out.concat(retCallsBlock(t, b)) }
        for (const x of exprKids(e)) { out = out.concat(retCallsExpr(t, x)) }
        return out
    }

    // ---- the queries -------------------------------------------------------------
    // The witness of callable `i` in a dimension, as the chain of labels down to it.
    fn fxChain(s: Summary, dim: FxAtom[][], i: int, a: FxAtom) -> string[] {
        let out: string[] = []
        for (const j of atomChain(dim, i, a)) { out = out.concat([s.nodes[j].label]) }
        return out
    }

    // =========================================================================
    // s452 (dpa-066 M3) — THE RULES PASS: the binder's decisions that read the
    // effect summary. The binder (phaseB) meets them before any summary
    // exists, so it records each (addPending) with the diagnostic(s) it would
    // report and the position in the diagnostic list where it would have
    // reported it; here each is decided by a query and its diagnostic put
    // back at that position — the diagnostics keep the order the binder gave
    // them.
    //   IfNoValue    §19.4.3 ruling 1a — E-ERROR-012 when the arm's callee
    //                yields no value (noValue: transitive through `return <call>`,
    //                which closes G7; fail closed: an unknown callee yields none)
    //   RemoteOr     s454 (U1b) §19.9.10 — a call of a server function in a
    //                function with no server trigger of its own: `remote` when
    //                that function is client-placed in the WHOLE program (not
    //                inherited onto the server, §12.2 Trigger 5), else `local`;
    //                a remote diagnostic names the client caller that made it so
    //                (clientCause — "SHALL name that client caller (file and line)")
    //   IfClock      a call of a clock reader where the clock is not in the
    //                bootstrap (the summary's `clock`, through calls)
    //   PureCall     E-FN-003, its message naming the clock when the callee reads it
    // =========================================================================
    type PendRule:enum = {
        IfNoValue(fnSym: int, diag: Diag),
        RemoteOr(caller: int, remote: Diag[], local: Diag[]),
        IfClock(fnSym: int, diag: Diag),
        PureCall(fnSym: int, bare: Diag, clocked: Diag),
    }
    type Pending:struct = { at: int, rule: PendRule }

    fn rulesPass(s: Summary, st: AS) -> AS {
        if (st.pend.length == 0) return st
        let out: Diag[] = []
        let k: int = 0
        let i: int = 0
        while (i <= st.diags.length) {
            while (k < st.pend.length && st.pend[k].at == i) {
                out = out.concat(decide(s, st.pend[k].rule))
                k = k + 1
            }
            if (i < st.diags.length) out = out.concat([st.diags[i]])
            i = i + 1
        }
        return { facts: st.facts, diags: out, nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects, pend: [], lifts: st.lifts }
    }

    fn decide(s: Summary, r: PendRule) -> Diag[] {
        return match r {
            .IfNoValue(fnSym: f, diag: d) :> onlyIf(yieldsNoValue(s, f), d)
            .RemoteOr(caller: c, remote: r, local: l) :> remoteOr(s, c, r, l)
            .IfClock(fnSym: f, diag: d) :> onlyIf(readsClock(s, f), d)
            .PureCall(fnSym: f, bare: a, clocked: b) :> either(readsClock(s, f), b, a)
        }
    }

    fn onlyIf(yes: boolean, d: Diag) -> Diag[] {
        if (yes) return [d]
        return []
    }

    fn either(yes: boolean, a: Diag, b: Diag) -> Diag[] {
        if (yes) return [a]
        return [b]
    }

    // ---- the queries ----------------------------------------------------------------
    // Does a call of function `sym` yield no value? An unknown callee: fail
    // closed (dpa-066 G10 — the walker this replaces failed open).
    fn yieldsNoValue(s: Summary, sym: int) -> boolean {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return true
        return s.noValue[i].length > 0
    }

    // §12.2 T1 / T4: its own body has a `?{}` or the deprecated `server` modifier.
    fn serverTriggeredFn(s: Summary, sym: int) -> boolean {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return false
        return serverTriggered(s.nodes[i].f)
    }

    // Does function `sym` read the clock, itself or through a call?
    fn readsClock(s: Summary, sym: int) -> boolean {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return false
        return s.clock[i].length > 0
    }

    // =========================================================================
    // s454 (U1b) — THE SUSPENSION PLAN (design §2.2 "Where a ServerCall can
    // stand — ANF with refusal positions"). Per SITE, after the summary (it
    // reads the whole-program placement and the async colour — no transitive
    // question is answered here; those are the summary's). For every CLIENT
    // body — a client-placed function, an event handler, an `<effect>` body —
    // it finds the SUSPENSION POINTS:
    //   - a handling form (`!{}` / `match` / `?`) on a call of a server
    //     function made on the client (HandledFact.remote, caller remote);
    //   - a call of a WAITING client function (§13.2 async colour: the
    //     summary's `waits`) — a handled one, a plain one, or a handler
    //     reference that names one;
    // and decides each by POSITION, lowering the ones with a statement boundary
    // to suspend at and refusing (fail closed, naming the lifting slice) the
    // ones without:
    //   lowered   a statement's whole value; a call argument, an operand, an
    //             array element, an object value, a member / index operand, an
    //             `if` condition, a `return` / `let` value — ANF: everything
    //             evaluated BEFORE the point (left to right) is evaluated into a
    //             temporary first (TempFact), so order is kept; a point inside an
    //             `if` / `given` branch with statements after it — a Join
    //             (JoinFact) the branches jump to.
    //   refused   the right operand of `&&` / `||`, a ternary branch (it runs on
    //             one path only); a `!{}` / `match` arm; a `defer` body (and any
    //             `defer` in a function that waits — its body would run at the
    //             synchronous exit, §19.16.2); a lambda body (an awaited
    //             combinator, §13.2); the value of an indexed write.
    // The binder minted the Suspend's bind for a handling form
    // (HandledFact.outcome); a plain call's bind, the temporaries and the join
    // continuations are minted here. `waiting`: the client functions whose
    // body holds a suspension point — Core's Fn.waits (check.scrml C-S8).
    // =========================================================================
    // s468 (U1c): SQuery — a `?{}` in a server-side body; SLocal — an in-place call
    // (server→server, §13.4) of a function that waits on the server (`swaits`).
    export type SuspendK:enum = { SRemote(callee: Sym), SWaits(callee: Sym), SQuery, SLocal(callee: Sym) }
    export type SuspendAt:struct = { nid: int, bind: Sym, kind: SuspendK }
    export type TempFact:struct = { nid: int, sym: Sym }
    export type JoinFact:struct = { nid: int, k: Sym }
    // `rets`: the WIRE type of a server function's answer that declares none — a
    // `!` function cannot (§19.4.1: "its success type is inferred from its
    // returns", §19.4.2), so the client decodes against the type its `return`s
    // prove (routedChecks).
    export type RetFact:struct = { sym: int, ty: Type }
    export type SuspendPlan:struct = { at: SuspendAt[], temps: TempFact[], joins: JoinFact[], waiting: int[], rets: RetFact[] }

    export fn noPlan() -> SuspendPlan { return { at: [], temps: [], joins: [], waiting: [], rets: [] } }

    export fn retOf(p: SuspendPlan, sym: int) -> Type | not {
        for (const r of p.rets) {
            if (r.sym == sym) return r.ty
        }
        return not
    }

    export fn suspendAtOf(p: SuspendPlan, nid: int) -> SuspendAt | not {
        for (const a of p.at) {
            if (a.nid == nid) return a
        }
        return not
    }

    export fn tempOf(p: SuspendPlan, nid: int) -> Sym | not {
        for (const x of p.temps) {
            if (x.nid == nid) return x.sym
        }
        return not
    }

    export fn joinOf(p: SuspendPlan, nid: int) -> Sym | not {
        for (const j of p.joins) {
            if (j.nid == nid) return j.k
        }
        return not
    }

    // The planner's running state.
    type PS:struct = { st: AS, plan: SuspendPlan }
    // A body being planned: its file, and what it is (for messages). s468 (U1c):
    // `server` — a SERVER-side body (a server-placed function, or one server-placed
    // by §12.2 Trigger 5), whose waits are in place (the S467 §13 gate).
    type PCx:struct = { g: Globals, t: Tables, s: Summary, file: string, inFn: boolean, server: boolean }
    // `found`: the expression holds a suspension point (lowered or refused).
    type PX:struct = { found: boolean, ps: PS }
    // Why a position cannot suspend ("" — it can).
    type Pos:struct = { refused: string }

    fn okPos() -> Pos { return { refused: "" } }

    fn planPass(g: Globals, t: Tables, s: Summary, st0: AS) -> PS {
        let ps: PS = { st: st0, plan: noPlan() }
        for (const fs of g.fns) {
            const sym: int = fs.info.sym.id
            const pk: PlaceK = placeOf(s.places, sym)
            if ((pk == PlaceK.Client || pk == PlaceK.Ambient) && s.inherited.indexOf(sym) < 0) {
                const cx: PCx = { g: g, t: t, s: s, file: fs.info.file, inFn: true, server: false }
                const before: int = ps.plan.at.length
                ps = planBlock(cx, fs.f.body, ps)
                if (ps.plan.at.length > before) {
                    ps = withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps, joins: ps.plan.joins, waiting: ps.plan.waiting.concat([sym]), rets: ps.plan.rets })
                    // a `defer` in a function that waits (§19.16.2 exit timing)
                    for (const d of defersIn(fs.f.body)) {
                        ps = pdiag(ps, cx, d, "a `defer` in a function that waits for the server (`" + fs.info.name + "()` suspends on a server call) — its body would run when the function's synchronous part ends, BEFORE the server answers, not at the function's exit (§19.16.2). It arrives with the §19.16.6 async-`defer` slice; until then move the cleanup after the call's handling")
                    }
                }
            } else if (pk == PlaceK.Server || s.inherited.indexOf(sym) >= 0) {
                // s468 (U1c, the S467 §13 gate): a SERVER-side body. Its waits — a
                // `?{}`, an in-place call of a function that waits on the server —
                // are suspension points with the SAME position table as the client
                // (amendment item 2: a position that cannot wait is refused). Its
                // `defer` is not refused: the server prints native `async`, where a
                // `try … finally` runs at the function's real exit (§19.16.2).
                const scx: PCx = { g: g, t: t, s: s, file: fs.info.file, inFn: true, server: true }
                const sbefore: int = ps.plan.at.length
                ps = planBlock(scx, fs.f.body, ps)
                if (ps.plan.at.length > sbefore) {
                    ps = withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps, joins: ps.plan.joins, waiting: ps.plan.waiting.concat([sym]), rets: ps.plan.rets })
                }
            }
        }
        for (const a of actionPositions(g)) {
            const cx2: PCx = { g: g, t: t, s: s, file: a.file, inFn: false, server: false }
            ps = planValue(cx2, a.v, ps)
        }
        return ps
    }

    fn withPlan(ps: PS, p: SuspendPlan) -> PS { return { st: ps.st, plan: p } }

    fn pdiag(ps: PS, cx: PCx, span: ASpan, msg: string) -> PS {
        return { st: addDiag(ps.st, cx.file, span, "E-BOOTSTRAP-UNSUPPORTED", msg), plan: ps.plan }
    }

    fn pmint(ps: PS, hint: string) -> RPSym {
        const r: RSym = mint(ps.st, hint)
        return { s: r.s, ps: { st: r.st, plan: ps.plan } }
    }
    type RPSym:struct = { s: Sym, ps: PS }

    // An event-handler value (a reference, an expression, a block) or an effect body.
    fn planValue(cx: PCx, v: AAttrValue, ps: PS) -> PS {
        return match v {
            .Bare(e: e) :> planHandlerExpr(cx, e, ps)
            .Paren(e: e) :> planHandlerExpr(cx, e, ps)
            .Braced(b: b) :> planBraced(cx, b, ps)
            .Quoted(v: x) :> ps
            .NoValue :> ps
        }
    }

    fn planBraced(cx: PCx, b: ABlock, ps: PS) -> PS {
        const r: AExpr | not = blockReference(b)
        if (r is given) return planReference(cx, r, ps)
        return planBlock(cx, b, ps)
    }

    fn planHandlerExpr(cx: PCx, e: AExpr, ps: PS) -> PS {
        if (exprName(e) != "") return planReference(cx, e, ps)
        return planExpr(cx, e, okPos(), ps).ps
    }

    // `onclick=save` / `onclick={ save }` — the event CALLS the function: a
    // suspension point when it waits.
    fn planReference(cx: PCx, e: AExpr, ps: PS) -> PS {
        const f: Sym | not = fnSymOf(nameFact(cx.t.names, e.nid))
        if (f is not) return ps
        if (!waitingClientFn(cx, f.id)) return ps
        const rb: RPSym = pmint(ps, "settled")
        return addAt(rb.ps, { nid: e.nid, bind: rb.s, kind: SuspendK.SWaits(f) })
    }

    fn addAt(ps: PS, a: SuspendAt) -> PS {
        return withPlan(ps, { at: ps.plan.at.concat([a]), temps: ps.plan.temps, joins: ps.plan.joins, waiting: ps.plan.waiting, rets: ps.plan.rets })
    }

    // Is function `sym` a client function that waits (§13.2 async colour)?
    fn waitingClientFn(cx: PCx, sym: int) -> boolean {
        const pk: PlaceK = placeOf(cx.s.places, sym)
        if (pk == PlaceK.Server || pk == PlaceK.Split) return false
        if (cx.s.inherited.indexOf(sym) >= 0) return false
        return waitsOf(cx.s, sym) is given
    }

    fn planBlock(cx: PCx, b: ABlock, ps0: PS) -> PS {
        let ps: PS = ps0
        let i: int = 0
        for (const s of b.stmts) {
            const rest: boolean = i < b.stmts.length - 1
            ps = planStmt(cx, s, rest, ps)
            i = i + 1
        }
        return ps
    }

    fn planStmt(cx: PCx, s: AStmt, rest: boolean, ps: PS) -> PS {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> planStmtExpr(cx, e, ps)
            .Local(name: n, init: i) :> planExpr(cx, i, okPos(), ps).ps
            .Return(e: e) :> planMaybe(cx, e, ps)
            .If(cond: c, thenB: tb, elseB: eb) :> planBranches(cx, s, [tb].concat(maybeBlockList(eb)), rest, planExpr(cx, c, okPos(), ps).ps)
            .Given(name: n, subject: x, body: b) :> planBranches(cx, s, [b], rest, planExpr(cx, x, okPos(), ps).ps)
            .For(f: lf) :> planLoop(cx, s, lf, ps)
            .Break(label: x) :> ps
            .Continue(label: x) :> ps
            .Lift(what: w) :> planExprs(cx, liftExprs(w), ps)
            .EffectStmt(w: w) :> ps
            .Defer(body: b) :> planDeferBody(cx, b, ps)
            .Fail(f: f) :> planExprs(cx, failExprs(f), ps)
        }
    }

    fn maybeBlockList(b: ABlock | not) -> ABlock[] {
        if (b is not) return []
        return [b]
    }

    fn planMaybe(cx: PCx, e: AExpr | not, ps: PS) -> PS {
        if (e is not) return ps
        return planExpr(cx, e, okPos(), ps).ps
    }

    fn planExprs(cx: PCx, es: AExpr[], ps0: PS) -> PS {
        let ps: PS = ps0
        for (const e of es) { ps = planExpr(cx, e, okPos(), ps).ps }
        return ps
    }

    // An expression statement: an assignment's TARGET is written after its
    // value; an indexed target's index is evaluated in the write (refused).
    fn planStmtExpr(cx: PCx, e: AExpr, ps: PS) -> PS {
        const k: AExprK = e.k
        const t: AExpr | not = assignTargetOf(k)
        const v: AExpr | not = assignedValue(e)
        if (t is given && v is given) {
            let pos: Pos = okPos()
            if (isIndexTarget(t)) pos = { refused: "the value of an indexed write (`@xs[i] = …`) — its index is evaluated in the write, after the value; it arrives with the U1b ANF follow-up. Evaluate the call into a `const` first" }
            // s472: an INDEX of the target is evaluated in the write too — a waiting call
            // there is refused the same way (never left un-awaited in the Core)
            let ps2: PS = ps
            for (const ix of targetIndices(t)) {
                ps2 = planExpr(cx, ix, { refused: "an index of an indexed write (`xs[i] = …`) — it is evaluated in the write; it arrives with the U1b ANF follow-up. Evaluate the call into a `const` first" }, ps2).ps
            }
            return planExpr(cx, v, pos, ps2).ps
        }
        return planExpr(cx, e, okPos(), ps).ps
    }

    fn assignTargetOf(k: AExprK) -> AExpr | not {
        return match k {
            .Assign(target: t) :> t
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .Foreign(f: fb0) :> not
        }
    }

    // s472 — the index expressions of a write target (`a.xs[i][j].f` → i, j).
    fn targetIndices(t: AExpr) -> AExpr[] {
        const k: AExprK = t.k
        return match k {
            .Index(obj: o, idx: i) :> targetIndices(o).concat([i])
            .Member(obj: o) :> targetIndices(o)
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: x) :> []
            .Assign(target: x) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    fn isIndexTarget(t: AExpr) -> boolean {
        const k: AExprK = t.k
        return match k {
            .Index(obj: o) :> true
            .Member(obj: o) :> isIndexTarget(o)
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // An `if` / `given`: plan each branch; when one suspends and statements
    // follow, the statement gets a join continuation.
    fn planBranches(cx: PCx, s: AStmt, bs: ABlock[], rest: boolean, ps0: PS) -> PS {
        let ps: PS = ps0
        const before: int = ps.plan.at.length
        for (const b of bs) { ps = planBlock(cx, b, ps) }
        if (ps.plan.at.length > before && rest) {
            const rk: RPSym = pmint(ps, "join")
            ps = rk.ps
            ps = withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps, joins: ps.plan.joins.concat([{ nid: s.nid, k: rk.s }]), waiting: ps.plan.waiting, rets: ps.plan.rets })
        }
        return ps
    }

    // A deferred body: no suspension point may stand in it (check.scrml C16).
    // s471 review F1: at EVERY depth — an `if` / `given` branch, a loop's head and
    // body inside the deferred body (loopPlanBlocks) — with the same refusal.
    fn planDeferBody(cx: PCx, b: ABlock, ps0: PS) -> PS {
        let ps: PS = ps0
        for (const s of b.stmts) {
            for (const e of stmtExprs(s)) { ps = planExpr(cx, e, { refused: "a `defer` body — a deferred body cannot wait (C16; §19.16.6 async `defer` arrives with its own slice)" }, ps).ps }
            for (const nb of loopPlanBlocks(s)) { ps = planDeferBody(cx, nb, ps) }
        }
        return ps
    }

    // The expressions a statement evaluates directly (not its nested blocks').
    fn stmtExprs(s: AStmt) -> AExpr[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> [e]
            .Local(name: n, init: i) :> [i]
            .Return(e: e) :> maybeExprList(e)
            .If(cond: c) :> [c]
            .Given(name: n, subject: x) :> [x]
            .For(f: lf) :> forHeadExprs(lf)
            .Break(label: x) :> []
            .Continue(label: x) :> []
            .Lift(what: w) :> liftExprs(w)
            .EffectStmt(w: w) :> []
            .Defer(body: b) :> []
            .Fail(f: f) :> failExprs(f)
        }
    }

    fn maybeExprList(e: AExpr | not) -> AExpr[] {
        if (e is not) return []
        return [e]
    }

    // The `defer` statements of a function body, at any depth (their spans).
    fn defersIn(b: ABlock) -> ASpan[] {
        let out: ASpan[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const sub: ASpan[] = match k {
                .Defer(body: d) :> [s.span]
                .If(cond: c, thenB: tb, elseB: eb) :> defersIn(tb).concat(defersInMaybe(eb))
                .Given(name: n, body: gb) :> defersIn(gb)
                .For(f: lf) :> defersIn(lf.body)
                .Break(label: x) :> []
                .Continue(label: x) :> []
                .Lift(what: x) :> []
                .Eval(e: x) :> []
                .Local(name: n) :> []
                .Return(e: x) :> []
                .EffectStmt(w: w) :> []
                .Fail(f: x) :> []
            }
            out = out.concat(sub)
        }
        return out
    }

    fn defersInMaybe(b: ABlock | not) -> ASpan[] {
        if (b is not) return []
        return defersIn(b)
    }

    // ---- an expression -------------------------------------------------------------
    // Walk `e` in evaluation order. A child that holds a suspension point makes
    // every EARLIER sibling a temporary (unless it is a literal), so it is
    // evaluated before the suspension (left-to-right order kept).
    fn planExpr(cx: PCx, e: AExpr, pos: Pos, ps0: PS) -> PX {
        let ps: PS = ps0
        const sp: SuspendK | not = suspendKindAt(cx, e)
        if (sp is given) {
            // the point's own arguments are evaluated before it suspends
            ps = planKids(cx, suspendArgs(e), pos, ps).ps
            if (pos.refused != "") return { found: true, ps: pdiag(ps, cx, e.span, suspendWhat(sp) + " in " + pos.refused) }
            ps = routedChecks(cx, e, sp, ps)
            // a suspending handling form's arms run in its continuation: none may suspend (first cut)
            const hh: AHandled | not = handledOf(e.k)
            if (hh is given) ps = planArms(cx, hh, ps)
            const bind: Sym | not = handledOutcome(cx, e)
            if (bind is given) return { found: true, ps: addAt(ps, { nid: e.nid, bind: bind, kind: sp }) }
            const rb: RPSym = pmint(ps, "settled")
            return { found: true, ps: addAt(rb.ps, { nid: e.nid, bind: rb.s, kind: sp }) }
        }
        const k: AExprK = e.k
        return match k {
            .Binary(op: o, l: l, r: r) :> planBinary(cx, o, l, r, pos, ps)
            .Ternary(test: t, yes: y, no: n) :> planTernary(cx, t, y, n, pos, ps)
            .Lambda(params: lp, body: b) :> planExpr(cx, b, { refused: "a lambda (`xs.map(x => …)`) — an awaited combinator (§13.2) is not in the bootstrap; it arrives with the §13.2 awaited-combinator slice. Call it in a statement" }, ps)
            .Handled(h: h) :> planHandledArms(cx, h, pos, ps)
            .Template(quasis: qs, slots: ss) :> planKids(cx, ss, pos, ps)
            .Foreign(f: fb0) :> planKids(cx, fb0.crossings, pos, ps)
            .Member(obj: o) :> planKids(cx, [o], pos, ps)
            .Call(callee: c, args: a) :> planKids(cx, a, pos, ps)
            .Unary(op: o, e: x) :> planKids(cx, [x], pos, ps)
            .Assign(target: t, value: v) :> planKids(cx, [v], pos, ps)
            .ArrayLit(elems: es) :> planKids(cx, es, pos, ps)
            .ObjectLit(props: pr) :> planKids(cx, propValueList(pr), pos, ps)
            .Spread(e: x) :> planKids(cx, [x], pos, ps)
            .Index(obj: o, idx: i) :> planKids(cx, [o, i], pos, ps)
            .Sql(q: q) :> planKids(cx, distinctSqlParams(q.params), pos, ps)
            .Name(name: n) :> { found: false, ps: ps }
            .At(name: n) :> { found: false, ps: ps }
            .AtItem :> { found: false, ps: ps }
            .Num(raw: r) :> { found: false, ps: ps }
            .Str(v: s) :> { found: false, ps: ps }
            .Bool(v: b) :> { found: false, ps: ps }
            .NotLit :> { found: false, ps: ps }
            .Recovered :> { found: false, ps: ps }
            .Variant(name: n) :> { found: false, ps: ps }
        }
    }

    // Children in evaluation order; a temporary for each non-literal child
    // evaluated before a later child that holds a suspension point.
    fn planKids(cx: PCx, kids: AExpr[], pos: Pos, ps0: PS) -> PX {
        let ps: PS = ps0
        let found = false
        let i: int = 0
        for (const k of kids) {
            const r: PX = planExpr(cx, k, pos, ps)
            ps = r.ps
            if (r.found) {
                found = true
                let j: int = 0
                for (const prev of kids) {
                    if (j < i && !isLiteralExpr(prev) && tempOf(ps.plan, prev.nid) is not && suspendAtOf(ps.plan, prev.nid) is not) {
                        const rt: RPSym = pmint(ps, "tmp")
                        ps = rt.ps
                        ps = withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps.concat([{ nid: prev.nid, sym: rt.s }]), joins: ps.plan.joins, waiting: ps.plan.waiting, rets: ps.plan.rets })
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        return { found: found, ps: ps }
    }

    fn isLiteralExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> true
            .Str(v: s) :> true
            .Bool(v: b) :> true
            .NotLit :> true
            .Variant(name: n) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Recovered :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // `a && f()` / `a || f()`: the right operand runs on one path only.
    fn planBinary(cx: PCx, o: BinOp, l: AExpr, r: AExpr, pos: Pos, ps: PS) -> PX {
        if (o == BinOp.And || o == BinOp.Or) {
            const rl: PX = planExpr(cx, l, pos, ps)
            const rr: PX = planExpr(cx, r, condPos(pos, "the right operand of `&&` / `||`"), rl.ps)
            return { found: rl.found || rr.found, ps: rr.ps }
        }
        return planKids(cx, [l, r], pos, ps)
    }

    fn planTernary(cx: PCx, t: AExpr, y: AExpr, n: AExpr, pos: Pos, ps: PS) -> PX {
        const rt: PX = planExpr(cx, t, pos, ps)
        const ry: PX = planExpr(cx, y, condPos(pos, "a branch of `? :`"), rt.ps)
        const rn: PX = planExpr(cx, n, condPos(pos, "a branch of `? :`"), ry.ps)
        return { found: rt.found || ry.found || rn.found, ps: rn.ps }
    }

    fn condPos(pos: Pos, what: string) -> Pos {
        if (pos.refused != "") return pos
        return { refused: what + " — it runs on one path only, and lifting it out would run it on both; it arrives with the U1b conditional-lowering follow-up. Write an `if` statement: a call in an `if` branch suspends" }
    }

    // A handling form that is NOT a suspension point: its subject's arguments
    // are evaluated in place; its arms cannot suspend in this slice.
    fn planHandledArms(cx: PCx, h: AHandled, pos: Pos, ps0: PS) -> PX {
        const r: PX = planKids(cx, [h.subject], pos, ps0)
        return { found: r.found, ps: planArms(cx, h, r.ps) }
    }

    fn planArms(cx: PCx, h: AHandled, ps0: PS) -> PS {
        let ps: PS = ps0
        const armPos: Pos = { refused: "a `!{}` / `match` arm — an arm that waits needs a continuation out of the arm, which arrives with the U1b arm-continuation follow-up. Handle the outer call, then make this call in the statement after it" }
        for (const a of handledArms(h)) {
            const b: AArmBody = a.body
            for (const x of armExprOf(b)) { ps = planExpr(cx, x, armPos, ps).ps }
            for (const blk of armBlockOf(b)) {
                for (const s of blk.stmts) {
                    for (const e of stmtExprs(s)) { ps = planExpr(cx, e, armPos, ps).ps }
                }
            }
        }
        return ps
    }

    // Is `e` a suspension point (and of which kind)?
    fn suspendKindAt(cx: PCx, e: AExpr) -> SuspendK | not {
        // s469: a plain-value `match` is no suspension point (its subject, a kid, may be)
        if (plainFactOf(failFact(cx.t.fails, e.nid)) is given) return not
        if (cx.server) return serverSuspendKind(cx, e)
        const h: AHandled | not = handledOf(e.k)
        if (h is given) {
            const hf: HandledFact | not = handledFactIn(cx.t, e.nid)
            if (hf is given) {
                const rf: RemoteFact | not = hf.remote
                if (rf is given) {
                    if (callerRemote(cx.s, rf.caller)) return SuspendK.SRemote(rf.callee)
                    return not
                }
            }
            const f: Sym | not = callSym(cx.t, h.subject)
            if (f is given) {
                if (waitingClientFn(cx, f.id)) return SuspendK.SWaits(f)
            }
            return not
        }
        const c: Sym | not = callSym(cx.t, e)
        if (c is given) {
            if (waitingClientFn(cx, c.id)) return SuspendK.SWaits(c)
        }
        return not
    }

    // s468 (U1c) — a SERVER-side suspension point: a `?{}` (its handling form, or
    // the query itself when its `!` function propagates it, §19.8.2), or a call —
    // plain or handled — of a function that waits when it runs on the server.
    fn serverSuspendKind(cx: PCx, e: AExpr) -> SuspendK | not {
        const h: AHandled | not = handledOf(e.k)
        if (h is given) {
            if (sqlOfK(h.subject.k) is given) return SuspendK.SQuery
            const f: Sym | not = callSym(cx.t, h.subject)
            if (f is given) {
                if (swaitsOf(cx.s, f.id) is given) return SuspendK.SLocal(f)
            }
            return not
        }
        if (sqlOfK(e.k) is given) {
            if (handledFactIn(cx.t, e.nid) is given) return SuspendK.SQuery
            return not
        }
        const c: Sym | not = callSym(cx.t, e)
        if (c is given) {
            if (swaitsOf(cx.s, c.id) is given) return SuspendK.SLocal(c)
        }
        return not
    }

    // The scrml function a call expression names, else not.
    fn callSym(t: Tables, e: AExpr) -> Sym | not {
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return not
        return fnSymOf(nameFact(t.names, c.nid))
    }

    fn handledFactIn(t: Tables, nid: int) -> HandledFact | not {
        const f: FailFact | not = failFact(t.fails, nid)
        return match f {
            .FHandled(h: h) :> h
            .FArm(idx: x) :> not
            .FFail(err: x) :> not
            .FPlain(m: pm) :> not
            not :> not
        }
    }

    fn handledOutcome(cx: PCx, e: AExpr) -> Sym | not {
        if (handledOf(e.k) is not && sqlOfK(e.k) is not) return not
        const hf: HandledFact | not = handledFactIn(cx.t, e.nid)
        if (hf is not) return not
        return hf.outcome
    }

    // =========================================================================
    // s468 (U1c) — §8.2 PARAMETER DEDUPLICATION, decided on the SYNTAX tree:
    // "If the same expression appears more than once in a single SQL template,
    // the compiler SHALL assign it a single positional parameter slot … Two
    // expressions are the same … when they are syntactically identical …
    // Complex expressions (function calls, member accesses) are NOT
    // deduplicated unless they are syntactically identical." A value that WAITS
    // (a call of a function that waits on the server) is a suspension point, so
    // deduplicating after lowering (Core `==`, lower.scrml sqlQueryOf) would be
    // too late — two Suspends, the call made twice. So a query's values are
    // deduplicated HERE, once: each value stands for the FIRST syntactically
    // identical one (sqlParamRep), only the distinct ones are planned
    // (distinctSqlParams) and lowered, and the duplicates read the same Core
    // value — one slot, evaluated once.
    // `sqlParamKey` is a canonical spelling of the tree (never source text); ""
    // for a form that is never deduplicated (a lambda, a nested query, a handled
    // form, a parse-error placeholder).
    // =========================================================================
    export fn sqlParamKey(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> "n:" + n
            .At(name: n) :> "@:" + n
            .AtItem :> "@."
            .Num(raw: r) :> "#:" + r
            .Str(v: v) :> "s:" + JSON.stringify(v)
            .Bool(v: b) :> boolKey(b)
            .NotLit :> "not"
            .Variant(name: n) :> "v:" + n
            .Member(obj: o, name: n) :> keyOf2("m(", sqlParamKey(o), n)
            .Call(callee: c, args: a) :> keyOfList("c(" + sqlParamKey(c) + "|", a)
            .Unary(op: o, e: x) :> keyOf2("u(" + unKey(o) + "|", sqlParamKey(x), "")
            .Binary(op: o, l: l, r: r) :> keyOfList("b(" + binKey(o) + "|", [l, r])
            .Ternary(test: t, yes: y, no: n) :> keyOfList("t(", [t, y, n])
            .ArrayLit(elems: es) :> keyOfList("[", es)
            .Index(obj: o, idx: i) :> keyOfList("i(", [o, i])
            .Spread(e: x) :> keyOf2("...(", sqlParamKey(x), "")
            .ObjectLit(props: ps) :> ""
            .Assign(target: t) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs, slots: ss) :> keyOfList("tpl(" + JSON.stringify(qs) + "|", ss)
            .Foreign(f: fb0) :> ""      // s473 (#1646 review F3): an awaited host effect, never deduplicated — like a nested query
            .Recovered :> ""
        }
    }

    fn boolKey(b: boolean) -> string {
        if (b) return "true"
        return "false"
    }

    // `head` + the key of `inner` + `tail` + ")" — "" when the inner one is "".
    fn keyOf2(head: string, inner: string, tail: string) -> string {
        if (inner == "") return ""
        return head + inner + "|" + tail + ")"
    }

    fn keyOfList(head: string, es: AExpr[]) -> string {
        let out: string = head
        for (const x of es) {
            const kx: string = sqlParamKey(x)
            if (kx == "") return ""
            out = out + kx + ","
        }
        return out + ")"
    }

    fn unKey(o: UnOp) -> string {
        return match o {
            .Not :> "!"
            .Neg :> "-"
            .IsGiven :> "given"
            .IsNot :> "isnot"
        }
    }

    fn binKey(o: BinOp) -> string {
        return match o {
            .Add :> "+"
            .Sub :> "-"
            .Mul :> "*"
            .Div :> "/"
            .Mod :> "%"
            .Lt :> "<"
            .Le :> "<="
            .Gt :> ">"
            .Ge :> ">="
            .Eq :> "=="
            .Ne :> "!="
            .And :> "&&"
            .Or :> "||"
            .Pipe :> "|>"
        }
    }

    // The value `p` (one of `ps`) stands for: the first syntactically identical one.
    export fn sqlParamRep(ps: AExpr[], p: AExpr) -> AExpr {
        const kp: string = sqlParamKey(p)
        if (kp == "") return p
        for (const q of ps) {
            if (sqlParamKey(q) == kp) return q
        }
        return p
    }

    // The distinct values of a query, in order of first appearance.
    export fn distinctSqlParams(ps: AExpr[]) -> AExpr[] {
        let out: AExpr[] = []
        for (const p of ps) {
            if (sqlParamRep(ps, p).nid == p.nid) out = out.concat([p])
        }
        return out
    }

    // The expressions a suspension point evaluates before it suspends: its call's
    // arguments (s468: a query's DISTINCT values, §8.2).
    fn suspendArgs(e: AExpr) -> AExpr[] {
        const h: AHandled | not = handledOf(e.k)
        let call: AExpr = e
        if (h is given) call = h.subject
        const k: AExprK = call.k
        return match k {
            .Call(callee: c, args: a) :> a
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: x) :> []
            .Assign(target: x) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> distinctSqlParams(q.params)
            .Handled(h: x) :> []
            .Template(quasis: qs) :> []
            .Foreign(f: fb0) :> []
        }
    }

    fn suspendWhat(k: SuspendK) -> string {
        return match k {
            .SRemote(callee: f) :> "a client call of the server function `" + f.hint + "` (§19.9.10) stands"
            .SWaits(callee: f) :> "a call of `" + f.hint + "`, which waits for the server (§13.2: it calls a server function), stands"
            .SQuery :> "a `" + sqlSigil() + "}` query — a waiting value (§13.8 item 2) — stands"
            .SLocal(callee: f) :> "a call of `" + f.hint + "`, which waits on the server (§13.8: it runs a `" + sqlSigil() + "}` query, directly or through a call), stands"
        }
    }

    // A client call's route needs a wire type at both ends (§57.4 R10: the
    // client decodes strictly against the declared return type).
    fn routedChecks(cx: PCx, e: AExpr, k: SuspendK, ps0: PS) -> PS {
        const f: Sym | not = match k {
            .SRemote(callee: c) :> c
            .SWaits(callee: c) :> not
            .SQuery :> not
            .SLocal(callee: c) :> not
        }
        if (f is not) return ps0
        let ps: PS = ps0
        const fs: FnSrc | not = fnSrcOf(cx.g, f.id)
        if (fs is not) return ps
        if (fs.info.arity < 0) ps = pdiag(ps, cx, e.span, "a client call of `" + fs.info.name + "`, whose parameters are not all typed — the call's arguments cross the wire, encoded against each parameter's declared type (§57); declare every parameter's type")
        if (fs.info.ret is given || retOf(ps.plan, f.id) is given) return ps
        if (!fs.info.failable && yieldsNoValue(cx.s, f.id)) return ps          // no value: the 204 contract
        const rt: RetType = provenReturn(cx, fs.f.body)
        const ty: Type | not = rt.ty
        if (ty is not) return pdiag(ps, cx, e.span, "a client call of `" + fs.info.name + "`: the client decodes the server's answer strictly against the function's success type (§57.4, S451 R10), and `" + fs.info.name + "` declares none and its returns do not prove one (" + rt.why + ")" + declareHint(fs.info))
        const pc: PlaceCx = { t: cx.t, g: cx.g }
        const state: string = stateTypeIn(cx.g, ty)
        if (state != "") return pdiag(ps, cx, e.span, "a client call of `" + fs.info.name + "`, whose answer holds `" + state + "`, a declaration's instance — a live state object with no wire form (§12.5.3)")
        if (wireBuild(typesProgram(cx.g), ty).table is not) return pdiag(ps, cx, e.span, "a client call of `" + fs.info.name + "`, whose answer's type has no wire descriptor in the bootstrap's codec")
        return withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps, joins: ps.plan.joins, waiting: ps.plan.waiting, rets: ps.plan.rets.concat([{ sym: f.id, ty: ty }]) })
    }

    fn declareHint(f: FnInfo) -> string {
        if (f.failable) return "; a `!` function has no success-type annotation (§19.4.1), so make every `return` carry a value of one known type"
        return "; declare it (`-> T`)"
    }

    // The ONE type every `return` in a body carries (§19.4.2 "inferred from its
    // returns"), by the typer's proven types — else why not.
    type RetType:struct = { ty: Type | not, why: string }

    fn provenReturn(cx: PCx, b: ABlock) -> RetType {
        const rs: ReturnSite[] = returnSites(b)
        if (rs.length == 0) return { ty: not, why: "it has no `return`" }
        let ty: Type | not = not
        for (const r of rs) {
            const x: AExpr | not = r.e
            if (x is not) return { ty: not, why: "a `return` without a value" }
            const vt: VType = exprType(cx.t, x.nid)
            const t: Type | not = knownType(vt)
            if (t is not) return { ty: not, why: "the type of a returned value is not proven" }
            if (ty is given) {
                if (!(ty == t)) return { ty: not, why: "its returns carry different types" }
            }
            ty = t
        }
        return { ty: ty, why: "" }
    }

    fn knownType(vt: VType) -> Type | not {
        return match vt {
            .Known(t: t) :> t
            .Absent :> not
            .Unknown :> not
            .OneOf(ts: xs) :> not
        }
    }

    type ReturnSite:struct = { e: AExpr | not }

    // Every `return` in a body, at any depth (an `if` / `given` branch, a
    // handling form's arm block — whose `return` leaves the function).
    fn returnSites(b: ABlock) -> ReturnSite[] {
        let out: ReturnSite[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const sub: ReturnSite[] = match k {
                .Return(e: x) :> [{ e: x }].concat(returnSitesIn(x))
                .If(cond: c, thenB: tb, elseB: eb) :> returnSitesIn(c).concat(returnSites(tb)).concat(returnSitesMaybe(eb))
                .Given(name: n, subject: x, body: gb) :> returnSites(gb)
                .For(f: lf) :> forReturnSites(lf)
                .Break(label: x) :> []
                .Continue(label: x) :> []
                .Lift(what: w) :> liftReturnSites(w)
                .Eval(e: x) :> returnSitesIn(x)
                .Local(name: n, init: i) :> returnSitesIn(i)
                .EffectStmt(w: w) :> []
                .Defer(body: d) :> []
                .Fail(f: x) :> []
            }
            out = out.concat(sub)
        }
        return out
    }

    fn returnSitesMaybe(b: ABlock | not) -> ReturnSite[] {
        if (b is not) return []
        return returnSites(b)
    }

    // `return`s inside a handling form's arm blocks in an expression.
    fn liftReturnSites(w: ALift) -> ReturnSite[] {
        let out: ReturnSite[] = []
        for (const e of liftExprs(w)) { out = out.concat(returnSitesIn(e)) }
        return out
    }

    fn returnSitesIn(e: AExpr | not) -> ReturnSite[] {
        if (e is not) return []
        // s473: a lambda's `return` is the lambda's, not the function's (as retsInExpr)
        if (isLambdaK(e.k)) return []
        let out: ReturnSite[] = []
        for (const b of exprBlocks(e)) { out = out.concat(returnSites(b)) }
        for (const x of exprKids(e)) { out = out.concat(returnSitesIn(x)) }
        return out
    }

    // =========================================================================
    // Entry. `files` in LINK ORDER: every file after the files it imports; the
    // entry (the file with `<program>`) last.
    // =========================================================================
    // =========================================================================
    // s469 — THE STYLESHEET PASS (SPEC §9.1, §25.7, §65; s469-boot-css). Every
    // `#{…}` block the parser read (ANodeK.Css), placed by where it stands:
    //   - at a file's top level (the entry file, which holds the `<program>`),
    //     in the program body, or inside any element that is not inside a
    //     component → PROGRAM-GLOBAL rules (§9.1 DQ-6; R4 S440: "a plain element
    //     creates no scope"), emitted in `@layer global` (§65.5);
    //   - anywhere inside a component — a declaration's `renders` (§66.15.1: "A
    //     declaration with typed attributes and a `renders` clause IS the
    //     component"), the bodies of its fields' variants, its child fields'
    //     renders → that component's `@scope ([data-scrml="<name>"]) to
    //     ([data-scrml])` (§9.1 DQ-7), its root stamped `data-scrml` (lower);
    //   - a block of ONLY bare declarations written DIRECTLY in a component's
    //     `renders` root → that root's inline `style="…"` (§9.1 DQ-7; §65.4.1).
    // A declaration value's `@name` is a declared PROGRAM cell → `var(--scrml-
    // name)`, its value written to `:root` at run time by the CSS-variable bridge
    // (§25.7; the runtime's `cssVar` admits only a safe value — the injection
    // boundary). `<theme>` is refused at parse, so no `@name` is a theme token:
    // a name that is neither is E-THEME-TOKEN-UNKNOWN (§65.3.2).
    //
    // FAIL-CLOSED (E-BOOTSTRAP-UNSUPPORTED — each unruled or not built):
    //   a flat block anywhere but directly in a component's root (§9.1 ⚑ OPEN);
    //   a flat block mixed with rules; a flat block on a root that already has
    //   `style=` (the merge is unruled); `@charset` / `@import` in a component
    //   (§65.8 hoists the program-global ones); a `#{}` at the top level of a
    //   file with no `<program>` (DQ-6 does not say whose page a module's
    //   top-level sheet joins); `@name` of a component's own field (a
    //   per-instance value has no `:root` home — the bridge is program-level);
    //   `@name` of a cell that is not an int / number / string.
    // =========================================================================
    export type CssInline:struct = { decl: int, decls: CssDecl[] }
    export type CssBridge:struct = { cell: Sym, idx: int }
    export type CssFacts:struct = {
        charsets: string[],
        imports: CssImport[],
        global: StyleRule[],
        scopes: ScopeSheet[],
        inline: CssInline[],
        bridges: CssBridge[],
        // s474 r1 (review F1): the build's source root under the project root (core.scrml
        // fileKeyPath) — every user declaration's output key is declScopeKey(keyBase, file, name)
        keyBase: string,
    }

    export fn noCssFacts() -> CssFacts { return { charsets: [], imports: [], global: [], scopes: [], inline: [], bridges: [], keyBase: "" } }

    type CssPlace:struct = { comp: boolean, decl: Sym, name: string, root: boolean, rootStyled: boolean }
    type CssAcc:struct = { facts: CssFacts, diags: Diag[] }

    fn cssDiag(a: CssAcc, file: string, span: ASpan, code: string, msg: string) -> CssAcc {
        return { facts: a.facts, diags: a.diags.concat([newDiag(code, msg, file, span)]) }
    }

    fn cssUnsupported(a: CssAcc, file: string, span: ASpan, msg: string) -> CssAcc {
        return cssDiag(a, file, span, "E-BOOTSTRAP-UNSUPPORTED", msg)
    }

    fn cssWithFacts(a: CssAcc, f: CssFacts) -> CssAcc { return { facts: f, diags: a.diags } }

    fn cssPrimitive(t: Type) -> string {
        return match t {
            .Int :> ""
            .Num :> ""
            .Str :> ""
            .Bool :> "a bool"
            .Named(sym: s) :> "a `" + s.hint + "`"
            .Seq(elem: e) :> "a sequence"
            .Maybe(inner: i) :> "a `T | not`"
        }
    }

    fn hasBridge(bs: CssBridge[], id: int) -> boolean {
        for (const b of bs) {
            if (b.cell.id == id) return true
        }
        return false
    }

    type CssPartsR:struct = { parts: CssPart[], acc: CssAcc }

    fn cssValueParts(g: Globals, prog: DeclSrc | not, at: CssPlace, file: string, ps: ACssPart[], a0: CssAcc) -> CssPartsR {
        let a: CssAcc = a0
        let out: CssPart[] = []
        for (const p of ps) {
            const k: ACssPart = p
            const text: string | not = match k {
                .CText(text: t) :> t
                .CRef(r: r) :> not
            }
            const ref: ACssRef | not = match k {
                .CText(text: t) :> not
                .CRef(r: r) :> r
            }
            if (text is given) out = out.concat([CssPart.CssText(text)])
            if (ref is given) {
                const rr: CssPartsR = cssRef(g, prog, at, file, ref, a)
                a = rr.acc
                out = out.concat(rr.parts)
            }
        }
        return { parts: out, acc: a }
    }

    fn cssRef(g: Globals, prog: DeclSrc | not, at: CssPlace, file: string, r: ACssRef, a: CssAcc) -> CssPartsR {
        // the nearest scope first: inside a component, `@name` is its own field before a program cell
        if (at.comp) {
            for (const ds of g.decls) {
                if (ds.info.sym.id == at.decl.id && fieldIndex(ds.info, r.name) >= 0) {
                    return { parts: [], acc: cssUnsupported(a, file, r.span, "`@" + r.name + "` is a field of `<" + at.name + ">` — a per-instance value in a component's CSS is not in the bootstrap (the §25.7 bridge writes program cells to `:root`)") }
                }
            }
        }
        let idx = -1
        if (prog is given) idx = fieldIndex(prog.info, r.name)
        if (prog is given && idx >= 0) {
            const f: FieldInfo = prog.info.fields[idx]
            const bad: string = cssPrimitive(f.ty)
            if (bad.length > 0) {
                return { parts: [], acc: cssUnsupported(a, file, r.span, "`@" + r.name + "` is " + bad + " cell — the bootstrap's CSS-variable bridge (§25.7) carries an int, a number or a string; convert it to a string cell for CSS") }
            }
            let bs: CssBridge[] = a.facts.bridges
            if (!hasBridge(bs, f.sym.id)) bs = bs.concat([{ cell: f.sym, idx: idx }])
            const nf: CssFacts = { charsets: a.facts.charsets, imports: a.facts.imports, global: a.facts.global, scopes: a.facts.scopes,
                                   inline: a.facts.inline, bridges: bs, keyBase: a.facts.keyBase }
            return { parts: [CssPart.CellVar(f.sym)], acc: cssWithFacts(a, nf) }
        }
        return { parts: [], acc: cssDiag(a, file, r.span, "E-THEME-TOKEN-UNKNOWN", "`@" + r.name + "` names no theme token and no declared cell (§65.3.2) — declare `<" + r.name + "…/>` in the program, fix the spelling, or drop the `@` for a literal CSS value") }
    }

    type CssDeclsR:struct = { decls: CssDecl[], acc: CssAcc }

    fn cssDecls(g: Globals, prog: DeclSrc | not, at: CssPlace, file: string, ds: ACssDecl[], a0: CssAcc) -> CssDeclsR {
        let a: CssAcc = a0
        let out: CssDecl[] = []
        for (const d of ds) {
            const r: CssPartsR = cssValueParts(g, prog, at, file, d.value, a)
            a = r.acc
            out = out.concat([{ prop: d.prop, value: r.parts }])
        }
        return { decls: out, acc: a }
    }

    fn addScope(ss: ScopeSheet[], name: string, rs: StyleRule[]) -> ScopeSheet[] {
        let out: ScopeSheet[] = []
        let found = false
        for (const s of ss) {
            if (s.component == name) {
                out = out.concat([{ component: s.component, rules: s.rules.concat(rs) }])
                found = true
            } else {
                out = out.concat([s])
            }
        }
        if (!found) out = out.concat([{ component: name, rules: rs }])
        return out
    }

    fn addInline(xs: CssInline[], decl: int, ds: CssDecl[]) -> CssInline[] {
        let out: CssInline[] = []
        let found = false
        for (const x of xs) {
            if (x.decl == decl) {
                out = out.concat([{ decl: x.decl, decls: x.decls.concat(ds) }])
                found = true
            } else {
                out = out.concat([x])
            }
        }
        if (!found) out = out.concat([{ decl: decl, decls: ds }])
        return out
    }

    fn cssWhere(at: CssPlace) -> string {
        if (at.comp) return "inside `<" + at.name + ">`, below its `renders` root"
        return "outside any component (the program body, a file's top level, or a plain element)"
    }

    fn cssBlock(g: Globals, prog: DeclSrc | not, at: CssPlace, file: string, c: ACss, a0: CssAcc) -> CssAcc {
        let a: CssAcc = a0
        let flats: ACssDecl[] = []
        let rules: ACssRule[] = []
        let statements = 0
        for (const it of c.items) {
            const k: ACssItem = it
            const f: ACssDecl | not = match k {
                .CssFlat(d: d) :> d
                .CssRule(r: r) :> not
                .CssCharset(span: s, encoding: e) :> not
                .CssImport(span: s, url: u) :> not
            }
            const r: ACssRule | not = match k {
                .CssRule(r: r) :> r
                .CssFlat(d: d) :> not
                .CssCharset(span: s, encoding: e) :> not
                .CssImport(span: s, url: u) :> not
            }
            if (f is given) flats = flats.concat([f])
            if (r is given) rules = rules.concat([r])
            if (f is not && r is not) statements = statements + 1
        }
        if (flats.length > 0) {
            if (rules.length > 0 || statements > 0) {
                return cssUnsupported(a, file, c.span, "a `#" + "{…}` block that mixes bare declarations with selector rules or at-rules — its meaning is unruled (§9.1: a flat block holds ONLY `property: value;` pairs); split it into two blocks")
            }
            if (!(at.comp && at.root)) {
                return cssUnsupported(a, file, c.span, "bare declarations with no selector " + cssWhere(at) + " — §9.1 rules a flat block only directly in a component's `renders` root (its inline `style=`; ⚑ OPEN elsewhere); add a selector, or move it into the root element")
            }
            if (at.rootStyled) {
                return cssUnsupported(a, file, c.span, "a flat `#" + "{…}` on `<" + at.name + ">`'s root, which already has `style=` — how the two combine is unruled (§65.1 orders them, but merging into one attribute is not specified); keep one")
            }
            const dr: CssDeclsR = cssDecls(g, prog, at, file, flats, a)
            a = dr.acc
            const nf: CssFacts = { charsets: a.facts.charsets, imports: a.facts.imports, global: a.facts.global, scopes: a.facts.scopes,
                                   inline: addInline(a.facts.inline, at.decl.id, dr.decls), bridges: a.facts.bridges, keyBase: a.facts.keyBase }
            return cssWithFacts(a, nf)
        }
        let charsets: string[] = a.facts.charsets
        let imports: CssImport[] = a.facts.imports
        for (const it of c.items) {
            const k: ACssItem = it
            const cs: string | not = match k {
                .CssCharset(span: s, encoding: e) :> e
                .CssImport(span: s, url: u) :> not
                .CssRule(r: r) :> not
                .CssFlat(d: d) :> not
            }
            const im: CssImport | not = match k {
                .CssImport(span: s, url: u, conditions: cd) :> cssImportOf(u, cd)
                .CssCharset(span: s, encoding: e) :> not
                .CssRule(r: r) :> not
                .CssFlat(d: d) :> not
            }
            const sp: ASpan | not = match k {
                .CssCharset(span: s, encoding: e) :> s
                .CssImport(span: s, url: u) :> s
                .CssRule(r: r) :> not
                .CssFlat(d: d) :> not
            }
            if (at.comp && sp is given) {
                a = cssUnsupported(a, file, sp, "`@charset` / `@import` in a component's `#" + "{…}` — §65.8 hoists only a program-global one; move it to a program-level block")
            } else {
                if (cs is given) charsets = charsets.concat([cs])
                if (im is given) imports = imports.concat([im])
            }
        }
        let out: StyleRule[] = []
        for (const r of rules) {
            const dr: CssDeclsR = cssDecls(g, prog, at, file, r.decls, a)
            a = dr.acc
            out = out.concat([{ sel: r.sel, decls: dr.decls }])
        }
        let globalRules: StyleRule[] = a.facts.global
        let scopes: ScopeSheet[] = a.facts.scopes
        if (at.comp) {
            // s474 (door 3): the scope key is per-file qualified, always — `file` is the component's own file
            if (out.length > 0) scopes = addScope(scopes, declScopeKey(a.facts.keyBase, file, at.name), out)
        } else {
            globalRules = globalRules.concat(out)
        }
        const nf: CssFacts = { charsets: charsets, imports: imports, global: globalRules, scopes: scopes, inline: a.facts.inline, bridges: a.facts.bridges, keyBase: a.facts.keyBase }
        return cssWithFacts(a, nf)
    }

    fn cssImportOf(u: string, cd: string) -> CssImport { return { url: u, conditions: cd } }

    // The nodes `ns` stand directly in an element at `at` (`at.root`: that
    // element is a component's `renders` root).
    fn cssNodes(g: Globals, prog: DeclSrc | not, at: CssPlace, file: string, ns: ANode[], a0: CssAcc) -> CssAcc {
        let a: CssAcc = a0
        const below: CssPlace = { comp: at.comp, decl: at.decl, name: at.name, root: false, rootStyled: false }
        for (const n of ns) {
            const k: ANodeK = n.k
            const c: ACss | not = match k {
                .Css(c: c) :> c
                .Gather(f: x) :> not
                .Elem(e: e) :> not
                .Text(text: t) :> not
                .Interp(e: x) :> not
                .DeclNode(d: d) :> not
                .Effect(w: w) :> not
            }
            const e: AElem | not = match k {
                .Elem(e: e) :> e
                .Css(c: c) :> not
                .Gather(f: x) :> not
                .Text(text: t) :> not
                .Interp(e: x) :> not
                .DeclNode(d: d) :> not
                .Effect(w: w) :> not
            }
            if (c is given) a = cssBlock(g, prog, at, file, c, a)
            if (e is given) a = cssNodes(g, prog, below, file, e.kids, a)
            // s469: a Tier-0 loop's rows stand where the loop does (§17.4)
            const gf: AFor | not = gatherOfNode(k)
            if (gf is given) a = cssNodes(g, prog, at, file, gatherRows(gf), a)
        }
        return a
    }

    fn gatherOfNode(k: ANodeK) -> AFor | not {
        return match k {
            .Gather(f: lf) :> lf
            .Elem(e: x) :> not
            .Css(c: x) :> not
            .Text(text: x) :> not
            .Interp(e: x) :> not
            .DeclNode(d: x) :> not
            .Effect(w: x) :> not
        }
    }

    fn cssDeclRenders(d: ADecl) -> AElem[] {
        const r: AElem | not = d.renders
        if (r is not) return []
        return [r]
    }

    fn cssFieldDeclsOf(ds: DeclSrc) -> ADecl[] {
        const p: AProgram | not = ds.p
        if (p is given) {
            let out: ADecl[] = []
            for (const it of p.items) {
                for (const d of declsOfItem(it)) {
                    if (!isNestedUserDecl(d)) out = out.concat([d])
                }
            }
            return out
        }
        const ud: ADecl | not = ds.d
        if (ud is given) return childFields(ud.body)
        return []
    }

    // The markup a declaration owns below its root: its fields' variant bodies
    // and their renders (§66.4 rule 4, O5 (1i)) — nested to any depth.
    fn cssFieldMarkup(g: Globals, prog: DeclSrc | not, at: CssPlace, file: string, fds: ADecl[], a0: CssAcc) -> CssAcc {
        let a: CssAcc = a0
        for (const fd of fds) {
            for (const c of fd.body) {
                for (const sc of stateChildOf(c)) { a = cssNodes(g, prog, at, file, sc.body, a) }
            }
            for (const r of cssDeclRenders(fd)) { a = cssNodes(g, prog, at, file, [{ nid: -1, span: r.span, k: ANodeK.Elem(r) }], a) }
            a = cssFieldMarkup(g, prog, at, file, childFields(fd.body), a)
        }
        return a
    }

    type CssPassR:struct = { facts: CssFacts, diags: Diag[] }

    fn cssPass(g: Globals, keyBase: string) -> CssPassR {
        let prog: DeclSrc | not = not
        for (const ds of g.decls) {
            if (ds.isProgram && ds.info.sym.id == g.program.id) prog = ds
        }
        const f0: CssFacts = noCssFacts()
        let a: CssAcc = { facts: { charsets: f0.charsets, imports: f0.imports, global: f0.global, scopes: f0.scopes, inline: f0.inline, bridges: f0.bridges, keyBase: keyBase }, diags: [] }
        const none: Sym = mkSym(0 - 1, "")
        const globalAt: CssPlace = { comp: false, decl: none, name: "", root: false, rootStyled: false }
        // a file's top level (outside `<program>`)
        for (const f of g.files) {
            let hasProgram = false
            for (const it of f.items) {
                if (programOfItem(it) is given) hasProgram = true
            }
            for (const it of f.items) {
                const n: ANode | not = markupOfItem(it)
                if (n is given) {
                    if (hasProgram && f.path == g.entry) {
                        a = cssNodes(g, prog, globalAt, f.path, [n], a)
                    } else if (isCssNode(n)) {
                        a = cssUnsupported(a, f.path, n.span, "a `#" + "{…}` at the top level of a file with no `<program>` — §9.1 DQ-6 does not say whose page a module's top-level stylesheet joins; put it in the program, or in a component's `renders`")
                    }
                }
            }
        }
        for (const ds of g.decls) {
            if (ds.isProgram) {
                const p: AProgram | not = ds.p
                if (p is given) a = cssNodes(g, prog, globalAt, ds.file, markupNodes(p.items), a)
                a = cssFieldMarkup(g, prog, globalAt, ds.file, cssFieldDeclsOf(ds), a)
            } else {
                const ud: ADecl | not = ds.d
                if (ud is given) {
                    for (const r of cssDeclRenders(ud)) {
                        const rootAt: CssPlace = { comp: true, decl: ds.info.sym, name: ds.info.sym.hint, root: true,
                                                   rootStyled: attrNamed(r.attrs, "style") is given }
                        a = cssNodes(g, prog, rootAt, ds.file, r.kids, a)
                    }
                    const at: CssPlace = { comp: true, decl: ds.info.sym, name: ds.info.sym.hint, root: false, rootStyled: false }
                    a = cssFieldMarkup(g, prog, at, ds.file, cssFieldDeclsOf(ds), a)
                }
            }
        }
        // (one `data-scrml` key per component holds by construction: dupDecls refuses two declarations
        // of one name, in any two files (s472: kept for declarations only, for this key) — so no two
        // scopes share a key; when that limit lifts, the key must carry the declaring module, or two
        // `card`s merge — g-boot-component-scope-key-bare-name-s472)
        return { facts: a.facts, diags: a.diags }
    }

    // =========================================================================
    // s471 — THE LINEAR PASS (SPEC §35, `lin`).
    //
    // §35.1: "A `lin` variable is a value with exactly-once consumption and
    // restricted intermediate visibility. The binding is immutable, must be
    // consumed on every execution path, and must not be referenced by any code
    // between the declaration site and the consumption site except the
    // consumption itself." §35.2: "Every appearance of a `lin` identifier in a
    // position that is not a declaration SHALL count as a consumption event".
    //
    // One walk per body root — a function body (its `lin` parameters bound at
    // entry, §35.2.1), an event-handler block, an effect body — over the
    // BINDER's facts: an appearance is a Name whose name fact is a `lin`
    // binding's Sym (a shadowing binder has its own Sym, never counted for it).
    // The walk carries, per `lin` binding in scope, whether the path being
    // walked has consumed it:
    //   - a second appearance on one path                         E-LIN-002
    //   - an appearance inside a loop body — or a loop head's
    //     condition / step, which run per iteration — of a `lin`
    //     declared outside that loop (§35.4.4)                    E-LIN-002
    //   - unconsumed where a path leaves its scope: the block's
    //     end, a `return` / `fail`, a `?` propagation (or a `?{}`
    //     a `!` function propagates, §19.8.2), a `break` /
    //     `continue` out of the loop it was declared in           E-LIN-001
    //   - consumed on some paths through an `if` / `given` /
    //     `&&` / `||` / `? :` / `match` / `!{}` and not others    E-LIN-003
    //   - a `let` / `const` / `lin` declaration of the name of a
    //     `lin` binding of an enclosing scope (§35.5)             E-LIN-005
    //   - passed to a server function from the client (§35.7)     W-LIN-001
    // A lambda that names a `lin` binding CAPTURES it (§35.6: "The closure
    // capture is the consumption event, even if `f` is never called"): one
    // consumption, at the lambda, whatever branches its body holds; a second
    // appearance in the body is a second consumption (§35.2). A deferred body
    // is counted where the `defer` stands (§19.16.9: "a reached `defer` runs
    // its body exactly once on every exit"). A handling form the typer reported
    // an error in — a non-exhaustive `match` (E-TYPE-020) among them — is not
    // judged (§35.4.3: "linear type analysis is deferred on non-exhaustive
    // matches"): its arms consume what they name, and nothing cascades.
    // Each E-LIN-001 / -003 is reported once per binding.
    // =========================================================================
    type LinVar:struct = { id: int, name: string, decl: ASpan, used: boolean, at: ASpan, depth: int, scope: int }
    type LinSt:struct = { vars: LinVar[], diags: Diag[], reported: int[], scopes: int }
    type LinLoop:struct = { label: string, depth: int }
    type LinCx:struct = { t: Tables, file: string, depth: int, loops: LinLoop[], scope: int, errs: ASpan[],
                          failable: boolean, caller: int }
    // A walk's result: the state, and whether EVERY path through what was
    // walked left (`return`, `fail`, `break`, `continue`) — a path that left
    // takes no part in the merge after a branch.
    type LinR:struct = { st: LinSt, ends: boolean }

    fn linPass(g: Globals, t: Tables, prior: Diag[]) -> Diag[] {
        let st: LinSt = { vars: [], diags: [], reported: [], scopes: 0 }
        for (const fs of g.fns) {
            const cx: LinCx = { t: t, file: fs.info.file, depth: 0, loops: [], scope: 0, errs: errorSpansIn(prior, fs.info.file),
                                failable: fs.info.failable, caller: fs.info.sym.id }
            let s: LinSt = { vars: [], diags: st.diags, reported: st.reported, scopes: st.scopes }
            for (const p of fs.f.params) {
                if (p.lin) {
                    const ps: Sym | not = linParamSym(bindFact(t.binds, p.nid))
                    if (ps is given) s = linDeclare(s, { id: ps.id, name: p.name, decl: p.span, used: false, at: p.span, depth: 0, scope: 0 })
                }
            }
            st = linBlockAt(cx, fs.f.body, s, 0).st
        }
        for (const a of actionPositions(g)) {
            const v: AAttrValue = a.v
            const b: ABlock | not = match v {
                .Braced(b: bb) :> bb
                .Bare(e: x) :> not
                .Paren(e: x) :> not
                .Quoted(v: x) :> not
                .NoValue :> not
            }
            if (b is given) {
                const cx2: LinCx = { t: t, file: a.file, depth: 0, loops: [], scope: 0, errs: errorSpansIn(prior, a.file), failable: false, caller: -1 }
                const s2: LinSt = { vars: [], diags: st.diags, reported: st.reported, scopes: st.scopes }
                st = linBlockAt(cx2, b, s2, 0).st
            }
        }
        return st.diags
    }

    fn linParamSym(f: BindFact | not) -> Sym | not {
        return match f {
            .BParam(sym: s) :> s
            .BBind(sym: x) :> not
            .BGiven(sym: x) :> not
            .BLoop(label: x) :> not
            .BJump(target: x) :> not
            not :> not
        }
    }

    fn linBindSym(f: BindFact | not) -> Sym | not {
        return match f {
            .BBind(sym: s) :> s
            .BParam(sym: x) :> not
            .BGiven(sym: x) :> not
            .BLoop(label: x) :> not
            .BJump(target: x) :> not
            not :> not
        }
    }

    fn linDeclare(s: LinSt, v: LinVar) -> LinSt {
        return { vars: s.vars.concat([v]), diags: s.diags, reported: s.reported, scopes: s.scopes }
    }

    fn linDiag(cx: LinCx, s: LinSt, code: string, span: ASpan, msg: string) -> LinSt {
        return { vars: s.vars, diags: s.diags.concat([newDiag(code, msg, cx.file, span)]), reported: s.reported, scopes: s.scopes }
    }

    // A branch starts from `pre`'s bindings, carrying everything reported so far (`d`).
    fn linFrom(pre: LinSt, d: LinSt) -> LinSt {
        return { vars: pre.vars, diags: d.diags, reported: d.reported, scopes: d.scopes }
    }

    fn linGo(s: LinSt) -> LinR { return { st: s, ends: false } }

    // ---- statements -----------------------------------------------------------------
    // A block: its own scope; the bindings declared in it (from `mark` on) must
    // be consumed when a path falls off its end (§35.5 "not consumed before
    // scope exit"), and go out of scope after it.
    fn linBlock(cx: LinCx, b: ABlock, s: LinSt) -> LinR {
        return linBlockAt(cx, b, s, s.vars.length)
    }

    fn linBlockAt(cx0: LinCx, b: ABlock, s0: LinSt, mark: int) -> LinR {
        const scope: int = s0.scopes + 1
        const cx: LinCx = { t: cx0.t, file: cx0.file, depth: cx0.depth, loops: cx0.loops, scope: scope, errs: cx0.errs, failable: cx0.failable, caller: cx0.caller }
        let s: LinSt = { vars: s0.vars, diags: s0.diags, reported: s0.reported, scopes: scope }
        let ends = false
        for (const st of b.stmts) {
            if (!ends) {
                const r: LinR = linStmt(cx, st, s)
                s = r.st
                ends = r.ends
            }
        }
        if (!ends) s = linScopeExit(cx, s, mark, b.span)
        let kept: LinVar[] = []
        let i = 0
        for (const v of s.vars) {
            if (i < mark) kept = kept.concat([v])
            i = i + 1
        }
        return { st: { vars: kept, diags: s.diags, reported: s.reported, scopes: s.scopes }, ends: ends }
    }

    fn linScopeExit(cx: LinCx, s0: LinSt, mark: int, span: ASpan) -> LinSt {
        let s: LinSt = s0
        let i = 0
        for (const v of s0.vars) {
            if (i >= mark && !v.used && s.reported.indexOf(v.id) < 0) {
                s = linDiag(cx, s, "E-LIN-001", v.decl, "`lin` variable `" + v.name + "` is declared at " + offsetOf(v.decl) + " but is not consumed before scope exit. A `lin` variable must be used exactly once (§35.3, §35.5). Either consume `" + v.name + "` before the scope ends, or remove the `lin` keyword if single-use is not required")
                s = { vars: s.vars, diags: s.diags, reported: s.reported.concat([v.id]), scopes: s.scopes }
            }
            i = i + 1
        }
        return s
    }

    // A path LEAVES here (`what`): every binding declared at loop depth
    // `minDepth` or deeper must already be consumed on it.
    fn linExit(cx: LinCx, s0: LinSt, minDepth: int, span: ASpan, what: string) -> LinSt {
        let s: LinSt = s0
        for (const v of s0.vars) {
            if (v.depth >= minDepth && !v.used && s.reported.indexOf(v.id) < 0) {
                s = linDiag(cx, s, "E-LIN-001", span, "`lin` variable `" + v.name + "` (declared at " + offsetOf(v.decl) + ") is not consumed on the path that leaves through " + what + " — a `lin` variable is consumed exactly once on EVERY execution path (§35.3, §35.5). Consume `" + v.name + "` before " + what)
                s = { vars: s.vars, diags: s.diags, reported: s.reported.concat([v.id]), scopes: s.scopes }
            }
        }
        return s
    }

    fn linStmt(cx: LinCx, st: AStmt, s: LinSt) -> LinR {
        const k: AStmtK = st.k
        return match k {
            .Eval(e: e) :> linExpr(cx, e, s)
            .Local(name: n, mutable: m, init: i, lin: l) :> linLocal(cx, st, n, i, l, s)
            .Return(e: e) :> linReturn(cx, st, e, s)
            .Fail(f: f) :> linFail(cx, st, f, s)
            .If(cond: c, thenB: tb, elseB: eb) :> linIf(cx, st, c, tb, eb, s)
            .Given(name: n, subject: x, body: b) :> linGiven(cx, st, x, b, s)
            .For(f: lf) :> linFor(cx, lf, s)
            .Break(label: l) :> linJump(cx, st, l, "`break`", s)
            .Continue(label: l) :> linJump(cx, st, l, "`continue`", s)
            .Lift(what: w) :> linExprs(cx, liftExprs(w), s)
            .EffectStmt(w: w) :> linGo(s)
            .Defer(body: b) :> linGo(linBlock(cx, b, s).st)
        }
    }

    fn linLocal(cx: LinCx, st: AStmt, name: string, init: AExpr, isLin: boolean, s0: LinSt) -> LinR {
        const r: LinR = linExpr(cx, init, s0)
        let s: LinSt = r.st
        if (r.ends) return r
        s = linShadow(cx, s, name, st.span)
        if (!isLin) return linGo(s)
        const sy: Sym | not = linBindSym(bindFact(cx.t.binds, st.nid))
        if (sy is not) return linGo(s)
        return linGo(linDeclare(s, { id: sy.id, name: name, decl: st.span, used: false, at: st.span, depth: cx.depth, scope: cx.scope }))
    }

    // §35.5: "The compiler SHALL emit E-LIN-005 when a `let`, `const`, or
    // `lin` declaration has the same name as an in-scope `lin` variable
    // declared in a strictly enclosing scope. A same-scope rebinding is not
    // shadowing in the hierarchical sense and is not covered by E-LIN-005."
    fn linShadow(cx: LinCx, s: LinSt, name: string, span: ASpan) -> LinSt {
        for (const v of s.vars) {
            if (v.name == name && v.scope != cx.scope) {
                return linDiag(cx, s, "E-LIN-005", span, "this declaration of `" + name + "` shadows an in-scope `lin` variable of the same name (declared at " + offsetOf(v.decl) + ") — shadowing a `lin` variable prevents the compiler from determining which binding a consumption refers to (§35.5). Rename the new binding, or consume the outer `lin " + name + "` before this declaration")
            }
        }
        return s
    }

    fn linReturn(cx: LinCx, st: AStmt, e: AExpr | not, s0: LinSt) -> LinR {
        let s: LinSt = s0
        if (e is given) {
            const r: LinR = linExpr(cx, e, s)
            if (r.ends) return r
            s = r.st
        }
        return { st: linExit(cx, s, 0, st.span, "this `return`"), ends: true }
    }

    fn linFail(cx: LinCx, st: AStmt, f: AFail, s0: LinSt) -> LinR {
        const r: LinR = linExprs(cx, f.args, s0)
        if (r.ends) return r
        return { st: linExit(cx, r.st, 0, st.span, "this `fail`"), ends: true }
    }

    fn linIf(cx: LinCx, st: AStmt, c: AExpr, tb: ABlock, eb: ABlock | not, s0: LinSt) -> LinR {
        const rc: LinR = linExpr(cx, c, s0)
        if (rc.ends) return rc
        const pre: LinSt = rc.st
        const rt: LinR = linBlock(cx, tb, pre)
        let re: LinR = linGo(linFrom(pre, rt.st))
        if (eb is given) re = linBlock(cx, eb, linFrom(pre, rt.st))
        return linMerge(cx, pre, [rt, re], st.span, "this `if` / `else`")
    }

    fn linGiven(cx: LinCx, st: AStmt, x: AExpr, b: ABlock, s0: LinSt) -> LinR {
        const rx: LinR = linExpr(cx, x, s0)
        if (rx.ends) return rx
        const pre: LinSt = rx.st
        const rb: LinR = linBlock(cx, b, pre)
        return linMerge(cx, pre, [rb, linGo(linFrom(pre, rb.st))], st.span, "this `given` (its body runs only when the handle is present)")
    }

    // §35.4.4: "`lin` variables from outer scope SHALL NOT be consumed inside
    // loop bodies"; §49.5.3: "A `lin` declared in a counted head's `init` is an
    // outer `lin` for the body." The iterable and a range's bounds run once,
    // before the first iteration; a condition and a step run per iteration.
    fn linFor(cx: LinCx, f: AFor, s0: LinSt) -> LinR {
        const inner: LinCx = { t: cx.t, file: cx.file, depth: cx.depth + 1, loops: cx.loops.concat([{ label: f.label, depth: cx.depth }]),
                               scope: cx.scope, errs: cx.errs, failable: cx.failable, caller: cx.caller }
        let s: LinSt = s0
        const h: AForHead = f.head
        const once: AExpr[] = match h {
            .HForever :> []
            .HCond(cond: c) :> []
            .HCounted(init: i) :> []
            .HIter(bind: b, src: src) :> iterSrcExprs(src)
        }
        const each: AExpr[] = match h {
            .HForever :> []
            .HCond(cond: c) :> [c]
            .HCounted(init: i, cond: c, step: sp) :> maybeExprList(c).concat(sp)
            .HIter(bind: b, key: ky) :> maybeExprList(ky)                // s474: the header `key`, once per iteration (§17.4b)
        }
        const r0: LinR = linExprs(cx, once, s)
        if (r0.ends) return r0
        s = r0.st
        // a counted head's `init`: its `let`s are the loop's (in the loop's scope, E-LIN-005 applies)
        const mark: int = s.vars.length
        const rh: LinR = linStmtsIn(cx, forInit(f), s)
        if (rh.ends) return rh
        s = rh.st
        const re: LinR = linExprs(inner, each, s)
        s = re.st
        const rb: LinR = linBlock(inner, f.body, s)
        let kept: LinVar[] = []
        let i = 0
        for (const v of rb.st.vars) {
            if (i < mark) kept = kept.concat([v])
            i = i + 1
        }
        return linGo({ vars: kept, diags: rb.st.diags, reported: rb.st.reported, scopes: rb.st.scopes })
    }

    fn linStmtsIn(cx: LinCx, ss: AStmt[], s0: LinSt) -> LinR {
        let s: LinSt = s0
        for (const st of ss) {
            const r: LinR = linStmt(cx, st, s)
            if (r.ends) return r
            s = r.st
        }
        return linGo(s)
    }

    // `break` / `continue` leave the loop they name: every binding declared
    // inside that loop must be consumed on this path (§49.5.3: "A `lin`
    // declared inside a loop body that is not consumed before `break` or
    // `continue` on the fast-exit path is E-LIN-001 on that path").
    fn linJump(cx: LinCx, st: AStmt, label: string, what: string, s: LinSt) -> LinR {
        let depth: int = -1
        let i: int = cx.loops.length - 1
        while (i >= 0) {
            if (depth < 0 && (label == "" || cx.loops[i].label == label)) depth = cx.loops[i].depth
            i = i - 1
        }
        if (depth < 0) return { st: s, ends: true }      // no such loop: the loop-control pass reported it
        return { st: linExit(cx, s, depth + 1, st.span, "this " + what), ends: true }
    }

    // ---- merging the paths of a branch ------------------------------------------------
    // Every path that did not leave must agree, per binding in scope before the
    // branch: consumed on all of them, or on none (§35.4.2: "A `lin` variable
    // consumed in only one branch is not consumed on the other branch's
    // execution path — E-LIN-003").
    fn linMerge(cx: LinCx, pre: LinSt, rs: LinR[], span: ASpan, what: string) -> LinR {
        const last: LinSt = rs[rs.length - 1].st
        let s: LinSt = { vars: pre.vars, diags: last.diags, reported: last.reported, scopes: last.scopes }
        let live: LinSt[] = []
        for (const r of rs) {
            if (!r.ends) live = live.concat([r.st])
        }
        if (live.length == 0) return { st: s, ends: true }
        let vars: LinVar[] = []
        let i = 0
        for (const v of pre.vars) {
            let n = 0
            let at: ASpan = v.at
            for (const l of live) {
                if (l.vars[i].used) {
                    if (n == 0) at = l.vars[i].at
                    n = n + 1
                }
            }
            let used: boolean = n > 0
            if (n > 0 && n < live.length && s.reported.indexOf(v.id) < 0) {
                s = linDiag(cx, s, "E-LIN-003", span, "`lin` variable `" + v.name + "` (declared at " + offsetOf(v.decl) + ") is consumed on some paths through " + what + " (at " + offsetOf(at) + ") but not on the others — a `lin` variable is consumed exactly once on EVERY execution path (§35.4). Consume it on every path, or consume it once before the branch")
                s = { vars: s.vars, diags: s.diags, reported: s.reported.concat([v.id]), scopes: s.scopes }
            }
            vars = vars.concat([{ id: v.id, name: v.name, decl: v.decl, used: used, at: at, depth: v.depth, scope: v.scope }])
            i = i + 1
        }
        return linGo({ vars: vars, diags: s.diags, reported: s.reported, scopes: s.scopes })
    }

    // ---- expressions ------------------------------------------------------------------
    fn linExprs(cx: LinCx, es: AExpr[], s0: LinSt) -> LinR {
        let s: LinSt = s0
        for (const e of es) {
            const r: LinR = linExpr(cx, e, s)
            if (r.ends) return r
            s = r.st
        }
        return linGo(s)
    }

    fn linExpr(cx: LinCx, e: AExpr, s: LinSt) -> LinR {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> linGo(linUse(cx, e, s))
            .Binary(op: o, l: l, r: r) :> linBinary(cx, e, o, l, r, s)
            .Ternary(test: t, yes: y, no: n) :> linTernary(cx, e, t, y, n, s)
            .Handled(h: h) :> linHandled(cx, e, h, s)
            .Lambda(params: lp, body: b) :> linGo(linCapture(cx, e, b, s))
            .Sql(q: q) :> linSql(cx, e, q, s)
            .Call(callee: c, args: a) :> linCall(cx, c, a, s)
            .Assign(target: t, value: v) :> linAssign(cx, t, v, s)
            .Member(obj: o) :> linExpr(cx, o, s)
            .Unary(op: o, e: x) :> linExpr(cx, x, s)
            .ArrayLit(elems: es) :> linExprs(cx, es, s)
            .ObjectLit(props: ps) :> linExprs(cx, propValueList(ps), s)
            .Spread(e: x) :> linExpr(cx, x, s)
            .Index(obj: o, idx: i) :> linExprs(cx, [o, i], s)
            .Template(quasis: qs, slots: ss) :> linExprs(cx, ss, s)
            .Foreign(f: fb0) :> linExprs(cx, fb0.crossings, s)
            .At(name: n) :> linGo(s)
            .AtItem :> linGo(s)
            .Num(raw: r) :> linGo(s)
            .Str(v: x) :> linGo(s)
            .Bool(v: b) :> linGo(s)
            .NotLit :> linGo(s)
            .Recovered :> linGo(s)
            .Variant(name: n) :> linGo(s)
        }
    }

    // The `lin` binding a Name reads, if it reads one in scope: its index in `vars`.
    fn linIndex(cx: LinCx, e: AExpr, s: LinSt) -> int {
        const f: NameFact | not = nameFact(cx.t.names, e.nid)
        const id: int = match f {
            .NLocal(sym: sy) :> sy.id
            .NField(decl: x) :> -1
            .NInst(decl: x) :> -1
            .NStruct(owner: x) :> -1
            .NFn(sym: x) :> -1
            .NLength :> -1
            .NSurface(of: x) :> -1
            .NConst(sym: sy) :> -1
            not :> -1
        }
        if (id < 0) return -1
        let i = 0
        for (const v of s.vars) {
            if (v.id == id) return i
            i = i + 1
        }
        return -1
    }

    fn linUse(cx: LinCx, e: AExpr, s: LinSt) -> LinSt {
        const i: int = linIndex(cx, e, s)
        if (i < 0) return s
        return linConsume(cx, s, i, e.span)
    }

    fn linConsume(cx: LinCx, s0: LinSt, i: int, span: ASpan) -> LinSt {
        const v: LinVar = s0.vars[i]
        let s: LinSt = s0
        if (v.depth < cx.depth) {
            s = linDiag(cx, s, "E-LIN-002", span, "`lin` variable `" + v.name + "` (declared at " + offsetOf(v.decl) + ", outside this loop) is consumed inside a loop body — the body may run many times, or none (§35.4.4: \"`lin` variables from outer scope SHALL NOT be consumed inside loop bodies\"). Consume it once before the loop, or declare it inside the body")
        } else if (v.used) {
            s = linDiag(cx, s, "E-LIN-002", span, "`lin` variable `" + v.name + "` is used at " + offsetOf(v.at) + " and again here — a `lin` variable must be used exactly once (§35.2, §35.5). Remove one use, or use a regular `let` binding if the value needs to be referenced more than once")
        }
        let vars: LinVar[] = []
        let j = 0
        for (const w of s.vars) {
            if (j == i && !w.used) {
                vars = vars.concat([{ id: w.id, name: w.name, decl: w.decl, used: true, at: span, depth: w.depth, scope: w.scope }])
            } else {
                vars = vars.concat([w])
            }
            j = j + 1
        }
        return { vars: vars, diags: s.diags, reported: s.reported, scopes: s.scopes }
    }

    // `a && b` / `a || b`: `b` runs on one path only.
    fn linBinary(cx: LinCx, e: AExpr, op: BinOp, l: AExpr, r: AExpr, s0: LinSt) -> LinR {
        const rl: LinR = linExpr(cx, l, s0)
        if (rl.ends) return rl
        if (op != BinOp.And && op != BinOp.Or) return linExpr(cx, r, rl.st)
        const pre: LinSt = rl.st
        const rr: LinR = linExpr(cx, r, pre)
        return linMerge(cx, pre, [rr, linGo(linFrom(pre, rr.st))], e.span, "this `&&` / `||` (its right operand runs on one path only)")
    }

    fn linTernary(cx: LinCx, e: AExpr, t: AExpr, y: AExpr, n: AExpr, s0: LinSt) -> LinR {
        const rt: LinR = linExpr(cx, t, s0)
        if (rt.ends) return rt
        const pre: LinSt = rt.st
        const ry: LinR = linExpr(cx, y, pre)
        const rn: LinR = linExpr(cx, n, linFrom(pre, ry.st))
        return linMerge(cx, pre, [ry, rn], e.span, "this `? :`")
    }

    // A handling form (§19.4.3): the subject runs, then one arm — or, for
    // `!{}`, the success path (no arm). `?` leaves on the failure path.
    fn linHandled(cx: LinCx, e: AExpr, h: AHandled, s0: LinSt) -> LinR {
        const rs: LinR = linExpr(cx, h.subject, s0)
        if (rs.ends) return rs
        const pre: LinSt = rs.st
        const how: AHow = h.how
        return match how {
            .Propagate :> linGo(linFrom(pre, linExit(cx, pre, 0, e.span, "this `?` (on the failure path it returns from the function)")))
            .Guard(arms: arms) :> linArms(cx, e, arms, true, pre)
            .MatchOn(arms: arms) :> linArms(cx, e, arms, false, pre)
        }
    }

    fn linArms(cx: LinCx, e: AExpr, arms: AArm[], success: boolean, pre: LinSt) -> LinR {
        if (hasErrIn(cx.errs, e.span)) return linSkim(cx, arms, pre)
        let rs: LinR[] = []
        let d: LinSt = pre
        for (const a of arms) {
            const r: LinR = linArm(cx, a, linFrom(pre, d))
            rs = rs.concat([r])
            d = r.st
        }
        if (success) rs = rs.concat([linGo(linFrom(pre, d))])
        if (rs.length == 0) return linGo(pre)
        let what: string = "this `match`"
        if (success) what = "this `!{}` (its arms run only on failure)"
        return linMerge(cx, pre, rs, e.span, what)
    }

    fn linArm(cx: LinCx, a: AArm, s: LinSt) -> LinR {
        const b: AArmBody = a.body
        return match b {
            .ArmExpr(e: x) :> linExpr(cx, x, s)
            .ArmBlock(b: blk) :> linBlock(cx, blk, s)
        }
    }

    // A handling form the typer reported an error in: not judged — each `lin`
    // an arm names counts as consumed (no cascade).
    fn linSkim(cx: LinCx, arms: AArm[], pre: LinSt) -> LinR {
        let s: LinSt = pre
        for (const a of arms) {
            const b: AArmBody = a.body
            const xs: AExpr[] = match b {
                .ArmExpr(e: x) :> [x]
                .ArmBlock(b: blk) :> []
            }
            for (const x of xs) {
                for (const i of linNamed(cx, x, s)) { s = linMark(s, i) }
            }
        }
        return linGo(s)
    }

    fn linMark(s: LinSt, i: int) -> LinSt {
        let vars: LinVar[] = []
        let j = 0
        for (const w of s.vars) {
            if (j == i) {
                vars = vars.concat([{ id: w.id, name: w.name, decl: w.decl, used: true, at: w.at, depth: w.depth, scope: w.scope }])
            } else {
                vars = vars.concat([w])
            }
            j = j + 1
        }
        return { vars: vars, diags: s.diags, reported: s.reported, scopes: s.scopes }
    }

    // The `vars` indices of the `lin` bindings `e` names, one per appearance,
    // in evaluation order (a lambda body included).
    fn linNamed(cx: LinCx, e: AExpr, s: LinSt) -> int[] {
        const i: int = linIndex(cx, e, s)
        if (i >= 0) return [i]
        let out: int[] = []
        for (const x of exprKids(e)) { out = out.concat(linNamed(cx, x, s)) }
        return out
    }

    // §35.6: "Capturing a `lin` variable in a closure … SHALL count as one
    // consumption of that `lin` variable" — at the lambda, whether or not it
    // is ever called. A lambda whose body holds a statement block (an arm
    // block) is refused when it names a `lin`: the bootstrap reads a lambda
    // body as one expression and does not count inside such a block.
    fn linCapture(cx: LinCx, lam: AExpr, body: AExpr, s0: LinSt) -> LinSt {
        let s: LinSt = s0
        const named: int[] = linNamed(cx, body, s)
        if (named.length > 0 && allExprBlocks(body).length > 0) {
            return linDiag(cx, s, "E-BOOTSTRAP-UNSUPPORTED", lam.span, "a lambda that captures a `lin` variable and holds a statement block (an arm block) — the bootstrap counts the consumptions of a lambda's expression body only; write the block's work in a named function and call it")
        }
        for (const i of named) { s = linConsume(cx, s, i, lam.span) }
        return s
    }

    // §19.8.2: in a `!` function an unhandled `?{}` propagates its failure —
    // a path that leaves the function.
    fn linSql(cx: LinCx, e: AExpr, q: ASql, s0: LinSt) -> LinR {
        const r: LinR = linExprs(cx, q.params, s0)
        if (r.ends) return r
        if (cx.failable && !q.handled) return linGo(linFrom(r.st, linExit(cx, r.st, 0, e.span, "this `" + sqlSigil() + "}` (in a `!` function, its failure returns from the function, §19.8.2)")))
        return r
    }

    // §35.7 (working position): "The compiler SHALL emit W-LIN-001 when a `lin`
    // variable is passed to a server-escalated function" — a client call of a
    // server-placed function, an argument that is the `lin` binding itself.
    fn linCall(cx: LinCx, callee: AExpr, args: AExpr[], s0: LinSt) -> LinR {
        let s: LinSt = s0
        const fsym: Sym | not = fnSymOf(nameFact(cx.t.names, callee.nid))
        if (fsym is given && isServerPlaced(cx.t, fsym) && remoteCaller(cx.t, cx.caller)) {
            for (const a of args) {
                const i: int = linIndex(cx, a, s)
                if (i >= 0) s = linDiag(cx, s, "W-LIN-001", a.span, "`lin` variable `" + s.vars[i].name + "` is passed to the server function `" + fsym.hint + "` — it is consumed here, on the client; the server receives a serialized copy, and the `lin` guarantee does not extend to that copy (§35.7)")
            }
        }
        return linExprs(cx, [callee].concat(args), s)
    }

    // `x = v`: the value is evaluated; a bare-name target is a write, not an
    // appearance (a write to a `lin` binding is refused as a write to an
    // immutable binding, §35.2).
    fn linAssign(cx: LinCx, target: AExpr, value: AExpr, s0: LinSt) -> LinR {
        const r: LinR = linExpr(cx, value, s0)
        if (r.ends) return r
        const tk: AExprK = target.k
        const bare: boolean = match tk {
            .Name(name: n) :> true
            .At(name: n) :> true
            .AtItem :> false
            .Num(raw: x) :> false
            .Str(v: x) :> false
            .Bool(v: x) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: x) :> false
            .ObjectLit(props: x) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: x) :> false
            .Sql(q: x) :> false
            .Handled(h: x) :> false
            .Template(quasis: x) :> false
            .Foreign(f: fb0) :> false
        }
        if (bare) return r
        // s472 r1 F2 — a write to a PART of a `lin` binding (`t.n = v`, `t[i] = v`)
        // rebinds it to a copy (value semantics), and nothing may read that copy (a
        // later read is a second use). §35.2: "The binding is immutable — the developer
        // cannot assign a new value to a `lin` variable after declaration"; "The
        // compiler SHALL reject any reassignment to a `lin`-declared identifier".
        // Refused like the whole rebinding (E-ASSIGN-CONST); it still counts as the
        // appearance it is (no cascading E-LIN-001).
        let s1: LinSt = r.st
        const rn: AExpr | not = partRootName(target)
        if (rn is given) {
            if (linIndex(cx, rn, s1) >= 0) s1 = linDiag(cx, s1, "E-ASSIGN-CONST", target.span, "`" + exprLabel(target) + " = …` writes a part of the `lin` variable `" + exprName(rn) + "` — a `lin` binding is immutable and the compiler SHALL reject any reassignment of it (§35.2); a part write rebinds it to a copy nothing may read (a later read is a second use). Build the new value where the `lin` is consumed (pass it to the function that makes it)")
        }
        return linExpr(cx, target, s1)
    }

    // s474 (client-bang composition): the analysis, and the composed program's. A
    // client `!` function whose server calls compose (composePass) is written into
    // the program as one call of a server `!` batch function (composeFiles), and the
    // composed program is analyzed in its place — so its batch is placed, enveloped,
    // routed and checked as every server `!` function is. `nextId`: the linker's first
    // unused node id (link.scrml Linked.nextId); without one (-1) nothing is composed
    // and such a function is refused. A program with an error is not composed (its
    // report stands; the compile fails either way). Both passes get `keyBase`.
    export type ARun:struct = { tp: TypedProgram, plans: ComposePlan[] }

    export fn analyze(files: FileAst[], entry: string) -> TypedProgram { return analyzeLinked(files, entry, "", -1) }

    // s474 r1 (review F1): `keyBase` = the build's source root under the PROJECT root (§21.3) —
    // the root the per-file output keys are hashed from (core.scrml fileKeyPath); `""` when the
    // source root is the project root. The file names the front end reports are not changed.
    export fn analyzeKeyed(files: FileAst[], entry: string, keyBase: string) -> TypedProgram { return analyzeLinked(files, entry, keyBase, -1) }

    export fn analyzeLinked(files: FileAst[], entry: string, keyBase: string, nextId: int) -> TypedProgram {
        const r1: ARun = analyzeRun(files, entry, keyBase, nextId >= 0)
        if (r1.plans.length == 0 || hasErrorDiag(r1.tp.diags)) return r1.tp
        const r2: ARun = analyzeRun(composeFiles(files, r1.plans, nextId), entry, keyBase, false)
        // the plans' warnings join the composed program's diagnostics, and no diagnostic names the
        // synthesized batch (`#F`, `F#batch` — review L2): it is "F (its composed server batch)"
        let notes: Diag[] = []
        for (const p of r1.plans) { notes = notes.concat(p.notes) }
        let ds: Diag[] = []
        for (const d of r2.tp.diags.concat(notes)) { ds = ds.concat([newDiag(d.code, batchNamesOut(r1.plans, d.message), d.file, d.span)]) }
        return { files: r2.tp.files, tables: r2.tp.tables, diags: ds, infos: r2.tp.infos }
    }

    // `m` with every WHOLE `tok` (no identifier character before or after it) replaced by `rep`, and a
    // `()` right after one dropped (s474 r2, review N6).
    fn replaceToken(m: string, tok: string, rep: string) -> string {
        let out: string = ""
        let i: int = 0
        let more = true
        while (more) {
            const j: int = m.indexOf(tok, i)
            if (j < 0) {
                more = false
            } else {
                const e: int = j + tok.length
                let whole = true
                if (j > 0 && cpIdentCh(m.charCodeAt(j - 1))) whole = false
                if (e < m.length && cpIdentCh(m.charCodeAt(e))) whole = false
                if (whole) {
                    out = out + m.substring(i, j) + rep
                    i = e
                    if (m.substring(i, i + 2) == "()") i = i + 2
                } else {
                    out = out + m.substring(i, e)
                    i = e
                }
            }
        }
        return out + m.substring(i)
    }

    fn cpIdentCh(c: int) -> boolean { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 36 }

    fn batchNamesOut(plans: ComposePlan[], m0: string) -> string {
        let m: string = m0
        // longest name first, so `#book` never rewrites inside `#bookings`
        let done: string[] = []
        let left: int = plans.length
        while (left > 0) {
            let best: string = ""
            for (const p of plans) {
                if (done.indexOf(p.name) < 0 && p.name.length >= best.length) best = p.name
            }
            done = done.concat([best])
            m = replaceToken(replaceToken(m, best + "#batch", best + " (its composed server batch)"), "#" + best, best + " (its composed server batch)")
            left = left - 1
        }
        return m
    }

    fn analyzeRun(files: FileAst[], entry: string, keyBase: string, allow: boolean) -> ARun {
        const st0: AS = { facts: noFacts(), diags: [], nextSym: 0, annots: [], bad: { params: [], fields: [] }, effects: [], pend: [], lifts: [] }
        const ra0: RGlobals = phaseA(files, entry, st0)
        // s472: the file-scope constants' initializers, in order (before any body reads one)
        const ra: RGlobals = constPass(ra0.g, ra0.st)
        let st: AS = checkImports(files, ra.g, ra.st)
        st = phaseB(ra.g, st)
        st = strayEffects(files, st)
        // s473 (§21.3.3 rule 15): a declared `:host` handle is not data
        st = hostCellDiags(ra.g, hostTypeDataDiags(ra.g.types, st))
        const rr: RResets = resetOnPass(ra.g, st)
        st = rr.st
        const rp: RPersists = persistPass(ra.g, files, st)
        st = programNoValue(ra.g, rp.st)
        // s469: the stylesheet (§9.1, §65) — placed by position, its `@name` references resolved
        const css: CssPassR = cssPass(ra.g, keyBase)
        let decls: DeclInfo[] = []
        for (const d of ra.g.decls) { decls = decls.concat([d.info]) }
        let fns: FnInfo[] = []
        for (const f of ra.g.fns) { fns = fns.concat([f.info]) }
        // The binder's tables, then the two passes that read them: the scope
        // pass (redeclarations) and the typer (value types). Each returns new
        // values; the final Tables carries the typer's own table.
        const fs: NodeFacts = indexed(st.facts)
        const bound: Tables = { program: ra.g.program, types: ra.g.types, decls: decls, fns: fns, handles: ra.g.handles,
                                names: fs.names, values: fs.values, effects: fs.effects, binds: fs.binds, elems: fs.elems,
                                attrs: fs.attrs, fails: fs.fails, annots: st.annots, unresolved: st.bad, typing: { exprs: [], at: [], presence: [] },
                                novalidate: [], resets: rr.infos, gated: [], persists: rp.infos, server: noServerFacts(), css: css.facts, consts: ra.g.consts, taliases: typeAliases(ra.g.te.link, ra.g.types) }
        const scopeDiags: Diag[] = checkScopes(files, bound, ra.g.te.link)
        // s452 (dpa-066): THE EFFECT SUMMARY — once, over the bound tables —
        // and the binder's decisions that read it (rulesPass, M3)
        const sum: Summary = summarize(ra.g, bound)
        st = rulesPass(sum, st)
        // s449: the no-write rule over every accepted effect (§6.7.4)
        const effectDiags: Diag[] = effectPass(ra.g, bound, st.effects, sum)
        // s444 Phase B: dead validators (RULED S442 (5)) and the forms that take `novalidate` (RULED S442 (3))
        const vp: ValPass = validatorPass(ra.g, bound)
        // s468: static executable attribute values (§5.2 S464) and impure `fn` bodies (§48.3.3)
        const sinkDiags: Diag[] = staticExecPass(ra.g, bound).concat(fnWritePass(ra.g, sum)).concat(fallOffPass(ra.g, bound)).concat(css.diags)
        const typed: RTyping = typeProgram(files, bound, st.diags.concat(scopeDiags).concat(effectDiags).concat(vp.diags).concat(sinkDiags), ra.g.te.link)
        // s451 (U1a): route placement, the queries and the databases
        const pp: RPlaced = placePass(ra.g, bound, st, sum)
        // s454 (U1b): the suspension plan — per client site, after placement (it
        // reads the typer's proven types: a server function's inferred success type)
        const typedT: Tables = { program: bound.program, types: bound.types, decls: bound.decls, fns: bound.fns, handles: bound.handles,
                                 names: bound.names, values: bound.values, effects: bound.effects, binds: bound.binds,
                                 elems: bound.elems, attrs: bound.attrs, fails: bound.fails, annots: bound.annots, unresolved: bound.unresolved, typing: typed.typing,
                                 novalidate: vp.forms, resets: bound.resets, gated: vp.gated, persists: bound.persists, server: pp.facts, css: css.facts, consts: bound.consts, taliases: bound.taliases }
        // s474: the client `!` functions whose server calls compose into one request
        const cp: RCompose = composePass(ra.g, typedT, sum, allow, pp.st)
        const pl: PS = planPass(ra.g, typedT, sum, cp.st)
        const sf: ServerFacts = { servers: pp.facts.servers, sqls: pp.facts.sqls, dbs: pp.facts.dbs, places: pp.facts.places,
                                  inherited: pp.facts.inherited, plan: pl.plan, loads: pp.facts.loads, envelopes: pp.facts.envelopes }
        const t: Tables = { program: bound.program, types: bound.types, decls: bound.decls, fns: bound.fns, handles: bound.handles,
                            names: bound.names, values: bound.values, effects: bound.effects, binds: bound.binds,
                            elems: bound.elems, attrs: bound.attrs, fails: bound.fails, annots: bound.annots, unresolved: bound.unresolved, typing: typed.typing,
                            novalidate: vp.forms, resets: bound.resets, gated: vp.gated, persists: bound.persists, server: sf, css: css.facts, consts: bound.consts, taliases: bound.taliases }
        const base0: Diag[] = domScopeDropped(pl.st.diags, pp.doms).concat(scopeDiags).concat(effectDiags).concat(vp.diags).concat(sinkDiags).concat(typed.diags).concat(hostPlacedDiags(fns, pp.facts.servers)).concat(hostServerDiags(ra.g, pp.facts.servers))
        // s471: the linear pass (§35) — after the typer (§35.5: "after type resolution and
        // route inference"; a non-exhaustive `match`'s E-TYPE-020 is in `base0`, §35.4.3)
        const base: Diag[] = base0.concat(linPass(ra.g, typedT, base0))
        // s462 (fix round 2): the own-value type reports run LAST, over every
        // other pass's diagnostics — so an Error anywhere inside the
        // initializer, or inside the function a failed proof stands in, owns
        // the failure whatever pass reported it (no cascade)
        return { tp: { files: files, tables: t, diags: base.concat(originPass(files, t, base)),
                       infos: gatedInfos(vp.gated) }, plans: cp.plans }
    }

    fn originPass(files: FileAst[], t: Tables, prior: Diag[]) -> Diag[] {
        let ts: TypeState = { exprs: [], diags: prior, contribs: [], presence: [] }
        const fns: int[] = refusedReturns(files, t)
        for (const di of t.decls) {
            const blame: Blame = { spans: errorSpansIn(prior, di.file), syms: [], fns: fns }
            const env: TEnv = { t: t, file: di.file, errs: fileErrs(files, di.file), locals: [], settled: [], narrowed: [], fnw: [], rows: [], fret: not, blame: blame }
            for (const f of di.fields) { ts = originReport(env, di, f, ts) }
        }
        return ts.diags.slice(prior.length)
    }

    // s451 (U1a): a DOM global in a server-triggered body is E-ROUTE-005 (the
    // function cannot be placed, §12.4), not also "not declared".
    fn domScopeDropped(ds: Diag[], doms: int[]) -> Diag[] {
        if (doms.length == 0) return ds
        let out: Diag[] = []
        for (const d of ds) {
            if (!(d.code == "E-SCOPE-001" && doms.indexOf(d.span.start) >= 0)) out = out.concat([d])
        }
        return out
    }

    // s449 — I-FORM-SUBMIT-GATED (§55.17.6 item 1): "one per gated form, at the
    // form's opener, naming the gating values in source order: *"this form's
    // submit is gated by: email, password"*".
    fn gatedInfos(gs: GateInfo[]) -> Diag[] {
        let out: Diag[] = []
        for (const g of gs) {
            // a form that binds only unvalidated fields records the submit (§55.7) but gates nothing
            if (g.values.length > 0) out = out.concat([newDiag("I-FORM-SUBMIT-GATED",
                "this form's submit is gated by: " + g.values.join(", ") + " — the compiler blocks the submit while any of them is invalid, before the form's `onsubmit` runs (§55.17.3); a submit button carrying `formnovalidate` bypasses the block (§55.17.4)", g.file, g.span)])
        }
        return out
    }

    // =========================================================================
    // s444 Phase B — THE VALIDATOR PASS, over the bound tables.
    //  - §55.5.2 (S447 call 4, narrowing RULED S442 (5)): validators are DEAD —
    //    E-VALIDATOR-DEAD — only when nothing can ever change the value: no
    //    `bind:` targets it, it is locked (no write grant), it is not
    //    server-loaded, not seeded at a use site, not restored by `persist=`.
    //    (`server` is not in the bootstrap — refused where written; s451:
    //    `persist=` is, but only on a writable cell — persistPass refuses it on
    //    a locked one — so "locked" already implies "not restored".) A `let`
    //    value set only from logic is LIVE: its
    //    surface reports what logic writes.
    //  - RULED S442 (3) "the compiler adds `novalidate` to any form carrying
    //    lowered attributes": every `<form>` whose markup — through `<*f/>`
    //    inlines, `<*x/>` Stars, uses, `<each>` rows and state-view arms — holds
    //    a bound element with lowered validator attributes.
    // =========================================================================
    type ValPass:struct = { diags: Diag[], forms: int[], gated: GateInfo[] }
    type BindKey:struct = { decl: int, idx: int }

    fn validatorPass(g: Globals, t: Tables) -> ValPass {
        let keys: BindKey[] = []
        for (const k of t.attrs.facts) { keys = keys.concat(bindKeyOf(k)) }
        let seeds: BindKey[] = []
        for (const ds of g.decls) {
            for (const n of declMarkup(ds)) { seeds = seeds.concat(seedKeysIn(t, n)) }
        }
        let diags: Diag[] = []
        for (const ds of g.decls) {
            let i = 0
            for (const f of ds.info.fields) {
                const locked: boolean = f.wcap is not
                if (f.vals.length > 0 && locked && !hasBindKey(keys, ds.info.sym.id, i) && !hasBindKey(seeds, ds.info.sym.id, i)) {
                    diags = diags.concat([newDiag("E-VALIDATOR-DEAD",
                        "`" + f.sym.hint + "` has validators, but nothing can ever change its value — it is locked (no `let`), no `bind:` targets it, and no use site seeds it — so its validity is a compile-time constant and the validators can never report a change (§55.5.2); make it `let` (and bind it or set it from logic), or drop the validators", ds.file, f.span)])
                }
                i = i + 1
            }
        }
        // r2 F1: a `<slot/>` in a declaration's markup is filled by the
        // children of every use of that declaration — collect the use sites.
        let uses: UseSite[] = []
        for (const ds of g.decls) {
            for (const n of declMarkup(ds)) { uses = uses.concat(useSitesIn(t, ds.info.sym.id, n)) }
        }
        let forms: int[] = []
        let gated: GateInfo[] = []
        for (const ds of g.decls) {
            const cx: CarryCx = { g: g, t: t, uses: uses, seen: [], slot: ds.info.sym.id, slotSeen: [] }
            for (const n of declMarkup(ds)) {
                forms = forms.concat(formsIn(cx, n))
                for (const gi of gatesIn(cx, n)) { gated = gated.concat([{ form: gi.form, values: gi.values, span: gi.span, file: ds.file }]) }
            }
        }
        // s472 — a control outside its form that names it with `form="id"` joins
        // that form's gate (and its `novalidate`), RULED S472 (formOwnerPass).
        const owners: OwnerPass = formOwnerPass(g, t)
        diags = diags.concat(owners.diags)
        for (const x of owners.ext) {
            let found = false
            let next: GateInfo[] = []
            for (const gi of gated) {
                if (gi.form == x.form) {
                    found = true
                    next = next.concat([{ form: gi.form, values: addNames(gi.values, x.names), span: gi.span, file: gi.file }])
                } else {
                    next = next.concat([gi])
                }
            }
            if (!found) next = next.concat([{ form: x.form, values: x.names, span: x.span, file: x.file }])
            gated = next
            if (x.carries && forms.indexOf(x.form) < 0) forms = forms.concat([x.form])
        }
        return { diags: diags, forms: forms, gated: gated }
    }

    // ---- s472: THE HTML FORM OWNER (g-bootstrap-gate-external-form-owner-control)
    // RULED S472 (user-voice-scrml.md "`form="id"` (HTML form owner) and the
    // submit gate"): "a control carrying `form="id"` whose `bind:` targets a
    // validated value JOINS THE GATE SET OF THAT ONE FORM (§55.17), and only
    // that form, when `id` is a static literal naming exactly one `<form>` in
    // the program; `novalidate` on that form waives it as for in-form
    // controls. Otherwise — a computed `form=`, an id naming no form or more
    // than one, or a non-literal — `form=` on a validated bind is a COMPILE
    // ERROR." (SPEC §55.17.3 "The HTML form owner"; E-FORM-OWNER-UNRESOLVED.)
    //
    // HTML attribute names are ASCII case-insensitive (`FORM=` is `form=` to
    // the browser), so `form` / `id` / `novalidate` are found case-blind on an
    // HTML element (htmlAttr) — the bootstrap's existing rule for HTML names
    // (resolveElem's repeated-attribute check compares lowercased names).
    //
    // What the bootstrap builds (fail closed beyond it, E-BOOTSTRAP-UNSUPPORTED):
    // the control and its form both in the `<program>`'s own markup (Cond arms,
    // state-view arms and slot content included), neither inside an `<each>` /
    // Tier-0 row — the places the form's gate can name the control's value
    // from its own render context (lower.scrml gateDecls `extFields`). An `&`
    // in either literal (a character reference the browser decodes) is not
    // read as a literal.
    type IdSite:struct = { id: string, dynamic: boolean, nid: int, isForm: boolean, okLoc: boolean, novalidate: boolean, tag: string, span: ASpan, file: string }
    type CtlSite:struct = { e: AElem, file: string, okLoc: boolean, owner: AAttr, validated: string[], surfaced: string[], carries: boolean }
    type OwnerWalk:struct = { ids: IdSite[], ctls: CtlSite[] }
    type ExtCtl:struct = { form: int, names: string[], carries: boolean, span: ASpan, file: string }
    type OwnerPass:struct = { diags: Diag[], ext: ExtCtl[] }

    fn formOwnerPass(g: Globals, t: Tables) -> OwnerPass {
        let w: OwnerWalk = { ids: [], ctls: [] }
        for (const ds of g.decls) {
            const isProg: boolean = ds.info.sym.id == t.program.id
            for (const n of declMarkup(ds)) { w = ownerWalkIn(t, ds.file, isProg, false, n, w) }
        }
        let diags: Diag[] = []
        let ext: ExtCtl[] = []
        let computedForm = false
        for (const s of w.ids) {
            if (s.isForm && s.dynamic) computedForm = true
        }
        for (const c of w.ctls) {
            const r: OwnerPass = judgeOwner(w, computedForm, c)
            diags = diags.concat(r.diags)
            ext = ext.concat(r.ext)
        }
        return { diags: diags, ext: ext }
    }

    fn judgeOwner(w: OwnerWalk, computedForm: boolean, c: CtlSite) -> OwnerPass {
        const validated: boolean = c.validated.length > 0
        if (!validated && c.surfaced.length == 0) return { diags: [], ext: [] }
        const what: string = "`<" + c.e.tag + " " + c.owner.name + "=…>` binds `" + c.validated.concat(c.surfaced).join("`, `") + "`"
        // s473 — a data `form=` is refused on its own (E-ATTR-FORM-ACTION, §5.2
        // "Data never chooses where a form posts …"); one diagnostic per fault.
        if (valueExpr(c.owner.value) is given) return { diags: [], ext: [] }
        const lit: string | not = htmlLiteral(c.owner.value)
        let why: string = ""
        let target: IdSite | not = not
        if (lit is not) {
            why = "its `" + c.owner.name + "=` is not a static literal (a computed, unquoted or entity-bearing value)"
        } else if (computedForm) {
            why = "a `<form>` in this program has a computed `id`, so it cannot be proven that \"" + lit + "\" names exactly one form"
        } else {
            let hits: IdSite[] = []
            for (const s of w.ids) {
                if (!s.dynamic && s.id == lit) hits = hits.concat([s])
            }
            if (hits.length == 0) {
                why = "no element in the program has `id=\"" + lit + "\"`"
            } else if (hits.length > 1) {
                why = hits.length + " elements in the program have `id=\"" + lit + "\"`"
            } else if (!hits[0].isForm) {
                why = "`id=\"" + lit + "\"` names a `<" + hits[0].tag + ">`, not a `<form>`"
            } else {
                target = hits[0]
            }
        }
        if (target is not) {
            // F4 (S472 r1): only a VALIDATED bind is ruled; an unvalidated one with an
            // unresolved owner joins no gate and is left to HTML.
            if (!validated) return { diags: [], ext: [] }
            return { diags: [newDiag("E-FORM-OWNER-UNRESOLVED",
                what + " (a validated value) and names its form owner, but " + why + " — a control with `form=\"id\"` joins the submit gate of that one form only when `id` is a static literal naming exactly one `<form>` in the program (§55.17.3 \"The HTML form owner\"); write `form=\"<that form's id>\"` with a literal, or put the control inside its `<form>` and drop `form=`",
                c.file, c.owner.span)], ext: [] }
        }
        if (!c.okLoc || !target.okLoc) {
            if (!validated) return { diags: [], ext: [] }
            return { diags: [newDiag("E-BOOTSTRAP-UNSUPPORTED",
                what + " (a validated value) and joins the gate of `<form id=\"" + target.id + "\">` (§55.17.3 \"The HTML form owner\"), but the bootstrap builds that only when the control and the form are both in the `<program>`'s own markup and neither is inside an `<each>` or a `${ for … lift }` row — refused (fail closed); put the control inside its `<form>` and drop `form=`",
                c.file, c.owner.span)], ext: [] }
        }
        let carries: boolean = c.carries
        if (target.novalidate) carries = false
        return { diags: [], ext: [{ form: target.nid, names: c.validated, carries: carries, span: target.span, file: target.file }] }
    }

    // A literal attribute value the browser reads as written: quoted, no
    // `${…}`, no `&` (a character reference would decode to other text).
    fn htmlLiteral(v: AAttrValue) -> string | not {
        const s: string | not = staticQuotedText(v)
        if (s is not) return not
        if (s.indexOf("&") >= 0) return not
        return s
    }

    // The first attribute of an HTML element named `name`, ASCII case-blind.
    fn htmlAttr(attrs: AAttr[], name: string) -> AAttr | not {
        for (const a of attrs) {
            if (a.name.toLowerCase() == name) return a
        }
        return not
    }

    // An HTML control that names a form owner (`form=`, any case) — its binds
    // belong to THAT form, not to the form whose subtree it sits in.
    fn ownsOtherForm(t: Tables, e: AElem) -> boolean {
        if (!isHtmlFact(elemFact(t.elems, e.nid))) return false
        return htmlAttr(e.attrs, "form") is given
    }

    fn ownerWalkRows(t: Tables, file: string, isProg: boolean, rows: ANode[], w0: OwnerWalk) -> OwnerWalk {
        let w: OwnerWalk = w0
        for (const r of rows) { w = ownerWalkIn(t, file, isProg, true, r, w) }
        return w
    }

    fn ownerWalkIn(t: Tables, file: string, isProg: boolean, inRow: boolean, n: ANode, w: OwnerWalk) -> OwnerWalk {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> ownerWalkElem(t, file, isProg, inRow, e, w)
            .Text(text: x) :> w
            .Interp(e: x) :> w
            .DeclNode(d: d) :> w
            .Css(c: c) :> w
            .Gather(f: lf) :> ownerWalkRows(t, file, isProg, gatherRows(lf), w)
            .Effect(w: x) :> w
        }
    }

    fn ownerWalkElem(t: Tables, file: string, isProg: boolean, inRow: boolean, e: AElem, w0: OwnerWalk) -> OwnerWalk {
        let w: OwnerWalk = w0
        const f: ElemFact | not = elemFact(t.elems, e.nid)
        const okLoc: boolean = isProg && !inRow
        if (isHtmlFact(f)) {
            const isForm: boolean = e.tag.toLowerCase() == "form" && !e.star
            const ida: AAttr | not = htmlAttr(e.attrs, "id")
            if (ida is given) {
                const lit: string | not = htmlLiteral(ida.value)
                let id: string = ""
                if (lit is given) id = lit
                w = { ids: w.ids.concat([{ id: id, dynamic: lit is not, nid: e.nid, isForm: isForm, okLoc: okLoc,
                                          novalidate: htmlAttr(e.attrs, "novalidate") is given, tag: e.tag, span: e.span, file: file }]),
                      ctls: w.ctls }
            }
            const owner: AAttr | not = htmlAttr(e.attrs, "form")
            if (owner is given) {
                let validated: string[] = []
                let all: string[] = []
                let carries = false
                for (const a of e.attrs) {
                    const fact: AttrKind | not = attrFact(t.attrs, a.nid)
                    validated = addNames(validated, boundValidated(t, fact, false))
                    all = addNames(all, boundValidated(t, fact, true))
                    if (lowersAttrs(fact)) carries = true
                }
                let surfaced: string[] = []
                for (const x of all) {
                    if (validated.indexOf(x) < 0) surfaced = surfaced.concat([x])
                }
                w = { ids: w.ids, ctls: w.ctls.concat([{ e: e, file: file, okLoc: okLoc, owner: owner, validated: validated, surfaced: surfaced, carries: carries }]) }
            }
        }
        const rows: boolean = inRow || isEachElemFact(f)
        for (const c of e.kids) { w = ownerWalkIn(t, file, isProg, rows, c, w) }
        return w
    }

    fn isEachElemFact(f: ElemFact | not) -> boolean {
        return match f {
            .MEach(bind: b) :> true
            .MHtml :> false
            .MUse(decl: d) :> false
            .MSlot :> false
            .MDb :> false
            .MErrors(of: x) :> false
            .MStateView(v: v) :> false
            .MInline(v: v) :> false
            .MStar(decl: d) :> false
            not :> false
        }
    }

    // ---- s449: THE GATED FORMS (§55.17.3) ------------------------------------
    // "A gated form is every `<form>` whose composed subtree (§55.17.2 rule 1)
    // contains a native control whose `bind:` targets a value that carries
    // validators, whether or not any of those validators lowers to an HTML
    // attribute." The composed subtree is the one `novalidate` walks
    // (formsIn): inlines, Stars, uses, `<each>` rows, state-view arms, slot
    // content. A form the author wrote `novalidate` on is gated all the same
    // (S447 gate-calls item 1: "with or without `novalidate`").
    fn gatesInRows(cx: CarryCx, rows: ANode[]) -> GateInfo[] {
        let out: GateInfo[] = []
        for (const r of rows) { out = out.concat(gatesIn(cx, r)) }
        return out
    }

    fn gatesIn(cx: CarryCx, n: ANode) -> GateInfo[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> gatesInElem(cx, e)
            .Text(text: x) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Css(c: c) :> []
            .Gather(f: lf) :> gatesInRows(cx, gatherRows(lf))
            .Effect(w: w) :> []
        }
    }

    fn gatesInElem(cx: CarryCx, e: AElem) -> GateInfo[] {
        let out: GateInfo[] = []
        if (e.tag == "form" && !e.star && isHtmlFact(elemFact(cx.t.elems, e.nid))) {
            // §55.7: a form that binds ANY field with a surface sets `submitted`
            // (`all`); it is GATED (§55.17.3) when one of them carries validators.
            const surfaced: string[] = elemBound(cx, e, true)
            if (surfaced.length > 0) out = [{ form: e.nid, values: elemBound(cx, e, false), span: e.span, file: "" }]
        }
        for (const k of e.kids) { out = out.concat(gatesIn(cx, k)) }
        return out
    }

    // The validated values bound under this element (through its expansion
    // and its children), named, each once, in source order. `all`: every
    // bound value that has a surface (a validated top-level value, any field
    // of a user declaration), not only the validated ones.
    fn elemBound(cx: CarryCx, e: AElem, all: boolean) -> string[] {
        let out: string[] = []
        // s472: a control naming its form owner (`form=`) is bound in THAT form (formOwnerPass)
        if (!ownsOtherForm(cx.t, e)) {
            for (const a of e.attrs) { out = addNames(out, boundValidated(cx.t, attrFact(cx.t.attrs, a.nid), all)) }
        }
        out = addNames(out, expansionBound(cx, elemFact(cx.t.elems, e.nid), all))
        return addNames(out, nodesBound(cx, e.kids, all))
    }

    fn addNames(xs: string[], ys: string[]) -> string[] {
        let out: string[] = xs
        for (const y of ys) {
            if (out.indexOf(y) < 0) out = out.concat([y])
        }
        return out
    }

    fn nodesBound(cx: CarryCx, ns: ANode[], all: boolean) -> string[] {
        let out: string[] = []
        for (const n of ns) {
            const k: ANodeK = n.k
            const el: AElem | not = elemOfNode(k)
            if (el is given) out = addNames(out, elemBound(cx, el, all))
            // s472 r1 (F3): a Tier-0 `${ for … lift <…> }`'s rows are markup in the form too
            out = addNames(out, nodesBound(cx, tier0Rows(k), all))
        }
        return out
    }

    fn tier0Rows(k: ANodeK) -> ANode[] {
        return match k {
            .Gather(f: lf) :> gatherRows(lf)
            .Elem(e: x) :> []
            .Text(text: x) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Css(c: c) :> []
            .Effect(w: w) :> []
        }
    }

    // A bind of a field's WHOLE value whose field carries validators → its name.
    fn boundValidated(t: Tables, k: AttrKind | not, all: boolean) -> string[] {
        return match k {
            .ABind(w: w, decl: d, idx: i) :> validatedName(t, w, d, i, all)
            .AStatic :> []
            .ABound :> []
            .AOn(event: ev) :> []
            .AIf :> []
            .AShow :> []
            .AConstruct(field: x) :> []
            .AAs :> []
            .AEachIn :> []
            .AEachKey :> []
            .AEachAs :> []
            not :> []
        }
    }

    fn validatedName(t: Tables, w: WriteFact, d: Sym, i: int, all: boolean) -> string[] {
        if (bindKeyFor(w, d, i).length == 0) return []
        const di: DeclInfo | not = declInfo(t, d)
        if (di is not) return []
        if (i < 0 || i >= di.fields.length) return []
        const surfacedOnly: boolean = all && di.sym.id != t.program.id
        if (di.fields[i].vals.length == 0 && !surfacedOnly) return []
        if (di.sym.id == t.program.id) return [di.fields[i].sym.hint]
        return [di.sym.hint + "." + di.fields[i].sym.hint]
    }

    fn expansionBound(cx: CarryCx, f: ElemFact | not, all: boolean) -> string[] {
        return match f {
            .MInline(v: v) :> nodesBound(cx, v.nodes, all)
            .MStar(decl: d) :> nodesBound(intoDecl(cx, d), declRendersOnce(cx, d), all)
            .MUse(decl: d) :> nodesBound(intoDecl(cx, d), declRendersOnce(cx, d), all)
            .MStateView(v: v) :> nodesBound(cx, stateArmNodes(v), all)
            .MSlot :> slotBound(cx, all)
            .MDb :> []
            .MErrors(of: x) :> []
            .MHtml :> []
            .MEach(bind: b) :> []
            not :> []
        }
    }

    fn slotBound(cx: CarryCx, all: boolean) -> string[] {
        if (cx.slot < 0 || cx.slotSeen.indexOf(cx.slot) >= 0) return []
        let out: string[] = []
        for (const u of cx.uses) {
            if (u.decl == cx.slot) {
                const ux: CarryCx = { g: cx.g, t: cx.t, uses: cx.uses, seen: cx.seen, slot: u.owner, slotSeen: cx.slotSeen.concat([cx.slot]) }
                out = addNames(out, nodesBound(ux, u.kids, all))
            }
        }
        return out
    }

    // s449 — the fields a USE seeds (`<f v="x"/>`, a use-site value, §66.9
    // rule 8): a locked validated field seeded there is LIVE (§55.5.2 (4)).
    fn seedKeysIn(t: Tables, n: ANode) -> BindKey[] {
        const k: ANodeK = n.k
        const e: AElem | not = elemOfNode(k)
        if (e is not) return []
        let out: BindKey[] = []
        const used: Sym | not = useDeclOf(elemFact(t.elems, e.nid))
        if (used is given) {
            for (const a of e.attrs) {
                const i: int = constructIdx(attrFact(t.attrs, a.nid))
                if (i >= 0) out = out.concat([{ decl: used.id, idx: i }])
            }
        }
        for (const c of e.kids) { out = out.concat(seedKeysIn(t, c)) }
        return out
    }

    fn useDeclOf(f: ElemFact | not) -> Sym | not {
        return match f {
            .MUse(decl: d) :> d
            .MStar(decl: d) :> not
            .MInline(v: v) :> not
            .MStateView(v: v) :> not
            .MHtml :> not
            .MEach(bind: b) :> not
            .MSlot :> not
            .MDb :> not
            .MErrors(of: x) :> not
            not :> not
        }
    }

    fn constructIdx(k: AttrKind | not) -> int {
        return match k {
            .AConstruct(field: i) :> i
            .AStatic :> -1
            .ABound :> -1
            .AOn(event: ev) :> -1
            .AIf :> -1
            .AShow :> -1
            .AAs :> -1
            .AEachIn :> -1
            .AEachKey :> -1
            .AEachAs :> -1
            .ABind(kind: b) :> -1
            not :> -1
        }
    }

    // A use of declaration `decl` (`<decl …>kids</>`) written in `owner`'s
    // markup: its `kids` fill `decl`'s `<slot/>`.
    type UseSite:struct = { decl: int, owner: int, kids: ANode[] }

    fn useSitesIn(t: Tables, owner: int, n: ANode) -> UseSite[] {
        const k: ANodeK = n.k
        const e: AElem | not = elemOfNode(k)
        if (e is not) return []
        let out: UseSite[] = useSiteOf(elemFact(t.elems, e.nid), owner, e.kids)
        for (const c of e.kids) { out = out.concat(useSitesIn(t, owner, c)) }
        return out
    }

    fn useSiteOf(f: ElemFact | not, owner: int, kids: ANode[]) -> UseSite[] {
        return match f {
            .MUse(decl: d) :> [{ decl: d.id, owner: owner, kids: kids }]
            .MStar(decl: d) :> []
            .MInline(v: v) :> []
            .MStateView(v: v) :> []
            .MHtml :> []
            .MEach(bind: b) :> []
            .MSlot :> []
            .MDb :> []
            .MErrors(of: x) :> []
            not :> []
        }
    }

    // The traversal context: `seen` — the declarations already being expanded
    // (a renders may reach itself); `slot` — the declaration whose uses fill a
    // `<slot/>` met here (-1: none — inside a use's expansion the slot is that
    // use's own children, which the traversal visits as the use's kids);
    // `slotSeen` — the declarations whose slot content is being visited.
    type CarryCx:struct = { g: Globals, t: Tables, uses: UseSite[], seen: int[], slot: int, slotSeen: int[] }

    fn bindKeyOf(k: AttrKind) -> BindKey[] {
        return match k {
            .ABind(w: w, decl: d, idx: i) :> bindKeyFor(w, d, i)
            .AStatic :> []
            .ABound :> []
            .AOn(event: ev) :> []
            .AIf :> []
            .AShow :> []
            .AConstruct(field: x) :> []
            .AAs :> []
            .AEachIn :> []
            .AEachKey :> []
            .AEachAs :> []
        }
    }

    // Only a bind of the field's WHOLE value (not a sub-field path) is its bind.
    fn bindKeyFor(w: WriteFact, d: Sym, i: int) -> BindKey[] {
        const isWhole: boolean = w.edit == EditKind.Replace
        if (!isWhole) return []
        return [{ decl: d.id, idx: i }]
    }

    fn hasBindKey(ks: BindKey[], d: int, i: int) -> boolean {
        for (const k of ks) {
            if (k.decl == d && k.idx == i) return true
        }
        return false
    }

    // All the markup a declaration owns: its renders, state-child bodies, child renders.
    fn declMarkup(ds: DeclSrc) -> ANode[] {
        let out: ANode[] = rendersNodes(ds).concat(stateBodies(ds))
        if (ds.p is not) {
            for (const fd of fieldDecls(ds)) { out = out.concat(rendersOf(fd)) }
        }
        return out
    }

    // The `<form>` elements under `n` that carry lowered attributes.
    fn formsInRows(cx: CarryCx, rows: ANode[]) -> int[] {
        let out: int[] = []
        for (const r of rows) { out = out.concat(formsIn(cx, r)) }
        return out
    }

    fn formsIn(cx: CarryCx, n: ANode) -> int[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> formsInElem(cx, e)
            .Text(text: x) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Css(c: c) :> []
            .Gather(f: lf) :> formsInRows(cx, gatherRows(lf))
            .Effect(w: w) :> []
        }
    }

    fn formsInElem(cx: CarryCx, e: AElem) -> int[] {
        let out: int[] = []
        if (e.tag == "form" && !e.star && isHtmlFact(elemFact(cx.t.elems, e.nid)) && htmlAttr(e.attrs, "novalidate") is not) {
            if (elemCarries(cx, e)) out = [e.nid]
        }
        for (const k of e.kids) { out = out.concat(formsIn(cx, k)) }
        return out
    }

    fn isHtmlFact(f: ElemFact | not) -> boolean {
        return match f {
            .MHtml :> true
            .MUse(decl: d) :> false
            .MEach(bind: b) :> false
            .MSlot :> false
            .MDb :> false
            .MErrors(of: x) :> false
            .MStateView(v: v) :> false
            .MInline(v: v) :> false
            .MStar(decl: d) :> false
            not :> false
        }
    }

    // Does this markup hold a bound element with lowered attributes?
    fn nodesCarry(cx: CarryCx, ns: ANode[]) -> boolean {
        for (const n of ns) {
            const k: ANodeK = n.k
            const el: AElem | not = elemOfNode(k)
            if (el is given) {
                if (elemCarries(cx, el)) return true
            }
            if (nodesCarry(cx, tier0Rows(k))) return true
        }
        return false
    }

    fn elemOfNode(k: ANodeK) -> AElem | not {
        return match k {
            .Elem(e: e) :> e
            .Text(text: x) :> not
            .Interp(e: x) :> not
            .DeclNode(d: d) :> not
            .Css(c: c) :> not
            .Gather(f: x) :> not
            .Effect(w: w) :> not
        }
    }

    fn elemCarries(cx: CarryCx, e: AElem) -> boolean {
        if (!ownsOtherForm(cx.t, e)) {
            for (const a of e.attrs) {
                if (lowersAttrs(attrFact(cx.t.attrs, a.nid))) return true
            }
        }
        const f: ElemFact | not = elemFact(cx.t.elems, e.nid)
        if (expansionCarries(cx, f)) return true
        return nodesCarry(cx, e.kids)
    }

    fn lowersAttrs(k: AttrKind | not) -> boolean {
        return match k {
            .ABind(vattrs: vs) :> vs.length > 0
            .AStatic :> false
            .ABound :> false
            .AOn(event: ev) :> false
            .AIf :> false
            .AShow :> false
            .AConstruct(field: x) :> false
            .AAs :> false
            .AEachIn :> false
            .AEachKey :> false
            .AEachAs :> false
            not :> false
        }
    }

    // The markup an element stands for beyond its own children: an inlined
    // renders, a Star's / a use's declaration renders, state-view arm bodies,
    // and (r2 F1) a `<slot/>`'s content — the children of every use of the
    // declaration whose markup holds it. A form's `novalidate` is one static
    // attribute of the declaration's markup, so it is added when ANY use's
    // slot content carries lowered attributes.
    fn expansionCarries(cx: CarryCx, f: ElemFact | not) -> boolean {
        return match f {
            .MInline(v: v) :> nodesCarry(cx, v.nodes)
            .MStar(decl: d) :> nodesCarry(intoDecl(cx, d), declRendersOnce(cx, d))
            .MUse(decl: d) :> nodesCarry(intoDecl(cx, d), declRendersOnce(cx, d))
            .MStateView(v: v) :> nodesCarry(cx, stateArmNodes(v))
            .MSlot :> slotCarries(cx)
            .MDb :> false
            .MErrors(of: x) :> false
            .MHtml :> false
            .MEach(bind: b) :> false
            not :> false
        }
    }

    // Into a declaration's renders through a Star / a use: that renders' own
    // `<slot/>` is the use's children (visited as its kids) — no slot owner.
    fn intoDecl(cx: CarryCx, d: Sym) -> CarryCx {
        return { g: cx.g, t: cx.t, uses: cx.uses, seen: cx.seen.concat([d.id]), slot: -1, slotSeen: cx.slotSeen }
    }

    fn slotCarries(cx: CarryCx) -> boolean {
        if (cx.slot < 0 || cx.slotSeen.indexOf(cx.slot) >= 0) return false
        for (const u of cx.uses) {
            if (u.decl == cx.slot) {
                const ux: CarryCx = { g: cx.g, t: cx.t, uses: cx.uses, seen: cx.seen, slot: u.owner, slotSeen: cx.slotSeen.concat([cx.slot]) }
                if (nodesCarry(ux, u.kids)) return true
            }
        }
        return false
    }

    fn declRendersOnce(cx: CarryCx, d: Sym) -> ANode[] {
        if (cx.seen.indexOf(d.id) >= 0) return []
        const ds: DeclSrc | not = findDeclSrc(cx.g, d)
        if (ds is not) return []
        return declMarkup(ds)
    }

    fn stateArmNodes(v: StateView) -> ANode[] {
        let out: ANode[] = []
        for (const a of v.arms) { out = out.concat(a.body) }
        return out
    }

    // s471 — every import RESOLVES (link.scrml `importTarget`, the one resolver
    // the link order also reads) to a file in the link set, and every name it
    // brings is an EXPORTED type / declaration / function of THAT file (§21.3:
    // "resolved by the compiler against the exporting file's export list").
    // An import that resolves to nothing is refused BY NAME at the import —
    // never dropped (before s471 a `scrml:` import, an import inside a
    // `<program>`, and a name exported by some other file all passed silently).
    fn checkImports(files: FileAst[], g: Globals, st0: AS) -> AS {
        let st: AS = st0
        const paths: string[] = filePaths(files)
        for (const f of files) {
            for (const imp of importsOfItems(f.items)) {
                const target: string = importTarget(f.path, imp.from, paths)
                if (isServerOnlyStdlib(imp.from)) {
                    st = addDiag(st, f.path, imp.span, "E-BOOTSTRAP-UNSUPPORTED", serverOnlyWhy(imp.from))
                } else if (target == "") {
                    const r: ImportRefusal = importRefusal(imp.from)
                    st = addDiag(st, f.path, imp.span, r.code, r.why)
                } else {
                    for (const n of imp.names) {
                        // s474: an aliased import (`{ a as b }`) names the export `a`
                        if (!exportedBy(g, target, n.orig)) {
                            st = addDiag(st, f.path, n.span, "E-IMPORT-004", "`" + n.orig + "` is not exported by `" + imp.from + "`")
                        }
                    }
                }
            }
            for (const h of hostImportsOfItems(f.items)) { st = checkHostImport(g, st, f.path, h) }
        }
        return st
    }

    // s472 — an `import:<tag> { … } from "…"` declaration (§21.3.1), judged in
    // the order impl#1 (compiler/src/host-import.js validateHostImports) judges
    // it, each failed rule its own diagnostic:
    //   - E-IMPORT-003: "`import:host` SHALL appear only at file top level,
    //     OUTSIDE any `${}` logic context. An `import:host` declaration inside a
    //     `${}` block or any nested scope SHALL be a compile error (`E-IMPORT-003`
    //     — same as plain `import`)." (a `<program>` body is a nested scope)
    //   - E-IMPORT-009: "The `host-tag` SHALL be `host` in v1. Any other host-tag
    //     value SHALL be a compile error (`E-IMPORT-009` — unknown host-tag; only
    //     `host` is recognized in v1)." A `host` import of a module that is not
    //     TypeScript / JavaScript ("a host-language module (TypeScript or
    //     JavaScript)") is refused under the same code, as impl#1 refuses it.
    //   - E-IMPORT-008: "A file outside the allow-list using `import:host` SHALL
    //     be a compile error (`E-IMPORT-008`)." The allow-list is the stdlib
    //     (§22.13 `"self-host-only"` — "canonical: … `scrml/stdlib/**` — S471");
    //     an adopter file is outside it whatever its manifest says (§22.13: "in an
    //     adopter project `import:host` is E-IMPORT-008 whatever the entry
    //     says"). Stdlib-ness is the file's path in the build (link.scrml
    //     `isStdlibPath`), never its text.
    // s472 (boot-math-port): a declaration that passes every rule is EMITTED —
    // E-IMPORT-012 if its module is not inside its stdlib module's directory
    // (the S472 output-location ruling), E-BOOTSTRAP-UNSUPPORTED for a
    // TypeScript module; its bindings are usable only under the wrapper rule
    // (hostWrappers / resolveHostBinding); a binding's name also declared in the
    // file is E-SCOPE-010 (§7.6, as for a plain import — linkage).
    fn checkHostImport(g: Globals, st0: AS, file: string, h: AImport) -> AS {
        let st: AS = st0
        const tag: string = hostTagOf(h)
        const shown: string = "import:" + tag
        let failed = false
        if (!h.top) {
            failed = true
            st = addDiag(st, file, h.span, "E-IMPORT-003", "`" + shown + "` is not at file top level — `import:host` SHALL appear only at file top level, outside any `${}` logic context and any nested scope such as a `<program>` body (§21.3.1); move it to the top of the file")
        }
        if (tag != "host") {
            failed = true
            st = addDiag(st, file, h.span, "E-IMPORT-009", "`" + shown + "` uses the host-tag `" + tag + "` — v1 recognizes only `host` (the TypeScript / JavaScript named-export bridge, §21.3.1); other host languages are reserved for a future SPEC amendment")
        } else if (!hostModuleSource(h.from)) {
            failed = true
            st = addDiag(st, file, h.span, "E-IMPORT-009", "`import:host` target `" + h.from + "` is not a TypeScript / JavaScript module — the `host` tag binds named exports of a `.ts` / `.mts` / `.js` / `.mjs` module only (§21.3.1); import a scrml module with a plain `import`")
        }
        if (!isStdlibPath(file)) {
            failed = true
            st = addDiag(st, file, h.span, "E-IMPORT-008", "`" + shown + "` is used in a file outside the `[capabilities] host-import` allow-list — `import:host` is the stdlib's host bridge, admitted only in stdlib files (§21.3.1, §22.13: an adopter project has no opt-in); reach host JavaScript through a relative `.js` import (§21.3)")
        }
        // s472 (boot-math-port): an admitted declaration is emitted — its module is
        // copied to `<outputDir>/_scrml/<module>/<file>` and imported from there by
        // both artifacts (§21.3.1, ruling:user-voice-scrml.md S472 "stdlib host `.js`
        // output location"): it must lie inside its stdlib module's directory, and be
        // JavaScript (the bootstrap prints JavaScript, which cannot import TypeScript)
        if (!failed) {
            if (hostLocOf(file, h.from) is not) {
                st = addDiag(st, file, h.span, "E-IMPORT-012", "`import:host` target `" + h.from + "` is not inside this stdlib module's directory — a stdlib module's host file is copied to `<outputDir>/_scrml/<module>/<file>`, so it SHALL lie in the module's own directory (a relative path that does not climb out of it; a file-form module `scrml:NAME.scrml` has no directory to hold one) (§21.3.1)")
            } else if (!hostEmitSource(h.from)) {
                st = addDiag(st, file, h.span, "E-BOOTSTRAP-UNSUPPORTED", "`import:host` target `" + h.from + "` is TypeScript — the bootstrap's artifacts are JavaScript modules, which import a `.js` / `.mjs` host module only")
            }
        }
        for (const n of h.names) {
            if (hostNameCollides(g, file, n.name)) {
                st = addDiag(st, file, n.span, "E-SCOPE-010", "`" + n.name + "` is bound by `" + shown + "` and also declared in this file — a name is bound once in file scope (duplicate binding in file scope, §7.6); rename one with `as`")
            } else {
                const other: string = hostImportClash(g, file, h, n.name)
                if (other != "") {
                    st = addDiag(st, file, n.span, "E-SCOPE-010", "`" + n.name + "` is bound by `" + shown + "` and also by " + other + " in this file — a host binding's local name is bound once in file scope (§21.3.1.1, §7.6; never a later-import-wins shadow, which would let one binding silently replace the typed host boundary); rename one with `as`")
                }
            }
        }
        return st
    }

    // s473 (review LOW-1) — another import of `file` that also binds `name`: a plain
    // `import { … }` (§21.3), a second `import:host` declaration, or `h` itself binding
    // it twice. "" when none does. §21.3.1.1: "A binding's local name SHALL NOT also be
    // declared in its file (`E-SCOPE-010`)" — the §41.7 later-import-WINS +
    // W-IMPORT-001 rule is for scrml imports; for a host binding it would let either
    // binding silently replace the other (hostImportBinding consults host imports
    // before file-scope imports, so the host one always won), so it is refused.
    fn hostImportClash(g: Globals, file: string, h: AImport, name: string) -> string {
        for (const f of g.files) {
            if (f.path == file) {
                for (const imp of importsOfItems(f.items)) {
                    for (const m of imp.names) {
                        if (m.name == name && m.orig != name) return "`import { " + m.orig + " as " + name + " } from \"" + imp.from + "\"`"   // s474: an alias
                        if (m.name == name) return "`import { " + name + " } from \"" + imp.from + "\"`"
                    }
                }
                for (const o of hostImportsOfItems(f.items)) {
                    let count = 0
                    for (const m of o.names) {
                        if (m.name == name) count = count + 1
                    }
                    if (o.nid != h.nid && count > 0) return "another `import:" + hostTagOf(o) + "` from `" + o.from + "`"
                    if (o.nid == h.nid && count > 1) return "this same `import:" + hostTagOf(o) + "` a second time"
                }
            }
        }
        return ""
    }

    // `name` is declared in `file` (a type, a function or a user declaration).
    fn hostNameCollides(g: Globals, file: string, name: string) -> boolean {
        for (const o of g.te.link.own) {
            if (o.file == file && o.name == name) return true
        }
        return false
    }

    // A `host` import's module (§21.3.1 — "a host-language module (TypeScript
    // or JavaScript)"), by the extension impl#1 admits.
    fn hostModuleSource(from: string) -> boolean {
        return from.endsWith(".js") || from.endsWith(".mjs") || from.endsWith(".ts") || from.endsWith(".mts")
    }

    fn filePaths(files: FileAst[]) -> string[] {
        let out: string[] = []
        for (const f of files) { out = out.concat([f.path]) }
        return out
    }

    // s473 (boot-failclosed-sql-protect) — §12.2 Trigger 3: "calling a binding
    // imported from any of [the server-only stdlib modules] escalates the function
    // that calls it". The bootstrap has NO such escalation: placePass places a
    // function on the server for a `?{}`, a foreign block or the `server`
    // modifier, never for what it imports. So the first server-only module that
    // compiled on the bootstrap would put its callers — and its Bun-only
    // implementation, and any secret they handle — on the CLIENT, the S299
    // founding defect. Until the escalation is built, importing one is REFUSED at
    // the import (in any file — a stdlib module reaching another one included).
    //
    // The set is §12.2's own evaluation of its normative criterion — "(a) its
    // implementation reaches a host API that does not exist in a browser —
    // `Bun.*`, `process.*`, or an import of `bun` / `bun:*` / `node:*` — or (b) it
    // accepts or transmits a credential" — as of S299: auth, crypto, cron, fs,
    // mcp, oauth, path, process, redis, store (a submodule — `scrml:auth/jwt` —
    // is the module's). Limb (b) cannot be read off source, so the list is the
    // authority here; slice-m4/server-only-stdlib-s473.test.js re-derives limb
    // (a) from the stdlib's sources on every run and FAILS when a module meets
    // it but is missing here (the SPEC: "a hand-maintained derived list rots
    // silently and nothing fails when it does").
    fn isServerOnlyStdlib(from: string) -> boolean {
        if (!from.startsWith("scrml:")) return false
        let m: string = from.substring(6)
        if (m.indexOf("/") >= 0) m = m.substring(0, m.indexOf("/"))
        if (m.endsWith(".scrml")) m = m.substring(0, m.length - 6)
        return ["auth", "crypto", "cron", "fs", "mcp", "oauth", "path", "process", "redis", "store"].indexOf(m) >= 0
    }

    fn serverOnlyWhy(from: string) -> string {
        return "`" + from + "` is a server-only stdlib module (§12.2 Trigger 3: its implementation reaches a host API no browser has, or it handles a credential). Calling one of its bindings SHALL place the calling function on the server, and the bootstrap does not build that escalation yet — the caller would run in the browser, with the module's implementation and whatever it is passed. Refused until it is built; keep this work in a program compiled by the main compiler"
    }

    type ImportRefusal:struct = { code: string, why: string }

    // Why an import that resolves to no file in the build is refused (§21.3,
    // §21.6, §41.4, §41.5, §41.17).
    fn importRefusal(from: string) -> ImportRefusal {
        if (from == "scrml:compiler" || from.startsWith("scrml:compiler/")) {
            return { code: "E-BOOTSTRAP-UNSUPPORTED", why: "`" + from + "` — the `scrml:compiler` family is KNOWN-DEFERRED (§41.17): its runtime surface is the live compiler, which the bootstrap does not expose; run the compiler as a command instead" }
        }
        if (from.startsWith("scrml:")) {
            return { code: "E-BOOTSTRAP-UNSUPPORTED", why: "`" + from + "` — the bootstrap cannot import this stdlib module: the build supplied no source for it that the bootstrap compiles, so none of its names are imported (§41.5)" }
        }
        if (from.startsWith("./") || from.startsWith("../")) {
            if (from.endsWith(".scrml")) {
                return { code: "E-IMPORT-006", why: "`" + from + "` does not resolve to a `.scrml` file in this build (§21.3)" }
            }
            return { code: "E-BOOTSTRAP-UNSUPPORTED", why: "`" + from + "` — the bootstrap imports `.scrml` modules and `scrml:` stdlib modules only; a JavaScript (or other non-`.scrml`) module import is not in the bootstrap" }
        }
        if (from.startsWith("vendor:") || from.startsWith("bun:") || from.startsWith("node:")) {
            return { code: "E-BOOTSTRAP-UNSUPPORTED", why: "`" + from + "` — a `vendor:` / `bun:` / `node:` import (§41.4) is not in the bootstrap" }
        }
        return { code: "E-IMPORT-005", why: "`" + from + "` is not a module scrml can import: a source begins with `./`, `../`, `scrml:`, `vendor:`, `bun:` or `node:` — a bare npm-style name is never valid (§41.4)" }
    }

    // `name` is an exported type / declaration / function of the file `path`.
    fn exportedBy(g: Globals, path: string, name: string) -> boolean {
        for (const t of g.types) {
            if (t.file == path && t.name == name && t.exported) return true
        }
        for (const d of g.decls) {
            const ad: ADecl | not = d.d
            if (ad is given) {
                if (d.file == path && ad.name == name && ad.exported) return true
            }
        }
        for (const f of g.fns) {
            if (f.info.file == path && f.info.name == name && f.info.exported) return true
        }
        for (const c of g.consts) {
            if (c.file == path && c.name == name && c.exported) return true
        }
        return false
    }

    // s471 — `name` is named by an import in `file` that analyze REFUSES (it
    // resolves to nothing, or its target does not export the name): that
    // import's own diagnostic owns the failure, so a use of the name is not
    // also "not declared" (no cascade). Only a refused import qualifies, so a
    // use is never left unreported.
    fn importRefusesName(g: Globals, file: string, name: string) -> boolean {
        const paths: string[] = filePaths(g.files)
        for (const f of g.files) {
            if (f.path == file) {
                // s472: a host binding is resolved by resolveHostBinding (before this is reached); a
                // name of a host import that never reaches it (a nested one) does not cascade either
                for (const h of hostImportsOfItems(f.items)) {
                    for (const hn of h.names) {
                        if (hn.name == name) return true
                    }
                }
                for (const imp of importsOfItems(f.items)) {
                    for (const n of imp.names) {
                        if (n.name == name) {
                            const target: string = importTarget(f.path, imp.from, paths)
                            if (target == "" || !exportedBy(g, target, n.orig)) return true   // s474 r1 F1: the EXPORTED name (an alias is the local one)
                        }
                    }
                }
            }
        }
        return false
    }
}
