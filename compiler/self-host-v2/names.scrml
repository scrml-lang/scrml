// =============================================================================
// self-host-v2 / names.scrml — the ONE NameSupply (dpa-051 §3.3).
//
// Emitted identifiers are MINTED, never rewritten: every Sym and every
// printer-made module-level name (factory, render, shared getter, declaration
// descriptor, edge table, the runtime import) is requested up front and gets a
// name from its hint plus a disambiguator on collision. There is no rename pass,
// so a helper cannot collide with a user name (the TS compiler's
// `g-user-fn-rename-rewrites-emitted-helper-locals` family).
//
// The one reserved sub-namespace: minted names NEVER contain `$` (a `$` in a
// hint becomes `_`). Printer-internal locals inside emitted function bodies
// (`inst$`, `scope$`, `n$0_2`, …) ALWAYS contain `$` and are derived from tree
// position, so they are collision-free by construction without threading a
// counter through the printer.
// =============================================================================
${
    // What a name is FOR. Keyed by Sym id / declaration Sym id.
    export type NameKey:enum = {
        OfSym(id: int),
        Factory(decl: int),
        Render(decl: int),
        SharedGet(decl: int),
        DeclInfo(decl: int),
        Edges(decl: int, field: int),
        Runtime,
    }

    // `names[i]` is the name minted for `keys[i]` (keyText), in minting order. s477
    // (s477-boot-compile-perf): two parallel tapes, searched by indexOf — a tape of
    // { key, name } entries was walked entry by entry on every mint and lookup.
    // `nexts[j]`: where mint resumes its candidate search for the hint `bases[j]` (see mint).
    // S480 (s480-boot-fn-count-perf): `kix` / `nix` / `bix` index `keys` / `names` / `bases`
    // (text → position) — an indexOf per mint, per candidate and per lookup made printing
    // O(names²). Each is a SIdx: sorted LEVELS whose sizes are distinct powers of two, the
    // smallest last (an add merges equal levels, as a binary counter carries), so an add
    // copies each entry O(log n) times and a lookup is a binary search per level.
    export type NameTable:struct = { keys: string[], names: string[], bases: string[], nexts: int[], kix: SIdx, nix: SIdx, bix: SIdx }

    // A set of distinct texts, each with a value (here: its position in a tape).
    type SIdx:struct = { ks: string[][], vs: int[][] }

    fn sixEmpty() -> SIdx { return { ks: [], vs: [] } }

    // `ix` with `k` (not present) → `v`.
    fn sixAdd(ix: SIdx, k: string, v: int) -> SIdx {
        let ck: string[] = [k]
        let cv: int[] = [v]
        let n: int = ix.ks.length
        while (n > 0 && ix.ks[n - 1].length == ck.length) {
            const m: SIdx = sixMerge(ix.ks[n - 1], ix.vs[n - 1], ck, cv)
            ck = m.ks[0]
            cv = m.vs[0]
            n = n - 1
        }
        return { ks: ix.ks.slice(0, n).concat([ck]), vs: ix.vs.slice(0, n).concat([cv]) }
    }

    // Two sorted levels merged into one (returned as the one level of an SIdx), into
    // fresh tapes written in place.
    fn sixMerge(ak: string[], av: int[], bk: string[], bv: int[]) -> SIdx {
        const n: int = ak.length + bk.length
        let mk: string[] = blanks(n)
        let mv: int[] = minusOnes(n)
        let i: int = 0
        let j: int = 0
        let o: int = 0
        while (o < n) {
            if (j >= bk.length || (i < ak.length && ak[i] < bk[j])) {
                mk[o] = ak[i]
                mv[o] = av[i]
                i = i + 1
            } else {
                mk[o] = bk[j]
                mv[o] = bv[j]
                j = j + 1
            }
            o = o + 1
        }
        return { ks: [mk], vs: [mv] }
    }

    // The value of `k` in `ix`, else -1.
    fn sixFind(ix: SIdx, k: string) -> int {
        let l: int = 0
        while (l < ix.ks.length) {
            const ks: string[] = ix.ks[l]
            let lo: int = 0
            let hi: int = ks.length
            while (lo < hi) {
                const mid: int = Math.floor((lo + hi) / 2)
                const x: string = ks[mid]
                if (x == k) return ix.vs[l][mid]
                if (x < k) {
                    lo = mid + 1
                } else {
                    hi = mid
                }
            }
            l = l + 1
        }
        return -1
    }

    // Fresh tapes of `n` entries (by doubling, not one concat per entry).
    fn blanks(n: int) -> string[] {
        if (n <= 0) return []
        let out: string[] = [""]
        while (out.length + out.length <= n) { out = out.concat(out) }
        return out.concat(blanks(n - out.length))
    }

    fn minusOnes(n: int) -> int[] {
        if (n <= 0) return []
        let out: int[] = [-1]
        while (out.length + out.length <= n) { out = out.concat(out) }
        return out.concat(minusOnes(n - out.length))
    }

    // A total, injective encoding of a key (compared as a string).
    export fn keyText(k: NameKey) -> string {
        return match k {
            .OfSym(id: id) :> "sym:" + id
            .Factory(decl: d) :> "mk:" + d
            .Render(decl: d) :> "render:" + d
            .SharedGet(decl: d) :> "shared:" + d
            .DeclInfo(decl: d) :> "decl:" + d
            .Edges(decl: d, field: f) :> "edges:" + d + "." + f
            .Runtime :> "rt"
        }
    }

    export fn emptyNames() -> NameTable { return { keys: [], names: [], bases: [], nexts: [], kix: sixEmpty(), nix: sixEmpty(), bix: sixEmpty() } }

    // JavaScript reserved words + the globals emitted code references.
    export fn isReserved(n: string) -> boolean {
        return match n {
            "break" :> true
            "case" :> true
            "catch" :> true
            "class" :> true
            "const" :> true
            "continue" :> true
            "debugger" :> true
            "default" :> true
            "delete" :> true
            "do" :> true
            "else" :> true
            "enum" :> true
            "export" :> true
            "extends" :> true
            "false" :> true
            "finally" :> true
            "for" :> true
            "function" :> true
            "if" :> true
            "import" :> true
            "in" :> true
            "instanceof" :> true
            "new" :> true
            "null" :> true
            "return" :> true
            "super" :> true
            "switch" :> true
            "this" :> true
            "throw" :> true
            "true" :> true
            "try" :> true
            "typeof" :> true
            "var" :> true
            "void" :> true
            "while" :> true
            "with" :> true
            "yield" :> true
            "let" :> true
            "static" :> true
            "await" :> true
            "async" :> true
            "arguments" :> true
            "eval" :> true
            "undefined" :> true
            "NaN" :> true
            "Infinity" :> true
            "document" :> true
            "window" :> true
            "globalThis" :> true
            "Object" :> true
            "Array" :> true
            "JSON" :> true
            "Math" :> true
            "String" :> true
            "Number" :> true
            "Date" :> true
            _ :> false
        }
    }

    fn sanitize(hint: string) -> string {
        // s474 r1 (review L3): `#` — a composed batch's hint (`book#batch`), which no identifier spells
        const s: string = hint.replaceAll("$", "_").replaceAll("#", "_")
        if (s.length == 0) return "x"
        const c: int = s.charCodeAt(0)
        if (c >= 48 && c <= 57) return "_" + s
        return s
    }

    fn taken(t: NameTable, n: string) -> boolean {
        return sixFind(t.nix, n) >= 0
    }

    fn hasKey(t: NameTable, k: string) -> boolean {
        return sixFind(t.kix, k) >= 0
    }

    // Mint a name for `key` from `hint` (idempotent per key): the first of `base`,
    // `base_1`, `base_2`, … that is neither reserved nor taken.
    // s477 (s477-boot-compile-perf): a table only grows, so every candidate a previous
    // mint of the same base passed over (or took) stays reserved or taken — the search
    // resumes where that one stopped (`nexts`) instead of re-testing them all (k mints of
    // one hint, e.g. a local name every function uses, were O(k²) candidates).
    export fn mint(t: NameTable, key: NameKey, hint: string) -> NameTable {
        const k: string = keyText(key)
        if (hasKey(t, k)) return t
        const base: string = sanitize(hint)
        const bi: int = sixFind(t.bix, base)
        let cand: string = base
        let n = 1
        if (bi >= 0) {
            n = t.nexts[bi]
            cand = base + "_" + n
            n = n + 1
        }
        while (isReserved(cand) || taken(t, cand)) {
            cand = base + "_" + n
            n = n + 1
        }
        const at: int = t.keys.length
        const kix: SIdx = sixAdd(t.kix, k, at)
        const nix: SIdx = sixAdd(t.nix, cand, at)
        if (bi >= 0) {
            return { keys: t.keys.concat([k]), names: t.names.concat([cand]), bases: t.bases,
                     nexts: t.nexts.slice(0, bi).concat([n]).concat(t.nexts.slice(bi + 1)), kix: kix, nix: nix, bix: t.bix }
        }
        return { keys: t.keys.concat([k]), names: t.names.concat([cand]), bases: t.bases.concat([base]), nexts: t.nexts.concat([n]),
                 kix: kix, nix: nix, bix: sixAdd(t.bix, base, t.bases.length) }
    }

    // The minted name for `key`. An unminted key is a printer bug; it prints as
    // a name that cannot be a minted one and will fail loudly when run.
    export fn nameOf(t: NameTable, key: NameKey) -> string {
        const k: string = keyText(key)
        const i: int = sixFind(t.kix, k)
        if (i >= 0) return t.names[i]
        return "unminted$" + k.replaceAll(":", "_").replaceAll(".", "_")
    }
}
