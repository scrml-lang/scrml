// §50 (S473 D10): the kept form as the WHOLE condition of an `if` / `else if`.
<program>
    function pick() -> int {
        let ok = false;
        let n = 0;
        if ((ok = 1 > 2)) {
            n = 1;
        } else if ((ok = 2 > 1)) {
            n = 2;
        }
        if (ok) { n = n * 10; }
        return n;
    }
    <main>
        <p id="o">${pick()}</p>
    </main>
</program>
