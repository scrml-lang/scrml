// §8.1.3 (S472 ruling item 5): a locked `<db>` cell is read-only on the client, even inside its block.
<program>
    <db src="./app.db">
        type Row:struct = { id: int, name: string }
        <rows:Row[free, append]=(?{`SELECT id, name FROM people`}.all() !{ _ :> [] })/>
        function more() {
            @rows = [...@rows, { id: 9, name: "Zed" }];
        }
        <button onclick=more()>"more"</button>
    </db>
    <main><p>${@rows.length}</p></main>
</program>
