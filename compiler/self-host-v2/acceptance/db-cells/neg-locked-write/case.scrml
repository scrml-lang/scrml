// §8.1.3 (S472 ruling item 5): a locked `<db>` cell is read-only on the client, even inside its block.
<program>
    <db src="./app.db">
        <n:int=(1)/>
        function bump() {
            @n = 2;
        }
        <button onclick=bump()>"bump"</button>
    </db>
    <main><p>${@n}</p></main>
</program>
