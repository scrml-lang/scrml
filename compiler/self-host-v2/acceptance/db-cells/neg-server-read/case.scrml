// §8.1.3 (S472 ruling item 4): server code never reads a `<db>` cell's client copy.
<program>
    <db src="./app.db">
        type Row:struct = { id: int, name: string }
        <rows:Row[]=(?{`SELECT id, name FROM people`}.all() !{ _ :> [] })/>
        function first() -> int {
            const r: Row = ?{`SELECT id, name FROM people WHERE id = ${@rows.length}`}.get() !{ _ :> { return 0; } };
            return r.id;
        }
    </db>
    <main><p>${@rows.length}</p></main>
</program>
