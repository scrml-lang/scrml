// §14.13.2: a slot of unresolved type is refused (fail closed).
// (s473: §48.8 infers `fn one() { return 1; }` as `int` now. s475 r1: a return that IS a recursive
// call contributes nothing (least fixpoint); a recursive call inside an expression stays unresolved.)
<program>
    fn one() { return down(1); }
    fn down(n: int) { if (n > 0) { return 1 + down(n - 1); } else { return 1; } }
    fn show() -> string {
        return `v=${one()}`;
    }
    <main>
        <p>${show()}</p>
    </main>
</program>
