// The assigned cell is never a dependency, even when the load reads it (§6.7.7 "`<request>` is not a loop").
<program>
    let <pageNo:int=1/>
    let <items:int=0/>
    fn load(p: int, prev: int) -> int { return prev + p; }
    <request id="items">${ @items = load(@pageNo, @items); }</request>
    <main>
        <button id="next" onclick={ @pageNo = @pageNo + 1; }>next</button>
        <p id="items">${@items}</p>
    </main>
</program>
