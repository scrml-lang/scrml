// The assigned cell is never a dependency, even when the load reads it (§6.7.7 "`<request>` is not a loop").
<program>
    let <page:int=1/>
    let <items:int=0/>
    let <runs:int=0/>
    fn load(p: int, prev: int) -> int { return prev + p; }
    <request id="items">${ @items = load(@page, @items); }</request>
    <main>
        <button id="next" onclick={ @page = @page + 1; }>next</button>
        <p id="items">${@items}</p>
    </main>
</program>
