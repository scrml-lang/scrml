// §66 twin of conformance/cases/lifecycle/request-refetch-inline-multi-stmt-rt.
// Reads `<#userReq>` (§6.7.7 Properties) — built by slice S3b (s475-boot-request-refs).
<program db="./app.db">
    type User:struct = { id: int, name: string }
    let <userId:int=1/>
    let <userName:string=""/>
    function loadName(id: int) -> string {
        const u: User = ?{`SELECT id, name FROM users WHERE id = ${id}`}.get() !{ _ :> { return "?"; } };
        return u.name;
    }
    <request id="userReq" deps=[]>${ @userName = loadName(@userId); }</request>
    <main>
        <button id="again" onclick={ @userId = 2; <#userReq>.refetch(); }>user 2</button>
        <p id="who">${@userName}</p>
    </main>
</program>
