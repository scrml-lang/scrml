// §66 twin of conformance/cases/lifecycle/request-data-is-some-value-bool-class-attr-rt.
// Reads `<#userReq>` (§6.7.7 Properties) — built by slice S3b (s475-boot-request-refs).
<program db="./app.db">
    type User:struct = { id: int, name: string }
    let <userName:string=""/>
    function loadName() -> string {
        const u: User = ?{`SELECT id, name FROM users LIMIT 1`}.get() !{ _ :> { return "?"; } };
        return u.name;
    }
    <request id="userReq">${ @userName = loadName(); }</request>
    <main>
        <button id="btn" disabled=(<#userReq>.data is given)>go</button>
        <div id="box" class=(<#userReq>.data is given ? "ready" : "wait")>box</div>
        <span id="nm">${@userName}</span>
    </main>
</program>
