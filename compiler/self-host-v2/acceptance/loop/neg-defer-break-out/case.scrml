// §19.16.3 rule 1: a deferred body cannot `break` out of itself — not even to the loop whose body holds the `defer`.
<program>

    function f() -> int {
        let s = 0;
        for (i of 0..3) {
            defer {
                if (i == 1) { break; }
            }
            s = s + 1;
        }
        return s;
    }
    <main>
        <p id="o">${f()}</p>
    </main>
</program>
