// §8.9.2 / §19.10.5 (S473 transitive query set; s474 U1e): a `!` function with two writes and a
// `fail` after them runs in ONE transaction — the `fail` rolls both writes back, success commits both.
<program db="./app.db">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost }
    type C:struct = { c: int }
    let <r:int=0/>
    let <n:int=0/>
    function move(a: int)! E {
        ?{`INSERT INTO log (a) VALUES (${a})`}.run();
        ?{`INSERT INTO log (a) VALUES (${a + 1})`}.run();
        if (a > 5) fail .Bad;
        return 1;
    }
    function count()! E {
        const row: C = ?{`SELECT count(*) AS c FROM log WHERE a > 0`}.get();
        return row.c;
    }
    <main>
        <button id="bad" onclick={ @r = move(6) !{ _ :> 9, }; }>bad</button>
        <button id="ok" onclick={ @r = move(1) !{ _ :> 9, }; }>ok</button>
        <button id="count" onclick={ @n = count() !{ _ :> 99, }; }>count</button>
        <p id="r">${@r}</p>
        <p id="n">${@n}</p>
    </main>
</program>
