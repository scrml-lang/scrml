// S473 D1: a client-placed `!` function whose one server call runs two queries in a function NOT
// declared `!` — the server runs them with no envelope, and no transaction spans the request.
<program db="./app.db">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost }
    let <r:int=0/>
    function both(a: int) -> int {
        ?{`INSERT INTO log (a) VALUES (${a})`}.run() !{ _ :> { return 0; } };
        ?{`INSERT INTO log (a) VALUES (${a})`}.run() !{ _ :> { return 0; } };
        return 1;
    }
    function move(a: int)! E {
        const y: int = both(a) !{ _ :> { return 0; } };
        if (y == 0) fail .Bad;
        return y;
    }
    <main><button onclick={ @r = move(1) !{ _ :> 0, }; }>go</button></main>
</program>
