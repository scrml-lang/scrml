// §19.10.6 Pooled drivers: a transaction runs on one connection reserved from the pool. The
// bootstrap's reserved-connection transaction is proven against Postgres only (s475), so an envelope
// on a MySQL database stays refused by name (S473 D1) — one query is enough to need it (§8.9.2
// "Amendment S474" item 1).
<program db="mysql://localhost/app">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost }
    let <r:int=0/>
    function move(a: int)! E {
        ?{`UPDATE acct SET n = n - ${a}`}.run();
        return 1;
    }
    <main><button onclick={ @r = move(1) !{ _ :> 0, }; }>go</button></main>
</program>
