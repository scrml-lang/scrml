// §8.9.2 (S451 ruling 4a) + §8.9.5 (s474 r1, review F1): `.nobatch()` opts a query out of the envelope's
// COUNT, not out of its reach — a `.nobatch()` write to another database inside it is still E-SQL-011.
<program db="./a.db">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost }
    <db src="./b.db">
        function logB(a: int) -> int {
            ?{`INSERT INTO blog (a) VALUES (${a})`}.nobatch().run() !{ _ :> { return 0; } };
            return 1;
        }
    </db>
    let <r:int=0/>
    function move(a: int)! E {
        ?{`UPDATE acct SET n = n - ${a}`}.run();
        ?{`UPDATE acct SET n = n + ${a}`}.run();
        const x: int = logB(a);
        return x;
    }
    <main><button onclick={ @r = move(1) !{ _ :> 0, }; }>go</button></main>
</program>
