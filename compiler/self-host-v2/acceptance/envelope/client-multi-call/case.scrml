// S474 ruling (the four one-way doors, door 2): a client-placed `!` function's server calls compose
// into ONE request with ONE envelope (§19.9.9.8 rule 1). book(1, 1): hold's INSERT, then charge's
// INSERT and `fail` — the whole batch rolls back and the caller's `.Bad` arm runs (r = 7). book(2, 0)
// commits both rows (r = 3; the write after the batch applies once it commits: status "booked").
// Count 2 (3 if hold's row had survived charge's failure, as it did when each call was a request).
<program db="./app.db">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost, Transport(t: ServerCallError) }
    type C:struct = { c: int }
    let <r:int=0/>
    let <n:int=0/>
    let <status:string="idle"/>
    function hold(a: int)! E {
        ?{`INSERT INTO log (a) VALUES (${a})`}.run();
        return 1;
    }
    function charge(a: int, f: int)! E {
        ?{`INSERT INTO log (a) VALUES (${a + 100})`}.run();
        if (f > 0) fail .Bad;
        return 2;
    }
    function book(a: int, f: int)! E {
        @status = "booking";
        hold(a)?;
        charge(a, f)?;
        @status = "booked";
        return 3;
    }
    function count()! E {
        const row: C = ?{`SELECT count(*) AS c FROM log WHERE a > 0`}.get();
        return row.c;
    }
    <main>
        <button id="bad" onclick={ @r = book(1, 1) !{ .Bad :> 7, _ :> 9, }; }>bad</button>
        <button id="ok" onclick={ @r = book(2, 0) !{ .Bad :> 7, _ :> 9, }; }>ok</button>
        <button id="count" onclick={ @n = count() !{ _ :> 99, }; }>count</button>
        <p id="r">${@r}</p>
        <p id="n">${@n}</p>
        <p id="s">${@status}</p>
    </main>
</program>
