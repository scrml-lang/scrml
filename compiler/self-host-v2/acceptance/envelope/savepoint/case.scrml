// §8.9.2 amendment F10 + §19.10.6 Nesting (S473 #1690 review): an inner `!` called inside an outer
// envelope runs as a nested SAVEPOINT. The outer `fail`ing after the inner succeeded rolls the
// inner's writes back too; the outer HANDLING the inner's failure undoes only the inner's writes.
<program db="./app.db">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost }
    type C:struct = { c: int }
    let <r:int=0/>
    let <n:int=0/>
    function inner(a: int)! E {
        ?{`INSERT INTO log (a) VALUES (${a})`}.run();
        ?{`INSERT INTO log (a) VALUES (${a + 100})`}.run();
        if (a == 7) fail .Bad;
        return 1;
    }
    function outerFails(a: int)! E {
        ?{`INSERT INTO log (a) VALUES (${a})`}.run();
        const y: int = inner(a)?;
        if (y > 0) fail .Bad;
        return y;
    }
    function outerHandles(a: int)! E {
        ?{`INSERT INTO log (a) VALUES (${a})`}.run();
        const y: int = inner(7) !{ _ :> 0 };
        ?{`INSERT INTO log (a) VALUES (${a + 1})`}.run();
        return y;
    }
    function count()! E {
        const row: C = ?{`SELECT count(*) AS c FROM log WHERE a > 0`}.get();
        return row.c;
    }
    <main>
        <button id="fails" onclick={ @r = outerFails(1) !{ _ :> 9, }; }>fails</button>
        <button id="handles" onclick={ @r = outerHandles(1) !{ _ :> 9, }; }>handles</button>
        <button id="count" onclick={ @n = count() !{ _ :> 99, }; }>count</button>
        <p id="r">${@r}</p>
        <p id="n">${@n}</p>
    </main>
</program>
