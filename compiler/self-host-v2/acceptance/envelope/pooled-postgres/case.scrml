// §19.10.6 Pooled drivers: a transaction runs on one connection reserved from the pool. s475: the
// bootstrap's server runtime reserves one (Bun.SQL `reserve()`), so an envelope on a Postgres
// database compiles (it was refused, S473 D1, before s475). Its runtime behaviour is measured against
// a live Postgres in slice-m4/pg-envelope-s475.test.js.
<program db="postgres://localhost/app">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost }
    let <r:int=0/>
    function move(a: int)! E {
        ?{`UPDATE acct SET n = n - ${a}`}.run();
        ?{`UPDATE acct SET n = n + ${a}`}.run();
        return 1;
    }
    <main><button onclick={ @r = move(1) !{ _ :> 0, }; }>go</button></main>
</program>
