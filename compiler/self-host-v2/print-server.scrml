// =============================================================================
// self-host-v2 / print-server.scrml — the SERVER artifact printer (unit U1c).
//
// Design authority: scrml-support/docs/deep-dives/bootstrap-u1-server-boundary-
// design-2026-10-03.md §4 ("Server artifact = a factory, not a module with
// globals"), §2 ("Trigger 5 is emission, not inference"), §5 ("Lower (U1c)")
// and the BINDING §13 amendment (S467) "U1c gate: the server half awaits by
// construction". The wire contract is the U1b design's Item 3; its client half
// is print.scrml's `route$<fn>` constants + runtime.js `call`.
//
// What it prints, from Core and nothing else:
//
//   import * as rt from "./scrml-server-runtime.js";
//   export const manifest = { routes: [ { fn, path, value }, … ] };
//   const route$f = { path, params, result, error };   // print.scrml routeJs — the SAME tables the client uses
//   const sql$12 = rt.sqlText(["SELECT … WHERE id = ", ""]);   // a query site's literal runs, frozen at load
//   export function createServer(host$) {
//     const db$7 = rt.connection(host$, { driver, target, file });   // one per database, injected by the host
//     async function f(…) { … const o = await rt.query(db$7, "get", sql$12, [v0], [0]); … }
//     function helper(…) { … }
//     return rt.server(host$, [ rt.route(route$f, (args$) => f(args$[0], …)) ], [ db$7 ]);
//   }
//
// - ROUTED IFF REACHED FROM A CLIENT ROOT (design §4): one route per server
//   function a ServerCall names — the client artifact's own manifest
//   (print.scrml `calledServerFns`); the path is minted from the Sym, never the
//   name (§12.3).
// - TRIGGER 5 IS EMISSION (design §2): the artifact holds the transitive
//   closure, over Core Call Syms, of every routed server function — the server
//   functions it calls in place (§13.4: no extra route), the server-only
//   helpers (Trigger 5) and the ambient functions it reaches. An ambient
//   function the client also calls is printed in BOTH artifacts (§13.4 "TWO
//   representations"); one only the server reaches is in this one only.
// - THE §13 GATE: this printer decides nothing about waiting. A function is
//   `async` iff Core says it waits (Fn.waits / ServerFn.waits — check.scrml
//   C-S8 / C-S8s: the body holds a Suspend), and `await` is printed at a
//   Suspend and NOWHERE ELSE (print.scrml server mode). A call of a waiting
//   function stands only as a Suspend's `on` (C-S8 / C-S8s), so a waiting call
//   left unawaited is not a program this printer can be handed by a checked Core.
// - Nothing client-side is here: no cell, no view, no handler. check.scrml
//   C-S1 keeps every server-reached body free of client state; a ServerCall
//   reaching this printer (only a Core that checkCore rejects holds one there)
//   is REFUSED, never printed.
//
// impl#1 workaround: F11 — every `match` on a payload variant uses NAMED
// binding (positional binding over an imported enum is silently dropped).
// =============================================================================
${
    import { Sym, Expr, Stmt, Failable, Fn, HostFn, ServerFn, CoreProgram, Db, Driver, SqlQuery, Param, Block, ForeignSlice, CoreTool,
             findFn, findServerFn, findDb } from "./core.scrml"
    import { Node, allNodes } from "./walk.scrml"
    import { JsExpr, JsStmt, JsProp, jid, jstr, jnum, jcall, jmember, jmcall, sexpr, printModule } from "./js.scrml"
    import { RouteOut, Ctx, coreRefusal, sliceName, serverCtx, serverFnJs, envelopedFnJs, symNameOf, routeJs, routeName, routePath, calledServerFns,
             sqlTextName, dbVarName, hostImports, hostFnJs, constsReadIn, constStmts } from "./print.scrml"

    export type ServerOutput:struct = { js: string, refused: string[], routes: RouteOut[] }

    // The server artifact of `p`. `js` is "" when the program routes nothing (it
    // has no server half to serve); `refused` names anything this printer will
    // not print (fail closed — nothing is printed then).
    export fn printServer(p: CoreProgram, jsFile: string, runtimeFile: string) -> ServerOutput {
        // s468 fix round 1 (F3): the gate at emission — a Core checkCore rejects is never printed
        const ill: string[] = coreRefusal(p)
        if (ill.length > 0) return { js: "", refused: ill, routes: [] }
        const refused: string[] = serverPrintRefusal(p)
        if (refused.length > 0) return { js: "", refused: refused, routes: [] }
        const routed: ServerFn[] = calledServerFns(p)
        if (routed.length == 0) return { js: "", refused: [], routes: [] }
        const ctx: Ctx = serverCtx(p)
        const reach: int[] = serverReach(p, routed)

        // s472 (boot-math-port): the host modules the reached functions call (§21.3.1 —
        // imported from `./_scrml/<module>/<file>`, the same copy the client artifact imports)
        let reachedFns: Fn[] = []
        for (const rf of p.fns) {
            if (reach.indexOf(rf.sym.id) >= 0) reachedFns = reachedFns.concat([rf])
        }
        let body: JsStmt[] = [
            JsStmt.SComment(jsFile + " — generated by the scrml bootstrap printer (self-host-v2, unit U1c). Do not edit."),
            JsStmt.SImportAll("rt", "./" + runtimeFile),
        ]
        body = body.concat(hostImports(p, reachedFns)).concat([JsStmt.SBlank])
        // the manifest — the routes, by the scrml-source function name (the harness and
        // the client's own `Output.routes` key on it; the path is compiler-internal)
        let routes: RouteOut[] = []
        let manifest: JsExpr[] = []
        for (const sf of routed) {
            const r: RouteOut = { fn: sf.sym.hint, path: routePath(sf.sym), value: sf.ret is given }
            routes = routes.concat([r])
            manifest = manifest.concat([JsExpr.JObject([
                { key: "fn", value: jstr(r.fn) }, { key: "path", value: jstr(r.path) }, { key: "value", value: JsExpr.JBool(r.value) },
            ])])
        }
        body = body.concat([
            JsStmt.SComment("the routes this server answers — one per server function the client calls (paths are compiler-internal, §12.3)"),
            JsStmt.SExportConst("manifest", JsExpr.JObject([{ key: "routes", value: JsExpr.JArray(manifest) }])),
            JsStmt.SBlank,
            JsStmt.SComment("each route's wire contract — the same §57 tables the client artifact encodes and decodes with"),
        ])
        for (const sf of routed) { body = body.concat([routeJs(p, sf)]) }

        // s472: the constants the SERVER's code reads (the functions it reaches), once each
        let roots: Node[] = []
        for (const sf2 of p.server) { if (reach.indexOf(sf2.sym.id) >= 0) roots = roots.concat([Node.NServerFn(sf2)]) }
        for (const f2 of p.fns) { if (reach.indexOf(f2.sym.id) >= 0) roots = roots.concat([Node.NFn(f2)]) }
        body = body.concat(constStmts(ctx, constsReadIn(p, roots)))

        // the SQL text of every query site the server reaches, frozen once at load (§8.1:
        // a query's text is the literal runs only; every value is a bound parameter)
        const queries: SqlQuery[] = queriesIn(p, reach)
        if (queries.length > 0) body = body.concat([JsStmt.SBlank, JsStmt.SComment("query text (literal runs only — every value is a bound parameter, §8.1)")])
        for (const q of queries) {
            let runs: JsExpr[] = []
            for (const c of q.chunks) { runs = runs.concat([jstr(c)]) }
            body = body.concat([JsStmt.SConst(sqlTextName(q.site.n), jcall(jmember(jid("rt"), "sqlText"), [JsExpr.JArray(runs)]))])
        }

        // createServer(host$): the databases, the functions, the routes
        let inner: JsStmt[] = []
        let conns: JsExpr[] = []
        const envRefused: string[] = envelopeRefusal(p, reach, dbsOf(p, queries))
        if (envRefused.length > 0) return { js: "", refused: envRefused, routes: [] }
        for (const d of dbsOf(p, queries)) {
            inner = inner.concat([JsStmt.SConst(dbVarName(d.sym), jcall(jmember(jid("rt"), "connection"), [jid("host$"), dbJs(d)]))])
            conns = conns.concat([jid(dbVarName(d.sym))])
        }
        for (const sf of p.server) {
            if (reach.indexOf(sf.sym.id) >= 0) inner = inner.concat([bodyFnJs(ctx, p, sf.sym, sf.params, sf.body, sf.waits)])
        }
        for (const f of p.fns) {
            if (reach.indexOf(f.sym.id) >= 0) inner = inner.concat([serverFnOf(ctx, p, f)])
        }
        let routeExprs: JsExpr[] = []
        for (const sf of routed) { routeExprs = routeExprs.concat([routeEntry(ctx, sf)]) }
        // s473: the databases go to the server too — it checks each for an undeclared tenant
        // relation before it serves (SPEC §14.8.10 item (3); server-runtime.js tenantGate)
        inner = inner.concat([JsStmt.SReturn(jcall(jmember(jid("rt"), "server"), [jid("host$"), JsExpr.JArray(routeExprs), JsExpr.JArray(conns)]))])
        body = body.concat([
            JsStmt.SBlank,
            JsStmt.SComment("createServer(host$) — host$.connect(desc) supplies each database's driver (Bun.SQL by default); host$.log the server log; host$.dev true only in a dev build (a failed query's driver text is then kept in a failure answer — S474 ruling 2)"),
            JsStmt.SExportFunc("createServer", ["host$"], inner),
        ])
        return { js: printModule(body), refused: [], routes: routes }
    }

    // =========================================================================
    // s477 — THE TOOL ARTIFACT (SPEC §64, `<program kind="tool">`).
    //
    // §64.1: "A `kind="tool"` top-level program emits a plain ES module: NO html,
    // NO client.js bundle, NO CSRF scaffold. The module contains the file's logic
    // (fn/const/type declarations), its `_{}` foreign blocks (via `lang=`), its
    // `?{}` db calls (via `db=` + §44), and the `main()` invocation harness
    // (§64.3). It is runnable directly (`bun <emitted>.js <args…>`)." What it
    // prints, from Core and the driver's sealed slices:
    //
    //   import * as rt from "./scrml-server-runtime.js";
    //   const host$ = { root: "<the build's source root>" };          // only with a database
    //   const sql$12 = rt.sqlText([…]);                               // a query site's text
    //   const slice$9 = rt.foreignSeal("app.scrml:7:9", `async function (g) {…}`, import.meta);
    //   const db$7 = rt.connection(host$, { driver, target, file });
    //   async function main(args) { … await slice$9(g) … }             // server mode: `await` at each Suspend
    //   const exitCode$ = await main(globalThis.process.argv.slice(2)); // §64.3, `-> number`
    //   globalThis.process.exit(exitCode$);
    //
    // Every `function` of a tool is server-placed (analyze.scrml FnFacts.tool: the
    // tool "is an in-process monolith with no client boundary", §64.5.1), so the
    // module holds `main` and everything it reaches (serverReach), printed exactly as
    // the server artifact prints them — no routes, no `createServer`, no client.
    // A foreign slice's text is OPAQUE to the compiler (§23.2.3): the driver reads its
    // shape and builds the sealed function's source (slice-m1/tool-slices.js, on
    // impl#1's parser-token scan — the proven path), and hands it in as `sealed`.
    // =========================================================================
    export type ToolSlice:struct = { n: int, file: string, at: int, params: string[], body: string }
    export type SealedSlice:struct = { n: int, label: string, source: string }
    export type ToolOutput:struct = { js: string, refused: string[] }

    // The foreign slices of EVERY function of the tool program, each once — the driver checks
    // them all (E-FOREIGN-006 / E-FOREIGN-007 are compile errors at the slice, §23.2.4a / §23.2.6,
    // whether or not `main` reaches its function; s477 r1, review F3), and printTool prints only
    // the ones `main` reaches (it looks each up by site in `sealed`).
    export fn toolSlices(p: CoreProgram) -> ToolSlice[] {
        const tl: CoreTool | not = p.tool
        if (tl is not) return []
        let every: int[] = []
        for (const sf of p.server) { every = every.concat([sf.sym.id]) }
        for (const f of p.fns) { every = every.concat([f.sym.id]) }
        return slicesIn(p, every)
    }

    export fn printTool(p: CoreProgram, jsFile: string, runtimeFile: string, root: string, sealed: SealedSlice[]) -> ToolOutput {
        const ill: string[] = coreRefusal(p)
        if (ill.length > 0) return { js: "", refused: ill }
        const tl: CoreTool | not = p.tool
        if (tl is not) return { js: "", refused: ["E-BOOTSTRAP-UNSUPPORTED: printTool was handed a program that is not a tool (no CoreProgram.tool) — a driver defect"] }
        const mf: ServerFn | not = findServerFn(p, tl.main)
        if (mf is not) return { js: "", refused: ["E-BOOTSTRAP-UNSUPPORTED: the tool's `main` is not a server-placed function — the Core is ill-formed (every `function` of a tool runs in process, §64.5.1)"] }
        const refused: string[] = serverPrintRefusal(p)
        if (refused.length > 0) return { js: "", refused: refused }
        const ctx: Ctx = serverCtx(p)
        const reach: int[] = serverReach(p, [mf])
        let reachedFns: Fn[] = []
        for (const rf of p.fns) {
            if (reach.indexOf(rf.sym.id) >= 0) reachedFns = reachedFns.concat([rf])
        }
        let body: JsStmt[] = [
            JsStmt.SComment(jsFile + " — generated by the scrml bootstrap printer (self-host-v2, s477) — a tool module, SPEC §64. Do not edit."),
            JsStmt.SComment("Run it: bun " + jsFile + " <args…>"),
            JsStmt.SImportAll("rt", "./" + runtimeFile),
        ]
        body = body.concat(hostImports(p, reachedFns))

        // the constants the reached functions read
        let roots: Node[] = []
        for (const sf2 of p.server) { if (reach.indexOf(sf2.sym.id) >= 0) roots = roots.concat([Node.NServerFn(sf2)]) }
        for (const f2 of p.fns) { if (reach.indexOf(f2.sym.id) >= 0) roots = roots.concat([Node.NFn(f2)]) }
        body = body.concat(constStmts(ctx, constsReadIn(p, roots)))

        // the queries' text, frozen once at load (§8.1)
        const queries: SqlQuery[] = queriesIn(p, reach)
        if (queries.length > 0) body = body.concat([JsStmt.SBlank, JsStmt.SComment("query text (literal runs only — every value is a bound parameter, §8.1)")])
        for (const q of queries) {
            let runs: JsExpr[] = []
            for (const c of q.chunks) { runs = runs.concat([jstr(c)]) }
            body = body.concat([JsStmt.SConst(sqlTextName(q.site.n), jcall(jmember(jid("rt"), "sqlText"), [JsExpr.JArray(runs)]))])
        }

        // the foreign slices, each built ONCE, sealed (§23.2.4a)
        const slices: ToolSlice[] = slicesIn(p, reach)
        if (slices.length > 0) body = body.concat([JsStmt.SBlank, JsStmt.SComment("foreign slices (§23.2.4a) — each built once, in a sealed scope: it sees its in:{} crossings (its parameters), host globals and this module's require / __dirname / __filename, and no scrml binding")])
        for (const sl of slices) {
            const ss: SealedSlice | not = sealedOf(sealed, sl.n)
            if (ss is not) return { js: "", refused: ["E-BOOTSTRAP-UNSUPPORTED: the foreign slice at " + sl.file + " (offset " + sl.at + ") reached the printer without its sealed source — the driver prepares every slice (slice-m1/tool-slices.js); a driver defect"] }
            body = body.concat([JsStmt.SConst(sliceName(sl.n), jcall(jmember(jid("rt"), "foreignSeal"), [jstr(ss.label), JsExpr.JText(ss.source), jmember(jid("import"), "meta")]))])
        }

        // the databases (§8.1.1 / §44.2) — a SQLite path resolves against the build's source
        // root, which is where the compile-time schema read found it (§47.14, SCRML_DATA_DIR: gap)
        const conns: Db[] = dbsOf(p, queries)
        const envRefused: string[] = envelopeRefusal(p, reach, conns)
        if (envRefused.length > 0) return { js: "", refused: envRefused }
        if (conns.length > 0) {
            body = body.concat([JsStmt.SBlank, JsStmt.SComment("the databases — a relative SQLite path resolves against the directory the program was compiled from (§8.1.1)"),
                                JsStmt.SConst("host$", JsExpr.JObject([{ key: "root", value: jstr(root) }]))])
        }
        for (const d of conns) {
            body = body.concat([JsStmt.SConst(dbVarName(d.sym), jcall(jmember(jid("rt"), "connection"), [jid("host$"), dbJs(d)]))])
        }

        // the functions
        body = body.concat([JsStmt.SBlank, JsStmt.SComment("functions")])
        for (const sf of p.server) {
            if (reach.indexOf(sf.sym.id) >= 0) body = body.concat([bodyFnJs(ctx, p, sf.sym, sf.params, sf.body, sf.waits)])
        }
        for (const f of p.fns) {
            if (reach.indexOf(f.sym.id) >= 0) body = body.concat([serverFnOf(ctx, p, f)])
        }

        // §64.3 the harness: "The emitted harness invokes `main(process.argv.slice(2))`.
        // The RETURN-TYPE of `main` selects the harness arm" — `-> number`: the exit-harness;
        // no return type: invoke-only ("The harness does NOT call `process.exit`"). "Both
        // arms `await main(...)`". `globalThis.process`: no scrml binding can shadow it.
        let argv: JsExpr[] = []
        if (tl.argv) argv = [jmcall(jmember(jmember(jid("globalThis"), "process"), "argv"), "slice", [jnum(2)])]
        const run: JsExpr = JsExpr.JAwait(jcall(jid(symNameOf(ctx, tl.main)), argv))
        body = body.concat([JsStmt.SBlank])
        if (tl.exits) {
            body = body.concat([
                JsStmt.SComment("main() harness (§64.3) — `main` returns a number: it is the process exit code"),
                JsStmt.SConst("exitCode$", run),
                sexpr(jmcall(jmember(jid("globalThis"), "process"), "exit", [jid("exitCode$")])),
            ])
        } else {
            body = body.concat([
                JsStmt.SComment("main() harness (§64.3) — `main` returns nothing: invoke it, then the host's event loop decides when the process ends"),
                sexpr(run),
            ])
        }
        return { js: printModule(body), refused: [] }
    }

    fn sealedOf(ss: SealedSlice[], n: int) -> SealedSlice | not {
        for (const s of ss) {
            if (s.n == n) return s
        }
        return not
    }

    // Every foreign slice the reached functions hold, in program order, each site once.
    fn slicesIn(p: CoreProgram, reach: int[]) -> ToolSlice[] {
        let roots: Node[] = []
        for (const sf of p.server) { if (reach.indexOf(sf.sym.id) >= 0) roots = roots.concat([Node.NServerFn(sf)]) }
        for (const f of p.fns) { if (reach.indexOf(f.sym.id) >= 0) roots = roots.concat([Node.NFn(f)]) }
        let out: ToolSlice[] = []
        let seen: int[] = []
        for (const r of roots) {
            for (const n of allNodes(r)) {
                const fs: ForeignSlice | not = nodeSlice(n)
                if (fs is given) {
                    if (seen.indexOf(fs.site.n) < 0) {
                        seen = seen.concat([fs.site.n])
                        out = out.concat([{ n: fs.site.n, file: fs.file, at: fs.at, params: fs.params, body: fs.body }])
                    }
                }
            }
        }
        return out
    }

    fn nodeSlice(n: Node) -> ForeignSlice | not {
        return match n {
            .NExpr(e: e) :> exprSlice(e)
            .NStmt(s: x) :> not
            .NProgram(p: x) :> not
            .NDecl(d: x) :> not
            .NField(f: x) :> not
            .NFn(f: x) :> not
            .NServerFn(f: x) :> not
            .NBlock(b: x) :> not
            .NPlace(pl: x) :> not
            .NInst(i: x) :> not
            .NPattern(pat: x) :> not
            .NEdit(k: x) :> not
            .NView(v: x) :> not
            .NAttr(a: x) :> not
        }
    }

    fn exprSlice(e: Expr) -> ForeignSlice | not {
        return match e {
            .Foreign(slice: fs) :> fs
            .Query(q: x) :> not
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .VariantOf(enumSym: x) :> not
            .Handle(inst: x) :> not
            .Assigned(local: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Refetch(req: rf0) :> not
            .Validity(of: x) :> not
            .ServerCall(fn: x) :> not
        }
    }

    // A reached Fn: a host-backed one is its signature around the decoded host call (print.scrml hostFnJs).
    fn serverFnOf(ctx: Ctx, p: CoreProgram, f: Fn) -> JsStmt {
        const h: HostFn | not = f.host
        if (h is given) return hostFnJs(ctx, f, h)
        return bodyFnJs(ctx, p, f.sym, f.params, f.body, f.waits)
    }

    // s474 (U1e): a function with an Envelope runs its body inside it (print.scrml envelopedFnJs).
    fn bodyFnJs(ctx: Ctx, p: CoreProgram, sym: Sym, params: Param[], body: Block, waits: boolean) -> JsStmt {
        for (const e of p.envelopes) {
            if (e.fn.id == sym.id) return envelopedFnJs(ctx, sym, params, body, e.db, e.standalone, e.writes)
        }
        return serverFnJs(ctx, sym, params, body, waits)
    }

    // s474 (U1e) — fail closed on its own (check.scrml C-TX1..C-TX3 are the Core's
    // invariants): an envelope this artifact prints must name a function that waits
    // and a SQLite or (s475) Postgres database this artifact connects to.
    fn envelopeRefusal(p: CoreProgram, reach: int[], conns: Db[]) -> string[] {
        let out: string[] = []
        for (const e of p.envelopes) {
            if (reach.indexOf(e.fn.id) >= 0) {
                let waits = false
                for (const sf of p.server) { if (sf.sym.id == e.fn.id) waits = sf.waits }
                for (const f of p.fns) { if (f.sym.id == e.fn.id) waits = f.waits }
                let db: Db | not = not
                for (const d of conns) { if (d.sym.id == e.db.id) db = d }
                if (!waits) out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + e.fn.hint + "() has a transaction envelope but does not wait — the Core is ill-formed (check.scrml C-TX2)"])
                if (db is not) {
                    out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + e.fn.hint + "()'s transaction envelope is on a database none of the server's queries use — the Core is ill-formed (check.scrml C-TX1)"])
                } else if (e.standalone && db.driver == Driver.Mysql) {
                    out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: " + e.fn.hint + "()'s transaction envelope is on a MySQL database — the server runtime's reserved-connection transaction is proven on Postgres only (check.scrml C-TX3)"])
                }
            }
        }
        return out
    }

    // `rt.route(route$f, (args$) => f(args$[0], args$[1]))` — the arguments arrive
    // decoded (strictly, against route$f.params) in parameter order.
    fn routeEntry(ctx: Ctx, sf: ServerFn) -> JsExpr {
        let args: JsExpr[] = []
        let i: int = 0
        for (const prm of sf.params) {
            args = args.concat([JsExpr.JIndex(jid("args$"), jnum(i))])
            i = i + 1
        }
        const call: JsExpr = jcall(jid(symNameOf(ctx, sf.sym)), args)
        return jcall(jmember(jid("rt"), "route"), [jid(routeName(ctx.p, sf.sym)), JsExpr.JArrowE(["args$"], call)])
    }

    // `{ driver: "sqlite", target: "./app.db", file: "app.scrml" }` — §8.1.1 / §44.2.
    fn dbJs(d: Db) -> JsExpr {
        return JsExpr.JObject([
            { key: "driver", value: jstr(driverName(d.driver)) },
            { key: "target", value: jstr(d.target) },
            { key: "file", value: jstr(d.file) },
        ])
    }

    fn driverName(d: Driver) -> string {
        return match d {
            .Sqlite :> "sqlite"
            .Postgres :> "postgres"
            .Mysql :> "mysql"
        }
    }

    // ---- reach: the functions the server artifact holds ------------------------
    // The routed server functions and everything they call, transitively (Fns and
    // ServerFns by Sym — a Call's callee, an Attempt's FCall).
    fn serverReach(p: CoreProgram, routed: ServerFn[]) -> int[] {
        let out: int[] = []
        let todo: int[] = []
        for (const sf of routed) {
            out = out.concat([sf.sym.id])
            todo = todo.concat([sf.sym.id])
        }
        while (todo.length > 0) {
            const id: int = todo[0]
            todo = todo.slice(1)
            for (const c of calleesOf(p, id)) {
                if (out.indexOf(c) < 0) {
                    out = out.concat([c])
                    todo = todo.concat([c])
                }
            }
        }
        return out
    }

    fn calleesOf(p: CoreProgram, id: int) -> int[] {
        let ns: Node[] = []
        for (const sf of p.server) { if (sf.sym.id == id) ns = allNodes(Node.NServerFn(sf)) }
        for (const f of p.fns) { if (f.sym.id == id) ns = allNodes(Node.NFn(f)) }
        let out: int[] = []
        for (const n of ns) {
            const c: Sym | not = nodeCallee(n)
            if (c is given) {
                if (findFn(p, c) is given || findServerFn(p, c) is given) out = out.concat([c.id])
            }
        }
        return out
    }

    fn nodeCallee(n: Node) -> Sym | not {
        return match n {
            .NExpr(e: e) :> exprCallee(e)
            .NStmt(s: s) :> stmtCallee(s)
            .NProgram(p: x) :> not
            .NDecl(d: x) :> not
            .NField(f: x) :> not
            .NFn(f: x) :> not
            .NServerFn(f: x) :> not
            .NBlock(b: x) :> not
            .NPlace(pl: x) :> not
            .NInst(i: x) :> not
            .NPattern(pat: x) :> not
            .NEdit(k: x) :> not
            .NView(v: x) :> not
            .NAttr(a: x) :> not
        }
    }

    fn exprCallee(e: Expr) -> Sym | not {
        return match e {
            .Call(callee: f) :> f
            .ServerCall(fn: x) :> not
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .VariantOf(enumSym: x) :> not
            .Handle(inst: x) :> not
            .Assigned(local: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Refetch(req: rf0) :> not
            .Validity(of: x) :> not
            .Query(q: x) :> not
            .Foreign(slice: fsl0) :> not
        }
    }

    fn stmtCallee(s: Stmt) -> Sym | not {
        return match s {
            .Attempt(call: c) :> failableCallee(c)
            .Let(sym: x) :> not
            .Assign(local: x) :> not
            .Write(cap: x) :> not
            .Commit(writes: x) :> not
            .If(cond: x) :> not
            .Return(e: x) :> not
            .Eval(e: x) :> not
            .Suspend(bind: x) :> not
            .ResetSurface(of: x) :> not
            .Defer(body: x) :> not
            .Unpersist(decl: x) :> not
            .Fail(err: x) :> not
            .Join(k: x) :> not
            .Jump(k: x) :> not
            .Loop(label: x) :> not
            .Break(target: x) :> not
            .Continue(target: x) :> not
            .Gather(g: x) :> not
            .Lift(into: x) :> not
            .LocalFn(f: x) :> not
        }
    }

    fn failableCallee(c: Failable) -> Sym | not {
        return match c {
            .FCall(fn: f) :> f
            .FSettled(outcome: x) :> not
        }
    }

    // ---- queries and databases -------------------------------------------------
    // Every query the reached functions hold, in program order, each site once.
    fn queriesIn(p: CoreProgram, reach: int[]) -> SqlQuery[] {
        let roots: Node[] = []
        for (const sf of p.server) { if (reach.indexOf(sf.sym.id) >= 0) roots = roots.concat([Node.NServerFn(sf)]) }
        for (const f of p.fns) { if (reach.indexOf(f.sym.id) >= 0) roots = roots.concat([Node.NFn(f)]) }
        let out: SqlQuery[] = []
        let seen: int[] = []
        for (const r of roots) {
            for (const n of allNodes(r)) {
                const q: SqlQuery | not = nodeQuery(n)
                if (q is given) {
                    if (seen.indexOf(q.site.n) < 0) {
                        seen = seen.concat([q.site.n])
                        out = out.concat([q])
                    }
                }
            }
        }
        return out
    }

    fn nodeQuery(n: Node) -> SqlQuery | not {
        return match n {
            .NExpr(e: e) :> exprQuery(e)
            .NStmt(s: x) :> not
            .NProgram(p: x) :> not
            .NDecl(d: x) :> not
            .NField(f: x) :> not
            .NFn(f: x) :> not
            .NServerFn(f: x) :> not
            .NBlock(b: x) :> not
            .NPlace(pl: x) :> not
            .NInst(i: x) :> not
            .NPattern(pat: x) :> not
            .NEdit(k: x) :> not
            .NView(v: x) :> not
            .NAttr(a: x) :> not
        }
    }

    fn exprQuery(e: Expr) -> SqlQuery | not {
        return match e {
            .Query(q: q) :> q
            .Foreign(slice: fsl0) :> not
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .VariantOf(enumSym: x) :> not
            .Handle(inst: x) :> not
            .Assigned(local: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Refetch(req: rf0) :> not
            .Validity(of: x) :> not
            .ServerCall(fn: x) :> not
        }
    }

    // The databases those queries run on, in program order (C-SQL1: every query's
    // `db` is one of the program's).
    fn dbsOf(p: CoreProgram, qs: SqlQuery[]) -> Db[] {
        let out: Db[] = []
        for (const d of p.dbs) {
            let used = false
            for (const q of qs) { if (q.db.id == d.sym.id) used = true }
            if (used) out = out.concat([d])
        }
        return out
    }

    // ---- fail closed -----------------------------------------------------------
    // A client call of a server function inside a server-placed body. Core that
    // checkCore accepts never holds one (C-S1: a ServerFn makes no client call;
    // C-S3: no client root reaches a server-only Fn), but this printer is
    // fail-closed on its own: such a body would print a client fetch on the server.
    fn serverPrintRefusal(p: CoreProgram) -> string[] {
        let out: string[] = []
        for (const s of p.server) {
            for (const n of allNodes(Node.NServerFn(s))) {
                if (nodeIsServerCall(n)) out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: server function " + s.sym.hint + "() holds a client call of a server function (a server body calls in place, §13.4) — the Core is ill-formed (check.scrml C-S1)"])
            }
        }
        return out
    }

    fn nodeIsServerCall(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> exprIsServerCall(e)
            .NStmt(s: x) :> false
            .NProgram(p: x) :> false
            .NDecl(d: x) :> false
            .NField(f: x) :> false
            .NFn(f: x) :> false
            .NServerFn(f: x) :> false
            .NBlock(b: x) :> false
            .NPlace(pl: x) :> false
            .NInst(i: x) :> false
            .NPattern(pat: x) :> false
            .NEdit(k: x) :> false
            .NView(v: x) :> false
            .NAttr(a: x) :> false
        }
    }

    fn exprIsServerCall(e: Expr) -> boolean {
        return match e {
            .ServerCall(fn: x) :> true
            .Lit(lit: x) :> false
            .Local(sym: x) :> false
            .Read(place: x) :> false
            .Call(callee: x) :> false
            .Prim(op: x) :> false
            .Match(scrut: x) :> false
            .ArrayOf(elems: x) :> false
            .StructOf(ty: x) :> false
            .VariantOf(enumSym: x) :> false
            .Handle(inst: x) :> false
            .Assigned(local: x) :> false
            .InitOf(decl: x) :> false
            .Host(call: x) :> false
            .Lambda(params: x) :> false
            .SeqCall(op: x) :> false
            .Refetch(req: rf0) :> false
            .Validity(of: x) :> false
            .Query(q: x) :> false
            .Foreign(slice: fsl0) :> false
        }
    }
}
