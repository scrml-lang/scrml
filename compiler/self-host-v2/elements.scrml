// =============================================================================
// self-host-v2 / elements.scrml — the markup element registry (SPEC §4.1, §24.1).
//
// SPEC §4.1: "The compiler SHALL validate the element name against the
// built-in HTML element registry … A name that is not a known HTML element
// and not a defined component SHALL be a compile error (E-MARKUP-001)."
// §24.1 names the registry; §24.4: the scrml structural elements are NOT in
// it. The bootstrap had no registry: every tag it did not otherwise read was
// emitted as an HTML element (gap g-bootstrap-unknown-tags-resolved-as-html).
//
// This module is impl#1's ONE list (compiler/src/html-elements.js
// `isKnownElementName`, the E-MARKUP-001 gate since S264), ported as data:
// WHATWG HTML (with the legacy names, which still parse), SVG and MathML
// (MDN, with the legacy names), and the custom-element grammar. impl#1's curated
// REGISTRY adds nothing a markup page writes (its extra keys are scrml
// structural forms, which analyze reads before it asks here).
// compiler/self-host-v2/slice-m4/markup-failclosed-s473.test.js ("elements.scrml
// is impl#1's element list") runs both over the same names and requires the
// same answer: a drift is a failing test. One deliberate addition, pinned there:
// WHATWG's `selectedcontent` (customizable `<select>`), which impl#1's list lacks.
//
// A CAPITALISED tag is matched against the HTML list only
// (isHtmlElementName): `<DIV>` is `<div>`, but `<Unknown/>` / `<Set/>` /
// `<View/>` never fold onto an SVG or MathML name (analyze markupElementName).
//
// Matching is case-insensitive (§4.3 / §15.15.3: "Casing is irrelevant to
// resolution"), as impl#1's predicate is. A custom element (§22.4.1 /
// §5.2 treat it as an element; the SPEC states no grammar, impl#1's is
// `^[a-z][a-z0-9._]*-[a-z0-9._-]*$`) is a lowercase-initial name holding a
// hyphen, case-sensitive.
// =============================================================================
${
    // WHATWG HTML Living Standard element names, with the legacy / obsolete
    // names (lowercase). impl#1 html-elements.js STANDARD_HTML_ELEMENTS.
    export fn htmlElementNames() -> string[] {
        return ["html", "head", "body", "base", "link", "meta", "style", "title",
                "script", "noscript", "template", "slot", "canvas",
                "address", "article", "aside", "footer", "header",
                "h1", "h2", "h3", "h4", "h5", "h6", "hgroup", "main", "nav", "section", "search",
                "blockquote", "dd", "div", "dl", "dt", "figcaption", "figure", "hr",
                "li", "menu", "ol", "p", "pre", "ul",
                "a", "abbr", "b", "bdi", "bdo", "br", "cite", "code", "data", "dfn", "em",
                "i", "kbd", "mark", "q", "rp", "rt", "ruby", "s", "samp", "small", "span",
                "strong", "sub", "sup", "time", "u", "var", "wbr",
                "area", "audio", "img", "map", "track", "video", "picture", "source",
                "embed", "iframe", "object", "param", "portal", "fencedframe",
                "del", "ins",
                "caption", "col", "colgroup", "table", "tbody", "td", "tfoot", "th",
                "thead", "tr",
                "button", "datalist", "fieldset", "form", "input", "label", "legend",
                "meter", "optgroup", "option", "output", "progress", "select", "textarea",
                "details", "dialog", "summary", "selectedcontent",
                "svg", "math",
                "acronym", "applet", "basefont", "bgsound", "big", "blink", "center",
                "content", "dir", "font", "frame", "frameset", "image", "isindex", "keygen",
                "listing", "marquee", "menuitem", "multicol", "nextid", "nobr", "noembed",
                "noframes", "plaintext", "rb", "rtc", "shadow", "spacer", "strike", "tt",
                "xmp"]
    }

    // SVG element names, canonical case (MDN, with the legacy names).
    // impl#1 html-elements.js SVG_ELEMENTS.
    export fn svgElementNames() -> string[] {
        return ["a", "animate", "animateMotion", "animateTransform", "circle", "clipPath",
                "defs", "desc", "ellipse",
                "feBlend", "feColorMatrix", "feComponentTransfer", "feComposite",
                "feConvolveMatrix", "feDiffuseLighting", "feDisplacementMap", "feDistantLight",
                "feDropShadow", "feFlood", "feFuncA", "feFuncB", "feFuncG", "feFuncR",
                "feGaussianBlur", "feImage", "feMerge", "feMergeNode", "feMorphology",
                "feOffset", "fePointLight", "feSpecularLighting", "feSpotLight", "feTile",
                "feTurbulence",
                "filter", "foreignObject", "g", "image", "line", "linearGradient", "marker",
                "mask", "metadata", "mpath", "path", "pattern", "polygon", "polyline",
                "radialGradient", "rect", "set", "stop", "svg", "switch", "symbol", "text",
                "textPath", "tspan", "use", "view",
                "altGlyph", "altGlyphDef", "altGlyphItem", "animateColor", "color-profile",
                "cursor", "discard", "font", "font-face", "font-face-format",
                "font-face-name", "font-face-src", "font-face-uri", "glyph", "glyphRef",
                "hatch", "hatchpath", "hkern", "mesh", "meshgradient", "meshpatch",
                "meshrow", "missing-glyph", "solidcolor", "tref", "unknown", "vkern",
                "script", "style", "title"]
    }

    // MathML element names (MDN, with the legacy names; lowercase).
    // impl#1 html-elements.js MATHML_ELEMENTS.
    export fn mathmlElementNames() -> string[] {
        return ["math", "annotation", "annotation-xml", "maction", "menclose", "merror",
                "mfenced", "mfrac", "mi", "mmultiscripts", "mn", "mo", "mover", "mpadded",
                "mphantom", "mprescripts", "mroot", "mrow", "ms", "mspace", "msqrt",
                "mstyle", "msub", "msubsup", "msup", "mtable", "mtd", "mtext", "mtr",
                "munder", "munderover", "none", "semantics",
                "maligngroup", "malignmark", "mglyph", "mlabeledtr", "mlongdiv",
                "mscarries", "mscarry", "msgroup", "msline", "msrow", "mstack"]
    }

    fn lowerAll(xs: string[]) -> string[] {
        let out: string[] = []
        for (const x of xs) { out = out.concat([x.toLowerCase()]) }
        return out
    }

    fn isLowerAlpha(c: string) -> boolean { return c >= "a" && c <= "z" }
    fn isDigit(c: string) -> boolean { return c >= "0" && c <= "9" }

    // The custom-element name grammar — impl#1 html-elements.js
    // CUSTOM_ELEMENT_NAME_PATTERN `^[a-z][a-z0-9._]*-[a-z0-9._-]*$`: a
    // lowercase letter first, then lowercase letters, digits, `.`, `_` and `-`,
    // holding at least one `-`.
    export fn isCustomElementName(name: string) -> boolean {
        if (name.length < 2 || !isLowerAlpha(name.substring(0, 1))) return false
        let hyphen = false
        let i: int = 1
        while (i < name.length) {
            const c: string = name.substring(i, i + 1)
            if (c == "-") {
                hyphen = true
            } else if (!(isLowerAlpha(c) || isDigit(c) || c == "." || c == "_")) {
                return false
            }
            i = i + 1
        }
        return hyphen
    }

    // `name`, case-folded, is a WHATWG HTML element name (no SVG / MathML, no
    // custom element) — the only registry a capitalised tag may fold onto.
    export fn isHtmlElementName(name: string) -> boolean {
        return name != "" && htmlElementNames().indexOf(name.toLowerCase()) >= 0
    }

    // SPEC §4.1 / §24.1: `name` is an element of the built-in registry — an HTML,
    // SVG or MathML element name (any case), or a custom element name. impl#1
    // html-elements.js `isKnownElementName`.
    export fn isKnownElementName(name: string) -> boolean {
        if (name == "") return false
        if (isCustomElementName(name)) return true
        const lower: string = name.toLowerCase()
        if (htmlElementNames().indexOf(lower) >= 0) return true
        if (lowerAll(svgElementNames()).indexOf(lower) >= 0) return true
        if (mathmlElementNames().indexOf(lower) >= 0) return true
        return false
    }

    // =========================================================================
    // s474 (boot-gate-await-mathml) — THE HTML PARSER'S CONTEXT AND REPAIRS.
    //
    // One context computation, read by the printer (print.scrml: a template
    // inserted into foreign content is printed inside the elements that make
    // the browser build it there) and by the analyzer (analyze.scrml
    // markupParseDiags: markup the parser would RESTRUCTURE is refused — the
    // printer addresses a template's holes by child-index path over the tree
    // as WRITTEN, so a node the parser moves misaddresses the holes after it;
    // SPEC §24.5).
    //
    // The contexts (HTML §13.2.6.5 "tree construction dispatcher" and "the
    // rules for parsing tokens in foreign content"):
    //   "html"       an HTML element's children (and an HTML integration
    //                point's: SVG `foreignObject` / `desc` / `title`, MathML
    //                `annotation-xml encoding="text/html"` or
    //                `"application/xhtml+xml"`)
    //   "svg"        an SVG element's children
    //   "math"       a MathML element's children
    //   "math-text"  a MathML text integration point's children (`mi` `mo`
    //                `mn` `ms` `mtext`): HTML, except `mglyph` / `malignmark`
    //   "annot"      `annotation-xml`'s children (no HTML encoding): MathML,
    //                except `svg`, which opens SVG
    // Only a STATIC `encoding` decides (`encoding` is "" when there is none or
    // it is bound): a bound one is set after the parse.
    // =========================================================================
    export fn htmlNs() -> string { return "html" }

    /** The context the children of `<tag encoding=…>`, itself in context `ns`, parse in. */
    export fn childNs(ns: string, tag: string, encoding: string) -> string {
        const t: string = tag.toLowerCase()
        if (ns == "svg") {
            if (t == "foreignobject" || t == "desc" || t == "title") return "html"
            return "svg"
        }
        if (ns == "annot" && t == "svg") return "svg"
        if (ns == "math" || ns == "annot") return mathChildNs(t, encoding)
        if (ns == "math-text" && (t == "mglyph" || t == "malignmark")) return "math"
        // an HTML element (in "html", or an HTML element in "math-text")
        if (t == "svg") return "svg"
        if (t == "math") return "math"
        return "html"
    }

    fn mathChildNs(t: string, encoding: string) -> string {
        if (t == "mi" || t == "mo" || t == "mn" || t == "ms" || t == "mtext") return "math-text"
        if (t == "annotation-xml") {
            const enc: string = encoding.toLowerCase()
            if (enc == "text/html" || enc == "application/xhtml+xml") return "html"
            return "annot"
        }
        return "math"
    }

    /** A context whose elements are SVG or MathML elements (never HTML). */
    export fn isForeignNs(ns: string) -> boolean {
        return ns == "svg" || ns == "math" || ns == "annot"
    }

    /** An element `<tag>` written in context `ns` is an HTML element. */
    export fn isHtmlInNs(ns: string, tag: string) -> boolean {
        const t: string = tag.toLowerCase()
        if (ns == "html") return true
        if (ns == "math-text") return t != "mglyph" && t != "malignmark"
        return false
    }

    // HTML §13.2.6.5 "rules for parsing tokens in foreign content": a start tag
    // of one of these names (and `font` carrying `color`, `face` or `size`) is a
    // parse error that POPS the open SVG / MathML elements and is reprocessed as
    // HTML — the element is never a child of the foreign element it is written
    // in. `fontAttr`: the element carries a `color` / `face` / `size` attribute.
    export fn isForeignBreakout(tag: string, fontAttr: boolean) -> boolean {
        const t: string = tag.toLowerCase()
        if (t == "font") return fontAttr
        return ["b", "big", "blockquote", "body", "br", "center", "code", "dd", "div", "dl", "dt", "em", "embed",
                "h1", "h2", "h3", "h4", "h5", "h6", "head", "hr", "i", "img", "li", "listing", "menu", "meta", "nobr",
                "ol", "p", "pre", "ruby", "s", "small", "span", "strong", "strike", "sub", "sup", "table", "tt", "u",
                "ul", "var"].indexOf(t) >= 0
    }

    // HTML §13.2.6.4.7 "in body": a start tag of one of these names, while a
    // `<p>` is open in button scope, CLOSES that `<p>` first ("close a p
    // element") — the element becomes the `<p>`'s next sibling.
    export fn closesP(tag: string) -> boolean {
        return ["address", "article", "aside", "blockquote", "center", "details", "dialog", "dir", "div", "dl",
                "fieldset", "figcaption", "figure", "footer", "header", "hgroup", "main", "menu", "nav", "ol", "p",
                "search", "section", "summary", "ul", "h1", "h2", "h3", "h4", "h5", "h6", "pre", "listing", "form",
                "li", "dd", "dt", "plaintext", "table", "hr", "xmp"].indexOf(tag.toLowerCase()) >= 0
    }

    export fn isHeading(tag: string) -> boolean {
        return ["h1", "h2", "h3", "h4", "h5", "h6"].indexOf(tag.toLowerCase()) >= 0
    }

    // HTML §13.2.4.2 "has an element in scope": the elements that bound the
    // default scope — HTML ones, the MathML text / annotation points, the SVG
    // HTML integration points. `ns` is the element's OWN context.
    export fn boundsScope(ns: string, tag: string) -> boolean {
        const t: string = tag.toLowerCase()
        if (ns == "svg") return t == "foreignobject" || t == "desc" || t == "title"
        if (ns == "math" || ns == "annot") return ["mi", "mo", "mn", "ms", "mtext", "annotation-xml"].indexOf(t) >= 0
        return ["applet", "caption", "html", "table", "td", "th", "marquee", "object", "template"].indexOf(t) >= 0
    }

    // HTML §13.2.4.3: the elements whose start inserts a MARKER into the list of
    // active formatting elements (an `<a>` inside one does not see an outer `<a>`).
    export fn formattingMarker(tag: string) -> boolean {
        return ["applet", "object", "marquee", "template", "td", "th", "caption"].indexOf(tag.toLowerCase()) >= 0
    }

    // HTML §13.2.4.2 the "special" category (HTML namespace) — where the `li` /
    // `dd` / `dt` start-tag steps stop looking for an open `li` / `dd` / `dt`.
    export fn isSpecialHtml(tag: string) -> boolean {
        return ["address", "applet", "area", "article", "aside", "base", "basefont", "bgsound", "blockquote", "body",
                "br", "button", "caption", "center", "col", "colgroup", "dd", "details", "dir", "div", "dl", "dt", "embed",
                "fieldset", "figcaption", "figure", "footer", "form", "frame", "frameset", "h1", "h2", "h3", "h4", "h5",
                "h6", "head", "header", "hgroup", "hr", "html", "iframe", "img", "input", "keygen", "li", "link", "listing",
                "main", "marquee", "menu", "meta", "nav", "noembed", "noframes", "noscript", "object", "ol", "p", "param",
                "plaintext", "pre", "script", "search", "section", "select", "source", "style", "summary", "table", "tbody",
                "td", "template", "textarea", "tfoot", "th", "thead", "title", "tr", "track", "ul", "wbr", "xmp"].indexOf(tag.toLowerCase()) >= 0
    }

    // The table insertion mode (HTML §13.2.6.4.9–15) a child of `<tag>` is
    // parsed in: "table", "tbody" (`tbody` / `thead` / `tfoot`), "tr",
    // "colgroup", or "" (none).
    export fn tableMode(tag: string) -> string {
        const t: string = tag.toLowerCase()
        if (t == "table") return "table"
        if (t == "tbody" || t == "thead" || t == "tfoot") return "tbody"
        if (t == "tr") return "tr"
        if (t == "colgroup") return "colgroup"
        return ""
    }

    /** The element names a table-mode parent keeps as its children; any other is moved or wrapped. */
    export fn tableModeChildren(mode: string) -> string[] {
        if (mode == "table") return ["caption", "colgroup", "thead", "tbody", "tfoot", "template"]
        if (mode == "tbody") return ["tr", "template"]
        if (mode == "tr") return ["td", "th", "template"]
        if (mode == "colgroup") return ["col", "template"]
        return []
    }
}
