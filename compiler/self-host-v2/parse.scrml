// =============================================================================
// self-host-v2 / parse.scrml — source → FileAst (bootstrap impl#2, slice M2).
//
// Design authority: dpa-051 §3.1, §4; R1 (a) the S233 re-cut (lex · parse ·
// analyze · lower), ruled S437. Grammar: SPEC §66.2 (declaration openers,
// termination, the declaration/use marker), §66.5 (`renders`), §66.6 (`<*x>`),
// §66.7 (`as=`), §17.7 (`<each in= key= as name>`), §27 (comments), §4.14.
//
// TWO SCANNERS, ONE LEXER. A scrml file is markup with logic regions in it.
//   - The MARKUP scanner (this file, char level) reads tags, attribute names,
//     text and comments — none of which are tokens.
//   - Every LOGIC region — a `${…}` block or interpolation, a parenthesized /
//     braced / bare attribute value, an opener value, a `function` / `type` /
//     `import` declaration — is lexed by lex.scrml's `lexFrom` (the same fold as
//     `lex`, started at the region's offset and stopped by a rule) and parsed
//     here from tokens. There is no second lexer.
//   The opener TYPE (`:string[]`, `:Openness`) is read by the markup scanner: it
//   is a name + optional bracket grant list and ends at the opener's `=` / space
//   / `/>`, which no logic-region stop rule sees.
//
// OUTPUT: a FileAst whose every node carries a NodeId (`nid`), dense from the
// `firstId` the driver passes (so the files of one linked program get disjoint
// ranges), and whose bodies are trees (§4). Diagnostics are data, never thrown.
//
// Parse-level diagnostics (codes named in SPEC §66.20 where one exists):
//   E-DECL-OPENER-EXPR-UNPARENTHESIZED (§66.2.4), E-DECL-ILLEGAL-FIELD-NAME
//   (§66.2.3), E-DECL-LET-IN-OPENER / E-DECL-RENDERS-IN-OPENER /
//   E-DECL-KEYWORD-NOT-ITEM (§66.2.5, §66.4 rule 6, §66.5.1 — S447), and
//   E-PARSE-* for plain syntax errors (no §34 code is named for them yet — the
//   house rule is that §34 rows land with the implementation).
//
// S447 opener keywords (§66.2.5): `export` / `let` stand BEFORE the `<`, in JS
// order (`let <x:int=0/>`, `export let <checked:bool=false/>`), and are read only
// where declarations are ITEMS — a program body and a declaration body. Inside
// an opener stand only the name, `:Type`, `=value`, typed attributes and flags;
// `renders` follows the closer. An attribute is always locked data: a writable
// field is a child declaration (§66.4 rule 6).
//
// impl#1 workarounds: F4 (qualified variants in argument / field / element
// position), F5 (host-method results annotated), F11 (named payload binding),
// F16 (a match over an imported payload enum binds a field in at least one
// arm). (F12 — an alternation arm only first — and F14 — a brace in a string
// literal — are fixed in impl#1 by #1119; braces are plain string literals
// again, S440.)
// =============================================================================
${
    import { Token, TokenKind, LexStop, LexRun, LexPause, lexFrom, lexFromMode, lexTier0, lexTier0X, ForeignExtent, foreignOpenAt, foreignExtentAt, isVoidName, markupValueExtentAt, isKeyword, markupOpensAt } from "./lex.scrml"
    import { Severity } from "./severity.scrml"
    import { ASpan, BinOp, UnOp, AExpr, AProp, AExprK, AStmt, ABlock, AStmtK, IfForm, AEffect, ARequest, AType, ATypeK, AFnFx,
             ATypeField, AVariant, ATypeBody, ATypeDecl, AParam, AFn, AImportName, AImport, ALink,
             AAttrValue, AAttr, AElem, ANode, ANodeK, ADeclAttr, AStateChild, ADeclChild, ADecl, AValArg, AValidator,
             AProgram, AItem, AItemK, AConst, FileAst, ADbFn, AHostBind, APage, AEndpoint, AEpArm, AChannel, AOnchange, Diag, ASql, ASqlMode,
             AHow, AHandled, AArm, APat, ABind, AArmBody, AFail, AFor, AForHead, AIterSrc, AForBound, ALift, ACss, AForeign, mkSpan, newDiag, stdlibPathPrefix,
             HView, HChain, HTargetParts, hostView, hostChainOf, hostRootGlobal, hostTargetParts, isHyphenWordExpr } from "./ast.scrml"
    import { CssErr, CssParsed, parseCssBlock } from "./css-syntax.scrml"
    import { SchemaErr, SchemaRead, SchemaTable, SchemaCol, readSchemaBody, schemaCloseAt } from "./schema.scrml"
    import { logicWriteSink, executableAttrName } from "./url.scrml"
    import { isSurfaceIface } from "./host-surface.scrml"
    import { isKnownElementName } from "./elements.scrml"

    // =========================================================================
    // Tokens, as the parser sees them: one TOTAL classification of TokenKind
    // (the only match over it), then text-directed parsing.
    // =========================================================================
    // s451 (U1a): the three template token kinds get their own classes — a
    // `?{}` SQL template is read from them (TChunk = a literal run, TIStart /
    // TIEnd = a `${` / its `}`); everywhere else they are still not an expression.
    export type TC:enum = { Punct, Ident, Keyword, Num, Str, Variant, At, Other, End, TChunk, TIStart, TIEnd, Foreign, Markup }

    // `v` = the payload the parser needs: a name, a cooked string, a raw number.
    // s469 (templates): `bad` — a template chunk's malformed escape (lex.scrml
    // escapeWhy), "" for every other token. A slot's `}` (TIEnd) carries its
    // unreadable reason in `v`.
    export type PTok:struct = { cls: TC, v: string, text: string, start: int, end: int, line: int, bad: string }

    fn tokClass(k: TokenKind) -> TC {
        return match k {
            .LParen | .RParen | .LBrace | .RBrace | .LBracket | .RBracket |
                  .Semicolon | .Comma | .Dot | .Colon | .Arrow | .Question |
                  .Assign | .Equal | .StrictEqual | .NotEqual | .StrictNotEqual |
                  .Plus | .Minus | .Star | .Slash | .Percent |
                  .LessThan | .LessEqual | .GreaterThan | .GreaterEqual |
                  .Increment | .Decrement | .NullishCoalesce | .OptionalChain | .Bang |
                  .LogicalAnd | .LogicalOr | .BitAnd | .BitOr | .DotDot | .DotDotEq :> TC.Punct
            .TemplateInterpStart :> TC.TIStart
            .TemplateInterpEnd(why: w) :> TC.TIEnd
            .Eof :> TC.End
            .NumberLit(raw: r) :> TC.Num
            .StringLit(cooked: c) :> TC.Str
            .RegexLit(pattern: p) :> TC.Other
            .TemplateChunk(cooked: c) :> TC.TChunk
            .BareVariant(name: n) :> TC.Variant
            .Ident(name: n) :> TC.Ident
            .Keyword(name: n) :> TC.Keyword
            .Unknown(ch: c) :> unknownClass(c)
            .Foreign(level: l) :> TC.Foreign
            .MarkupValue :> TC.Markup
        }
    }

    fn unknownClass(c: string) -> TC {
        if (c == "@") return TC.At
        return TC.Other
    }

    fn tokPayload(k: TokenKind) -> string {
        return match k {
            .LParen | .RParen | .LBrace | .RBrace | .LBracket | .RBracket |
                  .Semicolon | .Comma | .Dot | .Colon | .Arrow | .Question |
                  .Assign | .Equal | .StrictEqual | .NotEqual | .StrictNotEqual |
                  .Plus | .Minus | .Star | .Slash | .Percent |
                  .LessThan | .LessEqual | .GreaterThan | .GreaterEqual |
                  .Increment | .Decrement | .NullishCoalesce | .OptionalChain | .Bang |
                  .LogicalAnd | .LogicalOr | .BitAnd | .BitOr | .DotDot | .DotDotEq |
                  .TemplateInterpStart | .Eof :> ""
            .TemplateInterpEnd(why: w) :> w
            .NumberLit(raw: r) :> r
            .StringLit(cooked: c) :> c
            .BareVariant(name: n) :> n
            .Ident(name: n) :> n
            .Keyword(name: n) :> n
            .Unknown(ch: c) :> c
            .RegexLit(pattern: p) :> p
            .TemplateChunk(cooked: c) :> c
            .Foreign(level: l, body: b) :> b
            .MarkupValue :> ""
        }
    }

    fn tokBad(k: TokenKind) -> string {
        return match k {
            .TemplateChunk(cooked: c, bad: b) :> b
            .LParen | .RParen | .LBrace | .RBrace | .LBracket | .RBracket |
                  .Semicolon | .Comma | .Dot | .Colon | .Arrow | .Question |
                  .Assign | .Equal | .StrictEqual | .NotEqual | .StrictNotEqual |
                  .Plus | .Minus | .Star | .Slash | .Percent |
                  .LessThan | .LessEqual | .GreaterThan | .GreaterEqual |
                  .Increment | .Decrement | .NullishCoalesce | .OptionalChain | .Bang |
                  .LogicalAnd | .LogicalOr | .BitAnd | .BitOr | .DotDot | .DotDotEq |
                  .TemplateInterpStart | .Eof :> ""
            .TemplateInterpEnd(why: w) :> ""
            .NumberLit(raw: r) :> ""
            .StringLit(cooked: c) :> ""
            .BareVariant(name: n) :> ""
            .Ident(name: n) :> ""
            .Keyword(name: n) :> ""
            .Unknown(ch: c) :> ""
            .RegexLit(pattern: p) :> ""
            .Foreign(level: l, body: b, closer: k) :> foreignBad(l, k)
            .MarkupValue :> ""
        }
    }

    // s473 — a foreign block's closer, judged where the token is made: "A
    // mismatched level (opener `_={` with closer `}==`) SHALL be a compile
    // error (E-FOREIGN-001)"; "A `_{}` block that reaches end-of-file without
    // a matching closer SHALL be a compile error (E-FOREIGN-002)" (§23.2).
    fn foreignBad(level: int, closer: int) -> string {
        if (closer < 0) return "E-FOREIGN-002"
        if (closer != level) return "E-FOREIGN-001"
        return ""
    }

    fn toPTok(t: Token) -> PTok {
        return { cls: tokClass(t.kind), v: tokPayload(t.kind), text: t.text,
                 start: t.span.start, end: t.span.end, line: t.span.line, bad: tokBad(t.kind) }
    }

    export fn toPToks(ts: Token[]) -> PTok[] {
        let out: PTok[] = []
        for (const t of ts) { out = out.concat([toPTok(t)]) }
        return out
    }

    // =========================================================================
    // s475 — namespace imports (ruling:user-voice-scrml.md S475 "S474 veto-window
    // readings; namespace-import markup" item 3: "`import * as m from './x.scrml'`
    // is defined; a namespaced component is written `<m.card/>` (and `<*m.card/>`
    // for the shared instance). Resolved by what `m` is bound to: a namespace
    // import → module member; a cell → field navigation (E-SCOPE-010 already
    // forbids one name being both)").
    //
    // s475 r1 (review of #1746, items 1 and 3) — WHAT `m.x` IS, ASKED OF THE TREE:
    // `PNs` is the file's namespace context, threaded through MP and TP:
    //  - `names`: the local names of the file's PARSED `import * as NAME` items
    //    (nsOfItems — never a scan of the source text: an `import * as C` in a
    //    comment or a string binds nothing, review item 3). A dotted name in a
    //    position no value can stand in — a type (`x: m.Box`), a `fail m.E.V`
    //    head, a qualified arm (`m.E.V :>`), a tag (`<m.card/>`) — whose head is
    //    one of them names that module's member: no local shadows a type, a tag
    //    or an enum path;
    //  - `at`: the source offsets of the VALUE names `m` that ANALYSIS resolved
    //    to the namespace import (analyze.scrml resolveNameOf — after every
    //    nearer binding: a local, a parameter, a declaration's prop or field, a
    //    host binding, §7.6 lexical scoping, review item 1). At those offsets
    //    only, `m . x` is ONE identifier token `m.x` (nsToks), which analyze's
    //    linkage binds to the module's export `x` (the #1715 (declaring file,
    //    orig) lookup) — so every pass reads a member as it reads an aliased
    //    import. Everywhere else `m.x` is a member access on `m`, exactly as
    //    without the import. The first parse has `at` empty; analyze.scrml
    //    analyzeSources re-parses a file (from the driver's source — the tree
    //    holds no text) with the offsets its first analysis found (parseFileNs).
    // =========================================================================
    //  - `kw` (s478): the source offsets of the statements `x = e;` analysis proved
    //    to be KEYWORDLESS DECLARATIONS (§50.8.5 — `x` names nothing in scope;
    //    analyze.scrml resolveEvalStmt). At those offsets only, the statement is
    //    parsed as `const x = e;` is (parseStmt). Everywhere else it is an
    //    assignment.
    export type PNs:struct = { names: string[], at: int[], kw: int[] }

    // The local names of the namespace imports among `items` (a `<program>`'s own
    // included — the items analyze's linkage binds, link.scrml importsOfItems).
    export fn nsOfItems(items: AItem[]) -> string[] {
        let out: string[] = []
        for (const it of items) {
            const k: AItemK = it.k
            const more: string[] = match k {
                .ImportItem(i: i) :> nsOfImport(i)
                .ProgramItem(p: p) :> nsOfItems(p.items)
                .TypeItem(t: t) :> []
                .FnItem(f: f) :> []
                .DeclItem(d: d) :> []
                .MarkupItem(n: n) :> []
                .ConstItem(c: c) :> []
            }
            for (const n of more) {
                if (out.indexOf(n) < 0) out = out.concat([n])
            }
        }
        return out
    }

    fn nsOfImport(i: AImport) -> string[] {
        if (i.ns == "" || i.host is given) return []
        return [i.ns]
    }

    // `m . x` at a proven value offset (`ns.at`) as the one token `m.x`.
    fn nsToks(ns: PNs, ts: PTok[]) -> PTok[] {
        if (ns.at.length == 0) return ts
        let out: PTok[] = []
        let i: int = 0
        while (i < ts.length) {
            const t: PTok = ts[i]
            let merged = false
            if (t.cls == TC.Ident && ns.at.indexOf(t.start) >= 0 && ns.names.indexOf(t.v) >= 0 && i + 2 < ts.length) {
                const d: PTok = ts[i + 1]
                const x: PTok = ts[i + 2]
                if (tk(d, ".") && x.cls == TC.Ident) {
                    const nm: string = t.v + "." + x.v
                    out = out.concat([{ cls: TC.Ident, v: nm, text: nm, start: t.start, end: x.end, line: t.line, bad: "" }])
                    i = i + 3
                    merged = true
                }
            }
            if (!merged) {
                out = out.concat([t])
                i = i + 1
            }
        }
        return out
    }

    // In a type / `fail` head / qualified-arm position: a namespace name `m` followed by
    // `.x` (touching) — the member name `m.x` and how many tokens it spans (0: not one).
    type NsHead:struct = { name: string, n: int }

    fn nsHeadAt(tp: TP, k: int) -> NsHead {
        const a: PTok = peekAt(tp, k)
        const b: PTok = peekAt(tp, k + 1)
        const c: PTok = peekAt(tp, k + 2)
        if (a.cls == TC.Ident && tp.ns.names.indexOf(a.v) >= 0 && b.cls == TC.Punct && tk(b, ".") && c.cls == TC.Ident && touching(a, b) && touching(b, c)) {
            return { name: a.v + "." + c.v, n: 3 }
        }
        return { name: "", n: 0 }
    }

    // =========================================================================
    // The token-level parser state: a value threaded through every function.
    // =========================================================================
    // s478 (review-followups-2): `inFn` — the tokens being read are inside the body of a
    // function DECLARATION (§19.16.3 rule 4), and not in a non-function body nested in one
    // (a `when` / effect body, an arrow body; markup — handlers — is read from its own MP).
    // Set by parseFnDecl; bareBlock reads it to name a `defer` there (§19.16.2 vs §19.16.3).
    // s478 (review-followups-3): three states, not two — 0 (top-level logic), 1 (a function
    // declaration's body), 2 (a text-lowered body: a `when` / effect /
    // arrow body, an attribute value — handler — or anything nested in one). A function
    // DECLARED in a lowered body is no defer site either — §19.16.3 rule 4: "a `defer`
    // inside a function or arrow DECLARED in a `when` body or a handler attribute is
    // rejected too" (E-DEFER-OUTSIDE-FUNCTION) — so parseFnDecl keeps 2 (fnBodyInFn).
    // (One int field, not a second flag: every TP literal copies it unchanged.)
    type TP:struct = { toks: PTok[], i: int, nid: int, diags: Diag[], file: string, ns: PNs, inFn: int }

    // A function declaration's body: a defer site (1) unless declared in a lowered body (2).
    fn fnBodyInFn(outer: int) -> int {
        if (outer == 2) return 2
        return 1
    }

    fn withInFn(tp: TP, v: int) -> TP {
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags, file: tp.file, ns: tp.ns, inFn: v }
    }

    type RExpr:struct  = { e: AExpr, tp: TP }
    type RExprs:struct = { es: AExpr[], tp: TP }
    type RStmt:struct  = { s: AStmt, tp: TP }
    type RBlock:struct = { b: ABlock, tp: TP }
    type RType:struct  = { t: AType, tp: TP }
    type RItems:struct = { items: AItem[], tp: TP }
    type RName:struct  = { name: string, tp: TP }

    fn cur(tp: TP) -> PTok {
        if (tp.i < tp.toks.length) return tp.toks[tp.i]
        return tp.toks[tp.toks.length - 1]
    }

    fn peekAt(tp: TP, k: int) -> PTok {
        const j: int = tp.i + k
        if (j < tp.toks.length) return tp.toks[j]
        return tp.toks[tp.toks.length - 1]
    }

    fn adv(tp: TP) -> TP {
        if (tp.i >= tp.toks.length - 1) return tp
        return { toks: tp.toks, i: tp.i + 1, nid: tp.nid, diags: tp.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    fn bumpId(tp: TP) -> TP {
        return { toks: tp.toks, i: tp.i, nid: tp.nid + 1, diags: tp.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    fn diagAt(tp: TP, code: string, msg: string, t: PTok) -> TP {
        const d: Diag = newDiag(code, msg, tp.file, mkSpan(t.start, t.end))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    fn atEnd(tp: TP) -> boolean { return cur(tp).cls == TC.End }

    // Is the current token the punctuation / word `s`?
    fn isP(tp: TP, s: string) -> boolean {
        const t: PTok = cur(tp)
        if (t.cls == TC.Str) return false
        return tk(t, s)
    }

    // s469 — does token `x` read as the punctuation / word `s`? A template's
    // pieces (a chunk, a `${`, a slot's `}`) never do: their text is template
    // text, and every token-level scanner here (bracket-depth counters, arm and
    // head boundaries, `isP`) steps over them — a slot's `}` is not a brace.
    fn tk(x: PTok, s: string) -> boolean {
        if (x.cls == TC.TChunk || x.cls == TC.TIStart || x.cls == TC.TIEnd) return false
        return x.text == s
    }

    fn isWord(tp: TP, s: string) -> boolean {
        const t: PTok = cur(tp)
        if (t.cls == TC.Ident || t.cls == TC.Keyword) return t.v == s
        return false
    }

    fn expectP(tp: TP, s: string) -> TP {
        if (isP(tp, s)) return adv(tp)
        const t: PTok = cur(tp)
        return diagAt(tp, "E-PARSE-EXPECTED", "expected `" + s + "`, found `" + t.text + "`" + gluedQHint(tp), t)
    }

    // s469 (§7.2.2 rule 4, adjacency decides a `?`) — a message note, no code of its
    // own: when the token before `tp` is a `?` glued to what it follows (propagation,
    // which ends the expression) and an expression start follows it on its line — the
    // conditional the S446 reading took it for (`f(a == 1? 2 : 3)`, `${ ok? "y" : "n" }`).
    fn gluedQHint(tp: TP) -> string {
        if (tp.i < 2) return ""
        const q: PTok = tp.toks[tp.i - 1]
        const t: PTok = cur(tp)
        if (q.cls != TC.Punct || !tk(q, "?") || !touching(tp.toks[tp.i - 2], q)) return ""
        if (t.cls == TC.End || t.cls == TC.TIEnd || t.line != q.line || !exprStartTok(t)) return ""
        return " (A `?` written directly against what it follows is the propagation operator, §19.5 — for the conditional, put a space before it: `c ? a : b`.)"
    }

    // Can token `t` begin an expression?
    fn exprStartTok(t: PTok) -> boolean {
        if (t.cls == TC.Ident || t.cls == TC.Num || t.cls == TC.Str || t.cls == TC.At || t.cls == TC.Variant || t.cls == TC.TChunk || t.cls == TC.Foreign || t.cls == TC.Markup) return true
        if (t.cls == TC.Keyword) return t.v == "true" || t.v == "false" || t.v == "not" || t.v == "match"
        if (t.cls != TC.Punct) return false
        return tk(t, "(") || tk(t, "[") || tk(t, "{") || tk(t, "!") || tk(t, "-")
    }

    // Two tokens that touch (no trivia between them): `:>`, `@x`, `->`.
    fn touching(a: PTok, b: PTok) -> boolean { return a.end == b.start }

    // s469 — the line a token ENDS on (a template chunk can span lines; `line`
    // is where it starts). "The line above" a token is its predecessor's end line.
    fn endLine(x: PTok) -> int {
        let n: int = x.line
        let i: int = x.text.indexOf("\n")
        while (i >= 0) {
            n = n + 1
            i = x.text.indexOf("\n", i + 1)
        }
        return n
    }

    fn spanFrom(tp: TP, start: int) -> ASpan {
        let end: int = start
        if (tp.i > 0) end = tp.toks[tp.i - 1].end
        if (end < start) end = start
        return mkSpan(start, end)
    }

    fn mkE(tp: TP, start: int, k: AExprK) -> RExpr {
        const e: AExpr = { nid: tp.nid, span: spanFrom(tp, start), k: k }
        return { e: e, tp: bumpId(tp) }
    }

    // =========================================================================
    // Expressions — precedence climbing.
    //   assignment (right) < ternary < `||` < `&&` < `|` < `==` `!=` < relational
    //   < additive < multiplicative < unary (`!` `-`) < postfix (`.name`, call)
    // =========================================================================
    fn binPrec(tp: TP) -> int {
        const t: PTok = cur(tp)
        if (t.cls != TC.Punct) return 0
        if (isCompoundAssign(tp)) return 0
        // s449: `<effect deps=…` on the next line opens an element, not a comparison
        if (effectTagAhead(tp) && tp.i > 0 && tp.toks[tp.i - 1].line != t.line) return 0
        return match t.text {
            "||"  :> 1
            "&&"  :> 2
            "|"   :> 3
            "=="  :> 4
            "!="  :> 4
            "===" :> 4
            "!==" :> 4
            "<"   :> 5
            "<="  :> 5
            ">"   :> 5
            ">="  :> 5
            "+"   :> 6
            "-"   :> 6
            "*"   :> 7
            "/"   :> 7
            "%"   :> 7
            _     :> 0
        }
    }

    fn binOpOf(text: string) -> BinOp {
        return match text {
            "||" :> BinOp.Or
            "&&" :> BinOp.And
            "|"  :> BinOp.Pipe
            "==" :> BinOp.Eq
            "!=" :> BinOp.Ne
            "<"  :> BinOp.Lt
            "<=" :> BinOp.Le
            ">"  :> BinOp.Gt
            ">=" :> BinOp.Ge
            "+"  :> BinOp.Add
            "-"  :> BinOp.Sub
            "*"  :> BinOp.Mul
            "/"  :> BinOp.Div
            "%"  :> BinOp.Mod
            "===" :> BinOp.Eq
            "!==" :> BinOp.Ne
            _    :> BinOp.Eq
        }
    }

    // `x += v` — the lexer has no compound-assignment token, so it is an
    // arithmetic operator TOUCHING a following `=`.
    fn isCompoundAssign(tp: TP) -> boolean {
        const t: PTok = cur(tp)
        const n: PTok = peekAt(tp, 1)
        if (t.cls != TC.Punct || !tk(n, "=") || !touching(t, n)) return false
        return tk(t, "+") || tk(t, "-") || tk(t, "*") || tk(t, "/") || tk(t, "%")
    }

    // s473 — the sink member a compound assignment's target writes ("" — none):
    // `x.innerHTML += …`, `x["onclick"] += …` (url.scrml logicWriteSink).
    fn compoundSinkMember(t: AExpr) -> string {
        const k: AExprK = t.k
        const name: string = match k {
            .Member(obj: o, name: n) :> n
            .Index(obj: o, idx: ix) :> strLitText(ix)
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: x) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: x) :> ""
            .Assign(target: x) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Lambda(params: ps) :> ""
            .BlockLambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .HashRef(id: hr0) :> ""
            .Foreign(f: fb0) :> ""
        }
        // by name only (the type-judged kinds — `on…`, a navigation — are left to the
        // unsupported-form refusal below: the parser sees no types)
        const kind: string = logicWriteSink(name)
        if (name != "" && (kind == "html" || kind == "exec")) return name
        return ""
    }

    fn strLitText(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Str(v: x) :> x
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: x) :> ""
            .Assign(target: x) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: o) :> ""
            .Lambda(params: ps) :> ""
            .BlockLambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .HashRef(id: hr0) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    export fn parseAssign(tp: TP) -> RExpr {
        const start: int = cur(tp).start
        const lhs: RExpr = parseTernary(tp)
        if (isP(lhs.tp, "=")) {
            const rhs: RExpr = parseAssign(adv(lhs.tp))
            return mkE(rhs.tp, start, AExprK.Assign(lhs.e, rhs.e, false, false))
        }
        if (isCompoundAssign(lhs.tp)) {
            const op: PTok = cur(lhs.tp)
            // s473 — §5.2 "Executable sinks in plain logic (S473)": a compound write
            // of a sink member (`el.innerHTML += s`) is refused as the sink it is
            // (its value is never a static literal), not only as an unsupported form
            const sinkName: string = compoundSinkMember(lhs.e)
            if (sinkName != "") {
                const ds: TP = diagAt(lhs.tp, "E-LOGIC-EXECUTABLE-SINK", "`… ." + sinkName + " " + op.text + "= …` writes `" + sinkName + "` from data — `" + sinkName + "` is an executable sink: the browser parses or runs what is written there, script included, without scrml checking it, and data is never written into it (§5.2, S473). Render the content as markup, or write plain text with `textContent`.", op)
                const rhs3: RExpr = parseAssign(adv(adv(ds)))
                return mkE(rhs3.tp, start, AExprK.Recovered)
            }
            const d: TP = diagAt(lhs.tp, "E-BOOTSTRAP-UNSUPPORTED", "compound assignment `" + op.text + "=` is not in bootstrap slice M2 — write `x = x " + op.text + " …`", op)
            const rhs2: RExpr = parseAssign(adv(adv(d)))
            // reported above; recovered as a placeholder, never typed as `x = v`
            return mkE(rhs2.tp, start, AExprK.Recovered)
        }
        if (isP(lhs.tp, "++") || isP(lhs.tp, "--")) {
            const inc: PTok = cur(lhs.tp)
            const d2: TP = diagAt(lhs.tp, "E-BOOTSTRAP-UNSUPPORTED", "`" + inc.text + "` is not in bootstrap slice M2 — write `x = x " + inc.text.substring(0, 1) + " 1`", inc)
            return { e: lhs.e, tp: adv(d2) }
        }
        return lhs
    }

    fn parseTernary(tp: TP) -> RExpr {
        const start: int = cur(tp).start
        const test: RExpr = parseBinary(tp, 1)
        if (isRangeTok(test.tp)) return rangeOutsideHead(test.tp, start)
        if (!isP(test.tp, "?")) return test
        // s451: `?{` is the SQL sigil (§8.1), never a ternary's `?` — the
        // expression ends here and a `?{` statement follows
        if (isSqlOpen(test.tp)) return test
        // s469 (§7.2.2 rule 4, RULED: adjacency decides a `?`) — a SPACED `?`
        // is the conditional's, so one with nothing after it (`load(id) ?;`,
        // `f(x ?)`) is a conditional missing its branches: refused by name,
        // naming the propagation spelling, never read as propagation
        const q: PTok = cur(test.tp)
        const qn: PTok = peekAt(test.tp, 1)
        if (qn.cls == TC.End || qn.cls == TC.TIEnd || (qn.cls == TC.Punct && (tk(qn, ")") || tk(qn, "]") || tk(qn, ",") || tk(qn, "}") || tk(qn, ";")))) {
            const dq: TP = diagAt(test.tp, "E-PARSE-EXPR", "a `?` with whitespace before it is the conditional (`c ? a : b`), and nothing follows it — for propagation (§19.5) write the `?` directly against what it follows: `x?` (§7.2.2 rule 4: adjacency decides)", q)
            return mkE(adv(dq), start, AExprK.Recovered)
        }
        const yes: RExpr = parseTernary(adv(test.tp))
        const t2: TP = expectP(yes.tp, ":")
        const no: RExpr = parseTernary(t2)
        return mkE(no.tp, start, AExprK.Ternary(test.e, yes.e, no.e, false, false))
    }

    // s469 (§49.2.5): `a..b` / `a..=b` is legal ONLY as the whole iterable of a
    // `for (x of …)` head — parseForIter reads it there, at additive precedence,
    // without coming through here. Every other position an expression can stand
    // in reaches this from parseTernary: E-RANGE-OUTSIDE-LOOP-HEAD, and the
    // upper bound is consumed (recovered; nothing downstream types it).
    fn isRangeTok(tp: TP) -> boolean { return isP(tp, "..") || isP(tp, "..=") }

    fn rangeOutsideHead(tp: TP, start: int) -> RExpr {
        const op: PTok = cur(tp)
        const d: TP = diagAt(tp, "E-RANGE-OUTSIDE-LOOP-HEAD", "a range `a" + op.text + "b` is not a value — it stands only as the whole iterable of a `for (i of a" + op.text + "b)` head (§49.2.5)", op)
        const hi: RExpr = parseBinary(adv(d), 6)
        return mkE(hi.tp, start, AExprK.Recovered)
    }

    fn parseBinary(tp: TP, minPrec: int) -> RExpr {
        const start: int = cur(tp).start
        let left: RExpr = parseUnary(tp)
        let going = true
        while (going) {
            const prec: int = binPrec(left.tp)
            if (prec == 0 || prec < minPrec) {
                going = false
            } else {
                const opTok: PTok = cur(left.tp)
                let t1: TP = left.tp
                if (tk(opTok, "===") || tk(opTok, "!==")) {
                    t1 = diagAt(t1, "E-PARSE-STRICT-EQ", "`" + opTok.text + "` is not scrml — `==` is already strict and structural (§45)", opTok)
                }
                const right: RExpr = parseBinary(adv(t1), prec + 1)
                left = mkE(right.tp, start, AExprK.Binary(binOpOf(opTok.text), left.e, right.e))
            }
        }
        return left
    }

    fn parseUnary(tp: TP) -> RExpr {
        const start: int = cur(tp).start
        if (isP(tp, "!")) {
            const inner: RExpr = parseUnary(adv(tp))
            return mkE(inner.tp, start, AExprK.Unary(UnOp.Not, inner.e))
        }
        if (isP(tp, "-")) {
            const inner: RExpr = parseUnary(adv(tp))
            return mkE(inner.tp, start, AExprK.Unary(UnOp.Neg, inner.e))
        }
        return parsePostfix(tp)
    }

    fn parsePostfix(tp: TP) -> RExpr {
        const start: int = cur(tp).start
        return parsePostfixFrom(parsePrimary(tp), start)
    }

    fn parsePostfixFrom(first: RExpr, start: int) -> RExpr {
        let r: RExpr = first
        let going = true
        // s478 (s478-boot-syntax-batch, landed s478-boot-optional-chain) — optional chaining (§42.3.6): the receivers of this
        // chain's `?.` hops, in order (see optHop / closeOpt)
        let opts: AExpr[] = []
        while (going) {
            const t: PTok = cur(r.tp)
            const prev: PTok = peekAt(r.tp, -1)
            if (t.cls == TC.Punct && tk(t, "?.")) {
                const oh: ROpt = optHop(r, start)
                r = oh.r
                if (oh.ok) opts = opts.concat([oh.recv])
            } else if (t.cls == TC.Punct && tk(t, ".") && peekAt(r.tp, 1).cls == TC.Ident) {
                const name: string = peekAt(r.tp, 1).v
                r = mkE(adv(adv(r.tp)), start, AExprK.Member(r.e, name))
            } else if (t.cls == TC.Punct && tk(t, ".") && peekAt(r.tp, 1).cls == TC.Keyword) {
                const kname: string = peekAt(r.tp, 1).v
                r = mkE(adv(adv(r.tp)), start, AExprK.Member(r.e, kname))
            } else if (t.cls == TC.Variant && touching(prev, t) && isHashRefExpr(r.e)) {
                // s475 (S3b): `<#id>.data` — after the `>` the lexer reads `.data` as one
                // bare-variant token (a `.` in value position); touching `<#id>` it is the member
                r = mkE(adv(r.tp), start, AExprK.Member(r.e, t.v))
            } else if (t.cls == TC.Punct && tk(t, "(") && t.line == endLine(prev)) {
                const args: RExprs = parseList(adv(r.tp), ")")
                r = mkE(args.tp, start, AExprK.Call(r.e, args.es))
            } else if (t.cls == TC.Punct && tk(t, "[") && touching(prev, t)) {
                // `a[i]` — the `[` touches what it indexes (a spaced `[` starts a new expression)
                const ix: RExpr = parseAssign(adv(r.tp))
                r = mkE(expectP(ix.tp, "]"), start, AExprK.Index(r.e, ix.e))
            } else if (opts.length > 0) {
                // the chain ends here: what follows (`!{`, `?`, `is given`, an operator) applies
                // to the WHOLE optional chain (§42.3.6 "Short-circuit is chain-wide")
                r = closeOpt(r, opts)
                opts = []
            } else if (t.cls == TC.TChunk && t.line == endLine(prev)) {
                // s469 — `tag`…`` (a tagged template: the tag CALLED with the
                // template's pieces) is not a text template; refused by name, the
                // template read past (its own errors report)
                const dt: TP = diagAt(r.tp, "E-BOOTSTRAP-UNSUPPORTED", "a tagged template (`tag` followed by a backtick template) is not in the bootstrap — a logic template is text (§14.13.3); pass the template to the function as an argument instead (`f(` then the template then `)`)", t)
                const rt: RExpr = parseTemplate(dt)
                r = mkE(rt.tp, start, AExprK.Recovered)
            } else if (splitContinuesAt(r.tp)) {
                // s469 (§7.2.2 rule 5, F4 (ii) — RULED, "Build both"): an expression
                // that continues across a line break into a line starting with `(`,
                // `[` or a template is E-STMT-SPLIT-CONTINUATION — never the call /
                // index / tagged template JavaScript reads, never a silent split.
                // The expression ends here (as if the `;` were written), so the
                // next line is read as a statement of its own and reports only
                // its own errors (no second terminator or no-effect report).
                r = { e: r.e, tp: splitContinuation(r.tp) }
                going = false
            } else if (isHandlerOpen(r.tp)) {
                // s451 (Ue): `expr !{ … }` — a failable handler (§19.4.3 item 3)
                r = parseGuard(r, start)
            } else if (isPropagate(r.tp)) {
                // s451 (Ue): `expr?` — propagation (§19.5)
                r = handledExpr(adv(r.tp), start, r.e, AHow.Propagate)
            } else if (isPresenceTest(r.tp)) {
                // s460: `expr is given` / `expr is not` — a postfix presence
                // test (§42.2.2, §42.2.4), binding tighter than a prefix `!`
                // (`!x is not` is `!(x is not)`, as impl#1 reads it)
                let pop: UnOp = UnOp.IsNot
                const word: TP = adv(r.tp)
                if (isWord(word, "given") || isWord(word, "some")) pop = UnOp.IsGiven
                let past: TP = adv(word)
                if (isWord(word, "some")) past = someLint(past, cur(r.tp), cur(word))
                r = mkE(past, start, AExprK.Unary(pop, r.e))
            } else {
                going = false
            }
        }
        if (opts.length > 0) r = closeOpt(r, opts)
        return r
    }

    // =========================================================================
    // s478 (s478-boot-syntax-batch; landed by s478-boot-optional-chain on #1917's member access
    // through a narrowed `T | not`) — OPTIONAL CHAINING, `?.` (SPEC §42.3.6):
    //   optional-access ::= expr '?.' identifier | expr '?.' '[' expr ']' | expr '?.' arguments
    // "When the receiver `expr` is `not`, the access short-circuits: the whole optional-chain
    // expression evaluates to `not`, and the remainder of the chain is NOT evaluated (no field
    // read, no index, no call, no argument evaluation, no side effects past the `?.`)." "Short-
    // circuit is chain-wide from the `?.` point, but each hop is guarded only against its own
    // receiver." "Result type. `recv?.field` has type `F | not` where `F` is the declared type of
    // `field` … a further BARE dereference on it fires E-TYPE-046 (§42.3.5)."
    //
    // The bootstrap reads a chain holding `?.` hops as the presence tests of their receivers
    // around the chain read plainly — `a?.b.c` is `a is given ? a.b.c : not`, `a?.b?.c` is
    // `a is given ? (a.b is given ? a.b.c : not) : not` — a value-position conditional (§42.4
    // statement 8: "`x is given` narrows it to `T` where the test is true", a member path
    // included). That IS each SPEC sentence: the rest of the chain runs only where every tested
    // receiver is present; a hop after a `?.` is guarded against that receiver only (the next
    // hop's own receiver is not narrowed, so a bare `.c` on an optional `b` is still E-TYPE-046);
    // and the conditional's type joins the chain's type with `not` — `F | not`. A `?.` ends at
    // the chain's end: `(a?.b).c` dereferences the conditional's `F | not`, E-TYPE-046.
    //
    // The receiver is evaluated twice (its test, then the chain), so it is built only for a
    // receiver whose evaluation does nothing but read: a name, `@cell`, a `<#id>`
    // reference, a member path of those, an index by a literal or such a path (an `<each>` row
    // read `@.` is refused by name — INTERIM g-boot-optional-chain-atitem-s478). Any other receiver
    // (a call, a conditional …; parentheses alone are grouping) is refused by name — INTERIM,
    // g-boot-optional-chain-receiver-s478 (the capable form binds it once: `const u = f(); u?.x`).
    // (§42.3.6 "Codegen" — "SHALL lower to the corresponding JavaScript optional-chaining form" —
    // is about the emitted JavaScript; the bootstrap prints its presence test and the plain
    // access, which short-circuit identically on `not` — owner question g-boot-optional-chain-js-form-s478.)
    // Every read in the chain is a PLAIN member read typed by analyze.scrml typeMember, so the
    // receiver-type check (memberRecvMismatch, #1917 H1) and E-TYPE-046 apply to it unchanged.
    // =========================================================================
    type ROpt:struct = { r: RExpr, recv: AExpr, ok: boolean }

    // One `?.` hop: `?.name`, `?.[i]` or `?.(args)` read as the plain hop on the receiver, which is
    // returned (`recv`) so closeOpt can test it. `ok` false: refused (the hop is read past).
    fn optHop(r0: RExpr, start: int) -> ROpt {
        const recv: AExpr = r0.e
        const q: PTok = cur(r0.tp)
        let t: TP = r0.tp
        // s478 (s478-boot-optional-chain): an OPTIONAL CALL `f?.(args)` is refused by name —
        // INTERIM, g-boot-optional-call-s478. Its receiver is a function value that may be `not`
        // (§42.3.6 "recv?.method(args)"); the bootstrap types no `fn | not` value, and a function
        // DECLARATION (never `not`) read through `?.(` would test a function for presence and put a
        // server call in a conditional arm (the s474 H1 shape, foreign-content-s474.test.js: `match check?.(p) { … }`) — so the
        // whole hop is refused, fail closed. The capable form: call it plainly, or narrow the
        // function value first.
        const isCall: boolean = peekAt(t, 1).cls == TC.Punct && tk(peekAt(t, 1), "(")
        if (isCall) {
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "`?.(…) optional call` (§42.3.6) is not in the bootstrap yet — the bootstrap builds `?.` member and index reads, not a call through a function value that may be `not`; it is refused here by name rather than misread (INTERIM, g-boot-optional-call-s478). Call it plainly (`f(args)`), or narrow the value first (`if (f is given) { f(args) }`)", q)
        } else if (optAtItemRooted(recv)) {
            // s478 fix round 1 (#1927 review LOW-3): an `<each>` row read `@.` / `@.addr` is no
            // place the typer narrows (analyze.scrml nKey: `@.` has no key), so the presence
            // test would not reach the hop and the user would get E-TYPE-046 at a hop they did
            // not write — refused by name, INTERIM g-boot-optional-chain-atitem-s478; the named
            // row binding (`<each in=@xs as u>` … `u.addr?.city`) is built.
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "`?. on an `@.` row read` (§42.3.6) is not in the bootstrap yet — it cannot narrow an `<each>` row read `@.` (or a member path of it) by the presence test `?.` makes; it is refused here by name rather than misreported (INTERIM, g-boot-optional-chain-atitem-s478). Name the row: `<each in=@xs as u>` … `u.addr?.city`", q)
        } else if (!optRecvOk(recv)) {
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "`?. on a computed receiver` (§42.3.6) is not in the bootstrap yet — it builds `?.` on a name, `@cell`, a `<#id>` reference, or a member path / literal index of those, whose presence it can test before reading it; it is refused here by name rather than misread (INTERIM, g-boot-optional-chain-receiver-s478). Bind the receiver first: `const r = …; r?.x`", q)
        }
        const n: PTok = peekAt(t, 1)
        let out: RExpr = { e: recv, tp: t }
        if (n.cls == TC.Ident || n.cls == TC.Keyword) {
            out = mkE(adv(adv(t)), start, AExprK.Member(recv, n.v))
        } else if (n.cls == TC.Punct && tk(n, "[")) {
            const ix: RExpr = parseAssign(adv(adv(t)))
            out = mkE(expectP(ix.tp, "]"), start, AExprK.Index(recv, ix.e))
        } else if (n.cls == TC.Punct && tk(n, "(")) {
            const args: RExprs = parseList(adv(adv(t)), ")")
            out = mkE(args.tp, start, AExprK.Call(recv, args.es))
        } else {
            const dt: TP = diagAt(t, "E-PARSE-EXPECTED", "expected a field name, `[` or `(` after `?.` (§42.3.6: `recv?.field`, `recv?.[key]`, `recv?.method(args)`)", n)
            return { r: mkE(adv(dt), start, AExprK.Recovered), recv: recv, ok: false }
        }
        if (isCall || optAtItemRooted(recv) || !optRecvOk(recv)) return { r: mkE(out.tp, start, AExprK.Recovered), recv: recv, ok: false }
        return { r: out, recv: recv, ok: true }
    }

    // A receiver whose evaluation only reads (so testing it, then reading it again, is one read).
    fn optRecvOk(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> true
            .At(name: n) :> true
            .AtItem :> true
            .HashRef(id: h) :> true
            .Member(obj: o) :> optRecvOk(o)
            .Index(obj: o, idx: i) :> optRecvOk(o) && optIndexOk(i)
            .Num(raw: x) :> false
            .Str(v: x) :> false
            .Bool(v: x) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: x) :> false
            .Call(callee: x) :> false
            .Unary(op: x) :> false
            .Binary(op: x) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: x) :> false
            .ObjectLit(props: x) :> false
            .Spread(e: x) :> false
            .Lambda(params: x) :> false
            .BlockLambda(params: x) :> false
            .Sql(q: x) :> false
            .Handled(h: x) :> false
            .Template(quasis: x) :> false
            .Foreign(f: x) :> false
        }
    }

    // Is the receiver an `<each>` row read `@.`, or a member path / index of one?
    fn optAtItemRooted(e: AExpr) -> boolean {
        const k: AExprK = e.k
        const ob: AExpr | not = recvObj(e)
        if (ob is given) return optAtItemRooted(ob)
        return match k {
            .AtItem :> true
            // no-default-arm: one question of the receiver's root — is it `@.`
            _ :> false
        }
    }

    fn optIndexOk(e: AExpr) -> boolean {
        const k: AExprK = e.k
        const lit: boolean = match k {
            .Num(raw: x) :> true
            .Str(v: x) :> true
            .Name(name: x) :> false
            .At(name: x) :> false
            .AtItem :> false
            .HashRef(id: x) :> false
            .Member(obj: x) :> false
            .Index(obj: x) :> false
            .Bool(v: x) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: x) :> false
            .Call(callee: x) :> false
            .Unary(op: x) :> false
            .Binary(op: x) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: x) :> false
            .ObjectLit(props: x) :> false
            .Spread(e: x) :> false
            .Lambda(params: x) :> false
            .BlockLambda(params: x) :> false
            .Sql(q: x) :> false
            .Handled(h: x) :> false
            .Template(quasis: x) :> false
            .Foreign(f: x) :> false
        }
        return lit || optRecvOk(e)
    }

    // The chain `r.e` with its `?.` receivers `opts` (shortest first): each receiver's presence
    // test around the rest, the first receiver's outermost — `opts[0] is given ? (… ? r.e : not) : not`.
    // Each test reads a COPY of its receiver with fresh node ids (a node is typed once; the test
    // and the chain read the receiver at two places). The conditional is marked `optChain`: the
    // analyzer counts the test and the chain's read of the receiver as ONE use of a `lin` binding
    // (linOptWalk, #1927 review MED-1), and the test narrows the receiver only where the chain's
    // SPINE reads it, never inside a hop's argument or index (optSpineKeys — §42.3.6 "each hop is
    // guarded only against its own receiver", #1927 review LOW-2).
    fn closeOpt(r: RExpr, opts: AExpr[]) -> RExpr {
        let t: TP = r.tp
        let inner: AExpr = r.e
        let i: int = opts.length - 1
        while (i >= 0) {
            const rc: RExpr = cloneRecv(t, opts[i])
            t = rc.tp
            const test: AExpr = { nid: t.nid, span: opts[i].span, k: AExprK.Unary(UnOp.IsGiven, rc.e) }
            t = bumpId(t)
            const none: AExpr = { nid: t.nid, span: r.e.span, k: AExprK.NotLit }
            t = bumpId(t)
            inner = { nid: t.nid, span: r.e.span, k: AExprK.Ternary(test, inner, none, false, true) }
            t = bumpId(t)
            i = i - 1
        }
        return { e: inner, tp: t }
    }

    // A copy of a receiver optRecvOk admits, every node with a fresh id.
    fn cloneRecv(tp: TP, e: AExpr) -> RExpr {
        let t: TP = tp
        let k2: AExprK = e.k
        const ob: AExpr | not = recvObj(e)
        if (ob is given) {
            const co: RExpr = cloneRecv(t, ob)
            t = co.tp
            const ix: AExpr | not = recvIdx(e)
            if (ix is given) {
                const ci: RExpr = cloneRecv(t, ix)
                t = ci.tp
                k2 = AExprK.Index(co.e, ci.e)
            } else {
                k2 = AExprK.Member(co.e, recvName(e))
            }
        }
        const out: AExpr = { nid: t.nid, span: e.span, k: k2 }
        return { e: out, tp: bumpId(t) }
    }

    fn recvObj(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Member(obj: o) :> o
            .Index(obj: o) :> o
            .Name(name: x) :> not
            .At(name: x) :> not
            .AtItem :> not
            .HashRef(id: x) :> not
            .Num(raw: x) :> not
            .Str(v: x) :> not
            .Bool(v: x) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: x) :> not
            .Call(callee: x) :> not
            .Unary(op: x) :> not
            .Binary(op: x) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: x) :> not
            .ObjectLit(props: x) :> not
            .Spread(e: x) :> not
            .Lambda(params: x) :> not
            .BlockLambda(params: x) :> not
            .Sql(q: x) :> not
            .Handled(h: x) :> not
            .Template(quasis: x) :> not
            .Foreign(f: x) :> not
        }
    }

    fn recvIdx(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Index(obj: o, idx: i) :> i
            .Member(obj: x) :> not
            .Name(name: x) :> not
            .At(name: x) :> not
            .AtItem :> not
            .HashRef(id: x) :> not
            .Num(raw: x) :> not
            .Str(v: x) :> not
            .Bool(v: x) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: x) :> not
            .Call(callee: x) :> not
            .Unary(op: x) :> not
            .Binary(op: x) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: x) :> not
            .ObjectLit(props: x) :> not
            .Spread(e: x) :> not
            .Lambda(params: x) :> not
            .BlockLambda(params: x) :> not
            .Sql(q: x) :> not
            .Handled(h: x) :> not
            .Template(quasis: x) :> not
            .Foreign(f: x) :> not
        }
    }

    fn recvName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Member(obj: o, name: n) :> n
            .Index(obj: x) :> ""
            .Name(name: x) :> ""
            .At(name: x) :> ""
            .AtItem :> ""
            .HashRef(id: x) :> ""
            .Num(raw: x) :> ""
            .Str(v: x) :> ""
            .Bool(v: x) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: x) :> ""
            .Call(callee: x) :> ""
            .Unary(op: x) :> ""
            .Binary(op: x) :> ""
            .Ternary(test: x) :> ""
            .Assign(target: x) :> ""
            .ArrayLit(elems: x) :> ""
            .ObjectLit(props: x) :> ""
            .Spread(e: x) :> ""
            .Lambda(params: x) :> ""
            .BlockLambda(params: x) :> ""
            .Sql(q: x) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: x) :> ""
            .Foreign(f: x) :> ""
        }
    }

    // =========================================================================
    // s451 (Ue) — the error model's surface forms (SPEC §19): `e?` (§19.5.1
    // "propagation-expr ::= expression '?'"), `e !{ arms }` (§19.4.3 item 3),
    // `match e { arms }` (§19.7.1), and the arms the last two share ("The `!{}`
    // error-handler arms share the match arm-arrow rule (lockstep)", §19 alias
    // note). What `e` is — whether it is failable, which enum the arms name —
    // is analyze's. Arm syntax: an optional leading `|`; a pattern `.V`, `::V`,
    // `.V(a, _)`, `_` or `else` (canonical `.V` / `else`, aliases `::V` / `_`);
    // `:>` (the deprecated `=>` / `->` parse identically and are marked
    // `legacy`, W-MATCH-ARROW-LEGACY); a `{ block }` or ONE expression, which
    // ends at the arms' `}`, a `|`, or the end of its line (§7.2.2).
    // =========================================================================
    // s469 (§7.2.2 rule 4, RULED "Attach to the line above"): `!{` after an
    // expression handles it, on its line or the next — a line break is
    // whitespace, and `!{ … }` cannot start a statement (`x⏎!{ … }` handles
    // `x`). `!=` is its own token.
    fn isHandlerOpen(tp: TP) -> boolean {
        const a: PTok = cur(tp)
        const b: PTok = peekAt(tp, 1)
        if (a.cls != TC.Punct || !tk(a, "!") || b.cls != TC.Punct || !tk(b, "{")) return false
        return tp.i > 0
    }

    // s469 (§7.2.2 rule 4, RULED: "`?` is decided by adjacency only: glued
    // `x?` is propagation, spaced `?` is the conditional. The end-of-line test
    // is dropped"). A `?` written directly against what it follows is the §19.5
    // postfix propagation operator, whatever comes after it; a `?` with
    // whitespace before it (a line break is whitespace) is the conditional's.
    // `?{` (touching) is the SQL sigil (§8.1), never propagation.
    fn isPropagate(tp: TP) -> boolean {
        const a: PTok = cur(tp)
        if (a.cls != TC.Punct || !tk(a, "?")) return false
        if (tp.i == 0) return false
        if (!touching(peekAt(tp, -1), a)) return false
        return !isSqlOpen(tp)
    }

    // s460: `is given` / `is not` after what it tests. s469 (§7.2.2 rule 4,
    // RULED): on its line or the next — `is given` / `is not` cannot start a
    // statement, so `x⏎is given` tests `x`.
    // s462: `is some` too — the SOFT-DEPRECATED spelling of `is given`
    // (§42.2.2a, §63.1 Stage 1): it reads as `is given` and surfaces
    // W-IS-SOME-DEPRECATED (`someLint`). §63.5: rejecting it would be a
    // conformance bug in this implementation, not a stricter language.
    fn isPresenceTest(tp: TP) -> boolean {
        if (!isWord(tp, "is")) return false
        if (tp.i == 0) return false
        const n: TP = adv(tp)
        return isWord(n, "given") || isWord(n, "not") || isWord(n, "some")
    }

    // s469 (§7.2.2 rule 5, F4 (ii)): after an expression, does the NEXT LINE
    // start with `(`, `[` or a template — a continuation across the line break,
    // which the language refuses? (On the same line `(` is a call, a touching
    // `[` an index and a template a tagged template, read above; a SPACED
    // same-line `x [y]` still ends the expression — INTERIM, no ruling.)
    fn splitContinuesAt(tp: TP) -> boolean {
        const t: PTok = cur(tp)
        if (tp.i == 0) return false
        if (t.line == endLine(peekAt(tp, -1))) return false
        if (t.cls == TC.TChunk) return true
        if (t.cls != TC.Punct) return false
        if (tk(t, "[")) return true
        if (!tk(t, "(")) return false
        // a `( … ) :>` line is an arm head (a tuple pattern, §18), not a
        // continuation — left to the arm list (unchanged)
        return !tupleArmHeadAt(tp.toks, tp.i)
    }

    // Does `( … )` at token `i` close and then meet an arm separator?
    fn tupleArmHeadAt(ts: PTok[], i: int) -> boolean {
        let j: int = i
        let depth: int = 0
        while (j < ts.length && ts[j].cls != TC.End) {
            if (ts[j].cls == TC.Punct && tk(ts[j], "(")) depth = depth + 1
            if (ts[j].cls == TC.Punct && tk(ts[j], ")")) {
                depth = depth - 1
                if (depth == 0) return sepTokAt(ts, j + 1)
            }
            j = j + 1
        }
        return false
    }

    // E-STMT-SPLIT-CONTINUATION, with the ruled message, at the EMPTY span at the
    // end of the line above (the end of its last token) — where the `;` goes,
    // so the span is the fix-it.
    fn splitContinuation(tp: TP) -> TP {
        const last: PTok = peekAt(tp, -1)
        const t: PTok = cur(tp)
        // (one report per place — a region read twice reports once)
        for (const d0 of tp.diags) { if (d0.code == "E-STMT-SPLIT-CONTINUATION" && d0.span.start == last.end) return tp }
        let what: string = "`" + t.text + "`"
        if (t.cls == TC.TChunk) what = "a template"
        const msg: string = "add `;` to the line above, or join the lines — the next line starts with " + what + ", which would continue the expression above it (a call, an index or a tagged template); scrml refuses that reading rather than guess (§7.2.2 rule 5)"
        const d: Diag = newDiag("E-STMT-SPLIT-CONTINUATION", msg, tp.file, mkSpan(last.end, last.end))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // s462 — W-IS-SOME-DEPRECATED (§42.2.2a, Info; one per site): the
    // soft-deprecated `is some`, read as `is given`. The span runs from the
    // `is` through `some`. A lint only — the test is unchanged.
    fn someLint(tp: TP, isTok: PTok, someTok: PTok) -> TP {
        const msg: string = "`x is some` is the soft-deprecated spelling of `x is given` (§42.2.2a). Write `is given` — it means the same and compiles to the same program. `scrml fix` rewrites it (rule `is-some`)."
        const d: Diag = newDiag("W-IS-SOME-DEPRECATED", msg, tp.file, mkSpan(isTok.start, someTok.end))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    fn handledExpr(tp: TP, start: int, subject: AExpr, how: AHow) -> RExpr {
        return mkE(tp, start, AExprK.Handled({ subject: handledSql(subject), how: how }))
    }

    // `subject !{ arms }` — at the `!`.
    fn parseGuard(r: RExpr, start: int) -> RExpr {
        const arms: RArms = parseArms(adv(r.tp), true, "")
        return handledExpr(arms.tp, start, r.e, AHow.Guard(arms.arms))
    }

    // `match subject { arms }` — at `match`.
    fn parseMatch(tp: TP, start: int) -> RExpr {
        const subj: RExpr = parseTernary(adv(tp))
        if (!isP(subj.tp, "{")) {
            const d: TP = diagAt(subj.tp, "E-PARSE-EXPECTED", "expected `{` to open the `match` arms, found `" + cur(subj.tp).text + "`", cur(subj.tp))
            return mkE(d, start, AExprK.Recovered)
        }
        const arms: RArms = parseArms(subj.tp, false, subjectName(subj.e))
        return handledExpr(arms.tp, start, subj.e, AHow.MatchOn(arms.arms))
    }

    // A query the handling forms take as their subject is HANDLED there — the
    // flag analyze's §19.8.3 rule reads (E-ERROR-002 only for an unhandled one).
    fn handledSql(e: AExpr) -> AExpr {
        const k: AExprK = e.k
        const q: ASql | not = sqlOf(k)
        if (q is not) return e
        return { nid: e.nid, span: e.span, k: AExprK.Sql({ chunks: q.chunks, params: q.params, mode: q.mode, nobatch: q.nobatch, handled: true }) }
    }

    type RArms:struct = { arms: AArm[], tp: TP }
    type RPat:struct = { pat: APat, tp: TP }
    type RArmBody:struct = { body: AArmBody, lifted: boolean, bare: boolean, tp: TP }

    // At `{`: the arms, through the matching `}`. ONE arm parser for `!{}`
    // and `match` (S452 ruling c: "`!{}` handler arms use the SAME grammar as
    // `match` arms", §18.2). `guard`: the arms of a `!{}` handler — the only
    // place the legacy spellings are read. The leading `|` before an arm is
    // the soft-deprecated legacy spelling OF A `!{}` ARM ONLY (S452 ruling c,
    // §19.4.5) and parses identically — the arm built is the arm without the
    // `|` — surfacing W-ARM-PIPE-LEGACY (Info; one per arm, `pipeLint`); the
    // paren-free binder (`| .V m :>`) is read only after that `|`. A `match` arm takes no `|` (§18.2 `match-arm ::=
    // arm-pattern …`) — E-PARSE-ARM. (Engine message arms, §51.0.S, are not
    // parsed here.)
    //
    // s469 — the arm list is a COMMA list (dpa-073 F2 (iii) + F2 (i), S469):
    // `match x { .A :> 1, .B :> 2, }` — a `,` after every arm, block arms
    // included, the trailing one optional. The bootstrap ENFORCES it (dpa-073
    // F5 (4)): every arm after the first that does not follow a `,` is
    // E-MATCH-ARM-SEPARATOR (missingArmComma), so a newline-separated list is
    // refused, not read. (impl#1 keeps reading newline-separated arms — a
    // carried divergence; the bootstrap's OWN source is compiled by impl#1 and
    // stays in impl#1's dialect.)
    fn parseArms(tp: TP, guard: boolean, subj: string) -> RArms {
        let t: TP = expectP(tp, "{")
        let arms: AArm[] = []
        let lastComma = false
        let prevEnd: int = 0
        let gheads: GHead[] = []
        while (!isP(t, "}") && !atEnd(t)) {
            if (isP(t, ",")) {
                // a `,` with no arm before it (`{ , .A :> 1 }`, `.A :> 1,, .B …`):
                // one report, then the list goes on
                t = adv(diagAt(t, "E-PARSE-ARM", "a `,` with no arm before it — an arm list puts one `,` after each arm (dpa-073 F2)", cur(t)))
            } else {
                if (arms.length > 0 && !lastComma) t = missingArmComma(t, prevEnd)
                const before: int = t.i
                let piped = false
                const pipe: PTok = cur(t)
                if (isP(t, "|")) {
                    if (!guard) t = diagAt(t, "E-PARSE-ARM", "a `match` arm takes no leading `|` (§18.2) — write `.V(x) :> …` (the `|` is a legacy spelling of a `!{}` handler arm only)", cur(t))
                    piped = true
                    t = adv(t)
                }
                const astart: int = cur(t).start
                const pfrom: int = t.i
                const dfrom: int = t.diags.length
                // s478 — a `given x :>` arm (§42.2.3, soft-deprecated): its head is
                // read here (givenArmHead); what the arm becomes is decided once the
                // list is read (givenArms). `given :>` is a bare binder named
                // `given`, not this.
                const isGiven: boolean = !guard && !piped && isWord(t, "given") && !sepAt(t, 1)
                let gh: GHead = { idx: arms.length, names: [], written: "", bad: false, start: 0, sepEnd: 0, tp: t }
                let rp: RPat = { pat: APat.PWild, tp: t }
                if (isGiven) {
                    gh = givenArmHead(t, arms.length, true)
                    rp = { pat: APat.PWild, tp: gh.tp }
                } else {
                    rp = parsePattern(t, guard && piped)
                }
                t = rp.tp
                // r2: the lint names a rewrite, so only for an arm that PARSED — a
                // non-empty pattern with no diagnostic of its own, followed by its
                // separator (not an unsupported alternation, not error recovery)
                const patOk: boolean = t.i > pfrom && t.diags.length == dfrom && sepAt(t, 0)
                if (guard && piped && patOk) t = pipeLint(t, pipe, pfrom, rp.pat)
                let legacy = false
                const c: PTok = cur(t)
                const g: PTok = peekAt(t, 1)
                if (c.cls == TC.Punct && tk(c, ":") && tk(g, ">") && touching(c, g)) {
                    t = adv(adv(t))
                } else if (c.cls == TC.Punct && tk(c, "=>")) {
                    legacy = true
                    t = adv(t)
                } else if (c.cls == TC.Punct && tk(c, "-") && tk(g, ">") && touching(c, g)) {
                    legacy = true
                    t = adv(adv(t))
                } else if (c.cls == TC.Punct && tk(c, "|") && !patStartAt(adv(t))) {
                    // S478 open-Qs ruling item 15 — §18.10 (amended S478): "The compiler SHALL
                    // also emit E-SYNTAX-011 when a `|` after an arm pattern is followed by
                    // something that is not a pattern (`.Admin | p.active :> …`): that is the
                    // same guard, spelled with a pipe."
                    t = diagAt(t, "E-SYNTAX-011", "a match arm has no guard clause in v1 (§18.10): `| " + cur(adv(t)).text + "…` after the arm's pattern is a guard, not a second pattern — match the variant, then branch inside the arm body", c)
                    while (!atEnd(t) && !isP(t, "}") && !sepAt(t, 0) && cur(t).line == c.line) { t = adv(t) }
                    if (sepAt(t, 0)) t = adv(t)
                    if (isP(t, ">")) t = adv(t)
                } else if (c.cls == TC.Punct && tk(c, "|")) {
                    // s452 r3 (LOW-D): `.A | .B :>` — §18.2's arm-pattern alternation
                    t = diagAt(t, "E-PARSE-ARM", "alternation `|` between patterns (`.A | .B :> …`, §18.2) is not yet supported in the bootstrap — write one arm per pattern", c)
                    // s452 r4: skip the rest of the alternation through its separator (one report, no follow-on E-PARSE-EXPR)
                    while (!atEnd(t) && !isP(t, "}") && !sepAt(t, 0) && cur(t).line == c.line) { t = adv(t) }
                    if (sepAt(t, 0)) t = adv(t)
                    if (isP(t, ">")) t = adv(t)
                } else if (!isGiven || !gh.bad) {
                    t = diagAt(t, "E-PARSE-ARM", "expected `:>` after the arm's pattern, found `" + c.text + "`", c)
                }
                if (isGiven) gheads = gheads.concat([gh])
                const rb: RArmBody = parseArmBody(t, !guard)
                t = rb.tp
                const arm: AArm = { nid: t.nid, span: spanFrom(t, astart), pat: rp.pat, body: rb.body, legacy: legacy, lifted: rb.lifted, bare: rb.bare }
                arms = arms.concat([arm])
                t = bumpId(t)
                lastComma = false
                if (t.i > 0) prevEnd = t.toks[t.i - 1].end
                if (isP(t, ",")) {
                    lastComma = true
                    t = adv(t)
                }
                if (t.i == before) t = adv(t)
            }
        }
        if (gheads.length > 0) return givenArms(arms, gheads, subj, expectP(t, "}"))
        return { arms: arms, tp: expectP(t, "}") }
    }

    // s478 — a `match` subject that is a bare name, as a `given` head writes
    // it (`n`, `@c`); "" for any other subject.
    fn subjectName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> n
            .At(name: n) :> "@" + n
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: x) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Index(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: x) :> ""
            .Assign(target: x) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Lambda(params: ps) :> ""
            .BlockLambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .HashRef(id: hr0) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // s478 — a `given` arm's head (§42.2.3): `idx` the arm's index in its list,
    // `names` the head's names as written (`n`, `@c`), `written` them joined;
    // `bad`: not an identifier-list followed by a separator (E-SYNTAX-044 /
    // E-SYNTAX-045, reported by givenArmHead); `start` the `given`, `sepEnd`
    // the end of the head.
    type GHead:struct = { idx: int, names: string[], written: string, bad: boolean, start: int, sepEnd: int, tp: TP }

    // At `given` in a `match` arm list. §42.2.3: "A `given` head SHALL be
    // `given` followed by an identifier-list and then the separator `:>` (or
    // the deprecated `=>`). Any other head SHALL be compile error
    // **E-SYNTAX-044** … a property path …, a comparison, call or other
    // expression …, a head with no name (`given (cond) :>`), and a head with no
    // separator … on a `given` ARM of a `match`, `->` is the §18.2 deprecated
    // arm-separator alias and is accepted"; "The rebind head `given <name> =
    // <expr> :>` is E-SYNTAX-045 instead"; "A refused head is the site's one
    // diagnostic". The rest of a refused head on its line is skipped, up to
    // its separator (left for the arm list to read). `arm`: a `match` arm's
    // head (else a markup-`${}` guard's, parseMarkupGiven) — the message only.
    fn givenArmHead(tp: TP, idx: int, arm: boolean) -> GHead {
        const gtok: PTok = cur(tp)
        let t: TP = adv(tp)
        let names: string[] = []
        let written: string = ""
        let going: boolean = true
        while (going) {
            const n: PTok = cur(t)
            const n2: PTok = peekAt(t, 1)
            let w: string = ""
            if (n.cls == TC.At && touching(n, n2) && (n2.cls == TC.Ident || n2.cls == TC.Keyword) && n.line == gtok.line) {
                w = "@" + n2.v
                t = adv(adv(t))
            } else if (n.cls == TC.Ident && n.line == gtok.line) {
                w = n.v
                t = adv(t)
            }
            if (w == "") {
                going = false
            } else {
                names = names.concat([w])
                if (written != "") written = written + ", "
                written = written + w
                // s478 r1 (review MED-1): a later name may be a cell (`, @b`), as the first may
                const a1: PTok = peekAt(t, 1)
                const a2: PTok = peekAt(t, 2)
                if (isP(t, ",") && a1.line == gtok.line && (a1.cls == TC.Ident || (a1.cls == TC.At && touching(a1, a2) && (a2.cls == TC.Ident || a2.cls == TC.Keyword)))) {
                    t = adv(t)
                } else {
                    going = false
                }
            }
        }
        const c: PTok = cur(t)
        if (names.length > 0 && c.line == gtok.line && sepAt(t, 0)) {
            let se: int = c.end
            if (!tk(c, "=>")) se = peekAt(t, 1).end
            return { idx: idx, names: names, written: written, bad: false, start: gtok.start, sepEnd: se, tp: t }
        }
        let found: string = "the end of the line"
        if (c.line == gtok.line && c.cls != TC.End) found = "`" + c.text + "`"
        if (names.length > 0 && c.cls == TC.Punct && tk(c, "=") && c.line == gtok.line) {
            t = diagAt(t, "E-SYNTAX-045", "a `given` head narrows `" + written + "` in place — it takes no `= <expr>` (§42.2.3: no variable is rebound to a new name). Declare the value first (`let " + names[0] + " = <expr>`), then name it after `given`.", c)
        } else if (arm) {
            t = diagAt(t, "E-SYNTAX-044", "a `given` arm's head is a list of names followed by `:>` (`given x :> …`, §42.2.3); found " + found + " instead. To take an arm when a value is present, write `else :>` after the `not :>` arm; a condition is `if (<cond>) { … }`.", c)
        } else {
            t = diagAt(t, "E-SYNTAX-044", "a `given` head is a list of names followed by `:>` (`given x, y :> { … }`, §42.2.3); found " + found + " instead. To show markup when a condition holds, write `if (<cond>) { … }`; when a value is present, `if (x is given) { … }`.", c)
        }
        let skipping: boolean = true
        while (skipping) {
            const x: PTok = cur(t)
            if (x.cls == TC.End || x.line != gtok.line || sepAt(t, 0) || isP(t, "{") || isP(t, "}") || isP(t, ",")) {
                skipping = false
            } else {
                t = adv(t)
            }
        }
        return { idx: idx, names: names, written: written, bad: true, start: gtok.start, sepEnd: cur(t).end, tp: t }
    }

    // s478 — what each `given` arm of one `match` arm list becomes. §42.2.3:
    // the `given x :>` match arm "is soft-deprecated … during the window it
    // parses, lowers and runs exactly as this section states, and every site
    // surfaces **W-GIVEN-PRESENCE-DEPRECATED**", its canonical form "`match x {
    // not :> A  given x :> B }` → `match x { not :> A  else :> B }` — the
    // present case is the arm after `not :>`". So the arm that is the LAST arm,
    // after a `not :>` arm, naming the subject itself — the shape `scrml fix`
    // rewrites ("only when the arm is the last arm, the match has a `not :>`
    // arm, and the arm names the scrutinee itself") — is read as that `else :>`
    // arm, with the W-code. Any other `given` arm is a presence GUARD between
    // patterns, which the bootstrap does not build: refused by name (INTERIM —
    // the capable form is a guard pattern carried through analyze, lower and
    // the printer; gap g-boot-given-guard-arm-unbuilt-s478). A refused or a
    // malformed arm's match keeps only that arm, its body a placeholder
    // (refusedArm), so its one diagnostic is the site's only one.
    fn givenArms(arms: AArm[], gheads: GHead[], subj: string, tp: TP) -> RArms {
        let t: TP = tp
        let legacyOff: int[] = []
        for (const g of gheads) {
            let sawNot: boolean = false
            let j: int = 0
            while (j < g.idx) {
                if (patIsNot(arms[j].pat)) sawNot = true
                j = j + 1
            }
            const last: boolean = g.idx == arms.length - 1
            if (g.bad) {
                // s478 r1 (review LOW-2): "A refused head is the site's one diagnostic" (§42.2.3) —
                // the match keeps only this arm, as a placeholder (no coverage report, no typing
                // of a body whose names the head never narrowed); its E-SYNTAX-044/045 stops the build
                return refusedArm(arms[g.idx], t)
            } else if (last && sawNot && g.names.length == 1 && subj != "" && g.names[0] == subj) {
                const msg: string = "the presence arm `given " + g.written + " :>` is deprecated (§42.2.3). Write `else :>` — after the `not :>` arm it takes the same present case and narrows `" + g.written + "` the same way. Run `scrml fix` to rewrite it. It compiles as before during the deprecation window (§63)."
                const d: Diag = newDiag("W-GIVEN-PRESENCE-DEPRECATED", msg, t.file, mkSpan(g.start, g.sepEnd))
                t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d]), file: t.file, ns: t.ns, inFn: t.inFn }
                // s478 r1 (review LOW-1): the deprecation is the site's one diagnostic (§42.2.3, the
                // W-GIVEN-ARROW-LEGACY row) — a `=>` / `->` head adds no W-MATCH-ARROW-LEGACY
                legacyOff = legacyOff.concat([g.idx])
            } else {
                const msg: string = "a `given " + g.written + " :>` arm other than the last arm after a `not :>` arm naming the subject itself is a presence guard between patterns, which is not in the bootstrap yet (§42.2.3). Test presence before the match (`if (" + g.names[0] + " is given) { … }`), or, over a `T | not` subject, write `not :>` then `else :>`."
                const d: Diag = newDiag("E-BOOTSTRAP-UNSUPPORTED", msg, t.file, mkSpan(g.start, g.sepEnd))
                t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d]), file: t.file, ns: t.ns, inFn: t.inFn }
                // the refused match keeps one arm — this one's, as a placeholder —
                // so no other arm's coverage (or its absence) reports anything, nor its body
                return refusedArm(arms[g.idx], t)
            }
        }
        if (legacyOff.length == 0) return { arms: arms, tp: t }
        let out: AArm[] = []
        let k: int = 0
        for (const a of arms) {
            let off: boolean = false
            for (const x of legacyOff) {
                if (x == k) off = true
            }
            if (off) {
                out = out.concat([{ nid: a.nid, span: a.span, pat: a.pat, body: a.body, legacy: false, lifted: a.lifted, bare: a.bare }])
            } else {
                out = out.concat([a])
            }
            k = k + 1
        }
        return { arms: out, tp: t }
    }

    // s478 r1 (review LOW-2) — the one arm a refused `given` arm's match keeps: its
    // pattern, its body a parse placeholder (Recovered — nothing downstream types it;
    // the refusal, an Error, stops the build), no legacy mark.
    fn refusedArm(a: AArm, tp: TP) -> RArms {
        const r: RExpr = mkE(tp, a.span.start, AExprK.Recovered)
        const arm: AArm = { nid: a.nid, span: a.span, pat: a.pat, body: AArmBody.ArmExpr(r.e), legacy: false, lifted: false, bare: false }
        return { arms: [arm], tp: r.tp }
    }

    fn patIsNot(p: APat) -> boolean {
        return match p {
            .PNot :> true
            .PName(name: n) :> false
            .PWild :> false
            .PWhole(bind: b) :> false
            .PBare(bind: b) :> false
            .PLit(e: x) :> false
        }
    }

    // s469 — E-MATCH-ARM-SEPARATOR (its dpa-073 F2 meaning, SPEC §18.2): an arm
    // that does not follow a `,`. One report per missing `,`, its span the empty
    // span at the end of the arm before — where the `,` goes. (No `match`
    // keyword followed by a subject and `{` inside this string: impl#1, which
    // compiles this file, rewrites that shape even inside a literal.)
    fn missingArmComma(tp: TP, at: int) -> TP {
        const msg: string = "Expected `,` between two arms — insert `,` after the arm before this one. An arm list is a comma list: a `,` after every arm, block arms included, the trailing one optional (`{ .A :> 1, .B :> 2, }`); a newline does not separate arms (dpa-073 F2, §18.2)."
        const d: Diag = newDiag("E-MATCH-ARM-SEPARATOR", msg, tp.file, mkSpan(at, at))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // s452 — W-ARM-PIPE-LEGACY (§19.4.5, Info; one per arm): the `|`-led `!{}`
    // arm whose pattern is tokens `from` up to `tp.i`. The message is §19.4.5's:
    // the arm as written, its canonical rewrite (the `|` dropped; a paren-free
    // binder `.V m` written `.V(m)`), `scrml fix` and the section. The span runs
    // from the `|` through the pattern. A lint only — the arm is unchanged.
    fn pipeLint(tp: TP, pipe: PTok, from: int, pat: APat) -> TP {
        const written: string = tokText(tp, from, tp.i)
        let canonical: string = written
        if (parenFreeBinder(pat) && tp.i - 1 > from) {
            canonical = tokText(tp, from, tp.i - 1) + "(" + tp.toks[tp.i - 1].text + ")"
        }
        let end: int = pipe.end
        if (tp.i > from) end = tp.toks[tp.i - 1].end
        const msg: string = "Arm '| " + written + " :>' uses the deprecated leading '|'. A pattern arm is a match arm (§18.2): write '" + canonical + " :>'. Run 'scrml fix' to rewrite every site (§19.4.5)."
        const d: Diag = newDiag("W-ARM-PIPE-LEGACY", msg, tp.file, mkSpan(pipe.start, end))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // The source text of tokens `from` up to (not including) `to`, with a
    // space between two tokens that do not touch.
    fn tokText(tp: TP, from: int, to: int) -> string {
        let s: string = ""
        let i: int = from
        while (i < to) {
            const x: PTok = tp.toks[i]
            if (i > from && !touching(tp.toks[i - 1], x)) s = s + " "
            s = s + x.text
            i = i + 1
        }
        return s
    }

    // Is the pattern the paren-free payload binder (`.V m` — `parens` false,
    // one binder)?
    fn parenFreeBinder(p: APat) -> boolean {
        return match p {
            .PName(binds: bs, parens: pr) :> !pr && bs.length == 1
            .PWild :> false
            .PWhole(bind: b) :> false
            .PBare(bind: b) :> false
            .PNot :> false
            .PLit(e: x) :> false
        }
    }

    // s452: SPEC §19.4.3 ruling 2 settled what `| .V m :>` binds (the variant's
    // PAYLOAD, under §18.7's positional arity); the bootstrap does not build the
    // parenthesis-free payload binder yet, so it stays refused — never read as
    // something else.
    fn binderReason() -> string {
        return "an arm pattern has no parenthesis-free payload binder (§18.2: `variant-pattern ::= ('.' | '::') VariantName ('(' binding-list ')')?`) — write `.V(m)` (`| .V m :>` is read only as the legacy spelling of a `!{}` handler arm, after its `|`)"
    }

    // An arm separator (`:>`, or the deprecated `=>` / `->`) at token offset `k`.
    fn sepAt(tp: TP, k: int) -> boolean {
        const s: PTok = peekAt(tp, k)
        const g: PTok = peekAt(tp, k + 1)
        if (s.cls != TC.Punct) return false
        if (tk(s, ":") && tk(g, ">") && touching(s, g)) return true
        if (tk(s, "=>")) return true
        return tk(s, "-") && tk(g, ">") && touching(s, g)
    }

    // An arm's pattern.
    // S478 (open-Qs ruling item 15, §18.10 amended) — does a PATTERN start at
    // the cursor (the token after an arm's `|`)? The pattern starts of §18.2 /
    // §18.16.1: `.V` / `::V` / a bare variant token, `_`, `else`, `not` (impl#1's
    // set, type-system.ts altRhsIsVariantPattern); plus a literal, for a
    // literal-subject match (§18.16.1 — impl#1 reads `| true` / `| 1` as a guard,
    // so the two compilers refuse that shape under different codes); plus (fix
    // round 1, review MED-1) a qualified variant `TypeName.Variant` /
    // `TypeName::Variant` / `ns.TypeName.Variant` (§18.2 `variant-pattern ::= …
    // | TypeName ('.' | '::') VariantName`), read by its spelling — a capitalized
    // type name, `.` or `::`, a capitalized variant name — since a guard's member
    // read (`p.active`) is a lowercase value. Anything else after the `|` is a
    // guard (`.Admin | p.active :>`), E-SYNTAX-011.
    fn patStartAt(tp: TP) -> boolean {
        const a: PTok = cur(tp)
        const b: PTok = peekAt(tp, 1)
        if (a.cls == TC.Variant) return true
        if (qualPatStartAt(tp)) return true
        if (a.cls == TC.Punct && tk(a, ".") && (b.cls == TC.Ident || b.cls == TC.Keyword) && touching(a, b)) return true
        if (a.cls == TC.Punct && tk(a, ":") && tk(b, ":") && touching(a, b)) return true
        if ((a.cls == TC.Ident || a.cls == TC.Keyword) && (a.v == "_" || a.v == "else" || a.v == "not")) return true
        if (a.cls == TC.Str || a.cls == TC.Num) return true
        if ((a.cls == TC.Keyword || a.cls == TC.Ident) && (a.v == "true" || a.v == "false")) return true
        return a.cls == TC.Punct && tk(a, "-") && b.cls == TC.Num && touching(a, b)
    }

    fn capName(t: PTok) -> boolean {
        if (t.cls != TC.Ident && t.cls != TC.Keyword) return false
        const c: string = t.v.substring(0, 1)
        return c >= "A" && c <= "Z"
    }

    // `TypeName.Variant` / `TypeName::Variant` / `ns.TypeName.Variant` at the cursor (patStartAt).
    fn qualPatStartAt(tp: TP) -> boolean {
        let k: int = 0
        const ph: NsHead = nsHeadAt(tp, 0)
        if (ph.n > 0) k = 2
        const a: PTok = peekAt(tp, k)
        const b: PTok = peekAt(tp, k + 1)
        if (!capName(a) || !touching(a, b)) return false
        if (b.cls == TC.Variant) return b.v.substring(0, 1) >= "A" && b.v.substring(0, 1) <= "Z"
        if (b.cls != TC.Punct) return false
        if (tk(b, ".")) {
            const n: PTok = peekAt(tp, k + 2)
            return capName(n) && touching(b, n)
        }
        if (tk(b, ":")) {
            const b2: PTok = peekAt(tp, k + 2)
            const n2: PTok = peekAt(tp, k + 3)
            return tk(b2, ":") && touching(b, b2) && capName(n2) && touching(b2, n2)
        }
        return false
    }

    fn parsePattern(tp: TP, guard: boolean) -> RPat {
        const a: PTok = cur(tp)
        const b: PTok = peekAt(tp, 1)
        if (a.cls == TC.Variant) return patBinds(adv(tp), a, a.v, guard, "", ".")
        if (a.cls == TC.Punct && tk(a, ".") && (b.cls == TC.Ident || b.cls == TC.Keyword) && touching(a, b)) return patBinds(adv(adv(tp)), b, b.v, guard, "", ".")
        if (a.cls == TC.Punct && tk(a, ":") && tk(b, ":") && touching(a, b)) {
            const n: PTok = peekAt(tp, 2)
            if ((n.cls == TC.Ident || n.cls == TC.Keyword) && touching(b, n)) return patBinds(adv(adv(adv(tp))), n, n.v, guard, "", "::")
        }
        if ((a.cls == TC.Ident && a.v == "_") || (a.cls == TC.Keyword && a.v == "else")) {
            const t: TP = adv(tp)
            const nx: PTok = cur(t)
            // s452 — `_ err` (§18.6.1, the whole-error binder) / `else err`
            // (E-MATCH-BARE-BINDER, analyze's): the wildcard with one binder
            if (nx.cls == TC.Ident && nx.line == a.line && nx.v != "_") {
                const bind: ABind = { nid: t.nid, span: mkSpan(nx.start, nx.end), name: nx.v }
                return { pat: APat.PWhole(bind, a.v == "else"), tp: bumpId(adv(t)) }
            }
            return { pat: APat.PWild, tp: t }
        }
        // s469 — the absence arm `not :>` (§18.2: "`not` is not a bare name
        // here: it is the absence arm (§42)"; §42.2.3)
        if ((a.cls == TC.Ident || a.cls == TC.Keyword) && a.v == "not" && sepAt(tp, 1)) return { pat: APat.PNot, tp: adv(tp) }
        // s469 — a literal arm (§18.16.1: a string, number or boolean literal)
        if ((a.cls == TC.Str || a.cls == TC.Num || ((a.cls == TC.Keyword || a.cls == TC.Ident) && (a.v == "true" || a.v == "false"))) && sepAt(tp, 1)) {
            const rl: RExpr = parsePrimary(tp)
            return { pat: APat.PLit(rl.e), tp: rl.tp }
        }
        if (a.cls == TC.Punct && tk(a, "-") && b.cls == TC.Num && touching(a, b) && sepAt(tp, 2)) {
            const rn: RExpr = mkE(adv(adv(tp)), a.start, AExprK.Num("-" + b.v))
            return { pat: APat.PLit(rn.e), tp: rn.tp }
        }
        // s452 — a bare identifier as the WHOLE pattern (`err :>`, §18.2): a
        // pattern of its own, so analyze reports E-MATCH-BARE-BINDER by name
        if (a.cls == TC.Ident && sepAt(tp, 1)) {
            const bb: ABind = { nid: tp.nid, span: mkSpan(a.start, a.end), name: a.v }
            return { pat: APat.PBare(bb), tp: bumpId(adv(tp)) }
        }
        // s469 — `E.V` / `E::V`, a qualified pattern (§18.13: "`TypeName.VariantName`
        // (fully qualified) SHALL always be valid"); analyze checks `E`
        // s475 r1: `m.E.V` — qualified through a namespace import's member enum
        const ph: NsHead = nsHeadAt(tp, 0)
        if (ph.n > 0) {
            const pd: PTok = peekAt(tp, 3)
            const pv: PTok = peekAt(tp, 4)
            if (pd.cls == TC.Variant && touching(peekAt(tp, 2), pd)) return patBinds(adv(adv(adv(adv(tp)))), pd, pd.v, guard, ph.name, ".")
            if (pd.cls == TC.Punct && tk(pd, ".") && (pv.cls == TC.Ident || pv.cls == TC.Keyword) && touching(peekAt(tp, 2), pd) && touching(pd, pv)) return patBinds(adv(adv(adv(adv(adv(tp))))), pv, pv.v, guard, ph.name, ".")
        }
        if (a.cls == TC.Ident && b.cls == TC.Variant && touching(a, b)) return patBinds(adv(adv(tp)), b, b.v, guard, a.v, ".")
        if (a.cls == TC.Ident && b.cls == TC.Punct && tk(b, ".") && touching(a, b)) {
            const qn: PTok = peekAt(tp, 2)
            if ((qn.cls == TC.Ident || qn.cls == TC.Keyword) && touching(b, qn)) return patBinds(adv(adv(adv(tp))), qn, qn.v, guard, a.v, ".")
        }
        if (a.cls == TC.Ident && tk(b, ":") && touching(a, b) && tk(peekAt(tp, 2), ":") && touching(b, peekAt(tp, 2))) {
            const qc: PTok = peekAt(tp, 3)
            if ((qc.cls == TC.Ident || qc.cls == TC.Keyword) && touching(peekAt(tp, 2), qc)) return patBinds(adv(adv(adv(adv(tp)))), qc, qc.v, guard, a.v, "::")
        }
        if (a.cls == TC.Ident && (tk(b, ".") || tk(b, ":")) && touching(a, b)) {
            // `E.V` / `E::V` — a qualified pattern
            let t: TP = diagAt(tp, "E-BOOTSTRAP-UNSUPPORTED", "a qualified arm pattern (`" + a.v + b.text + "…`) is not in the bootstrap — write the bare variant (`.V`), which resolves against the subject's error type", a)
            while (!atEnd(t) && !isP(t, "}") && !(isP(t, ":") && tk(peekAt(t, 1), ">")) && !isP(t, "=>")) { t = adv(t) }
            return { pat: APat.PWild, tp: t }
        }
        return { pat: APat.PWild, tp: diagAt(tp, "E-PARSE-ARM", "expected an arm pattern (`.Variant`, `.Variant(a, b)`, `not`, a literal, `_` or `else`), found `" + a.text + "`", a) }
    }

    // After a pattern's variant name (`nameTok`): its `(binders)`, if written.
    // s479 r1 (LOW-1): `sep` — the separator the pattern was written with before `name` (`.` or `::`),
    // so a report names the pattern as written, qualifier included (`E.Bad(…)`, `m.E.V(…)`, `E::V(…)`).
    fn patBinds(tp: TP, nameTok: PTok, name: string, guard: boolean, qual: string, sep: string) -> RPat {
        const o: PTok = cur(tp)
        if (o.cls == TC.Punct && tk(o, "(") && touching(nameTok, o)) {
            let t: TP = adv(tp)
            let binds: ABind[] = []
            while (!isP(t, ")") && !atEnd(t)) {
                const b: PTok = cur(t)
                if (b.cls != TC.Ident) {
                    t = adv(diagAt(t, "E-PARSE-ARM", "expected a binder name (or `_`) in the pattern's `(…)`, found `" + b.text + "`", b))
                } else {
                    if (binderRepeated(binds, b.v)) t = diagAt(t, "E-SCOPE-REDECLARE", binderDupMsg(b.v, qual + sep + name + "(…)"), b)
                    binds = binds.concat([{ nid: t.nid, span: mkSpan(b.start, b.end), name: b.v }])
                    t = bumpId(adv(t))
                }
                if (isP(t, ",")) t = adv(t)
            }
            return { pat: APat.PName(name, binds, true, qual), tp: expectP(t, ")") }
        }
        // `.V m` — the paren-free payload binder: in a `!{}` arm the legacy
        // spelling of `.V(m)` (§19.4.3 ruling 2: "the same pattern as `| .V(m)
        // :>`"; S452 ruling c: it deprecates with the `|` form) — ONE binder,
        // `parens` false (analyze holds it to §18.7's arity: E-TYPE-021 on a
        // unit or multi-field variant). A `match` arm has no such pattern
        // (§18.2 `variant-pattern ::= ('.' | '::') VariantName ('(' binding-list ')')?`).
        if (o.cls == TC.Ident && o.line == nameTok.line && o.v != "_") {
            if (!guard) {
                const d: TP = diagAt(tp, "E-PARSE-ARM", binderReason(), o)
                return { pat: APat.PName(name, [], false, qual), tp: adv(d) }
            }
            const bnd: ABind = { nid: tp.nid, span: mkSpan(o.start, o.end), name: o.v }
            return { pat: APat.PName(name, [bnd], false, qual), tp: bumpId(adv(tp)) }
        }
        return { pat: APat.PName(name, [], false, qual), tp: tp }
    }

    // s479 — SPEC §7.3.3: "a binder that repeats an earlier binder of the SAME arm is
    // E-SCOPE-REDECLARE, reported at the repeat … The wildcard `_` binds nothing and may repeat"
    // (§18.7; ruling: user-voice S478 open-Qs item 14; code PA-chosen S479).
    // Shared by the `match` / `!{}` pattern (patBinds) and the `<match>` arm (parseArmBinds).
    fn binderRepeated(bs: ABind[], name: string) -> boolean {
        if (name == "_") return false
        for (const x of bs) {
            if (x.name == name) return true
        }
        return false
    }

    fn binderDupMsg(name: string, pat: string) -> string {
        return "`" + name + "` is bound twice in the arm pattern `" + pat + "` — the second binder would silently shadow the first, so the arm would read the wrong field. Give each binder its own name, or `_` for a field the arm does not read (§7.3.3, §18.7)"
    }

    // An arm's body: a `{ block }`, or one expression read up to `armEnd`.
    // s478 — `inMatch`: a `match` arm (not a `!{}` handler arm, §19), whose body
    // may not be a markup element (E-MATCH-ARM-MARKUP-IN-VALUE, §18.0).
    fn parseArmBody(tp: TP, inMatch: boolean) -> RArmBody {
        if (isP(tp, "{")) {
            // s469 — §18.5 (ruling S469 "Compile error (Recommended)", extended to
            // every arm kind by dpa-072 F9): a brace body that is exactly ONE bare
            // shorthand name, `{ foo }` (no `;`), reads both as the object
            // `{ foo: foo }` and as a block whose result is `foo`
            const sh: PTok = peekAt(tp, 1)
            if (sh.cls == TC.Ident && sh.v != "not" && tk(peekAt(tp, 2), "}")) {
                // (read as the one-statement block, with no E-STMT-MISSING-SEMICOLON
                // beside the one report: the shape, not its terminator, is the error)
                const bstart: int = cur(tp).start
                const rs: RStmt = parseStmt(adv(diagAt(tp, "E-MATCH-ARM-SHORTHAND-AMBIGUOUS", shorthandArmReason(sh.v), sh)))
                const close: TP = expectP(rs.tp, "}")
                const sb: ABlock = { nid: close.nid, span: spanFrom(close, bstart), stmts: [rs.s] }
                return { body: AArmBody.ArmBlock(sb), lifted: false, bare: false, tp: bumpId(close) }
            }
            // s475 — §18.5: "A brace body that reads as an object literal is the
            // arm's value … in every position a `match` appears … exactly as
            // `return { … }` and `f({ … })` read it." The object test
            // (armObjectShape) comes before the one-expression brace and the
            // block; the body is then read as the arm's ONE expression, by the
            // expression path below (parsePrimary's object path), ended by armEnd.
            // s475 (#1762 review item 3) — §7.2.2 rule 3: "a `{ … }` holding exactly ONE
            // expression and no `;` at its own top level, written as the body of a
            // `match` or `!{}` arm whose value is used (§18.5) … is that expression";
            // a value `if` is an expression (§17.6 if-as-expression), and value `if`
            // branches already take a nested one (parseValueBranchExpr). Read as that
            // ONE expression, `bare` (the brace is `[Eval(if …)]`, as `{ e }` is). In
            // a STATEMENT-position `match` / `!{}` the brace is a statement list and
            // the `if` a statement `if`: armTails re-reads it so (stmtArmReread).
            if (isWord(adv(tp), "if")) {
                const vb: RArmBlock | not = valueIfBrace(tp)
                if (vb is given) return { body: AArmBody.ArmBlock(vb.b), lifted: false, bare: true, tp: vb.tp }
            }
            if (!armObjectShape(tp)) {
                const rb: RArmBlock = parseArmBlock(tp)
                return { body: AArmBody.ArmBlock(rb.b), lifted: rb.lifted, bare: rb.bare, tp: rb.tp }
            }
        }
        const end: int = armEnd(tp)
        const sub: TP = { toks: tp.toks.slice(0, end).concat([endTokAt(tp.toks[end])]), i: tp.i, nid: tp.nid, diags: tp.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn }
        // §18.2 `leave-stmt` (S462, ruling dpa-068 W1): `arm-body ::= expression |
        // block-body | leave-stmt`. A bare `fail <variant>` / `return [expr]` arm is
        // a one-statement block — it leaves the function exactly as `{ fail … }` /
        // `{ return … }` does. (`fail` was admitted here before the ruling, citing
        // a §19.5.2 spelling S454 had removed; `return` fell through to the
        // expression parser and was reported as an undeclared name, E-SCOPE-001.)
        if (failAhead(sub) || isWord(sub, "return")) {
            const kw: string = cur(sub).text
            const start: int = cur(sub).start
            const rf: RStmt = parseStmt(sub)
            let ft: TP = rf.tp
            if (!atEnd(ft)) ft = diagAt(ft, "E-PARSE-ARM", "unexpected `" + cur(ft).text + "` after the arm's `" + kw + "`", cur(ft))
            const fb: ABlock = { nid: ft.nid, span: spanFrom(ft, start), stmts: [rf.s] }
            return { body: AArmBody.ArmBlock(fb), lifted: false, bare: false, tp: { toks: tp.toks, i: end, nid: ft.nid + 1, diags: ft.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn } }
        }
        // s478 — §19.16.2: "`defer` in … a single-statement (unbraced) `match` /
        // `!{}` arm … — not a stage-1 defer site" (E-DEFER-UNSUPPORTED-SITE): the
        // arm has no written block for the deferred statement to belong to. One
        // report; the rest of the arm is skipped (read as nothing). (`defer` is a
        // keyword where a statement starts — deferAhead, §19.16.1.)
        if (deferAhead(sub)) {
            const dt: TP = diagAt(sub, "E-DEFER-UNSUPPORTED-SITE", "a `defer` that is the whole unbraced body of an arm has no written block to belong to (§19.16.2) — brace the arm (`.V :> { defer …; }`) or move the `defer` to the enclosing block", cur(sub))
            const rd: RExpr = mkE(dt, cur(sub).start, AExprK.Recovered)
            return { body: AArmBody.ArmExpr(rd.e), lifted: false, bare: false, tp: { toks: tp.toks, i: end, nid: rd.tp.nid, diags: rd.tp.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn } }
        }
        // `break` / `continue` are leave statements too (§18.2), but the bootstrap
        // has no loops for them to leave.
        if (isWord(sub, "break") || isWord(sub, "continue")) {
            const bt: TP = diagAt(sub, "E-BOOTSTRAP-UNSUPPORTED", "a `" + cur(sub).text + "` arm (§18.2 leave statement) needs a loop, and loops are not in the bootstrap", cur(sub))
            const rb: RExpr = mkE(bt, cur(sub).start, AExprK.Recovered)
            return { body: AArmBody.ArmExpr(rb.e), lifted: false, bare: false, tp: { toks: tp.toks, i: end, nid: rb.tp.nid, diags: rb.tp.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn } }
        }
        // s478 — §18.0 / §34 E-MATCH-ARM-MARKUP-IN-VALUE: "A JS-style value-match
        // arm (`match expr { .V :> ... }`) has an arm body that is a MARKUP element"
        const r: RExpr = inMatch && cur(sub).cls == TC.Markup && peekAt(sub, 1).cls == TC.End ? parseMarkupValue(sub, true) : parseAssign(sub)
        let st: TP = r.tp
        if (!atEnd(st)) {
            const x: PTok = cur(st)
            st = diagAt(st, "E-PARSE-ARM", "unexpected `" + x.text + "` in an arm — an arm holds one expression or a `{ … }` block", x)
        }
        return { body: AArmBody.ArmExpr(r.e), lifted: false, bare: false, tp: { toks: tp.toks, i: end, nid: st.nid, diags: st.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn } }
    }

    // s469 — an arm's `{ … }` block (§18.5, RULED S469 "block arms yield with
    // `lift`": `.B :> { log(); lift 2 }`). A `lift <expr>` written as the
    // block's LAST statement is the arm's value: the block ends in `Eval(expr)`
    // and the arm is `lifted` (AArm). Speculative: the `lift` is read, and kept
    // only when the block's `}` follows it; any other `lift` goes to parseStmt,
    // which refuses it by name.
    type RArmBlock:struct = { b: ABlock, lifted: boolean, bare: boolean, tp: TP }

    fn parseArmBlock(tp: TP) -> RArmBlock {
        const start: int = cur(tp).start
        const b0: int = hardErrors(tp.diags)
        let t: TP = expectP(tp, "{")
        let stmts: AStmt[] = []
        let lifted = false
        let sawSemi = false
        let bare = false
        while (!isP(t, "}") && !atEnd(t)) {
            const before: int = t.i
            let done = false
            if (isWord(t, "lift") && !isRowTok(peekAt(t, 1))) {
                const kw: PTok = cur(t)
                // s469 r2 — `lift⏎expr`, like `return⏎expr`: refused fail closed
                // until the newline-terminated corpus is migrated (the same PA
                // reading as the split `return` in parseStmt)
                if (peekAt(t, 1).line != kw.line && !tk(peekAt(t, 1), "}") && !tk(peekAt(t, 1), ";")) {
                    const ld: Diag = newDiag("E-STMT-MISSING-SEMICOLON", "Expected `;` to end the statement — a `lift` followed by a line break is refused for now: put the lifted value on the `lift` line. dpa-073 F1 would read `lift⏎expr;` as lifting `expr`; the bootstrap does not guess while newline-terminated code is still being migrated.", t.file, mkSpan(kw.end, kw.end))
                    t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([ld]), file: t.file, ns: t.ns, inFn: t.inFn }
                }
                const v: RExpr = parseAssign(adv(t))
                let t2: TP = v.tp
                if (isP(t2, ";")) t2 = adv(t2)
                if (isP(t2, "}")) {
                    const ls: RStmt = mkS(v.tp, kw.start, AStmtK.Eval(v.e))
                    stmts = stmts.concat([ls.s])
                    t = ls.tp
                    // s469 — `lift <expr>` is a statement: it takes its `;` (dpa-073 F3 (i), F6)
                    if (isP(t, ";")) {
                        t = adv(t)
                    } else if (hardErrors(t.diags) == b0) {
                        t = missingSemi(t)
                    }
                    lifted = true
                    done = true
                }
            }
            if (!done && isP(t, ";")) {
                t = adv(t)
                sawSemi = true
                done = true
            }
            // s478-boot-destructuring — a destructuring declaration: its statements (a
            // declaration is never the arm's value)
            if (!done && destructDeclAhead(t)) {
                const rd: RStmts = parseTermStmts(t, b0)
                stmts = stmts.concat(rd.ss)
                t = rd.tp
                done = true
                if (t.i == before) t = adv(t)
            }
            if (!done) {
                // s469 — E-STMT-NO-EFFECT (stmtChecks): every statement but the
                // block's LAST is a statement in any position; the last is the
                // arm's value where the arm's value is used, so it is judged
                // only for a statement-position `match` / `!{}` (armTails)
                const h0: int = hardErrors(t.diags)
                const rs: RStmt = parseStmt(t)
                // s474 #1512 — §18.5 / §7.2.2 rule 3 (RULED S469 "Allow { e } in
                // arms too": "a brace holding ONE expression is that
                // expression"): a body that is exactly ONE expression, with no
                // `;` at its top level (`.B :> { 2 }`), is a single-expression
                // position and takes no `;` — the same arm as `.B :> { 2; }`
                // (one expression statement, then `}`). A body that holds a
                // statement or a second item still takes rule 1's `;`
                // (`{ f(); 2 }` is E-STMT-MISSING-SEMICOLON after `2`), and a
                // declaration / `return` / `fail` / `lift` is a statement, not
                // an expression. Not after an error (a recovered placeholder).
                // Where the arm's value is NOT used (a statement-position
                // `match` / `!{}`) the block is a statement list and the `;` is
                // owed after all: `bare` marks the arm so armTails reports it.
                // A block-like expression statement (a statement `match`) owes
                // no `;` in either position (rule 2), so it is never `bare`
                // (#1722 review F1: `.A :> { match k { … } }` in a statement
                // `match` drew a spurious report); termAfter passes it.
                let r: RStmt = rs
                if (stmts.length == 0 && !sawSemi && isP(rs.tp, "}") && stmtExpr(rs.s) is given && needsSemi(rs.s) && hardErrors(rs.tp.diags) == h0) {
                    bare = true
                } else {
                    r = { s: rs.s, tp: termAfter(rs.tp, rs.s, b0) }
                }
                if (!armBlockLastAt(r.tp)) {
                    r = stmtChecks(r.tp, r.s, b0, h0)
                } else if (stmts.length > 0) {
                    // s475 r1 (#1767 review F3): the LAST of two or more statements is
                    // never the arm's value (§18.5: a statement-holding block arm yields
                    // only by `lift` — a bare tail is E-ARM-TAIL-VALUE), so a `match` /
                    // `!{}` there is a statement in either position: its value-`if`
                    // brace arms are statement lists (stmtArmReread), as armTails reads
                    // them for a statement-position form
                    r = valueIfArmsReread(r.tp, r.s)
                }
                stmts = stmts.concat([r.s])
                t = r.tp
                if (t.i == before) t = adv(t)
            }
        }
        t = expectP(t, "}")
        const b: ABlock = { nid: t.nid, span: spanFrom(t, start), stmts: stmts }
        return { b: b, lifted: lifted, bare: bare, tp: bumpId(t) }
    }

    // s475 (#1762 review item 3) — at an arm's `{` whose first token is `if`: the
    // brace read as ONE value `if` (parseValueIfExpr, parenthesized head), an
    // optional `;`, then the brace's `}` — the block `[Eval(if …)]`. `not` when the
    // brace holds anything else or the value `if` does not read without an error;
    // the caller then reads the brace as a block (a statement `if` among others).
    fn valueIfBrace(tp: TP) -> RArmBlock | not {
        const start: int = cur(tp).start
        const h0: int = hardErrors(tp.diags)
        const ifStart: int = cur(adv(tp)).start
        const inner: RExpr = parseValueIfExpr(adv(tp), false)
        if (hardErrors(inner.tp.diags) != h0) return not
        const es: RStmt = mkS(inner.tp, ifStart, AStmtK.Eval(inner.e))
        let t: TP = es.tp
        if (isP(t, ";")) t = adv(t)
        if (!isP(t, "}")) return not
        t = adv(t)
        const b: ABlock = { nid: t.nid, span: spanFrom(t, start), stmts: [es.s] }
        return { b: b, lifted: false, bare: true, tp: bumpId(t) }
    }

    // After a statement in an arm block: is it the block's last (only `;`s, then
    // the block's `}` or the end of the input, follow)?
    fn armBlockLastAt(tp: TP) -> boolean {
        let t: TP = tp
        while (isP(t, ";")) { t = adv(t) }
        return atEnd(t) || isP(t, "}")
    }

    // s475 — §18.5's object-literal test on an arm's brace body (at its `{`):
    // "The content is an object literal when it is a non-empty, comma-separated
    // list in which every entry is `key: value` (the key an identifier, a
    // keyword, a string or number literal, or a `[computed]` key), `...spread`,
    // or a lone shorthand name — and it contains NO `;` at its own top level."
    // Only the brace's own top-level tokens are read (a nested bracket is one
    // step; its closer is kept, so `[k]:` reads `[`, `]`, `:`). A body that is
    // exactly ONE lone shorthand name is not taken here: it is
    // E-MATCH-ARM-SHORTHAND-AMBIGUOUS (§18.5), parseArmBody's own reading.
    fn armObjectShape(tp: TP) -> boolean {
        let i: int = tp.i + 1
        let depth: int = 0
        let entries: int = 0
        let cnt: int = 0
        let ai: int = i
        let bi: int = i
        let ci: int = i
        while (i < tp.toks.length) {
            const x: PTok = tp.toks[i]
            if (x.cls == TC.End) return false
            const opener: boolean = x.cls == TC.Punct && (tk(x, "{") || tk(x, "(") || tk(x, "["))
            const closer: boolean = x.cls == TC.Punct && (tk(x, "}") || tk(x, ")") || tk(x, "]"))
            if (closer && depth == 0) {
                if (!tk(x, "}")) return false
                if (cnt == 0) return false            // `{}`, or a `,` with no entry after it
                if (!objEntryOk(tp, ai, bi, ci, cnt)) return false
                if (entries == 0 && cnt == 1 && isShorthandName(tp.toks[ai])) return false
                return true
            }
            let top: boolean = depth == 0
            if (closer) {
                depth = depth - 1
                top = depth == 0
            }
            if (depth == 0 && !opener && !closer && x.cls == TC.Punct && tk(x, ";")) return false
            if (depth == 0 && !closer && x.cls == TC.Punct && tk(x, ",")) {
                if (cnt == 0 || !objEntryOk(tp, ai, bi, ci, cnt)) return false
                entries = entries + 1
                cnt = 0
                // a trailing `,` before the `}` ends the list (JS reads `{ a: 1, }`)
                const nx: PTok = tp.toks[i + 1]
                if (nx.cls == TC.Punct && tk(nx, "}")) {
                    return true
                }
            } else if (top) {
                if (cnt == 0) ai = i
                if (cnt == 1) bi = i
                if (cnt == 2) ci = i
                cnt = cnt + 1
            }
            if (opener) depth = depth + 1
            i = i + 1
        }
        return false
    }

    // One entry of armObjectShape's list: its first three top-level tokens.
    fn objEntryOk(tp: TP, ai: int, bi: int, ci: int, cnt: int) -> boolean {
        const a: PTok = tp.toks[ai]
        if (isSpread({ toks: tp.toks, i: ai, nid: tp.nid, diags: tp.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn })) return true
        if (cnt == 1) return isShorthandName(a)
        const b: PTok = tp.toks[bi]
        const colon: boolean = b.cls == TC.Punct && tk(b, ":") && !tk(tp.toks[bi + 1], ">")
        if ((a.cls == TC.Ident || a.cls == TC.Keyword || a.cls == TC.Str || a.cls == TC.Num) && colon) return true
        if (cnt < 3) return false
        const c: PTok = tp.toks[ci]
        return a.cls == TC.Punct && tk(a, "[") && b.cls == TC.Punct && tk(b, "]") && c.cls == TC.Punct && tk(c, ":") && !tk(tp.toks[ci + 1], ">")
    }

    // §18.5: "A *shorthand name* is a word JavaScript reads as a shorthand
    // property: an identifier, or a scrml keyword that is not an ECMAScript
    // strict-mode reserved word (`type`, `from`, `is`, `as`, `get`, `set`,
    // `server`, `fn`, `async`, `undefined`, …); a reserved word (`return`,
    // `break`, `null`, `this`, `true`, …) never is." `not` is scrml's absence
    // literal (§42), never a name.
    fn isShorthandName(x: PTok) -> boolean {
        if (x.v == "not") return false
        if (x.cls == TC.Ident) return !strictReserved(x.v)
        if (x.cls == TC.Keyword) return !strictReserved(x.v)
        return false
    }

    // The ECMAScript strict-mode reserved words (ES2015+ §12.6.2 ReservedWord, plus
    // the strict-mode FutureReservedWords and `let` / `static` / `yield` / `await`).
    fn strictReserved(w: string) -> boolean {
        return match w {
            "break" :> true
            "case" :> true
            "catch" :> true
            "class" :> true
            "const" :> true
            "continue" :> true
            "debugger" :> true
            "default" :> true
            "delete" :> true
            "do" :> true
            "else" :> true
            "enum" :> true
            "export" :> true
            "extends" :> true
            "false" :> true
            "finally" :> true
            "for" :> true
            "function" :> true
            "if" :> true
            "import" :> true
            "in" :> true
            "instanceof" :> true
            "new" :> true
            "null" :> true
            "return" :> true
            "super" :> true
            "switch" :> true
            "this" :> true
            "throw" :> true
            "true" :> true
            "try" :> true
            "typeof" :> true
            "var" :> true
            "void" :> true
            "while" :> true
            "with" :> true
            "yield" :> true
            "let" :> true
            "static" :> true
            "implements" :> true
            "interface" :> true
            "package" :> true
            "private" :> true
            "protected" :> true
            "public" :> true
            "await" :> true
            _ :> false
        }
    }

    fn shorthandArmReason(n: string) -> string {
        return "the arm body `{ " + n + " }` reads two ways — as the object `{ " + n + ": " + n + " }` and as a block whose result is `" + n + "` (§18.5). Write `{ " + n + ": " + n + " }` for the object, or the bare `" + n + "` (`<pattern> :> " + n + "`) for its value"
    }

    // Where an expression arm ends: at bracket depth 0, the arms' closing `}`,
    // a `,` (the arm-list separator, s469), a `|` (the next arm), or the start
    // of the next arm (`.A :> 1  .B :> 2`, on the same line or the next — a
    // pattern followed by its separator, which no expression contains; the
    // missing `,` is then reported by parseArms). s469 (dpa-073 F1 (a)): a line
    // break is whitespace — `.Boom(m) :> "a:"⏎ + m` is one arm, as
    // `.Boom(m) :> "a:" +⏎ m` already was (dpa-068 D12).
    fn armEnd(tp: TP) -> int {
        let i: int = tp.i
        let depth: int = 0
        while (i < tp.toks.length) {
            const x: PTok = tp.toks[i]
            if (x.cls == TC.End) return i
            if (depth == 0 && i > tp.i) {
                // s469: a `,` at depth 0 ends the arm (dpa-073 F2). One inside
                // `( [ {` is the body's own (`f(a, b)`, `[1, 2]`). This counts
                // TOKEN brackets only: a MARKUP arm body (`.Ok(v) :> <b>ok, yes</b>`)
                // would be split at its text's `,`. The bootstrap has no markup
                // arm bodies yet (it fails loudly — pinned in arms-union-s469.test.js);
                // when they land, this boundary rule must learn markup depth.
                if (x.cls == TC.Punct && tk(x, ",")) return i
                // (s469 — dpa-073 F1 (a): a line break no longer ends an arm; the
                // next arm's head below still does, so a missing `,` is reported
                // after the arm it is missing from, never read as one long body)
                if (x.cls == TC.Punct && tk(x, "|")) return i
                if (armStartsAt(tp.toks, i)) return i
            }
            if (x.cls == TC.Punct && (tk(x, "(") || tk(x, "[") || tk(x, "{"))) depth = depth + 1
            if (x.cls == TC.Punct && (tk(x, ")") || tk(x, "]") || tk(x, "}"))) {
                if (depth == 0) return i
                depth = depth - 1
            }
            // s469: a backtick template is ONE operand — its text and slots may
            // span lines and hold `,` / `|` / brackets; none of them ends the arm
            if (x.cls == TC.TChunk) i = tmplEnd(tp.toks, i)
            i = i + 1
        }
        return tp.toks.length - 1
    }

    // s469 — the index of the chunk that closes the template whose FIRST chunk
    // is at `i` (a nested template's tokens lie inside one of its slots).
    fn tmplEnd(ts: PTok[], i: int) -> int {
        let j: int = i
        let slots: int = 0
        while (j < ts.length) {
            const x: PTok = ts[j]
            if (x.cls == TC.End) return j - 1
            if (x.cls == TC.TIStart) slots = slots + 1
            if (x.cls == TC.TIEnd) slots = slots - 1
            if (x.cls == TC.TChunk && slots == 0 && chunkClosed(x.text)) return j
            j = j + 1
        }
        return ts.length - 1
    }

    // Does an arm's pattern start at token `i` — `.V`, `::V`, `_`, `else`,
    // optionally `(…)` — followed by an arm separator?
    fn armStartsAt(ts: PTok[], i: int) -> boolean {
        const a: PTok = ts[i]
        let j: int = -1
        if (a.cls == TC.Variant) j = i + 1
        if (j < 0 && a.cls == TC.Punct && tk(a, ".") && i + 1 < ts.length && touching(a, ts[i + 1]) && (ts[i + 1].cls == TC.Ident || ts[i + 1].cls == TC.Keyword)) j = i + 2
        if (j < 0 && a.cls == TC.Punct && tk(a, ":") && i + 2 < ts.length && tk(ts[i + 1], ":") && touching(a, ts[i + 1]) && touching(ts[i + 1], ts[i + 2])) j = i + 3
        // s469: the absence arm `not :>` and a literal arm (`"a" :>`, `1 :>`, `-1 :>`, `true :>`)
        if (j < 0 && (a.cls == TC.Ident || a.cls == TC.Keyword) && a.v == "not") return sepTokAt(ts, i + 1)
        if (j < 0 && (a.cls == TC.Str || a.cls == TC.Num)) return sepTokAt(ts, i + 1)
        if (j < 0 && (a.cls == TC.Ident || a.cls == TC.Keyword) && (a.v == "true" || a.v == "false")) return sepTokAt(ts, i + 1)
        if (j < 0 && a.cls == TC.Punct && tk(a, "-") && i + 1 < ts.length && ts[i + 1].cls == TC.Num && touching(a, ts[i + 1])) return sepTokAt(ts, i + 2)
        if (j < 0 && ((a.cls == TC.Ident && a.v == "_") || (a.cls == TC.Keyword && a.v == "else"))) {
            j = i + 1
            // s452: `_ err` / `else err` — the wildcard's one binder (§18.6.1)
            if (j < ts.length && ts[j].cls == TC.Ident && ts[j].line == a.line) j = j + 1
        }
        // s469 r2: a qualified head, `Type.V` / `Type::V` (§18.13) — the forms
        // parsePattern accepts — so a newline-separated `E.A :> 1⏎ E.B :> 2`
        // ends the first arm at `E.B` and reports the one missing `,` there
        if (j < 0 && a.cls == TC.Ident && i + 1 < ts.length && ts[i + 1].cls == TC.Variant && touching(a, ts[i + 1])) j = i + 2
        if (j < 0 && a.cls == TC.Ident && i + 2 < ts.length && ts[i + 1].cls == TC.Punct && tk(ts[i + 1], ".") && touching(a, ts[i + 1]) && (ts[i + 2].cls == TC.Ident || ts[i + 2].cls == TC.Keyword) && touching(ts[i + 1], ts[i + 2])) j = i + 3
        if (j < 0 && a.cls == TC.Ident && i + 3 < ts.length && tk(ts[i + 1], ":") && tk(ts[i + 2], ":") && touching(a, ts[i + 1]) && touching(ts[i + 1], ts[i + 2]) && (ts[i + 3].cls == TC.Ident || ts[i + 3].cls == TC.Keyword) && touching(ts[i + 2], ts[i + 3])) j = i + 4
        // s452: a bare identifier pattern (`err :>`, §18.2) — only before the
        // canonical `:>` here: `x =>` mid-expression is an arrow function
        if (j < 0 && a.cls == TC.Ident) {
            if (i + 2 < ts.length && ts[i + 1].cls == TC.Punct && tk(ts[i + 1], ":") && tk(ts[i + 2], ">") && touching(ts[i + 1], ts[i + 2])) return true
            return false
        }
        if (j < 0 || j >= ts.length) return false
        // the legacy paren-free binder (`.V m :>`): one identifier before the separator
        if (j < ts.length && a.cls != TC.Ident && a.cls != TC.Keyword && ts[j].cls == TC.Ident && ts[j].line == a.line && j + 1 < ts.length && ts[j + 1].cls == TC.Punct) j = j + 1
        if (ts[j].cls == TC.Punct && tk(ts[j], "(")) {
            let depth: int = 0
            let going = true
            while (going && j < ts.length) {
                if (ts[j].cls == TC.End) return false
                if (ts[j].cls == TC.Punct && tk(ts[j], "(")) depth = depth + 1
                if (ts[j].cls == TC.Punct && tk(ts[j], ")")) depth = depth - 1
                j = j + 1
                if (depth == 0) going = false
            }
        }
        if (j >= ts.length - 1) return false
        const s: PTok = ts[j]
        const g: PTok = ts[j + 1]
        if (s.cls != TC.Punct) return false
        if (tk(s, ":") && tk(g, ">") && touching(s, g)) return true
        if (tk(s, "=>")) return true
        return tk(s, "-") && tk(g, ">") && touching(s, g)
    }

    // s469 — is there an arm separator (`:>`, `=>`, `->`) at token `j`?
    fn sepTokAt(ts: PTok[], j: int) -> boolean {
        if (j + 1 >= ts.length) return false
        const s: PTok = ts[j]
        const g: PTok = ts[j + 1]
        if (s.cls != TC.Punct) return false
        if (tk(s, ":") && tk(g, ">") && touching(s, g)) return true
        if (tk(s, "=>")) return true
        return tk(s, "-") && tk(g, ">") && touching(s, g)
    }

    fn endTokAt(x: PTok) -> PTok {
        return { cls: TC.End, v: "", text: "", start: x.start, end: x.start, line: x.line, bad: "" }
    }

    fn sqlOf(k: AExprK) -> ASql | not {
        return match k {
            .Sql(q: q) :> q
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .HashRef(id: hr0) :> not
            .Foreign(f: fb0) :> not
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .BlockLambda(params: ps) :> not
        }
    }

    // At a `{`: past its matching `}` (the error recovery for a refused body).
    fn skipBraced(tp: TP) -> TP {
        if (!isP(tp, "{")) return tp
        let t: TP = adv(tp)
        let depth: int = 1
        while (depth > 0 && !atEnd(t)) {
            const x: PTok = cur(t)
            if (x.cls == TC.Punct && tk(x, "{")) depth = depth + 1
            if (x.cls == TC.Punct && tk(x, "}")) depth = depth - 1
            t = adv(t)
        }
        return t
    }

    // =========================================================================
    // s451 (U1a) — a SQL context `?{ `…` }` (SPEC §8.1, §8.3, §44.8).
    //
    // §8.1: "sql-context ::= '?{' sql-template '}' · sql-template ::= '`'
    // sql-content '`' · bound-param ::= '${' expression '}'"; "`${}` inside a
    // SQL template SHALL be compiled to a positional bound parameter … SHALL NOT
    // be compiled to string interpolation under any circumstance."
    // §44.8: the scanner is BRACKET-MATCHED — "The opening `?{` enters a
    // JS-expression context with brace-depth = 1 … a backtick opens a
    // template-literal context … `${` opens a nested JS-expression context with
    // its own brace-depth counter … The outer `?{...}` ends when the original
    // JS-context's brace-depth returns to 0." The bootstrap's ONE lexer already
    // is that scanner (templates, `${…}` frames, strings and brackets are
    // tracked in its fold — lex.scrml), so the SQL is read here from its tokens:
    // one TemplateChunk per literal run, TIStart / TIEnd around each `${…}`.
    // "If the scanner reaches end-of-input with the outer JS-context still open,
    // the compiler SHALL emit `E-SQL-008` with the source offset of the
    // offending `?{`."
    // E-SQL-003 (§8.6): "SQL template content is a runtime expression, not a
    // literal string template" — content that is not ONE backtick template, or a
    // template with no literal SQL text (only `${…}`, §8.4's
    // ``?{`${sql}`}`` example).
    // The chain (§8.3): `.all()` / `.get()` / `.run()` and `.nobatch()` (§8.9.5)
    // are absorbed into the node; `.prepare()` is E-SQL-006 ("removed — Bun.SQL
    // manages prepared-statement caching internally. Calling `.prepare()` on a
    // `?{}` result SHALL be compile error E-SQL-006").
    // =========================================================================
    fn isSqlOpen(tp: TP) -> boolean {
        const a: PTok = cur(tp)
        const b: PTok = peekAt(tp, 1)
        return a.cls == TC.Punct && tk(a, "?") && b.cls == TC.Punct && tk(b, "{") && touching(a, b)
    }

    // A template chunk's raw text ends the template when it ends in an
    // UNESCAPED backtick (the lexer consumes the closing backtick into the last
    // chunk; an unterminated template's last chunk runs to end-of-input).
    fn chunkClosed(raw: string) -> boolean {
        if (raw.length == 0 || raw.substring(raw.length - 1, raw.length) != "`") return false
        let k: int = raw.length - 2
        let slashes: int = 0
        while (k >= 0 && raw.substring(k, k + 1) == "\\") {
            slashes = slashes + 1
            k = k - 1
        }
        return slashes % 2 == 0
    }

    fn sql008(tp: TP, open: PTok) -> TP {
        return diagAt(tp, "E-SQL-008", "this `?{` SQL block has no matching `}` — an unterminated SQL template, an unterminated backtick template, or an unmatched `${` inside the SQL body (§44.8); close the template with a backtick and the block with `}`", open)
    }

    fn parseSql(tp: TP) -> RExpr {
        const open: PTok = cur(tp)
        const start: int = open.start
        const t0: TP = adv(adv(tp))
        if (cur(t0).cls != TC.TChunk) return sqlNotTemplate(t0, open, start)
        let chunks: string[] = [cur(t0).v]
        let params: AExpr[] = []
        let closed: boolean = chunkClosed(cur(t0).text)
        let t: TP = adv(t0)
        while (!closed) {
            if (cur(t).cls != TC.TIStart) return mkE(sql008(t, open), start, AExprK.Recovered)
            const pe: RExpr = parseAssign(adv(t))
            params = params.concat([pe.e])
            t = pe.tp
            if (cur(t).cls != TC.TIEnd) return mkE(sql008(t, open), start, AExprK.Recovered)
            // s469 — the one reader of a slot's extent (§8.1.2) could not bound this
            // bound parameter one way (lex.scrml InterpFrame.why): refused, as a
            // logic template's slot is
            if (cur(t).v != "") {
                const d: TP = diagAt(t, "E-PARSE-TEMPLATE", "this `?{}` bound parameter cannot be read one way — " + cur(t).v + " — so where it ends is not known, and it is refused (§8.1.2: one reader of a slot's extent). Compute the value into a local first and bind the local", cur(t))
                const past: RSkip = skipToSqlClose(adv(d), open)
                if (!past.closed) return mkE(past.tp, start, AExprK.Recovered)
                const rcu: RSqlChain = parseSqlChain(past.tp, emptySqlChain())
                return mkE(rcu.tp, start, AExprK.Recovered)
            }
            t = adv(t)
            if (cur(t).cls != TC.TChunk) return mkE(sql008(t, open), start, AExprK.Recovered)
            chunks = chunks.concat([cur(t).v])
            closed = chunkClosed(cur(t).text)
            t = adv(t)
        }
        if (atEnd(t)) return mkE(sql008(t, open), start, AExprK.Recovered)
        if (!(cur(t).cls == TC.Punct && tk(cur(t), "}"))) {
            const extra: PTok = cur(t)
            const d: TP = diagAt(t, "E-SQL-003", sqlShapeHead() + " ONE backtick SQL template — found `" + extra.text + "` after it (§8.1: `?{` `…` `}`). The SQL text is fixed at compile time; bind values with `${…}` inside the template (§8.2), and reuse SQL by extracting a function (§8.4.1)", extra)
            const past: RSkip = skipToSqlClose(d, open)
            if (!past.closed) return mkE(past.tp, start, AExprK.Recovered)
            const rc: RSqlChain = parseSqlChain(past.tp, emptySqlChain())
            return mkE(rc.tp, start, AExprK.Recovered)
        }
        t = adv(t)
        const rc2: RSqlChain = parseSqlChain(t, emptySqlChain())
        if (onlyInterp(chunks, params)) {
            const d2: TP = diagAt(rc2.tp, "E-SQL-003", "this SQL template has no literal SQL text — its whole content is `${…}`, a runtime expression (§8.1, §8.4: the `?{}` body SHALL remain a literal string at compile time, so every value is a bound parameter, never SQL text). Write the SQL inside the backticks and bind values with `${…}`; reuse SQL by extracting a function (§8.4.1)", open)
            return mkE(d2, start, AExprK.Recovered)
        }
        const q: ASql = { chunks: chunks, params: params, mode: rc2.c.mode, nobatch: rc2.c.nobatch, handled: false }
        return mkE(rc2.tp, start, AExprK.Sql(q))
    }

    // Every chunk blank and at least one `${…}`.
    fn onlyInterp(chunks: string[], params: AExpr[]) -> boolean {
        if (params.length == 0) return false
        for (const c of chunks) {
            if (c.trim() != "") return false
        }
        return true
    }

    // The head of the two E-SQL-003 reports of a `?{ … }` not written `?{` + ONE
    // backtick template + `}` (sqlNotTemplate; parseSql's text after the template)
    // — the shapes sqlInCondition re-codes in an `if` condition.
    fn sqlShapeHead() -> string {
        return "the content of `?{ … }` must be"
    }

    // s479 — §34 E-SQL-QUERY-NOT-READABLE: "a `?{` in an `if` / `while` condition …
    // not written `?{` + backtick template + `}` (an unbackticked `?{ … }`), a
    // backtick inside the body, or no `}` right after the closing backtick". It is
    // the more specific code for that shape there (ruling S473 D29: "one code per
    // rule, the more specific winning"), so the E-SQL-003 a condition's `?{ … }`
    // drew (the reports from diags[n0] on) is re-coded. `while` is retired; its
    // condition is the `for (cond)` head's (§49.3.1: "This is the loop the retired
    // `while (cond)` spelled"), so that head is covered too (s479 r1, LOW-4). The
    // template-literal slot and `match` arm body positions are not re-coded yet
    // (g-boot-sql-query-not-readable-positions-s479).
    fn sqlInCondition(n0: int, r: RExpr) -> RExpr {
        const ds: Diag[] = r.tp.diags
        if (ds.length <= n0) return r
        let out: Diag[] = ds.slice(0, n0)
        let changed = false
        for (const d of ds.slice(n0)) {
            if (d.code == "E-SQL-003" && d.message.indexOf(sqlShapeHead()) == 0) {
                changed = true
                out = out.concat([newDiag("E-SQL-QUERY-NOT-READABLE", "this `?{ … }` in an `if` / `for` condition is not written `?{` + ONE backtick SQL template + `}` (the report is at the text that breaks that shape), so no check can read it, and it is refused (§8.1.2). Write the backtick form (`?{`SELECT …`}`), or bind the query to a local first (`const row = ?{`…`}.get();`)", d.file, d.span)])
            } else {
                out = out.concat([d])
            }
        }
        if (!changed) return r
        const t: TP = r.tp
        return { e: r.e, tp: { toks: t.toks, i: t.i, nid: t.nid, diags: out, file: t.file, ns: t.ns, inFn: t.inFn } }
    }

    // `?{` followed by something other than a template.
    fn sqlNotTemplate(t0: TP, open: PTok, start: int) -> RExpr {
        if (atEnd(t0)) return mkE(sql008(t0, open), start, AExprK.Recovered)
        const found: PTok = cur(t0)
        const past: RSkip = skipToSqlClose(t0, open)
        if (!past.closed) return mkE(past.tp, start, AExprK.Recovered)
        const d: TP = diagAt(past.tp, "E-SQL-003", sqlShapeHead() + " a backtick SQL template (`?{`SELECT …`}`) — found `" + found.text + "` (§8.1). The SQL text is fixed at compile time; a runtime value is bound with `${…}` inside the template (§8.2), never assembled into the SQL", found)
        const rc: RSqlChain = parseSqlChain(d, emptySqlChain())
        return mkE(rc.tp, start, AExprK.Recovered)
    }

    // Past the `}` that closes a `?{` (brace depth 1 at `tp`); at end-of-input
    // that is E-SQL-008 (`closed` false).
    type RSkip:struct = { tp: TP, closed: boolean }

    fn skipToSqlClose(tp: TP, open: PTok) -> RSkip {
        let t: TP = tp
        let depth: int = 1
        while (depth > 0) {
            if (atEnd(t)) return { tp: sql008(t, open), closed: false }
            const x: PTok = cur(t)
            if (x.cls == TC.Punct && tk(x, "{")) depth = depth + 1
            if (x.cls == TC.Punct && tk(x, "}")) depth = depth - 1
            t = adv(t)
        }
        return { tp: t, closed: true }
    }

    // The chain after a `?{}`: its terminator and `.nobatch()`.
    type SqlChain:struct = { mode: ASqlMode, terminated: boolean, nobatch: boolean }
    type RSqlChain:struct = { c: SqlChain, tp: TP }

    fn emptySqlChain() -> SqlChain { return { mode: ASqlMode.SqlAll, terminated: false, nobatch: false } }

    fn isChainWord(w: string) -> boolean {
        return w == "all" || w == "get" || w == "run" || w == "nobatch" || w == "prepare"
    }

    fn parseSqlChain(tp: TP, c0: SqlChain) -> RSqlChain {
        let t: TP = tp
        let c: SqlChain = c0
        let going = true
        while (going) {
            const dot: PTok = cur(t)
            const name: PTok = peekAt(t, 1)
            const paren: PTok = peekAt(t, 2)
            if (dot.cls == TC.Punct && tk(dot, ".") && (name.cls == TC.Ident || name.cls == TC.Keyword) && isChainWord(name.v)
                    && paren.cls == TC.Punct && tk(paren, "(") && paren.line == name.line) {
                const args: RExprs = parseList(adv(adv(adv(t))), ")")
                t = args.tp
                if (args.es.length > 0) t = diagAt(t, "E-PARSE-SQL-CHAIN", "`." + name.v + "()` on a `?{}` takes no arguments (§8.3)", name)
                if (name.v == "prepare") {
                    t = diagAt(t, "E-SQL-006", "`.prepare()` on a `?{}` is removed (§8.5.2, §44.3) — Bun.SQL manages prepared-statement caching itself; call `.all()`, `.get()` or `.run()` on the query directly", name)
                } else if (name.v == "nobatch") {
                    c = { mode: c.mode, terminated: c.terminated, nobatch: true }
                } else {
                    if (c.terminated) t = diagAt(t, "E-PARSE-SQL-CHAIN", "a `?{}` takes ONE of `.all()`, `.get()`, `.run()` (§8.3) — `." + name.v + "()` follows another", name)
                    c = { mode: chainMode(name.v), terminated: true, nobatch: c.nobatch }
                }
            } else {
                going = false
            }
        }
        return { c: c, tp: t }
    }

    fn chainMode(w: string) -> ASqlMode {
        if (w == "get") return ASqlMode.SqlGet
        if (w == "run") return ASqlMode.SqlRun
        return ASqlMode.SqlAll
    }

    // Comma-separated expressions up to (and consuming) `close`.
    fn parseList(tp: TP, close: string) -> RExprs {
        let t: TP = tp
        let out: AExpr[] = []
        let going = !isP(t, close) && !atEnd(t)
        while (going) {
            const r: RExpr = parseAssign(t)
            out = out.concat([r.e])
            t = r.tp
            if (isP(t, ",")) {
                t = adv(t)
                if (isP(t, close)) going = false
            } else {
                going = false
            }
        }
        return { es: out, tp: expectP(t, close) }
    }

    // s469 — W-STRING-INTERP-LITERAL (code name provisional; its §34 row, a
    // Warning, landed in s469-spec-followup, so severity.scrml reads it from
    // §34 like any other code). A quoted
    // string in LOGIC is plain text: `${…}` interpolates only in markup text
    // and quoted attribute values (SPEC §5.5.3, §4.18), so `"typed ${n}
    // chars"` is those characters — a trap for a JavaScript reader. A WARNING
    // (the program means what it says), read from the token's RAW text: an
    // escaped `\${` was written on purpose and is not reported. A code-default
    // body's display-text literal (§4.18.4), which DOES interpolate, takes the
    // diagnostic back (displayNodes → dropInterpLint).
    fn interpLiteralLint(tp: TP, t: PTok) -> TP {
        const q: string = t.text.substring(0, 1)
        if (q != "\"" && q != "'") return tp
        if (!liveInterpRaw(t.text)) return tp
        const open: string = interpOpen()
        return diagAt(tp, "W-STRING-INTERP-LITERAL", "this string is plain text: `" + open + "…}` inside a string in logic is not interpolated — it prints as written. Interpolate in markup instead (`<p>typed " + open + "n} chars</p>`, or a quoted attribute) (§5.5.3, §4.18) [provisional code]", t)
    }

    // An unescaped `${…}` in a quoted token's raw text (a `\` escapes the next
    // character). A `${` with no `}` after it is not an interpolation attempt:
    // `${"${"}` is the SPEC's own spelling of a literal `${` in markup (§4.18.1b).
    fn liveInterpRaw(raw: string) -> boolean {
        let i: int = 1
        while (i < raw.length - 1) {
            if (raw.substring(i, i + 1) == "\\") {
                i = i + 2
            } else if (raw.substring(i, i + 2) == interpOpen()) {
                return raw.indexOf("}", i + 2) > 0
            } else {
                i = i + 1
            }
        }
        return false
    }

    fn parsePrimary(tp: TP) -> RExpr {
        const t: PTok = cur(tp)
        const start: int = t.start
        if (t.cls == TC.Num) return mkE(adv(tp), start, AExprK.Num(t.v))
        if (t.cls == TC.Str) return mkE(interpLiteralLint(adv(tp), t), start, AExprK.Str(t.v))
        if (t.cls == TC.Variant) return mkE(adv(tp), start, AExprK.Variant(t.v))
        if (t.cls == TC.At) return parseAt(tp)
        if (t.cls == TC.Keyword) return parseKeywordPrimary(tp)
        if (t.cls == TC.Ident) {
            if (t.v == "not") return notPrimary(tp, start)
            if (tk(peekAt(tp, 1), "=>")) return parseLambda(adv(tp), start, [t.v])
            return mkE(adv(tp), start, AExprK.Name(t.v))
        }
        if (isP(tp, "(")) {
            const ps: string[] | not = lambdaParams(tp)
            if (ps is given) return parseLambda(skipParams(tp), start, ps)
            // s478 (s478-boot-fn-type) — an arrow that WRITES its parameters' types,
            // `(x: int, y: string) => …` (§7.5 S469: "A standalone lambda (`const f = (x) =>
            // …`) must annotate its parameters"): read as a declaration's parameters are
            if (typedArrowAhead(tp)) return parseTypedLambda(tp, start)
            const inner: RExpr = parseAssign(adv(tp))
            return { e: parenMark(inner.e), tp: expectP(inner.tp, ")") }
        }
        if (isP(tp, "[")) {
            const elems: RExprs = parseArrayElems(adv(tp))
            return mkE(elems.tp, start, AExprK.ArrayLit(elems.es))
        }
        if (isP(tp, "{")) return parseObject(tp)
        if (isSqlOpen(tp)) return parseSql(tp)          // s451 (U1a): `?{ `…` }` (§8.1)
        if (t.cls == TC.TChunk) return parseTemplate(tp)  // s469: a logic backtick template (§14.13.3)
        if (t.cls == TC.Foreign) return parseForeign(tp)  // s473: a `_={ … }=` foreign code block (§23.2)
        if (t.cls == TC.Markup) return parseMarkupValue(tp, false)  // s478: markup as a value (§1.4, §7.4.1)
        if (hashRefAhead(tp)) return mkE(adv(adv(adv(adv(tp)))), start, AExprK.HashRef(peekAt(tp, 2).v))   // s475 (S3b)
        const bad: TP = diagAt(tp, "E-PARSE-EXPR", "expected an expression, found `" + t.text + "`", t)
        return mkE(adv(bad), start, AExprK.Recovered)
    }

    // s475 (slice S3b) — `<#id>`, a reference by id (SPEC §6.7.7 Properties:
    // `<#id>.loading`, `.data`, `.error`, `.stale`, `.refetch()`): the four
    // tokens `<` `#` id `>` with nothing between them. Only an expression's
    // primary position reads it, where `<` is never the less-than operator (an
    // operator has a left operand), and `#` follows `<` nowhere else in logic,
    // so it takes nothing from markup or a comparison. In a string literal it
    // is text (the lexer made the literal one token).
    fn isHashRefExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .HashRef(id: x) :> true
            .Name(name: x) :> false
            .At(name: x) :> false
            .AtItem :> false
            .Num(raw: x) :> false
            .Str(v: x) :> false
            .Bool(v: x) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: x) :> false
            .Member(obj: x) :> false
            .Call(callee: x) :> false
            .Unary(op: x) :> false
            .Binary(op: x) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: x) :> false
            .ObjectLit(props: x) :> false
            .Spread(e: x) :> false
            .Index(obj: x) :> false
            .Lambda(params: x) :> false
            .BlockLambda(params: x) :> false
            .Sql(q: x) :> false
            .Handled(h: x) :> false
            .Template(quasis: x) :> false
            .Foreign(f: x) :> false
        }
    }

    fn hashRefAhead(tp: TP) -> boolean {
        const lt: PTok = cur(tp)
        if (!(tk(lt, "<") && lt.cls == TC.Punct)) return false
        const h: PTok = peekAt(tp, 1)
        const nm: PTok = peekAt(tp, 2)
        const gt: PTok = peekAt(tp, 3)
        if (!(touching(lt, h) && h.cls == TC.Other && h.text == "#")) return false
        if (!(touching(h, nm) && nm.cls == TC.Ident)) return false
        return touching(nm, gt) && tk(gt, ">") && gt.cls == TC.Punct
    }

    // =========================================================================
    // s473 — a §23.2 foreign code block. The lexer bounded it by characters
    // (lex.scrml scanForeign — one token; its interior never tokenized). Here:
    // its closer (E-FOREIGN-001 / -002), the level-0 lint (W-FOREIGN-001), and
    // the optional `in: { name, name }` crossing header (§23.2.4a: "declared
    // ONCE, at the top of the block, inside the braces"; "The header is
    // optional (`in: {}` or omitted = no crossings)"). Each crossing is a Name
    // read at its own span, so scope resolution judges it like any read.
    // A header that is not that shape leaves `in:` at the head of the slice,
    // which is not JavaScript (`in` is a reserved word) — E-FOREIGN-007, the
    // unbuildable slice (§23.2.4a), named at the header. Where the block may
    // stand (§23.2.4) is judged by analyze, which knows the enclosing function.
    // =========================================================================
    // `why` (s478): why a header that is not ok cannot be built ("" — not the
    // `in: { name, … }` shape at all).
    type FHeader:struct = { names: string[], starts: int[], bodyAt: int, ok: boolean, why: string }

    fn parseForeign(tp: TP) -> RExpr {
        const t: PTok = cur(tp)
        const start: int = t.start
        let tp1: TP = adv(tp)
        if (t.bad == "E-FOREIGN-002") {
            const d: TP = diagAt(tp1, "E-FOREIGN-002", "unclosed foreign code block — this `" + foreignOpener(t.text) + "` reaches the end of the file without its closer `}" + foreignEq(t.text) + "` (§23.2: the closer is `}` followed by the same number of `=` as the opener)", t)
            return mkE(d, start, AExprK.Recovered)
        }
        const level: int = foreignEq(t.text).length
        if (t.bad == "E-FOREIGN-001") {
            const d1: TP = diagAt(tp1, "E-FOREIGN-001", "foreign code block level mismatch — opened with `" + foreignOpener(t.text) + "` but closed by a `}` followed by more `=` than the opener has (§23.2: the opener and closer MUST have the same number of `=` characters). Close it with `}" + foreignEq(t.text) + "`, or raise the opener's level", t)
            return mkE(d1, start, AExprK.Recovered)
        }
        if (level == 0) tp1 = diagAt(tp1, "W-FOREIGN-001", "a level-0 `_{ … }` foreign block closes at the first unbalanced `}` — a `}` in a string or a comment in the foreign code ends it early; write `_={ … }=` (§23.2)", t)
        const bodyAt: int = start + level + 2
        const h: FHeader = foreignHeader(t.v)
        if (!h.ok && h.why != "") {
            const d3: TP = diagAt(tp1, "E-FOREIGN-007", h.why, t)
            return mkE(d3, start, AExprK.Recovered)
        }
        if (!h.ok) {
            const d2: TP = diagAt(tp1, "E-FOREIGN-007", "this foreign block's `in:` header is not `in: { name, name, … }` — the crossing header names bare identifiers only, separated by commas (§23.2.4a). Anything else leaves `in:` at the head of the slice, which is not JavaScript (`in` is a reserved word), so the slice cannot be built. Bind the value to a local first, then cross the local", t)
            return mkE(d2, start, AExprK.Recovered)
        }
        let crossings: AExpr[] = []
        let i: int = 0
        let tpn: TP = tp1
        while (i < h.names.length) {
            const at: int = bodyAt + h.starts[i]
            const x: AExpr = { nid: tpn.nid, span: mkSpan(at, at + h.names[i].length), k: AExprK.Name(h.names[i]) }
            crossings = crossings.concat([x])
            tpn = bumpId(tpn)
            i = i + 1
        }
        const f: AForeign = { level: level, crossings: crossings, body: t.v.substring(h.bodyAt, t.v.length) }
        return mkE(tpn, start, AExprK.Foreign(f))
    }

    // =========================================================================
    // s478 — MARKUP AS A VALUE (SPEC §1.4 "markup is a first-class value"; §7.4.1
    // markup-as-expression): an element written where logic reads an operand
    // (`return <li>…</li>`, `@f ? <b>x</b> : <i>y</i>`, `.A :> <p>a</p>`). The
    // lexer made it ONE token (lex.scrml markupValueExtentAt); the element is read
    // HERE by the markup reader — parseMarkupNode, the reader every markup body
    // uses — over the token's own span, so the refusals below are decided on the
    // parsed element, never on text (§4.17, S462: "The decision is made on the
    // parsed element (its node), never on source text").
    //
    // Built: the READ and these named diagnostics —
    //   - `<script>` / `<style>` anywhere in it: E-SCRIPT-001 / E-STYLE-001 (§4.17
    //     S462: rejected "with the same codes … at EVERY position markup is parsed
    //     or built" — the markup reader reports them);
    //   - an `<md>` in it: E-MD-IN-LOGIC-NOMINAL (§34 row: "An `<md>` inside `lift`
    //     markup or a markup value in an expression (`const x = <div><md>…</md></div>`)
    //     … the element is refused by name — never rendered as an unknown element");
    //   - a value-form `match` arm whose body is the element (`arm`):
    //     E-MATCH-ARM-MARKUP-IN-VALUE (§34 row, §18.0: "A JS-style value-match arm
    //     (`match expr { .V :> ... }`) has an arm body that is a MARKUP element").
    // NOT BUILT (INTERIM, fail closed): the value itself — its type, its lowering,
    // its rendering. Any other markup value is E-BOOTSTRAP-UNSUPPORTED naming
    // §1.4 / §7.4.1 (g-boot-markup-as-value-unbuilt-s473). Capable form: a markup
    // value typed as markup and rendered where it is interpolated.
    // The expression is AExprK.Recovered: nothing downstream types or checks it.
    // =========================================================================
    fn parseMarkupValue(tp: TP, arm: boolean) -> RExpr {
        const t: PTok = cur(tp)
        // the element's own reader, over the file's offsets (the span is padded to
        // its offset, so every diagnostic it reports is at its place in the file)
        const m0: MP = { src: " ".repeat(t.start) + t.text, pos: t.start, nid: tp.nid, diags: [], file: tp.file, hoist: [], dbFns: [], hosts: [], pages: [], eps: [], chans: [], onchs: [], schemaN: 0, tables: [], ns: tp.ns }
        const rn: RNodeOne = parseMarkupNode(m0)
        let ds: Diag[] = rn.mp.diags
        // text the token holds past the element the reader read (the lexer's extent
        // ran on): E-PARSE-TRAILING (§34: "An unexpected token after a complete
        // expression") — never silently dropped (s478 review L2)
        const restAt: int = rn.mp.pos
        if (restAt < t.end && m0.src.substring(restAt, t.end).trim().length > 0) {
            ds = ds.concat([newDiag("E-PARSE-TRAILING", "unexpected text after this markup value's element: the element ends before it. Close the element where it ends, or write the rest as markup inside it", tp.file, mkSpan(restAt, t.end))])
        }
        let named = false
        for (const d of ds) {
            if (d.code == "E-SCRIPT-001" || d.code == "E-STYLE-001") named = true
        }
        for (const md of mdElemsIn(rn.n)) {
            ds = ds.concat([newDiag("E-MD-IN-LOGIC-NOMINAL", "an `<md>` in a markup value in logic is not read yet — it is refused by name rather than rendered as an unknown element (§67.2). A static `<md>` is read in a markup body: write it in the element's markup where it renders, not in a value", tp.file, mkSpan(md.start, md.end))])
            named = true
        }
        if (arm) {
            ds = ds.concat([newDiag("E-MATCH-ARM-MARKUP-IN-VALUE", "a value-form `match` arm returns a VALUE, and this arm's body is a markup element (§18.0). To render a UI tree per variant, use the block form `<match for=Type on=expr>` (§18.0.1); to compute a value per variant, have the arm return that value and interpolate it in markup", tp.file, mkSpan(t.start, t.end))])
        } else if (!named) {
            ds = ds.concat([newDiag("E-BOOTSTRAP-UNSUPPORTED", markupValueRefusal(), tp.file, mkSpan(t.start, t.end))])
        }
        const t2: TP = { toks: tp.toks, i: tp.i, nid: rn.mp.nid, diags: tp.diags.concat(ds), file: tp.file, ns: tp.ns, inFn: tp.inFn }
        return mkE(adv(t2), t.start, AExprK.Recovered)
    }

    // The message of the INTERIM markup-value refusal (also how parseFileNs finds it).
    fn markupValueRefusal() -> string {
        return "markup as a value in logic (a function's return, an operand, an argument, a binding — §1.4, §7.4.1) is not built in the bootstrap yet: the element is read and checked, but no value is made of it. Write the markup where it renders — in a markup body, choosing with `if=` / `else` (§17.1) or `<match for=… on=…>` (§18.0.1) — or compute a value (a string) in logic and interpolate it"
    }

    // A file's diagnostics, the INTERIM markup-value refusal dropped where a NAMED
    // markup refusal (E-SCRIPT-001, E-STYLE-001, E-MD-IN-LOGIC-NOMINAL,
    // E-MATCH-ARM-MARKUP-IN-VALUE) covers its line (the lines from the named span's
    // first to its last): `@f ? <style>…</style> :
    // <b>b</b>` is the one error the author must act on, not that plus a bootstrap
    // limit on its sibling (the named-refusal table's rule, refusals.scrml: "the
    // named refusal is what the author must act on first"). A named refusal
    // elsewhere in the file (a body `<style>`, another function's arm) does not
    // hide this one: each markup value the bootstrap cannot build is reported
    // (s478 review L1). Fail closed either way: both are Errors.
    fn markupValueDiags(ds: Diag[], src: string) -> Diag[] {
        // each named refusal's lines: from the line its span starts on to the end
        // of the line its ELEMENT ends on. s478-boot-review-followups r1 (L2): an
        // E-SCRIPT-001 / E-STYLE-001 span is the opener only, so a `<style>` written
        // over several lines (`@c ? <style>\np{}\n</style> : <b>b</b>`) is measured to
        // its closer — the extent the lexer gave the element (markupValueExtentAt).
        let from: int[] = []
        let to: int[] = []
        for (const d of ds) {
            if (d.code == "E-SCRIPT-001" || d.code == "E-STYLE-001" || d.code == "E-MD-IN-LOGIC-NOMINAL" || d.code == "E-MATCH-ARM-MARKUP-IN-VALUE") {
                let end: int = d.span.end
                if ((d.code == "E-SCRIPT-001" || d.code == "E-STYLE-001") && d.span.start < src.length && src.charCodeAt(d.span.start) == 60) {
                    const x: int = markupValueExtentAt(src, d.span.start)
                    if (x > end) end = x
                }
                from = from.concat([lineStartOf(src, d.span.start)])
                to = to.concat([lineEndOf(src, end)])
            }
        }
        if (from.length == 0) return ds
        let out: Diag[] = []
        for (const d of ds) {
            let drop = false
            if (d.code == "E-BOOTSTRAP-UNSUPPORTED" && d.message == markupValueRefusal()) {
                let k: int = 0
                while (k < from.length) {
                    if (d.span.start >= from[k] && d.span.start <= to[k]) drop = true
                    k = k + 1
                }
            }
            if (!drop) out = out.concat([d])
        }
        return out
    }

    // The offset where the line holding offset `at` starts.
    fn lineStartOf(src: string, at: int) -> int {
        const p: int = at > src.length ? src.length : at
        if (p <= 0) return 0
        return src.lastIndexOf("\n", p - 1) + 1
    }

    // The offset of the newline ending the line holding offset `at` (the end of input on the last line).
    fn lineEndOf(src: string, at: int) -> int {
        const nl: int = src.indexOf("\n", at)
        return nl < 0 ? src.length : nl
    }

    // The spans of the `<md>` elements in `n` (itself included).
    fn mdElemsIn(n: ANode) -> ASpan[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> mdElemsOf(e)
            .Text(text: x) :> []
            .Interp(e: x) :> []
            .DeclNode(d: x) :> []
            .Effect(w: x) :> []
            .Request(r: x) :> []
            .Css(c: x) :> []
            .Gather(f: x) :> []
            .Run(b: x) :> []
        }
    }

    fn mdElemsOf(e: AElem) -> ASpan[] {
        let out: ASpan[] = []
        if (!e.star && e.tag.toLowerCase() == "md") out = [e.span]
        for (const k of e.kids) { out = out.concat(mdElemsIn(k)) }
        return out
    }

    // The opener's `=` run, as written.
    fn foreignEq(text: string) -> string {
        let k: int = 1
        while (text.substring(k, k + 1) == "=") { k = k + 1 }
        return text.substring(1, k)
    }

    fn foreignOpener(text: string) -> string { return "_" + foreignEq(text) + "{" }

    // The `in: { a, b }` header at the head of a foreign body (after
    // whitespace). No header (the body does not start with the word `in` then
    // `:`): no crossings, the body whole. `starts` are offsets into `body`;
    // `bodyAt` is where the slice begins.
    // s478 (g-boot-foreign-header-checks-unbuilt-s473) — §23.2.4a: "A slice that is
    // not valid JavaScript as the body of a strict-mode async function whose
    // parameters are its crossings SHALL be a compile error (E-FOREIGN-007)". The
    // crossings ARE those parameters ("The crossings are the parameters of the
    // sealed slice"), so three headers make the slice unbuildable, refused here:
    //   - a name crossed twice (`in: { a, a }`) — duplicate parameters are a
    //     SyntaxError in strict mode;
    //   - a reserved word, or `eval` / `arguments`, as a crossing (`in: { if }`,
    //     `in: { await }`) — not a parameter name of a strict-mode async function;
    //   - a comment before the header (`_={ /* c */ in: { a } … }=`) — the header
    //     is declared "at the top of the block, inside the braces", so a comment
    //     ahead of it leaves `in:` inside the slice text, and `in` is a reserved
    //     word: not JavaScript.
    // S478 open-Qs ruling (user-voice) item 27: JS comments BETWEEN the header's
    // names (after `in`, around `:`, `{`, each name, `,` and `}`) are admitted —
    // "they are whitespace to the JavaScript the header becomes" (§23.2.4a).
    fn foreignHeader(body: string) -> FHeader {
        const none: FHeader = { names: [], starts: [], bodyAt: 0, ok: true, why: "" }
        const i: int = skipBlankChars(body, 0)
        if (body.substring(i, i + 2) != "in" || isIdentCh(body.substring(i + 2, i + 3))) {
            const ci: int = skipBlankAndComments(body, 0)
            if (ci > i && headerAt(body, ci)) return { names: [], starts: [], bodyAt: 0, ok: false, why: "this foreign block's `in:` header follows a comment — the crossing header is declared \"at the top of the block, inside the braces\" (§23.2.4a), so after a comment it is not read as one: `in:` stays in the slice, which is then not JavaScript (`in` is a reserved word) and cannot be built (E-FOREIGN-007). Put the comment after the header, or before the block" }
            return none
        }
        let j: int = skipBlankAndComments(body, i + 2)
        if (body.substring(j, j + 1) != ":") return none
        const bad: FHeader = { names: [], starts: [], bodyAt: 0, ok: false, why: "" }
        j = skipBlankAndComments(body, j + 1)
        if (body.substring(j, j + 1) != "{") return bad
        j = skipBlankAndComments(body, j + 1)
        let names: string[] = []
        let starts: int[] = []
        let ok: boolean = true
        let done: boolean = body.substring(j, j + 1) == "}"
        while (ok && !done) {
            const n0: int = j
            if (!isIdentStartCh(body.substring(j, j + 1))) {
                ok = false
            } else {
                while (isIdentCh(body.substring(j, j + 1))) { j = j + 1 }
                names = names.concat([body.substring(n0, j)])
                starts = starts.concat([n0])
                j = skipBlankAndComments(body, j)
                const c: string = body.substring(j, j + 1)
                if (c == ",") {
                    j = skipBlankAndComments(body, j + 1)
                    if (body.substring(j, j + 1) == "}") done = true
                } else if (c == "}") {
                    done = true
                } else {
                    ok = false
                }
            }
        }
        if (!ok) return bad
        let k: int = 0
        while (k < names.length) {
            const n: string = names[k]
            if (names.indexOf(n) < k) return { names: [], starts: [], bodyAt: 0, ok: false, why: "this foreign block crosses `" + n + "` twice in its `in:` header — a crossing is a parameter of the sealed slice (§23.2.4a), and a strict-mode function cannot take two parameters of one name, so the slice cannot be built (E-FOREIGN-007). Name each crossing once" }
            if (isSliceReservedName(n)) return { names: [], starts: [], bodyAt: 0, ok: false, why: "this foreign block crosses `" + n + "` in its `in:` header — a crossing is a parameter of the sealed slice, a strict-mode async function (§23.2.4a), and `" + n + "` cannot name one there, so the slice cannot be built (E-FOREIGN-007). Bind the value to a local of another name, then cross the local" }
            k = k + 1
        }
        return { names: names, starts: starts, bodyAt: j + 1, ok: true, why: "" }
    }

    // `in` + blanks + `:` at offset `at`
    fn headerAt(body: string, at: int) -> boolean {
        if (body.substring(at, at + 2) != "in" || isIdentCh(body.substring(at + 2, at + 3))) return false
        const j: int = skipBlankAndComments(body, at + 2)
        return body.substring(j, j + 1) == ":"
    }

    // Past blanks and JavaScript comments (`// …` to the line end, `/* … */`).
    fn skipBlankAndComments(s: string, from: int) -> int {
        let i: int = skipBlankChars(s, from)
        let going = true
        while (going) {
            if (s.substring(i, i + 2) == "//") {
                const nl: int = s.indexOf("\n", i)
                i = skipBlankChars(s, nl < 0 ? s.length : nl)
            } else if (s.substring(i, i + 2) == "/*") {
                const ce: int = s.indexOf("*/", i + 2)
                i = skipBlankChars(s, ce < 0 ? s.length : ce + 2)
            } else {
                going = false
            }
        }
        return i
    }

    // A name that cannot be a parameter of a strict-mode async function: a
    // reserved word (ES2015+, strict mode included), `await` (async), `eval` /
    // `arguments` (strict mode).
    fn isSliceReservedName(n: string) -> boolean {
        return ["break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do",
                "else", "enum", "export", "extends", "false", "finally", "for", "function", "if", "import", "in",
                "instanceof", "new", "null", "return", "super", "switch", "this", "throw", "true", "try", "typeof",
                "var", "void", "while", "with", "yield", "let", "static", "implements", "interface", "package",
                "private", "protected", "public", "await", "eval", "arguments"].indexOf(n) >= 0
    }

    fn skipBlankChars(s: string, from: int) -> int {
        let i: int = from
        while (i < s.length && s.substring(i, i + 1).trim() == "") { i = i + 1 }
        return i
    }

    fn isIdentStartCh(c: string) -> boolean {
        if (c == "") return false
        if (c >= "a" && c <= "z") return true
        if (c >= "A" && c <= "Z") return true
        return c == "_" || c == "$"
    }

    fn isIdentCh(c: string) -> boolean {
        if (c == "") return false
        if (c >= "0" && c <= "9") return true
        return isIdentStartCh(c)
    }

    // =========================================================================
    // s469 — a logic backtick template (SPEC §14.13.3): `` `typed ${n} chars` ``
    // is a `string`; each `${…}` slot is a text sink holding ONE expression.
    // The lexer bounded it (lex.scrml: a TChunk, then TIStart … TIEnd TChunk
    // per slot; the closing backtick ends the last chunk). Refused by name,
    // E-PARSE-TEMPLATE — fail closed: a malformed escape in its text (the
    // chunk's `bad`), a slot whose extent a JavaScript reader could read
    // differently (the lexer's reason, on the slot's `}`), an empty slot, a
    // slot holding more than one expression, an unterminated template. A
    // refused template is Recovered (its slots are not judged).
    // =========================================================================
    fn parseTemplate(tp: TP) -> RExpr {
        const first: PTok = cur(tp)
        const start: int = first.start
        const d0: int = errorCount(tp.diags)
        let t: TP = tmplText(tp, first)
        let quasis: string[] = [first.v]
        let slots: AExpr[] = []
        let closed: boolean = chunkClosed(first.text)
        let going: boolean = !closed
        t = adv(t)
        while (going) {
            if (cur(t).cls != TC.TIStart) {
                t = tmplUnclosed(t, first)
                going = false
            } else {
                const open: PTok = cur(t)
                t = adv(t)
                // a slot the lexer could not bound one way is refused WHOLE, before
                // its tokens are read (they are one reading of two): one report
                const ahead: TP = skipToSlotEnd(t)
                const unread: boolean = cur(ahead).cls == TC.TIEnd && cur(ahead).v != ""
                if (unread) {
                    t = ahead           // reported at the `}` below
                } else if (cur(t).cls == TC.TIEnd) {
                    t = diagAt(t, "E-PARSE-TEMPLATE", "an empty `" + interpOpen() + "}` slot — a slot holds one expression (§14.13.3); for the characters `" + interpOpen() + "` write `\\" + interpOpen() + "`", open)
                } else {
                    const r: RExpr = parseAssign(t)
                    slots = slots.concat([r.e])
                    t = r.tp
                    if (cur(t).cls != TC.TIEnd && !atEnd(t)) {
                        t = diagAt(t, "E-PARSE-TEMPLATE", "a template slot holds ONE expression — found `" + cur(t).text + "` after it (§14.13.3); compute the value first and put the result in the slot" + gluedQHint(t), cur(t))
                        t = skipToSlotEnd(t)
                    }
                }
                if (cur(t).cls != TC.TIEnd) {
                    t = tmplUnclosed(t, first)
                    going = false
                } else {
                    const close: PTok = cur(t)
                    if (close.v != "") {
                        const d: Diag = newDiag("E-PARSE-TEMPLATE", "this template slot cannot be read one way — " + close.v + " — so where it ends is not known, and it is refused (§14.13.3). Compute the value into a local first and put the local in the slot", t.file, mkSpan(open.start, close.end))
                        t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d]), file: t.file, ns: t.ns, inFn: t.inFn }
                    }
                    t = adv(t)
                    if (cur(t).cls != TC.TChunk) {
                        t = tmplUnclosed(t, first)
                        going = false
                    } else {
                        const chunk: PTok = cur(t)
                        t = tmplText(t, chunk)
                        quasis = quasis.concat([chunk.v])
                        if (chunkClosed(chunk.text)) going = false
                        t = adv(t)
                    }
                }
            }
        }
        // only an ERROR refuses the template: a warning inside a slot (W-STRING-
        // INTERP-LITERAL, W-IS-SOME-DEPRECATED, …) is a lint, and the program
        // still means what it says (review H1: counting warnings made the whole
        // template a Recovered node, lowered to `null`, its slots untyped)
        if (errorCount(t.diags) > d0) return mkE(t, start, AExprK.Recovered)
        return mkE(t, start, AExprK.Template(quasis, slots))
    }

    fn errorCount(ds: Diag[]) -> int {
        let n: int = 0
        for (const d of ds) { if (d.severity == Severity.Error) n = n + 1 }
        return n
    }

    // s469 — the errors that can derail what follows: every Error but a
    // missing terminator (E-STMT-MISSING-SEMICOLON / E-MATCH-ARM-SEPARATOR /
    // E-STMT-SPLIT-CONTINUATION, whose fix-it is the `;`), which is reported at
    // an exact place and parsed past without loss, and E-STMT-NO-EFFECT (a
    // whole, well-formed statement). The terminator cascade guard (termAfter)
    // counts these, so one missing `;` or `,` does not hide the next.
    fn hardErrors(ds: Diag[]) -> int {
        let n: int = 0
        for (const d of ds) {
            if (d.severity == Severity.Error && !softError(d.code)) n = n + 1
        }
        return n
    }

    fn softError(c: string) -> boolean {
        return c == "E-STMT-MISSING-SEMICOLON" || c == "E-MATCH-ARM-SEPARATOR" || c == "E-STMT-SPLIT-CONTINUATION" || c == "E-STMT-NO-EFFECT"
    }

    // A template chunk's text: a malformed escape (lex.scrml escapeWhy) is refused.
    fn tmplText(tp: TP, chunk: PTok) -> TP {
        if (chunk.bad == "") return tp
        return diagAt(tp, "E-PARSE-TEMPLATE", "this template's text holds " + chunk.bad + " (§14.13.3) — a template's escapes are a JavaScript template's: `\\n`, `\\t`, `\\``, `\\" + interpOpen() + "`, `\\xHH`, `\\uHHHH`, `\\u{H…}`", chunk)
    }

    fn tmplUnclosed(tp: TP, first: PTok) -> TP {
        return diagAt(tp, "E-PARSE-TEMPLATE", "this template is not closed — end it with a backtick (§14.13.3)", first)
    }

    // Past a slot's extra tokens, to its `}` (a nested template's slots skipped whole).
    fn skipToSlotEnd(tp: TP) -> TP {
        let t: TP = tp
        let depth: int = 0
        let going: boolean = true
        while (going && !atEnd(t)) {
            const x: PTok = cur(t)
            if (x.cls == TC.TIEnd && depth == 0) {
                going = false
            } else {
                if (x.cls == TC.TIStart) depth = depth + 1
                if (x.cls == TC.TIEnd) depth = depth - 1
                t = adv(t)
            }
        }
        return t
    }

    // s442: array elements up to (and consuming) `]`; `...e` is a Spread element.
    fn parseArrayElems(tp: TP) -> RExprs {
        let t: TP = tp
        let out: AExpr[] = []
        let going = !isP(t, "]") && !atEnd(t)
        while (going) {
            if (isSpread(t)) {
                const sstart: int = cur(t).start
                const sv: RExpr = parseSpreadValue(t)
                const sp: RExpr = mkE(sv.tp, sstart, AExprK.Spread(sv.e))
                out = out.concat([sp.e])
                t = sp.tp
            } else {
                const r: RExpr = parseAssign(t)
                out = out.concat([r.e])
                t = r.tp
            }
            if (isP(t, ",")) {
                t = adv(t)
                if (isP(t, "]")) going = false
            } else {
                going = false
            }
        }
        return { es: out, tp: expectP(t, "]") }
    }

    // s442: `(a, b) =>` — the parameter names when the parenthesis at `tp` is a
    // lambda's parameter list (only names and commas, then `=>`), else `not`.
    fn lambdaParams(tp: TP) -> string[] | not {
        let k: int = 1
        let names: string[] = []
        let going = true
        while (going) {
            const x: PTok = peekAt(tp, k)
            if (x.cls == TC.Ident) {
                names = names.concat([x.v])
                k = k + 1
                const sep: PTok = peekAt(tp, k)
                if (tk(sep, ",")) {
                    k = k + 1
                } else if (tk(sep, ")")) {
                    going = false
                } else {
                    return not
                }
            } else if (tk(x, ")") && names.length == 0) {
                going = false
            } else {
                return not
            }
        }
        if (!tk(peekAt(tp, k + 1), "=>")) return not
        return names
    }

    // s478 (s478-boot-fn-type) — `(` [`lin`] name `:` … `)` `=>`: an arrow with written
    // parameter types.
    fn typedArrowAhead(tp: TP) -> boolean {
        const a: PTok = peekAt(tp, 1)
        let named: boolean = a.cls == TC.Ident && tk(peekAt(tp, 2), ":")
        if (a.cls == TC.Keyword && a.v == "lin" && peekAt(tp, 2).cls == TC.Ident && tk(peekAt(tp, 3), ":")) named = true
        if (!named) return false
        const close: int = parenClose(tp)
        if (close < 0) return false
        return tk(peekAt(tp, close + 1), "=>")
    }

    fn parseTypedLambda(tp: TP, start: int) -> RExpr {
        const rp: RParams = parseParamList(adv(tp), false)
        const t: TP = expectP(rp.tp, ")")
        let names: string[] = []
        for (const p of rp.ps) { names = names.concat([p.name]) }
        const at: TP = adv(t)       // past `=>`
        if (isP(at, "{")) {
            // §19.16.3 rule 4: an arrow body is no defer site (analyze reports one)
            const b: RBlock = parseBlock(withInFn(at, 2))
            return mkE(withInFn(b.tp, tp.inFn), start, AExprK.BlockLambda(rp.ps, b.b, false))
        }
        const body: RExpr = parseAssign(at)
        return mkE(body.tp, start, AExprK.Lambda(names, body.e, rp.ps))
    }

    // Past a lambda's `( … )` (lambdaParams said it is one), at its `=>`.
    fn skipParams(tp: TP) -> TP {
        let t: TP = adv(tp)
        while (!isP(t, ")") && !atEnd(t)) { t = adv(t) }
        return adv(t)
    }

    // At `=>`: the lambda's body (§7.2 arrow functions) — one expression, or
    // (s478-boot-block-lambda) a braced statement block whose `return`s are
    // the lambda's own: §7.2 "All JavaScript that is valid in a Bun execution
    // context is valid inside `${ }`, except the constructs §7.2.1 excludes"
    // (a block-bodied arrow is not excluded). Where one may stand and what its
    // body may hold is analyze's (resolveLambda).
    fn parseLambda(tp: TP, start: int, params: string[]) -> RExpr {
        const t: TP = adv(tp)
        if (isP(t, "{")) {
            const rp: RParams = bareParams(t, start, params)
            // §19.16.3 rule 4: an arrow body is no defer site (analyze reports one)
            const b: RBlock = parseBlock(withInFn(rp.tp, 2))
            return mkE(withInFn(b.tp, tp.inFn), start, AExprK.BlockLambda(rp.ps, b.b, false))
        }
        const body: RExpr = parseAssign(t)
        return mkE(body.tp, start, AExprK.Lambda(params, body.e, []))
    }

    // s478 — an arrow's bare parameters as AParams (no type: the position fixes
    // it, §7.5 "Lambdas given to a tape method are inferred"), each its own node id.
    fn bareParams(tp: TP, start: int, names: string[]) -> RParams {
        let t: TP = tp
        let ps: AParam[] = []
        for (const n of names) {
            ps = ps.concat([{ nid: t.nid, span: { start: start, end: start }, name: n, ty: not, lin: false }])
            t = bumpId(t)
        }
        return { ps: ps, tp: t }
    }

    // s478 (s478-boot-block-lambda) — `function (a: T, b: U) { … }` where a value
    // stands: a function EXPRESSION (§7.2; §35.6 "a closure (arrow function
    // expression or `function` expression)"). Its parameters are read as a
    // declaration's are (§7.5: "Every parameter of a `function` / `fn`
    // declaration or expression — named or anonymous … SHALL carry `: T`" —
    // analyze judges that); its body is a block whose `return`s are its own and
    // which is no defer site (§19.16.3 rule 4: "the body of an arrow function or
    // function expression"). A name, a return-type annotation or a `!` are not
    // read by the bootstrap: refused by name (INTERIM).
    fn parseFnExpr(tp: TP, start: int) -> RExpr {
        let t: TP = adv(tp)
        if (cur(t).cls == TC.Ident) {
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a NAMED function expression `function " + cur(t).v + "(…) { … }` used as a value is not in the bootstrap (INTERIM) — drop the name (`function (…) { … }`), or declare it as a statement (§7.3.1) and pass its name", cur(t))
            t = adv(t)
        }
        const rp: RParams = parseParamList(expectP(t, "("), false)
        t = expectP(rp.tp, ")")
        const a: PTok = cur(t)
        if (!isP(t, "{")) {
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a function expression with a return-type annotation or a `!` (`function (…) -> T { … }`) is not in the bootstrap (INTERIM) — the value its `return`s give is inferred; drop the annotation", a)
            while (!isP(t, "{") && !atEnd(t)) { t = adv(t) }
        }
        const b: RBlock = parseBlock(withInFn(t, 2))   // §19.16.3 rule 4: a function-expression body is a lowered body
        return mkE(withInFn(b.tp, tp.inFn), start, AExprK.BlockLambda(rp.ps, b.b, true))
    }

    // s479 — `not` at a primary. §42.10: "`not` SHALL NOT appear in prefix position
    // before a boolean expression — in EITHER form (bare `not @x` / `not f(...)` /
    // `not obj.prop`, OR parenthesized `not (expr)`) and in ANY expression position
    // … The compiler SHALL emit E-TYPE-045 in all such positions." So `not`
    // followed by the start of an operand is E-TYPE-045 at the `not` (the §42.10
    // message), and the operand is read (a unary operand, as `!`'s is) and dropped
    // — the expression is Recovered, so nothing cascades from it. Any other `not`
    // is the absence value.
    // INTERIM (§7.2.2 "Remaining newline-sensitive readings"): the operand must
    // start on the `not`'s line. Rule 4 makes `not⏎@b;` the prefix `not @b`, but
    // the legacy newline-terminated `@a = not⏎@b = not` (20 corpus samples) is a
    // missing `;` after the `not`, and is reported so — the `return⏎expr`
    // precedent (rule 8): the bootstrap does not guess across a line break while
    // newline-terminated code is migrated. Either way it is an error.
    fn notPrimary(tp: TP, start: int) -> RExpr {
        const t1: TP = adv(tp)
        if (cur(t1).line != cur(tp).line || !notOperandAt(t1)) return mkE(t1, start, AExprK.NotLit)
        const d: TP = diagAt(tp, "E-TYPE-045", "`not` is the absence value, not a negation operator (§42.10). Use `!` for boolean negation: `!expr` (bare) or `!(expr)` (parenthesized). To check for absence, use `x is not`.", cur(tp))
        const operand: RExpr = parseUnary(adv(d))
        return mkE(operand.tp, start, AExprK.Recovered)
    }

    // Does an operand start at `tp` (the token after a `not`)? A cell, a name that is
    // not a word operator, a literal, a template, `(`, `[`, `!`, or a value keyword.
    fn notOperandAt(tp: TP) -> boolean {
        const c: PTok = cur(tp)
        if (c.cls == TC.At || c.cls == TC.Num || c.cls == TC.Str || c.cls == TC.TChunk) return true
        if (c.cls == TC.Ident) return !(wordOperatorAt(tp) || deferNonLead(c.v))
        if (c.cls == TC.Keyword) return ["true", "false", "not", "this", "typeof", "await", "new"].indexOf(c.v) >= 0
        // (`not !{ … }` is a handler on the value `not`, §19.4.3 — a `!` before `{` opens no operand)
        if (c.cls == TC.Punct) return tk(c, "(") || tk(c, "[") || (tk(c, "!") && !isP(adv(tp), "{"))
        return false
    }

    fn parseKeywordPrimary(tp: TP) -> RExpr {
        const t: PTok = cur(tp)
        const start: int = t.start
        if (t.v == "true") return mkE(adv(tp), start, AExprK.Bool(true))
        if (t.v == "false") return mkE(adv(tp), start, AExprK.Bool(false))
        if (t.v == "not") return notPrimary(tp, start)
        if (t.v == "null" || t.v == "undefined") {
            const d: TP = diagAt(tp, "E-PARSE-NO-NULL", "`" + t.v + "` does not exist in scrml — absence is `not` (§42)", t)
            return mkE(adv(d), start, AExprK.Recovered)
        }
        // s451 (Ue): `match e { … }` (§19.7.1 — analyze admits a failable subject)
        if (t.v == "match") return parseMatch(tp, start)
        // s469 — a `for` where a value stands but is not bound (§49.4.4: "A
        // `for` in any other expression position (an operand, an argument, a
        // `return` operand) is neither and is a syntax error"). The SPEC names
        // no code for that syntax error, so the bootstrap refuses it by name.
        // Read past as a loop (so its own errors report).
        if (t.v == "for") {
            const df: TP = diagAt(tp, "E-BOOTSTRAP-UNSUPPORTED", "a `for` is a value only where it is BOUND (`const xs = for (…) { … lift e; … };`, §49.2.1) or is the sole content of a markup `" + interpOpen() + " }` (§17.4) — as an operand, an argument or a `return` operand it is a syntax error (§49.4.4); bind it first: `const xs = for (…) { … };`", t)
            const rf: RStmt = parseFor(df, "", start)
            // (refused: its body is not judged as statements — s469 E-STMT-NO-EFFECT)
            return mkE(dropNoEffect(rf.tp, df.diags.length), start, AExprK.Recovered)
        }
        // s475 — an `if` where a value stands (if-as-expression §17.6, the value
        // form §17.6.10): parseValueIfExpr. Its head takes its parentheses here
        // (§17.6.1 `'if' '(' condition ')'`); only the sole content of a markup
        // `${ … }` may drop them (§17.6.10 `'if' condition`, parseInterp).
        if (t.v == "if") return parseValueIfExpr(tp, false)
        // s478 — `function (…) { … }` where a value stands: a function expression
        if (t.v == "function" && (tk(peekAt(tp, 1), "(") || peekAt(tp, 1).cls == TC.Ident)) return parseFnExpr(tp, start)
        return mkE(adv(tp), start, AExprK.Name(t.v))
    }

    // `@name` (a cell / handle / declaration reference) or `@.` (the current
    // <each> item). The `@` must touch what follows it.
    fn parseAt(tp: TP) -> RExpr {
        const at: PTok = cur(tp)
        const nx: PTok = peekAt(tp, 1)
        if (touching(at, nx) && (nx.cls == TC.Ident || nx.cls == TC.Keyword)) {
            return mkE(adv(adv(tp)), at.start, AExprK.At(nx.v))
        }
        if (touching(at, nx) && nx.cls == TC.Punct && tk(nx, ".")) {
            return mkE(adv(tp), at.start, AExprK.AtItem)
        }
        const bad: TP = diagAt(tp, "E-PARSE-AT", "`@` must be followed by a name (`@count`) or `.` (`@.field`)", at)
        return mkE(adv(bad), at.start, AExprK.Recovered)
    }

    fn isSpread(tp: TP) -> boolean {
        const a: PTok = cur(tp)
        const b: PTok = peekAt(tp, 1)
        const c: PTok = peekAt(tp, 2)
        if (!tk(a, ".") || !tk(b, ".")) return false
        if (!tk(c, ".") && c.cls != TC.Variant) return false
        return touching(a, b) && touching(b, c)
    }

    // The spread's value: after `..` + `.x` (a bare-variant token, when the
    // spread names a local) or after `...`.
    fn parseSpreadValue(tp: TP) -> RExpr {
        const t2: TP = adv(adv(tp))
        const c: PTok = cur(t2)
        if (c.cls == TC.Variant) {
            const base: RExpr = mkE(adv(t2), c.start, AExprK.Name(c.v))
            return parsePostfixFrom(base, c.start)
        }
        return parseAssign(adv(t2))
    }

    fn parseObject(tp: TP) -> RExpr {
        const start: int = cur(tp).start
        let t: TP = adv(tp)
        let props: AProp[] = []
        let going = !isP(t, "}") && !atEnd(t)
        let keyRefused = false          // s475: a computed or number key — the literal is reported once, then Recovered
        while (going) {
            const nameTok: PTok = cur(t)
            const pstart: int = nameTok.start
            if (isSpread(t)) {
                // `...value` — the lexer has no Ellipsis token yet (lex.scrml: deferred), so a
                // spread is three touching `.` tokens.
                const sv: RExpr = parseSpreadValue(t)
                t = sv.tp
                props = props.concat([{ nid: t.nid, span: spanFrom(t, pstart), spread: true, name: "", value: sv.e }])
            } else if (isShorthandName(nameTok) && (isP(adv(t), ",") || isP(adv(t), "}"))) {
                // s475 — a shorthand property `{ u }` is the longhand `{ u: u }`
                // (§18.5's "lone shorthand name"; §12.4: "a shorthand property `{ u }`
                // is the longhand `{ u: u }`"): the value is the name, read as written
                const sv: RExpr = mkE(adv(t), pstart, AExprK.Name(nameTok.v))
                t = sv.tp
                props = props.concat([{ nid: t.nid, span: spanFrom(t, pstart), spread: false, name: nameTok.v, value: sv.e }])
            } else if (isP(t, "[")) {
                // s475 (#1762 review item 4) — a `[computed]: value` entry. §18.5's
                // object-literal test reads it as an object entry (armObjectShape),
                // but a scrml object literal is a struct value constructed BY FIELD
                // NAME (§66.18, §14.3): a key known only at run time names no field.
                // PERMANENT (a computed key cannot be checked against a struct's
                // fields): one report, and the entry is read past whole — `[ … ]`,
                // `:`, its value — so nothing cascades.
                t = diagAt(t, "E-PARSE-OBJECT", "a computed key `[…]: value` in an object literal — an object literal is a struct value, built by field name (§66.18, §14.3), and a key computed at run time names no field; write the field's name (`name: value`)", nameTok)
                t = expectP(skipParens(t), ":")          // (scanHead balances every bracket kind: past the `]`)
                const cv: RExpr = parseAssign(t)
                t = cv.tp
                props = props.concat([{ nid: t.nid, span: spanFrom(t, pstart), spread: false, name: "", value: cv.e }])
                keyRefused = true
            } else {
                if (nameTok.cls == TC.Num) {
                    // s475 (#1762 review item 4) — §18.5's object test admits a number
                    // literal key (JavaScript reads `{ 1: x }`), but a struct field is
                    // named by an identifier (§14.3 `field: type`): no field is `1`
                    t = diagAt(t, "E-PARSE-OBJECT", "a number `" + nameTok.text + "` is not a field name — an object literal is a struct value, built by field name (§66.18), and a struct field is named by an identifier (§14.3 `field: type`); write the field's name (`name: value`)", nameTok)
                    keyRefused = true
                } else if (nameTok.cls != TC.Ident && nameTok.cls != TC.Keyword && nameTok.cls != TC.Str) {
                    t = diagAt(t, "E-PARSE-OBJECT", "expected a field name, found `" + nameTok.text + "`", nameTok)
                }
                t = expectP(adv(t), ":")
                const v: RExpr = parseAssign(t)
                t = v.tp
                props = props.concat([{ nid: t.nid, span: spanFrom(t, pstart), spread: false, name: nameTok.v, value: v.e }])
            }
            t = bumpId(t)
            if (isP(t, ",")) {
                t = adv(t)
                if (isP(t, "}")) going = false
            } else {
                going = false
            }
        }
        t = expectP(t, "}")
        // (a refused key: the literal is a parse-error placeholder — no struct type is
        // judged against an entry list that names no field, so no E-TYPE-STRUCT-FIELD cascade)
        if (keyRefused) return mkE(t, start, AExprK.Recovered)
        return mkE(t, start, AExprK.ObjectLit(props))
    }

    // =========================================================================
    // Statements and blocks.
    // =========================================================================
    fn mkS(tp: TP, start: int, k: AStmtK) -> RStmt {
        const s: AStmt = { nid: tp.nid, span: spanFrom(tp, start), k: k }
        return { s: s, tp: bumpId(tp) }
    }

    // `{ stmt* }`
    export fn parseBlock(tp: TP) -> RBlock {
        const start: int = cur(tp).start
        const b0: int = hardErrors(tp.diags)
        let t: TP = expectP(tp, "{")
        let stmts: AStmt[] = []
        while (!isP(t, "}") && !atEnd(t)) {
            const before: int = t.i
            if (isP(t, ";")) {
                // an empty statement (a `;` after a block-like statement, `;;`)
                t = adv(t)
            } else {
                const r: RStmts = parseTermStmts(t, b0)
                stmts = stmts.concat(r.ss)
                t = r.tp
            }
            if (t.i == before) t = adv(t)
        }
        t = expectP(t, "}")
        const b: ABlock = { nid: t.nid, span: spanFrom(t, start), stmts: stmts }
        return { b: b, tp: bumpId(t) }
    }

    // s469 — dpa-073 F1 (a) "`;` terminates" + F3 (i) "Every statement": `;`
    // ends every statement that is not block-like, the last one before a `}`
    // included (`onclick={ @n = @n + 1; }`). Block-like statements, whose own
    // `{ … }` (or closer) ends them, take none: `if` / `else`, `for`, a
    // statement `match`, `given`, `when … changes { … }` / `<effect>`, and
    // `defer { … }`. A statement with no `;` after it is
    // E-STMT-MISSING-SEMICOLON ("Expected `;` to end the statement", the
    // dpa-073 F6 code), its span the empty span at the statement's end — where
    // the `;` goes. Cascade guard: once a block has reported an error (`d0` is
    // its error count when it opened), its later statements are not also
    // reported for their terminators — a broken expression can swallow the
    // block's `}` and run on into what follows. (impl#1 keeps reading
    // newline-terminated statements — a carried divergence, dpa-073 F5.)
    fn parseTermStmt(tp: TP, d0: int) -> RStmt {
        const h0: int = hardErrors(tp.diags)
        const r: RStmt = parseTermStmtBare(tp, d0)
        return stmtChecks(r.tp, r.s, d0, h0)
    }

    // The statement and its terminator, without the no-effect judgment (an arm
    // block's LAST statement, whose position — value or statement — is the
    // enclosing form's: see parseArmBlock).
    fn parseTermStmtBare(tp: TP, d0: int) -> RStmt {
        const r: RStmt = parseStmt(tp)
        return { s: r.s, tp: termAfter(r.tp, r.s, d0) }
    }

    // =========================================================================
    // s469 — E-STMT-NO-EFFECT (§40.8, §7.2.2 rule 9; RULED S469 "Build both":
    // "a pure expression statement on either line, including after a
    // block-like `}`"). An EXPRESSION statement whose expression has no effect
    // — no call (any call), no assignment, no `?{ … }` query (§40.8's list; the
    // bootstrap has no `++` / `--` / `new` / `delete` / tagged template, each
    // refused where it is written) — computes a value and drops it: `-1;`,
    // `(x);`, `[1];`, a bare template, a bare literal or name, `x => y;` (a
    // lambda's body is not run by the statement). Not judged here:
    //   - a value position (§40.8 "Not expression statements"): an arm's
    //     single-expression body, a `lift` / `return` / `fail` operand, an
    //     arm block's LAST statement where the arm's value is used (only a
    //     statement-position `match` / `!{}` makes it a statement — armTails);
    //   - a handling form at the top of the statement (`x?`, `x !{ … }`, a
    //     statement `match`): it handles a failure or chooses a branch, and its
    //     arms are judged on their own (PA reading, S469 — see the progress note);
    //   - a parse-error placeholder (its error was reported);
    //   - after a hard error in the same block (the cascade guard, as termAfter);
    //   - a statement beside a terminator error (E-STMT-MISSING-SEMICOLON /
    //     E-STMT-SPLIT-CONTINUATION at its end or just before it): the two
    //     halves may be one expression written across a missing `;`, and the
    //     one root cause is reported once (`x⏎[1];`, `break⏎label;`, the
    //     refused `return⏎expr;` — each keeps exactly its terminator report).
    // Two no-effect statements on one line are one report (§40.8). The `~`
    // exemption (§32.2) has nothing to apply to: the bootstrap has no `~`.
    // =========================================================================
    // s475 (#1762 review item 3): returns the statement too — armTails may re-read
    // a value-`if` arm brace of a statement-position `match` / `!{}` as statements.
    fn stmtChecks(tp: TP, s: AStmt, d0: int, h0: int) -> RStmt {
        const t: TP = noEffectStmt(tp, s, d0)
        if (hardErrors(t.diags) == h0) return armTails(t, s, d0)
        return { s: s, tp: t }
    }

    fn noEffectStmt(tp: TP, s: AStmt, d0: int) -> TP {
        const x: AExpr | not = stmtExpr(s)
        if (x is not) return tp
        if (exprHasEffect(x)) return tp
        if (hardErrors(tp.diags) > d0) return tp
        if (besideTermError(tp, s.span)) return tp
        // two (or more) on one line, one after the other (`a; b;`) are one report
        if (tp.diags.length > 0) {
            const prev: Diag = tp.diags[tp.diags.length - 1]
            if (prev.code == "E-STMT-NO-EFFECT" && lineAt(tp, prev.span.start) == lineAt(tp, s.span.start) && onlySemisBetween(tp, prev.span.end, s.span.start)) return tp
        }
        let shown: string = ""
        // the statement's own span (a parenthesized `(a)` included), without its `;`
        const i0: int = tokIndexAt(tp, s.span.start)
        if (i0 >= 0) {
            let i1: int = i0
            let plain = true
            while (i1 < tp.toks.length && tp.toks[i1].cls != TC.End && tp.toks[i1].end <= s.span.end) {
                const c: TC = tp.toks[i1].cls
                if (c == TC.TChunk || c == TC.TIStart || c == TC.TIEnd) plain = false
                i1 = i1 + 1
            }
            const txt: string = tokText(tp, i0, i1)
            if (plain && txt.length <= 40 && txt.indexOf("\n") < 0) shown = " `" + txt + "`"
        }
        const msg: string = "this statement has no effect —" + shown + " computes a value and discards it: it holds no call, assignment or query (§40.8, §7.2.2 rule 9). Remove it, or use the value — assign it, pass it to a call, return it, or show it in markup (`<span>" + interpOpen() + "…}</span>`)"
        // (a template's first chunk starts after its opening backtick — the span takes the backtick in)
        let from: int = s.span.start
        if (i0 >= 0 && tp.toks[i0].cls == TC.TChunk && from > 0) from = from - 1
        const d: Diag = newDiag("E-STMT-NO-EFFECT", msg, tp.file, mkSpan(from, s.span.end))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // A statement-position `match` / `!{}` (the whole expression statement): its
    // block arms yield nothing (§18.5), so each block's LAST statement is a
    // statement too — judged here (parseArmBlock left it alone). A `lift` there
    // is analyze's refusal (it yields to nothing), not judged.
    fn armTails(tp: TP, s: AStmt, d0: int) -> RStmt {
        const x: AExpr | not = stmtExpr(s)
        if (x is not) return { s: s, tp: tp }
        const arms: AArm[] = handledArms(x)
        if (arms.length == 0) return { s: s, tp: tp }
        let t: TP = tp
        let out: AArm[] = []
        for (const a0 of arms) {
            let a: AArm = a0
            // s475 (#1762 review item 3) — a value-`if` brace (valueIfBrace) is the
            // arm's ONE expression only where its value is used; here the brace is a
            // statement list (§7.2.2 rule 1; §18.5 "In a STATEMENT position a block arm
            // yields nothing"), so it is re-read as one: its `if` is a statement `if`,
            // whose branches owe their own `;` (reported by that reading, as for any block)
            if (a.bare && valueIfArm(t, a)) {
                const rr: RArmReread = stmtArmReread(t, a)
                a = rr.a
                t = rr.tp
            }
            const b: ABlock | not = armBlockOf(a)
            if (b is given && !a.lifted && b.stmts.length > 0) {
                const last: AStmt = b.stmts[b.stmts.length - 1]
                // s474 #1512 — a `{ e }` brace (one expression, no `;`) is that
                // expression only where the arm's value is used (§18.5, RULED
                // S469 "`{ e }` in a value-position match arm is that
                // expression"); here the block is a statement list (§7.2.2
                // rule 1), so its statement owes its `;` — reported where it
                // goes, as termAfter would have (the cascade guard included)
                if (a.bare && hardErrors(t.diags) <= d0) t = bareArmSemi(t, last)
                const rl: RStmt = stmtChecks(t, last, d0, hardErrors(t.diags))
                t = rl.tp
                a = withArmBlock(a, { nid: b.nid, span: b.span, stmts: b.stmts.slice(0, b.stmts.length - 1).concat([rl.s]) }, a.lifted, a.bare)
            }
            out = out.concat([a])
        }
        return { s: withArmsStmt(s, x, out), tp: t }
    }

    type RArmReread:struct = { a: AArm, tp: TP }

    // s475 r1 (#1767 review F3) — the expression statement `s` (a `match` / `!{}`),
    // its value-`if` brace arms re-read as statement lists; nothing else judged here.
    fn valueIfArmsReread(tp: TP, s: AStmt) -> RStmt {
        const x: AExpr | not = stmtExpr(s)
        if (x is not) return { s: s, tp: tp }
        const arms: AArm[] = handledArms(x)
        if (arms.length == 0) return { s: s, tp: tp }
        let t: TP = tp
        let out: AArm[] = []
        let changed = false
        for (const a0 of arms) {
            let a: AArm = a0
            if (a.bare && valueIfArm(t, a)) {
                const rr: RArmReread = stmtArmReread(t, a)
                a = rr.a
                t = rr.tp
                changed = true
            }
            out = out.concat([a])
        }
        if (!changed) return { s: s, tp: tp }
        return { s: withArmsStmt(s, x, out), tp: t }
    }

    // Is this `bare` arm a value-`if` brace (valueIfBrace: the block `[Eval(if …)]`,
    // written `{ if … }`)? A `{ e }` brace never starts with `if` (parseStmt reads a
    // statement `if` there), so the brace's first token decides.
    fn valueIfArm(tp: TP, a: AArm) -> boolean {
        const b: ABlock | not = armBlockOf(a)
        if (b is not) return false
        const i: int = tokIndexAt(tp, b.span.start)
        if (i < 0 || i + 1 >= tp.toks.length) return false
        const w: PTok = tp.toks[i + 1]
        return isNameTok(w) && w.v == "if"
    }

    // The arm's brace read again as a statement-list block (parseArmBlock), from its
    // `{` — fresh node ids from `tp`, and that reading's own diagnostics.
    // s475 r1 (#1767 review F2): the discarded value reading's diagnostics inside the
    // brace (a soft one — a warning — survives valueIfBrace, which only refuses on a
    // hard error) are dropped first, so the statement reading's own are not reported twice.
    fn stmtArmReread(tp: TP, a: AArm) -> RArmReread {
        const b: ABlock | not = armBlockOf(a)
        if (b is not) return { a: a, tp: tp }
        const i: int = tokIndexAt(tp, b.span.start)
        if (i < 0) return { a: a, tp: tp }
        let kept: Diag[] = []
        for (const d of tp.diags) {
            if (d.span.start < b.span.start || d.span.end > b.span.end) kept = kept.concat([d])
        }
        const rb: RArmBlock = parseArmBlock({ toks: tp.toks, i: i, nid: tp.nid, diags: kept, file: tp.file, ns: tp.ns, inFn: tp.inFn })
        return { a: withArmBlock(a, rb.b, rb.lifted, rb.bare), tp: { toks: tp.toks, i: tp.i, nid: rb.tp.nid, diags: rb.tp.diags, file: tp.file, ns: rb.tp.ns, inFn: rb.tp.inFn } }
    }

    fn withArmBlock(a: AArm, b: ABlock, lifted: boolean, bare: boolean) -> AArm {
        return { nid: a.nid, span: a.span, pat: a.pat, body: AArmBody.ArmBlock(b), legacy: a.legacy, lifted: lifted, bare: bare }
    }

    // The expression statement `s` (its expression `x` a `match` / `!{}`) with its arms replaced.
    fn withArmsStmt(s: AStmt, x: AExpr, arms: AArm[]) -> AStmt {
        const hx: AHandled | not = handledOf(x)
        if (hx is given) {
            const how: AHow = hx.how
            const nh: AHow = match how {
                .MatchOn(arms: a) :> AHow.MatchOn(arms)
                .Guard(arms: a) :> AHow.Guard(arms)
                .Propagate :> AHow.Propagate
            }
            const nx: AExpr = { nid: x.nid, span: x.span, k: AExprK.Handled({ subject: hx.subject, how: nh }) }
            return { nid: s.nid, span: s.span, k: AStmtK.Eval(nx) }
        }
        return s
    }

    fn handledOf(e: AExpr) -> AHandled | not {
        const k: AExprK = e.k
        return match k {
            .Handled(h: h) :> h
            .Recovered :> not
            .Sql(q: q) :> not
            .Template(quasis: qs) :> not
            .HashRef(id: hr0) :> not
            .Foreign(f: fb0) :> not
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: sv) :> not
            .Bool(v: bv) :> not
            .NotLit :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: tt) :> not
            .Assign(target: at) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .BlockLambda(params: ps) :> not
        }
    }

    // s474 #1512 — E-STMT-MISSING-SEMICOLON for a `bare` arm's one statement
    // (`.A :> { f() }` in a statement-position `match`): missingSemi read at the
    // token after the statement, so the report and its message are rule 1's own.
    fn bareArmSemi(tp: TP, s: AStmt) -> TP {
        let i: int = tp.i
        if (i >= tp.toks.length) i = tp.toks.length - 1
        while (i > 0 && tp.toks[i - 1].end > s.span.end) { i = i - 1 }
        if (i > 0 && tp.toks[i - 1].end == s.span.end) {
            const r: TP = missingSemi({ toks: tp.toks, i: i, nid: tp.nid, diags: tp.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn })
            return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: r.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn }
        }
        // (fail closed: no token ends where the statement does — report at its end)
        const d: Diag = newDiag("E-STMT-MISSING-SEMICOLON", "Expected `;` to end the statement — insert `;`. In a statement-position `match` / `!{}` an arm's `{ … }` block is a statement list (§7.2.2 rule 1); a `{ e }` brace is its expression only where the arm's value is used (§18.5).", tp.file, mkSpan(s.span.end, s.span.end))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    fn armBlockOf(a: AArm) -> ABlock | not {
        const body: AArmBody = a.body
        return match body {
            .ArmBlock(b: b) :> b
            .ArmExpr(e: e) :> not
        }
    }

    // The arms of a `match` / `!{}` that IS the expression (none otherwise).
    fn handledArms(e: AExpr) -> AArm[] {
        const k: AExprK = e.k
        const none: AArm[] = []
        return match k {
            .Handled(h: h) :> howArms(h.how)
            .Recovered :> none
            .Sql(q: q) :> none
            .Template(quasis: qs) :> none
            .HashRef(id: hr0) :> none
            .Foreign(f: fb0) :> none
            .Name(name: n) :> none
            .At(name: n) :> none
            .AtItem :> none
            .Num(raw: r) :> none
            .Str(v: s) :> none
            .Bool(v: b) :> none
            .NotLit :> none
            .Variant(name: n) :> none
            .Member(obj: o) :> none
            .Call(callee: c) :> none
            .Unary(op: o) :> none
            .Binary(op: o) :> none
            .Ternary(test: t) :> none
            .Assign(target: t) :> none
            .ArrayLit(elems: es) :> none
            .ObjectLit(props: ps) :> none
            .Spread(e: x) :> none
            .Index(obj: o) :> none
            .Lambda(params: ps) :> none
            .BlockLambda(params: ps) :> none
        }
    }

    fn howArms(how: AHow) -> AArm[] {
        const none: AArm[] = []
        return match how {
            .MatchOn(arms: a) :> a
            .Guard(arms: a) :> a
            .Propagate :> none
        }
    }

    // The expression of an expression statement (not, for any other statement).
    fn stmtExpr(s: AStmt) -> AExpr | not {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> e
            .Local(name: n) :> not
            .Return(e: e) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: b) :> not
            .Fail(f: x) :> not
            .For(f: x) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: x) :> not          // s469: a `lift` operand is a value position (§40.8)
            .LocalFn(f: x) :> not
        }
    }

    // Does evaluating `e` do anything (§40.8)? A call, an assignment, a query —
    // anywhere inside it except a lambda's body. A handling form (`?`, `!{}`,
    // `match`) and a parse-error placeholder count as effects (see above).
    fn exprHasEffect(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Call(callee: c) :> true
            .Assign(target: t) :> true
            .Sql(q: q) :> true
            .Handled(h: h) :> true
            .Recovered :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Variant(name: n) :> false
            .Lambda(params: ps) :> false
            .BlockLambda(params: ps) :> false
            .Member(obj: o) :> exprHasEffect(o)
            .Unary(op: o, e: x) :> exprHasEffect(x)
            .Binary(op: o, l: l, r: r) :> exprHasEffect(l) || exprHasEffect(r)
            .Ternary(test: c, yes: y, no: n) :> exprHasEffect(c) || exprHasEffect(y) || exprHasEffect(n)
            .ArrayLit(elems: es) :> anyEffect(es)
            .ObjectLit(props: ps) :> propsEffect(ps)
            .Spread(e: x) :> exprHasEffect(x)
            .Index(obj: o, idx: i) :> exprHasEffect(o) || exprHasEffect(i)
            .Template(quasis: qs, slots: ss) :> anyEffect(ss)
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> true      // s473: host code — the compiler cannot see what it does (§23.2.3)
        }
    }

    fn anyEffect(es: AExpr[]) -> boolean {
        for (const x of es) { if (exprHasEffect(x)) return true }
        return false
    }

    fn propsEffect(ps: AProp[]) -> boolean {
        for (const p of ps) { if (exprHasEffect(p.value)) return true }
        return false
    }

    // Is there a terminator error (a missing `;`, a split continuation) at the
    // end of the statement spanning `sp`, or at the end of the token before it?
    fn besideTermError(tp: TP, sp: ASpan) -> boolean {
        let before: int = -1
        const i0: int = tokIndexAt(tp, sp.start)
        if (i0 > 0) before = tp.toks[i0 - 1].end
        for (const d of tp.diags) {
            if (d.code == "E-STMT-MISSING-SEMICOLON" || d.code == "E-STMT-SPLIT-CONTINUATION") {
                if (d.span.start == sp.end || d.span.start == before) return true
            }
        }
        return false
    }

    // Are the tokens between offset `from` (a token's end) and the token that
    // starts at `to` only `;`s?
    fn onlySemisBetween(tp: TP, from: int, to: int) -> boolean {
        let i: int = tokIndexAt(tp, to) - 1
        while (i >= 0 && tp.toks[i].cls == TC.Punct && tk(tp.toks[i], ";")) { i = i - 1 }
        return i >= 0 && tp.toks[i].end == from
    }

    // The index of the token that starts at `pos` (-1 when none does).
    fn tokIndexAt(tp: TP, pos: int) -> int {
        let i: int = tp.i
        if (i >= tp.toks.length) i = tp.toks.length - 1
        while (i >= 0) {
            if (tp.toks[i].start == pos) return i
            if (tp.toks[i].start < pos) return -1
            i = i - 1
        }
        return -1
    }

    // The source line of offset `pos` (the line of the last token starting at or before it).
    fn lineAt(tp: TP, pos: int) -> int {
        let i: int = tp.i
        if (i >= tp.toks.length) i = tp.toks.length - 1
        while (i >= 0) {
            if (tp.toks[i].start <= pos) return tp.toks[i].line
            i = i - 1
        }
        return 0
    }

    // After statement `s` (the enclosing block's error count was `d0`): its `;`.
    fn termAfter(tp: TP, s: AStmt, d0: int) -> TP {
        if (isP(tp, ";")) return adv(tp)
        if (!needsSemi(s)) return tp
        if (hardErrors(tp.diags) > d0) return tp
        return missingSemi(tp)
    }

    // E-STMT-MISSING-SEMICOLON at the end of the last token consumed.
    fn missingSemi(tp: TP) -> TP {
        let at: int = cur(tp).start
        let after: string = ""
        if (tp.i > 0) {
            const last: PTok = tp.toks[tp.i - 1]
            at = last.end
            if (last.text.length <= 24 && last.text.indexOf("\n") < 0) after = " after `" + last.text + "`"
        }
        // (one report per place: a statement that already reported its own
        // missing `;` here — the split `return`, or a split continuation
        // (E-STMT-SPLIT-CONTINUATION, whose fix-it is this `;`) — is not
        // reported twice)
        if (tp.diags.length > 0) {
            const prev: Diag = tp.diags[tp.diags.length - 1]
            if ((prev.code == "E-STMT-MISSING-SEMICOLON" || prev.code == "E-STMT-SPLIT-CONTINUATION") && prev.span.start == at) return tp
        }
        let msg: string = "Expected `;` to end the statement — insert `;`" + after + ". A `;` ends every statement that is not block-like, the last one before a `}` included (`{ @n = @n + 1; }`); a newline does not end a statement (dpa-073 F1 / F3)."
        // s469 (§7.2.2 rule 4): a `?` glued to what it follows is propagation,
        // which ends the expression — name the conditional's spelling too, where
        // the code goes on after it on its line (`a == 1? 2 : 3`, the conditional
        // the S446 reading took it for)
        msg = msg + gluedQHint(tp)
        const d: Diag = newDiag("E-STMT-MISSING-SEMICOLON", msg, tp.file, mkSpan(at, at))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // Does statement `s` end with a `;` (dpa-073 F3 (i))? A block-like statement
    // does not: its `{ … }` ends it. A braceless body (`if (c) x = 1;`, `defer
    // f();`) took its own `;` when it was parsed (parseBlockOrStmt, parseDefer).
    fn needsSemi(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> !blockLikeExpr(e.k)
            .Local(name: n) :> true
            .Return(e: e) :> true
            .If(cond: c) :> false
            .Given(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: b) :> false
            .Fail(f: x) :> true
            .For(f: x) :> x.bound is given          // s469: a `for-binding` is a declaration (§49.2.1)
            .Break(label: x) :> true
            .Continue(label: x) :> true
            .Lift(what: x) :> true
            .LocalFn(f: x) :> false             // s477: block-like — its `}` ends it
        }
    }

    // An expression statement that is block-like: a statement `match` (the
    // whole statement is the `match`, so its arms' `}` ends it). A `!{}`
    // handler statement (`load() !{ … }`) is not in dpa-073 F3's block-like
    // list, so it takes a `;` (PA reading, fail closed — S469). A parse-error
    // placeholder takes none (its error was reported).
    fn blockLikeExpr(k: AExprK) -> boolean {
        return match k {
            .Handled(h: h) :> isMatchHow(h.how)
            .Recovered :> true
            .Sql(q: q) :> false
            .Template(quasis: qs) :> false
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> false
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .BlockLambda(params: ps) :> false
        }
    }

    fn isMatchHow(how: AHow) -> boolean {
        return match how {
            .MatchOn(arms: a) :> true
            .Propagate :> false
            .Guard(arms: a) :> false
        }
    }

    // s472 (review F3) — an import written as a STATEMENT (a function body, an
    // `if` / loop body): §41.3 "`import` SHALL be valid only inside a `${ }` logic
    // context at file top level" and §21.3.1 "An `import:host` declaration inside
    // a `${}` block or any nested scope SHALL be a compile error (`E-IMPORT-003`
    // — same as plain `import`)". Read whole (parseImport), so its tokens are not
    // a wall of parse errors; E-IMPORT-003 at it. A host import here is still
    // held to the tag and the allow-list (impl#1 host-import.js does the same for
    // an in-function `import:host`): E-IMPORT-009 / E-IMPORT-008 as at file top
    // (analyze.scrml checkHostImport). The statement binds nothing.
    fn nestedImport(tp: TP) -> RStmt {
        const t0: PTok = cur(tp)
        const start: int = t0.start
        const r: RItems = parseImport(tp, start, false)
        let t: TP = r.tp
        for (const it of r.items) {
            const k: AItemK = it.k
            const imp: AImport | not = match k {
                .ImportItem(i: i) :> i
                .TypeItem(t: x) :> not
                .FnItem(f: f) :> not
                .DeclItem(d: d) :> not
                .MarkupItem(n: n) :> not
                .ProgramItem(p: p) :> not
                .ConstItem(c: c) :> not
            }
            if (imp is given) t = judgeNestedImport(t, imp)
        }
        const re: RExpr = mkE(t, start, AExprK.Recovered)
        return mkS(re.tp, start, AStmtK.Eval(re.e))
    }

    fn judgeNestedImport(tp: TP, imp: AImport) -> TP {
        const h: string | not = imp.host
        let ds: Diag[] = []
        if (h is given) {
            ds = ds.concat([newDiag("E-IMPORT-003", "`import:" + h + "` is not at file top level — `import:host` SHALL appear only at file top level, outside any `${}` logic context and any nested scope such as a function body (§21.3.1); move it to the top of the file", tp.file, imp.span)])
            if (h != "host") {
                ds = ds.concat([newDiag("E-IMPORT-009", "`import:" + h + "` uses the host-tag `" + h + "` — v1 recognizes only `host` (§21.3.1)", tp.file, imp.span)])
            } else if (!(imp.from.endsWith(".js") || imp.from.endsWith(".mjs") || imp.from.endsWith(".ts") || imp.from.endsWith(".mts"))) {
                ds = ds.concat([newDiag("E-IMPORT-009", "`import:host` target `" + imp.from + "` is not a TypeScript / JavaScript module (§21.3.1)", tp.file, imp.span)])
            }
            if (!tp.file.startsWith(stdlibPathPrefix())) {
                ds = ds.concat([newDiag("E-IMPORT-008", "`import:" + h + "` is used in a file outside the `[capabilities] host-import` allow-list — `import:host` is the stdlib's host bridge (§21.3.1, §22.13)", tp.file, imp.span)])
            }
        } else {
            ds = ds.concat([newDiag("E-IMPORT-003", "`import` here is inside a function or block — an `import` SHALL be valid only inside a `${ }` logic context at file top level (§41.3, §21.3); move it to the top of the file", tp.file, imp.span)])
        }
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat(ds), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // A block's statements when the region holds them WITHOUT braces (an
    // attribute handler written `{ … }` is lexed with its braces — parseBlock).
    fn parseStmt(tp: TP) -> RStmt {
        const t: PTok = cur(tp)
        const start: int = t.start
        // s478 — bare markup / an implied-`lift` arm in a body-top logic block (logicBlockTP)
        // s478 (markup-in-logic) — a bare row of a Tier-0 region (parseTier0 /
        // parseTier0If): one a value-form branch did not take (§17.6.10.1)
        if (isBareRowOther(t)) return logicRowStmt(tp, start, notMarkupWhy())
        if (isBareRowTok(t)) return unrenderedRowStmt(tp, start, false)
        if (isLocusRow(t)) return misplacedRowStmt(tp, start)
        if (isLogicRowTok(t)) return logicBareStmt(tp, start, "markup standing as a statement in a `" + interpOpen() + " … }` logic block (bare markup, an implied-`lift` arm, §10) is not in the bootstrap — write the markup in the body, under `if=` (§17.1) or `<each>` (§17.7)")
        if (isWord(tp, "let") || isWord(tp, "const")) return parseLocal(tp)
        if (isWord(tp, "lin")) return parseLinLocal(tp)   // s471 (§35.2)
        if (deferAhead(tp)) return parseDefer(tp)      // s451 (§19.16.1)
        if (failAhead(tp)) return parseFail(tp)        // s451 (Ue, §19.3.1)
        if (isWord(tp, "fail")) return bareFail(tp)    // s469 (§7.2.2 rule 10: reserved here)
        // s469 (§7.2.2 rule 10): `transaction` before `{`, on its line or the next
        if (isWord(tp, "transaction") && tk(peekAt(tp, 1), "{")) {
            // s478 (s478-boot-syntax-batch): §19.10.2 "The `transaction` keyword provides a
            // scoped alternative that auto-rolls-back on `fail`" — BUILT. Read as a block
            // (IfForm.Transaction: the scope of a branch whose test is the literal `true`,
            // spanning the keyword); where it may stand (§19.10.4) is analyze's
            // (transactionDiags), its commit-or-rollback the printer's (Core If `tx`).
            // §19.10.4: "A `transaction` block outside a `!` function — … or at the top level of a
            // `${}` logic block, outside any function (S453) — SHALL be a compile error (E-ERROR-001
            // applies …)". In no function body (TP.inFn 0: top-level logic, a handler attribute) the
            // block is refused here and its statements read and dropped (a Recovered node), so the
            // one root cause is reported once; inside a function body analyze judges it
            // (txRulesPass: the function, a nested function, a lambda or an effect body).
            if (tp.inFn == 0) {
                const dt: TP = diagAt(tp, "E-ERROR-001", "a `transaction { … }` block outside any function — a `transaction` block is valid only inside a `!` function (§19.10.4): its commit-or-rollback promise is a failure-handling promise, and at the top level of a logic block (or in a handler) a failure inside it has nowhere to go. Move the block into a function declared with '!' — 'function save(...)! ErrorType { transaction { … } }' — and call it", t)
                const rb0: RBlock = parseBlock(adv(dt))
                const re: RExpr = mkE(rb0.tp, start, AExprK.Recovered)
                return mkS(re.tp, start, AStmtK.Eval(re.e))
            }
            const rb: RBlock = parseBlock(adv(tp))
            const yes: AExpr = { nid: rb.tp.nid, span: mkSpan(t.start, t.end), k: AExprK.Bool(true) }
            return mkS(bumpId(rb.tp), start, AStmtK.If(yes, rb.b, not, IfForm.Transaction))
        }
        // s469 — `lift` (§49.6.2): a statement; which bound loop it appends to
        // — and whether one encloses it — is analyze's (resolveLift). An arm
        // block's LAST `lift` is the arm's value (parseArmBlock, §18.5).
        if (isWord(tp, "lift")) return parseLift(tp)
        // s472 (review F3): an `import` / `import:<tag>` in a statement position
        if (isWord(tp, "import")) return nestedImport(tp)
        // s477 — a nested function declaration (§7.3.1). `fn` starts one only
        // before a name (`fn(…) { … }` is an anonymous `fn` expression, §48.2.1);
        // `server` only before `function` / `fn` (analyze refuses the modifier
        // on a nested declaration). Where one may stand is analyze's.
        if (localFnAhead(tp)) {
            let lt: TP = tp
            let srv = false
            if (isWord(lt, "server")) {
                srv = true
                lt = adv(lt)
            }
            const rf: RFnDecl = parseFnDecl(lt, start, false, isWord(lt, "fn"), srv)
            return mkS(rf.tp, start, AStmtK.LocalFn(rf.f))
        }
        if (isWord(tp, "return")) {
            const nx: PTok = peekAt(tp, 1)
            if (nx.cls == TC.End || tk(nx, "}") || tk(nx, ";")) {
                return mkS(adv(tp), start, AStmtK.Return(not))
            }
            // s469 — dpa-073 F6 reads `return⏎expr;` as returning `expr` (F1 (a):
            // a newline ends nothing). Until the newline-terminated corpus is
            // migrated (F5 steps 2–3) that reading would silently turn a legacy
            // `return⏎next();` into `return next();`, so the split form is
            // REFUSED, fail closed (PA reading, S469): E-STMT-MISSING-SEMICOLON
            // at the end of `return` — the legacy meaning's fix-it — whose message
            // names the other repair.
            if (nx.line != t.line) {
                const rt: TP = adv(tp)
                const d: Diag = newDiag("E-STMT-MISSING-SEMICOLON", "Expected `;` to end the statement — insert `;` after `return` to return nothing, or put the returned value on the `return` line. A `return` followed by a line break is refused for now: dpa-073 F1 reads `return⏎expr;` as returning `expr`, and the bootstrap does not guess which was meant while newline-terminated code is still being migrated.", rt.file, mkSpan(t.end, t.end))
                const rd: TP = { toks: rt.toks, i: rt.i, nid: rt.nid, diags: rt.diags.concat([d]), file: rt.file, ns: rt.ns, inFn: rt.inFn }
                return mkS(rd, start, AStmtK.Return(not))
            }
            const v: RExpr = parseAssign(adv(tp))
            return mkS(v.tp, start, AStmtK.Return(v.e))
        }
        // s469 — the one loop (§49): `for`, a labelled `for`, `break` / `continue`,
        // and the retired spellings, refused with their §34 codes
        if (isWord(tp, "for")) return parseFor(tp, "", start)
        if (labelAhead(tp)) return parseFor(adv(adv(tp)), t.v, start)
        if (isWord(tp, "while")) return retiredWhile(tp)
        if (isWord(tp, "do")) return retiredDoWhile(tp)
        if (isWord(tp, "break")) return parseJump(tp, true)
        if (isWord(tp, "continue")) return parseJump(tp, false)
        if (isWord(tp, "if")) return parseIf(tp)
        if (isWord(tp, "else")) return orphanElse(tp)    // s478 (§17.1.1, gap g-bootstrap-unclaimed-else-misdiagnosed-as-undeclared-s462)
        if (isWord(tp, "given")) return parseGiven(tp)
        if (whenAhead(tp)) {
            const rw: REffect = parseWhen(tp)
            return mkS(rw.tp, start, AStmtK.EffectStmt(rw.w))
        }
        if (effectTagAhead(tp)) {
            const re: REffect = parseEffectTokens(tp)
            return mkS(re.tp, start, AStmtK.EffectStmt(re.w))
        }
        // s469 r3 — dpa-073 F3 (i): a `match` that STARTS a statement is
        // block-like, and its arms' `}` ends the statement (a value `match` —
        // `const v = match …`, `@x = match …`, one inside an expression — is
        // parsed by parseAssign and still needs its `;`). So `match k { … }⏎-1;`
        // is two statements, never `match … - 1`. On the SAME line, a token that
        // would continue an expression after the `}` (`match k { … } + 2`) is
        // refused (E-PARSE-TRAILING) rather than silently split: the writer
        // plainly meant one expression, and its value form is `(match …) + 2`.
        if (isWord(tp, "match")) {
            const rm: RExpr = parseMatch(tp, start)
            let mt: TP = rm.tp
            if (mt.i > 0 && continuesAfterBlock(mt)) {
                const x: PTok = cur(mt)
                mt = diagAt(mt, "E-PARSE-TRAILING", "unexpected `" + x.text + "` after a statement `match`: a `match` that starts a statement ends at its `}` (dpa-073 F3) — to use its value in an expression, write the expression around it: `(match … { … }) " + x.text + " …`, or start the statement with something else (`const v = match … { … };`)", x)
                const rr: RExpr = parseAssign(mt)
                mt = rr.tp
            }
            return mkS(mt, start, AStmtK.Eval(rm.e))
        }
        // s478-boot-semicolon-residue — a `{` that STARTS a statement is a bare block
        // (bareBlock), never an object literal
        if (isP(tp, "{")) return bareBlock(tp)
        // s478 — a keywordless declaration analysis proved (PNs.kw, §50.8.5): `x = e;` read as `const x = e;`
        if (kwDeclAhead(tp)) {
            const kinit: RExpr = parseAssign(adv(adv(tp)))
            return mkS(kinit.tp, start, AStmtK.Local(t.v, false, not, kinit.e, false))
        }
        const e: RExpr = parseAssign(tp)
        return mkS(e.tp, start, AStmtK.Eval(e.e))
    }

    // s478 (triage C14) — a statement that STARTS with `else`: an `else` no `if` claims
    // (`@r = "a" else @r = "b"`, or `if (c) { … }; else …`, whose `;` ended the `if`).
    // An `else` continues the `if` statement it follows (§17.1.1, §17.6); no statement
    // begins with it — §34 E-STMT-UNEXPECTED-TOKEN "Unexpected token — no statement begins
    // here". Before s478 the word fell through to an expression statement: E-SCOPE-001
    // "`else` is not declared" plus E-STMT-MISSING-SEMICOLON after `else` (and before it).
    // One report, at the `else`: the E-STMT-MISSING-SEMICOLON the previous statement just
    // drew AT the `else`'s left edge (its fix-it, a `;`, would not make the `else` legal) is
    // replaced by it. What follows the `else` (`if …`, a `{ … }` block, or one statement)
    // is read — so its own syntax errors are reported — and dropped (a Recovered node):
    // with the `else` refused, nothing downstream resolves or types it.
    fn orphanElse(tp: TP) -> RStmt {
        const t: PTok = cur(tp)
        const start: int = t.start
        let ds: Diag[] = tp.diags
        if (ds.length > 0 && tp.i > 0) {
            const prev: Diag = ds[ds.length - 1]
            const before: PTok = tp.toks[tp.i - 1]
            if (prev.code == "E-STMT-MISSING-SEMICOLON" && prev.span.start == before.end) ds = ds.slice(0, ds.length - 1)
        }
        const d: Diag = newDiag("E-STMT-UNEXPECTED-TOKEN", "`else` with no `if` before it — no statement begins with `else`: an `else` continues the `if` statement it follows, `if (c) { … } else { … }` (§17.1.1, §17.6). A `;` after the `if`'s `}` ends the `if`, so an `else` after it has none; remove that `;`, or write the missing `if (…)`", tp.file, mkSpan(t.start, t.end))
        let rt: TP = adv({ toks: tp.toks, i: tp.i, nid: tp.nid, diags: ds.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn })
        if (isWord(rt, "if")) {
            rt = parseIf(rt).tp
        } else if (isP(rt, "{")) {
            rt = parseBlock(rt).tp
        } else if (cur(rt).cls != TC.End && !isP(rt, "}")) {
            rt = parseStmt(rt).tp
            if (isP(rt, ";")) rt = adv(rt)
        }
        const re: RExpr = mkE(rt, start, AExprK.Recovered)
        return mkS(re.tp, start, AStmtK.Eval(re.e))
    }

    // s478-boot-semicolon-residue — a BARE BLOCK statement, `{ … }` where a
    // statement stands. SPEC §7.2.2 "Terms": a statement list is the content of
    // "any `{ … }` block of a statement (`if` / `else` / loop / bare block)" —
    // so a `{` that starts a statement opens a block, never an object literal
    // (before this, the bootstrap read it as one: E-TYPE-STRUCT-CONTEXT and a
    // cascade). s478 (s478-boot-syntax-batch) BUILDS it: §7.2 "All JavaScript that
    // is valid in a Bun execution context is valid inside `${ }`, except the
    // constructs §7.2.1 excludes" — a block statement is not excluded, so it is
    // the JavaScript block: its statements run once, in order, and a name it
    // declares is in scope from its declaration to the block's `}` and NOT after
    // it. It is read as an `if` whose test is the literal `true` (IfForm.Bare):
    // the same scope, the same statements, every pass's `if`-body rules for
    // free (and printed `if (true) { … }`, the same JavaScript scope). One rule is
    // judged here because it holds whatever the bootstrap builds — §19.16.2
    // "Not defer sites in stage 1 — E-DEFER-UNSUPPORTED-SITE": "A bare `{ }`
    // block statement … so a `defer` there has no block to attach to … It
    // SHALL be a compile error, never silently mis-scoped". The block is
    // block-like (§7.2.2 rule 2, "bare block"): its `}` ends it, no `;`; what
    // follows that `}` is the next statement, as after an `if` (§7.2.2: "A pure
    // expression after a block-like `}` … E-STMT-NO-EFFECT, on the next line or
    // (after an `if` / `for` / `given` / `defer` `}`) the same line" — PA ruling
    // S478: on trailing tokens §7.2.2 governs over §40.8).
    // Recovery: a `{` on the line of an Error just reported is the body of a
    // construct that failed to parse (a function head the type reader could
    // not read, `switch (x) {`), not a bare block the author wrote — it is read
    // and dropped (a Recovered node; the error before it is the one root
    // cause).
    fn bareBlock(tp: TP) -> RStmt {
        const t0: PTok = cur(tp)
        const start: int = t0.start
        const n: int = tp.diags.length
        const recovering: boolean = n > 0 && tp.diags[n - 1].severity == Severity.Error && lineAt(tp, tp.diags[n - 1].span.start) == t0.line
        const rb: RBlock = parseBlock(tp)
        let t: TP = rb.tp
        // s478 (review-followups-2): not when recovering — the `{` is then the body of a
        // construct that failed to parse (often a function's), not a bare block, and a
        // `defer` in it is judged by nothing here (the error before it is the one cause).
        // Inside a function declaration's body (TP.inFn) a bare block is §19.16.2's
        // E-DEFER-UNSUPPORTED-SITE; anywhere else the `defer` is outside any function —
        // §19.16.3 rule 4: "It is E-DEFER-OUTSIDE-FUNCTION in every other position: … a
        // `match` / `!{}` arm or bare block at the top level" (§34: "`defer` outside a
        // function-declaration body (top-level logic, … a `when` body, an `on*=${}` handler
        // attribute …)").
        if (!recovering) {
            for (const s of rb.b.stmts) {
                if (isDeferStmt(s)) {
                    let d: Diag = newDiag("E-DEFER-UNSUPPORTED-SITE", "a `defer` in a bare `{ … }` block has no block to belong to in stage 1 (§19.16.2) — move the `defer` to the enclosing function body or a braced `if` / loop body", t.file, s.span)
                    if (tp.inFn == 0) d = newDiag("E-DEFER-OUTSIDE-FUNCTION", "`defer` stands only in the body of a function declaration (`function` / `fn`) — this bare block is not in one, and a handler, an effect or the program has no single block exit to attach the deferred statement to (§19.16.3 rule 4); move the body into a named function and call it", t.file, s.span)
                    // §19.16.3 rule 4: "a `defer` inside a function or arrow DECLARED in a
                    // `when` body or a handler attribute is rejected too — declare the
                    // function outside the body and call it"
                    if (tp.inFn == 2) d = newDiag("E-DEFER-OUTSIDE-FUNCTION", "`defer` stands only in the body of a function declaration (`function` / `fn`) that is not itself inside a `when` / effect / arrow body or a handler attribute — this bare block is in one (§19.16.3 rule 4); declare the function outside that body and call it", t.file, s.span)
                    t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d]), file: t.file, ns: t.ns, inFn: t.inFn }
                }
            }
        }
        if (recovering) {
            const re: RExpr = mkE(t, start, AExprK.Recovered)
            return mkS(re.tp, start, AStmtK.Eval(re.e))
        }
        // the test: the literal `true`, spanning the block's `{`
        const yes: AExpr = { nid: t.nid, span: mkSpan(t0.start, t0.end), k: AExprK.Bool(true) }
        return mkS(bumpId(t), start, AStmtK.If(yes, rb.b, not, IfForm.Bare))
    }

    fn isDeferStmt(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Defer(body: b) :> true
            .Eval(e: e) :> false
            .Local(name: n) :> false
            .Return(e: e) :> false
            .If(cond: c) :> false
            .Given(name: n) :> false
            .EffectStmt(w: w) :> false
            .Fail(f: x) :> false
            .For(f: x) :> false
            .Break(label: x) :> false
            .Continue(label: x) :> false
            .Lift(what: x) :> false
            .LocalFn(f: x) :> false
        }
    }

    // s477 — does a nested function declaration start here (§7.3.1)?
    // `function`, `fn name`, `server function`, `server fn name`.
    fn localFnAhead(tp: TP) -> boolean {
        let k: int = 0
        if (isWord(tp, "server")) k = 1
        const a: PTok = peekAt(tp, k)
        if (a.cls != TC.Ident && a.cls != TC.Keyword) return false
        if (a.v == "function") return true
        return a.v == "fn" && peekAt(tp, k + 1).cls == TC.Ident
    }

    // s469 r3 — after a block-like statement's `}` (token tp.i - 1): does the
    // next token, on the SAME line, read as continuing an expression (a binary
    // or assignment operator, `.` / `?.`, a call `(`, an index `[`, `?`, `!`,
    // a template)?
    fn continuesAfterBlock(tp: TP) -> boolean {
        const x: PTok = cur(tp)
        if (x.cls == TC.End) return false
        if (x.line != tp.toks[tp.i - 1].line) return false
        if (x.cls == TC.TChunk) return true
        if (binPrec(tp) > 0) return true
        if (isP(tp, "=") || isCompoundAssign(tp)) return true
        if (x.cls != TC.Punct) return false
        return tk(x, ".") || tk(x, "?.") || tk(x, "(") || tk(x, "[") || tk(x, "?") || tk(x, "!")
    }

    // =========================================================================
    // s449 — reactive effects (SPEC §6.7.4).
    //
    // The keyword spelling (soft-deprecated, §63 Stage 1 — it parses
    // identically to `<effect>`):
    //   when-stmt ::= 'when' dep-list 'changes' '{' logic-content '}'
    //   dep-list  ::= '@' identifier | '(' '@' identifier (',' '@' identifier)* ')'
    // `when` / `changes` are contextual words: `when` starts one only before
    // `@` or before a parenthesized list followed by `changes` (a function
    // named `when` stays a call). The `reads` clause RETIRES with no window —
    // a syntax error saying so (§6.7.4 "The `reads` clause retires").
    //
    // The markup spelling `<effect deps=[…]>${ … }</>` is parsed at the char
    // level (finishEffect) where markup stands; where a STATEMENT stands (a
    // function body, another effect's body) it is read from the tokens here
    // (parseEffectTokens), so analyze can name the position (E-LIFECYCLE-016
    // inside an effect body).
    // =========================================================================
    type REffect:struct = { w: AEffect, tp: TP }

    fn whenAhead(tp: TP) -> boolean {
        if (!isWord(tp, "when")) return false
        const nx: PTok = peekAt(tp, 1)
        if (nx.cls == TC.At) return true
        if (!tk(nx, "(") || nx.cls == TC.Str) return false
        let k: int = 2
        let depth: int = 1
        while (depth > 0) {
            const t: PTok = peekAt(tp, k)
            if (t.cls == TC.End) return false
            if (t.cls != TC.Str && tk(t, "(")) depth = depth + 1
            if (t.cls != TC.Str && tk(t, ")")) depth = depth - 1
            k = k + 1
        }
        const after: PTok = peekAt(tp, k)
        return (after.cls == TC.Ident || after.cls == TC.Keyword) && after.v == "changes"
    }

    // At `when`.
    fn parseWhen(tp: TP) -> REffect {
        const start: int = cur(tp).start
        const ds: RExprs = parseDepList(adv(tp))
        let t: TP = ds.tp
        if (isWord(t, "changes")) {
            t = adv(t)
        } else {
            t = diagAt(t, "E-PARSE-WHEN", "expected `changes` after the `when` dep-list (§6.7.4: `when @x changes { … }` — or write `<effect deps=[@x]>" + interpOpen() + " … }</>`)", cur(t))
        }
        if (isWord(t, "reads")) {
            const r: PTok = cur(t)
            t = diagAt(t, "E-PARSE-WHEN", "the `reads` clause is retired (§6.7.4): reading a cell the effect does not list needs no annotation — the body reads its current value when it runs; delete `reads …`", r)
            const rs: RExprs = parseDepList(adv(t))
            t = rs.tp
        }
        const body: RBlock = parseBlock(withInFn(t, 2))   // §19.16.3 rule 4: a `when` body is no defer site
        const w: AEffect = { nid: body.tp.nid, span: spanFrom(body.tp, start), deps: ds.es, body: body.b, keyword: true }
        return { w: w, tp: bumpId(withInFn(body.tp, tp.inFn)) }
    }

    // `@x` or `(@a, @b, …)` — at least one entry (the keyword form's empty
    // dep-list was a syntax error; the markup form names it E-EFFECT-NO-DEPS).
    fn parseDepList(tp: TP) -> RExprs {
        if (!isP(tp, "(")) {
            const one: RExpr = parseDepItem(tp)
            return { es: [one.e], tp: one.tp }
        }
        let t: TP = adv(tp)
        if (isP(t, ")")) {
            t = diagAt(t, "E-PARSE-WHEN", "an empty dep-list `()` is a syntax error — an effect names at least one `@cell` (§6.7.4)", cur(t))
            return { es: [], tp: adv(t) }
        }
        let es: AExpr[] = []
        let going = true
        while (going) {
            const r: RExpr = parseDepItem(t)
            es = es.concat([r.e])
            t = r.tp
            if (isP(t, ",")) {
                t = adv(t)
            } else {
                going = false
            }
        }
        t = expectP(t, ")")
        return { es: es, tp: t }
    }

    // One keyword dep-list entry: `@name` and nothing else (the grammar's
    // `'@' identifier`).
    fn parseDepItem(tp: TP) -> RExpr {
        const t: PTok = cur(tp)
        if (t.cls == TC.At) {
            const r: RExpr = parseAt(tp)
            if (isAtName(r.e)) return r
            const bad: TP = diagAt(r.tp, "E-PARSE-WHEN", "a dep-list entry is `@name` (§6.7.4)", t)
            return { e: r.e, tp: bad }
        }
        const d: TP = diagAt(tp, "E-PARSE-WHEN", "a dep-list entry is `@name` (§6.7.4), found `" + t.text + "`", t)
        return mkE(adv(d), t.start, AExprK.Recovered)
    }

    fn isAtName(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> true
            .Name(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: v) :> false
            .Bool(v: v) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: x) :> false
            .ObjectLit(props: x) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: p) :> false
            .BlockLambda(params: p) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> false
        }
    }

    // `<effect` where a statement stands: `<` touching the word `effect`.
    fn effectTagAhead(tp: TP) -> boolean {
        if (!isP(tp, "<")) return false
        const nx: PTok = peekAt(tp, 1)
        return touching(cur(tp), nx) && nx.cls == TC.Ident && nx.v == "effect"
    }

    // At `<effect` in a token run: `deps=[…]`, then `/>` or `>` `${ … }` `</>`
    // (or `</effect>`). Anything else is E-PARSE-EFFECT and recovery skips to
    // the end of the run's statement.
    fn parseEffectTokens(tp: TP) -> REffect {
        const start: int = cur(tp).start
        let t: TP = adv(adv(tp))
        let deps: AExpr[] = []
        if (isWord(t, "deps") && isP(adv(t), "=") && isP(adv(adv(t)), "[")) {
            const rl: RExprs = parseList(adv(adv(adv(t))), "]")
            deps = rl.es
            t = rl.tp
        }
        let body: ABlock = { nid: t.nid, span: spanFrom(t, start), stmts: [] }
        if (isP(t, "/") && isP(adv(t), ">")) {
            t = adv(adv(t))
        } else if (isP(t, ">")) {
            t = adv(t)
            if (tk(cur(t), "$") && isP(adv(t), "{")) {
                const b: RBlock = parseBlock(withInFn(adv(t), 2))   // §19.16.3 rule 4: an effect body is no defer site
                body = b.b
                t = withInFn(b.tp, tp.inFn)
            }
            if (isP(t, "<") && isP(adv(t), "/")) {
                t = adv(adv(t))
                if (isWord(t, "effect")) t = adv(t)
                t = expectP(t, ">")
            } else if (isP(t, "<") && closerAsRegex(peekAt(t, 1))) {
                // after `<` the lexer reads a `/` as a regex opener: `</>` / `</effect>`
                // at the end of a line arrives as one unterminated regex token
                t = adv(adv(t))
            } else {
                t = diagAt(t, "E-PARSE-EFFECT", "expected `" + interpOpen() + " … }</>` after `<effect deps=[…]>` (§6.7.4: an effect body is one `" + interpOpen() + " }` logic block)", cur(t))
            }
        } else {
            t = diagAt(t, "E-PARSE-EFFECT", "expected `deps=[…]` then `>` or `/>` in `<effect …>` (§6.7.4)", cur(t))
        }
        const w: AEffect = { nid: t.nid, span: spanFrom(t, start), deps: deps, body: body, keyword: false }
        return { w: w, tp: bumpId(t) }
    }

    // A closer the logic lexer read as a regex (`/>` or `/effect>`, alone to the end of its line).
    fn closerAsRegex(t: PTok) -> boolean {
        const s: string = t.text.trim()
        return s == "/>" || s == "/effect>"
    }

    // =========================================================================
    // s469 — the `for` statement (SPEC §49 "one `for`"; §49.2.1, §49.2.4).
    //   for-stmt ::= label-prefix? 'for' for-head? loop-body
    //   for-head ::= '(' iterate-head ')' | '(' counted-head ')' | '(' condition ')'
    // The head is told apart by the tokens at the TOP LEVEL of its parentheses
    // (§49.2.4): none → infinite; exactly two `;` → counted; a binder then `of`
    // → iterate; otherwise → condition. One `;`, or more than two, is a syntax
    // error, and so is `for ()`. A `for (… in …)` head is E-CTRL-011; the
    // braceless `for x in xs { … }` / `for x of xs { … }` is
    // E-FOR-UNPARENTHESIZED-HEAD (§49.4.1). `while` and `do … while` are retired
    // (E-LOOP-WHILE-RETIRED / E-LOOP-DO-WHILE-RETIRED). A refused loop is read
    // past (its body parsed, so the body's own syntax errors report) and stands
    // as a Recovered statement: nothing downstream types or runs it.
    // Not in the bootstrap (refused): `for-else` (§17.4a). (s478-boot-destructuring:
    // an object destructuring binder is built — parseDestructIter.)
    // =========================================================================
    type HeadScan:struct = { semis: int, close: int }
    type RStmts:struct = { ss: AStmt[], tp: TP }
    type RSrc:struct = { src: AIterSrc, tp: TP }

    // `name :` then `for` — a loop label (§49.2.2: "written before the `for`
    // keyword (on the same line or the line before)"). Nothing else that
    // starts `name :` is read as a label.
    fn labelAhead(tp: TP) -> boolean {
        const t: PTok = cur(tp)
        if (t.cls != TC.Ident) return false
        const c: PTok = peekAt(tp, 1)
        if (c.cls != TC.Punct || !tk(c, ":")) return false
        const f: PTok = peekAt(tp, 2)
        if (f.cls != TC.Keyword || f.v != "for") return false
        return f.line - t.line <= 1
    }

    fn advN(tp: TP, n: int) -> TP {
        let t: TP = tp
        let i: int = 0
        while (i < n) {
            t = adv(t)
            i = i + 1
        }
        return t
    }

    // At `(`: the number of top-level `;` before its matching `)`, and the
    // offset of that `)` from `tp` (the end of input when it never closes).
    fn scanHead(tp: TP) -> HeadScan {
        let k: int = 1
        let depth: int = 1
        let semis: int = 0
        while (depth > 0) {
            const x: PTok = peekAt(tp, k)
            if (x.cls == TC.End) return { semis: semis, close: k }
            if (x.cls == TC.Punct) {
                if (tk(x, "(") || tk(x, "[") || tk(x, "{")) depth = depth + 1
                if (tk(x, ")") || tk(x, "]") || tk(x, "}")) depth = depth - 1
                if (depth == 1 && tk(x, ";")) semis = semis + 1
            }
            if (depth > 0) k = k + 1
        }
        return { semis: semis, close: k }
    }

    // At `(`: past its matching `)`.
    fn skipParens(tp: TP) -> TP {
        const hs: HeadScan = scanHead(tp)
        return advN(tp, hs.close + 1)
    }

    // At `(`: `[let | const] name w` — the offset of `w` from `tp`, or -1.
    fn binderThen(tp: TP, w: string) -> int {
        let k: int = 1
        const a: PTok = peekAt(tp, 1)
        if (isNameTok(a) && (a.v == "let" || a.v == "const")) k = 2
        const n: PTok = peekAt(tp, k)
        if (n.cls != TC.Ident) return -1
        const o: PTok = peekAt(tp, k + 1)
        if (isNameTok(o) && o.v == w) return k + 1
        return -1
    }

    // At `(`: `[let | const] { … } of` / `[let | const] [ … ] of` — a
    // destructuring binder (§49.2.1 `for-binder`; s478-boot-destructuring:
    // parseDestructIter).
    fn destructAhead(tp: TP) -> boolean {
        let k: int = 1
        const a: PTok = peekAt(tp, 1)
        if (isNameTok(a) && (a.v == "let" || a.v == "const")) k = 2
        const o: PTok = peekAt(tp, k)
        if (o.cls != TC.Punct || (!tk(o, "{") && !tk(o, "["))) return false
        let depth: int = 0
        let going = true
        while (going) {
            const x: PTok = peekAt(tp, k)
            if (x.cls == TC.End) return false
            if (x.cls == TC.Punct && (tk(x, "{") || tk(x, "["))) depth = depth + 1
            if (x.cls == TC.Punct && (tk(x, "}") || tk(x, "]"))) depth = depth - 1
            k = k + 1
            if (depth == 0) going = false
        }
        const w: PTok = peekAt(tp, k)
        return isNameTok(w) && w.v == "of"
    }

    // s478-boot-destructuring — `for ([let | const] { a, b: c } of xs) { … }` (§49.2.1
    // `for-binder ::= ('let' | 'const')? (Identifier | destructuring-pattern)`; §49.3.5
    // "A destructuring binder follows §50's destructuring rules"): the binder is a
    // minted temp holding the element (a keywordless / `const` binder — §50.8.5), and
    // the body opens with the pattern's locals read off it (parseDestructDecl's
    // reading; `let` makes the bound names mutable per iteration). A `key` clause on
    // such a binder is refused by name (INTERIM): it is evaluated where the bound
    // names are not yet declared.
    fn parseDestructIter(tp: TP, label: string, start: int) -> RStmt {
        let t: TP = adv(tp)
        let mutable = false
        if (isWord(t, "let")) {
            mutable = true
            t = adv(t)
        } else if (isWord(t, "const")) {
            t = adv(t)
        }
        const pt: PTok = cur(t)
        const root: string = destructTemp(pt.start)
        const rp: RDPat = parseDPattern(t, root)
        t = rp.tp
        const bind: ABind = { nid: t.nid, span: spanFrom(t, pt.start), name: root }
        t = bumpId(t)
        if (isWord(t, "of")) {
            t = adv(t)
        } else {
            const bo: PTok = cur(t)
            t = diagAt(t, "E-PARSE-EXPECTED", "expected `of` after the destructuring binder, found `" + bo.text + "`", bo)
        }
        const src: RSrc = parseIterSrc(t)
        let ht: TP = src.tp
        if (isWord(ht, "key")) {
            const kk: PTok = cur(ht)
            ht = diagAt(ht, "E-BOOTSTRAP-UNSUPPORTED", "a `key` clause on a destructuring `for` binder is not in the bootstrap yet — bind the element (`for (o of xs) key o.id { … }`) and read its fields in the body", kk)
            const kx: RExpr = parseAssign(adv(ht))
            ht = kx.tp
        }
        const body: RBlock = parseLoopBody(closeHead(ht))
        // a refused pattern: the loop stands as a Recovered statement (its body read,
        // so its own syntax errors report), as a refused head always has (refusedHead)
        if (rp.bad) return recoveredStmt(body.tp, start)
        const pre: RStmts = stepStmts(body.tp, rp.steps, mutable, false)
        const nb: ABlock = { nid: body.b.nid, span: body.b.span, stmts: pre.ss.concat(body.b.stmts) }
        return forStmt(pre.tp, start, label, AForHead.HIter(bind, false, src.src, not), nb)
    }

    fn recoveredStmt(tp: TP, start: int) -> RStmt {
        const re: RExpr = mkE(tp, start, AExprK.Recovered)
        return mkS(re.tp, start, AStmtK.Eval(re.e))
    }

    // A refused head: reported at `at`; the head (from `(` at `tp`) is skipped
    // and the body read, so the statement after the loop parses where it stands.
    fn refusedHead(tp: TP, code: string, msg: string, at: PTok, start: int) -> RStmt {
        const d: TP = diagAt(tp, code, msg, at)
        const body: RBlock = parseLoopBody(skipParens(d))
        return recoveredStmt(body.tp, start)
    }

    // §49.2.1 `loop-body ::= '{' loop-statement* '}'` — a body is a block.
    fn parseLoopBody(tp: TP) -> RBlock {
        if (isP(tp, "{")) return parseBlock(tp)
        const t: PTok = cur(tp)
        const d: TP = diagAt(tp, "E-PARSE-EXPECTED", "a `for` body is a block — expected `{`, found `" + t.text + "` (§49.2.1 `loop-body ::= '{' loop-statement* '}'`)", t)
        return parseBlockOrStmt(d)
    }

    // At `for` (`label` "" — none; `start` — where the statement, label included, starts).
    fn parseFor(tp: TP, label: string, start: int) -> RStmt {
        const kw: PTok = cur(tp)
        const t: TP = adv(tp)
        if (isP(t, "{")) {
            const fb: RBlock = parseBlock(t)
            return forStmt(fb.tp, start, label, AForHead.HForever, fb.b)
        }
        if (!isP(t, "(")) return bracelessFor(t, kw, start)
        const hs: HeadScan = scanHead(t)
        if (hs.close == 1) return refusedHead(t, "E-PARSE-FOR-HEAD", "`for ()` has no head — write `for { … }` for a loop that runs until a `break` (§49.2.4)", kw, start)
        if (hs.semis == 2) return parseCounted(t, label, start)
        if (hs.semis != 0) return refusedHead(t, "E-PARSE-FOR-HEAD", "a `for` head has no `;` (a condition, or `x of xs`) or exactly two (`init; cond; step`) — this one has " + hs.semis + " (§49.2.4)", kw, start)
        if (binderThen(t, "in") >= 0) return refusedHead(t, "E-CTRL-011", "`for (… in …)` is not a scrml loop — scrml iterates values with `of`: `for (x of xs) { … }` (§17.4, §49.2.4)", kw, start)
        if (destructAhead(t)) return parseDestructIter(t, label, start)   // s478-boot-destructuring
        if (binderThen(t, "of") >= 0) return parseIterHead(t, label, start)
        // the condition head (§49.3.1); s474: its kept assignments (§50, D10)
        // s479 r1 (LOW-4): §49.3.1 "This is the loop the retired `while (cond)` spelled",
        // so its unreadable `?{ … }` is §34 E-SQL-QUERY-NOT-READABLE as an `if`'s is
        const tc: TP = adv(t)
        const cond0: RExpr = sqlInCondition(tc.diags.length, parseAssign(tc))
        const cond: RExpr = { e: keptHead(cond0.e), tp: cond0.tp }
        let t2: TP = cond.tp
        if (!isP(t2, ")")) {
            const bad: PTok = cur(t2)
            t2 = diagAt(t2, "E-PARSE-EXPECTED", "expected `)` to end the `for` condition, found `" + bad.text + "`", bad)
            t2 = toHeadClose(t2)       // forward from t2: its diagnostics and node ids are kept
        }
        // past the `)` only when there is one (toHeadClose stops at a depth-0 `{`
        // too, so a missing `)` never eats the body or the enclosing block's `}`)
        if (isP(t2, ")")) t2 = adv(t2)
        if (condContinues(t2)) {
            const cc: PTok = cur(t2)
            const dc: TP = diagAt(t2, "E-CONDITION-HEAD-UNPARENTHESIZED", "the `for` condition continues past its closing `)` — the parentheses wrap the WHOLE condition: write `for (… " + cc.text + " …) { … }` (§49.2.3)", cc)
            // reported once; the continuation is SKIPPED (never read as part of
            // the condition, §49.2.3 "rejection only") and the body read past
            const rb: RBlock = parseLoopBody(toBodyOpen(dc))
            return recoveredStmt(rb.tp, start)
        }
        const body: RBlock = parseLoopBody(t2)
        return forStmt(body.tp, start, label, AForHead.HCond(cond.e), body.b)
    }

    // §49.2.3 (E-CONDITION-HEAD-UNPARENTHESIZED): after the head's `)`, an
    // operator that continues the condition. Wider than the §34 row's set for
    // `if` / `while`: a `for` body is always braced (§49.2.1), so `+ - / ( . [`
    // cannot begin a braceless body here.
    fn condContinues(tp: TP) -> boolean {
        const t: PTok = cur(tp)
        if (t.cls != TC.Punct) return false
        return ["<", "<=", ">", ">=", "==", "!=", "===", "!==", "&&", "||", "??", "*", "%", "?", "+", "-", "/", "(", ".", "["].indexOf(t.text) >= 0
    }

    // A built `for` (§49.2.1). `for-else` (§17.4a) after an iterate head is
    // refused — not in the bootstrap.
    fn forStmt(tp: TP, start: int, label: string, head: AForHead, body: ABlock) -> RStmt {
        if (isIterHead(head) && isWord(tp, "else") && tk(peekAt(tp, 1), "{")) {
            const d: TP = diagAt(tp, "E-BOOTSTRAP-UNSUPPORTED", "`for … else { … }` (the empty-state block, §17.4a) is not in the bootstrap yet — test `xs.length == 0` before the loop", cur(tp))
            const eb: RBlock = parseBlock(adv(d))
            return recoveredStmt(eb.tp, start)
        }
        const f: AFor = { nid: tp.nid, span: spanFrom(tp, start), label: label, head: head, body: body, bound: not }
        return mkS(bumpId(tp), start, AStmtK.For(f))
    }

    fn forOfStmt(s: AStmt) -> AFor | not {
        const k: AStmtK = s.k
        return match k {
            .For(f: lf) :> lf
            .Eval(e: x) :> not
            .Local(name: n) :> not
            .Return(e: x) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: b) :> not
            .Fail(f: x) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: x) :> not
            .LocalFn(f: x) :> not
        }
    }

    // s469 — `const xs = for (…) { … };` (§49.2.1 `for-binding ::= ('const' |
    // 'let') Identifier (':' type)? '=' for-stmt ';'`, the value form §49.6):
    // at the `for` (or its label). The loop is a For statement carrying its
    // binder (`bound`); a loop whose head was refused (parseFor reported it)
    // leaves the name bound to a placeholder, so its uses are not a second error.
    fn parseForBinding(tp: TP, start: int, nameTok: PTok, mutable: boolean, aty: AType | not) -> RStmt {
        const ft: PTok = cur(tp)
        const labelled: boolean = !isWord(tp, "for")
        const rf: RStmt = labelled ? parseFor(adv(adv(tp)), ft.v, ft.start) : parseFor(tp, "", ft.start)
        const b: AForBound = { nid: rf.tp.nid, span: mkSpan(nameTok.start, nameTok.end), name: nameTok.v, mutable: mutable, ty: aty }
        const t: TP = bumpId(rf.tp)
        const f: AFor | not = forOfStmt(rf.s)
        if (f is not) {
            const re: RExpr = mkE(t, ft.start, AExprK.Recovered)
            return mkS(re.tp, start, AStmtK.Local(nameTok.v, mutable, aty, re.e, false))
        }
        const nf: AFor = { nid: f.nid, span: f.span, label: f.label, head: f.head, body: f.body, bound: b }
        return mkS(t, start, AStmtK.For(nf))
    }

    // =========================================================================
    // s469 — `lift` (§49.6.2): `lift <expr>;`, which appends to the nearest
    // enclosing bound loop (§49.6 rule 7 — analyze decides which, and refuses
    // a `lift` that has none). In a Tier-0 `${ for … }` in markup the operand
    // may be a markup element — the lexer paused before it and the parser read
    // it as markup (parseTier0); here it is a row placeholder token, and the
    // statement holds a stand-in node that parseTier0 replaces (fillRows).
    // Markup anywhere else is not a value in the bootstrap: refused by name.
    // A `lift` an arm block ends with is the arm's value (parseArmBlock, §18.5).
    // =========================================================================
    fn rowMark() -> string { return "lift-row" }

    fn isRowTok(t: PTok) -> boolean { return t.cls == TC.Other && t.v == rowMark() }

    fn parseLift(tp: TP) -> RStmt {
        const kw: PTok = cur(tp)
        const nx: PTok = peekAt(tp, 1)
        let t: TP = tp
        // `lift⏎expr`, like `return⏎expr`: refused fail closed until the
        // newline-terminated corpus is migrated (parseArmBlock's rule)
        if (nx.line != kw.line && !tk(nx, "}") && !tk(nx, ";") && !splitLiftReported(t, kw)) {
            const ld: Diag = newDiag("E-STMT-MISSING-SEMICOLON", "Expected `;` to end the statement — a `lift` followed by a line break is refused for now: put the lifted value on the `lift` line. dpa-073 F1 would read `lift⏎expr;` as lifting `expr`; the bootstrap does not guess while newline-terminated code is still being migrated.", t.file, mkSpan(kw.end, kw.end))
            t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([ld]), file: t.file, ns: t.ns, inFn: t.inFn }
        }
        if (isRowTok(nx)) {
            const stand: ANode = { nid: -1, span: mkSpan(nx.start, nx.end), k: ANodeK.Text("") }
            return mkS(adv(adv(t)), kw.start, AStmtK.Lift(ALift.LiftNode(stand)))
        }
        // s478 — `lift <markup>` in a body-top logic block (logicBlockTP). s478
        // (markup-in-logic): an ELEMENT operand stands as the lift's node, so
        // analyze judges where the `lift` is (resolveLift: E-SYNTAX-002 in a bare
        // `function` body, §10.4; refused by name where no Tier-0 loop takes it)
        if (isLocusRow(nx)) return misplacedRowStmt(adv(t), kw.start)
        // S478 open-Qs ruling item 1 (b): the stand-in of an element lifted in a
        // body-top `${ … }` carries bodyTopRowTag() as its text, so analyze
        // (resolveLift) can judge a `lift` with no loop to take it there as
        // E-MARKUP-STATEMENT-NOT-RENDERED (§17.3 amended S478)
        if (nx.cls == TC.Other && nx.v == logicRowMark(false)) {
            const stand: ANode = { nid: -1, span: mkSpan(nx.start, nx.end), k: ANodeK.Text(nx.bad) }
            return mkS(adv(adv(t)), kw.start, AStmtK.Lift(ALift.LiftNode(stand)))
        }
        if (isLogicRowTok(nx)) return logicRowStmt(adv(t), kw.start, "lifting MARKUP is in the bootstrap only in a Tier-0 `" + interpOpen() + " for (…) { … lift <li>…</li>; … } }` in markup (§17.4) — a `lift` of markup in a `" + interpOpen() + " … }` logic block (§10, §17.4) is not")
        if (tk(nx, "<") && nx.cls == TC.Punct) {
            const tn: PTok = peekAt(tp, 2)
            if ((tn.cls == TC.Ident || tn.cls == TC.Keyword) && tn.start == nx.end) {
                const dm: TP = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "lifting MARKUP is in the bootstrap only in a Tier-0 `" + interpOpen() + " for (…) { … lift <li>…</li>; … } }` in markup (§17.4) — here the nearest bound loop builds a tape of values; markup is not a value in the bootstrap's logic", nx)
                const sk: TP = skipLiftOperand(adv(dm))
                const rr: RExpr = mkE(sk, kw.start, AExprK.Recovered)
                return mkS(rr.tp, kw.start, AStmtK.Lift(ALift.LiftExpr(rr.e)))
            }
        }
        const v: RExpr = parseAssign(adv(t))
        return mkS(v.tp, kw.start, AStmtK.Lift(ALift.LiftExpr(v.e)))
    }

    // (an arm block's speculative read of its last `lift` reports the split first)
    fn splitLiftReported(tp: TP, kw: PTok) -> boolean {
        for (const d of tp.diags) {
            if (d.code == "E-STMT-MISSING-SEMICOLON" && d.span.start == kw.end) return true
        }
        return false
    }

    // Past a refused `lift` operand: up to its `;`, or the `}` that closes the
    // block it stands in (neither consumed), at bracket depth 0.
    fn skipLiftOperand(tp: TP) -> TP {
        let t: TP = tp
        let depth: int = 0
        let going = true
        while (going && !atEnd(t)) {
            const x: PTok = cur(t)
            if (depth == 0 && (tk(x, ";") || tk(x, "}"))) {
                going = false
            } else {
                if (tk(x, "{") || tk(x, "(") || tk(x, "[")) depth = depth + 1
                if (tk(x, "}") || tk(x, ")") || tk(x, "]")) depth = depth - 1
                t = adv(t)
            }
        }
        return t
    }

    // =========================================================================
    // s469 — the Tier-0 `${ for … }` in markup (§17.4; §49.4.4: "A `for` that
    // is the sole content of a markup `${ }` interpolation is the same value
    // form, rendered"). The region is lexed by lexTier0, which pauses before
    // each `lift <element>`; the element is read here as markup (text is not
    // tokens) and the run resumes after it. Each element becomes a row
    // placeholder token for parseLift; after the loop is parsed, fillRows puts
    // each element into its `lift` (matched by offset). Anything but the one
    // loop in the region is refused.
    // =========================================================================
    fn tier0Ahead(mp: MP) -> boolean {
        const tp: TP = regionTP(mAdv(mp, 1), LexStop.Balanced)
        if (!isP(tp, "{")) return false
        const t: TP = adv(tp)
        if (isWord(t, "for")) return true
        return labelAhead(t)
    }

    // =========================================================================
    // s478 (S478 triage C3) — a `${ … }` logic block at a body top, lexed with
    // the run PAUSED before each markup element in it: a `lift` operand
    // (lexTier0) and an element that starts a statement (lexTier0X `bare` — bare
    // markup, an implied-`lift` arm). SPEC §4.17 (S462): "A `<script>` /
    // `<style>` element SHALL be rejected with the same codes … at EVERY
    // position markup is parsed or built: … markup in a logic block — `lift
    // <markup>`, `for … lift`, `if … lift` and implied-`lift` arms, bare markup in
    // `${ … }` …. The decision is made on the parsed element (its node), never on
    // source text". So each element is read here as markup (parseMarkupNode —
    // E-SCRIPT-001 / E-STYLE-001 with the skip-the-body recovery) and stands in
    // the token run as a logic-row token. A refused element (its node is the
    // refusal's empty Text) is done; any other is refused by name where it
    // stands (parseLift / parseStmt): lifting or placing markup outside a Tier-0
    // `${ for … }` in markup is not in the bootstrap.
    // =========================================================================
    type RLogicRegion:struct = { tp: TP, mp: MP }

    fn logicRowMark(refused: boolean) -> string {
        if (refused) return "logic-row-refused"
        return "logic-row"
    }

    fn isLogicRowTok(t: PTok) -> boolean {
        return t.cls == TC.Other && (t.v == logicRowMark(true) || t.v == logicRowMark(false) || t.v == logicRowOther() || isLocusRow(t))
    }

    fn refusedRowNode(n: ANode) -> boolean {
        const k: ANodeK = n.k
        return match k {
            .Text(text: s) :> s == ""
            .Elem(e: x) :> false
            .Interp(e: x) :> false
            .DeclNode(d: x) :> false
            .Css(c: x) :> false
            .Effect(w: x) :> false
            .Request(r: x) :> false
            .Gather(f: x) :> false
            .Run(b: x) :> false
        }
    }

    fn refusalSince(ds: Diag[], from: int) -> boolean {
        let i: int = from
        while (i < ds.length) {
            if (ds[i].code == "E-SCRIPT-001" || ds[i].code == "E-STYLE-001") return true
            i = i + 1
        }
        return false
    }

    // S478 (open-Qs ruling item 1) — `bodyTop`: the block stands at a `<program>` /
    // `<page>` body top (parseMarkupItem), not in markup (parseNestedLogic). Its
    // element rows carry bodyTopRowTag() in `bad` so the statement reader can
    // tell a body-top block — which renders nothing (§17.3) — from a markup one.
    fn bodyTopRowTag() -> string { return "body-top-row" }

    fn logicBlockTP(mp: MP, bodyTop: boolean) -> RLogicRegion {
        let pos: int = mp.pos + 1
        let depth: int = 0
        let toks: PTok[] = []
        let m: MP = mp
        let going = true
        while (going) {
            const p: LexPause = lexTier0X(mp.src, pos, depth, true)
            const pt: PTok[] = nsToks(mp.ns, toPToks(p.tokens))
            toks = toks.concat(pt.slice(0, pt.length - 1))
            if (!p.paused) {
                toks = toks.concat([pt[pt.length - 1]])
                going = false
            } else {
                const d0: int = m.diags.length
                const rn: RNodeOne = parseMarkupNode(mAt(m, p.end))
                m = rn.mp
                let text: string = mp.src.substring(p.end, m.pos)
                if (text.length > 24 || text.indexOf("\n") >= 0) text = "<…>"
                // refused: the element itself, or one inside it (`<svg><script>…`) — rejected by §4.17
                const refused: boolean = refusedRowNode(rn.n) || refusalSince(m.diags, d0)
                let mark: string = logicRowMark(refused)
                if (!refused && !rowIsElem(rn.n)) mark = logicRowOther()
                // #1919 review F2: an element that is not markup (a §52 state
                // type, a `<x> = …` declaration, a §55 compound, a `renders`
                // clause, a component) — refused by name, as before
                const lifted: boolean = toks.length > 0 && isLiftWord(toks[toks.length - 1])
                if (!refused && !lifted && rowIsElem(rn.n) && !rowIsMarkup(rn.n, mp.src, m.pos, toks)) mark = logicRowOther()
                if (!refused && locusMarkOf(rn.n) != "") mark = locusMarkOf(rn.n)
                let rowTag: string = ""
                if (bodyTop) rowTag = bodyTopRowTag()
                const rt: PTok = { cls: TC.Other, v: mark, text: text, start: p.end, end: m.pos, line: p.line, bad: rowTag }
                toks = toks.concat([rt])
                pos = m.pos
                depth = p.depth
            }
        }
        const t: TP = { toks: toks, i: 0, nid: m.nid, diags: m.diags, file: m.file, ns: m.ns, inFn: 0 }
        return { tp: t, mp: m }
    }

    // s478 (markup-in-logic) — a row whose node is not a markup ELEMENT (a §66
    // declaration `<x=…/>`, an `<effect>` / `<request>`, …): not markup, so
    // §17.6.10.1 does not judge it — refused by name as before.
    fn logicRowOther() -> string { return "logic-row-other" }

    // s478 (markup-in-logic) — a scrml-defined structural element bound to an
    // owning locus, standing in a logic block. SPEC §4.15: "These element names
    // are ONLY recognised in their owning loci; e.g., `<onTransition>` is
    // grammatical only as a child of `<engine>`; `<onTimeout>` is grammatical
    // only as a child of an engine state-child; `<onIdle>` is grammatical only
    // at engine root …; `<page>` is grammatical only as a child of `<program>`
    // … Use outside the owning locus is `E-STRUCTURAL-ELEMENT-MISPLACED`" (also
    // `<onchange>`, §33.x, and `<theme>` / `<defaults>`, §65). A logic block is
    // none of those loci — the specific code, not §17.6.10.1's.
    fn locusRowPrefix() -> string { return "logic-row-locus:" }

    fn isLocusRow(t: PTok) -> boolean {
        return t.cls == TC.Other && t.v.startsWith(locusRowPrefix())
    }

    fn locusTag(tag: string) -> boolean {
        // s478-ruled-endpoint — `endpoint`: §61.2 "a direct child of the top-level `<program>`"
        return tag == "onTransition" || tag == "onTimeout" || tag == "onIdle" || tag == "page" || tag == "onchange" || tag == "theme" || tag == "defaults" || tag == "endpoint"
    }

    // The row mark for an element node: its locus mark when its tag is locus-bound, else "".
    fn locusMarkOf(n: ANode) -> string {
        const k: ANodeK = n.k
        const tag: string = match k {
            .Elem(e: x) :> x.tag
            .Text(text: s) :> ""
            .Interp(e: x) :> ""
            .DeclNode(d: x) :> ""
            .Css(c: x) :> ""
            .Effect(w: x) :> ""
            .Request(r: x) :> ""
            .Gather(f: x) :> ""
            .Run(b: x) :> ""
        }
        if (locusTag(tag)) return locusRowPrefix() + tag
        return ""
    }

    fn misplacedRowStmt(tp: TP, start: int) -> RStmt {
        const row: PTok = cur(tp)
        const tag: string = row.v.substring(locusRowPrefix().length)
        const t: TP = diagAt(tp, "E-STRUCTURAL-ELEMENT-MISPLACED", "`<" + tag + ">` in a `" + interpOpen() + " … }` logic block — `<" + tag + ">` is a scrml-defined structural element, grammatical only in its owning locus (§4.15); move it there", row)
        const re: RExpr = mkE(adv(t), start, AExprK.Recovered)
        return mkS(re.tp, start, AStmtK.Eval(re.e))
    }

    // s478 (#1919 review F2) — is the element row MARKUP, which §17.6.10.1
    // judges ("A markup element in statement position …")? An element of the
    // §24.1 registry (elements.scrml isKnownElementName: HTML, SVG, MathML, a
    // custom element), written lower-case first, that is neither followed by
    // `=` (a `<x> = …` cell / legacy `<query default=…> = "v"` declaration)
    // nor the operand of a §19.2 `renders` clause. Not markup, so refused by
    // name as before (INTERIM — the by-name refusal is what BASE gave): a
    // capitalised §52 state-type declaration (`<Account authority=…> id: number
    // …</>`), a §55 compound declaration's parent (`<signup> … </>`), and a
    // component (its name is known only to analysis).
    fn rowIsMarkup(n: ANode, src: string, end: int, before: PTok[]) -> boolean {
        const k: ANodeK = n.k
        const tag: string = match k {
            .Elem(e: x) :> x.tag
            .Text(text: s) :> ""
            .Interp(e: x) :> ""
            .DeclNode(d: x) :> ""
            .Css(c: x) :> ""
            .Effect(w: x) :> ""
            .Request(r: x) :> ""
            .Gather(f: x) :> ""
            .Run(b: x) :> ""
        }
        if (tag == "") return false
        if (declShaped(n)) return false
        const c0: string = tag.substring(0, 1)
        if (c0 != c0.toLowerCase()) return false
        if (!isKnownElementName(tag)) return false
        if (before.length > 0) {
            const pv: PTok = before[before.length - 1]
            if ((pv.cls == TC.Ident || pv.cls == TC.Keyword) && pv.v == "renders") return false
        }
        let i: int = end
        while (i < src.length && (src.substring(i, i + 1) == " " || src.substring(i, i + 1) == "\t" || src.substring(i, i + 1) == "\n" || src.substring(i, i + 1) == "\r")) { i = i + 1 }
        if (src.substring(i, i + 1) == "=" && src.substring(i + 1, i + 2) != "=") return false
        return true
    }

    // A declaration read as an element: a text child that starts with `=` —
    // an unclosed `<label min(3)> = "hi"` (its `= …` read as the element's
    // text), or a §55 compound `<form> <name default=…> = "v" … </>` (a
    // child's `= …`). Markup text does not start with `=`.
    fn declShaped(n: ANode) -> boolean {
        const k: ANodeK = n.k
        const kids: ANode[] = match k {
            .Elem(e: x) :> x.kids
            .Text(text: s) :> []
            .Interp(e: x) :> []
            .DeclNode(d: x) :> []
            .Css(c: x) :> []
            .Effect(w: x) :> []
            .Request(r: x) :> []
            .Gather(f: x) :> []
            .Run(b: x) :> []
        }
        for (const c of kids) {
            const ck: ANodeK = c.k
            const txt: string = match ck {
                .Text(text: s) :> s
                .Elem(e: x) :> ""
                .Interp(e: x) :> ""
                .DeclNode(d: x) :> ""
                .Css(c: x) :> ""
                .Effect(w: x) :> ""
                .Request(r: x) :> ""
                .Gather(f: x) :> ""
                .Run(b: x) :> ""
            }
            const tt: string = txt.trim()
            if (tt.startsWith("=") && !tt.startsWith("==")) return true
            if (declShaped(c)) return true
        }
        return false
    }

    fn notMarkupWhy() -> string {
        return "this element standing as a statement in a `" + interpOpen() + " … }` logic block is not one the bootstrap reads there (a declaration written as markup — a §52 state type, a `<x> = …` cell, a §55 compound — or a component; §10, §17.6.10.1) — write it where it is read: a declaration at a body top, markup in the body"
    }

    fn rowIsElem(n: ANode) -> boolean {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: x) :> true
            .Text(text: s) :> false
            .Interp(e: x) :> false
            .DeclNode(d: x) :> false
            .Css(c: x) :> false
            .Effect(w: x) :> false
            .Request(r: x) :> false
            .Gather(f: x) :> false
            .Run(b: x) :> false
        }
    }

    // The logic-row token at the cursor as the statement it stands for: nothing
    // to run (a Recovered placeholder — no `;` owed, no E-STMT-NO-EFFECT); a
    // refused element is already reported, any other is refused by name here.
    fn logicRowStmt(tp: TP, start: int, why: string) -> RStmt {
        const row: PTok = cur(tp)
        let t: TP = tp
        if (row.v == logicRowMark(false) || row.v == logicRowOther() || row.v == bareRowOtherMark()) t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", why, row)
        const re: RExpr = mkE(adv(t), start, AExprK.Recovered)
        return mkS(re.tp, start, AStmtK.Eval(re.e))
    }

    // s478 (markup-in-logic) — a markup ELEMENT standing as a statement in a
    // logic block read by logicBlockTP (a body-top `${ … }`, a declaration
    // block in markup) or in a Tier-0 region (a bare row). SPEC §17.6.10.1: "A
    // markup element in statement position in a logic body that no `lift`
    // names and that is not the single-element branch of a value-form (this
    // section) SHALL be a compile error, E-MARKUP-STATEMENT-NOT-RENDERED"; the
    // shapes it reaches "include: `${ <p>hello</p> }`; two elements in one
    // branch; an element after a statement in a branch or block …; a `for` /
    // `while` body without `lift`; … and markup in statement position in a
    // `function` body". A body-top `${ … }` is "a statement list, evaluated, not
    // rendered" (§17.3, S449), so it holds no value-form: an element that is the
    // ONLY statement of a nested block there (`${ if (c) { <p/> } }`) is
    // E-MARKUP-STATEMENT-NOT-RENDERED too — S478 open-Qs ruling item 1 (b), §17.3
    // amended S478: "a single-element `if` / `given` branch or a `lift` there
    // renders nothing, and is E-MARKUP-STATEMENT-NOT-RENDERED". The same shape in
    // a `${ … }` logic block inside MARKUP (parseNestedLogic) stays refused by
    // name: a markup parent makes it a render position (§10.1), not built there.
    fn logicBareStmt(tp: TP, start: int, why: string) -> RStmt {
        const row: PTok = cur(tp)
        if (isLocusRow(row)) return misplacedRowStmt(tp, start)
        if (row.v != logicRowMark(false)) return logicRowStmt(tp, start, why)
        if (tp.inFn == 0 && row.bad != bodyTopRowTag() && soleInNestedBlock(tp)) return logicRowStmt(tp, start, why)
        return unrenderedRowStmt(tp, start, true)
    }

    // The row at the cursor is the one statement of a `{ … }` that is not the
    // region's own opening brace (token 0).
    fn soleInNestedBlock(tp: TP) -> boolean {
        if (tp.i < 2) return false
        if (!tk(tp.toks[tp.i - 1], "{")) return false
        const nx: TP = adv(tp)
        if (isP(nx, "}")) return true
        return isP(nx, ";") && isP(adv(nx), "}")
    }

    // E-MARKUP-STATEMENT-NOT-RENDERED at the element; the statement is a
    // Recovered placeholder (no `;` owed). §17.6.10.1: "Its message SHALL say
    // the markup is not rendered and SHALL name the fix that works where it
    // stands: `lift <tag>…</tag>` (or making it the branch's single element) in
    // a `${ }` or `fn` body; `return` it and render the call in markup
    // (`${f()}`) in a `function` declaration body, where `lift` is not valid
    // (§10.4); … in an event handler …, a `when` body … change state there and
    // render the markup from that state in markup."
    fn unrenderedRowStmt(tp: TP, start: int, bodyTop: boolean) -> RStmt {
        const row: PTok = cur(tp)
        const t: TP = diagAt(tp, "E-MARKUP-STATEMENT-NOT-RENDERED", unrenderedMsg(tp.inFn, bodyTop), row)
        const re: RExpr = mkE(adv(t), start, AExprK.Recovered)
        return mkS(re.tp, start, AStmtK.Eval(re.e))
    }

    fn unrenderedMsg(inFn: int, bodyTop: boolean) -> string {
        const head: string = "this markup stands as a statement and no `lift` names it, so it is not rendered (§17.6.10.1) — "
        if (inFn == 1) return head + "`lift` is not valid in a `function` body (§10.4): `return` the markup and render the call in markup (`" + interpOpen() + "f()}`)"
        if (inFn == 2) return head + "this body runs for its effects and renders nothing: change state here, and render the markup from that state in markup"
        if (bodyTop) return head + "a body-top `" + interpOpen() + " … }` is evaluated, not rendered (§17.3): write the element in the body itself (under `if=`, §17.1, when it is conditional)"
        return head + "write `lift <tag>…</tag>;` to render it, or make it the single element of a branch of a value-form `" + interpOpen() + " if … }` (§17.6.10)"
    }

    fn parseInterpOrTier0(mp: MP) -> RNodeOne {
        if (tier0Ahead(mp)) return parseTier0(mp)
        if (tier0IfAhead(mp)) return parseTier0If(mp)
        if (tier0BareAhead(mp)) return parseTier0Bare(mp)
        return parseInterp(mp)
    }

    // =========================================================================
    // s478 (S478 triage C10) — a `${ … }` LOGIC BLOCK inside markup: one that
    // starts with a declaration (`function`, `fn`, `server function`, `type`,
    // `const`, `let`, `import`, `export`) — a statement list, not one
    // interpolated expression. SPEC §7.1: "Logic contexts are
    // valid inside markup contexts"; §7.6 (S439 #12): "A declaration in a
    // `${…lift…}` block nested inside an `if=` element is a file-scope
    // declaration: it runs ONCE, at file init — not once per mount of the `if=`
    // scope." So its `function` / `fn` / `type` / `const` items are HOISTED to
    // the enclosing item list (MP.hoist, as a `<db>` body's are), and the block
    // renders nothing where it stands. What else it holds is refused by name
    // (INTERIM, g-boot-nested-logic-statements-s478): its statements, which §7.6
    // S439 #12 runs once per mount of the scope ("The block's `lift` statements
    // run per mount") and §17.3 (S449) makes a render position that "may not
    // write reactive state"; and an `import` / `export` there (§21 places them
    // at a file's or a program's top level).
    // =========================================================================
    fn nestedLogicAhead(mp: MP) -> boolean {
        const tp: TP = regionTP(mAdv(mp, 1), LexStop.Balanced)
        if (!isP(tp, "{")) return false
        // (a block of statements only — `${ f(); }` — is left to the element whose body it
        // is: a lifecycle element (`<timer>`, `<poll>`) names its own refusal; and a keyword
        // `when … changes { … }` there is parseInterp's effect, s449)
        const t: TP = adv(tp)
        // s478 r1 (LOW-7): `type` opens a declaration only in a type-declaration shape —
        // `type Name =` / `type Name:kind` / `type Name<…>`; `${ type }` / `${ type + 1 }`
        // read a binding named `type` (an `<each … as="type">` row binder) as before
        if (isWord(t, "type")) return typeDeclShapeAhead(adv(t))
        return logicItemAhead(t) && !whenAhead(t)
    }

    fn typeDeclShapeAhead(t: TP) -> boolean {
        if (!isNameTok(cur(t))) return false
        const n: TP = adv(t)
        return isP(n, "=") || isP(n, ":") || isP(n, "<")
    }

    fn parseNestedLogic(mp: MP) -> RNodeOne {
        const start: int = mp.pos
        const lr: RLogicRegion = logicBlockTP(mp, false)
        const inner: RItems = parseLogicItems(expectP(lr.tp, "{"), "}", false)
        let t: TP = expectRegionEnd(expectP(inner.tp, "}"))
        let hoisted: AItem[] = []
        for (const it of inner.items) {
            const why: string = nestedItemRefusal(it)
            if (why == "") {
                hoisted = hoisted.concat([it])
            } else {
                const d: Diag = newDiag("E-BOOTSTRAP-UNSUPPORTED", why, t.file, it.span)
                t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d]), file: t.file, ns: t.ns, inFn: t.inFn }
            }
        }
        const back: MP = backToMarkup(lr.mp, t)
        const m: MP = { src: back.src, pos: back.pos, nid: back.nid, diags: back.diags, file: back.file, hoist: back.hoist.concat(hoisted), dbFns: back.dbFns, hosts: back.hosts, pages: back.pages, eps: back.eps, chans: back.chans, onchs: back.onchs, schemaN: back.schemaN, tables: back.tables, ns: back.ns }
        const n: ANode = { nid: m.nid, span: mkSpan(start, m.pos), k: ANodeK.Text("") }
        return { n: n, mp: mBump(m) }
    }

    fn nestedExport(exported: boolean) -> string {
        if (exported) return "an `export` in a `" + interpOpen() + " … }` inside markup is not in the bootstrap — export at the file's top level or the `<program>` body top (§21.2)"
        return ""
    }

    // "" — the item is hoisted (a file-scope declaration, §7.6 S439 #12); else why it is refused.
    fn nestedItemRefusal(it: AItem) -> string {
        const k: AItemK = it.k
        return match k {
            .FnItem(f: x) :> nestedExport(x.exported)
            .TypeItem(t: x) :> nestedExport(x.exported)
            .ConstItem(c: x) :> nestedExport(x.exported)
            .ImportItem(i: x) :> "an `import` in a `" + interpOpen() + " … }` inside markup is not in the bootstrap — write it at the file's top level or the `<program>` body top (§21.3)"
            .DeclItem(d: x) :> "a declaration in a `" + interpOpen() + " … }` inside markup is not in the bootstrap — declare it in the `<program>` body (§66)"
            .ProgramItem(p: x) :> "a `<program>` here is not in the bootstrap"
            .MarkupItem(n: x) :> "statements in a `" + interpOpen() + " … }` logic block inside markup are not in the bootstrap — they run once per mount of the element's scope (§7.6) in a render position, which may not write a cell (§17.3); move them to the `<program>` body top, or into a function"
        }
    }

    fn rowTok(src: string, start: int, end: int, line: int) -> PTok {
        let text: string = src.substring(start, end)
        if (text.length > 24 || text.indexOf("\n") >= 0) text = "<…>"
        return { cls: TC.Other, v: rowMark(), text: text, start: start, end: end, line: line, bad: "" }
    }

    // s478 (markup-in-logic) — a Tier-0 region's tokens: the run pauses before a
    // `lift` operand element (a row) AND before an element that starts a
    // statement (lexTier0X `bare`), each read as markup. A bare ELEMENT stands as
    // a bare-row token (a value-form branch takes it, parseTier0Branch; anywhere
    // else parseStmt reports it, §17.6.10.1); a bare element §4.17 refused, or a
    // bare node that is not an element, as a logic-row token (logicRowStmt).
    type RT0Region:struct = { tp: TP, rows: ANode[], mp: MP, bad: boolean }

    fn bareRowMark() -> string { return "bare-row" }

    // s478 (#1919 review F2) — a bare element that is not markup (rowIsMarkup).
    fn bareRowOtherMark() -> string { return "bare-row-other" }

    fn isBareRowTok(t: PTok) -> boolean { return t.cls == TC.Other && (t.v == bareRowMark() || t.v == bareRowOtherMark()) }

    fn isBareRowOther(t: PTok) -> boolean { return t.cls == TC.Other && t.v == bareRowOtherMark() }

    fn isLiftWord(t: PTok) -> boolean {
        return (t.cls == TC.Keyword || t.cls == TC.Ident) && t.v == "lift"
    }

    fn tier0Region(mp: MP) -> RT0Region {
        let pos: int = mp.pos + 1
        let depth: int = 0
        let toks: PTok[] = []
        let rows: ANode[] = []
        let m: MP = mp
        let bad = false
        let going = true
        while (going) {
            const p: LexPause = lexTier0X(mp.src, pos, depth, true)
            const pt: PTok[] = nsToks(mp.ns, toPToks(p.tokens))
            toks = toks.concat(pt.slice(0, pt.length - 1))
            if (!p.paused) {
                toks = toks.concat([pt[pt.length - 1]])
                going = false
            } else {
                const lifted: boolean = toks.length > 0 && isLiftWord(toks[toks.length - 1])
                const d0: int = m.diags.length
                const rn: RNodeOne = parseMarkupNode(mAt(m, p.end))
                m = rn.mp
                let rt: PTok = rowTok(mp.src, p.end, m.pos, p.line)
                const locus: string = locusMarkOf(rn.n)
                if (locus != "") {
                    // §4.15: a structural element outside its owning locus (misplacedRowStmt)
                    bad = true
                    rt = { cls: TC.Other, v: locus, text: rt.text, start: rt.start, end: rt.end, line: rt.line, bad: "" }
                } else if (lifted) {
                    rows = rows.concat([rn.n])
                } else {
                    const refused: boolean = refusedRowNode(rn.n) || refusalSince(m.diags, d0)
                    if (refused) bad = true
                    let mark: string = bareRowMark()
                    if (refused) {
                        mark = logicRowMark(true)
                    } else if (!rowIsElem(rn.n)) {
                        mark = logicRowOther()
                    } else {
                        // #1919 review F2: an element that is not markup still
                        // stands as a value-form branch's one item; in statement
                        // position it is refused by name (parseStmt)
                        if (!rowIsMarkup(rn.n, mp.src, m.pos, toks)) mark = bareRowOtherMark()
                        rows = rows.concat([rn.n])
                    }
                    rt = { cls: TC.Other, v: mark, text: rt.text, start: rt.start, end: rt.end, line: rt.line, bad: "" }
                }
                toks = toks.concat([rt])
                pos = m.pos
                depth = p.depth
            }
        }
        const t: TP = { toks: toks, i: 0, nid: m.nid, diags: m.diags, file: m.file, ns: m.ns, inFn: 0 }
        return { tp: t, rows: rows, mp: m, bad: bad }
    }

    // Did the region report markup it does not render (§17.6.10.1)? Then it
    // renders nothing (a Recovered interpolation): its loop would only add a
    // second report (E-LOOP-007) for the same root cause.
    fn unrenderedSince(ds: Diag[], from: int) -> boolean {
        let i: int = from
        while (i < ds.length) {
            if (ds[i].code == "E-MARKUP-STATEMENT-NOT-RENDERED") return true
            i = i + 1
        }
        return false
    }

    fn recoveredInterp(mb: MP, start: int) -> RNodeOne {
        const re: AExpr = { nid: mb.nid, span: mkSpan(start, mb.pos), k: AExprK.Recovered }
        const mr: MP = mBump(mb)
        const nr: ANode = { nid: mr.nid, span: mkSpan(start, mr.pos), k: ANodeK.Interp(re) }
        return { n: nr, mp: mBump(mr) }
    }

    fn parseTier0(mp: MP) -> RNodeOne {
        const start: int = mp.pos
        const rr: RT0Region = tier0Region(mp)
        const rows: ANode[] = rr.rows
        const m: MP = rr.mp
        const d0: int = rr.tp.diags.length
        let t: TP = rr.tp
        t = expectP(t, "{")
        const rs: RStmt = parseStmt(t)
        t = rs.tp
        if (isP(t, ";")) t = adv(t)
        if (!isP(t, "}") && !atEnd(t)) {
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a `" + interpOpen() + " for … }` in markup holds the loop and nothing else (§49.4.4: the loop is \"the sole content of a markup `" + interpOpen() + " }` interpolation\") — compute the rest in a function, or give it its own block", cur(t))
            while (!atEnd(t) && !(isP(t, "}") && atEnd(adv(t)))) { t = adv(t) }
        }
        t = expectRegionEnd(expectP(t, "}"))
        // s472: from `m`, not `mp` — the rows read above may carry `<db>`-body
        // items (MP.hoist), which must reach the item list, never be dropped
        const mb: MP = backToMarkup(m, t)
        const f: AFor | not = forOfStmt(rs.s)
        if (f is not || rr.bad || unrenderedSince(t.diags, d0)) return recoveredInterp(mb, start)
        const n: ANode = { nid: mb.nid, span: mkSpan(start, mb.pos), k: ANodeK.Gather(fillRowsFor(f, rows)) }
        return { n: n, mp: mBump(mb) }
    }

    // =========================================================================
    // s478 (markup-in-logic) — a `${ if … }` in markup whose branches hold
    // MARKUP, read on the Tier-0 path (no second markup-in-logic path). SPEC:
    //   §10.1: "When `lift` appears in an anonymous `${}` block whose parent is a
    //   markup or style context, `lift` appends the value to the block's
    //   accumulator array"; §10.8.2: "When `lift` appears in an `if`/`else` body,
    //   only the taken branch's `lift` calls SHALL be added to the accumulator.
    //   The not-taken branch SHALL contribute zero values"; §10.8.1: they
    //   "accumulate in evaluation order".
    //   §17.6.10: "A control-flow statement that is the sole content of a markup
    //   `${…}` interpolation and whose every branch is exactly one expression
    //   SHALL be a value-form"; "A branch body that is exactly one expression
    //   SHALL be equivalent to `{ lift <expression> }`"; "When the `else` is
    //   absent, the false path SHALL contribute `not` … and SHALL render as
    //   nothing"; "A value-form SHALL re-evaluate reactively on change of any
    //   reactive cell it reads". §17.6.10.1: a single element is rendered "as
    //   the single element of an `if` / `given` branch (the implied `lift`
    //   above), or named by a `lift`"; a single-element branch beside a sibling
    //   that "is not (it uses `lift`, or holds statements)" is
    //   E-MARKUP-STATEMENT-NOT-RENDERED, whose message names that cause; and "A
    //   single-element branch is a value-form in every markup `${…}` position,
    //   including a `${ if }` nested inside the element of an enclosing
    //   single-element branch" (a nested interpolation is read by
    //   parseMarkupNode, so it is its own region).
    // The Tier-0 loop (§17.4) is already that accumulator — rows lifted in
    // order, the whole re-run when a cell it reads changes, each row's own reads
    // its own — so the `if` stands in a ONE-PASS loop, `for { <the if> break; }`
    // (§49.2: the infinite head, ended by `break`): a View.Gather like any
    // Tier-0 loop. A value-form branch `{ e }` is `{ lift e; }`; a branch `{ <p/> }`
    // is `{ lift <p/>; }`. A branch that holds statements is a statement list
    // (its `lift`s take their `;`, §7.2.2 rule 2). Only a chain that holds
    // markup comes here (tier0IfAhead); `${ if c { "A" } else { "B" } }` stays
    // the expression value-form (parseValueIfExpr).
    // =========================================================================
    fn tier0IfAhead(mp: MP) -> boolean {
        const tp: TP = regionTP(mAdv(mp, 1), LexStop.Balanced)
        if (!isP(tp, "{")) return false
        if (!isWord(adv(tp), "if")) return false
        const p: LexPause = lexTier0X(mp.src, mp.pos + 1, 0, true)
        return p.paused
    }

    // `${ <p>hello</p> }` — an element STARTS the interpolation's content: a
    // statement (§17.6.10.1 lists "`${ <p>hello</p> }`" first among the shapes
    // E-MARKUP-STATEMENT-NOT-RENDERED reaches), so the run pauses before it
    // with only the `{` lexed.
    fn tier0BareAhead(mp: MP) -> boolean {
        const p: LexPause = lexTier0X(mp.src, mp.pos + 1, 0, true)
        return p.paused && p.tokens.length == 2
    }

    // Every statement of the block is read (each element in it is reported);
    // it renders nothing.
    fn parseTier0Bare(mp: MP) -> RNodeOne {
        const start: int = mp.pos
        const rr: RT0Region = tier0Region(mp)
        let t: TP = expectP(rr.tp, "{")
        const b0: int = hardErrors(t.diags)
        while (!isP(t, "}") && !atEnd(t)) {
            const before: int = t.i
            if (isP(t, ";")) {
                t = adv(t)
            } else {
                const r: RStmts = parseTermStmts(t, b0)
                t = r.tp
            }
            if (t.i == before) t = adv(t)
        }
        t = expectRegionEnd(expectP(t, "}"))
        return recoveredInterp(backToMarkup(rr.mp, t), start)
    }

    type RT0If:struct = { s: AStmt, tp: TP, single: boolean }
    type RT0Branch:struct = { b: ABlock, tp: TP, single: boolean }

    // The one-pass loop's label: `#` starts no identifier, and a loop label is
    // one (parseJump reads an identifier), so no source jump can name it.
    // analyze.scrml tier0IfLabel() is the same string.
    fn tier0IfLabel() -> string { return "#if" }

    fn parseTier0If(mp: MP) -> RNodeOne {
        const start: int = mp.pos
        const rr: RT0Region = tier0Region(mp)
        const d0: int = rr.tp.diags.length
        const t0: TP = expectP(rr.tp, "{")
        // every branch ONE item: the value-form; otherwise every branch is a
        // statement list (accumulation, §10.1) — re-read from the same tokens
        let ri: RT0If = parseTier0IfChain(t0, true, false)
        // #1919 review F3: the message names the sibling's cause — an empty
        // branch is not one item either
        if (!ri.single) ri = parseTier0IfChain(t0, false, chainHasEmpty(ri.s))
        let t: TP = ri.tp
        if (isP(t, ";")) t = adv(t)
        if (!isP(t, "}") && !atEnd(t)) {
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a `" + interpOpen() + " if … }` in markup holds the `if` and nothing else (§17.6.10: the control-flow statement is \"the sole content of a markup `" + interpOpen() + "…}` interpolation\") — compute the rest in a function, or give it its own block", cur(t))
            while (!atEnd(t) && !(isP(t, "}") && atEnd(adv(t)))) { t = adv(t) }
        }
        t = expectRegionEnd(expectP(t, "}"))
        if (rr.bad || unrenderedSince(t.diags, d0)) return recoveredInterp(backToMarkup(rr.mp, t), start)
        // the one-pass loop: `for { <if> break; }`. It is no loop of the
        // program's (§49.9: a `break` / `continue` in the `if` has none to
        // leave), so it and its own `break` carry the reserved label
        // `tier0IfLabel()`, which no source label can spell: analyze's
        // loop-control pass (loopJump) passes over its frame for an unlabelled
        // jump — E-LOOP-001 / -002 when no loop of the program's encloses it,
        // at ANY depth (a `match` / `!{}` arm, an initializer) — and no
        // labelled jump can name it
        const brk: AStmt = { nid: t.nid, span: mkSpan(ri.s.span.end, ri.s.span.end), k: AStmtK.Break(tier0IfLabel()) }
        t = bumpId(t)
        const body: ABlock = { nid: t.nid, span: ri.s.span, stmts: [ri.s, brk] }
        t = bumpId(t)
        const f: AFor = { nid: t.nid, span: ri.s.span, label: tier0IfLabel(), head: AForHead.HForever, body: body, bound: not }
        t = bumpId(t)
        const mb: MP = backToMarkup(rr.mp, t)
        const n: ANode = { nid: mb.nid, span: mkSpan(start, mb.pos), k: ANodeK.Gather(fillRowsFor(f, rr.rows)) }
        return { n: n, mp: mBump(mb) }
    }

    // At `if`: the chain (`else if` nested in `else`). `vf`: read a branch that
    // is ONE item — one element, one expression, or a nested value-form `if` —
    // as its `lift` (§17.6.10); `single`: every branch was one.
    fn parseTier0IfChain(tp: TP, vf: boolean, emptySib: boolean) -> RT0If {
        const start: int = cur(tp).start
        let t: TP = adv(tp)
        let cond: AExpr = mkE(t, start, AExprK.Recovered).e
        // §17.6.10 `value-form-if ::= 'if' condition '{' …` — the head's
        // parentheses may be dropped (parseValueIfExpr's rule, bareHeadAt)
        if (bareHeadAt(t)) {
            const cb: RExpr = parseTernary(t)
            cond = cb.e
            t = cb.tp
        } else {
            t = bumpId(expectP(t, "("))
            const c0: RExpr = parseAssign(t)
            cond = keptHead(c0.e)                                       // §50, D10: a condition head
            t = expectP(c0.tp, ")")
        }
        const yes: RT0Branch = parseTier0Branch(t, vf, emptySib)
        t = yes.tp
        let single: boolean = yes.single
        let elseB: ABlock | not = not
        if (isWord(t, "else")) {
            t = adv(t)
            if (isWord(t, "if")) {
                const inner: RT0If = parseTier0IfChain(t, vf, emptySib)
                single = single && inner.single
                elseB = { nid: inner.tp.nid, span: inner.s.span, stmts: [inner.s] }
                t = bumpId(inner.tp)
            } else {
                const eb: RT0Branch = parseTier0Branch(t, vf, emptySib)
                single = single && eb.single
                elseB = eb.b
                t = eb.tp
            }
        }
        const r: RStmt = mkS(t, start, AStmtK.If(cond, yes.b, elseB, IfForm.Written))
        return { s: r.s, tp: r.tp, single: single }
    }

    // One branch. With `vf`, a branch that is ONE item is that item's `lift`;
    // any other branch (or any branch, without `vf`) is a statement list.
    fn parseTier0Branch(tp: TP, vf: boolean, emptySib: boolean) -> RT0Branch {
        const start: int = cur(tp).start
        if (!isP(tp, "{")) {
            // §17.6.10: every branch is braced (`'{' expression '}'`)
            const d: TP = diagAt(tp, "E-PARSE-EXPECTED", "expected `{` to open a branch of the `if`, found `" + cur(tp).text + "` — every branch of a `" + interpOpen() + " if … }` in markup is braced (§17.6.10): `if (c) { <p>…</p> } else { … }`", cur(tp))
            const rb: RBlock = parseBlockOrStmt(d)
            return { b: rb.b, tp: rb.tp, single: false }
        }
        const inner: TP = adv(tp)
        // one element: `{ <p>…</p> }` (an optional `;`)
        if (isBareRowTok(cur(inner)) && closesAfterOne(adv(inner))) {
            const row: PTok = cur(inner)
            if (!vf && isBareRowOther(row)) return oneItemBranch(logicRowStmt(inner, row.start, notMarkupWhy()), start, false)
            if (vf) {
                const stand: ANode = { nid: -1, span: mkSpan(row.start, row.end), k: ANodeK.Text("") }
                const ls: RStmt = mkS(adv(inner), row.start, AStmtK.Lift(ALift.LiftNode(stand)))
                return oneItemBranch(ls, start, true)
            }
            // a sibling branch is not one item (§17.6.10.1, the sibling sentence)
            let why: string = "this element is the single element of its branch, but a sibling branch of the same `if` is not (it uses `lift`, or holds statements) — a single-element branch renders only when every branch is one (§17.6.10.1): make every branch a single element, or `lift` in every branch (`lift <tag>…</tag>;`)"
            if (emptySib) why = "this element is the single element of its branch, but a sibling branch of the same `if` is empty, and an empty branch is not one item — a single-element branch renders only when every branch is one (§17.6.10.1): drop the empty branch (an `if` with no `else` renders nothing when false, §17.6.10), or write its value (`{ not }`)"
            const dt: TP = diagAt(inner, "E-MARKUP-STATEMENT-NOT-RENDERED", why, row)
            const re: RExpr = mkE(adv(dt), row.start, AExprK.Recovered)
            return oneItemBranch(mkS(re.tp, row.start, AStmtK.Eval(re.e)), start, false)
        }
        if (vf) {
            const h0: int = hardErrors(tp.diags)
            // a nested value-form `if` as the branch's one item
            if (isWord(inner, "if")) {
                const ni: RT0If = parseTier0IfChain(inner, true, false)
                if (ni.single && closesAfterOne(ni.tp) && hardErrors(ni.tp.diags) == h0) {
                    return oneItemBranch({ s: ni.s, tp: ni.tp }, start, true)
                }
            } else if (!isWord(inner, "lift") && !isP(inner, "}") && !isLogicRowTok(cur(inner))) {
                // one expression: `{ e }` / `{ e; }` — `{ lift e; }` (§17.6.10). Read
                // as a statement, so a statement keyword (`break`, `let`, …) is one
                const rx: RStmt = parseStmt(inner)
                const x: AExpr | not = stmtExpr(rx.s)
                if (x is given && closesAfterOne(rx.tp) && hardErrors(rx.tp.diags) == h0) {
                    const ls: RStmt = mkS(rx.tp, cur(inner).start, AStmtK.Lift(ALift.LiftExpr(x)))
                    return oneItemBranch(ls, start, true)
                }
            }
        }
        const rb: RBlock = parseBlock(tp)
        return { b: rb.b, tp: rb.tp, single: false }
    }

    // Does the chain at `s` have an empty branch (`{ }`)?
    fn chainHasEmpty(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .If(cond: c, thenB: tb, elseB: el) :> tb.stmts.length == 0 || elseHasEmpty(el)
            .Break(label: l) :> false
            .Continue(label: l) :> false
            .Given(name: n) :> false
            .Defer(body: b) :> false
            .For(f: lf) :> false
            .LocalFn(f: x) :> false
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .Return(e: x) :> false
            .EffectStmt(w: w) :> false
            .Fail(f: x) :> false
            .Lift(what: w) :> false
        }
    }

    fn elseHasEmpty(el: ABlock | not) -> boolean {
        if (el is not) return false
        if (el.stmts.length == 0) return true
        if (el.stmts.length == 1) return chainHasEmpty(el.stmts[0])
        return false
    }

    // `}` — or `;` then `}` — closes the branch after its one item.
    fn closesAfterOne(tp: TP) -> boolean {
        if (isP(tp, "}")) return true
        return isP(tp, ";") && isP(adv(tp), "}")
    }

    fn oneItemBranch(rs: RStmt, start: int, single: boolean) -> RT0Branch {
        let t: TP = rs.tp
        if (isP(t, ";")) t = adv(t)
        t = expectP(t, "}")
        const b: ABlock = { nid: t.nid, span: spanFrom(t, start), stmts: [rs.s] }
        return { b: b, tp: bumpId(t), single: single }
    }

    // Each row placeholder's stand-in node, replaced by the element read at its offset.
    fn fillRowsFor(f: AFor, rows: ANode[]) -> AFor {
        return { nid: f.nid, span: f.span, label: f.label, head: f.head, body: fillRowsBlock(f.body, rows), bound: f.bound }
    }

    fn fillRowsBlock(b: ABlock, rows: ANode[]) -> ABlock {
        let out: AStmt[] = []
        for (const s of b.stmts) { out = out.concat([fillRowsStmt(s, rows)]) }
        return { nid: b.nid, span: b.span, stmts: out }
    }

    fn fillRowsMaybe(b: ABlock | not, rows: ANode[]) -> ABlock | not {
        if (b is not) return not
        return fillRowsBlock(b, rows)
    }

    fn fillRowsStmt(s: AStmt, rows: ANode[]) -> AStmt {
        const k: AStmtK = s.k
        return match k {
            .Lift(what: w) :> withStmtK(s, AStmtK.Lift(fillLift(w, rows)))
            .LocalFn(f: x) :> s                  // s477: a nested function's body is not the loop's row scope
            .If(cond: c, thenB: tb, elseB: el, form: fm) :> withStmtK(s, AStmtK.If(c, fillRowsBlock(tb, rows), fillRowsMaybe(el, rows), fm))
            .Given(name: n, subject: sub, body: b) :> withStmtK(s, AStmtK.Given(n, sub, fillRowsBlock(b, rows)))
            .For(f: lf) :> withStmtK(s, AStmtK.For(fillRowsFor(lf, rows)))
            .Defer(body: b, arrayLead: a, bare: br) :> withStmtK(s, AStmtK.Defer(fillRowsBlock(b, rows), a, br))
            .Eval(e: x) :> s
            .Local(name: n) :> s
            .Return(e: x) :> s
            .EffectStmt(w: w) :> s
            .Fail(f: x) :> s
            .Break(label: x) :> s
            .Continue(label: x) :> s
        }
    }

    fn fillLift(w: ALift, rows: ANode[]) -> ALift {
        return match w {
            .LiftNode(n: n) :> ALift.LiftNode(rowAt(n, rows))
            .LiftExpr(e: x) :> w
        }
    }

    fn rowAt(n: ANode, rows: ANode[]) -> ANode {
        for (const r of rows) {
            if (r.span.start == n.span.start) return r
        }
        return n
    }

    fn isIterHead(h: AForHead) -> boolean {
        return match h {
            .HIter(bind: b) :> true
            .HForever :> false
            .HCond(cond: c) :> false
            .HCounted(init: i) :> false
        }
    }

    // At `(` of `[let | const] name of iterable`.
    fn parseIterHead(tp: TP, label: string, start: int) -> RStmt {
        let t: TP = adv(tp)
        let mutable = false
        if (isWord(t, "let")) {
            mutable = true
            t = adv(t)
        } else if (isWord(t, "const")) {
            t = adv(t)
        }
        const bt: PTok = cur(t)
        const bind: ABind = { nid: t.nid, span: mkSpan(bt.start, bt.end), name: bt.v }
        t = adv(adv(bumpId(t)))
        const src: RSrc = parseIterSrc(t)
        // s474 — the header `key-clause` (§49.2.1 `iterate-head ::= for-binder
        // 'of' iterable key-clause?`, `key-clause ::= 'key' expression`, §17.4b)
        let ht: TP = src.tp
        let key: AExpr | not = not
        if (isWord(ht, "key")) {
            const kx: RExpr = parseAssign(adv(ht))
            key = kx.e
            ht = kx.tp
        }
        const body: RBlock = parseLoopBody(closeHead(ht))
        return forStmt(body.tp, start, label, AForHead.HIter(bind, mutable, src.src, key), body.b)
    }

    // The iterable (after `of`), up to (not consuming) the head's `)`: an
    // expression, or — when a range glyph stands at the head's top level — a
    // range `lo..hi` / `lo..=hi`, each bound an additive expression (§49.2.1
    // `range ::= additive-expr '..' additive-expr`). A range that is not the
    // WHOLE iterable (`a || 0..n`, `0..n > 1`) is E-RANGE-OUTSIDE-LOOP-HEAD.
    fn parseIterSrc(tp: TP) -> RSrc {
        if (!rangeAtTop(tp)) {
            const e: RExpr = parseAssign(tp)
            return { src: AIterSrc.IterOf(e.e), tp: e.tp }
        }
        const lo: RExpr = parseBinary(tp, 6)
        if (!isRangeTok(lo.tp)) return rangeNotWhole(lo.tp, cur(lo.tp))
        const inclusive: boolean = isP(lo.tp, "..=")
        const hi: RExpr = parseBinary(adv(lo.tp), 6)
        if (isP(hi.tp, ")") || isWord(hi.tp, "key")) return { src: AIterSrc.IterRange(lo.e, hi.e, inclusive), tp: hi.tp }   // s474: or the header `key`
        if (hi.tp.diags.length == lo.tp.diags.length && continuesExpr(hi.tp)) return rangeNotWhole(hi.tp, cur(lo.tp))
        const re: RExpr = mkE(hi.tp, cur(lo.tp).start, AExprK.Recovered)
        return { src: AIterSrc.IterOf(re.e), tp: re.tp }
    }

    // An operator that would continue an expression (a binary operator, `?`).
    fn continuesExpr(tp: TP) -> boolean {
        if (binPrec(tp) > 0) return true
        return isP(tp, "?")
    }

    // At a head's closing `)`: past it. Anything else there is a syntax error,
    // reported once, and the head is skipped FORWARD to its `)` — the state is
    // never rebuilt from an earlier one (that would drop the diagnostic and
    // rewind the node ids).
    fn closeHead(tp: TP) -> TP {
        if (isP(tp, ")")) return adv(tp)
        let t: TP = tp
        if (!atEnd(t)) {
            const bad: PTok = cur(t)
            t = diagAt(t, "E-PARSE-EXPECTED", "expected `)` to end the `for` head, found `" + bad.text + "`", bad)
        }
        t = toHeadClose(t)
        if (isP(t, ")")) return adv(t)
        return t
    }

    fn rangeNotWhole(tp: TP, at: PTok) -> RSrc {
        const d: TP = diagAt(tp, "E-RANGE-OUTSIDE-LOOP-HEAD", "a range in a `for` head is the WHOLE iterable (`for (i of a..b)`), not an operand of it — a range is not a value (§49.2.5)", at)
        const t: TP = toHeadClose(d)
        const re: RExpr = mkE(t, at.start, AExprK.Recovered)
        return { src: AIterSrc.IterOf(re.e), tp: re.tp }
    }

    // Is a range glyph at depth 0 before the head's closing `)`?
    fn rangeAtTop(tp: TP) -> boolean {
        let k: int = 0
        let depth: int = 0
        let going = true
        while (going) {
            const x: PTok = peekAt(tp, k)
            if (x.cls == TC.End) return false
            if (x.cls == TC.Punct) {
                if (tk(x, "(") || tk(x, "[") || tk(x, "{")) depth = depth + 1
                if (tk(x, ")") || tk(x, "]") || tk(x, "}")) {
                    if (depth == 0) return false
                    depth = depth - 1
                }
                if (depth == 0 && (tk(x, "..") || tk(x, "..="))) return true
            }
            k = k + 1
        }
        return false
    }

    // Forward to the head's closing `)` (at depth 0; not consumed) — or to a
    // depth-0 `{`, which begins the body when the `)` is missing (a recovery
    // must never eat the body, or the enclosing block's `}`).
    fn toHeadClose(tp: TP) -> TP {
        let t: TP = tp
        let depth: int = 0
        while (!atEnd(t)) {
            const x: PTok = cur(t)
            if (x.cls == TC.Punct) {
                if (depth == 0 && tk(x, "{")) return t
                if (tk(x, "(") || tk(x, "[") || tk(x, "{")) depth = depth + 1
                if (tk(x, ")") || tk(x, "]") || tk(x, "}")) {
                    if (depth == 0) return t
                    depth = depth - 1
                }
            }
            t = adv(t)
        }
        return t
    }

    // Forward to the body's `{` at depth 0 (not consumed); stops at a depth-0
    // `}` or `;` (the statement ends there: no body to read).
    fn toBodyOpen(tp: TP) -> TP {
        let t: TP = tp
        let depth: int = 0
        while (!atEnd(t)) {
            const x: PTok = cur(t)
            if (x.cls == TC.Punct) {
                if (depth == 0 && (tk(x, "{") || tk(x, "}") || tk(x, ";"))) return t
                if (tk(x, "(") || tk(x, "[")) depth = depth + 1
                if (tk(x, ")") || tk(x, "]")) depth = depth - 1
            }
            t = adv(t)
        }
        return t
    }

    // At `(` of `init; cond; step` (§49.3.2). `init`: `let` declarators (a
    // comma list, §40.8) or assignments; an empty `cond` is `true`; `step`: a
    // comma list. `for (;;)` is the infinite head (§49.2.1).
    fn parseCounted(tp: TP, label: string, start: int) -> RStmt {
        let t: TP = adv(tp)
        let init: AStmt[] = []
        if (isWord(t, "const")) {
            const ck: PTok = cur(t)
            t = diagAt(t, "E-PARSE-FOR-HEAD", "a counted head declares its counters with `let` — the step rebinds them (§49.2.1 `for-init ::= 'let' declarator …`)", ck)
        }
        if (isWord(t, "let") || isWord(t, "const")) {
            const rd: RStmts = parseForDecls(t, true)
            init = rd.ss
            t = rd.tp
        } else if (!isP(t, ";")) {
            const ra: RStmts = parseForAssigns(t)
            init = ra.ss
            t = ra.tp
        }
        t = expectP(t, ";")
        let cond: AExpr | not = not
        if (!isP(t, ";")) {
            const c: RExpr = parseAssign(t)
            cond = c.e
            t = c.tp
        }
        t = expectP(t, ";")
        let step: AExpr[] = []
        let going = !isP(t, ")") && !atEnd(t)
        while (going) {
            const r: RExpr = parseAssign(t)
            step = step.concat([r.e])
            t = r.tp
            if (isP(t, ",")) {
                t = adv(t)
            } else {
                going = false
            }
        }
        const body: RBlock = parseLoopBody(closeHead(t))
        if (init.length == 0 && cond is not && step.length == 0) return forStmt(body.tp, start, label, AForHead.HForever, body.b)
        return forStmt(body.tp, start, label, AForHead.HCounted(init, cond, step), body.b)
    }

    // `let a = 0, b: int = 1` — each declarator its own Local statement.
    fn parseForDecls(tp: TP, mutable: boolean) -> RStmts {
        let t: TP = adv(tp)
        let out: AStmt[] = []
        let going = true
        while (going) {
            const r: RStmt = parseDeclarator(t, mutable)
            out = out.concat([r.s])
            t = r.tp
            if (isP(t, ",")) {
                t = adv(t)
            } else {
                going = false
            }
        }
        return { ss: out, tp: t }
    }

    // `name [: T] = init` (after the `let`).
    fn parseDeclarator(tp: TP, mutable: boolean) -> RStmt {
        const nameTok: PTok = cur(tp)
        const start: int = nameTok.start
        let t: TP = tp
        if (nameTok.cls != TC.Ident) t = diagAt(t, "E-PARSE-LOCAL", "expected a name in the `let` of a `for` head", nameTok)
        t = adv(t)
        let aty: AType | not = not
        if (isP(t, ":")) {
            const ty: RType = parseType(adv(t))
            aty = ty.t
            t = ty.tp
        }
        t = expectP(t, "=")
        const init: RExpr = parseAssign(t)
        return mkS(init.tp, start, AStmtK.Local(nameTok.v, mutable, aty, init.e, false))
    }

    // `i = 0, j = n` — each an expression statement.
    fn parseForAssigns(tp: TP) -> RStmts {
        let t: TP = tp
        let out: AStmt[] = []
        let going = true
        while (going) {
            const start: int = cur(t).start
            const r: RExpr = parseAssign(t)
            const s: RStmt = mkS(r.tp, start, AStmtK.Eval(r.e))
            out = out.concat([s.s])
            t = s.tp
            if (isP(t, ",")) {
                t = adv(t)
            } else {
                going = false
            }
        }
        return { ss: out, tp: t }
    }

    // After `for` with no `(`: the braceless head, removed (§49.4.1). The
    // recovery is the §34 row's bounded one — the binder, the `in` / `of`,
    // the iterable — so no part of it is read as statements.
    fn bracelessFor(tp: TP, kw: PTok, start: int) -> RStmt {
        let t: TP = diagAt(tp, "E-FOR-UNPARENTHESIZED-HEAD", "a `for` head is parenthesized — write `for (x of xs) { … }` (§49.4.1, §17.4; the braceless `for x in xs` form is removed)", kw)
        if (isWord(t, "let") || isWord(t, "const")) t = adv(t)
        if (cur(t).cls == TC.Ident) t = adv(t)
        if (isWord(t, "in") || isWord(t, "of")) t = adv(t)
        const it: RExpr = parseAssign(t)
        const body: RBlock = parseLoopBody(it.tp)
        return recoveredStmt(body.tp, start)
    }

    // `break [label]` / `continue [label]` (§49.2.1). There is no `break
    // value` (§49.6).
    fn parseJump(tp: TP, isBreak: boolean) -> RStmt {
        const kw: PTok = cur(tp)
        let t: TP = adv(tp)
        let label: string = ""
        const nx: PTok = cur(t)
        if (nx.cls == TC.Ident && nx.line == kw.line) {
            label = nx.v
            t = adv(t)
        } else if (nx.cls != TC.End && nx.line == kw.line && !tk(nx, ";") && !tk(nx, "}")) {
            t = diagAt(t, "E-PARSE-EXPECTED", "`" + kw.v + "` takes only a loop label — there is no `" + kw.v + " value` (§49.2.1, §49.6)", nx)
            // s469: a keyword there (`break fail;`) is consumed with the report, never
            // read again as a statement of its own (one report, not a second bare `fail`)
            if (nx.cls == TC.Keyword) t = adv(t)
        }
        if (isBreak) return mkS(t, kw.start, AStmtK.Break(label))
        return mkS(t, kw.start, AStmtK.Continue(label))
    }

    // `while (cond) { … }` — retired (§49.4.1); the fix is the same head under `for`.
    fn retiredWhile(tp: TP) -> RStmt {
        const kw: PTok = cur(tp)
        let t: TP = adv(diagAt(tp, "E-LOOP-WHILE-RETIRED", "`while` is not a scrml loop — write `for (cond) { … }`: a `for` with a condition head runs while the condition is true (§49.1, §49.4.1)", kw))
        if (isP(t, "(")) t = skipParens(t)
        const body: RBlock = parseBlockOrStmt(t)
        return recoveredStmt(body.tp, kw.start)
    }

    // `do { … } while (cond)` — retired (§49.4.1); the fix is §49.3.6's body-first loop.
    fn retiredDoWhile(tp: TP) -> RStmt {
        const kw: PTok = cur(tp)
        const t: TP = adv(diagAt(tp, "E-LOOP-DO-WHILE-RETIRED", "`do … while` is not a scrml loop — write a body-first `for { …; if (done) { break } }`, or, when the body uses `continue`, `for (let first = true; first || cond; first = false) { … }` (§49.3.6)", kw))
        const body: RBlock = parseBlockOrStmt(t)
        let t2: TP = body.tp
        if (isWord(t2, "while")) {
            t2 = adv(t2)
            if (isP(t2, "(")) t2 = skipParens(t2)
        }
        return recoveredStmt(t2, kw.start)
    }

    fn parseLocal(tp: TP) -> RStmt {
        const start: int = cur(tp).start
        // s478-boot-destructuring — a pattern where ONE statement stands (not a
        // statement list, whose readers take it through parseTermStmts): read past
        // whole, refused by name (INTERIM)
        if (destructDeclAhead(tp)) {
            const rd: RStmts = parseDestructDecl(tp)
            const dd: TP = diagAt(rd.tp, "E-BOOTSTRAP-UNSUPPORTED", "a destructuring declaration here (a body top, or where a single statement stands rather than a `{ … }` statement list) is not in the bootstrap yet — destructure inside a function or handler body, or bind the value and read its fields (`const v = …;` then `v.a`)", cur(tp))
            return recoveredStmt(dd, start)
        }
        const mutable: boolean = isWord(tp, "let")
        let t: TP = adv(tp)
        const nameTok: PTok = cur(t)
        if (nameTok.cls != TC.Ident) t = diagAt(t, "E-PARSE-LOCAL", "expected a name after `let` / `const`", nameTok)
        t = adv(t)
        let aty: AType | not = not
        if (isP(t, ":")) {
            const ty: RType = parseTypeAt(adv(t), true)
            aty = ty.t
            t = ty.tp
        }
        t = expectP(t, "=")
        // s469 — a `for-binding` (§49.2.1): the value form, from any head (§49.6)
        if (isWord(t, "for") || labelAhead(t)) {
            if (aty is given) t = refuseRefineIn(t, aty, "on the loop-bound `" + nameTok.v + "` (its value is the loop's)")
            return parseForBinding(t, start, nameTok, mutable, aty)
        }
        const init: RExpr = parseAssign(t)
        let t2: TP = init.tp
        if (aty is given && standingRefine(aty)) {
            const rz: RLocalRefine = localRefine(t2, aty, init.e, mutable, nameTok.v)
            t2 = rz.tp
            aty = rz.ty
        }
        return mkS(t2, start, AStmtK.Local(nameTok.v, mutable, aty, init.e, false))
    }

    // =========================================================================
    // s478-boot-destructuring — a destructuring declaration (`const { a, b: c } = e;`)
    // and a destructuring `for` binder (`for (const { id, name } of xs) { … }`).
    //
    // SPEC: §7.2 "All JavaScript that is valid in a Bun execution context is valid
    // inside `${ }`, except the constructs §7.2.1 excludes" (destructuring is not
    // excluded; §7.2.1 names `const { class: c } = o` a valid destructuring key);
    // §49.2.1 `for-binder ::= ('let' | 'const')? (Identifier | destructuring-pattern)`;
    // §49.3.5 "A destructuring binder follows §50's destructuring rules" — and the
    // JavaScript meaning of an object binding pattern: the value is evaluated ONCE,
    // then each property is read from it in order (`const { a } = o` binds what
    // `o.a` reads). So the declaration is READ AS that: one `const` holding the
    // value, then one local per bound name holding the member read off it —
    //     const { a, b: { c } } = e;   ≡   const v = e; const a = v.a;
    //                                       const w = v.b; const c = w.c;
    // (`v` / `w` — minted temps `destructured#<offset>`: `#` is spelled by no
    // identifier, names.scrml sanitize). Each bound name is therefore typed, checked
    // and lowered exactly as that member read is (a missing field, a read off a
    // value that is not a struct, a maybe-absent value — the member read's own
    // codes), and `e` is read once (§35.3 rule 1: a `lin` `e` is ONE consumption;
    // whether the bound names inherit `lin` is unruled — analyze refuses a
    // destructured `lin` binding by name, linLocal). `let { … }` makes the bound
    // names mutable; the temps are always `const`. In a `for` head the binder is
    // the temp and the bound names open the body.
    //
    // Built: shorthand `{ a }`, rename `{ a: x }` (any name as the key, §7.2.1's
    // `{ class: c }`), a nested object pattern `{ a: { b } }`, `{}`.
    // Refused by name (E-BOOTSTRAP-UNSUPPORTED, INTERIM — the SPEC gives no scrml
    // reading of them): a default `{ a = 1 }`, a rest `{ ...r }`, a computed /
    // string / number key, a type annotation on the pattern, a TAPE pattern
    // `[x, y]` (owner question: an index read `t[i]` traps out of range,
    // §66.12.8, where JavaScript's pattern yields undefined), a pattern where one
    // statement stands, at file scope, and a `key` clause on a destructuring
    // `for` binder. A refused pattern still declares its names (no use cascades);
    // nothing downstream types or runs them (a Recovered initializer).
    // =========================================================================
    type DStep:struct = { dst: string, src: string, key: string, span: ASpan, leaf: boolean }
    type RDPat:struct = { steps: DStep[], tp: TP, bad: boolean }

    fn destructTemp(at: int) -> string { return "destructured#" + at }

    // At `let` / `const`: a pattern next.
    fn destructDeclAhead(tp: TP) -> boolean {
        if (!isWord(tp, "let") && !isWord(tp, "const")) return false
        const o: PTok = peekAt(tp, 1)
        return o.cls == TC.Punct && (tk(o, "{") || tk(o, "["))
    }

    // A statement-list reader's one statement — or, for a destructuring
    // declaration, its statements — each with its terminator (parseTermStmt).
    fn parseTermStmts(tp: TP, d0: int) -> RStmts {
        if (destructDeclAhead(tp)) {
            const r: RStmts = parseDestructDecl(tp)
            return { ss: r.ss, tp: termAfter(r.tp, r.ss[r.ss.length - 1], d0) }
        }
        const r1: RStmt = parseTermStmt(tp, d0)
        return { ss: [r1.s], tp: r1.tp }
    }

    fn synE(tp: TP, sp: ASpan, k: AExprK) -> RExpr {
        const e: AExpr = { nid: tp.nid, span: sp, k: k }
        return { e: e, tp: bumpId(tp) }
    }

    fn synS(tp: TP, sp: ASpan, k: AStmtK) -> RStmt {
        const s: AStmt = { nid: tp.nid, span: sp, k: k }
        return { s: s, tp: bumpId(tp) }
    }

    // At `let` / `const` before a pattern: the declaration's statements (never empty).
    fn parseDestructDecl(tp: TP) -> RStmts {
        const start: int = cur(tp).start
        const mutable: boolean = isWord(tp, "let")
        let t: TP = adv(tp)
        const root: string = destructTemp(cur(t).start)
        const n0: int = t.diags.length
        const rp: RDPat = parseDPattern(t, root)
        t = rp.tp
        let bad: boolean = rp.bad
        if (rp.bad && hasCodeFrom(t, n0, "E-STMT-UNCLOSED-PATTERN")) {
            // s478 (review-followups-3): an unclosed pattern has no `=` to read — the
            // declaration is skipped to its `;` (the one report stands; no cascade)
            t = skipToStmtEnd(t)
            const rv: RExpr = synE(t, spanFrom(t, start), AExprK.Recovered)
            const rr: RStmt = synS(rv.tp, spanFrom(rv.tp, start), AStmtK.Local(root, false, not, rv.e, false))
            const rrs: RStmts = stepStmts(rr.tp, rp.steps, mutable, true)
            return { ss: [rr.s].concat(rrs.ss), tp: rrs.tp }
        }
        if (isP(t, ":")) {
            const ct: PTok = cur(t)
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a type annotation on a destructuring pattern is not in the bootstrap yet — annotate the value instead: `const v: T = …;`, then destructure `v`", ct)
            const ty: RType = parseTypeAt(adv(t), true)
            t = ty.tp
            bad = true
        }
        t = expectP(t, "=")
        const init: RExpr = parseAssign(t)
        t = init.tp
        const whole: ASpan = spanFrom(t, start)
        // (refused: the value is still read — its own checks, a `lin` it consumes —
        // and the bound names declared with Recovered values)
        const r0: RStmt = synS(t, whole, AStmtK.Local(root, false, not, init.e, false))
        const rs: RStmts = stepStmts(r0.tp, rp.steps, mutable, bad)
        return { ss: [r0.s].concat(rs.ss), tp: rs.tp }
    }

    // One local per step, in order: a bound name (`leaf`, mutable under `let`) or a
    // nested pattern's temp, holding the member `key` read off `src` (a Recovered
    // placeholder when the pattern was refused).
    fn stepStmts(tp: TP, steps: DStep[], mutable: boolean, bad: boolean) -> RStmts {
        let t: TP = tp
        let out: AStmt[] = []
        for (const st of steps) {
            const ie: RExpr = stepInit(t, st, bad)
            const ls: RStmt = synS(ie.tp, st.span, AStmtK.Local(st.dst, mutable && st.leaf, not, ie.e, false))
            out = out.concat([ls.s])
            t = ls.tp
        }
        return { ss: out, tp: t }
    }

    fn stepInit(tp: TP, st: DStep, bad: boolean) -> RExpr {
        if (bad) return synE(tp, st.span, AExprK.Recovered)
        const ob: RExpr = synE(tp, st.span, AExprK.Name(st.src))
        return synE(ob.tp, st.span, AExprK.Member(ob.e, st.key))
    }

    // At `{` / `[`: a pattern whose properties are read off `src`.
    fn parseDPattern(tp: TP, src: string) -> RDPat {
        if (isP(tp, "{")) return parseObjPattern(tp, src)
        const o: PTok = cur(tp)
        const d: TP = diagAt(tp, "E-BOOTSTRAP-UNSUPPORTED", "a tape destructuring pattern `[x, y]` is not in the bootstrap yet — whether a pattern longer than the tape traps like an index read (§66.12.8) or binds `not` is unruled; read the elements by index: `const x = t[0];`", o)
        const sk: RDPat = skipPatternElem(d, src, true)
        return { steps: sk.steps, tp: sk.tp, bad: true }
    }

    // A refused element (or a whole refused `[ … ]` pattern when `whole`): read past
    // it — to the next `,` / closer at its own depth — keeping each name it binds
    // (a name followed by `,`, `}`, `]` or `=`, not a key before `:`), so a use of
    // one does not cascade.
    fn skipPatternElem(tp: TP, src: string, whole: boolean) -> RDPat {
        let t: TP = tp
        let depth: int = 0
        let steps: DStep[] = []
        let going = true
        while (going) {
            const x: PTok = cur(t)
            if (x.cls == TC.End) {
                going = false
            } else if (depth == 0 && x.cls == TC.Punct && tk(x, ";")) {
                // s478 (review-followups-3): a pattern never holds a depth-0 `;` — an
                // unclosed `{ id = p;` stops at the statement's end, not the file's
                going = false
            } else if (x.cls == TC.At) {
                // `@name` binds nothing (§6.1.2) — its name is not kept as a local
                t = adv(t)
                if (cur(t).cls == TC.Ident) t = adv(t)
            } else if (x.cls == TC.Punct && (tk(x, "{") || tk(x, "[") || tk(x, "("))) {
                depth = depth + 1
                t = adv(t)
            } else if (x.cls == TC.Punct && (tk(x, "}") || tk(x, "]") || tk(x, ")"))) {
                if (depth == 0) {
                    going = false
                } else {
                    depth = depth - 1
                    t = adv(t)
                    if (whole && depth == 0) going = false
                }
            } else if (depth == 0 && !whole && x.cls == TC.Punct && tk(x, ",")) {
                going = false
            } else {
                const nx: PTok = peekAt(t, 1)
                const named: boolean = x.cls == TC.Ident || x.cls == TC.Variant
                if (named && nx.cls == TC.Punct && (tk(nx, ",") || tk(nx, "}") || tk(nx, "]") || tk(nx, "="))) {
                    steps = steps.concat([{ dst: x.v, src: src, key: x.v, span: mkSpan(x.start, x.end), leaf: true }])
                }
                t = adv(t)
            }
        }
        return { steps: steps, tp: t, bad: true }
    }

    fn hasCodeFrom(tp: TP, from: int, code: string) -> boolean {
        let i: int = from
        while (i < tp.diags.length) {
            if (tp.diags[i].code == code) return true
            i = i + 1
        }
        return false
    }

    // Error recovery: to the statement's depth-0 `;` (left for the caller), the end, or
    // the closer of the enclosing block (not consumed).
    fn skipToStmtEnd(tp: TP) -> TP {
        let t: TP = tp
        let depth: int = 0
        let going = true
        while (going) {
            const x: PTok = cur(t)
            if (x.cls == TC.End) {
                going = false
            } else if (x.cls == TC.Punct && (tk(x, "{") || tk(x, "[") || tk(x, "("))) {
                depth = depth + 1
                t = adv(t)
            } else if (x.cls == TC.Punct && (tk(x, "}") || tk(x, "]") || tk(x, ")"))) {
                if (depth == 0) {
                    going = false
                } else {
                    depth = depth - 1
                    t = adv(t)
                }
            } else if (depth == 0 && x.cls == TC.Punct && tk(x, ";")) {
                going = false
            } else {
                t = adv(t)
            }
        }
        return t
    }

    // s478 (review-followups-3) — §6.1.2: "`@varname` SHALL NOT be a DESTRUCTURING TARGET
    // (`const { @varname } = o`, `const { k: @varname } = o`, …) — same code" (E-OBJECT-
    // SHORTHAND-CELL). At the `@`: the one report; the caller skips the element, and
    // skipPatternElem keeps no local for the name after `@` (no E-NAME-COLLIDES-STATE).
    fn cellTargetDiag(tp: TP, at: PTok) -> TP {
        const nm: PTok = peekAt(tp, 1)
        let n: string = "name"
        if (nm.cls == TC.Ident) n = nm.v
        return diagAt(tp, "E-OBJECT-SHORTHAND-CELL", "`@" + n + "` cannot be a destructuring target — it is a cell read, not a name a pattern binds (§6.1.2); bind a local, then write the cell: `const { " + n + " } = …;` then `@" + n + " = " + n + ";`", at)
    }

    fn parseObjPattern(tp: TP, src: string) -> RDPat {
        let t: TP = adv(tp)
        let steps: DStep[] = []
        let bad = false
        let going = !isP(t, "}") && !atEnd(t)
        while (going) {
            const k: PTok = cur(t)
            if (isSpread(t)) {
                const dr: TP = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a rest element `...name` in a destructuring pattern is not in the bootstrap yet — it would bind a struct of the remaining fields, which has no declared type; read the fields you need", k)
                const sr: RDPat = skipPatternElem(dr, src, false)
                steps = steps.concat(sr.steps)
                t = sr.tp
                bad = true
            } else if (isP(t, "[") || k.cls == TC.Str || k.cls == TC.Num) {
                const dk: TP = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a computed, string or number key in a destructuring pattern is not in the bootstrap yet — a struct field is a name: write `{ field: x }`", k)
                let kt: TP = adv(dk)
                if (isP(dk, "[")) {
                    const sk: RDPat = skipPatternElem(dk, src, true)
                    kt = sk.tp
                }
                const sr: RDPat = skipPatternElem(kt, src, false)
                steps = steps.concat(sr.steps)
                t = sr.tp
                bad = true
            } else if (k.cls == TC.At) {
                const sc: RDPat = skipPatternElem(cellTargetDiag(t, k), src, false)
                steps = steps.concat(sc.steps)
                t = sc.tp
                bad = true
            } else if (!isNameTok(k)) {
                const dp: TP = diagAt(t, "E-STMT-PATTERN-PROPERTY", "expected a property name in an object-destructuring pattern, found `" + k.text + "`", k)
                const sr: RDPat = skipPatternElem(dp, src, false)
                steps = steps.concat(sr.steps)
                t = sr.tp
                bad = true
            } else {
                t = adv(t)
                if (isP(t, ":")) {
                    t = adv(t)
                    const v: PTok = cur(t)
                    if (isP(t, "{")) {
                        const sub: string = destructTemp(v.start)
                        steps = steps.concat([{ dst: sub, src: src, key: k.v, span: mkSpan(k.start, k.end), leaf: false }])
                        const r: RDPat = parseObjPattern(t, sub)
                        steps = steps.concat(r.steps)
                        t = r.tp
                        if (r.bad) bad = true
                    } else if (isP(t, "[")) {
                        const r2: RDPat = parseDPattern(t, src)
                        steps = steps.concat(r2.steps)
                        t = r2.tp
                        bad = true
                    } else if (v.cls == TC.Ident) {
                        steps = steps.concat([{ dst: v.v, src: src, key: k.v, span: mkSpan(k.start, v.end), leaf: true }])
                        t = adv(t)
                    } else if (v.cls == TC.At) {
                        const sv: RDPat = skipPatternElem(cellTargetDiag(t, v), src, false)
                        steps = steps.concat(sv.steps)
                        t = sv.tp
                        bad = true
                    } else {
                        const db: TP = diagAt(t, "E-STMT-BINDING-NAME", "expected a name to bind the field `" + k.v + "` to, found `" + v.text + "`", v)
                        const sr: RDPat = skipPatternElem(db, src, false)
                        steps = steps.concat(sr.steps)
                        t = sr.tp
                        bad = true
                    }
                } else if (k.cls != TC.Ident) {
                    t = diagAt(t, "E-STMT-BINDING-NAME", "`" + k.v + "` is a keyword and cannot be bound as a name — rename it: `{ " + k.v + ": name }`", k)
                    bad = true
                } else {
                    steps = steps.concat([{ dst: k.v, src: src, key: k.v, span: mkSpan(k.start, k.end), leaf: true }])
                }
                if (isP(t, "=")) {
                    const dd: TP = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a default value in a destructuring pattern (`{ " + k.v + " = … }`) is not in the bootstrap yet — a struct field is always present; read it, or test an optional field after the declaration", cur(t))
                    const sr: RDPat = skipPatternElem(dd, src, false)
                    t = sr.tp
                    bad = true
                }
            }
            if (isP(t, ",")) {
                t = adv(t)
                if (isP(t, "}")) going = false
            } else {
                going = false
            }
            if (atEnd(t)) going = false
        }
        if (isP(t, "}")) {
            t = adv(t)
        } else {
            const u: PTok = cur(t)
            t = diagAt(t, "E-STMT-UNCLOSED-PATTERN", "expected `}` to close an object-destructuring pattern, found `" + u.text + "`", u)
            bad = true
        }
        return { steps: steps, tp: t, bad: bad }
    }

    // s478 — the zone of a local's top refinement (parseLocal): a `const` whose
    // value is a literal is the static zone (§53.4.2 rules 1-2), judged now; a `let`
    // (every later assignment is a boundary-zone write, §53.4.3) or any other value
    // is refused by name (INTERIM).
    type RLocalRefine:struct = { ty: AType, tp: TP }

    // s478 (s478-boot-refinement-runtime) — a `const` local whose value is not a
    // literal (or a literal the bootstrap does not decide now, a `url`) is the
    // boundary zone, and its runtime check is BUILT: §53.4.3 rule 1 "The compiler
    // SHALL emit a runtime check when: The value comes from an unconstrained
    // source", §53.4.5 "The check SHALL be emitted at the assignment site" (lower.scrml
    // localRefineCheck — checked as the local binds, before any later statement).
    fn localRefine(tp: TP, ty: AType, init: AExpr, mutable: boolean, name: string) -> RLocalRefine {
        // Review #1911 HIGH-1: only a local in a BODY (tp.inFn 1 / 2) is lowered by
        // lowerStmt .Local, where localRefineCheck builds the check. A `const` at file
        // scope (tp.inFn 0 — top-level logic, any `${ }` region outside a body) is a
        // §7.6 file-scope constant, lowered by the constant path (lower.scrml coreConsts),
        // which builds no check — so there it stays refused by name (INTERIM), never
        // admitted unchecked (§53.11 "The compiler SHALL emit a runtime check for every
        // boundary-zone assignment that it cannot statically elide").
        const where: string = tp.inFn == 0 ? "the file-scope constant `" + name + "`" : "the local `" + name + "`"
        let z: RefZone = refineFixedZone(ty, refLitOf(init), where)
        if (!mutable && tp.inFn != 0 && z.code == "E-BOOTSTRAP-UNSUPPORTED") z = { code: "", msg: "", reported: false }
        if (mutable && z.code != "E-CONTRACT-001") {
            z = { code: "E-BOOTSTRAP-UNSUPPORTED", msg: refBoundaryMsg(typeNameText(ty), "on the `let` local `" + name + "` — each later assignment to it is a boundary-zone write"), reported: false }
        }
        if (z.code == "") return { ty: ty, tp: tp }
        const d: Diag = newDiag(z.code, z.msg, tp.file, ty.span)
        const t: TP = { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
        if (z.reported) return { ty: reportedRefine(ty), tp: t }
        return { ty: ty, tp: t }
    }

    // s471 — `lin name = init;` (§35.2: "`lin` is a declaration keyword. It takes
    // the same syntactic position as `let` and `const`"; `lin-declaration ::= 'lin'
    // identifier '=' expression ';'`). An immutable local, marked linear — the
    // linear pass (analyze linPass) counts its consumptions. The production has no
    // type annotation: `lin x: T = …` is a shape §35.2 does not govern — refused
    // by name (an open question), never read silently.
    fn parseLinLocal(tp: TP) -> RStmt {
        const start: int = cur(tp).start
        let t: TP = adv(tp)
        const nameTok: PTok = cur(t)
        if (nameTok.cls != TC.Ident) t = diagAt(t, "E-PARSE-LOCAL", "expected a name after `lin`", nameTok)
        t = adv(t)
        let aty: AType | not = not
        if (isP(t, ":")) {
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a type annotation on a `lin` declaration — §35.2's grammar is `lin name = expression;` (no annotation); write `lin " + nameTok.v + " = …;` (the value's type is its initializer's)", cur(t))
            const ty: RType = parseType(adv(t))
            aty = ty.t
            t = ty.tp
        }
        t = expectP(t, "=")
        const init: RExpr = parseAssign(t)
        return mkS(init.tp, start, AStmtK.Local(nameTok.v, false, aty, init.e, true))
    }

    // s474 (§50, S473 D10) — an assignment in its own parentheses `(x = e)`: the
    // mark the condition-head rule (keptHead) reads. Parentheses are otherwise
    // transparent (the node is the inner expression).
    fn parenMark(e: AExpr) -> AExpr {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> { nid: e.nid, span: e.span, k: AExprK.Assign(t, v, true, false) }
            .Unary(op: o) :> e
            .Binary(op: o) :> e
            .Str(v: x) :> e
            .Name(name: x) :> e
            .At(name: x) :> e
            .AtItem :> e
            .Num(raw: x) :> e
            .Bool(v: x) :> e
            .NotLit :> e
            .Recovered :> e
            .Variant(name: x) :> e
            .Member(obj: x) :> e
            .Call(callee: x) :> e
            .Ternary(test: x) :> e
            .ArrayLit(elems: x) :> e
            .ObjectLit(props: x) :> e
            .Spread(e: x) :> e
            .Index(obj: x) :> e
            .Lambda(params: x) :> e
            .BlockLambda(params: x) :> e
            .Sql(q: x) :> e
            .Handled(h: x) :> e
            .Template(quasis: x) :> e
            .HashRef(id: hr0) :> e
            .Foreign(f: x) :> e
        }
    }

    // s474 (§50 amendment, S473 D10): "The ONLY assignment-as-expression the
    // language keeps is an assignment wrapped in its own parentheses inside the
    // condition head of a `for (…)` or `if (…)` / `else if (…)`: as the whole
    // condition … or as a parenthesized operand of the condition" (§50.2.3: "the
    // root wrapped in its own `(…)` … or a parenthesized operand"). The kept
    // places: the head's root, and — through the operators — an operand of a
    // unary or binary operator of the condition (`((m = f(s)) is given)`,
    // `((n = next()) > 0 && ok)`). A parenthesized assignment there is marked
    // `kept`; anything else (unparenthesized, an argument, a ternary arm, a
    // member's object, inside a kept assignment's own value) stays a value
    // position — E-ASSIGN-POSITION (analyze resolveValueAssign).
    fn keptHead(e: AExpr) -> AExpr {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v, paren: p) :> keptAssign(e, t, v, p)
            .Unary(op: o, e: x) :> { nid: e.nid, span: e.span, k: AExprK.Unary(o, keptHead(x)) }
            .Binary(op: o, l: l, r: r) :> { nid: e.nid, span: e.span, k: AExprK.Binary(o, keptHead(l), keptHead(r)) }
            .Str(v: x) :> e
            .Name(name: x) :> e
            .At(name: x) :> e
            .AtItem :> e
            .Num(raw: x) :> e
            .Bool(v: x) :> e
            .NotLit :> e
            .Recovered :> e
            .Variant(name: x) :> e
            .Member(obj: x) :> e
            .Call(callee: x) :> e
            .Ternary(test: x) :> e
            .ArrayLit(elems: x) :> e
            .ObjectLit(props: x) :> e
            .Spread(e: x) :> e
            .Index(obj: x) :> e
            .Lambda(params: x) :> e
            .BlockLambda(params: x) :> e
            .Sql(q: x) :> e
            .Handled(h: x) :> e
            .Template(quasis: x) :> e
            .HashRef(id: hr0) :> e
            .Foreign(f: x) :> e
        }
    }

    fn keptAssign(e: AExpr, t: AExpr, v: AExpr, paren: boolean) -> AExpr {
        if (!paren) return e
        return { nid: e.nid, span: e.span, k: AExprK.Assign(t, v, true, true) }
    }

    fn parseIf(tp: TP) -> RStmt {
        return parseIfAs(tp)
    }

    fn parseIfAs(tp: TP) -> RStmt {
        const start: int = cur(tp).start
        let t: TP = expectP(adv(tp), "(")
        const cond0: RExpr = sqlInCondition(t.diags.length, parseAssign(t))   // s479: §34 E-SQL-QUERY-NOT-READABLE
        const cond: RExpr = { e: keptHead(cond0.e), tp: cond0.tp }   // s474 (§50, D10)
        t = expectP(cond.tp, ")")
        const thenB: RBlock = parseBlockOrStmt(t)
        t = thenB.tp
        if (isWord(t, "else")) {
            t = adv(t)
            if (isWord(t, "if")) {
                const inner: RStmt = parseIfAs(t)
                const eb: ABlock = { nid: inner.tp.nid, span: inner.s.span, stmts: [inner.s] }
                return mkS(bumpId(inner.tp), start, AStmtK.If(cond.e, thenB.b, eb, IfForm.Written))
            }
            const elseB: RBlock = parseBlockOrStmt(t)
            return mkS(elseB.tp, start, AStmtK.If(cond.e, thenB.b, elseB.b, IfForm.Written))
        }
        return mkS(t, start, AStmtK.If(cond.e, thenB.b, not, IfForm.Written))
    }

    // =========================================================================
    // s475 — THE VALUE `if` (§17.6 if-as-expression; §17.6.10 the value form).
    //
    //   if-as-expr ::= 'if' '(' condition ')' arm-body
    //                  ('else' 'if' '(' condition ')' arm-body)* ('else' arm-body)?
    //   arm-body   ::= '{' statement* lift-stmt statement* '}'
    //               |  '{' expression '}'   -- "value-form sugar for `{ lift expression }`"
    //
    // §17.6.2: "An if-as-expression arm body SHALL produce its result value via a
    // `lift` statement, or by being exactly one expression, which is sugar for
    // `lift` of that expression (§17.6.10)"; "The result of an if-as-expression
    // when no arm body executes SHALL be `not`"; its type is the union of the
    // lifted types (`T | not` without an `else`). RULED S469 (§17.6.10, "Keep
    // { e }, lift once a statement"): "A braced value-form `if` branch holding
    // ONE expression is that expression. Once the branch holds a statement, it
    // must `lift` … a bare tail is E-ARM-TAIL-VALUE."
    //
    // BUILT: every branch that is ONE value — `{ e }`, `{ e; }` or `{ lift e; }`
    // (a nested value `if` included) — as the choice AExprK.Ternary(…, viaIf =
    // true): §17.6.8 "For simple single-lift arms, the compiler MAY optimize to a
    // JavaScript ternary … (valid when arms contain only lift)". `else if` is a
    // nested choice in `no`; a missing `else` is `not` (§17.6.4). The choice's
    // union typing, the narrowing of each branch by the condition, the condition
    // rule (E-COND-NOT-BOOLEAN), reactivity in markup and the lowering are the
    // ternary's (resolveTernary / typeTernary / lower boolMatch).
    //
    // NOT BUILT (INTERIM, refused by name, E-BOOTSTRAP-UNSUPPORTED): a branch
    // that holds statements before its `lift` (or yields on only some paths, or
    // is empty) — Core's choice holds one expression per branch, as Core's
    // `match` arm does (analyze plainValueBlock refuses the same shape for a
    // `match`). The capable form: an expression kind for the value `if` lowered
    // assign-in-branches (§17.6.8's preferred form), with W-LIFT-001 for a
    // lift-less branch. Two shapes of such a branch are errors whatever is
    // built, and are reported by their own codes: a bare tail after a statement
    // (E-ARM-TAIL-VALUE) and a second `lift` on the branch's path (E-LIFT-002).
    // =========================================================================
    // `bareOk`: the head may be written without its parentheses — only for the
    // sole content of a markup `${ … }` (§17.6.10 `value-form-if ::= 'if'
    // condition '{' expression '}'`), and the `else if`s and nested value `if`s
    // of that one.
    fn parseValueIfExpr(tp: TP, bareOk: boolean) -> RExpr {
        const start: int = cur(tp).start
        let t: TP = adv(tp)
        let cond: AExpr = mkE(t, start, AExprK.Recovered).e
        if (bareOk && bareHeadAt(t)) {
            const cb: RExpr = parseTernary(t)
            cond = cb.e
            t = cb.tp
        } else {
            t = bumpId(expectP(t, "("))
            const c0: RExpr = sqlInCondition(t.diags.length, parseAssign(t))   // s479: §34 E-SQL-QUERY-NOT-READABLE
            cond = keptHead(c0.e)                                       // s474 (§50, D10): `if (…)` is a condition head
            t = expectP(c0.tp, ")")
        }
        const yes: RExpr = parseValueBranchExpr(t, bareOk)
        t = yes.tp
        const nl: RExpr = mkE(t, start, AExprK.NotLit)                  // §17.6.4: no `else` — the false path is `not`
        let no: AExpr = nl.e
        t = nl.tp
        if (isWord(t, "else")) {
            t = adv(t)
            if (isWord(t, "if")) {
                const inner: RExpr = parseValueIfExpr(t, bareOk)
                no = inner.e
                t = inner.tp
            } else {
                const eb: RExpr = parseValueBranchExpr(t, bareOk)
                no = eb.e
                t = eb.tp
            }
        }
        return mkE(t, start, AExprK.Ternary(cond, yes.e, no, true, false))
    }

    // s475 (#1762 review item 2) — at the token after `if`: is the head a BARE
    // condition (§17.6.10 `value-form-if ::= 'if' condition '{' …`)? Yes when it
    // does not start with `(`, and when it does but no `{` follows the matching
    // `)` — the parentheses are then part of the condition (`(@ok) && @n > 0`),
    // not the head's own (§17.6.1 `'if' '(' condition ')' arm-body`).
    fn bareHeadAt(tp: TP) -> boolean {
        if (!isP(tp, "(")) return true
        return !isP(skipParens(tp), "{")
    }

    // One branch of a value `if`: its value, or a Recovered placeholder for a
    // refused / erroneous branch (the report made here).
    fn parseValueBranchExpr(tp: TP, bareOk: boolean) -> RExpr {
        const start: int = cur(tp).start
        if (!isP(tp, "{")) {
            // §17.6.1: every branch of an if-as-expression is braced (`arm-body ::=
            // '{' … '}'`). Read past as one expression (so the `else` that may
            // follow is still the value `if`'s).
            const d: TP = diagAt(tp, "E-PARSE-EXPECTED", "expected `{` to open a branch of an `if` used as a value, found `" + cur(tp).text + "` — every branch of a value `if` is braced (§17.6.1 `arm-body ::= '{' … '}'`): `if (c) { a } else { b }`", cur(tp))
            const rx: RExpr = parseAssign(d)
            return mkE(rx.tp, start, AExprK.Recovered)
        }
        // A branch whose content is itself a value `if` (`{ if (d) { a } else { b } }`):
        // that `if` is the branch's ONE expression (§17.6.2: an arm body "that is
        // exactly one expression"). Taken only when the whole brace is that `if`
        // (an optional `;`, then `}`) and it read without an error; otherwise the
        // brace is read as statements below (a statement `if` among others).
        if (isWord(adv(tp), "if")) {
            const h0: int = hardErrors(tp.diags)
            const inner: RExpr = parseValueIfExpr(adv(tp), bareOk)
            let ti: TP = inner.tp
            if (isP(ti, ";")) ti = adv(ti)
            if (isP(ti, "}") && hardErrors(ti.diags) == h0) return { e: inner.e, tp: adv(ti) }
        }
        const hb: int = hardErrors(tp.diags)
        const rb: RArmBlock = parseArmBlock(tp)
        const ss: AStmt[] = rb.b.stmts
        if (ss.length == 1) {
            // `{ e }`, `{ e; }`, `{ lift e; }` — the branch's one value
            const x: AExpr | not = stmtExpr(ss[0])
            if (x is given) return { e: x, tp: rb.tp }
        }
        let t: TP = rb.tp
        // a branch that did not parse (markup as a value — not in the bootstrap,
        // g-boot-markup-as-value-unbuilt-s473 — or any other parse error) is judged
        // by nothing more: its shape is the parse error's artefact
        if (hardErrors(t.diags) > hb) return mkE(t, start, AExprK.Recovered)
        const line: int = cur(tp).line
        const dl: AStmt | not = directLiftBefore(ss)
        const vt: AExpr | not = valueTail(ss)
        if (rb.lifted && dl is given) {
            t = diagAt(t, "E-LIFT-002", "a second `lift` on the same path of one branch of an `if` used as a value — a branch yields exactly one value (§17.6.9 Example 6); keep the one `lift` that designates the branch's value", spanTok(dl.span, line))
        } else if (!rb.lifted && vt is given) {
            t = diagAt(t, "E-ARM-TAIL-VALUE", "a branch of an `if` used as a value holds a statement and ends in a bare expression — once a branch holds a statement it yields its value with `lift` (§17.6.10, ruled S469: \"Keep { e }, lift once a statement\"; §18.5); write `lift <expr>;` as its last statement", spanTok(vt.span, line))
        } else {
            t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", valueBranchReason(ss.length, rb.lifted), spanTok(rb.b.span, line))
        }
        return mkE(t, start, AExprK.Recovered)
    }

    // A stand-in token at `sp` — where a report made after the fact lands.
    fn spanTok(sp: ASpan, line: int) -> PTok {
        return { cls: TC.Other, v: "", text: "", start: sp.start, end: sp.end, line: line, bad: "" }
    }

    // INTERIM (capable form: an expression kind for the value `if`, lowered
    // assign-in-branches, §17.6.8; W-LIFT-001 for a lift-less branch).
    fn valueBranchReason(n: int, lifted: boolean) -> string {
        if (n == 0) return "an empty branch of an `if` used as a value (it yields `not` and owes W-LIFT-001, §17.6.2) is not in the bootstrap yet — write the value: `{ not }`"
        if (lifted) return "a branch of an `if` used as a value that holds statements before its `lift` is not in the bootstrap yet — the bootstrap builds a branch that is ONE value, `{ e }` or `{ lift e; }` (§17.6.8's single-lift form); compute the value before the `if` (or in a function) and make the branch `{ value }`, or use a statement `if` and write the result in each branch"
        return "a branch of an `if` used as a value that does not end in its `lift` (a `lift` on only some paths, or none — §17.6.2, W-LIFT-001) is not in the bootstrap yet — the bootstrap builds a branch that is ONE value, `{ e }` or `{ lift e; }`; compute the value before the `if` (or in a function), or use a statement `if`"
    }

    // A `lift` written directly in a branch before its last statement (the last
    // is the designating one): E-LIFT-002's second `lift` on one path.
    fn directLiftBefore(ss: AStmt[]) -> AStmt | not {
        let i: int = 0
        while (i < ss.length - 1) {
            const k: AStmtK = ss[i].k
            if (k is .Lift) return ss[i]
            i = i + 1
        }
        return not
    }

    // The bare tail of a branch that holds a statement: its last statement as a
    // value expression, else not — a write (an assignment) is a statement, never
    // the branch's value (analyze bareTail's rule).
    fn valueTail(ss: AStmt[]) -> AExpr | not {
        if (ss.length < 2) return not
        const x: AExpr | not = stmtExpr(ss[ss.length - 1])
        if (x is not) return not
        const k: AExprK = x.k
        if (k is .Assign) return not
        return x
    }

    // `if (c) stmt` without braces is one statement in a block of its own.
    // s451: a `defer` there is marked `bare` (§19.16.2 — no written block).
    fn parseBlockOrStmt(tp: TP) -> RBlock {
        if (isP(tp, "{")) return parseBlock(tp)
        const start: int = cur(tp).start
        if (destructDeclAhead(tp)) {
            const rd: RStmts = parseTermStmts(tp, hardErrors(tp.diags))
            const bd: ABlock = { nid: rd.tp.nid, span: spanFrom(rd.tp, start), stmts: rd.ss }
            return { b: bd, tp: bumpId(rd.tp) }
        }
        const s: RStmt = parseTermStmt(tp, hardErrors(tp.diags))
        const b: ABlock = { nid: s.tp.nid, span: spanFrom(s.tp, start), stmts: [bareDefer(s.s)] }
        return { b: b, tp: bumpId(s.tp) }
    }

    fn bareDefer(s: AStmt) -> AStmt {
        const k: AStmtK = s.k
        return match k {
            .Defer(body: b, arrayLead: a) :> withStmtK(s, AStmtK.Defer(b, a, true))
            .Eval(e: e) :> s
            .Local(name: n) :> s
            .Return(e: e) :> s
            .If(cond: c) :> s
            .Given(name: n) :> s
            .EffectStmt(w: w) :> s
            .Fail(f: x) :> s
            .For(f: x) :> s
            .Break(label: x) :> s
            .Continue(label: x) :> s
            .Lift(what: x) :> s
            .LocalFn(f: x) :> s
        }
    }

    fn withStmtK(s: AStmt, k: AStmtK) -> AStmt {
        return { nid: s.nid, span: s.span, k: k }
    }

    // =========================================================================
    // s451 — `defer` (SPEC §19.16.1). A CONTEXTUAL keyword: it opens a defer
    // statement "ONLY at statement start, and ONLY when the next token is on
    // the same source line and can begin a statement — an identifier (other
    // than the word operators `or`/`and`), an `@`-cell, a `?{}` block, a `{`,
    // a `[` SEPARATED from `defer` by whitespace …, or a statement keyword
    // other than `is`/`as`/`of`/`in`/`instanceof`/`else`/`from`/`extends`/
    // `case`/`catch`/`finally`/`default`. Everywhere else `defer` is an
    // ordinary identifier".
    //   defer-stmt    ::= 'defer' deferred-body
    //   deferred-body ::= statement | '{' statement* '}'
    // =========================================================================
    //
    // s469 (§7.2.2 rule 10, RULED "Keyword at statement start"): "regardless of
    // line" — the next token may stand on the next line (a line break is
    // whitespace): `defer⏎    close(h);` defers `close(h);`. The same-line
    // condition quoted above is superseded; the token list is unchanged.
    fn deferAhead(tp: TP) -> boolean {
        const t: PTok = cur(tp)
        if (t.cls != TC.Ident || t.v != "defer") return false
        const nx: PTok = peekAt(tp, 1)
        if (nx.cls == TC.End) return false
        if (nx.cls == TC.Ident) return nx.v != "or" && nx.v != "and"
        if (nx.cls == TC.At) return true
        if (nx.cls == TC.Keyword) return !deferNonLead(nx.v)
        if (nx.cls != TC.Punct) return false
        if (tk(nx, "{")) return true
        if (tk(nx, "[")) return !touching(t, nx)
        if (tk(nx, "?")) {
            const n2: PTok = peekAt(tp, 2)
            return n2.cls == TC.Punct && tk(n2, "{") && touching(nx, n2)
        }
        return false
    }

    fn deferNonLead(w: string) -> boolean {
        return ["is", "as", "of", "in", "instanceof", "else", "from", "extends", "case", "catch", "finally", "default"].indexOf(w) >= 0
    }

    // At `defer` (deferAhead said it opens a statement).
    fn parseDefer(tp: TP) -> RStmt {
        const start: int = cur(tp).start
        const t: TP = adv(tp)
        if (isP(t, "{")) {
            const rb: RBlock = parseBlock(t)
            return mkS(rb.tp, start, AStmtK.Defer(rb.b, false, false))
        }
        const arrayLead: boolean = isP(t, "[")
        const bodyStart: int = cur(t).start
        if (destructDeclAhead(t)) {
            const rd: RStmts = parseTermStmts(t, hardErrors(t.diags))
            const bd: ABlock = { nid: rd.tp.nid, span: spanFrom(rd.tp, bodyStart), stmts: rd.ss }
            return mkS(bumpId(rd.tp), start, AStmtK.Defer(bd, false, false))
        }
        const r: RStmt = parseTermStmt(t, hardErrors(t.diags))
        const b: ABlock = { nid: r.tp.nid, span: spanFrom(r.tp, bodyStart), stmts: [r.s] }
        return mkS(bumpId(r.tp), start, AStmtK.Defer(b, arrayLead, false))
    }

    // s451 (Ue) — `fail` (§19.3.1 `fail-stmt ::= 'fail' enum-type? ('.' |
    // '::') variant-name ('(' arg-list ')')?`). s469 (§7.2.2 rule 10, RULED
    // "Keyword at statement start"): at the start of a statement `fail` is the
    // keyword whenever the next token can begin its operand — a variant, a
    // name (the enum type), `.` or `::` (and, kept from s451, a keyword /
    // string / number, for analyze's E-ERROR-009) — on its line or the next
    // (a line break is whitespace: `fail⏎.NotFound;` is `fail .NotFound;`).
    // The bare name `fail` is reserved in statement position: anything else
    // after it is refused (parseStmt, `bareFail`), never read as a name.
    fn failAhead(tp: TP) -> boolean {
        if (!isWord(tp, "fail")) return false
        const nx: PTok = peekAt(tp, 1)
        if (nx.cls == TC.End) return false
        if (nx.cls == TC.Variant || nx.cls == TC.Ident) return true
        // a keyword / string / number cannot begin a valid operand: read as one only
        // on `fail`'s own line (s451's E-ERROR-009 path, unchanged) — on a later line
        // it starts the next statement, and this `fail` has no operand (`bareFail`)
        if (nx.cls == TC.Keyword || nx.cls == TC.Str || nx.cls == TC.Num) return nx.line == cur(tp).line
        if (nx.cls != TC.Punct) return false
        if (tk(nx, ".")) return true
        const n2: PTok = peekAt(tp, 2)
        return tk(nx, ":") && n2.cls == TC.Punct && tk(n2, ":") && touching(nx, n2)
    }

    // s469 (§7.2.2 rule 10): `fail` at statement start with no operand after it
    // (`fail;`, `fail = 1`, `fail(x)`, `fail` before a `}`) — the name is
    // reserved there, so this is a `fail` missing its variant: E-PARSE-EXPECTED
    // (never the misleading E-SCOPE-001 "`fail` is not declared"). The rest of
    // the statement is read past as one recovered expression (no cascade).
    fn bareFail(tp: TP) -> RStmt {
        const f: PTok = cur(tp)
        const start: int = f.start
        const nx: PTok = peekAt(tp, 1)
        let found: string = "`" + nx.text + "`"
        if (nx.cls == TC.End) found = "the end of the block"
        const d: TP = diagAt(tp, "E-PARSE-EXPECTED", "expected the failure after `fail` (`fail .Variant;`, `fail ErrorType.Variant(…);`, §19.3.1), found " + found + " — at the start of a statement `fail` is the keyword, and the name `fail` is reserved there (§7.2.2 rule 10)", f)
        if (nx.cls == TC.End || tk(nx, ";") || tk(nx, "}")) {
            const re: RExpr = mkE(adv(d), start, AExprK.Recovered)
            return mkS(re.tp, start, AStmtK.Eval(re.e))
        }
        const rv: RExpr = parseAssign(d)
        const rr: RExpr = mkE(rv.tp, start, AExprK.Recovered)
        return mkS(rr.tp, start, AStmtK.Eval(rr.e))
    }

    fn isNameTok(x: PTok) -> boolean { return x.cls == TC.Ident || x.cls == TC.Keyword }

    fn parseFail(tp: TP) -> RStmt {
        const start: int = cur(tp).start
        const t: TP = adv(tp)
        const a: PTok = cur(t)
        const b: PTok = peekAt(t, 1)
        const c: PTok = peekAt(t, 2)
        // s469 (§7.2.2 rule 10): the operand was read from a later line (analyze notes it on E-ERROR-009)
        const split: boolean = a.line != endLine(cur(tp))
        if (a.cls == TC.Variant) return failArgs(adv(t), start, "", a, split)
        if (a.cls == TC.Punct && tk(a, ".") && isNameTok(b) && touching(a, b)) return failArgs(adv(adv(t)), start, "", b, split)
        if (a.cls == TC.Punct && tk(a, ":") && tk(b, ":") && touching(a, b) && isNameTok(c) && touching(b, c)) return failArgs(adv(adv(adv(t))), start, "", c, split)
        // s475 r1: `fail m.E.V` — a namespace import's member enum
        const fh: NsHead = nsHeadAt(t, 0)
        if (fh.n > 0) {
            const fd: PTok = peekAt(t, 3)
            const fv: PTok = peekAt(t, 4)
            if (fd.cls == TC.Punct && tk(fd, ".") && isNameTok(fv) && touching(c, fd) && touching(fd, fv)) return failArgs(adv(adv(adv(adv(adv(t))))), start, fh.name, fv, split)
        }
        if (a.cls == TC.Ident && b.cls == TC.Punct && tk(b, ".") && isNameTok(c) && touching(a, b) && touching(b, c)) return failArgs(adv(adv(adv(t))), start, a.v, c, split)
        if (a.cls == TC.Ident && tk(b, ":") && tk(c, ":") && touching(a, b) && touching(b, c)) {
            const d: PTok = peekAt(t, 3)
            if (isNameTok(d) && touching(c, d)) return failArgs(adv(adv(adv(adv(t)))), start, a.v, d, split)
        }
        // not a variant (`fail "x"`): kept, so analyze reports E-ERROR-009
        const r: RExpr = parseAssign(t)
        return mkS(r.tp, start, AStmtK.Fail({ enumName: "", variant: "", args: [], target: r.e, split: split }))
    }

    // After the variant name: its payload `(args)`, when written touching it.
    fn failArgs(tp: TP, start: int, enumName: string, vtok: PTok, split: boolean) -> RStmt {
        let t: TP = tp
        let args: AExpr[] = []
        const o: PTok = cur(t)
        if (o.cls == TC.Punct && tk(o, "(") && touching(vtok, o)) {
            const r: RExprs = parseList(adv(t), ")")
            args = r.es
            t = r.tp
        }
        return mkS(t, start, AStmtK.Fail({ enumName: enumName, variant: vtok.v, args: args, target: not, split: split }))
    }

    // `given c = @h :> { … }` (§66.7.5) — and, when no `=` follows the first
    // name, the soft-deprecated in-place presence guard (§42.2.3, S462).
    fn parseGiven(tp: TP) -> RStmt {
        const start: int = cur(tp).start
        if (!givenRebindAhead(tp)) return parseGivenPresence(tp)
        let t: TP = adv(tp)
        const nameTok: PTok = cur(t)
        if (nameTok.cls != TC.Ident) t = diagAt(t, "E-PARSE-GIVEN", "expected a name after `given`", nameTok)
        t = expectP(adv(t), "=")
        const subj: RExpr = parseTernary(t)
        t = subj.tp
        const c: PTok = cur(t)
        const g: PTok = peekAt(t, 1)
        if (tk(c, ":") && tk(g, ">") && touching(c, g)) {
            t = adv(adv(t))
        } else {
            t = diagAt(t, "E-PARSE-GIVEN", "expected `:>` after the `given` subject", c)
        }
        const body: RBlock = parseBlock(t)
        return mkS(body.tp, start, AStmtK.Given(nameTok.v, subj.e, body.b))
    }

    // At `given`: does a `=` follow the first name (`given c = …`, the §66.7.5
    // rebind head)? A name is `x` or `@x`.
    fn givenRebindAhead(tp: TP) -> boolean {
        let t: TP = adv(tp)
        if (cur(t).cls == TC.At) t = adv(t)
        return isP(adv(t), "=")
    }

    // s462 — the in-place presence guard `given x[, y]* :> { … }` (§42.2.3),
    // SOFT-DEPRECATED (§63.1 Stage 1): read as `if (x is given && …) { … }`,
    // the form it lowers and narrows as (§42.5, §42.4 statement 8), and surface
    // W-GIVEN-PRESENCE-DEPRECATED (Info, one per guard). The legacy `=>`
    // separator is read like `:>`. A lint only — the guard is otherwise unchanged.
    fn parseGivenPresence(tp: TP) -> RStmt {
        const start: int = cur(tp).start
        let t: TP = adv(tp)
        let cond: AExpr | not = not
        let names: string = ""
        let tests: string = ""
        let bad: boolean = false
        const headLine: int = cur(tp).line
        let going: boolean = true
        while (going) {
            const nameTok: PTok = cur(t)
            let n: RExpr | not = not
            let written: string = nameTok.v
            if (nameTok.cls == TC.At) {
                written = "@" + peekAt(t, 1).v
                n = parseAt(t)
            } else if (nameTok.cls == TC.Ident) {
                n = mkE(adv(t), nameTok.start, AExprK.Name(nameTok.v))
            }
            if (n is given) {
                const test: RExpr = mkE(n.tp, nameTok.start, AExprK.Unary(UnOp.IsGiven, n.e))
                t = test.tp
                if (names != "") {
                    names = names + ", "
                    tests = tests + " && "
                }
                names = names + written
                tests = tests + written + " is given"
                if (cond is given) {
                    const both: RExpr = mkE(t, start, AExprK.Binary(BinOp.And, cond, test.e))
                    cond = both.e
                    t = both.tp
                } else {
                    cond = test.e
                }
                if (isP(t, ",")) {
                    t = adv(t)
                } else {
                    going = false
                }
            } else {
                bad = true
                going = false
            }
        }
        // s462 "a" — §42.2.3: "A `given` head SHALL contain only an identifier-list."
        // Anything else before the `:>` (a comparison, a call, no name, no separator)
        // is E-SYNTAX-044; the rest of the head on its line is skipped.
        let c: PTok = cur(t)
        let g: PTok = peekAt(t, 1)
        let sepEnd: int = c.end
        let sepFound: boolean = (tk(c, ":") && tk(g, ">") && touching(c, g)) || tk(c, "=>")
        if (bad || !sepFound) {
            bad = true
            let found: string = "the end of the line"
            if (c.line == headLine && c.cls != TC.End) found = "`" + c.text + "`"
            t = diagAt(t, "E-SYNTAX-044", "a `given` head is a list of names followed by `:>` (`given x, y :> { … }`, §42.2.3); found " + found + " instead. To run code when a condition holds, write `if (<cond>) { … }`; to run it when a value is present, write `if (x is given) { … }`.", c)
            let skipping: boolean = true
            while (skipping) {
                c = cur(t)
                g = peekAt(t, 1)
                sepFound = (tk(c, ":") && tk(g, ">") && touching(c, g)) || tk(c, "=>")
                if (c.cls == TC.End || c.line != headLine || isP(t, "{") || sepFound) {
                    skipping = false
                } else {
                    t = adv(t)
                }
            }
        }
        if (sepFound) {
            if (tk(c, "=>")) {
                t = adv(t)
            } else {
                sepEnd = g.end
                t = adv(adv(t))
            }
        }
        if (!bad && !isP(t, "{")) {
            // s462 fix round 1 — a guard body is a `{ … }` block (§42.2.3 grammar); without braces
            // the body would run whether or not the names are present.
            bad = true
            const bt: PTok = cur(t)
            let bfound: string = "the end of the line"
            if (bt.line == headLine && bt.cls != TC.End) bfound = "`" + bt.text + "`"
            t = diagAt(t, "E-SYNTAX-044", "a `given` guard must be `given <names> :> { … }` — its body is a `{ … }` block (§42.2.3); found " + bfound + " after `:>`. Without the braces the body would run whether or not the names are present. Write `if (" + tests + ") { … }`.", bt)
        }
        if (bad && !isP(t, "{")) {
            // A refused head with no block: nothing to guard; the line's rest parses on.
            const empty: ABlock = { nid: t.nid, span: mkSpan(start, start), stmts: [] }
            const none0: RExpr = mkE(bumpId(t), start, AExprK.NotLit)
            return mkS(none0.tp, start, AStmtK.If(none0.e, empty, not, IfForm.Written))
        }
        if (names != "" && !bad) {
            const msg: string = "the presence guard `given " + names + " :> { … }` is deprecated (§42.2.3). Write `if (" + tests + ") { … }` — it tests the same thing and narrows the same names inside the block. Run `scrml fix` to rewrite it. It compiles as before during the deprecation window (§63)."
            const d: Diag = newDiag("W-GIVEN-PRESENCE-DEPRECATED", msg, t.file, mkSpan(start, sepEnd))
            t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d]), file: t.file, ns: t.ns, inFn: t.inFn }
        }
        const body: RBlock = parseBlock(t)
        if (cond is given && !bad) return mkS(body.tp, start, AStmtK.If(cond, body.b, not, IfForm.Written))
        // A refused head (E-SYNTAX-044 above): keep the block, under a test that never holds.
        const none: RExpr = mkE(body.tp, start, AExprK.NotLit)
        return mkS(none.tp, start, AStmtK.If(none.e, body.b, not, IfForm.Written))
    }

    // =========================================================================
    // Types (in logic): `Name`, `T[]`, `T[g1, g2]`, `T | not`.
    // =========================================================================
    fn mkT(tp: TP, start: int, k: ATypeK) -> RType {
        const ty: AType = { nid: tp.nid, span: spanFrom(tp, start), k: k }
        return { t: ty, tp: bumpId(tp) }
    }

    fn parseType(tp: TP) -> RType {
        return parseTypeAt(tp, false)
    }

    // s478 — `own`: the caller judges the zone of a refinement at the type's TOP
    // (parseLocal — a fixed local with a literal value is the static zone, §53.4.2);
    // every other refinement, and every one when `own` is false, is the boundary
    // zone here and refused by name (refuseRefineIn, INTERIM).
    fn parseTypeAt(tp: TP, own: boolean) -> RType {
        const r0: RType = parseTypeBody(tp)
        if (own && standingRefine(r0.t)) return r0
        return { t: r0.t, tp: refuseRefineIn(r0.tp, r0.t, "stands where a value reaches it unproven (a parameter, a return type, a struct or variant field, a tape element, a `| not` member, a `let` local)") }
    }

    fn parseTypeBody(tp: TP) -> RType {
        const start: int = cur(tp).start
        const nameTok: PTok = cur(tp)
        if (lifeAhead(tp)) return parseLifeType(tp)
        if (fnTypeAhead(tp)) return parseFnType(tp, start, false, false)        // s478 (s478-boot-fn-type)
        // s478-ruled-fn-types — §7.5 "Function types (S478)": `fn (x: T) => R`, the pure function
        // type; and the two retired spellings, `(…) -> R` and `fn(…)` with no `=>`, which are
        // E-PARSE-TYPE naming the `=>` fix (read whole, so nothing cascades)
        if (isWord(tp, "fn") && fnTypeAhead(adv(tp))) return parseFnType(adv(tp), start, true, false)
        if (thinFnTypeAhead(tp)) return parseFnType(tp, start, false, true)
        if (isWord(tp, "fn") && isP(adv(tp), "(")) return parseRetiredFnKw(tp, start)
        let t: TP = tp
        if (nameTok.cls != TC.Ident && nameTok.cls != TC.Keyword) {
            t = diagAt(t, "E-PARSE-TYPE", "expected a type, found `" + nameTok.text + "`", nameTok)
        }
        // s475 r1: `m.T` — a namespace import's member type (no value shadows a type)
        const nh: NsHead = nsHeadAt(t, 0)
        let r: RType = mkT(adv(t), start, ATypeK.TName(nameTok.v))
        if (nh.n > 0) r = mkT(adv(adv(adv(t))), start, ATypeK.TName(nh.name))
        // s478 — a refinement `base(pred)` (§53.2.1), its `(` touching the base name
        if (nh.n == 0 && refinableBase(nameTok.v) && isP(r.tp, "(") && touching(nameTok, cur(r.tp))) {
            r = parseRefine(r.tp, start, r.t)
        }
        while (isP(r.tp, "[")) {
            let g: TP = adv(r.tp)
            let grants: string[] = []
            // s475 r1 (#1812 review F3): a bounded length (`1..=3`, §66.12.2) — a run of tokens that
            // starts with a number, up to the next comma — is ONE grant word, as the attribute form
            // reads it (grantWords): never dropped, so `int[1..=3, append]` is judged by its bound,
            // not read as fixed. Other tokens are skipped as before (a refinement's `[.A, .B]` list
            // is read by its own form).
            let odd: string = ""
            while (!isP(g, "]") && !atEnd(g)) {
                const w: PTok = cur(g)
                if (w.cls == TC.Ident || w.cls == TC.Keyword) {
                    if (odd != "") grants = grants.concat([odd])
                    odd = ""
                    grants = grants.concat([w.v])
                } else if (isP(g, ",")) {
                    if (odd != "") grants = grants.concat([odd])
                    odd = ""
                } else if (odd != "" || w.cls == TC.Num) {
                    odd = odd + w.text
                }
                g = adv(g)
            }
            if (odd != "") grants = grants.concat([odd])
            g = expectP(g, "]")
            r = mkT(g, start, ATypeK.TSeq(r.t, grants))
        }
        if (isP(r.tp, "|") && isWord(adv(r.tp), "not")) {
            r = maybeType(adv(adv(r.tp)), start, tp.i, r.t)
        } else if (nameTok.v == "not" && isP(r.tp, "|")) {
            // s469 review r2: `not | T`, the same union written the other way round
            const rest: RType = parseTypeBody(adv(r.tp))
            r = maybeType(rest.tp, start, tp.i, rest.t)
        }
        return r
    }

    // =========================================================================
    // s478 (s478-boot-refinement) — refinement types `base(pred)` (§53).
    //
    // §53.2.1: `inline-predicate = base-type "(" predicate-expr ")"`, `base-type
    // = "number" | "string" | "int" | "integer" | "bool" | "boolean"`. A
    // refinement is READ in every type position (a code type here, an opener type
    // in openerTypeMember) and JUDGED where it is declared, whatever zone its value
    // is in (§53.11: "Both forms of E-CONTRACT-002 SHALL be emitted where the
    // refinement is declared, whatever zone its value is in"): a malformed
    // predicate or an unknown named shape is E-CONTRACT-002, a reference outside
    // the incoming value is E-CONTRACT-003. Its ZONE (§53.4) is then decided where
    // the value is known: a fixed declaration (`const x: T(p) = lit`, a top-level
    // `<x:T(p)=lit/>`) whose value is a literal is judged now — the static zone
    // (§53.4.2 rules 1-2): a literal that fails is E-CONTRACT-001. Every other
    // position is the boundary zone, where §53.11 requires a runtime check ("The
    // compiler SHALL emit a runtime check for every boundary-zone assignment that
    // it cannot statically elide"); the bootstrap does not build that check yet, so
    // it refuses the refinement by name (INTERIM, g-boot-refinement-runtime-checks-s478)
    // — never an annotation read without its check.
    // =========================================================================
    fn refinableBase(n: string) -> boolean {
        return n == "number" || n == "int" || n == "integer" || n == "string" || n == "bool" || n == "boolean"
    }

    fn numericBase(n: string) -> boolean {
        return n == "number" || n == "int" || n == "integer"
    }

    // §53.6.1 "The following shapes SHALL be defined in the initial release"
    fn builtinShape(n: string) -> boolean {
        return n == "email" || n == "url" || n == "uuid" || n == "phone" || n == "date" || n == "time" || n == "color"
    }

    // A predicate token: k = num · op · and · or · not · lp · rp · prop (`.name`) ·
    // ident · ext (`@name`) · str · bad · end.
    type RefTok:struct = { k: string, v: string }
    type RefPred:enum = {
        PCmp(op: string, n: number),       // `>0` — the value against a number
        PLen(op: string, n: number),       // `.length > 7`
        PShape(name: string),              // a named shape (§53.6)
        PAnd(l: RefPred, r: RefPred),
        POr(l: RefPred, r: RefPred),
        PNot(p: RefPred),
    }
    // A parse result: `code` "" (read) or the code of the first fault, `msg` its why.
    type RRef:struct = { p: RefPred, i: int, code: string, msg: string }
    type RefJudge:struct = { code: string, msg: string, p: RefPred }

    fn refToks(src: string) -> RefTok[] {
        let out: RefTok[] = []
        let i: int = 0
        while (i < src.length) {
            const c: string = src.charAt(i)
            const c2: string = src.substring(i, i + 2)
            if (c == " " || c == "\t" || c == "\n" || c == "\r") {
                i = i + 1
            } else if (c2 == "&&") {
                out = out.concat([{ k: "and", v: c2 }])
                i = i + 2
            } else if (c2 == "||") {
                out = out.concat([{ k: "or", v: c2 }])
                i = i + 2
            } else if (c2 == ">=" || c2 == "<=" || c2 == "==" || c2 == "!=") {
                out = out.concat([{ k: "op", v: c2 }])
                i = i + 2
            } else if (c == ">" || c == "<") {
                out = out.concat([{ k: "op", v: c }])
                i = i + 1
            } else if (c == "!") {
                out = out.concat([{ k: "not", v: c }])
                i = i + 1
            } else if (c == "(") {
                out = out.concat([{ k: "lp", v: c }])
                i = i + 1
            } else if (c == ")") {
                out = out.concat([{ k: "rp", v: c }])
                i = i + 1
            } else if (isDigitStr(c) || (c == "-" && isDigitStr(src.charAt(i + 1)))) {
                let j: int = i + 1
                while (j < src.length && (isDigitStr(src.charAt(j)) || src.charAt(j) == ".")) j = j + 1
                out = out.concat([{ k: "num", v: src.substring(i, j) }])
                i = j
            } else if ((c == "." || c == "@") && isIdentStartCh(src.charAt(i + 1))) {
                let j: int = i + 1
                while (j < src.length && isIdentCh(src.charAt(j))) j = j + 1
                let kind: string = "prop"
                if (c == "@") kind = "ext"
                out = out.concat([{ k: kind, v: src.substring(i + 1, j) }])
                i = j
            } else if (isIdentStartCh(c)) {
                let j: int = i + 1
                while (j < src.length && isIdentCh(src.charAt(j))) j = j + 1
                out = out.concat([{ k: "ident", v: src.substring(i, j) }])
                i = j
            } else if (c == "\"" || c == "'") {
                let j: int = i + 1
                while (j < src.length && src.charAt(j) != c) {
                    if (src.charAt(j) == "\\") j = j + 1
                    j = j + 1
                }
                if (j >= src.length) {
                    out = out.concat([{ k: "bad", v: "an unterminated string" }])
                    i = src.length
                } else {
                    out = out.concat([{ k: "str", v: src.substring(i + 1, j) }])
                    i = j + 1
                }
            } else {
                out = out.concat([{ k: "bad", v: "`" + c + "`" }])
                i = i + 1
            }
        }
        return out
    }

    fn refAt(ts: RefTok[], i: int) -> RefTok {
        if (i < ts.length) return ts[i]
        return { k: "end", v: "" }
    }

    fn refOk(p: RefPred, i: int) -> RRef { return { p: p, i: i, code: "", msg: "" } }

    fn refErr(i: int, code: string, msg: string) -> RRef {
        return { p: RefPred.PShape(""), i: i, code: code, msg: msg }
    }

    fn refOr(ts: RefTok[], i: int) -> RRef {
        let l: RRef = refAnd(ts, i)
        while (l.code == "" && refAt(ts, l.i).k == "or") {
            const r: RRef = refAnd(ts, l.i + 1)
            if (r.code != "") return r
            l = refOk(RefPred.POr(l.p, r.p), r.i)
        }
        return l
    }

    fn refAnd(ts: RefTok[], i: int) -> RRef {
        let l: RRef = refUnary(ts, i)
        while (l.code == "" && refAt(ts, l.i).k == "and") {
            const r: RRef = refUnary(ts, l.i + 1)
            if (r.code != "") return r
            l = refOk(RefPred.PAnd(l.p, r.p), r.i)
        }
        return l
    }

    fn refUnary(ts: RefTok[], i: int) -> RRef {
        const t: RefTok = refAt(ts, i)
        if (t.k == "not") {
            const r: RRef = refUnary(ts, i + 1)
            if (r.code != "") return r
            return refOk(RefPred.PNot(r.p), r.i)
        }
        if (t.k == "lp") {
            const r2: RRef = refOr(ts, i + 1)
            if (r2.code != "") return r2
            if (refAt(ts, r2.i).k != "rp") return refErr(r2.i, "E-CONTRACT-002", "an unclosed `(`")
            return refOk(r2.p, r2.i + 1)
        }
        return refSimple(ts, i)
    }

    // `lo < value < hi` reads as `value > lo && value < hi`: the operator seen from `value`.
    fn refFlip(op: string) -> string {
        if (op == "<") return ">"
        if (op == "<=") return ">="
        if (op == ">") return "<"
        if (op == ">=") return "<="
        return op
    }

    fn refExtMsg(name: string) -> string {
        return "EXT:" + name
    }

    // s478 (S239 review of #1888, LOW-2) — a bare name as an operand (`<=max`):
    // §53.2.1 "No external identifiers MAY appear — if they do, the compiler SHALL
    // emit `E-CONTRACT-003`"; §53.3.1 the predicate "SHALL NOT access … Any function
    // parameter or outer binding".
    fn refIdentMsg(name: string) -> string {
        return "IDENT:" + name
    }

    // s478 (S239 review of #1888, MED-2) — a number token (`[0-9.]` run) that is
    // not a number (`1.2.3`, `1..2`) is malformed: §53.11 "A malformed predicate
    // SHALL NOT be treated as an unrefined annotation" (E-CONTRACT-002), never NaN.
    fn refBadNum(v: string) -> boolean {
        return Number.isNaN(Number(v))
    }

    fn refBadNumMsg(v: string) -> string {
        return "`" + v + "` is not a numeric literal"
    }

    fn refSimple(ts: RefTok[], i: int) -> RRef {
        const t: RefTok = refAt(ts, i)
        if (t.k == "ext") return refErr(i, "E-CONTRACT-003", refExtMsg(t.v))
        if (t.k == "op") {
            const n: RefTok = refAt(ts, i + 1)
            if (n.k == "num" && refBadNum(n.v)) return refErr(i + 1, "E-CONTRACT-002", refBadNumMsg(n.v))
            if (n.k == "num") return refOk(RefPred.PCmp(t.v, Number(n.v)), i + 2)
            if (n.k == "ext") return refErr(i + 1, "E-CONTRACT-003", refExtMsg(n.v))
            if (n.k == "ident") return refErr(i + 1, "E-CONTRACT-003", refIdentMsg(n.v))
            return refErr(i + 1, "E-CONTRACT-002", "expected a number after `" + t.v + "`")
        }
        if (t.k == "prop") {
            const o: RefTok = refAt(ts, i + 1)
            const n2: RefTok = refAt(ts, i + 2)
            if (o.k == "op" && n2.k == "num" && refBadNum(n2.v)) return refErr(i + 2, "E-CONTRACT-002", refBadNumMsg(n2.v))
            if (o.k == "op" && n2.k == "num" && t.v == "length") return refOk(RefPred.PLen(o.v, Number(n2.v)), i + 3)
            if (o.k == "op" && n2.k == "ext") return refErr(i + 2, "E-CONTRACT-003", refExtMsg(n2.v))
            if (o.k == "op" && n2.k == "ident") return refErr(i + 2, "E-CONTRACT-003", refIdentMsg(n2.v))
            if (o.k == "op" && (n2.k == "num" || n2.k == "str")) return refErr(i, "E-BOOTSTRAP-UNSUPPORTED", "the property comparison `." + t.v + " " + o.v + " " + n2.v + "` (the bootstrap judges `.length` against a number)")
            return refErr(i + 1, "E-CONTRACT-002", "expected a comparison after `." + t.v + "`")
        }
        if (t.k == "ident") {
            if (refAt(ts, i + 1).k == "lp") return refErr(i, "E-BOOTSTRAP-UNSUPPORTED", "the call form `" + t.v + "(…)` inside a refinement's parentheses (§53.6.1 spells the shared validator vocabulary `base." + t.v + "(…)`)")
            if (t.v == "value") return refErr(i, "E-CONTRACT-002", "`value` stands only in the range form `lo < value < hi`")
            if (!builtinShape(t.v)) return refErr(i, "E-CONTRACT-002", "SHAPE:" + t.v)
            return refOk(RefPred.PShape(t.v), i + 1)
        }
        if (t.k == "num") {
            if (refBadNum(t.v)) return refErr(i, "E-CONTRACT-002", refBadNumMsg(t.v))
            const o1: RefTok = refAt(ts, i + 1)
            const vv: RefTok = refAt(ts, i + 2)
            const o2: RefTok = refAt(ts, i + 3)
            const hi: RefTok = refAt(ts, i + 4)
            if (o1.k == "op" && vv.k == "ident" && vv.v == "value" && o2.k == "op" && hi.k == "num" && refBadNum(hi.v)) return refErr(i + 4, "E-CONTRACT-002", refBadNumMsg(hi.v))
            if (o1.k == "op" && vv.k == "ident" && vv.v == "value" && o2.k == "op" && hi.k == "ident") return refErr(i + 4, "E-CONTRACT-003", refIdentMsg(hi.v))
            if (o1.k == "op" && vv.k == "ident" && vv.v == "value" && o2.k == "op" && hi.k == "num") {
                return refOk(RefPred.PAnd(RefPred.PCmp(refFlip(o1.v), Number(t.v)), RefPred.PCmp(o2.v, Number(hi.v))), i + 5)
            }
            return refErr(i, "E-CONTRACT-002", "a bare number `" + t.v + "` is not a predicate (write a comparison: `>" + t.v + "`)")
        }
        if (t.k == "end") return refErr(i, "E-CONTRACT-002", "the predicate ends where a comparison or a shape is expected")
        if (t.k == "bad") return refErr(i, "E-CONTRACT-002", "an unexpected " + t.v)
        return refErr(i, "E-CONTRACT-002", "an unexpected `" + t.v + "`")
    }

    // Does each part of `p` fit the base type? A comparison judges a number; a
    // `.length` comparison and a named shape judge a string (§53.6.1 "Base type").
    fn refFits(p: RefPred, base: string) -> boolean {
        return match p {
            .PCmp(op: o) :> numericBase(base)
            .PLen(op: o) :> base == "string"
            .PShape(name: n) :> base == "string"
            .PAnd(l: a, r: b) :> refFits(a, base) && refFits(b, base)
            .POr(l: a, r: b) :> refFits(a, base) && refFits(b, base)
            .PNot(p: x) :> refFits(x, base)
        }
    }

    // The judgement of `base(pred)` where it is declared: `code` "" (the refinement
    // stands), E-CONTRACT-002 / -003 (§53.11), or E-BOOTSTRAP-UNSUPPORTED (a form
    // the grammar or impl#1 reads that the bootstrap does not judge).
    fn judgeRefine(base: string, pred: string) -> RefJudge {
        const shown: string = base + "(" + pred + ")"
        const ts: RefTok[] = refToks(pred)
        let r: RRef = refOr(ts, 0)
        if (r.code == "" && r.i < ts.length) r = refErr(r.i, "E-CONTRACT-002", "text is left over after the predicate, at `" + refAt(ts, r.i).v + "`")
        if (r.code == "E-CONTRACT-003" && r.msg.substring(0, 6) == "IDENT:") {
            const nm2: string = r.msg.substring(6)
            return { code: r.code, p: r.p, msg: "the inline predicate `" + shown + "` references the name `" + nm2 + "` — an inline predicate is stateless: its only subject is the incoming value (§53.2.1: \"No external identifiers MAY appear — if they do, the compiler SHALL emit `E-CONTRACT-003`\"; §53.3.1: it SHALL NOT access \"Any function parameter or outer binding\"). Write the bound as a number literal (`" + base + "(<=100)`), or for a constraint on external state use a `<machine>` guard" }
        }
        if (r.code == "E-CONTRACT-003") {
            const nm: string = r.msg.substring(4)
            return { code: r.code, p: r.p, msg: "the inline predicate `" + shown + "` references `@" + nm + "` — an inline predicate is stateless: it may reference only the incoming value and its properties, not a reactive variable, a sibling field or an outer binding (§53.3.1, §53.11 E-CONTRACT-003). For a constraint on external state use a `<machine>` guard: `<machine name=Range for=" + base + "> { * => * given (value <= @" + nm + ") }`" }
        }
        if (r.code == "E-CONTRACT-002" && r.msg.substring(0, 6) == "SHAPE:") {
            return { code: r.code, p: r.p, msg: "the named shape `" + r.msg.substring(6) + "` in `" + shown + "` is not in the shape registry (§53.6.3: \"If a named shape identifier does not match any entry in the built-in or extended registry, the compiler SHALL emit E-CONTRACT-002\"). Built-in shapes: email, url, uuid, phone, date, time, color" }
        }
        if (r.code == "E-CONTRACT-002") {
            return { code: r.code, p: r.p, msg: "the inline predicate `" + shown + "` is malformed (" + r.msg + "), so it cannot be enforced — §53.11: \"A malformed predicate SHALL NOT be treated as an unrefined annotation\". The §53.2.1 grammar reads comparisons (`>0`, `<=100`), `lo < value < hi`, `.length` comparisons, a named shape (`email`), `!`, `&&`, `||` and parentheses" }
        }
        if (r.code != "") return { code: r.code, p: r.p, msg: "the refinement `" + shown + "` uses " + r.msg + " — not in the bootstrap (INTERIM)" }
        if (!refFits(r.p, base)) return { code: "E-BOOTSTRAP-UNSUPPORTED", p: r.p, msg: "the refinement `" + shown + "` — the bootstrap judges comparisons on `number` / `int` and `.length` comparisons or a named shape on `string` (INTERIM)" }
        return { code: "", msg: "", p: r.p }
    }

    // ---- the static zone: a literal judged now (§53.4.2 rules 1-2, T-PRED-1) ----
    // A literal value: `isStr` a string (`s`), else a number (`n`, `raw` as written).
    type RefLit:struct = { isStr: boolean, n: number, s: string, raw: string }

    fn refLitOf(e: AExpr) -> RefLit | not {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> { isStr: false, n: Number(r), s: "", raw: r }
            .Str(v: s) :> { isStr: true, n: 0, s: s, raw: "\"" + s + "\"" }
            .Unary(op: o, e: x) :> refNegLit(o, x)
            // no-default-arm: one question of the expression — is it a literal (§53.4.2); every other form is not one
            _ :> not
        }
    }

    fn refNegLit(o: UnOp, x: AExpr) -> RefLit | not {
        if (!isNegNum(o, x)) return not
        const inner: RefLit | not = refLitOf(x)
        if (inner is not) return not
        return { isStr: false, n: 0 - inner.n, s: "", raw: "-" + inner.raw }
    }

    fn refCmp(op: string, a: number, b: number) -> boolean {
        if (op == ">") return a > b
        if (op == ">=") return a >= b
        if (op == "<") return a < b
        if (op == "<=") return a <= b
        if (op == "==") return a == b
        return a != b
    }

    // 1: holds · 0: fails · -1: not decided now.
    fn refEval(p: RefPred, v: RefLit) -> int {
        return match p {
            .PCmp(op: o, n: k) :> refCmpLit(o, k, v)
            .PLen(op: o, n: k) :> refLenLit(o, k, v)
            .PShape(name: nm) :> refShapeLit(nm, v)
            .PAnd(l: a, r: b) :> refAnd3(refEval(a, v), refEval(b, v))
            .POr(l: a, r: b) :> refOr3(refEval(a, v), refEval(b, v))
            .PNot(p: x) :> refNot3(refEval(x, v))
        }
    }

    fn refCmpLit(op: string, k: number, v: RefLit) -> int {
        if (v.isStr) return -1
        if (refCmp(op, v.n, k)) return 1
        return 0
    }

    fn refLenLit(op: string, k: number, v: RefLit) -> int {
        if (!v.isStr) return -1
        if (refCmp(op, codePointCount(v.s), k)) return 1
        return 0
    }

    // s478 (S239 review of #1888, HIGH-1) — a string's `.length` in CODE POINTS:
    // Appendix D.1 "A string's `.length` SHALL be its number of code points"; S469
    // (bryan) "code points everywhere". The host string is UTF-16, so a surrogate
    // pair (a high unit 0xD800-0xDBFF followed by a low unit 0xDC00-0xDFFF) is ONE
    // code point; a lone surrogate is one too (it is one code point, U+D800-U+DFFF).
    fn codePointCount(s: string) -> int {
        let n: int = 0
        let i: int = 0
        while (i < s.length) {
            const u: int = s.charCodeAt(i)
            if (u >= 55296 && u <= 56319 && i + 1 < s.length) {
                const w: int = s.charCodeAt(i + 1)
                if (w >= 56320 && w <= 57343) i = i + 1
            }
            n = n + 1
            i = i + 1
        }
        return n
    }

    fn refAnd3(a: int, b: int) -> int {
        if (a == 0 || b == 0) return 0
        if (a == 1 && b == 1) return 1
        return -1
    }

    fn refOr3(a: int, b: int) -> int {
        if (a == 1 || b == 1) return 1
        if (a == 0 && b == 0) return 0
        return -1
    }

    fn refNot3(a: int) -> int {
        if (a == -1) return -1
        return 1 - a
    }

    // A named shape against a string literal (§53.4.2 rule 2: "The value is a string
    // literal and the predicate is a named shape with a pure structural check"). The
    // checks are impl#1's informative predicates (§53.6.1 "The normative predicate
    // implementations are compiler-defined"). `url` is not decided by the bootstrap:
    // its normative predicate is the WHATWG URL parser plus the §5.2 scheme reader,
    // which the bootstrap does not have — not decided, so refused (INTERIM).
    fn refShapeLit(name: string, v: RefLit) -> int {
        if (!v.isStr) return -1
        let ok = false
        if (name == "email") {
            ok = shapeEmail(v.s)
        } else if (name == "uuid") {
            ok = shapeUuid(v.s)
        } else if (name == "phone") {
            ok = shapePhone(v.s)
        } else if (name == "date") {
            ok = shapeDigits(v.s, "dddd-dd-dd")
        } else if (name == "time") {
            ok = shapeDigits(v.s, "dd:dd") || shapeDigits(v.s, "dd:dd:dd")
        } else if (name == "color") {
            ok = shapeColor(v.s)
        } else {
            return -1
        }
        if (ok) return 1
        return 0
    }

    // JS `\s` (the regex class impl#1's shape predicates use).
    fn isRegexSpace(c: string) -> boolean {
        const n: int = c.charCodeAt(0)
        return (n >= 9 && n <= 13) || n == 32 || n == 160 || n == 5760 || (n >= 8192 && n <= 8202) || n == 8232 || n == 8233 || n == 8239 || n == 8287 || n == 12288 || n == 65279
    }

    fn isHexCh(c: string) -> boolean {
        return isDigitStr(c) || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
    }

    // `^[^\s@]+@[^\s@]+\.[^\s@]+$`
    fn shapeEmail(s: string) -> boolean {
        let at: int = -1
        let ats: int = 0
        let i: int = 0
        while (i < s.length) {
            const c: string = s.charAt(i)
            if (isRegexSpace(c)) return false
            if (c == "@") {
                ats = ats + 1
                at = i
            }
            i = i + 1
        }
        if (ats != 1 || at < 1) return false
        const dom: string = s.substring(at + 1)
        let j: int = 1
        while (j <= dom.length - 2) {
            if (dom.charAt(j) == ".") return true
            j = j + 1
        }
        return false
    }

    // `^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$` (case-insensitive)
    fn shapeUuid(s: string) -> boolean {
        if (s.length != 36) return false
        let i: int = 0
        while (i < 36) {
            const c: string = s.charAt(i)
            if (i == 8 || i == 13 || i == 18 || i == 23) {
                if (c != "-") return false
            } else if (!isHexCh(c)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // `^[+]?[0-9\s\-().]{7,15}$`
    fn shapePhone(s: string) -> boolean {
        let body: string = s
        if (s.substring(0, 1) == "+") body = s.substring(1)
        if (body.length < 7 || body.length > 15) return false
        let i: int = 0
        while (i < body.length) {
            const c: string = body.charAt(i)
            if (!(isDigitStr(c) || isRegexSpace(c) || c == "-" || c == "(" || c == ")" || c == ".")) return false
            i = i + 1
        }
        return true
    }

    // `form`: `d` a digit `[0-9]`, any other character itself.
    fn shapeDigits(s: string, form: string) -> boolean {
        if (s.length != form.length) return false
        let i: int = 0
        while (i < s.length) {
            const f: string = form.charAt(i)
            const c: string = s.charAt(i)
            if (f == "d") {
                if (!isDigitStr(c)) return false
            } else if (c != f) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // `^#[0-9A-Fa-f]{6}$|^[a-z]+$`
    fn shapeColor(s: string) -> boolean {
        if (s.length == 7 && s.charAt(0) == "#") {
            let i: int = 1
            while (i < 7) {
                if (!isHexCh(s.charAt(i))) return false
                i = i + 1
            }
            return true
        }
        if (s.length == 0) return false
        let j: int = 0
        while (j < s.length) {
            const c: string = s.charAt(j)
            if (!(c >= "a" && c <= "z")) return false
            j = j + 1
        }
        return true
    }

    // The static-zone verdict of literal `v` against `base(pred)` (the judgement
    // `p`): "pass" · "fail" (E-CONTRACT-001) · "base" (E-CONTRACT-001 — a number
    // that is not an integer, against an `int` base) · "mismatch" (a literal of
    // another primitive: the typer's type check reports it, not the predicate) ·
    // "open" (not decided now).
    // S458 (§53.3.4: "The constrained type is a subtype of the base type"): the
    // literal check tests the BASE type, as the runtime judge does — `1.5` does not
    // inhabit `integer(>0)`.
    fn refVerdict(base: string, p: RefPred, v: RefLit) -> string {
        if (numericBase(base) && v.isStr) return "mismatch"
        if (base == "string" && !v.isStr) return "mismatch"
        if ((base == "int" || base == "integer") && Math.floor(v.n) != v.n) return "base"
        const r: int = refEval(p, v)
        if (r == 1) return "pass"
        if (r == 0) return "fail"
        return "open"
    }

    fn refFailMsg(base: string, pred: string, v: RefLit, what: string, verdict: string) -> string {
        let why: string = "it does not satisfy `(" + pred + ")`"
        if (verdict == "base") why = "it is not an integer, so it is not a `" + base + "` (§53.3.4: the constrained type is a subtype of the base type)"
        return what + " is declared `" + base + "(" + pred + ")`, and its value, the literal `" + v.raw + "`, demonstrably fails it: " + why + " (§53.11 E-CONTRACT-001: \"The compiler SHALL emit E-CONTRACT-001 when a literal value is assigned to a constrained type variable and the literal demonstrably fails the predicate\"). Use a value satisfying `(" + pred + ")`"
    }

    // The refusal of a boundary-zone refinement (INTERIM: §53.11 requires a runtime
    // check there, which the bootstrap does not build yet).
    fn refBoundaryMsg(shown: string, where: string) -> string {
        return "the refinement `" + shown + "` " + where + " — a value that reaches it is checked at run time (§53.4.3, §53.11: \"The compiler SHALL emit a runtime check for every boundary-zone assignment that it cannot statically elide\"), and the bootstrap does not build that check yet (INTERIM, g-boot-refinement-runtime-checks-s478). The bootstrap judges a refinement on a fixed declaration whose value is a literal: `const x: " + shown + " = <literal>` or a top-level `<x:" + shown + "=<literal>/>`"
    }

    // Is `t` a refinement still standing (not reported) — at its top?
    fn standingRefine(t: AType) -> boolean {
        return match t.k {
            .TName(name: n) :> false
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
            .TLife(pre: f, post: x) :> false
            .TRefine(base: b, pred: p) :> p != ""
            .TFn(params: ps) :> false
        }
    }

    // The span of a standing refinement anywhere inside `t`, or not.
    fn refineInside(t: AType) -> ASpan | not {
        return match t.k {
            .TName(name: n) :> not
            .TSeq(elem: e) :> refineInside(e)
            .TMaybe(inner: i) :> refineInside(i)
            .TLife(pre: f, post: x) :> not      // a lifecycle refuses a refinement in it by name (lifeRefineWhy)
            .TRefine(base: b, pred: p) :> refineSpanIf(t, p)
            .TFn(params: ps, ret: r) :> refineInFn(ps, r)
        }
    }

    fn refineSpanIf(t: AType, p: string) -> ASpan | not {
        if (p == "") return not
        return t.span
    }

    // s478 (s478-boot-fn-type) — a standing refinement in a function type's parameter or return
    // type: refused where the function type stands, as in any other position it reaches unproven.
    fn refineInFn(ps: AType[], ret: AType | not) -> ASpan | not {
        for (const p of ps) {
            const s: ASpan | not = refineInside(p)
            if (s is given) return s
        }
        if (ret is not) return not
        return refineInside(ret)
    }

    // Base name and predicate of a refinement node (`base` "" when `t` is none).
    fn refineBaseName(t: AType) -> string {
        return match t.k {
            .TName(name: n) :> ""
            .TSeq(elem: e) :> ""
            .TMaybe(inner: i) :> ""
            .TLife(pre: f, post: x) :> ""
            .TRefine(base: b, pred: p) :> typeNameText(b)
            .TFn(params: ps) :> ""
        }
    }

    fn refinePred(t: AType) -> string {
        return match t.k {
            .TName(name: n) :> ""
            .TSeq(elem: e) :> ""
            .TMaybe(inner: i) :> ""
            .TLife(pre: f, post: x) :> ""
            .TRefine(base: b, pred: p) :> p
            .TFn(params: ps) :> ""
        }
    }

    // `t` with its top refinement marked REPORTED (`pred` "": untrusted downstream).
    fn reportedRefine(t: AType) -> AType {
        return match t.k {
            .TName(name: n) :> t
            .TSeq(elem: e) :> t
            .TMaybe(inner: i) :> t
            .TLife(pre: f, post: x) :> t
            .TRefine(base: b, pred: p) :> { nid: t.nid, span: t.span, k: ATypeK.TRefine(b, "") }
            .TFn(params: ps) :> t
        }
    }

    // The zone of a FIXED declaration's top refinement `t` with value `init`
    // (`what` names the declaration for the message): a literal is judged now
    // (§53.4.2), anything else is refused (the boundary zone, INTERIM). Returns the
    // diagnostic (code "" none) and whether the type is now reported.
    type RefZone:struct = { code: string, msg: string, reported: boolean }

    fn refineFixedZone(t: AType, lit: RefLit | not, what: string) -> RefZone {
        const base: string = refineBaseName(t)
        const pred: string = refinePred(t)
        const shown: string = base + "(" + pred + ")"
        const j: RefJudge = judgeRefine(base, pred)
        if (lit is not) return { code: "E-BOOTSTRAP-UNSUPPORTED", msg: refBoundaryMsg(shown, "on " + what + " whose value is not a literal"), reported: false }
        const verdict: string = refVerdict(base, j.p, lit)
        if (verdict == "fail" || verdict == "base") return { code: "E-CONTRACT-001", msg: refFailMsg(base, pred, lit, what, verdict), reported: verdict == "base" }
        if (verdict == "open") return { code: "E-BOOTSTRAP-UNSUPPORTED", msg: "the refinement `" + shown + "` on " + what + " — whether the literal `" + lit.raw + "` satisfies it is not decided by the bootstrap (the normative `url` predicate is the WHATWG URL parser with the §5.2 scheme reader, which it does not have; INTERIM, g-boot-refinement-runtime-checks-s478)", reported: false }
        return { code: "", msg: "", reported: false }
    }

    // =========================================================================
    // s478 (s478-boot-refinement-runtime) — the BOUNDARY zone's runtime check
    // (§53.4.3, §53.4.5, §53.11: "The compiler SHALL emit a runtime check for every
    // boundary-zone assignment that it cannot statically elide"). The predicate is
    // judged by THIS reader (judgeRefine) and handed to the runtime as a spec —
    // prefix tokens separated by one space — so the runtime never reads the
    // predicate text itself (one reader; the static and the runtime check judge the
    // same predicate, §53.6.1):
    //   `c <op> <n>`  the value against a number     `l <op> <n>`  `.length` (code points)
    //   `s <name>`    a named shape (§53.6.1)        `& A B` · `| A B` · `! A`
    // "" when the refinement does not stand (reported, or not judged).
    // =========================================================================
    export fn refineSpec(base: string, pred: string) -> string {
        if (pred == "") return ""
        const j: RefJudge = judgeRefine(base, pred)
        if (j.code != "") return ""
        return refSpecOf(j.p)
    }

    fn refSpecOf(p: RefPred) -> string {
        return match p {
            .PCmp(op: o, n: k) :> "c " + o + " " + k
            .PLen(op: o, n: k) :> "l " + o + " " + k
            .PShape(name: nm) :> "s " + nm
            .PAnd(l: a, r: b) :> "& " + refSpecOf(a) + " " + refSpecOf(b)
            .POr(l: a, r: b) :> "| " + refSpecOf(a) + " " + refSpecOf(b)
            .PNot(p: x) :> "! " + refSpecOf(x)
        }
    }

    // The base name and predicate of a refinement standing at the TOP of `t`
    // (`base` "" when there is none — a plain type, or a reported refinement).
    export type RefineTop:struct = { base: string, pred: string }

    export fn refineTopOf(t: AType | not) -> RefineTop {
        if (t is not) return { base: "", pred: "" }
        if (!standingRefine(t)) return { base: "", pred: "" }
        return { base: refineBaseName(t), pred: refinePred(t) }
    }

    // The static zone at a value that reaches a refinement (§53.4.2 rules 1-2,
    // T-PRED-1): `e` judged against `base(pred)` when it is a literal — "pass",
    // "fail" / "base" (E-CONTRACT-001), "mismatch" (another primitive: the type
    // check reports it), "open" (not decided now: the runtime check judges it) —
    // or "none" when `e` is not a literal.
    export fn refineLitVerdict(base: string, pred: string, e: AExpr) -> string {
        const lit: RefLit | not = refLitOf(e)
        if (lit is not) return "none"
        const j: RefJudge = judgeRefine(base, pred)
        if (j.code != "") return "open"
        return refVerdict(base, j.p, lit)
    }

    // The E-CONTRACT-001 text for literal `e` (refineLitVerdict "fail" / "base").
    export fn refineLitFailMsg(base: string, pred: string, e: AExpr, what: string, verdict: string) -> string {
        const lit: RefLit | not = refLitOf(e)
        if (lit is not) return what + " does not satisfy `" + base + "(" + pred + ")`"
        return refFailMsg(base, pred, lit, what, verdict)
    }

    // A refinement read in a code type, at its `(` (touching the base name):
    // the tokens to the matching `)` are the predicate, judged now. A tail after
    // the `)` that is not `[…]` (a label, or a tape: read by parseType's loop) and
    // is a name on the same line is malformed (§53.11: "a tail after the closing
    // `)` other than one `[label]`"). `own`: the caller decides the zone of a top
    // refinement (parseLocal); otherwise a standing refinement is refused here.
    fn parseRefine(tp: TP, start: int, base: AType) -> RType {
        const open: PTok = cur(tp)
        let t: TP = adv(tp)
        const from: int = t.i
        let depth: int = 1
        let closed = false
        while (!closed && !atEnd(t)) {
            if (isP(t, "(")) depth = depth + 1
            if (isP(t, ")")) {
                depth = depth - 1
                if (depth == 0) closed = true
            }
            if (!closed) t = adv(t)
        }
        const pred: string = tokText(t, from, t.i)
        const shown: string = typeNameText(base) + "(" + pred + ")"
        if (!closed) {
            t = diagAt(t, "E-CONTRACT-002", "the inline predicate `" + shown + "` is malformed (an unclosed `(`), so it cannot be enforced (§53.11)", open)
            return mkT(t, start, ATypeK.TRefine(base, ""))
        }
        const close: PTok = cur(t)
        t = adv(t)
        const j: RefJudge = judgeRefine(typeNameText(base), pred)
        let p: string = pred
        if (j.code != "") {
            const d: Diag = newDiag(j.code, j.msg, t.file, mkSpan(start, close.end))
            t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d]), file: t.file, ns: t.ns, inFn: t.inFn }
            p = ""
        }
        // S239 review of #1888 (LOW-1) — a constraint label `base(pred)[name]`
        // (§53.2.3, `named-constraint = inline-predicate "[" identifier "]"`): one
        // name in brackets that is no grant word (a grant word reads `T[g]`, a tape,
        // §66.12.2). Refused by name — INTERIM, g-boot-refinement-label-s478.
        if (isP(t, "[") && peekAt(t, 1).cls == TC.Ident && !isGrantText(peekAt(t, 1).v) && tk(peekAt(t, 2), "]")) {
            const lb: PTok = peekAt(t, 1)
            const rb: PTok = peekAt(t, 2)
            const d3: Diag = newDiag("E-BOOTSTRAP-UNSUPPORTED", refLabelMsg(shown, lb.v), t.file, mkSpan(start, rb.end))
            t = adv(adv(adv(t)))
            if (p != "") t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d3]), file: t.file, ns: t.ns, inFn: t.inFn }
            return mkT(t, start, ATypeK.TRefine(base, ""))
        }
        // a tail: a name on the `)`'s line that is no validator word and no keyword
        const tail: PTok = cur(t)
        if (tail.cls == TC.Ident && tail.line == close.line && !isValidatorWord(tail.v)) {
            let last: PTok = tail
            const tailFrom: int = t.i
            while (!atEnd(t) && cur(t).line == close.line && !isP(t, "=") && !isP(t, ",") && !isP(t, ")") && !isP(t, ";") && !isP(t, "{") && !isP(t, "}")) {
                last = cur(t)
                t = adv(t)
            }
            if (p != "") {
                const d2: Diag = newDiag("E-CONTRACT-002", "the refinement `" + shown + "` is followed by `" + tokText(t, tailFrom, t.i) + "` — text after a refinement's closing `)` other than one `[label]` is outside the §53.2.1 grammar, so the annotation is malformed (§53.11 E-CONTRACT-002; a malformed predicate \"SHALL NOT be treated as an unrefined annotation\")", t.file, mkSpan(start, last.end))
                t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d2]), file: t.file, ns: t.ns, inFn: t.inFn }
            }
            p = ""
        }
        return mkT(t, start, ATypeK.TRefine(base, p))
    }

    // The §66.12.2 grant words (analyze grantAxis, the retired and renamed
    // spellings included): `T[g]` with one of these is a tape, not a label.
    fn isGrantText(w: string) -> boolean {
        return w == "free" || w == "write" || w == "replace" || w == "append" || w == "pop" || w == "prepend" ||
               w == "shift" || w == "insert" || w == "remove" || w == "end" || w == "front" || w == "anywhere" || w == "writable"
    }

    fn isLabelText(w: string) -> boolean {
        if (w == "" || !isIdentStartCh(w.charAt(0))) return false
        let i: int = 1
        while (i < w.length) {
            if (!isIdentCh(w.charAt(i))) return false
            i = i + 1
        }
        return true
    }

    fn refLabelMsg(shown: string, label: string) -> string {
        return "the constraint label `[" + label + "]` on `" + shown + "` (§53.2.3: \"The name is used in error messages only … If the constraint is violated, the error message SHALL include the label name\") — the bootstrap does not carry a label into its messages yet, so it is refused rather than dropped (INTERIM, g-boot-refinement-label-s478)"
    }

    // A refinement anywhere in `ty` (a code type parsed at `start`) that its
    // position does not judge: refused by name (the boundary zone, INTERIM).
    fn refuseRefineIn(tp: TP, ty: AType, where: string) -> TP {
        const sp: ASpan | not = refineInside(ty)
        if (sp is not) return tp
        const d: Diag = newDiag("E-BOOTSTRAP-UNSUPPORTED", refBoundaryMsg(typeNameText(ty), where), tp.file, sp)
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // s475 (s475-boot-lifecycle-type) — a lifecycle type `(A to B)` (§14.12) in a
    // CODE position (a parameter, a return type, a struct / variant field, a
    // local's annotation), at its `(`. It is READ whole — A (`not`, a name or a
    // bare variant `.V`), the glyph `to` (or the legacy `->`), B (any type), `)` —
    // so nothing cascades, and then REFUSED by name: the bootstrap builds the
    // lifecycle only as a program cell's declared type (an opener, openerLife),
    // INTERIM until field / parameter / return tracking (§14.12.3, §14.12.6).
    // A malformed inside is E-PARSE-TYPE; the reader resumes after the `)`.
    // At `(`, A, then the glyph `to` or `->`: the head of a lifecycle type. Any
    // other `(` (a function type `(T, U) -> R`, …) keeps its old reading.
    // s478 (s478-boot-fn-type) — a FUNCTION type: `(` … `)` `=>` R (§7.5: "the spelling is the
    // §15.11.4 signature type, `f: (x: int) => int`"; §15.11.4 `fn-prop-decl ::= identifier ':'
    // '(' param-type-list ')' '=>' return-type`). At a `(` whose matching `)` is followed by `=>`
    // (a lifecycle `(A to B)` is lifeAhead's, tested first). The lexer reads `=>` as one token.
    fn fnTypeAhead(tp: TP) -> boolean {
        if (!isP(tp, "(")) return false
        const close: int = parenClose(tp)
        if (close < 0) return false
        return fnArrowAt(tp, close + 1) > 0
    }

    // s478-ruled-fn-types — after a function type's `)`, at offset `k`: `=>`, or the failable
    // modifier `!` / `! E` then `=>` (§7.5 "Function types (S478)": `(x: T)! E => R`, spelled as
    // the declaration is, §19.4.1). The offset just past the `=>`, else 0.
    fn fnArrowAt(tp: TP, k: int) -> int {
        let j: int = k
        if (tk(peekAt(tp, j), "!")) {
            j = j + 1
            const e: PTok = peekAt(tp, j)
            if ((e.cls == TC.Ident || e.cls == TC.Keyword) && tk(peekAt(tp, j + 1), "=>")) j = j + 1
        }
        if (tk(peekAt(tp, j), "=>")) return j + 1
        return 0
    }

    // s478-ruled-fn-types — the RETIRED thin-arrow spelling `(…) -> R` in a type: a `(` whose
    // matching `)` is followed by a glued `->` (a lifecycle `(A -> B)` is lifeAhead's, tested
    // first: its arrow is INSIDE the parentheses).
    fn thinFnTypeAhead(tp: TP) -> boolean {
        if (!isP(tp, "(")) return false
        const close: int = parenClose(tp)
        if (close < 0) return false
        return thinArrowAt(tp, close + 1) > 0
    }

    // s478-ruled-fn-types r1 (review LOW-1) — after a function type's `)`, at offset `k`: the
    // retired glued `->`, past an optional failable modifier `!` / `! E` (`(x: int)! E -> int`
    // is the retired spelling of `(x: int)! E => int`, §7.5). The offset of the `-`, else 0.
    fn thinArrowAt(tp: TP, k: int) -> int {
        let j: int = k
        if (tk(peekAt(tp, j), "!")) {
            j = j + 1
            const e: PTok = peekAt(tp, j)
            if ((e.cls == TC.Ident || e.cls == TC.Keyword) && tk(peekAt(tp, j + 1), "-")) j = j + 1
        }
        const a: PTok = peekAt(tp, j)
        if (tk(a, "-") && tk(peekAt(tp, j + 1), ">") && touching(a, peekAt(tp, j + 1))) return j
        return 0
    }

    fn thinArrowFix() -> string {
        return "a function type is written with `=>`, never `->` (§7.5 \"Function types\", S478: `=>` is the one spelling; `->` is the return-type annotation of a function DECLARATION only). Write `(x: T) => R` — `() => void` for a function that gives no value"
    }

    // s478-ruled-fn-types — the RETIRED `fn(…)` spelling (no `=>` after its `)`): E-PARSE-TYPE
    // naming the fix, then the rest read as a function type (a following `-> R` is its result)
    // so nothing cascades.
    fn parseRetiredFnKw(tp: TP, start: int) -> RType {
        const t0: TP = diagAt(tp, "E-PARSE-TYPE", "`fn(…)` is not a function type spelling (§7.5 \"Function types\", S478: `=>` is the one spelling). Write `(x: T) => R` — `() => void` for a function of no parameters that gives no value; `fn (x: T) => R` (with `=>`) is the PURE function type (§48.6.3)", cur(tp))
        const close: int = parenClose(adv(t0))
        if (close > 0 && thinArrowAt(adv(t0), close + 1) > 0) return parseFnTypeAt(adv(t0), start, false, true, false)
        return parseFnTypeAt(adv(t0), start, false, false, true)
    }

    // The offset (from `tp`, at a `(`) of the `)` that closes it, else -1 (a `{`, `}` or `;`
    // before it, or the end of input: no parameter list).
    fn parenClose(tp: TP) -> int {
        let k: int = 1
        let depth: int = 1
        while (k < 4096) {
            const x: PTok = peekAt(tp, k)
            if (x.cls == TC.End) return -1
            if (tk(x, "{") || tk(x, "}") || tk(x, ";")) return -1
            if (tk(x, "(") || tk(x, "[")) depth = depth + 1
            if (tk(x, ")") || tk(x, "]")) {
                depth = depth - 1
                if (depth == 0) {
                    if (tk(x, ")")) return k
                    return -1
                }
            }
            k = k + 1
        }
        return -1
    }

    // `(T1, T2) => R` / `(a: T1, b: T2) => R` / `() => void`. A parameter's written NAME is
    // read past (it is no part of the type); `lin` on one is refused by name — a function type
    // that carries a `lin` parameter is not in the bootstrap (INTERIM: §35.2.1 lin parameters
    // are built on a declaration's own parameters only). `void` as the return: a function that
    // gives no value. A failable function type has no spelling in the SPEC (§19.4.4 puts `!` in
    // a function's type signature but names no type syntax): nothing is read for it here.
    fn parseFnType(tp: TP, start: int, pure: boolean, thin: boolean) -> RType {
        if (!thin) return parseFnTypeAt(tp, start, pure, false, false)
        // the retired `(…) -> R`: reported at its `->`, then read as `(…) => R`
        const close: int = parenClose(tp)
        const t1: TP = diagAt(tp, "E-PARSE-TYPE", thinArrowFix(), peekAt(tp, thinArrowAt(tp, close + 1)))
        return parseFnTypeAt(t1, start, pure, true, false)
    }

    // `thin`: the arrow is the retired `->` (already reported); `bare`: no arrow at all (the
    // retired `fn(…)`, already reported) — the type gives no value.
    fn parseFnTypeAt(tp: TP, start: int, pure: boolean, thin: boolean, bare: boolean) -> RType {
        let t: TP = adv(tp)
        let ps: AType[] = []
        while (!isP(t, ")") && !atEnd(t)) {
            const lt: PTok = cur(t)
            if (lt.cls == TC.Keyword && lt.v == "lin") {
                t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a `lin` parameter in a function type is not in the bootstrap (INTERIM — §35.2.1 builds `lin` on a declaration's own parameters; a function TYPE does not carry it). Drop `lin` here, or call the function by its name", lt)
                t = adv(t)
            }
            if ((cur(t).cls == TC.Ident || cur(t).cls == TC.Keyword) && tk(peekAt(t, 1), ":")) t = adv(adv(t))
            const r: RType = parseTypeBody(t)
            ps = ps.concat([r.t])
            t = r.tp
            if (isP(t, ",")) {
                t = adv(t)
            } else if (!isP(t, ")")) {
                t = diagAt(t, "E-PARSE-TYPE", "expected `,` or `)` in a function type's parameter list, found `" + cur(t).text + "`", cur(t))
                while (!isP(t, ")") && !atEnd(t)) { t = adv(t) }
            }
        }
        t = expectP(t, ")")
        // s478-ruled-fn-types — the failable modifier `!` / `! E` (§7.5 "Function types (S478)",
        // spelled as a `!` declaration is, §19.4.1): `err` the error enum's NAME, `not` for the
        // built-in `Error` (§19.4.2)
        let isFail = false
        let err: AType | not = not
        if (!bare && isP(t, "!")) {
            isFail = true
            t = adv(t)
            const et: PTok = cur(t)
            if ((et.cls == TC.Ident || et.cls == TC.Keyword) && (tk(peekAt(t, 1), "=>") || (thin && tk(peekAt(t, 1), "-")))) {
                err = { nid: t.nid, span: mkSpan(et.start, et.end), k: ATypeK.TName(et.v) }
                t = bumpId(adv(t))
            }
        }
        const fx: AFnFx = { pure: pure, failable: isFail, err: err }
        if (bare) return mkT(t, start, ATypeK.TFn(ps, not, fx))
        if (thin) {
            t = adv(adv(t))
        } else {
            t = expectP(t, "=>")
        }
        if (isWord(t, "void")) return mkT(adv(t), start, ATypeK.TFn(ps, not, fx))
        const rr: RType = parseTypeBody(t)
        return mkT(rr.tp, start, ATypeK.TFn(ps, rr.t, fx))
    }

    fn lifeAhead(tp: TP) -> boolean {
        if (!isP(tp, "(")) return false
        const a: PTok = peekAt(tp, 1)
        if (a.cls != TC.Variant && a.cls != TC.Ident && a.cls != TC.Keyword) return false
        const g: PTok = peekAt(tp, 2)
        if ((g.cls == TC.Ident || g.cls == TC.Keyword) && g.v == "to") return true
        return tk(g, "-") && tk(peekAt(tp, 3), ">") && touching(g, peekAt(tp, 3))
    }

    fn parseLifeType(tp: TP) -> RType {
        const start: int = cur(tp).start
        let t: TP = adv(tp)
        let bad = false
        let arrow = false
        const ft: PTok = cur(t)
        let fromT: AType = { nid: t.nid, span: mkSpan(ft.start, ft.end), k: ATypeK.TName("") }
        if (ft.cls == TC.Variant) {
            fromT = { nid: t.nid, span: mkSpan(ft.start, ft.end), k: ATypeK.TName("." + ft.v) }
            t = bumpId(adv(t))
        } else if (ft.cls == TC.Ident || ft.cls == TC.Keyword) {
            fromT = { nid: t.nid, span: mkSpan(ft.start, ft.end), k: ATypeK.TName(ft.v) }
            t = bumpId(adv(t))
        } else {
            t = diagAt(t, "E-PARSE-TYPE", "expected a lifecycle's first state after `(` — `(not to T)` (§14.12), found `" + ft.text + "`", ft)
            bad = true
        }
        let toT: AType = { nid: t.nid, span: mkSpan(ft.start, ft.end), k: ATypeK.TName("") }
        if (!bad) {
            const a: PTok = cur(t)
            const b: PTok = peekAt(t, 1)
            if (isWord(t, "to")) {
                t = adv(t)
            } else if (tk(a, "-") && tk(b, ">") && touching(a, b)) {
                arrow = true
                t = adv(adv(t))
            } else {
                t = diagAt(t, "E-PARSE-TYPE", "expected `to` in the lifecycle type — `(not to T)` (§14.12.2), found `" + a.text + "`", a)
                bad = true
            }
        }
        // B a bare variant: one `.V` token, or — after the word `to`, which the lexer
        // reads as a member access — `.` then a name touching it
        const dt: PTok = cur(t)
        const dn: PTok = peekAt(t, 1)
        if (!bad && dt.cls == TC.Variant) {
            toT = { nid: t.nid, span: mkSpan(dt.start, dt.end), k: ATypeK.TName("." + dt.v) }
            t = bumpId(adv(t))
        } else if (!bad && tk(dt, ".") && (dn.cls == TC.Ident || dn.cls == TC.Keyword) && touching(dt, dn)) {
            toT = { nid: t.nid, span: mkSpan(dt.start, dn.end), k: ATypeK.TName("." + dn.v) }
            t = bumpId(adv(adv(t)))
        } else if (!bad) {
            const n0: int = t.diags.length
            const rb: RType = parseTypeBody(t)
            toT = rb.t
            t = rb.tp
            if (t.diags.length > n0) bad = true
            // s478: a refinement as B — read whole, refused by name (one report)
            if (!bad && refineInside(toT) is given) {
                t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", lifeRefineWhy(), cur(t))
                toT = reportedRefine(toT)
                bad = true
            }
        }
        if (!bad && !isP(t, ")")) {
            const c: PTok = cur(t)
            if (isP(t, "(")) {
                t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", lifeRefineWhy(), c)
            } else if (isWord(t, "to")) {
                t = diagAt(t, "E-PARSE-TYPE", "a lifecycle chain `(A to B to C)` is not v1 scrml — a lifecycle has two states (§14.12.6.4)", c)
            } else {
                t = diagAt(t, "E-PARSE-TYPE", "expected `)` to close the lifecycle type, found `" + c.text + "`", c)
            }
            bad = true
        }
        t = lifeCloseTok(t)
        // a malformed lifecycle (reported above) keeps a blank first state: it
        // resolves to no type, quietly (analyze presenceLife), never a second report
        if (bad) return mkT(t, start, ATypeK.TLife(blankAType(fromT), toT))
        const r: RType = mkT(t, start, ATypeK.TLife(fromT, toT))
        let why: string = lifeRefusal(fromT, toT, arrow, tokText(r.tp, tp.i, r.tp.i))
        if (why == "") why = "a lifecycle type `" + tokText(r.tp, tp.i, r.tp.i) + "` in a code position (a parameter, a return type, a struct or variant field, a local's annotation) is not in the bootstrap yet — it builds `(not to T)` only as a program cell's declared type, `let <x:(not to T)=not/>` (§14.12.3); write `T | not` here"
        const d: Diag = newDiag("E-BOOTSTRAP-UNSUPPORTED", why, r.tp.file, spanFrom(r.tp, start))
        return { t: r.t, tp: { toks: r.tp.toks, i: r.tp.i, nid: r.tp.nid, diags: r.tp.diags.concat([d]), file: r.tp.file, ns: r.tp.ns, inFn: r.tp.inFn } }
    }

    // Past the `)` that closes the lifecycle type the reader is inside (depth 1
    // at `tp`); at the end of input when it never closes. s475 r1 (F3): a `(` /
    // `)` inside a `[…]` (a grant list) does not count — a string is one token
    // already (isP) — so a malformed inside cannot pull the reader past its own
    // `)`. When a `[` never closes, the plain paren count decides (no swallow).
    type RClose:struct = { tp: TP, ok: boolean }

    fn lifeCloseTok(tp: TP) -> TP {
        const r: RClose = lifeCloseTokIn(tp, true)
        if (r.ok) return r.tp
        return lifeCloseTokIn(tp, false).tp
    }

    fn lifeCloseTokIn(tp: TP, brackets: boolean) -> RClose {
        let t: TP = tp
        let depth: int = 1
        let sq: int = 0
        while (!atEnd(t)) {
            if (brackets && isP(t, "[")) sq = sq + 1
            if (brackets && isP(t, "]") && sq > 0) sq = sq - 1
            if (sq == 0 && isP(t, "(")) depth = depth + 1
            if (sq == 0 && isP(t, ")")) {
                depth = depth - 1
                if (depth == 0) return { tp: adv(t), ok: true }
            }
            t = adv(t)
        }
        return { tp: t, ok: false }
    }

    // THE one judge of a READ lifecycle type, both readers (the opener's
    // openerLife and the code position's parseLifeType): why the bootstrap does
    // not build `(from to to)` in ANY position, "" when it is the presence
    // lifecycle `(not to T)` written with `to`. `text` = the type as written.
    fn lifeRefusal(fromT: AType, toT: AType, arrow: boolean, text: string) -> string {
        // s475 r1 (F4): `(int -> int)` may be a function type, meant — say that too
        if (arrow && !isNotType(fromT) && !variantAType(fromT)) return "the legacy lifecycle glyph `->` (`" + text + "`) is not in the bootstrap — write `to`: `(not to T)` (§14.12.2; §14.12.5 deprecates `->`). If `" + text + "` is meant as a function type, function types are not in the bootstrap either — declare a named function and pass its name"
        if (arrow) return "the legacy lifecycle glyph `->` (`" + text + "`) is not in the bootstrap — write `to`: `(not to T)` (§14.12.2; §14.12.5 deprecates `->`)"
        if (!isNotType(fromT) || variantAType(toT)) return "the lifecycle `" + text + "` is not in the bootstrap yet — it builds only the presence lifecycle `(not to T)` (§14.12.3, §14.12.6.1); a variant progression `(.A to .B)` (§14.12.6.2) is not built — for a variant graph, declare an engine (`<x:T=.A single>` with state-children, §66.13)"
        // s478 (s478-boot-pending-tape-grants): a granted tape as the second state,
        // `(not to S[replace])`, is READ here — its grants ride the type (§13.9.1 rule 4,
        // RULED S478: "needs `replace` in the tape's grants (`(not to S[replace])`)").
        // Which cell may carry one is analyze's (fieldOf: a pending tape; a plain
        // lifecycle cell's granted tape stays refused by name there, lifeTapeGrantsWhy).
        return ""
    }

    // s475 r1 (F5) — `(not to number(>0))`: a refinement (§53) as the lifecycle's
    // second state. The bootstrap reads no refinement type in any position yet —
    // INTERIM, the open refinement limb (g-bootstrap-opener-refinement-lifecycle-type-rejected,
    // g-bootstrap-refinement-types-unbuilt-all-positions-s473); the capable form is §53.
    fn lifeRefineWhy() -> string {
        return "a refinement type (§53) as the lifecycle's second state is not in the bootstrap yet — the value the lifecycle's write brings is not judged against it (g-boot-refinement-runtime-checks-s478); write `(not to T)` with the base type and check the value where it is written"
    }

    fn blankAType(t: AType) -> AType {
        return { nid: t.nid, span: t.span, k: ATypeK.TName("") }
    }

    // A lifecycle state written as a bare variant `.V` (held as TName(".V")).
    fn variantAType(t: AType) -> boolean {
        return match t.k {
            .TName(name: n) :> n.substring(0, 1) == "."
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
            .TLife(pre: f, post: x) :> false
            .TRefine(base: b, pred: p) :> false
            .TFn(params: ps) :> false
        }
    }

    // `T | not` in a CODE position (a return type, a parameter, a local's
    // annotation, a struct field), at the token after it. A TAPE member is
    // refused here exactly as in an opener (seqUnionCheck — the one check every
    // type position uses): the grant checks do not see through `| not`.
    fn maybeType(tp: TP, start: int, from: int, inner: AType) -> RType {
        if (seqUnionCheck(inner)) {
            const d: Diag = newDiag("E-BOOTSTRAP-UNSUPPORTED", seqUnionReason(tokText(tp, from, tp.i)), tp.file, spanFrom(tp, start))
            const t: TP = { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
            return mkT(t, start, inner.k)
        }
        return mkT(tp, start, ATypeK.TMaybe(inner))
    }

    // s469 review — THE check for a union with a sequence member, shared by the
    // opener type parser and the code-position type parser: is `member` (one
    // member of a `T | not` union) a tape that carries a GRANT? Such a tape is
    // refused: the bootstrap's grant model does not see through `| not`, so its
    // grants would be lost or bypassed. An UNGRANTED `S | not` (`int[] | not`)
    // stays — §17.7.2 admits it, and it is judged as the ungranted tape `S`
    // itself is (analyze sees through `| not` for `let`: E-GRANT-LET-ON-SEQUENCE).
    fn seqUnionCheck(member: AType) -> boolean {
        return grantedSeq(member)
    }

    fn grantedSeq(t: AType) -> boolean {
        return match t.k {
            .TName(name: n) :> false
            .TSeq(elem: e, grants: gs) :> gs.length > 0 || grantedSeq(e)
            .TMaybe(inner: i) :> grantedSeq(i)
            .TLife(pre: f, post: x) :> grantedSeq(x)
            .TRefine(base: b, pred: p) :> grantedSeq(b)
            .TFn(params: ps) :> false
        }
    }

    fn seqUnionReason(text: string) -> string {
        return "a granted sequence in a union type (`" + text + "`) is not in the bootstrap — its grants are not checked through the union; declare the tape on its own (`<xs:T[grants]=[]/>`, §66.12)"
    }

    // =========================================================================
    // Logic items: import / type / function / fn, optionally `export`ed.
    // =========================================================================
    fn mkItem(tp: TP, start: int, k: AItemK) -> RItems {
        const it: AItem = { nid: tp.nid, span: spanFrom(tp, start), k: k }
        return { items: [it], tp: bumpId(tp) }
    }

    // Items until the end of the token run (or `close`, when not "").
    // `top`: the run stands at file top level, outside `${}` and `<program>` (s472, §21.3.1).
    export fn parseLogicItems(tp: TP, close: string, top: boolean) -> RItems {
        let t: TP = tp
        let out: AItem[] = []
        let going = true
        while (going) {
            if (atEnd(t)) {
                going = false
            } else if (close != "" && isP(t, close)) {
                going = false
            } else if (isP(t, ";")) {
                t = adv(t)
            } else if (close == "}" && !logicItemAhead(t)) {
                // s478 — statements at the top level of a `${ … }` logic block
                // (§17.3, §40.8). (`close` is "" for a declaration's own region —
                // logicRegionItem — which holds that one item and nothing else.)
                const before: int = t.i
                const rs: RItems = parseStmtRun(t, close)
                out = out.concat(rs.items)
                t = rs.tp
                if (t.i == before) t = adv(t)
            } else {
                const before: int = t.i
                const r: RItems = parseLogicItem(t, top)
                out = out.concat(r.items)
                t = r.tp
                if (t.i == before) t = adv(t)
            }
        }
        return { items: out, tp: t }
    }

    fn parseLogicItem(tp: TP, top: boolean) -> RItems {
        const start: int = cur(tp).start
        let exported = false
        let t: TP = tp
        if (isWord(t, "export")) {
            exported = true
            t = adv(t)
            // s478: `export { … } [from "…"]` / `export * from "…"` — the export lists (§21.4)
            if (isP(t, "{") || isP(t, "*")) return parseExportList(t, start, top)
        }
        if (isWord(t, "import")) return parseImport(t, start, top)
        if (isWord(t, "type")) return parseTypeDecl(t, start, exported)
        if (isWord(t, "function")) return parseFn(t, start, exported, false, false)
        if (isWord(t, "fn")) return parseFn(t, start, exported, true, false)
        // s451 (U1a): the DEPRECATED `server` modifier (§52.10: "During the
        // deprecation window, the parser SHALL accept `server function`
        // declarations and emit `W-DEPRECATED-SERVER-MODIFIER`" — the warning is
        // analyze's, with route inference; §33.3: `server fn` is valid too)
        if (isWord(t, "server")) {
            const ts: TP = adv(t)
            if (isWord(ts, "function")) return parseFn(ts, start, exported, false, true)
            if (isWord(ts, "fn")) return parseFn(ts, start, exported, true, true)
            const bs: PTok = cur(ts)
            const ds: TP = diagAt(ts, "E-PARSE-ITEM", "`server` here modifies a function declaration (`server function name(…) { … }`, deprecated — §52.10); found `" + bs.text + "`", bs)
            return { items: [], tp: skipToLineEnd(ds) }
        }
        // s472: a file-scope constant (§7.6, §21.2) — and (s479) the file-scope `let`
        // §7.6 also admits there: per-artifact state (S478 open-Qs ruling item 59 (c))
        if (isWord(t, "const")) return parseConstItem(t, start, exported)
        if (isWord(t, "let")) return parseLetItem(t, start, exported)
        if (!exported && kwDeclAhead(t)) return parseKwConstItem(t, start)
        if (!exported && sharedModAhead(t)) return sharedModItem(t)
        // s449: a keyword `when` at logic-item level (a `<program>` body, a
        // program-level `${…}`) is an effect where markup stands — owned by the
        // scope it stands in, exactly as an `<effect>` element there is.
        if (!exported && whenAhead(t)) {
            const rw: REffect = parseWhen(t)
            const n: ANode = { nid: rw.tp.nid, span: rw.w.span, k: ANodeK.Effect(rw.w) }
            return mkItem(bumpId(rw.tp), start, AItemK.MarkupItem(n))
        }
        const bad: PTok = cur(t)
        const d: TP = diagAt(t, "E-PARSE-ITEM", "expected `import`, `type`, `const`, `function` or `fn` in a logic block, found `" + bad.text + "` (other statements at logic-block level are not in the bootstrap)", bad)
        return { items: [], tp: skipToLineEnd(d) }
    }

    // =========================================================================
    // s478 (S478 triage C3) — STATEMENTS where an item stands.
    // SPEC §17.3 (S449): "A `${ … }` at a `<program>` / `<page>` / `<channel>`
    // body top is a statement list, evaluated, not rendered (§40.8)"; §40.8 S441:
    // a bare expression statement there "is evaluated, not rendered — it runs
    // once at mount in source order, like any other body-top statement", and a
    // bare write "is an ordinary write in a logic context". Before s478 every
    // such statement was E-PARSE-ITEM ("other statements at logic-block level
    // are not in the bootstrap").
    // A run of statements up to the next item (logicItemAhead), the block's
    // `close` or the region's end is ONE ANodeK.Run, in source order among the
    // items. Each statement is read by the one statement reader (parseTermStmt:
    // its `;` per §7.2.2 rule 1, E-STMT-NO-EFFECT per rule 9).
    // =========================================================================
    fn logicItemAhead(tp: TP) -> boolean {
        if (kwDeclAhead(tp)) return true                 // s478 r1 (MED-1): a keywordless declaration item
        if (isWord(tp, "export") || isWord(tp, "import") || isWord(tp, "type")) return true
        if (isWord(tp, "function") || isWord(tp, "fn") || isWord(tp, "const") || isWord(tp, "let")) return true
        if (isWord(tp, "server")) return isWord(adv(tp), "function") || isWord(adv(tp), "fn")
        if (sharedModAhead(tp)) return true
        return whenAhead(tp)
    }

    // s478 (s478-boot-channel) — §38.4: "The `@shared` modifier SHALL NOT appear in
    // any v0.next source. Use SHALL emit `E-CHANNEL-SHARED-MODIFIER`"; §34: "`@shared`
    // modifier used inside (or outside) a channel body". The retired v1 form is a
    // modifier before a declared name (`@shared count = 0`, §38.4.1's table): `@`
    // touching `shared`, then a name on the same line.
    fn sharedModAhead(tp: TP) -> boolean {
        const a: PTok = cur(tp)
        if (a.cls != TC.At) return false
        const t1: TP = adv(tp)
        const b: PTok = cur(t1)
        if (!(b.cls == TC.Ident && b.v == "shared" && touching(a, b))) return false
        const c: PTok = cur(adv(t1))
        return c.cls == TC.Ident && c.line == b.line
    }

    // The retired form is reported once and read to the end of its statement (a `;`,
    // the line's end, or a `}` closing the enclosing block) — nothing of it is kept.
    fn sharedModItem(tp: TP) -> RItems {
        const a: PTok = cur(tp)
        const b: PTok = cur(adv(tp))
        const d: TP = diagAt(tp, "E-CHANNEL-SHARED-MODIFIER", "`@shared` is removed (§38.4, M19) — a cell declared in a `<channel>` body is synchronized across the channel's clients by being declared there; declare it `let <name:T=init/>` in the channel body, with no modifier", a)
        const line: int = b.line
        let t: TP = adv(adv(d))
        let depth: int = 0
        let going = true
        while (going && !atEnd(t)) {
            const k: PTok = cur(t)
            if (k.line != line && depth == 0) {
                going = false
            } else if (depth == 0 && (isP(t, ";") || isP(t, "}"))) {
                if (isP(t, ";")) t = adv(t)
                going = false
            } else {
                if (isP(t, "(") || isP(t, "[") || isP(t, "{")) depth = depth + 1
                if ((isP(t, ")") || isP(t, "]") || isP(t, "}")) && depth > 0) depth = depth - 1
                t = adv(t)
            }
        }
        return { items: [], tp: t }
    }

    fn parseStmtRun(tp: TP, close: string) -> RItems {
        const start: int = cur(tp).start
        const b0: int = hardErrors(tp.diags)
        let t: TP = tp
        let stmts: AStmt[] = []
        let going = true
        while (going) {
            if (atEnd(t) || (close != "" && isP(t, close)) || logicItemAhead(t)) {
                going = false
            } else if (isP(t, ";")) {
                t = adv(t)
            } else {
                const before: int = t.i
                const r: RStmts = parseTermStmts(t, b0)
                stmts = stmts.concat(r.ss)
                t = r.tp
                if (t.i == before) t = adv(t)
            }
        }
        return runItem(t, start, stmts)
    }

    // The statements `stmts` (read from `start`) as one Run item; none → no item.
    fn runItem(tp: TP, start: int, stmts: AStmt[]) -> RItems {
        if (stmts.length == 0) return { items: [], tp: tp }
        const last: AStmt = stmts[stmts.length - 1]
        const sp: ASpan = mkSpan(start, last.span.end)
        const b: ABlock = { nid: tp.nid, span: sp, stmts: stmts }
        const t1: TP = bumpId(tp)
        const n: ANode = { nid: t1.nid, span: sp, k: ANodeK.Run(b) }
        const t2: TP = bumpId(t1)
        const it: AItem = { nid: t2.nid, span: sp, k: AItemK.MarkupItem(n) }
        return { items: [it], tp: bumpId(t2) }
    }

    // s472 — `[export] const NAME[: T] = init;` at the top level of a `${ }`
    // logic block: a FILE-SCOPE constant. SPEC §7.6: "A variable declared with
    // `let` or `const` at the top level of a file-level `${}` block SHALL be in
    // scope for all subsequent `${}` blocks and markup interpolations in the
    // same file"; §21.2 makes it exportable (`export const Name = ...`). It is a
    // statement and takes its `;` (§7.2.2 rule 1) — read by the statement
    // reader (parseLocal) and its terminator rule (termAfter), so the item and a
    // function-body `const` cannot drift apart. What its initializer may be is
    // analyze's (constPass); a `const xs = for …` value loop (§49.6) runs a loop
    // at module initialization and is refused by name here.
    fn parseConstItem(tp: TP, start: int, exported: boolean) -> RItems {
        const kw: PTok = cur(tp)
        // `const <name> = …` — a derived cell (§6.6), and `const Name = <markup…>`
        // — a component (§21.2 Form 2): neither is a file-scope constant, and
        // neither is in the bootstrap (§66 spells them `<name:T = expr/>` and a
        // declaration, §66.15). Refused by name, as E-PARSE-ITEM refused them
        // before (and recovered the same way), not read as a malformed `const`.
        const derived: boolean = tk(peekAt(tp, 1), "<")
        // (s478: the markup after `=` is one markup-value token, lex.scrml markupValueAhead)
        if (derived || (tk(peekAt(tp, 2), "=") && (tk(peekAt(tp, 3), "<") || peekAt(tp, 3).cls == TC.Markup))) {
            let what: string = "a component written as a constant (`const Name = <…>`, §21.2 Form 2) — §66.15 writes a component as a declaration"
            if (derived) what = "a derived cell written `const <name> = …` (§6.6) — §66 writes it `<name:T = expr/>` in the `<program>`"
            const dc: TP = diagAt(tp, "E-BOOTSTRAP-UNSUPPORTED", what + "; neither form is in the bootstrap at logic-block level", kw)
            return { items: [], tp: skipToLineEnd(dc) }
        }
        const d0: int = hardErrors(tp.diags)
        if (destructDeclAhead(tp)) return refusedDestructItem(tp, d0, "a file-scope destructuring `const` (`const { a } = …;` at the top level of a logic block)")
        const r: RStmt = parseLocal(tp)
        const t: TP = termAfter(r.tp, r.s, d0)
        const c: AConst | not = constOfStmt(r.s, exported)
        if (c is not) {
            const dt: TP = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a file-scope `const` bound to a value loop (`const xs = for … { lift … };`, §49.6) — the loop would run at module initialization, which the bootstrap does not build for file-scope constants; compute the tape in a function and call it where it is needed", kw)
            return { items: [], tp: dt }
        }
        return mkItem(t, start, AItemK.ConstItem(c))
    }

    // s478 r1 (MED-1) — a statement analysis proved a keywordless declaration (PNs.kw), at a place
    // where `const` is an item (the top level of a `${ }` logic block, a `<program>` / `<page>` body
    // top). §50.8.5: the keywordless bare naming statement `x = 1` "declares `x` exactly as
    // `const x = 1` does" — so at file scope it is the file-scope constant (§7.6) `const x = …`
    // would be, with that item's treatment and refusals (constPass), not a body-top local.
    fn kwDeclAhead(tp: TP) -> boolean {
        const t: PTok = cur(tp)
        return t.cls == TC.Ident && tp.ns.kw.indexOf(t.start) >= 0 && isP(adv(tp), "=")
    }

    fn parseKwConstItem(tp: TP, start: int) -> RItems {
        const kw: PTok = cur(tp)
        if (tk(peekAt(tp, 2), "<")) {
            const dc: TP = diagAt(tp, "E-BOOTSTRAP-UNSUPPORTED", "a component written as a constant (`" + kw.text + " = <…>`, the keywordless form of `const " + kw.text + " = <…>`, §21.2 Form 2) — §66.15 writes a component as a declaration; the form is not in the bootstrap at logic-block level", kw)
            return { items: [], tp: skipToLineEnd(dc) }
        }
        const d0: int = hardErrors(tp.diags)
        const r: RStmt = parseStmt(tp)
        const t: TP = termAfter(r.tp, r.s, d0)
        const c: AConst | not = constOfStmt(r.s, false)
        if (c is not) return { items: [], tp: t }
        return mkItem(t, start, AItemK.ConstItem(c))
    }

    fn constOfStmt(s: AStmt, exported: boolean) -> AConst | not {
        const k: AStmtK = s.k
        return match k {
            .Local(name: n, mutable: m, ty: y, init: i) :> mkConst(s, exported, n, y, i, m)
            .Eval(e: x) :> not
            .Return(e: x) :> not
            .If(cond: x) :> not
            .Given(name: x) :> not
            .EffectStmt(w: x) :> not
            .Defer(body: x) :> not
            .Fail(f: x) :> not
            .For(f: x) :> not
            .Break(label: x) :> not
            .Continue(label: x) :> not
            .Lift(what: x) :> not
            .LocalFn(f: x) :> not
        }
    }

    fn mkConst(s: AStmt, exported: boolean, name: string, ty: AType | not, init: AExpr, mutable: boolean) -> AConst {
        return { nid: s.nid, span: s.span, exported: exported, name: name, ty: ty, init: init, mutable: mutable }
    }

    // s479 (s479-file-scope-init) — `[export] let NAME[: T] = init;` at the top level of a
    // `${ }` logic block: a FILE-SCOPE `let`. SPEC §7.6: "A variable declared with `let` or
    // `const` at the top level of a file-level `${}` block SHALL be in scope for all
    // subsequent `${}` blocks and markup interpolations in the same file"; and (S478, rule
    // (c)) "A file-scope `let` is per-artifact state. A server function SHALL NOT write a
    // file-scope `let`" (analyze: E-FILE-SCOPE-LET-SERVER-WRITE). It is read exactly as a
    // `const` item is (the statement reader and its `;` rule); its initializer is judged by
    // analyze's constPass as a constant's is (rule (b): evaluated once at module
    // initialization in each artifact that reads or writes it). `let <x…/>` is a §66 cell
    // declaration, not this item: it keeps the by-name refusal below.
    fn parseLetItem(tp: TP, start: int, exported: boolean) -> RItems {
        if (tk(peekAt(tp, 1), "<")) return refusedLetItem(tp, start)
        const kw: PTok = cur(tp)
        const d0: int = hardErrors(tp.diags)
        if (destructDeclAhead(tp)) return refusedDestructItem(tp, d0, "a destructuring `let` at the top level of a logic block (module-level mutable state, as a file-scope `let` is)")
        const r: RStmt = parseLocal(tp)
        const t: TP = termAfter(r.tp, r.s, d0)
        const c: AConst | not = constOfStmt(r.s, exported)
        if (c is not) {
            const dt: TP = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a file-scope `let` bound to a value loop (`let xs = for … { lift … };`, §49.6) — the loop would run at module initialization, which the bootstrap does not build for a file-scope binding; compute the tape in a function and call it where it is needed", kw)
            return { items: [], tp: dt }
        }
        return mkItem(t, start, AItemK.ConstItem(c))
    }

    // s472 — a `let` at the top level of a `${ }` logic block was refused here by name
    // until s479 (parseLetItem builds it). What is left: `let <x…/>` — a §66 cell
    // declaration written inside a logic block — which the item reader does not read
    // (a cell is declared in the `<program>`). Refused BY NAME; the statement is still
    // read, so what follows parses.
    fn refusedLetItem(tp: TP, start: int) -> RItems {
        const kw: PTok = cur(tp)
        const d0: int = hardErrors(tp.diags)
        const r: RStmt = parseLocal(tp)
        const t: TP = termAfter(r.tp, r.s, d0)
        const d: TP = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a cell declaration (`let <x:T=…/>`, §66) at the top level of a `${ }` logic block is not in the bootstrap — declare the cell in the `<program>`, or write a file-scope `let x: T = …;` (§7.6) for per-artifact state", kw)
        return { items: [], tp: d }
    }

    // s478-boot-destructuring — a destructuring declaration as a logic-block item: read
    // past whole (its own pattern / value errors kept), refused by name (INTERIM).
    fn refusedDestructItem(tp: TP, d0: int, what: string) -> RItems {
        const kw: PTok = cur(tp)
        const rd: RStmts = parseDestructDecl(tp)
        const t: TP = termAfter(rd.tp, rd.ss[rd.ss.length - 1], d0)
        return { items: [], tp: diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", what + " is not in the bootstrap yet — destructure inside a function or handler body, or bind the value and read its fields (`const v = …;` then `v.a`)", kw) }
    }

    // Skip the rest of the current token's line (error recovery).
    fn skipToLineEnd(tp: TP) -> TP {
        const line: int = cur(tp).line
        let t: TP = adv(tp)
        while (!atEnd(t) && cur(t).line == line) { t = adv(t) }
        return t
    }

    // `import { a, b } from "…";` (§21.3) and — s472 — the host-import
    // declaration `import:<tag> { a, b as c } from "…"` (§21.3.1:
    // `host-import-decl ::= 'import:' host-tag import-clause 'from'
    // string-literal`, `host-tag ::= identifier`, `named-binding ::= identifier
    // ('as' identifier)?`). Placement, the tag and the manifest gate are
    // analyze's (checkImports); the parser records the tag and `top`.
    fn parseImport(tp: TP, start: int, top: boolean) -> RItems {
        const d0: int = hardErrors(tp.diags)
        let t: TP = adv(tp)
        let host: string | not = not
        if (isP(t, ":")) {
            t = adv(t)
            const tag: PTok = cur(t)
            if (tag.cls != TC.Ident && tag.cls != TC.Keyword) {
                const dt: TP = diagAt(t, "E-PARSE-IMPORT", "expected a host-tag after `import:` (`import:host { … } from \"…\"`, §21.3.1), found `" + tag.text + "`", tag)
                return { items: [], tp: skipToLineEnd(dt) }
            }
            host = tag.v
            t = adv(t)
        }
        // s474 — a namespace import (`import * as m from "…"`) or a default import
        // (`import X from "…"`) is reported BY NAME, its statement read whole (was a
        // wall of E-PARSE-IMPORT / E-PARSE-EXPECTED and a spurious E-IMPORT-005).
        // s474 r1 (#1715 review F3/F4, PA ruling):
        //   - a namespace import was INTERIM-refused (g-boot-namespace-import-unbuilt-s474);
        //     s475 builds it (ruling item 3, see PNs): `import * as m from "…"` binds
        //     `m` (AImport.ns); `m.x` names the module's export `x`;
        //   - a default import of a scrml module is E-IMPORT-004 — §21.3 resolves a
        //     default import "against the exporting file's export list", and no scrml
        //     form exports a default (§21.2). A default import of a JavaScript module
        //     (ES semantics, §21.3) is not in the bootstrap (E-BOOTSTRAP-UNSUPPORTED).
        // s474 r1 (F8): the statement is skipped to its `from "…"` across lines, or to
        // a `;` / the closing `}` of the enclosing block / the end — never past them.
        if (host is not && !isP(t, "{")) {
            const h: PTok = cur(t)
            const isNs: boolean = tk(h, "*")
            // a default import is a name followed by `from` or `,` — `import stuff` alone is no
            // import form at all, and keeps the ordinary parse errors
            const nx: TP = adv(t)
            const isDef: boolean = (h.cls == TC.Ident || h.cls == TC.Keyword) && (isWord(nx, "from") || isP(nx, ","))
            if (isNs || isDef) {
                let rt: TP = t
                let depth = 0
                let from0: string = ""
                let done = false
                while (!done && !atEnd(rt)) {
                    if (depth == 0 && isWord(rt, "from") && cur(adv(rt)).cls == TC.Str) {
                        from0 = cur(adv(rt)).v
                        rt = adv(adv(rt))
                        if (isP(rt, ";")) rt = adv(rt)
                        done = true
                    } else if (depth == 0 && isP(rt, ";")) {
                        rt = adv(rt)
                        done = true
                    } else if (depth == 0 && isP(rt, "}")) {
                        done = true
                    } else {
                        if (isP(rt, "{")) depth = depth + 1
                        if (isP(rt, "}")) depth = depth - 1
                        rt = adv(rt)
                    }
                }
                const scrmlSrc: boolean = from0.endsWith(".scrml") || from0.indexOf("scrml:") == 0
                // s475: `* as NAME` — the local name of a namespace import
                let ns: string = ""
                if (isNs) {
                    const asT: TP = adv(t)
                    const nmT: PTok = cur(adv(asT))
                    if (!isWord(asT, "as")) {
                        rt = diagAt(rt, "E-PARSE-IMPORT", "expected `as` after `import *` — a namespace import is written `import * as name from \"…\"` (§21.3)", cur(asT))
                    } else if (nmT.cls == TC.Keyword) {
                        rt = diagAt(rt, "E-PARSE-IMPORT", "`" + nmT.text + "` is a keyword and cannot be a local name — write another name after `as` (`import * as m from \"…\"`)", nmT)
                    } else if (nmT.cls != TC.Ident || !isWord(adv(adv(asT)), "from")) {
                        rt = diagAt(rt, "E-PARSE-IMPORT", "expected `import * as name from \"…\"` — one name after `as`, then `from` (§21.3)", nmT)
                    } else {
                        ns = nmT.v
                    }
                } else if (scrmlSrc || from0 == "") {
                    rt = diagAt(rt, "E-IMPORT-004", "`" + h.text + "`: a .scrml file has no default export — scrml files export names only (§21.2, §21.3); use `import { " + h.text + " } from \"…\"`", h)
                } else {
                    rt = diagAt(rt, "E-BOOTSTRAP-UNSUPPORTED", "a default import of a JavaScript module (`import " + h.text + " from \"" + from0 + "\"`) is not in the bootstrap yet — import a named export: `import { name } from \"" + from0 + "\"`", h)
                }
                if (from0 == "") {
                    if (isNs && ns != "") rt = diagAt(rt, "E-PARSE-IMPORT", "expected `from \"…\"` after `import * as " + ns + "`", h)
                    return { items: [], tp: rt }
                }
                const imp0: AImport = { nid: rt.nid, span: spanFrom(rt, start), names: [], from: from0, host: host, top: top, ns: ns, re: ALink.Import }
                return mkItem(bumpId(rt), start, AItemK.ImportItem(imp0))
            }
        }
        t = expectP(t, "{")
        // s474 r1 (F9): §21.3 "ES module `import` syntax" — specifiers are separated by
        // commas (`{ a, b as c, }`; a trailing comma is allowed). `{ a b }` / `{ a as b c }`
        // is E-PARSE-IMPORT (was: read as separate names).
        let names: AImportName[] = []
        let needComma = false
        while (!isP(t, "}") && !atEnd(t)) {
            const n: PTok = cur(t)
            if (tk(n, ",")) {
                if (!needComma) t = diagAt(t, "E-PARSE-IMPORT", "expected an imported name before `,`", n)
                needComma = false
                t = adv(t)
            } else if (needComma) {
                t = diagAt(t, "E-PARSE-IMPORT", "expected `,` or `}` after an import specifier, found `" + n.text + "` — specifiers are separated by commas (`import { a, b as c } from \"…\"`, §21.3)", n)
                while (!atEnd(t) && !isP(t, ",") && !isP(t, "}")) { t = adv(t) }
            } else if (n.cls == TC.Ident || n.cls == TC.Keyword) {
                let bound: PTok = n
                let bind = true
                t = adv(t)
                // `name as local` binds `local` to the exported `name` — a host import's
                // (§21.3.1 `named-binding ::= identifier ('as' identifier)?`) and, s474, a
                // plain import's (§21.3 "ES module `import` syntax"; §21.4 names the renamed
                // re-export `export { a as b } from`) (g-boot-import-codes-and-alias-s471)
                if (isWord(t, "as")) {
                    const loc: PTok = cur(adv(t))
                    if (loc.cls == TC.Keyword) {
                        // s474 r1 (F5): a local name is a binding — a keyword is no binding name
                        // (as `fn if` is E-PARSE-FN); the exported name may be one (a host export)
                        t = adv(adv(diagAt(t, "E-PARSE-IMPORT", "`" + loc.text + "` is a keyword and cannot be a local name — write another name after `as` (`import { " + n.text + " as other } from \"…\"`)", loc)))
                        bind = false
                    } else if (loc.cls == TC.Ident) {
                        bound = loc
                        t = adv(adv(t))
                    } else {
                        t = adv(diagAt(t, "E-PARSE-IMPORT", "expected the local name after `as`, found `" + loc.text + "` (`import { " + n.text + " as localName } from \"…\"`)", loc))
                    }
                }
                // §21.8.1 `import { name pinned }` — not in the bootstrap (named, not read as a name)
                if (isWord(t, "pinned")) {
                    t = adv(diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "`pinned` on an import (§21.8.1) is not in the bootstrap yet — drop it, or declare the cell in this file", cur(t)))
                }
                if (bind) names = names.concat([{ nid: t.nid, span: mkSpan(n.start, bound.end), name: bound.v, orig: n.v }])
                t = bumpId(t)
                needComma = true
            } else {
                t = adv(diagAt(t, "E-PARSE-IMPORT", "expected an imported name, found `" + n.text + "`", n))
            }
        }
        t = expectP(t, "}")
        if (!isWord(t, "from")) t = diagAt(t, "E-PARSE-IMPORT", "expected `from` after the import list", cur(t))
        t = adv(t)
        const src: PTok = cur(t)
        if (src.cls != TC.Str) t = diagAt(t, "E-PARSE-IMPORT", "expected the import source string", src)
        t = adv(t)
        // s469 — an `import` is a statement, not a closer-delimited item: it ends
        // with `;` (dpa-073 F3 (i); the DD's open question "are `import … from
        // \"x\"` … statements (`;`) or items? F3 (i) says statements")
        if (isP(t, ";")) {
            t = adv(t)
        } else if (hardErrors(t.diags) == d0) {
            t = missingSemi(t)
        }
        const imp: AImport = { nid: t.nid, span: spanFrom(t, start), names: names, from: src.v, host: host, top: top, ns: "", re: ALink.Import }
        return mkItem(bumpId(t), start, AItemK.ImportItem(imp))
    }

    // s478 (s478-boot-modules) — the EXPORT LISTS, `tp` on the `{` or `*` after
    // `export` (SPEC §21.4, ruling:user-voice-scrml.md S458 "ratify 21.4"):
    //   - `export { a, b as c } from "…";` — a named (and renamed) re-export:
    //     "Re-export follows standard ES module `export { name } from 'source'`
    //     syntax" (AImport.re Reexport);
    //   - `export * from "…";` — "A file MAY also re-export every name another
    //     file exports" (re ReexportAll);
    //   - `export { a, b as c };` — a local export list (§21.2 names it beside
    //     E-EXPORT-001, "`export { count }` in a `${ }` block"; re ExportList,
    //     `from` "").
    // Each is a statement and takes its `;`, as an `import` does (dpa-073 F3 (i)).
    // What the names resolve to is analyze's (checkImports, exportTables); a
    // re-export binds nothing in this file's scope. `export * as ns from "…"`
    // (ES2020) is not one of §21.4's forms: refused by name. Specifiers are
    // comma-separated, as an import's are (§21.3, s474 r1 F9).
    fn parseExportList(tp: TP, start: int, top: boolean) -> RItems {
        const d0: int = hardErrors(tp.diags)
        let t: TP = tp
        let re: ALink = ALink.Reexport
        let names: AImportName[] = []
        if (isP(t, "*")) {
            re = ALink.ReexportAll
            t = adv(t)
            if (isWord(t, "as")) {
                const d: TP = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "`export * as name from \"…\"` is not one of the re-export forms §21.4 defines (`export { a, b as c } from \"…\"`, `export * from \"…\"`) — re-export the names, or import the namespace where it is used (`import * as name from \"…\"`, §21.3)", cur(t))
                return { items: [], tp: skipToLineEnd(d) }
            }
        } else {
            t = adv(t)
            let needComma = false
            while (!isP(t, "}") && !atEnd(t)) {
                const n: PTok = cur(t)
                if (tk(n, ",")) {
                    if (!needComma) t = diagAt(t, "E-PARSE-EXPORT", "expected an exported name before `,`", n)
                    needComma = false
                    t = adv(t)
                } else if (needComma) {
                    t = diagAt(t, "E-PARSE-EXPORT", "expected `,` or `}` after an export specifier, found `" + n.text + "` — specifiers are separated by commas (`export { a, b as c } from \"…\"`, §21.4)", n)
                    while (!atEnd(t) && !isP(t, ",") && !isP(t, "}")) { t = adv(t) }
                } else if (n.cls == TC.Ident) {
                    let bound: PTok = n
                    let bind = true
                    t = adv(t)
                    // `name as other` exports `name` under `other` (§21.4: "renamed `export { a as b } from`")
                    if (isWord(t, "as")) {
                        const loc: PTok = cur(adv(t))
                        if (loc.cls == TC.Ident) {
                            bound = loc
                            t = adv(adv(t))
                        } else {
                            // a keyword is no exported name here — `default` included (§21.4: a re-export
                            // "SHALL NOT re-export `default`"; no scrml form has a default, §21.2)
                            t = adv(adv(diagAt(t, "E-PARSE-EXPORT", "expected the exported name after `as`, found `" + loc.text + "` (`export { " + n.text + " as otherName } …`; a keyword is not an exported name)", loc)))
                            bind = false
                        }
                    }
                    if (bind) names = names.concat([{ nid: t.nid, span: mkSpan(n.start, bound.end), name: bound.v, orig: n.v }])
                    t = bumpId(t)
                    needComma = true
                } else {
                    t = adv(diagAt(t, "E-PARSE-EXPORT", "expected an exported name, found `" + n.text + "`", n))
                }
            }
            t = expectP(t, "}")
        }
        let from: string = ""
        if (isWord(t, "from")) {
            t = adv(t)
            const src: PTok = cur(t)
            if (src.cls == TC.Str) {
                from = src.v
            } else {
                t = diagAt(t, "E-PARSE-EXPORT", "expected the re-export source string after `from`", src)
            }
            t = adv(t)
        } else if (re == ALink.ReexportAll) {
            t = diagAt(t, "E-PARSE-EXPORT", "expected `from \"…\"` after `export *` — a star re-export names its source (`export * from \"./m.scrml\";`, §21.4)", cur(t))
        } else {
            re = ALink.ExportList
        }
        if (isP(t, ";")) {
            t = adv(t)
        } else if (hardErrors(t.diags) == d0) {
            t = missingSemi(t)
        }
        if (re != ALink.ExportList && from == "") return { items: [], tp: t }
        const ex: AImport = { nid: t.nid, span: spanFrom(t, start), names: names, from: from, host: not, top: top, ns: "", re: re }
        return mkItem(bumpId(t), start, AItemK.ImportItem(ex))
    }

    // `type Name:enum = { A, B(f: T) }` / `type Name:struct = { [let] f: T, … }`
    fn parseTypeDecl(tp: TP, start: int, exported: boolean) -> RItems {
        let t: TP = adv(tp)
        const nameTok: PTok = cur(t)
        // s478 — the type alias `type Name = T` (§14.1.2: "type-alias right-hand
        // sides (`type A = Type`)"; §40.8: "a `type` alias ends where its type
        // expression ends (§7.5 `type-expr`, which has no juxtaposition — `type N
        // = number extra` compiles `number` only)"). Not a `type … = { … }`
        // declaration, so it is a statement that takes `;` (§7.2.2 rule 1).
        if (nameTok.cls == TC.Ident && isP(adv(t), "=")) {
            let d0: int = hardErrors(t.diags)
            const tyAt: TP = adv(adv(t))
            const ra: RType = parseType(tyAt)
            let at: TP = ra.tp
            const aty: AType = ra.t   // (a refused union keeps its first member, as parseOpenerType does)
            // s479 — a general union `A | B` (§7.5: `type-expr ::= … | type-expr '|' type-expr`)
            // is read whole and refused by name, as in an opener (parseOpenerType): the
            // bootstrap's type system has `T | not` only. Before, the reader stopped at the
            // `|` and reported a `;` owed after `A` — a wrong code on a valid alias.
            if (isP(at, "|")) {
                while (isP(at, "|")) {
                    const rm: RType = parseType(adv(at))
                    at = rm.tp
                }
                const ut: string = tokText(at, tyAt.i, at.i)
                const ud: Diag = newDiag("E-BOOTSTRAP-UNSUPPORTED", "the union type `" + ut + "` is not in the bootstrap — its type system has `T | not` only (§7.5 admits any union: `type-expr '|' type-expr`)", at.file, mkSpan(cur(tyAt).start, at.toks[at.i - 1].end))
                at = { toks: at.toks, i: at.i, nid: at.nid, diags: at.diags.concat([ud]), file: at.file, ns: at.ns, inFn: at.inFn }
                d0 = hardErrors(at.diags)
            }
            if (isP(at, ";")) {
                at = adv(at)
            } else if (hardErrors(at.diags) == d0) {
                at = aliasTrailing(missingSemi(at))
            }
            const ad: ATypeDecl = { nid: at.nid, span: spanFrom(at, start), exported: exported, name: nameTok.v, body: ATypeBody.AliasBody(aty) }
            return mkItem(bumpId(at), start, AItemK.TypeItem(ad))
        }
        t = expectP(adv(t), ":")
        const kind: PTok = cur(t)
        t = adv(t)
        if (kind.v == "host") {
            // s473 (§21.3.3 rule 15): "It SHALL appear only inside a `<host>`; anywhere else it SHALL be `E-HOST-TYPE-OUTSIDE`."
            t = diagAt(t, "E-HOST-TYPE-OUTSIDE", "`type " + nameTok.v + ":host` is written outside a `<host>` block — a host handle type is declared only inside one (§21.3.3 rule 15)", kind)
            const hd: ATypeDecl = { nid: t.nid, span: spanFrom(t, start), exported: exported, name: nameTok.v, body: ATypeBody.HostBody }
            return mkItem(bumpId(t), start, AItemK.TypeItem(hd))
        }
        t = expectP(t, "=")
        let body: ATypeBody = ATypeBody.StructBody([])
        if (kind.v == "enum") {
            const r: RVariants = parseVariants(t)
            body = ATypeBody.EnumBody(r.vs)
            t = r.tp
        } else if (kind.v == "struct") {
            const r2: RFields = parseTypeFields(expectP(t, "{"), "}")
            body = ATypeBody.StructBody(r2.fs)
            t = expectP(r2.tp, "}")
        } else if (kind.v == "error") {
            // s479 (§14.2, ruling S479 batch item 1): "There is no `:error` kind. Error types
            // are enum types (§19.1) … `type Name:error = { … }` is … `E-PARSE-TYPE` …, and the
            // message gives the enum form." The `{ … }` body is not parsed — it is skipped by
            // brace depth, so whatever it holds (fields, enum variants, garbage) is covered by
            // the one refusal (§40.8) and the item after it still parses. Parsing it as fields
            // cascaded on an enum-shaped body and ate the closing `}` (review #1966 MED-1).
            t = diagAt(t, "E-PARSE-TYPE", "`:error` is not a type kind — error types are enums (§19.1, §14.2): write `type " + nameTok.v + ":enum = { Failed(reason: string), … }`, with the data on payload fields of each variant", kind)
            if (isP(t, "{")) {
                t = skipBraceBody(t)
            }
        } else {
            // s479 — the refused declaration's rest is skipped (declRestEnd), not read as
            // statements at a body top (its region is one declaration, LexStop.Decl)
            t = declRestEnd(diagAt(t, "E-PARSE-TYPE", "expected `:enum` or `:struct`, found `:" + kind.text + "`", kind))
        }
        const td: ATypeDecl = { nid: t.nid, span: spanFrom(t, start), exported: exported, name: nameTok.v, body: body }
        return mkItem(bumpId(t), start, AItemK.TypeItem(td))
    }

    // s479 (r1 LOW-3) — the tokens after a type alias's missing `;` (`type N = number
    // extra`): S478 open-Qs ruling item 2 — "E-STMT-MISSING-SEMICOLON (after `number`
    // …; the bootstrap's E-PARSE-ITEM / E-PARSE-TYPE follow-ons on `extra` / `more
    // words` are a separate cascade to quiet)". The run of tokens on the alias's line
    // that cannot start a statement or item is skipped (aliasSkipEnd), and through a
    // `;` that ends it; reading resumes at the first token that can (`const`, `@n`,
    // a `<`, a `}` …), which is read as the statement that follows — §7.2.2 rule 7
    // ("`let a = 1 let b = 2;` is E-STMT-MISSING-SEMICOLON after `1`"): a valid
    // declaration after the alias on its line is still declared. The missing `;`
    // covers the skipped text with an error and names it (§40.8: "a statement whose
    // head expression was parsed as a valid prefix with the rest discarded is not
    // compiled unless an error reports the discarded text").
    fn aliasTrailing(tp: TP) -> TP {
        const from: int = tp.i
        if (atEnd(tp) || from == 0) return tp
        const line: int = tp.toks[from - 1].line
        let t: TP = aliasSkipEnd(tp, line, true)
        let unclosed = ""
        // a group opened in the skipped text and never closed (`type A = number extra(`):
        // the skip is bounded by the alias's line — no opener swallows the rest of the
        // region — and the report says so; a statement start after it is not hidden by it
        const g: string = openGroupOnLine(tp, from, t.i)
        if (g != "") {
            unclosed = g
            t = aliasSkipEnd(tp, line, false)
        }
        if (isP(t, ";")) t = adv(t)
        let to: int = t.i
        if (to > from && tk(t.toks[to - 1], ";")) to = to - 1
        if (to == from || t.diags.length == 0) return t
        const last: Diag = t.diags[t.diags.length - 1]
        if (last.code != "E-STMT-MISSING-SEMICOLON") return t
        let skipped: string = tokText(t, from, to)
        if (skipped.length > 48) skipped = skipped.substring(0, 45) + "…"
        let why: string = " The text after it, `" + skipped + "`, is not read: a `type` alias ends where its type expression ends (§40.8)"
        if (unclosed != "") why = why + ", and its `" + unclosed + "` is not closed"
        // s479 r2 (LOW-C) — §40.8: "a statement whose head expression was parsed as a valid
        // prefix with the rest discarded is not compiled unless an error reports the
        // discarded text". The report covers ALL of it: its span runs from the missing `;`
        // through the last skipped token, a skip that crosses lines names the line it ends
        // on and its last token, and every declaration inside the skipped text is named —
        // none of them is declared (g2: `extra(⏎ const QQZ = 1; … const QQW = 3;⏎)`).
        const endTok: PTok = t.toks[to - 1]
        if (endTok.line != line) why = why + "; the skipped text runs through the `" + endTok.text + "` on line " + endTok.line
        const swallowed: string = skippedDecls(t, from, to)
        if (swallowed != "") why = why + ", and the declarations in it (" + swallowed + ") are not declared"
        if (!atEnd(t) && cur(t).line == line && !closerAt(t)) why = why + "; `" + cur(t).text + "` is read as the statement that follows"
        const nd: Diag = newDiag(last.code, last.message + why + ".", last.file, mkSpan(last.span.start, endTok.end))
        return { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.slice(0, t.diags.length - 1).concat([nd]), file: t.file, ns: t.ns, inFn: t.inFn }
    }

    // s479 r2 (LOW-C) — the declarations in toks[from, to) (aliasTrailing's skipped
    // text), each as its keyword and name: "`const QQZ`, `function qqf`", or "".
    fn skippedDecls(tp: TP, from: int, to: int) -> string {
        let out: string = ""
        let i: int = from
        while (i + 1 < to) {
            const k: PTok = tp.toks[i]
            const n: PTok = tp.toks[i + 1]
            if ((k.cls == TC.Keyword || k.cls == TC.Ident) && ["const", "let", "function", "fn", "type"].indexOf(k.text) >= 0 && n.cls == TC.Ident) {
                if (out != "") out = out + ", "
                out = out + "`" + k.text + " " + n.text + "`"
            }
            i = i + 1
        }
        return out
    }

    // Past the tokens on `line` from `tp` that cannot start a statement or item: it stops
    // at the line's end, at a `;` (not past it), at a `}` / `)` / `]` closing an
    // enclosing group, and at a token that starts a statement or item (aliasStopAt).
    // With `groups`, a group opened in the run is skipped whole, to its closer
    // (`extra(a) const Q = 1;` resumes at `const`; the legacy `type Order = struct {
    // …⏎}` skips its braced body) — aliasTrailing re-reads by line when there is none.
    // A closer that does not match the innermost open group (the `}` of an enclosing
    // `${ … }` after `extra(`) ends the run there, the group left unclosed.
    fn aliasSkipEnd(tp: TP, line: int, groups: boolean) -> TP {
        let t: TP = tp
        let opens: string[] = []
        let going = true
        while (going && !atEnd(t) && (opens.length > 0 || cur(t).line == line)) {
            const c: PTok = cur(t)
            if (opens.length == 0 && (isP(t, ";") || closerAt(t) || aliasStopAt(t))) {
                going = false
            } else if (groups && closerAt(t)) {
                if (opens[opens.length - 1] == openerOf(c.text)) {
                    opens = opens.slice(0, opens.length - 1)
                    t = adv(t)
                } else {
                    going = false
                }
            } else {
                if (groups && (isP(t, "(") || isP(t, "[") || isP(t, "{"))) opens = opens.concat([c.text])
                t = adv(t)
            }
        }
        return t
    }

    fn openerOf(closer: string) -> string {
        if (closer == ")") return "("
        if (closer == "]") return "["
        return "{"
    }

    fn closerAt(tp: TP) -> boolean {
        return isP(tp, "}") || isP(tp, ")") || isP(tp, "]")
    }

    // The opener (`(` / `[` / `{`) of a group opened in toks[from, to) and not closed
    // there, or "".
    fn openGroupOnLine(tp: TP, from: int, to: int) -> string {
        let opens: string[] = []
        let i: int = from
        while (i < to) {
            const x: PTok = tp.toks[i]
            if (x.cls == TC.Punct && (x.text == "(" || x.text == "[" || x.text == "{")) opens = opens.concat([x.text])
            if (x.cls == TC.Punct && (x.text == ")" || x.text == "]" || x.text == "}") && opens.length > 0 && opens[opens.length - 1] == openerOf(x.text)) opens = opens.slice(0, opens.length - 1)
            i = i + 1
        }
        if (opens.length == 0) return ""
        return opens[0]
    }

    // A token that can start a statement or item after an alias (aliasSkipEnd): a
    // declaration or statement keyword, a cell (`@n = …`), a name written to (`x = …`,
    // the §50.8.5 keywordless form), a markup `<`, a `${`.
    // s479 r2 (NIT) — a name directly after `.` / `?.` is a member (`extra.qqb = 3`),
    // never a statement start. (LOW-B) — a `<` is markup only where the tokenizer's
    // tag-open rule reads one (lex.scrml markupOpensAt — the rule its startsMarkup ends a
    // code region by: `<` followed immediately by `/`, `!` or a letter; §4.18.1 "spaced
    // `< tag>` is text"); `x < y` is a comparison. (Not the free-text opensTag below: an
    // alias's text is a code region.)
    fn aliasStopAt(tp: TP) -> boolean {
        if (tp.i > 0) {
            const pv: PTok = tp.toks[tp.i - 1]
            if (pv.cls == TC.Punct && (pv.text == "." || pv.text == "?.")) return false
        }
        if (logicItemAhead(tp)) return true
        const c: PTok = cur(tp)
        if (c.cls == TC.At) return true
        if (c.cls == TC.Ident || c.cls == TC.Keyword) {
            if (["lin", "fail", "transaction", "lift", "return", "for", "while", "do", "break", "continue", "if", "given", "match", "server", "defer"].indexOf(c.v) >= 0) return true
            if (c.text == "$" && isP(adv(tp), "{")) return true
            if (c.cls == TC.Ident && isP(adv(tp), "=")) return true
        }
        if (isP(tp, "<")) {
            const nx: PTok = adv(tp).toks[adv(tp).i]
            return nx.start == c.end && nx.text.length > 0 && markupOpensAt(60, nx.text.charCodeAt(0))
        }
        return false
    }

    // Past the rest of a broken declaration's line (aliasTrailing; a declaration whose
    // kind is refused): its tokens up to (not past) a `}` / `)` / `]` closing an
    // enclosing group, and through a `;` that ends them. A group opened on the line is
    // skipped whole, to its closer, so no half of it is left to be read as statements.
    fn declRestEnd(tp: TP) -> TP {
        if (atEnd(tp) || tp.i == 0) return tp
        const line: int = tp.toks[tp.i - 1].line
        let t: TP = tp
        let depth: int = 0
        let going = true
        while (going && !atEnd(t) && (depth > 0 || cur(t).line == line)) {
            if (depth == 0 && isP(t, ";")) {
                t = adv(t)
                going = false
            } else if (depth == 0 && (isP(t, "}") || isP(t, ")") || isP(t, "]"))) {
                going = false
            } else {
                if (isP(t, "(") || isP(t, "[") || isP(t, "{")) depth = depth + 1
                if ((isP(t, ")") || isP(t, "]") || isP(t, "}")) && depth > 0) depth = depth - 1
                t = adv(t)
            }
        }
        return t
    }

    // s479 (review #1966 MED-1) — skip a `{ … }` body by brace depth, the current token
    // being its `{`. Depth is counted on tokens with `tk`, so a brace inside a string, a
    // comment (never a token) or a template slot is not counted. Stops after the matching
    // `}`; an unclosed `{` stops at the end of the token stream with one E-PARSE-EXPECTED.
    fn skipBraceBody(tp: TP) -> TP {
        const open: PTok = cur(tp)
        let t: TP = adv(tp)
        let depth: int = 1
        while (depth > 0 && !atEnd(t)) {
            const x: PTok = cur(t)
            if (x.cls == TC.Punct && tk(x, "{")) {
                depth = depth + 1
            } else if (x.cls == TC.Punct && tk(x, "}")) {
                depth = depth - 1
            }
            t = adv(t)
        }
        if (depth > 0) {
            t = diagAt(t, "E-PARSE-EXPECTED", "expected `}` closing the `{` opened here — the body runs to the end of the block", open)
        }
        return t
    }

    type RVariants:struct = { vs: AVariant[], tp: TP }
    type RFields:struct = { fs: ATypeField[], tp: TP }

    fn parseVariants(tp: TP) -> RVariants {
        let t: TP = expectP(tp, "{")
        let vs: AVariant[] = []
        while (!isP(t, "}") && !atEnd(t)) {
            const n: PTok = cur(t)
            if (n.cls == TC.Ident || n.cls == TC.Keyword) {
                t = adv(t)
                let fields: ATypeField[] = []
                if (isP(t, "(")) {
                    const r: RFields = parseTypeFields(adv(t), ")")
                    fields = r.fs
                    t = expectP(r.tp, ")")
                }
                vs = vs.concat([{ nid: t.nid, span: spanFrom(t, n.start), name: n.v, fields: fields }])
                t = bumpId(t)
            } else {
                if (!tk(n, ",")) t = diagAt(t, "E-PARSE-TYPE", "expected a variant name, found `" + n.text + "`", n)
                t = adv(t)
                // s478 (#1867 review F4) — the rest of a variant whose name failed to parse
                // (`Étoile`: the lexer stops at `É`, leaving `toile` touching it) is part of
                // that failed variant, not a variant of its own: it is skipped, so no second
                // report (E-ENUM-VARIANT-CASE "rename it `Toile`") is made on the leftover.
                if (!tk(n, ",")) {
                    let last: PTok = n
                    while (!atEnd(t) && !isP(t, "}") && !isP(t, ",") && !isP(t, "(") && cur(t).start == last.end) {
                        last = cur(t)
                        t = adv(t)
                    }
                    // and so is its payload, `Étoile(r: int)` — parsed for its own faults, dropped
                    if (isP(t, "(") && cur(t).start == last.end) {
                        const rf: RFields = parseTypeFields(adv(t), ")")
                        t = expectP(rf.tp, ")")
                    }
                }
            }
        }
        return { vs: vs, tp: expectP(t, "}") }
    }

    // `[let] name: Type` separated by commas, up to (not consuming) `close`.
    fn parseTypeFields(tp: TP, close: string) -> RFields {
        let t: TP = tp
        let fs: ATypeField[] = []
        while (!isP(t, close) && !atEnd(t)) {
            const fstart: int = cur(t).start
            let isLet = false
            if (isWord(t, "let")) {
                isLet = true
                t = adv(t)
            }
            const n: PTok = cur(t)
            if (n.cls != TC.Ident && n.cls != TC.Keyword) {
                t = diagAt(t, "E-PARSE-TYPE", "expected a field name, found `" + n.text + "`", n)
                t = adv(t)
            } else {
                t = expectP(adv(t), ":")
                const ty: RType = parseType(t)
                t = ty.tp
                // s478 — validator words after the type (`name: string req`, `role: Role
                // oneOf([.A, .B]) req` — §53.6.1, §41.15.6): read whole (a word, and its
                // `(…)` arguments), judged by analyze (fieldDefsOf).
                // S239 review of #1888 (MED-1): a validator word FOLLOWED BY `:` is
                // the next field's NAME (`{ a: int\n min: int }`, `{ a: int max: int }`
                // — §14.3.2 lets a newline separate fields), never a validator.
                let vals: string[] = []
                while ((cur(t).cls == TC.Ident || cur(t).cls == TC.Keyword) && isValidatorWord(cur(t).v) && !tk(peekAt(t, 1), ":")) {
                    vals = vals.concat([cur(t).v])
                    t = adv(t)
                    if (isP(t, "(")) t = skipParens(t)
                }
                fs = fs.concat([{ nid: t.nid, span: spanFrom(t, fstart), isLet: isLet, name: n.v, ty: ty.t, vals: vals }])
                t = bumpId(t)
            }
            if (isP(t, ",")) t = adv(t)
        }
        return { fs: fs, tp: t }
    }

    // A parameter list, up to (not including) its `)` — shared by `function` /
    // `fn` declarations and `<host>` binding lines (s473, §21.3.3: "param-list
    // … (* §7.5 param-decl, unchanged *)").
    type RParams:struct = { ps: AParam[], tp: TP }

    // s478 (s478-boot-refinement-runtime) — `own`: a function DECLARATION's
    // parameter (parseFnDecl) keeps a refinement at its type's top: §53.9.1 "The
    // compiler SHALL emit a runtime check when the function is called with an
    // unconstrained argument" — built (lower.scrml paramRefineChecks, the entry
    // check). Every other parameter list (a function expression, a `<host>`
    // binding) refuses it by name, as before (INTERIM).
    fn parseParamList(tp: TP, own: boolean) -> RParams {
        let t: TP = tp
        let params: AParam[] = []
        while (!isP(t, ")") && !atEnd(t)) {
            // s471 — `lin name: T` (§35.2.1: "parameter ::= ['lin'] identifier ':' type-annotation")
            const lt: PTok = cur(t)
            let isLin = false
            if (lt.cls == TC.Keyword && lt.v == "lin" && peekAt(t, 1).cls == TC.Ident) {
                isLin = true
                t = adv(t)
            }
            const p: PTok = cur(t)
            t = adv(t)
            let ty: AType | not = not
            if (isP(t, ":")) {
                const r: RType = parseTypeAt(adv(t), own)
                ty = r.t
                t = r.tp
            }
            params = params.concat([{ nid: t.nid, span: spanFrom(t, lt.start), name: p.v, ty: ty, lin: isLin }])
            t = bumpId(t)
            if (isP(t, ",")) t = adv(t)
        }
        return { ps: params, tp: t }
    }

    // s477 — the E-PARSE-FN text for a `:`-spelled return / error type.
    fn colonReturnMsg(name: string, failable: boolean) -> string {
        if (failable) return "a type after a parameter list is never introduced by `:` — a failable function names its error type `function " + name + "(…)! ErrorType { … }` or `function " + name + "(…)! -> ErrorType { … }` (§19.4.1; §7: `->` is the sole return-type annotation syntax)"
        return "a return type is written `-> T` (§7: \"`->` is the sole return-type annotation syntax\") — write `function " + name + "(…) -> T { … }`, not `(…): T`"
    }

    // `function name(p, q: T) { … }` / `fn name(p: T) -> T { … }`
    // s451 (U1a): `server` = written with the deprecated modifier; (Ue) a `!`
    // after the parameter list is a failable function, its error type `err`.
    fn parseFn(tp: TP, start: int, exported: boolean, pure: boolean, server: boolean) -> RItems {
        const r: RFnDecl = parseFnDecl(tp, start, exported, pure, server)
        return mkItem(r.tp, start, AItemK.FnItem(r.f))
    }

    // s477 — the declaration itself, shared by a function ITEM (parseFn) and a
    // NESTED declaration in a body (§7.3.1; parseStmt -> AStmtK.LocalFn). The
    // returned `tp` is past the function's own node id.
    type RFnDecl:struct = { f: AFn, tp: TP }

    fn parseFnDecl(tp: TP, start: int, exported: boolean, pure: boolean, server: boolean) -> RFnDecl {
        let t: TP = adv(tp)
        const nameTok: PTok = cur(t)
        if (nameTok.cls != TC.Ident) t = diagAt(t, "E-PARSE-FN", "expected a function name", nameTok)
        const rp: RParams = parseParamList(expectP(adv(t), "("), true)
        const params: AParam[] = rp.ps
        t = expectP(rp.tp, ")")
        // s451 (Ue) — §19.4.1 `failable-fn ::= 'function' identifier '('
        // param-list ')' '!' (('->' error-type) | error-type)? block`: after a
        // `!` an arrow names the ERROR type (there is no success-type slot).
        let failable = false
        let err: AType | not = not
        if (isP(t, "!")) {
            failable = true
            t = adv(t)
            const ea: PTok = cur(t)
            const eb: PTok = peekAt(t, 1)
            if (tk(ea, "-") && tk(eb, ">") && touching(ea, eb)) {
                const re: RType = parseType(adv(adv(t)))
                err = re.t
                t = re.tp
            } else if (isP(t, ":")) {
                // s477 — `)! : E`: a colon never introduces a type after a
                // parameter list (§7: "`->` is the sole return-type annotation
                // syntax"). Named, then the type read so the body parses.
                t = diagAt(t, "E-PARSE-FN", colonReturnMsg(nameTok.v, true), ea)
                const rc: RType = parseType(adv(t))
                err = rc.t
                t = rc.tp
            } else if (!isP(t, "{")) {
                const re2: RType = parseType(t)
                err = re2.t
                t = re2.tp
            }
        }
        let ret: AType | not = not
        const a: PTok = cur(t)
        const b: PTok = peekAt(t, 1)
        if (tk(a, "-") && tk(b, ">") && touching(a, b)) {
            if (failable) t = diagAt(t, "E-PARSE-FN", "a failable function has no success-type annotation (§19.4.1: `function " + nameTok.v + "(…)! ErrorType { … }` — its success type is inferred from its returns, §19.4.2)", a)
            const r2: RType = parseType(adv(adv(t)))
            if (!failable) ret = r2.t
            t = r2.tp
        } else if (isP(t, ":")) {
            // s477 (bryan S477 "⭐ RULED — tool main return type spelled ->"):
            // `): T` / `) : T` (any spacing, a newline included) is newly
            // rejected — §7: "`->` is the sole return-type annotation syntax
            // for `function` and `fn` declarations". A written type is never
            // dropped: it is named here, then read (and kept as the declared
            // return, so the body is judged as the author meant) — no cascade.
            t = diagAt(t, "E-PARSE-FN", colonReturnMsg(nameTok.v, failable), a)
            const rc2: RType = parseType(adv(t))
            if (!failable) ret = rc2.t
            t = rc2.tp
        }
        const n0: int = t.diags.length
        // §19.16.3 rule 4: "`defer` SHALL appear only inside the body of a function DECLARATION
        // … including any block nested in one" — the body is a defer site (TP.inFn, bareBlock)
        const body: RBlock = parseBlock(withInFn(t, fnBodyInFn(tp.inFn)))
        t = withInFn(body.tp, tp.inFn)
        // s469 — a declared-return (non-`void`, non-`!`) function whose body ENDS in a
        // pure expression: that is analyze's E-TYPE-043 ("ends in an expression it does
        // not `return`", §17.6) — the primary report, so the tail is not also NO-EFFECT
        if (ret is given && !voidType(ret)) t = dropTailNoEffect(t, body.b, n0)
        const f: AFn = { nid: t.nid, span: spanFrom(t, start), exported: exported, pure: pure,
                         name: nameTok.v, params: params, ret: ret, body: body.b, server: server, failable: failable, err: err }
        return { f: f, tp: bumpId(t) }
    }

    // =========================================================================
    // The MARKUP scanner (char level). State threaded like TP.
    // =========================================================================
    // s472 (S472 ruling Q3): `hoist` — the `function` / `fn` / `type` items
    // read in a `<db>` body (parseDbBody), waiting for the nearest item list
    // (parseMarkupItems drains them into the program body or the file top);
    // `dbFns` — which `<db>` each such function was declared in (FileAst.dbFns).
    type MP:struct = { src: string, pos: int, nid: int, diags: Diag[], file: string, hoist: AItem[], dbFns: ADbFn[], hosts: AHostBind[], pages: APage[], eps: AEndpoint[], chans: AChannel[], onchs: AOnchange[], schemaN: int, tables: SchemaTable[], ns: PNs }

    type RNodes:struct  = { nodes: ANode[], mp: MP }
    type RMItems:struct = { items: AItem[], mp: MP }
    type RValue:struct  = { v: AAttrValue, mp: MP }
    type RMType:struct  = { t: AType, mp: MP }
    type RWord:struct   = { w: string, mp: MP }

    fn chAt(mp: MP, k: int) -> string {
        const s: string = mp.src.charAt(mp.pos + k)
        return s
    }

    fn mEof(mp: MP) -> boolean { return mp.pos >= mp.src.length }

    // `#` followed by an opening brace: a CSS block (§5.6).
    fn atCss(mp: MP) -> boolean { return chAt(mp, 0) == "#" && chAt(mp, 1) == "{" }

    // s469 — a `#{…}` block (§9.1): read by css-syntax.scrml (CSS is a foreign
    // language, scanned at the character level — never by the scrml lexer),
    // its findings reported here. The node renders nothing; analyze's cssPass
    // decides which stylesheet it feeds.
    type RCss:struct = { n: ANode, mp: MP }

    fn parseCssNode(mp: MP) -> RCss {
        const r: CssParsed = parseCssBlock(mp.src, mp.pos, mp.nid)
        let m: MP = { src: mp.src, pos: r.end, nid: r.nid, diags: mp.diags, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
        for (const e of r.errs) { m = mDiag(m, e.code, e.text, e.start, e.end) }
        const n: ANode = { nid: m.nid, span: r.css.span, k: ANodeK.Css(r.css) }
        return { n: n, mp: mBump(m) }
    }

    fn lastEnd(tp: TP) -> int {
        const eof: PTok = tp.toks[tp.toks.length - 1]
        return eof.start
    }

    // `$` followed by an opening brace: a logic block / interpolation.
    fn atInterp(mp: MP) -> boolean { return chAt(mp, 0) == "$" && chAt(mp, 1) == "{" }

    fn mAdv(mp: MP, n: int) -> MP {
        return { src: mp.src, pos: mp.pos + n, nid: mp.nid, diags: mp.diags, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    fn mAt(mp: MP, pos: int) -> MP {
        return { src: mp.src, pos: pos, nid: mp.nid, diags: mp.diags, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    fn mBump(mp: MP) -> MP {
        return { src: mp.src, pos: mp.pos, nid: mp.nid + 1, diags: mp.diags, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    fn mDiag(mp: MP, code: string, msg: string, start: int, end: int) -> MP {
        const d: Diag = newDiag(code, msg, mp.file, mkSpan(start, end))
        return { src: mp.src, pos: mp.pos, nid: mp.nid, diags: mp.diags.concat([d]), file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    fn mLooking(mp: MP, s: string) -> boolean {
        const got: string = mp.src.substring(mp.pos, mp.pos + s.length)
        return got == s
    }

    fn isSpaceCh(c: string) -> boolean {
        return c == " " || c == "\t" || c == "\n" || c == "\r"
    }

    fn isNameCh(c: string) -> boolean {
        if (c == "") return false
        if (c >= "a" && c <= "z") return true
        if (c >= "A" && c <= "Z") return true
        if (c >= "0" && c <= "9") return true
        return c == "_" || c == "-" || c == "$"
    }

    fn isNameStart(c: string) -> boolean {
        if (c == "") return false
        if (c >= "a" && c <= "z") return true
        if (c >= "A" && c <= "Z") return true
        return c == "_"
    }

    // Skip whitespace, `//` line comments and `<!-- … -->` comments (§27).
    fn skipTrivia(mp: MP) -> MP {
        let m: MP = mp
        let going = true
        while (going && !mEof(m)) {
            if (isSpaceCh(chAt(m, 0))) {
                m = mAdv(m, 1)
            } else if (mLooking(m, "//")) {
                m = skipLineComment(m)
            } else if (mLooking(m, "<!--")) {
                m = skipMarkupComment(m)
            } else {
                going = false
            }
        }
        return m
    }

    // `//` to (not including) the line terminator — LF or CR (§4.7: "the next
    // `\n` or `\r\n`"; S444: in free text the terminator is content, §4.18.5).
    fn skipLineComment(mp: MP) -> MP {
        let m: MP = mp
        while (!mEof(m) && chAt(m, 0) != "\n" && chAt(m, 0) != "\r") { m = mAdv(m, 1) }
        return m
    }

    fn skipMarkupComment(mp: MP) -> MP {
        const close: int = mp.src.indexOf("-->", mp.pos + 4)
        if (close < 0) {
            const d: MP = mDiag(mp, "E-PARSE-COMMENT", "unterminated `<!--` comment", mp.pos, mp.src.length)
            return mAt(d, mp.src.length)
        }
        return mAt(mp, close + 3)
    }

    fn readName(mp: MP) -> RWord {
        let m: MP = mp
        while (!mEof(m) && isNameCh(chAt(m, 0))) { m = mAdv(m, 1) }
        return { w: mp.src.substring(mp.pos, m.pos), mp: m }
    }

    // Skip spaces/tabs/newlines only (inside an opener).
    fn skipSpace(mp: MP) -> MP {
        let m: MP = mp
        while (!mEof(m) && isSpaceCh(chAt(m, 0))) { m = mAdv(m, 1) }
        return m
    }

    // ---- lexing a logic region --------------------------------------------
    fn regionTP(mp: MP, stop: LexStop) -> TP {
        const run: LexRun = lexFrom(mp.src, mp.pos, stop)
        return { toks: nsToks(mp.ns, toPToks(run.tokens)), i: 0, nid: mp.nid, diags: mp.diags, file: mp.file, ns: mp.ns, inFn: 0 }
    }

    // A CODE-DEFAULT region (a `:`-shorthand body, a state-child body run).
    // RULED S444 ("standalone only, your rec"; SPEC §4.18.1 / §4.18.3): a `"…"`
    // is a display-text literal ONLY when it stands alone as the body statement
    // — the display-mode lex of the region is exactly one `"` string token.
    // Any other region (`@n == 5 ? "a\n" : "b"`, `f("x")`, `"a" + @b`) is
    // re-lexed with display off: its strings are ordinary strings with the
    // ordinary logic-string escapes.
    fn codeRegionTP(mp: MP, stop: LexStop) -> TP {
        const d: TP = regionTP(mp, stop)
        if (isStandaloneDisplay(d)) return d
        const run: LexRun = lexFromMode(mp.src, mp.pos, stop, false)
        return { toks: nsToks(mp.ns, toPToks(run.tokens)), i: 0, nid: mp.nid, diags: mp.diags, file: mp.file, ns: mp.ns, inFn: 0 }
    }

    fn isStandaloneDisplay(tp: TP) -> boolean {
        if (tp.toks.length != 2) return false
        const t: PTok = tp.toks[0]
        return t.cls == TC.Str && t.text.substring(0, 1) == "\""
    }

    // Back to markup after a region: the position after the region's last
    // consumed token (the Eof sentinel's start = where the lexer stopped).
    fn backToMarkup(mp: MP, tp: TP) -> MP {
        const eof: PTok = tp.toks[tp.toks.length - 1]
        return { src: mp.src, pos: eof.start, nid: tp.nid, diags: tp.diags, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    // After a region's expression: anything left before the Eof is an error.
    fn expectRegionEnd(tp: TP) -> TP {
        if (atEnd(tp)) return tp
        const t: PTok = cur(tp)
        return diagAt(tp, "E-PARSE-TRAILING", "unexpected `" + t.text + "` after the expression", t)
    }

    // ---- attribute values ---------------------------------------------------
    // At the char after `=`: "…" / '…' · ( expr ) · { stmts } · ${ … } · bare.
    // s469 — `handler`: the attribute is an event handler (`on…`), whose `{ … }`
    // value is a statement list (§5.2.3) — judged for E-STMT-NO-EFFECT, except
    // the one-name reference `{ f }` / `{ f; }` (§19.4.3 "Handler references":
    // the event CALLS `f`). Any other attribute's `{ … }` is not a statement
    // list (analyze refuses it, §5.2.4), so its statements are not judged.
    // s478 — `name`: the attribute's name (for the §5.2.4 diagnostic, which
    // "SHALL name the attribute"); `decl`: the value is a declaration's own value
    // or typed-attribute default (§66.2.4), where `${…}` is not a value form.
    fn parseAttrValue(mp: MP, handler: boolean, name: string, decl: boolean) -> RValue {
        const c: string = chAt(mp, 0)
        if (c == "\"" || c == "'") return parseQuoted(mp, c)
        if (!decl && isDurationAttr(name)) {
            const rd: RValue | not = parseDurationValue(mp, name)
            if (rd is given) return rd
        }
        if (c == "$" && chAt(mp, 1) == "{") return parseDollarValue(mp, handler, name, decl)
        if (c == "(") {
            const tp: TP = withInFn(regionTP(mp, LexStop.Balanced), 2)   // an attribute value is a lowered body (§19.16.3 rule 4)
            // §5.2.4: "in a `(…)` value … it detects statements separated by a
            // statement-level `;`" — a non-handler value is ONE expression
            if (!handler && parenHasStatements(tp)) return multiStatementValue(mp, backToMarkup(mp, endOfRegion(tp)), name, "(…)")
            const r: RExpr = parsePrimary(tp)
            const t2: TP = expectRegionEnd(r.tp)
            return { v: AAttrValue.Paren(r.e), mp: backToMarkup(mp, t2) }
        }
        if (c == "{") {
            const tp2: TP = withInFn(regionTP(mp, LexStop.Balanced), 2)
            const n0: int = tp2.diags.length
            const b: RBlock = parseBlock(tp2)
            let t3: TP = expectRegionEnd(b.tp)
            // §5.2.4: two or more statements in a non-handler `{…}` value
            if (!handler && !decl && isStatementList(tp2, b.b, t3)) return multiStatementValue(mp, backToMarkup(mp, t3), name, "{…}")
            if (!handler || oneNameBlock(b.b)) t3 = dropNoEffect(t3, n0)
            return { v: AAttrValue.Braced(b.b, ""), mp: backToMarkup(mp, t3) }
        }
        const tp3: TP = withInFn(regionTP(mp, LexStop.BareValue), 2)
        if (atEnd(tp3)) {
            const d: MP = mDiag(mp, "E-PARSE-ATTR", "expected an attribute value after `=`", mp.pos, mp.pos + 1)
            return { v: AAttrValue.NoValue, mp: d }
        }
        const r3: RExpr = parseAssign(tp3)
        // s478 r1 — the operand-owed refusal applies only to a value that does
        // not parse whole: a complete postfix form (`bad()?`, §19.5.4
        // propagation) is an expression and keeps its own diagnostics.
        if (r3.tp.diags.length > tp3.diags.length || !atEnd(r3.tp)) {
            const owed: string = operandlessEnd(tp3)
            if (owed != "") return operandlessValue(mp, tp3, handler, name, owed)
        }
        // §5.2.3 / §5.2.4: a `;` ending an unquoted value is reported by scanAttr
        // (bareSequence), which reads the rest of the sequence
        if (isP(r3.tp, ";")) return { v: AAttrValue.Bare(r3.e), mp: mAt(backToMarkup(mp, r3.tp), cur(r3.tp).start) }
        if (wordOperatorAt(r3.tp)) return trailingWordOperator(mp, r3.tp, handler, name)
        const t4: TP = expectRegionEnd(r3.tp)
        return { v: AAttrValue.Bare(r3.e), mp: backToMarkup(mp, t4) }
    }

    // s478 (boot-durations) — a DURATION value (§6.13.3, §51.12.3, §51.12.3.1):
    // the value of `debounced=` / `throttled=` (§6.13.1–2) and of `after=`
    // (§51.0.M `<onTimeout>`, §51.0.R `<onIdle>`). "DURATION SHALL match the
    // literal-form grammar (`Nms` / `Ns` / `Nm` / `Nh`) OR the computed-form
    // grammar (`${expr}<unit>`)" (§6.13.6). A number written with letters right
    // after it — `300ms`, `5m`, and a malformed `300sec` / `5` alike — or a
    // `${…}` followed by letters is read WHOLE as its text (AAttrValue.Dur); the
    // analyzer judges it (E-SYNTAX-DURATION for a form that does not parse,
    // §6.13.6 "SHALL produce a compile error"). Any other value (`=(…)`, a name,
    // a bare `${…}` with no unit) keeps its expression reading, and the analyzer
    // refuses it as a duration. Only on an attribute — never a declaration's own
    // value or a typed attribute's default (`decl`).
    fn isDurationAttr(name: string) -> boolean {
        return name == "debounced" || name == "throttled" || name == "after"
    }

    fn isDigitStr(c: string) -> boolean { return c != "" && c >= "0" && c <= "9" }

    fn parseDurationValue(mp: MP, name: string) -> RValue | not {
        const c: string = chAt(mp, 0)
        if (c == "$" && chAt(mp, 1) == "{") {
            const rv: RValue = parseDollarValue(mp, false, name, false)
            let k: int = 0
            while (isIdentStartCh(chAt(rv.mp, k)) || isDigitStr(chAt(rv.mp, k))) { k = k + 1 }
            if (k == 0) return not
            const m: MP = mAdv(rv.mp, k)
            return { v: AAttrValue.Dur(mp.src.substring(mp.pos, m.pos)), mp: m }
        }
        let i: int = 0
        if (c == "-" || c == "+") i = 1
        if (!isDigitStr(chAt(mp, i)) && !(chAt(mp, i) == "." && isDigitStr(chAt(mp, i + 1)))) return not
        while (isDigitStr(chAt(mp, i)) || chAt(mp, i) == ".") { i = i + 1 }
        let j: int = i
        while (isIdentStartCh(chAt(mp, j)) || isDigitStr(chAt(mp, j))) { j = j + 1 }
        // a bare number with no unit keeps its number reading (the analyzer:
        // "The unit suffix is required", §51.12.3)
        if (j == i) return not
        const m2: MP = mAdv(mp, j)
        return { v: AAttrValue.Dur(mp.src.substring(mp.pos, m2.pos)), mp: m2 }
    }

    // s478 r1 (#1865 F1) — the bare value's expression stopped at a word operator:
    // the keyword tests `is` / `instanceof` / `in` (§5.2: an unquoted value
    // "continues across whitespace … before … the keyword tests `is` /
    // `instanceof` / `in`") or a word-form `and` / `or` (§45.9: valid "in all
    // expression positions (… attribute values …)"). The value was read whole
    // across it, so it is one value, refused once:
    //   - any attribute but an event handler: "any other attribute followed by an
    //     operator … is `E-ATTR-UNQUOTED-OPERATOR`" (a condition too, cluster-A);
    //   - an event handler whose word has no right operand (`onclick=f() in>`):
    //     "A value that cannot be read whole is REFUSED, once per attribute, never
    //     truncated" — E-ATTR-UNQUOTED-OPERATOR;
    //   - an event handler's `and` / `or` WITH a right operand is a legal §45.9
    //     expression the bootstrap does not parse: refused by name (the
    //     refusals.scrml §45.9 row), never a generic E-PARSE-TRAILING. A handler's
    //     `in` / `instanceof` with an operand keeps the expression parser's report.
    fn wordOperatorAt(tp: TP) -> boolean {
        return isWord(tp, "in") || isWord(tp, "instanceof") || isWord(tp, "is") || isWord(tp, "and") || isWord(tp, "or")
    }

    fn trailingWordOperator(mp: MP, tp: TP, handler: boolean, name: string) -> RValue {
        const w: string = cur(tp).v
        const operand: boolean = peekAt(tp, 1).cls != TC.End
        if (handler && operand && w != "and" && w != "or") {
            const t5: TP = expectRegionEnd(tp)
            return { v: AAttrValue.Bare(recoveredAt(backToMarkup(mp, t5), mp.pos)), mp: backToMarkup(mp, t5) }
        }
        const d0: Diag[] = mp.diags
        const m: MP = withDiagsOf(backToMarkup(mp, endOfRegion(tp)), d0)
        const text: string = mp.src.substring(mp.pos, m.pos).trim()
        let md: MP = m
        if (handler && operand) {
            md = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`word-form `" + w + "`` (§45.9) is not in the bootstrap yet; it is refused here by name rather than misread — write `" + (w == "and" ? "&&" : "||") + "`: `" + name + "=" + text + "`", mp.pos, m.pos)
        } else if (handler) {
            md = mDiag(m, "E-ATTR-UNQUOTED-OPERATOR", "`" + name + "=" + text + "` — an unquoted event-handler value is read whole, and it ends in `" + w + "` with no right operand (§5.2). Complete the expression, write the handler as an inline block — `" + name + "={ … }` — or, if `" + w + "` is a separate attribute, parenthesize the value before it: `" + name + "=(…) " + w + "`", mp.pos, m.pos)
        } else {
            md = mDiag(m, "E-ATTR-UNQUOTED-OPERATOR", "`" + name + "=" + text + "` — an unquoted attribute value holds no operator, and `" + w + "` after it continues it as one (§5.1, §5.2). Parenthesize the expression — `" + name + "=(…)` — or quote it; if `" + w + "` is a separate attribute, parenthesize the value before it: `" + name + "=(…) " + w + "`", mp.pos, m.pos)
        }
        return { v: AAttrValue.Bare(recoveredAt(md, mp.pos)), mp: md }
    }

    // s478 (attr-operator-residue) — the bare value's last token is a punctuation
    // operator still owed its right operand (`title=@last + >`): the reader
    // stopped at the tag's `>` / `/>` (lex.scrml bareValueEnds — the tag's end
    // is never an operand). Returns the operator, or "" when the value ends
    // complete. Word operators (`in` / `is` / …) are trailingWordOperator's.
    fn operandlessEnd(tp: TP) -> string {
        if (tp.toks.length < 2) return ""
        const t: PTok = tp.toks[tp.toks.length - 2]
        if (t.cls == TC.Str) return ""
        for (const op of ["=", "==", "===", "!=", "!==", "+", "-", "*", "/", "%", "<", "<=", ">", ">=", "&&", "||", "??", "&", "|", "!", "?", ":", ".", "?.", "=>", "+=", "-=", "*=", "/=", "%=", "??=", "&&=", "||="]) {
            if (tk(t, op)) return op
        }
        return ""
    }

    // §5.2 "An unquoted value is read WHOLE (S457)": "A value that cannot be read
    // whole is REFUSED, once per attribute, never truncated"; "any other
    // attribute followed by an operator (`title=@a + "x"`, …) is
    // `E-ATTR-UNQUOTED-OPERATOR`", and an event-handler expression before a
    // spaced `>` is `E-ATTR-UNQUOTED-OPERATOR` too. The value is recovered whole
    // and the tag's `>` left in place, so the rest of the file parses normally.
    fn operandlessValue(mp: MP, tp: TP, handler: boolean, name: string, op: string) -> RValue {
        const m: MP = withDiagsOf(backToMarkup(mp, endOfRegion(tp)), mp.diags)
        const text: string = mp.src.substring(mp.pos, m.pos).trim()
        let md: MP = m
        if (handler) {
            md = mDiag(m, "E-ATTR-UNQUOTED-OPERATOR", "`" + name + "=" + text + "` — an unquoted event-handler value is read whole, and it ends in `" + op + "` with no right operand (§5.2). Complete the expression, or write the handler as an inline block — `" + name + "={ … }`", mp.pos, m.pos)
        } else {
            md = mDiag(m, "E-ATTR-UNQUOTED-OPERATOR", "`" + name + "=" + text + "` — an unquoted attribute value holds no operator: it is an identifier, a member chain or a call (§5.1, §5.2), and this one ends in `" + op + "` with no right operand. Parenthesize the expression — `" + name + "=(…)` — or quote it", mp.pos, m.pos)
        }
        return { v: AAttrValue.Bare(recoveredAt(md, mp.pos)), mp: md }
    }

    // The region's tokens all consumed (at its Eof).
    fn endOfRegion(tp: TP) -> TP {
        return { toks: tp.toks, i: tp.toks.length - 1, nid: tp.nid, diags: tp.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // A `;` at the region's statement level (depth 1: directly inside its outer
    // `(…)`) with more of the value after it — two statements (§5.2.4: "A
    // trailing `;` after the one expression … does not make a second statement").
    fn parenHasStatements(tp: TP) -> boolean {
        let depth: int = 0
        let semi = false
        let i: int = 0
        while (i < tp.toks.length - 1) {
            const t: PTok = tp.toks[i]
            const opens: boolean = tk(t, "(") || tk(t, "[") || tk(t, "{") || t.cls == TC.TIStart
            const closes: boolean = tk(t, ")") || tk(t, "]") || tk(t, "}") || t.cls == TC.TIEnd
            if (semi && depth == 1 && !closes) return true
            if (opens) {
                depth = depth + 1
            } else if (closes) {
                depth = depth - 1
                if (depth == 0) return false
            } else if (depth == 1 && tk(t, ";")) {
                semi = true
            }
            i = i + 1
        }
        return false
    }

    // s478 — §5.2.4 (S450): "A `(…)`, `{…}` or `${…}` value of an attribute that
    // is not an event handler … SHALL be exactly one expression. When it holds
    // two or more statements, the compiler SHALL report E-ATTR-MULTI-STATEMENT
    // (an error) — never silently keep one statement or drop the attribute", and
    // "The diagnostic SHALL name the attribute and SHALL give the fix". The value
    // is refused whole: what parsing its statements reported is dropped (the
    // refusal is the root cause), and it reaches analyze as a recovered value.
    // `effect=` is the §51.0.H engine logic block on an engine (not judged) and a
    // plain attribute elsewhere (judged) — the bootstrap builds neither reading,
    // so a statement list there is refused by name.
    fn multiStatementValue(mp: MP, after: MP, name: string, form: string) -> RValue {
        const m0: MP = withDiagsOf(after, mp.diags)
        let m: MP = m0
        if (name == "effect") {
            m = mDiag(m0, "E-BOOTSTRAP-UNSUPPORTED", "`effect=" + form + "` holding a statement list — an engine's `effect=` logic block (§51.0.H) is not in the bootstrap, and on any other element `effect=` is a plain attribute whose value is one expression (§5.2.4, E-ATTR-MULTI-STATEMENT)", mp.pos, after.pos)
        } else {
            m = mDiag(m0, "E-ATTR-MULTI-STATEMENT", "`" + name + "=" + form + "` holds two or more statements — only an event handler takes a statement list (§5.2.3); every other attribute value is ONE expression (§5.2.4). Write a single expression, or move the statements into a function and use its result: `function compute() { … }` then `" + name + "=compute()`", mp.pos, after.pos)
        }
        return { v: AAttrValue.Paren(recoveredAt(m, mp.pos)), mp: mBump(m) }
    }

    fn withDiagsOf(mp: MP, ds: Diag[]) -> MP {
        return { src: mp.src, pos: mp.pos, nid: mp.nid, diags: ds, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    fn recoveredAt(mp: MP, start: int) -> AExpr {
        return { nid: mp.nid, span: mkSpan(start, mp.pos), k: AExprK.Recovered }
    }

    // s478 — `name=${ … }`, the §5.2.1 expression form. A value that "parses
    // whole as ONE expression is one expression" (§5.2.4) — a trailing `;`
    // included; anything else is the value's statement list.
    //   - a non-handler attribute: the one expression is the value — the same
    //     value as `name=(expr)` (Paren: one lowering, one escape path for every
    //     delimited expression value); two or more statements are
    //     E-ATTR-MULTI-STATEMENT.
    //   - an event handler (§5.2.1: "`onclick=${expr}` … SHALL use the `${...}`
    //     expression directly as the event handler, with `@var` references
    //     rewritten to reactive getters"): a statement list is the handler's
    //     statements (§5.2.4: "its inline block and `${…}` statement list are
    //     legal") — the inline block's value (Braced); one expression that is not
    //     a function is the compiler-written listener of §5.2 (S457: "a `${…}`
    //     value that is not itself a function"), read as `name=(expr)` is; a
    //     function with no parameters, `${() => e}`, is the listener itself and
    //     runs `e` — the same value as `name=(e)`. A function that takes the
    //     event object (`${(e) => …}`) or has a braced body is the
    //     function-values slice (g-bootstrap-function-values-slice-s451):
    //     REFUSED by name (E-BOOTSTRAP-UNSUPPORTED), never silently accepted.
    //   - a declaration's own value / attribute default (§66.2.4: "a literal or
    //     a plain `@ref`, written bare, or any other expression, PARENTHESIZED"):
    //     E-DECL-OPENER-EXPR-UNPARENTHESIZED.
    fn parseDollarValue(mp: MP, handler: boolean, name: string, decl: boolean) -> RValue {
        const start: int = mp.pos
        const tp: TP = withInFn(regionTP(mAdv(mp, 1), LexStop.Balanced), 2)   // §19.16.3 rule 4: a handler is a lowered body
        if (decl) {
            const md: MP = withDiagsOf(backToMarkup(mp, endOfRegion(tp)), mp.diags)
            const m: MP = mDiag(md, "E-DECL-OPENER-EXPR-UNPARENTHESIZED", "an opener value is a literal or a plain `@ref` written bare, or any other expression PARENTHESIZED — `=(…)`, not `=" + dollarOpen() + "…}` (§66.2.4)", start, md.pos)
            return { v: AAttrValue.Paren(recoveredAt(m, start)), mp: mBump(m) }
        }
        if (name == "effect") {
            // §51.0.H: on an engine opener / state-child `effect=${…}` is a logic
            // block that runs on entry; on any other element a plain attribute.
            // The parser cannot tell the two apart and the bootstrap builds the
            // engine block nowhere — refused by name rather than read as an attribute.
            const me: MP = withDiagsOf(backToMarkup(mp, endOfRegion(tp)), mp.diags)
            const m5: MP = mDiag(me, "E-BOOTSTRAP-UNSUPPORTED", "`effect=" + dollarOpen() + "…}` — an engine's `effect=` logic block (§51.0.H) is not in the bootstrap; on any other element `effect=` is a plain attribute, written `effect=(…)` (one expression, §5.2.4)", start, me.pos)
            return { v: AAttrValue.Paren(recoveredAt(m5, start)), mp: mBump(m5) }
        }
        // a handler value led by `if` / `match` is its statement (block-like, §7.2.2),
        // never a value-`if` / value `match` whose arms would be assignments
        const stmtLed: boolean = handler && (isWord(adv(tp), "if") || isWord(adv(tp), "match"))
        let one: RExpr | not = not
        if (!stmtLed) one = oneExprIn(tp)
        if (one is not && !stmtLed && !parenHasStatements(tp) && !stmtKeywordAt(adv(tp))) {
            // no statement separator and no statement keyword: the value is one
            // expression that does not parse — its own report, never a
            // statement-list reading (`${@s is .Busy}` is not two statements)
            one = exprWithErrors(tp)
        }
        if (one is not) {
            const n0: int = tp.diags.length
            const b: RBlock = parseBlock(tp)
            let t: TP = expectRegionEnd(b.tp)
            if (!handler) {
                // §5.2.4 "In a `${…}` / `{…}` value it detects ANY clean parse of two
                // or more statements" — clean: no error beyond a statement's
                // terminator (softError). A value whose statements do not parse
                // keeps what the parse reported (`${switch …}` is E-SWITCH-FORBIDDEN).
                const clean: boolean = hardErrors(t.diags) == hardErrors(tp.diags)
                if (b.b.stmts.length >= 2 && clean) return multiStatementValue(mp, backToMarkup(mp, t), name, dollarOpen() + "…}")
                const mb: MP = backToMarkup(mp, t)
                if (!clean) return { v: AAttrValue.Paren(recoveredAt(mb, start)), mp: mBump(mb) }
                // one statement that is not an expression (`${ const x = 1 }`)
                const m2: MP = mDiag(mb, "E-PARSE-ATTR", "`" + name + "=" + dollarOpen() + "…}` is ONE expression on an attribute that is not an event handler (§5.2.4) — write the expression alone", start, mb.pos)
                return { v: AAttrValue.Paren(recoveredAt(m2, start)), mp: mBump(m2) }
            }
            if (oneNameBlock(b.b)) t = dropNoEffect(t, n0)
            return { v: AAttrValue.Braced(b.b, ""), mp: backToMarkup(mp, t) }
        }
        const after: MP = backToMarkup(mp, one.tp)
        if (!handler) return { v: AAttrValue.Paren(one.e), mp: after }
        // s478 (s478-boot-block-lambda) — a BLOCK-bodied handler function that takes no
        // event, `${() => { … }}` / `${function () { … }}`: §5.2.1 "SHALL use the `${...}`
        // expression directly as the event handler" — the listener runs its statements,
        // the same value as the inline block `name={ … }` (§5.2.4).
        // s478 (s478-boot-fn-values) — one that TAKES THE EVENT, `${(e) => { … }}` /
        // `${(e) => expr}`: §5.2.1 "The expression form is required when: You need the event
        // object: `onclick=${(e) => handler(e, arg)}`", and §5.2 (S457) "A `${…}` value that IS
        // a function (`${(e) => …}`, …) is the listener itself and names its own parameter" —
        // the listener's statements, with `e` bound to the event (Braced's `ev`; what `e` may
        // be used for is analyze's, resolveEventUse). Built for an ARROW of ONE parameter: a
        // function expression's parameter SHALL carry `: T` (§7.5) and the event's type is not
        // a scrml type (§5.2 rule 2: "a parameter whose type is unwritten or is not a scrml
        // type (`e: Event`)"), and the SPEC does not say what a second parameter of a listener
        // holds (the platform passes one) — both refused by name.
        const blk: RBlockLam | not = blockLambdaOf(one.e)
        if (blk is given) {
            if (blk.arity == 1 && !blk.via && !oneNameBlock(blk.body)) return { v: AAttrValue.Braced(blk.body, blk.names[0]), mp: after }
            if (blk.arity > 0) {
                const mb3: MP = mDiag(after, "E-BOOTSTRAP-UNSUPPORTED", eventFnRefusal(name, blk.arity, blk.via, true), start, after.pos)
                return { v: AAttrValue.Paren(recoveredAt(mb3, start)), mp: mBump(mb3) }
            }
            return { v: AAttrValue.Braced(blk.body, ""), mp: after }
        }
        const lam: RLam | not = lambdaOf(one.e)
        if (lam is not) return { v: AAttrValue.Paren(one.e), mp: after }
        if (lam.params.length == 1 && !isNameExpr(lam.body)) {
            // `(e) => expr` — the listener evaluates `expr` (its value is discarded): the one
            // statement `expr;`, as the block form `(e) => { expr; }` (two fresh node ids)
            const sn: int = after.nid
            const bk: ABlock = { nid: sn + 1, span: lam.body.span, stmts: [{ nid: sn, span: lam.body.span, k: AStmtK.Eval(lam.body) }] }
            return { v: AAttrValue.Braced(bk, lam.params[0]), mp: mBump(mBump(after)) }
        }
        if (lam.params.length > 1) {
            const m3: MP = mDiag(after, "E-BOOTSTRAP-UNSUPPORTED", eventFnRefusal(name, lam.params.length, false, false), start, after.pos)
            return { v: AAttrValue.Paren(recoveredAt(m3, start)), mp: mBump(m3) }
        }
        if (isNameExpr(lam.body)) {
            const m4: MP = mDiag(after, "E-BOOTSTRAP-UNSUPPORTED", "`" + name + "=" + dollarOpen() + "(…) => f}` — an arrow handler whose body is a bare name RETURNS the function without calling it, and a function value is not in the bootstrap (g-bootstrap-function-values-slice-s451). Call it — `" + name + "=" + dollarOpen() + "() => f()}` — or wire it directly: `" + name + "=f`", start, after.pos)
            return { v: AAttrValue.Paren(recoveredAt(m4, start)), mp: mBump(m4) }
        }
        return { v: AAttrValue.Paren(lam.body), mp: after }
    }

    // s478 (s478-boot-fn-values) — why a `${…}` handler FUNCTION is refused: built for an
    // arrow of one parameter, the event (§5.2.1); a block arrow whose body is one bare name
    // evaluates the function without calling it (`(e) => { f }`).
    fn eventFnRefusal(name: string, arity: int, via: boolean, block: boolean) -> string {
        let form: string = "(…) => …"
        if (block) form = "(…) => { … }"
        if (via) form = "function (…) { … }"
        let why: string = "a handler function of " + arity + " parameters — the listener receives ONE argument, the event object, and the SPEC does not say what a second parameter holds (§5.2.1)"
        if (via) {
            why = "a function EXPRESSION that takes the event — its parameter SHALL carry `: T` (§7.5), and the event's type is not a scrml type (§5.2 rule 2, `e: Event`); write the arrow form `" + name + "=" + dollarOpen() + "(e) => { … }}`"
        } else if (arity == 1) {
            why = "an arrow handler whose body is a bare name evaluates the function without calling it — call it: `" + name + "=" + dollarOpen() + "(e) => { f(); }}`"
        }
        return "`" + name + "=" + dollarOpen() + form + "}` — " + why + " (bootstrap: g-bootstrap-function-values-slice-s451)"
    }

    // s478 (s478-boot-fn-values) — a block lambda's parameter names.
    fn aparamNames(ps: AParam[]) -> string[] {
        let out: string[] = []
        for (const p of ps) { out = out.concat([p.name]) }
        return out
    }

    fn dollarOpen() -> string { return "$" + "{" }

    // `{ expr }` read as one expression, its errors reported where they arise.
    fn exprWithErrors(tp: TP) -> RExpr {
        const t: TP = expectP(tp, "{")
        const r: RExpr = parseAssign(t)
        let t2: TP = r.tp
        if (isP(t2, ";")) t2 = adv(t2)
        t2 = expectRegionEnd(expectP(t2, "}"))
        return { e: r.e, tp: t2 }
    }

    // A statement keyword — the value is a statement list, not an expression.
    fn stmtKeywordAt(tp: TP) -> boolean {
        for (const w of ["if", "for", "while", "do", "const", "let", "var", "return", "given", "lift", "fail", "function", "fn", "switch", "try", "throw", "break", "continue", "defer", "match"]) {
            if (isWord(tp, w)) return true
        }
        return false
    }

    // §5.2.4 for a non-handler `{…}` value: two or more statements, parsed clean
    // (no error beyond a terminator), written as a list — a statement-level `;`
    // or a statement keyword — not one expression the parser could not read.
    fn isStatementList(tp: TP, b: ABlock, after: TP) -> boolean {
        if (b.stmts.length < 2) return false
        if (hardErrors(after.diags) != hardErrors(tp.diags)) return false
        return parenHasStatements(tp) || stmtKeywordAt(adv(tp))
    }

    // `{ expr }` / `{ expr; }` — the whole region one expression, else `not`.
    // (A braced-arrow body is reported by parseLambda, and still one expression.)
    fn oneExprIn(tp: TP) -> RExpr | not {
        if (!isP(tp, "{")) return not
        const t: TP = adv(tp)
        if (isP(t, "}") || isP(t, ";")) return not
        const r: RExpr = parseAssign(t)
        let t2: TP = r.tp
        if (isP(t2, ";")) t2 = adv(t2)
        if (!isP(t2, "}")) return not
        t2 = adv(t2)
        if (!atEnd(t2)) return not
        return { e: r.e, tp: t2 }
    }

    type RLam:struct = { params: string[], body: AExpr }

    // s478 — a block-bodied lambda's arity and body, else `not`.
    type RBlockLam:struct = { arity: int, body: ABlock, names: string[], via: boolean }

    fn blockLambdaOf(e: AExpr) -> RBlockLam | not {
        const k: AExprK = e.k
        return match k {
            .BlockLambda(params: ps, body: b, viaFunction: vf) :> { arity: ps.length, body: b, names: aparamNames(ps), via: vf }
            .Lambda(params: ps) :> not
            .Name(name: n) :> not
            .Recovered :> not
            .Sql(q: q) :> not
            .Template(quasis: qs) :> not
            .HashRef(id: hr0) :> not
            .Foreign(f: fb0) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Handled(h: h) :> not
        }
    }

    fn lambdaOf(e: AExpr) -> RLam | not {
        const k: AExprK = e.k
        return match k {
            .Lambda(params: ps, body: b) :> { params: ps, body: b }
            .Name(name: n) :> not
            .Recovered :> not
            .Sql(q: q) :> not
            .Template(quasis: qs) :> not
            .HashRef(id: hr0) :> not
            .Foreign(f: fb0) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Handled(h: h) :> not
            .BlockLambda(params: ps) :> not
        }
    }

    fn isNameExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        if (k is .Name) return true
        return false
    }

    // An event-handler attribute name (§5.2 rule 1 — analyze's rule: `on…`,
    // except the non-event words `one`, `online`, `onboarding`).
    fn isHandlerName(n: string) -> boolean {
        if (n == "one" || n == "online" || n == "onboarding") return false
        return n.length > 2 && n.substring(0, 2) == "on"
    }

    // A braced handler body that is one bare name (`{ f }`, `{ f; }`) — a
    // handler REFERENCE (analyze `blockReference`).
    fn oneNameBlock(b: ABlock) -> boolean {
        if (b.stmts.length != 1) return false
        const x: AExpr | not = stmtExpr(b.stmts[0])
        if (x is not) return false
        const k: AExprK = x.k
        return match k {
            .Name(name: n) :> true
            .Recovered :> false
            .Sql(q: q) :> false
            .Template(quasis: qs) :> false
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .BlockLambda(params: ps) :> false
            .Handled(h: h) :> false
        }
    }

    // s469 — one report per refused statement: a parse-phase E-STMT-NO-EFFECT whose
    // statement a LATER phase already refuses — E-BOOTSTRAP-UNSUPPORTED, or a scope
    // error (E-SCOPE-*), reported inside its span — is dropped (the refusal is the
    // root cause; `(x) => x;`, `bump;` naming a function, an undeclared `y;`).
    // The front end's driver applies it to the parse diagnostics (slice-m2/lowered.js).
    export fn withoutRefusedNoEffect(parsed: Diag[], later: Diag[]) -> Diag[] {
        let out: Diag[] = []
        for (const d of parsed) {
            let keep = true
            if (d.code == "E-STMT-NO-EFFECT" && d.message.indexOf(bodyTopForms()) < 0) {
                for (const a of later) {
                    const refusal: boolean = a.code == "E-BOOTSTRAP-UNSUPPORTED" || a.code.substring(0, 8) == "E-SCOPE-"
                    if (refusal && a.file == d.file && a.span.start >= d.span.start && a.span.end <= d.span.end) keep = false
                }
            }
            if (keep) out = out.concat([d])
        }
        return out
    }

    fn voidType(t: AType) -> boolean {
        const k: ATypeK = t.k
        return match k {
            .TName(name: n) :> n == "void"
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
            .TLife(pre: f, post: x) :> false
            .TRefine(base: b, pred: p) :> false
            .TFn(params: ps) :> false
        }
    }

    // `tp` without the E-STMT-NO-EFFECT report (made since `from`) on the LAST
    // statement of block `b`.
    fn dropTailNoEffect(tp: TP, b: ABlock, from: int) -> TP {
        if (b.stmts.length == 0) return tp
        const last: AStmt = b.stmts[b.stmts.length - 1]
        let ds: Diag[] = []
        let i: int = 0
        for (const d of tp.diags) {
            if (i < from || d.code != "E-STMT-NO-EFFECT" || d.span.end != last.span.end) ds = ds.concat([d])
            i = i + 1
        }
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: ds, file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // `tp` without the E-STMT-NO-EFFECT reports made since it had `from` diagnostics
    // (a region whose statements are not a statement list: see the callers).
    fn dropNoEffect(tp: TP, from: int) -> TP {
        let ds: Diag[] = []
        let i: int = 0
        for (const d of tp.diags) {
            if (i < from || d.code != "E-STMT-NO-EFFECT") ds = ds.concat([d])
            i = i + 1
        }
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: ds, file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    fn parseQuoted(mp: MP, q: string) -> RValue {
        let m: MP = mAdv(mp, 1)
        let text: string = ""
        while (!mEof(m) && chAt(m, 0) != q) {
            if (chAt(m, 0) == "\\" && !mEof(mAdv(m, 1))) {
                text = text + chAt(m, 1)
                m = mAdv(m, 2)
            } else {
                text = text + chAt(m, 0)
                m = mAdv(m, 1)
            }
        }
        if (mEof(m)) {
            const d: MP = mDiag(m, "E-PARSE-ATTR", "unterminated attribute string", mp.pos, m.pos)
            return { v: AAttrValue.Quoted(text, q == "'"), mp: d }
        }
        return { v: AAttrValue.Quoted(text, q == "'"), mp: mAdv(m, 1) }
    }

    // ---- opener types (char level): Name, Name[g, …][…], Name | not -------------
    //
    // s469 — a UNION in the type position (§66.2.4, S451: "a union type in an
    // opener is legal with `|`; a bootstrap rejection of it is a parser bug"),
    // spaced or not: `<g:Guess | not=…/>`, `<g:Guess|not/>`. No attribute
    // starts with `|`, so a `|` (not `||`) after a member, past any spaces,
    // always continues the type; the member after it ends where a member ends
    // (its name and `[…]`), and the opener goes on from there — `=`, `/>`,
    // `>`, or an attribute. `T | not` (either order) is the bootstrap's
    // TMaybe; any other union (`int | string`) is read whole, then refused —
    // the bootstrap type system has no general union.
    fn parseOpenerType(mp: MP) -> RMType {
        const start: int = mp.pos
        if (chAt(mp, 0) == "(") return openerLife(mp)
        const first: RMType = openerTypeMember(mp, "`:`")
        let m: MP = first.mp
        let ty: AType = first.t
        let members: int = 1
        let nots: int = 0
        let inner: AType = first.t
        if (isNotType(first.t)) nots = 1
        // review r1: a TAPE member (`Entry[free, append] | not`) is refused —
        // the grant checks do not see through `| not`, so `T[…] | not` would
        // let every write through. A member that failed to parse (`Guess |=`)
        // has its own E-PARSE-TYPE; no second report.
        let seqs: int = 0
        if (seqUnionCheck(first.t)) seqs = 1
        let blank = isBlankAType(first.t)
        // s478 — a refined member (§53.11: "A union with a refined member is checked by
        // testing the value against each member, so every member SHALL have a runtime
        // test"), and a map / set member `[K: V]` whose entries are refined (one with none)
        let refined: boolean = standingRefine(first.t)
        let untested: string = ""
        let going = true
        while (going) {
            const after: MP = skipSpace(m)
            if (chAt(after, 0) == "|" && chAt(after, 1) != "|" && chAt(skipSpace(mAdv(after, 1)), 0) == "[") {
                // a map / set member: read to its `]`; judged below
                const ms: MP = skipSpace(mAdv(after, 1))
                const mclose: int = bracketCloseCh(mp.src, ms.pos)
                let mend: int = mp.src.length
                if (mclose >= 0) mend = mclose + 1
                const mtext: string = mp.src.substring(ms.pos, mend)
                if (refinedEntries(mtext)) {
                    if (untested == "") untested = mtext
                } else {
                    m = mDiag(ms, "E-PARSE-TYPE", "expected a type after `|`", ms.pos, ms.pos + 1)
                }
                m = mBump(mAt(m, mend))
                members = members + 1
                blank = true
            } else if (chAt(after, 0) == "|" && chAt(after, 1) != "|") {
                const rm: RMType = openerTypeMember(skipSpace(mAdv(after, 1)), "`|`")
                if (standingRefine(rm.t)) refined = true
                m = rm.mp
                members = members + 1
                if (seqUnionCheck(rm.t)) seqs = seqs + 1
                if (isBlankAType(rm.t)) blank = true
                if (isNotType(rm.t)) {
                    nots = nots + 1
                } else {
                    inner = rm.t
                }
            } else {
                going = false
            }
        }
        const text: string = mp.src.substring(start, m.pos)
        if (untested != "" && !refined) m = mDiag(m, "E-PARSE-TYPE", "expected a type after `|`", start, m.pos)
        if (untested != "" && refined) {
            m = mDiag(m, "E-CONTRACT-002", "`" + text + "` has a refined member, so a value is checked against each member at run time — and the member `" + untested + "`, a map or set whose entries are refined, has no runtime test (§53.11: \"every member SHALL have a runtime test. The compiler SHALL emit E-CONTRACT-002 where such a union is declared when a member has none … A member SHALL NOT be admitted without a test\")", start, m.pos)
            ty = reportedRefine(ty)
        } else if (refined && members > 1 && !blank && !(members == 2 && nots == 1)) {
            // refused below (a general union); its refined member is not refused twice
            ty = reportedRefine(ty)
        }
        // (a blank member was reported by openerTypeMember: E-PARSE-TYPE)
        if (!blank && members > 1 && seqs > 0) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", seqUnionReason(text), start, m.pos)
        } else if (!blank && members == 2 && nots == 1) {
            ty = { nid: m.nid, span: mkSpan(start, m.pos), k: ATypeK.TMaybe(inner) }
            m = mBump(m)
        } else if (!blank && members > 1) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the union type `" + text + "` is not in the bootstrap — its type system has `T | not` only (§66.2.4 admits any union here, S451)", start, m.pos)
        }
        // The type's SPAN runs to the end of the type TEXT: a continuation the
        // slice cannot read (`fn()`) stays inside it, so the tag scanner's
        // error on it lies within this type's span and the typer does not
        // trust the type (the value that follows is not part of it).
        const end: int = typeTextEnd(mp.src, m.pos)
        if (end > m.pos) ty = { nid: ty.nid, span: mkSpan(start, end), k: ty.k }
        return { t: ty, mp: m }
    }

    // s475 (s475-boot-lifecycle-type) — a lifecycle type `(A to B)` in an opener,
    // at its `(`. §66.2.4 (amended S449, dialect ruling 4): "a refinement type
    // (§53) or a lifecycle type (§14.12) MAY stand bare … A `>` or `/` inside the
    // type's OWN parentheses … does not end the opener". So the reader runs to the
    // MATCHING `)` whatever is inside: spaces, `->`, a `/`. Inside: A (`not`, a
    // name, or a bare variant `.V`), the glyph `to` (or the legacy `->`), B (a
    // member: Name, Name[…]), `)`. A malformed inside is E-PARSE-TYPE and the
    // opener resumes after the `)` (no tag cascade). Whether the bootstrap
    // builds the lifecycle READ here is lifeRefusal (every position) and, for a
    // declaration's own type, analyze's lifeCellWhy (which cell).
    fn openerLife(mp: MP) -> RMType {
        const start: int = mp.pos
        const close: int = lifeCloseCh(mp.src, start)
        let m: MP = skipSpace(mAdv(mp, 1))
        let bad = false
        let arrow = false
        // A: up to a space, `)`, or the `->` glyph (a name may hold `-`: readName would eat it)
        const a0: int = m.pos
        let a1: int = a0
        if (chAt(m, 0) == ".") a1 = a1 + 1
        while (a1 < mp.src.length && isNameCh(mp.src.substring(a1, a1 + 1)) && mp.src.substring(a1, a1 + 2) != "->") a1 = a1 + 1
        const aText: string = mp.src.substring(a0, a1)
        let fromT: AType = { nid: m.nid, span: mkSpan(a0, a1), k: ATypeK.TName(aText) }
        m = mBump(mAt(m, a1))
        if (aText == "" || aText == ".") {
            m = mDiag(m, "E-PARSE-TYPE", "expected a lifecycle's first state after `(` — `(not to T)` (§14.12)", a0, a0 + 1)
            bad = true
        }
        if (!bad) {
            m = skipSpace(m)
            if (chAt(m, 0) == "-" && chAt(m, 1) == ">") {
                arrow = true
                m = skipSpace(mAdv(m, 2))
            } else {
                const g: RWord = readName(m)
                if (g.w == "to" && (isSpaceCh(chAt(g.mp, 0)) || chAt(g.mp, 0) == "")) {
                    m = skipSpace(g.mp)
                } else {
                    m = mDiag(m, "E-PARSE-TYPE", "expected `to` in the lifecycle type — `(not to T)` (§14.12.2)", m.pos, m.pos + 1)
                    bad = true
                }
            }
        }
        let toT: AType = { nid: m.nid, span: mkSpan(m.pos, m.pos), k: ATypeK.TName("") }
        if (!bad && chAt(m, 0) == ".") {
            // B a bare variant `.V` (a variant progression: read, then refused by lifeRefusal)
            const vb: RWord = readName(mAdv(m, 1))
            toT = { nid: m.nid, span: mkSpan(m.pos, vb.mp.pos), k: ATypeK.TName("." + vb.w) }
            m = skipSpace(mBump(vb.mp))
        } else if (!bad) {
            const rb: RMType = openerTypeMember(m, "`to`")
            toT = rb.t
            m = rb.mp
            if (isBlankAType(toT)) bad = true     // openerTypeMember reported it: E-PARSE-TYPE
            // s478: a refinement as B — read whole (openerTypeMember), refused by name (one report)
            if (!bad && refineInside(toT) is given) {
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", lifeRefineWhy(), toT.span.start, toT.span.end)
                toT = reportedRefine(toT)
                bad = true
            }
            m = skipSpace(m)
        }
        if (!bad && chAt(m, 0) != ")") {
            const w: RWord = readName(m)
            if (chAt(m, 0) == "(") {
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", lifeRefineWhy(), m.pos, m.pos + 1)
            } else if (w.w == "to") {
                m = mDiag(m, "E-PARSE-TYPE", "a lifecycle chain `(A to B to C)` is not v1 scrml — a lifecycle has two states (§14.12.6.4)", m.pos, w.mp.pos)
            } else {
                m = mDiag(m, "E-PARSE-TYPE", "expected `)` to close the lifecycle type, found `" + chAt(m, 0) + "`", m.pos, m.pos + 1)
            }
            bad = true
        }
        if (close < 0) {
            if (!bad) m = mDiag(m, "E-PARSE-TYPE", "unterminated `(` in a lifecycle type", start, start + 1)
            bad = true
        } else {
            m = mAt(m, close + 1)
        }
        let pre: AType = fromT
        if (bad) pre = blankAType(fromT)     // as parseLifeType: no second report downstream
        let why: string = ""
        if (!bad) why = lifeRefusal(fromT, toT, arrow, mp.src.substring(start, m.pos))
        // s475-boot-request-followups (#1783 review LOW 2): a REFUSED lifecycle keeps a blank first
        // state too — one report per construct. Before, `<xs:(not to int[append])=not/>` was refused
        // here AND every `@xs.append(…)` was E-WRITE-NOT-GRANTED against a `(not to int[])` it
        // never declared (the grant list dropped from the type text).
        if (why != "") pre = blankAType(fromT)
        const ty: AType = { nid: m.nid, span: mkSpan(start, m.pos), k: ATypeK.TLife(pre, toT) }
        m = mBump(m)
        if (why != "") m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", why, start, m.pos)
        return { t: ty, mp: m }
    }

    fn isLifeAType(t: AType) -> boolean {
        return match t.k {
            .TName(name: n) :> false
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
            .TLife(pre: f, post: x) :> true
            .TRefine(base: b, pred: p) :> false
            .TFn(params: ps) :> false
        }
    }

    // Does `ds` hold a diagnostic inside `sp` (one report per construct)?
    fn hasDiagIn(ds: Diag[], sp: ASpan) -> boolean {
        for (const d of ds) {
            if (d.span.start >= sp.start && d.span.end <= sp.end) return true
        }
        return false
    }

    // The index of the `)` matching the `(` at `open`, or -1. s475 r1 (F3): a
    // `(` / `)` inside a `[…]` (a grant list) or a quoted string (a refinement's
    // `=="a)"`) does not count, so a malformed lifecycle cannot swallow the
    // markup after it. When a `[` or a quote never closes, the plain paren count
    // decides (the old reading — never a longer swallow than before).
    fn lifeCloseCh(src: string, open: int) -> int {
        const shielded: int = lifeCloseChIn(src, open, true)
        if (shielded >= 0) return shielded
        return lifeCloseChIn(src, open, false)
    }

    // s478 — the index of the `]` matching the `[` at `open` (quotes shielded), or -1.
    fn bracketCloseCh(src: string, open: int) -> int {
        let depth: int = 0
        let q: string = ""
        let i: int = open
        while (i < src.length) {
            const c: string = src.substring(i, i + 1)
            if (q != "") {
                if (c == "\\") {
                    i = i + 1
                } else if (c == q) {
                    q = ""
                }
            } else if (c == "\"" || c == "'" || c == "`") {
                q = c
            } else if (c == "[") {
                depth = depth + 1
            } else if (c == "]") {
                depth = depth - 1
                if (depth == 0) return i
            }
            i = i + 1
        }
        return -1
    }

    // s478 — does a map / set type's text `[K: V]` hold a refinement (`base(`)?
    fn refinedEntries(text: string) -> boolean {
        for (const b of ["number", "int", "integer", "string", "bool", "boolean"]) {
            if (text.indexOf(b + "(") >= 0) return true
        }
        return false
    }

    fn lifeCloseChIn(src: string, open: int, shield: boolean) -> int {
        let depth: int = 0
        let sq: int = 0
        let q: string = ""
        let i: int = open
        while (i < src.length) {
            const c: string = src.substring(i, i + 1)
            if (q != "") {
                if (c == "\\") {
                    i = i + 1
                } else if (c == q) {
                    q = ""
                }
            } else if (shield && (c == "\"" || c == "'" || c == "`")) {
                q = c
            } else if (shield && c == "[") {
                sq = sq + 1
            } else if (shield && c == "]" && sq > 0) {
                sq = sq - 1
            } else if (sq == 0 && c == "(") {
                depth = depth + 1
            } else if (sq == 0 && c == ")") {
                depth = depth - 1
                if (depth == 0) return i
            }
            i = i + 1
        }
        return -1
    }

    fn isSeqAType(t: AType) -> boolean {
        return match t.k {
            .TName(name: n) :> false
            .TSeq(elem: e) :> true
            .TMaybe(inner: i) :> false
            .TLife(pre: f, post: x) :> false
            .TRefine(base: b, pred: p) :> false
            .TFn(params: ps) :> false
        }
    }

    fn isBlankAType(t: AType) -> boolean {
        return match t.k {
            .TName(name: n) :> n == ""
            .TSeq(elem: e) :> isBlankAType(e)
            .TMaybe(inner: i) :> false
            .TLife(pre: f, post: x) :> false
            .TRefine(base: b, pred: p) :> false
            .TFn(params: ps) :> false
        }
    }

    fn isNotType(t: AType) -> boolean {
        return match t.k {
            .TName(name: n) :> n == "not"
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
            .TLife(pre: f, post: x) :> false
            .TRefine(base: b, pred: p) :> false
            .TFn(params: ps) :> false
        }
    }

    // One member of an opener type: Name, Name[g, …][…]. `after` names what the
    // member follows, for the message when it is missing.
    fn openerTypeMember(mp: MP, after: string) -> RMType {
        const start: int = mp.pos
        const nm: RWord = readName(mp)
        let m: MP = nm.mp
        if (nm.w == "") {
            m = mDiag(m, "E-PARSE-TYPE", "expected a type after " + after, start, start + 1)
        }
        // s478-ruled-fn-types r1 (review MED-2) — the RETIRED `fn(…)` spelling on a declaration
        // attribute (`<btn act:fn()/>`, §66): E-PARSE-TYPE naming the fix (§7.5 "Function types":
        // "the `fn(…)` spelling with no `=>` (`cb: fn()`) SHALL be a parse error, E-PARSE-TYPE, whose
        // message names the fix"). The `(…)` — and a glued `-> R` after it — is read past, so nothing
        // cascades; the type is blank (already reported).
        if (nm.w == "fn" && chAt(m, 0) == "(") {
            const fclose: int = lifeCloseCh(mp.src, m.pos)
            if (fclose >= 0) {
                m = mAt(m, fclose + 1)
                if (chAt(m, 0) == "-" && chAt(m, 1) == ">") {
                    const rr: RMType = openerTypeMember(mAdv(m, 2), "`->`")
                    m = rr.mp
                }
                m = mDiag(m, "E-PARSE-TYPE", "`fn(…)` is not a function type spelling (§7.5 \"Function types\", S478: `=>` is the one spelling). Write `(x: T) => R` — `() => void` for a function of no parameters that gives no value. (The bootstrap does not yet read a function type on a declaration attribute — INTERIM, g-boot-opener-fn-type-s478.)", start, m.pos)
                const bt: AType = { nid: m.nid, span: mkSpan(start, m.pos), k: ATypeK.TName("") }
                return { t: bt, mp: mBump(m) }
            }
        }
        let ty: AType = { nid: m.nid, span: mkSpan(start, m.pos), k: ATypeK.TName(nm.w) }
        m = mBump(m)
        // s478 — a refinement `base(pred)` (§53.2.1). §66.2.4: "a refinement type (§53)
        // … MAY stand bare … A `>` or `/` inside the type's OWN parentheses … does not
        // end the opener" — the predicate runs to the MATCHING `)`.
        if (refinableBase(nm.w) && chAt(m, 0) == "(") {
            const baseTy: AType = ty
            const rclose: int = lifeCloseCh(mp.src, m.pos)
            if (rclose < 0) {
                m = mDiag(m, "E-CONTRACT-002", "the inline predicate after `" + nm.w + "` is malformed (an unclosed `(`), so it cannot be enforced (§53.11)", m.pos, m.pos + 1)
                m = mAt(m, mp.src.length)
                ty = { nid: m.nid, span: mkSpan(start, m.pos), k: ATypeK.TRefine(ty, "") }
            } else {
                const pred: string = mp.src.substring(m.pos + 1, rclose)
                const j: RefJudge = judgeRefine(nm.w, pred)
                let p: string = pred
                m = mAt(m, rclose + 1)
                if (j.code != "") {
                    m = mDiag(m, j.code, j.msg, start, m.pos)
                    p = ""
                }
                ty = { nid: m.nid, span: mkSpan(start, m.pos), k: ATypeK.TRefine(ty, p) }
                // S239 review of #1888 (LOW-1) — a constraint label `[name]` (§53.2.3)
                if (chAt(m, 0) == "[") {
                    const lclose: int = mp.src.indexOf("]", m.pos)
                    const lw: string = mp.src.substring(m.pos + 1, lclose)
                    if (lclose > m.pos && isLabelText(lw) && !isGrantText(lw)) {
                        m = mAt(m, lclose + 1)
                        if (p != "") m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", refLabelMsg(nm.w + "(" + pred + ")", lw), start, m.pos)
                        ty = { nid: m.nid, span: mkSpan(start, m.pos), k: ATypeK.TRefine(baseTy, "") }
                    }
                }
            }
            m = mBump(m)
        }
        while (chAt(m, 0) == "[") {
            const close: int = mp.src.indexOf("]", m.pos)
            let inner: string = ""
            if (close < 0) {
                m = mDiag(m, "E-PARSE-TYPE", "unterminated `[` in a type", m.pos, m.pos + 1)
                m = mAt(m, mp.src.length)
            } else {
                inner = mp.src.substring(m.pos + 1, close)
                m = mAt(m, close + 1)
            }
            ty = { nid: m.nid, span: mkSpan(start, m.pos), k: ATypeK.TSeq(ty, grantWords(inner)) }
            m = mBump(m)
        }
        return { t: ty, mp: m }
    }

    // The first index at or after `pos` that ends an opener type's text:
    // whitespace, `=`, `/`, `>`, or the end of the source.
    fn typeTextEnd(src: string, pos: int) -> int {
        let i: int = pos
        while (i < src.length) {
            const c: string = src.substring(i, i + 1)
            if (isSpaceCh(c) || c == "=" || c == "/" || c == ">") return i
            i = i + 1
        }
        return i
    }

    fn grantWords(inner: string) -> string[] {
        let out: string[] = []
        for (const part of inner.split(",")) {
            const w: string = part.trim()
            if (w != "") out = out.concat([w])
        }
        return out
    }

    // =========================================================================
    // Openers. One scanner reads every opener; the parser then classifies it
    // (§66.2.2): a DECLARATION iff it has an own value (`=` after the name or
    // `name:Type`), an own type, or at least one typed attribute; otherwise a
    // USE (or, in a declaration body, a STATE-CHILD — O52 ruled). The marker
    // comes from the opener alone: a `let` written before the `<` (§66.2.5)
    // is attached AFTER classification (`withLet`), so `let <signup>` is a use
    // carrying a misplaced `let` (E-PARSE-LET), never a declaration.
    // =========================================================================
    type Opener:struct = {
        start: int,
        star: boolean,
        isLet: boolean,         // the `replace` grant: set by `withLet` from a `let` before the `<`; parseOpener sets it only for the S435 in-opener spelling it refuses (recovery)
        name: string,
        ty: AType | not,
        own: AAttrValue,
        typed: ADeclAttr[],
        attrs: AAttr[],
        selfClosing: boolean,
        short: ANode[] | not,
        vals: AValidator[],     // s444 Phase B: validator CALLS (`length(>=5)`); bare `req` stays in `attrs` until finishDecl
    }
    type ROpener:struct = { o: Opener, mp: MP }

    fn isNamespace(w: string) -> boolean {
        return w == "bind" || w == "class" || w == "style" || w == "internal" || w == "on"
    }

    // s478 (s478-boot-channel) — §38.3's attribute table names `onserver:open`,
    // `onserver:message`, `onserver:close`, `onclient:open`, `onclient:close` and
    // `onclient:error` (a function call each): an attribute name with a `:`, not a
    // typed attribute `onclient:<Type>` (§66.2.2). Not a §66.2.3 reserved namespace —
    // a declaration may still be named `onclient`; only the `name:sub=` attribute
    // spelling is read as the hook.
    fn isChannelHookNs(w: string) -> boolean {
        return w == "onclient" || w == "onserver"
    }

    fn hasOwn(v: AAttrValue) -> boolean {
        return match v {
            .NoValue :> false
            .Quoted(v: s) :> true
            .Dur(text: s) :> true
            .Bare(e: e) :> true
            .Paren(e: e) :> true
            .Braced(b: b) :> true
        }
    }

    fn isDeclOpener(o: Opener) -> boolean {
        if (o.star) return false
        if (o.ty is given) return true
        if (hasOwn(o.own)) return true
        return o.typed.length > 0
    }

    // The `replace` grant of a `let` written before the `<` (§66.2.5).
    fn withLet(o: Opener) -> Opener {
        return { start: o.start, star: o.star, isLet: true, name: o.name, ty: o.ty, own: o.own,
                 typed: o.typed, attrs: o.attrs, selfClosing: o.selfClosing, short: o.short, vals: o.vals }
    }

    // At `<` (not `</`, not `<!--`).
    fn parseOpener(mp: MP) -> ROpener {
        const r: RArmOpener = parseOpenerB(mp, false)
        return { o: r.o, mp: r.mp }
    }

    // s478 — an opener, and (`arm`: a block-form `<match>` arm, SPEC §18.0.1) the
    // positional payload binders `( … )` written right after the variant name:
    // "Payload variants destructure positionally: `<Ready(rows)>` binds `rows` for
    // that arm's body". Only there: anywhere else `(` in a tag is E-PARSE-TAG.
    type RArmOpener:struct = { o: Opener, binds: ABind[], parens: boolean, mp: MP }

    fn parseOpenerB(mp: MP, arm: boolean) -> RArmOpener {
        const start: int = mp.pos
        let m: MP = mAdv(mp, 1)
        let star = false
        if (chAt(m, 0) == "*") {
            star = true
            m = mAdv(m, 1)
        }
        let isLet = false
        let nm: RWord = readName(m)
        let kws: AAttr[] = []
        let kwPrefix = false
        if (nm.w == "export" && !star) {
            // `<export x…/>` / `<export let x…/>`: the keyword written inside the
            // opener — refused like `<let x/>` (never a tag named `export`)
            kwPrefix = true
            const after: MP = skipSpace(nm.mp)
            const wl: RWord = readName(after)
            let kw: string = "export"
            let endKw: int = nm.mp.pos
            nm = readName(after)
            if (wl.w == "let") {
                isLet = true
                kw = "export let"
                endKw = wl.mp.pos
                nm = readName(skipSpace(wl.mp))
            }
            kws = [{ nid: m.nid, span: mkSpan(start, endKw), name: kw, value: AAttrValue.NoValue }]
        } else if (nm.w == "let" && !star) {
            // S447 (§66.2.5, §66.20): the S435 in-opener prefix `<let x…/>` is
            // refused (reported below, once the opener is classified); `<let/>`
            // (no name) lands here too.
            isLet = true
            kwPrefix = true
            kws = [{ nid: m.nid, span: mkSpan(start, nm.mp.pos), name: "let", value: AAttrValue.NoValue }]
            nm = readName(skipSpace(nm.mp))
        }
        // s475 (ruling S475 item 3): `<m.card …>` / `<*m.card/>` — a dotted tag whose head is a
        // namespace import of this file names that module's member (PNs.names); any other dotted
        // tag keeps its old reading (`.` is not a tag-name character: E-PARSE-TAG below)
        if (chAt(nm.mp, 0) == "." && isIdentStartCh(chAt(nm.mp, 1)) && nm.w != "" && mp.ns.names.indexOf(nm.w) >= 0) {
            const mem: RWord = readName(mAdv(nm.mp, 1))
            nm = { w: nm.w + "." + mem.w, mp: mem.mp }
        }
        m = nm.mp
        if (nm.w == "" && !kwPrefix) m = mDiag(m, "E-PARSE-TAG", "expected a tag name after `<`", start, start + 1)
        let binds: ABind[] = []
        let parens = false
        if (arm && chAt(m, 0) == "(") {
            const rb: RArmBinds = parseArmBinds(m, nm.w)
            binds = rb.bs
            parens = true
            m = rb.mp
        }
        let ty: AType | not = not
        if (chAt(m, 0) == ":") {
            const rt: RMType = parseOpenerType(mAdv(m, 1))
            ty = rt.t
            m = rt.mp
        }
        let own: AAttrValue = AAttrValue.NoValue
        m = checkSpacedEq(m)
        if (chAt(m, 0) == "=") {
            const rv: RValue = parseAttrValue(mAdv(m, 1), false, nm.w, true)
            own = rv.v
            m = rv.mp
        }
        let typed: ADeclAttr[] = []
        let attrs: AAttr[] = []
        let selfClosing = false
        let short: ANode[] | not = not
        let vals: AValidator[] = []
        let rend: ASpan[] = []
        let going = true
        while (going) {
            m = skipSpace(m)
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-TAG", "unterminated tag `<" + nm.w + "`", start, m.pos)
                going = false
            } else if (chAt(m, 0) == ":" && isSpaceCh(chAt(m, -1))) {
                // §4.14: a whitespace-preceded `:` opens the `:`-shorthand body —
                // one expression, running to the `>` that ends the opener.
                const rs: RNodes = parseShorthand(m, nm.w)
                short = rs.nodes
                m = rs.mp
                going = false
            } else if (mLooking(m, "/>")) {
                selfClosing = true
                m = mAdv(m, 2)
                going = false
            } else if (chAt(m, 0) == ">") {
                m = mAdv(m, 1)
                going = false
            } else {
                const before: int = m.pos
                const ra: RAttrScan = scanAttr(m)
                m = ra.mp
                typed = typed.concat(ra.typed)
                attrs = attrs.concat(ra.attrs)
                vals = vals.concat(ra.vals)
                rend = rend.concat(ra.rend)
                kws = kws.concat(ra.kws)
                if (m.pos == before) {
                    m = mDiag(m, "E-PARSE-TAG", "unexpected `" + chAt(m, 0) + "` in the tag `<" + nm.w + "`", m.pos, m.pos + 1)
                    m = mAdv(m, 1)
                }
            }
        }
        // the marker comes from the opener alone (§66.2.2): a refused in-opener
        // `let` keeps its grant (recovery) only on a real declaration
        const marked: boolean = !star && (ty is given || hasOwn(own) || typed.length > 0)
        const o: Opener = { start: start, star: star, isLet: isLet && marked, name: nm.w, ty: ty, own: own,
                            typed: typed, attrs: attrs, selfClosing: selfClosing, short: short, vals: vals }
        for (const k of kws) { m = keywordInOpener(m, k.name, nm.w, marked, k.span) }
        if (!isDeclOpener(o)) m = repeatedAttrDiags(m, o)
        m = quotedInterpDiags(m, o)
        for (const sp of rend) {
            if (isDeclOpener(o)) {
                m = mDiag(m, "E-DECL-RENDERS-IN-OPENER", "`renders` follows the closer (`/>` or `</>`) — close the opener, then write `renders <…>` after it (§66.5.1, S447)", sp.start, sp.end)
            } else {
                m = mDiag(m, "E-PARSE-TAG", "a markup element cannot stand inside the opener of `<" + nm.w + ">` — `renders <…>` is a declaration's clause, written after its closer (§66.5.1)", sp.start, sp.end)
            }
        }
        return { o: o, binds: binds, parens: parens, mp: m }
    }

    // s478 — at the `(` after an arm's variant name: `name (, name)*` up to `)`
    // (SPEC §18.0.1 — positional, one name or `_` per payload field; the arity is
    // the analyzer's, E-TYPE-021 as for a `.V(…)` pattern, §18.7). §18.0.1 names the
    // parenthesized POSITIONAL form only ("the bare-attribute form (`<Ready rows>`)
    // and a named form (`<Ready rows=r>`) … do NOT appear on `<match>`
    // state-children"); a `field: x` entry, or anything else, is not defined there —
    // refused, and the scan resumes after the `)` (or at the opener's `>`).
    type RArmBinds:struct = { bs: ABind[], mp: MP }

    fn parseArmBinds(mp: MP, tag: string) -> RArmBinds {
        let m: MP = mAdv(mp, 1)
        let out: ABind[] = []
        let going = true
        while (going) {
            m = skipSpace(m)
            const c: string = chAt(m, 0)
            if (mEof(m) || c == ">") {
                m = mDiag(m, "E-PARSE-TAG", "the binder list of `<" + tag + "(…)>` is not closed with `)`", mp.pos, m.pos)
                going = false
            } else if (c == ")") {
                m = mAdv(m, 1)
                going = false
            } else {
                const w: RWord = readName(m)
                const after: MP = skipSpace(w.mp)
                const nc: string = chAt(after, 0)
                if (w.w != "" && isKeyword(w.w) && (nc == "," || nc == ")")) {
                    // §18.0: one AST with the plain match — a reserved word is no binder (the plain reader's E-PARSE-ARM)
                    m = mAt(mDiag(m, "E-PARSE-ARM", "expected a binder name (or `_`) in the pattern's `(…)`, found `" + w.w + "`", m.pos, w.mp.pos), after.pos)
                    if (nc == ",") m = mAdv(m, 1)
                } else if (w.w != "" && isIdentStartCh(w.w.substring(0, 1)) && (nc == "," || nc == ")")) {
                    const dup: boolean = binderRepeated(out, w.w)
                    const from: int = m.pos
                    out = out.concat([{ nid: m.nid, span: mkSpan(m.pos, w.mp.pos), name: w.w }])
                    m = mBump(after)
                    if (dup) m = mDiag(m, "E-SCOPE-REDECLARE", binderDupMsg(w.w, "<" + tag + "(…)>"), from, w.mp.pos)
                    if (nc == ",") m = mAdv(m, 1)
                } else {
                    // not a positional binder: refused by name, skipped to the `)`
                    const stop: int = armBindsEnd(m)
                    m = mDiag(mAt(m, stop), "E-BOOTSTRAP-UNSUPPORTED", "`<" + tag + "(…)>` binds its payload POSITIONALLY — one name (or `_`) per field, comma-separated: `<" + tag + "(a, b)>` (§18.0.1). A named entry (`field: x`), a nested pattern or a literal is not defined for a `<match>` arm", m.pos, stop)
                    if (chAt(m, 0) == ")") m = mAdv(m, 1)
                    going = false
                }
            }
        }
        return { bs: out, mp: m }
    }

    // The `)` that closes an arm's binder list, or the opener's `>` (not consumed).
    fn armBindsEnd(mp: MP) -> int {
        let m: MP = mp
        while (!mEof(m) && chAt(m, 0) != ")" && chAt(m, 0) != ">") { m = mAdv(m, 1) }
        return m.pos
    }

    // s451 (S239 review of #1254, MED) — an attribute written TWICE on one
    // non-declaration opener (`<p if=@a if=@b>`, `<p else else>`,
    // `class="a" class="b"`, `<program reset="none" reset="none">`, a
    // state-child, an `<effect>`, a `<*x>` reference): every reader takes the
    // first match, so the rest were silently dropped. Searched §4, §5, §24 and
    // §34 for a duplicate-attribute rule — the SPEC names none — so
    // E-BOOTSTRAP-UNSUPPORTED, by construction for EVERY name, at each repeat.
    // Names compare EXACTLY here: the parser cannot tell an HTML element from a
    // use of a declaration, whose attribute names are its field names (case-
    // sensitive — `a` and `A` are distinct fields). The case-insensitive HTML
    // repeat (`class` + `CLASS`) is analyze's attrCaseDiags (HTML elements)
    // and unknownProgramAttrDiag (`<program>`). A namespaced name is its own
    // name: `class` and `class:active` are distinct. Declaration openers are
    // judged by analyze (repeatedWordDiags), which knows their validators.
    fn repeatedAttrDiags(mp: MP, o: Opener) -> MP {
        let m: MP = mp
        let seen: string[] = []
        for (const a of o.attrs) {
            if (seen.indexOf(a.name) >= 0) {
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is written twice on `<" + o.name + ">` — the bootstrap reads one, so the other would be silently dropped; the SPEC names no rule for a repeated attribute, so it is refused: write it once", a.span.start, a.span.end)
            }
            seen = seen.concat([a.name])
        }
        return m
    }

    // s451 fix round (S239 LOW-2) — §5.5.3: "The `${...}` interpolation inside a
    // quoted attribute value SHALL be recognized by the compiler" and compiled
    // as a reactive template (§1626: `attr="${@x}"` is "already
    // template-string-shaped"). The bootstrap parses a quoted value as literal
    // text, so `title="t${@x}"` used to be EMITTED LITERALLY. Not implemented
    // → refused, on every opener (element, use, declaration, `<program>`), for
    // every attribute and a declaration's own value.
    fn quotedInterpDiags(mp: MP, o: Opener) -> MP {
        let m: MP = mp
        for (const a of o.attrs) {
            if (quotedHasInterp(a.value) && executableByName(a.name)) {
                m = executableInterpDiag(m, a.name, o.name, a.span)
            } else {
                m = quotedInterpDiag(m, a.name, a.value, a.span)
            }
        }
        m = quotedInterpDiag(m, o.name, o.own, mkSpan(o.start, o.start + o.name.length + 1))
        return m
    }

    fn quotedHasInterp(v: AAttrValue) -> boolean {
        return match v {
            .Quoted(v: x) :> x.indexOf("$" + "{") >= 0
            .Dur(text: x) :> false            // s478: a computed DURATION `${…}ms` is judged by the analyzer (durationOf)
            .NoValue :> false
            .Bare(e: x) :> false
            .Paren(e: x) :> false
            .Braced(b: b) :> false
        }
    }

    // s462 — §5.2 rule 1 / rule 2: a quoted value with `${…}` in an attribute
    // the browser EXECUTES by its NAME alone — an event-handler attribute (its
    // name, lowercased, begins with `on`, except the exact words `one`,
    // `online`, `onboarding`) or `srcdoc` (any case) — "SHALL be a compile
    // error (E-ATTR-INTERP-EXECUTABLE)". The bootstrap refuses every other
    // quoted `${…}` too (no reactive templates, above); a scheme-led URL
    // attribute stays that refusal (its judgment reads the literal scheme).
    // s473: the test is url.scrml's `executableAttrName` (§5.2 rule 1's name test
    // plus `srcdoc`) — one table, shared with the plain-logic sink judgment.
    fn executableByName(name: string) -> boolean {
        return executableAttrName(name)
    }

    fn executableInterpDiag(mp: MP, name: string, tag: string, sp: ASpan) -> MP {
        const head: string = "the quoted `" + name + "=\"…\"` attribute on `<" + tag + ">` interpolates `$" + "{…}`"
        if (name.toLowerCase() == "srcdoc") {
            return mDiag(mp, "E-ATTR-INTERP-EXECUTABLE", head + " into an iframe `srcdoc`, which is an HTML document — interpolated text there can carry script. Build the frame from a URL (`src=`) or render the content as markup in the page (§5.2).", sp.start, sp.end)
        }
        return mDiag(mp, "E-ATTR-INTERP-EXECUTABLE", head + " into event-handler text. JavaScript is never built from interpolated text — a value can close a string and run code on the event. Pass the value as data: the unquoted call form `" + name + "=f(x)` (§5.2).", sp.start, sp.end)
    }

    fn quotedInterpDiag(mp: MP, name: string, v: AAttrValue, sp: ASpan) -> MP {
        const s: string = match v {
            .Quoted(v: x) :> x
            .Dur(text: x) :> ""                // s478: a DURATION (its `${…}ms` form is durationOf's)
            .NoValue :> ""
            .Bare(e: x) :> ""
            .Paren(e: x) :> ""
            .Braced(b: b) :> ""
        }
        if (s.indexOf("$" + "{") < 0) return mp
        // s472 — `style=(…)` is not a way out for a style: §65.4.2 refuses an
        // expression value of `style=` (E-STYLE-VALUE-NOT-STYLE). The quoted
        // template itself is refused as §5.5.3 (not in the bootstrap). Ruled
        // S472 (§65.4.2 "A `$` + `{…}` in a quoted `style="…"` is a guarded
        // value"): if the bootstrap ever lowers it, each `$` + `{…}` goes
        // through the runtime's cssValueOf — never written unguarded.
        if (name.toLowerCase() == "style") {
            return mDiag(mp, "E-BOOTSTRAP-UNSUPPORTED", "`" + name + "=\"…\"` holds a `$" + "{…}` interpolation — a quoted value with `$" + "{…}` is a reactive template (§5.5.3), which is not in the bootstrap; it would be emitted as literal text. `" + name + "=(…)` is no way out (an expression value of `style=` is E-STYLE-VALUE-NOT-STYLE): put the dynamic part in a `#" + "{…}` rule as `@cell` (§25.7), or switch a class with `class=(…)`", sp.start, sp.end)
        }
        return mDiag(mp, "E-BOOTSTRAP-UNSUPPORTED", "`" + name + "=\"…\"` holds a `$" + "{…}` interpolation — a quoted value with `$" + "{…}` is a reactive template (§5.5.3), which is not in the bootstrap; it would be emitted as literal text. Write the value as an expression: `" + name + "=(…)`", sp.start, sp.end)
    }

    // At the `:` of a `:`-shorthand body (§4.14): the single expression, as an
    // Interp node — or a nested element (markup-as-value, §1.4) — then the
    // opener's `>` (consumed). There is no closer: a `/>` here, or a closer
    // written right after the `>` (`<p : x></>`), is E-CLOSER-001 (§4.14).
    // The expression ends at the first depth-0 `>` that is not `>=`.
    // r1 F3 (PA ruling, fail-closed): a bare `>` COMPARISON cannot be told from
    // the opener's end — when the rest of the line after that `>` holds
    // another `>`, the body was a comparison: E-PARSE-SHORTHAND-GT (parenthesize
    // it, `(@n > 3)`), and the tail is consumed, never rendered as text.
    fn parseShorthand(mp: MP, tag: string) -> RNodes {
        const start: int = mp.pos
        const at: MP = skipSpace(mAdv(mp, 1))
        if (chAt(at, 0) == "<" && isNameStart(chAt(at, 1))) {
            const inner: RNodeOne = parseMarkupNode(at)
            let m0: MP = skipSpace(inner.mp)
            if (chAt(m0, 0) == ">") {
                m0 = mAdv(m0, 1)
            } else {
                m0 = mDiag(m0, "E-PARSE-SHORTHAND", "expected the `>` that ends the opener after a `:`-shorthand body (§4.14)", m0.pos, m0.pos + 1)
            }
            return { nodes: [inner.n], mp: closerAfterShorthand(m0, tag) }
        }
        if (chAt(at, 0) == ">") {
            // an empty `:`-shorthand body: one diagnostic, the opener still ends
            const em: MP = mDiag(mAdv(at, 1), "E-PARSE-SHORTHAND", "a `:`-shorthand body needs one expression before the `>` (§4.14)", start, at.pos + 1)
            const en: ANode = { nid: em.nid, span: mkSpan(start, em.pos), k: ANodeK.Text("") }
            return { nodes: [en], mp: mBump(em) }
        }
        const tp: TP = codeRegionTP(mAdv(mp, 1), LexStop.Shorthand)
        if (chAt(at, 0) == "\"" && displayCloseAt(mp.src, at.pos) < 0) {
            // SPEC §4.18.3: a display-text literal with no closing `"` before
            // end of file is E-CTX-001 against the opening `"` (recovered per
            // §4.18.7: a `:`-shorthand has no body closer, so its content is
            // the text to end of file).
            const em: MP = mDiag(mAt(mp, mp.src.length), "E-CTX-001", "unterminated display-text literal: the `\"` opened here has no closing `\"` before the end of the file (§4.18.3)", at.pos, at.pos + 1)
            const ck: RCook = cookRecovered(em, at.pos + 1, mp.src.length)
            const en: ANode = textNode(ck.mp, at.pos + 1, ck.text)
            return { nodes: [en], mp: mBump(ck.mp) }
        }
        let t: TP = tp
        let e: AExpr = { nid: t.nid, span: mkSpan(start, start + 1), k: AExprK.Recovered }
        if (atEnd(t)) {
            t = diagAt(t, "E-PARSE-SHORTHAND", "a `:`-shorthand body needs one expression before the `>` (§4.14)", cur(t))
            t = bumpId(t)
        } else {
            const r: RExpr = parseTernary(t)
            e = r.e
            if (isP(r.tp, ";") && !atEnd(adv(r.tp))) {
                // s478 — §5.2.3 cross-ref: "§4.14 (`:`-shorthand body) — keeps its
                // own single-expression rule … A multi-statement `:`-shorthand body
                // is still `E-MULTI-STATEMENT-HANDLER`, and its escape is the
                // bare-body form." The body is refused whole (its statements are
                // not judged one by one).
                const last: PTok = r.tp.toks[r.tp.toks.length - 1]
                const d: Diag = newDiag("E-MULTI-STATEMENT-HANDLER", "a `:`-shorthand body holds ONE expression (§4.14); this one is a `;`-separated statement sequence. Write the statements in the element's body instead of after `:` (the bare-body form, `<tag>…</>`), or name a function and call it", r.tp.file, mkSpan(e.span.start, last.start))
                const te: TP = endOfRegion(r.tp)
                t = { toks: te.toks, i: te.i, nid: te.nid, diags: te.diags.concat([d]), file: te.file, ns: te.ns, inFn: te.inFn }
                e = { nid: e.nid, span: mkSpan(e.span.start, last.start), k: AExprK.Recovered }
            } else {
                t = expectRegionEnd(r.tp)
            }
        }
        let m: MP = skipSpace(backToMarkup(mp, t))
        if (isStandaloneDisplay(tp)) m = displayEscapeDiags(m, tp.toks)
        if (mLooking(m, "/>")) {
            m = mAdv(mDiag(m, "E-CLOSER-001", "a `:`-shorthand body has no closer — drop the `/` (`<tag … : expr>`, §4.14)", m.pos, m.pos + 2), 2)
        } else if (chAt(m, 0) == ">") {
            m = mAdv(m, 1)
            m = comparisonTail(m, start)
            m = closerAfterShorthand(m, tag)
        } else {
            m = mDiag(m, "E-PARSE-SHORTHAND", "expected the `>` that ends the opener after a `:`-shorthand body (§4.14)", m.pos, m.pos + 1)
        }
        // §4.18.4: a display-text literal carrying `${…}` is one literal of
        // literal segments and interpolations — rendered as its segments
        return displayNodes(m, e, start, tp)
    }

    // The body nodes of a code-default expression `e` (spanning from `start`):
    // one Interp — or, when `e` is a display-text literal carrying `${ … }`
    // (§4.18.4), its literal segments (Text) and interpolations (Interp), in
    // order. A `${`-carrying display-text literal nested inside a larger
    // expression is not built (reported).
    fn displayNodes(m0: MP, e: AExpr, start: int, tp: TP) -> RNodes {
        // s469: a `"…"` in a code-default body is display text — interpolated
        // (standalone) or reported below (nested) — never the logic-string trap
        const m: MP = dropInterpLint(m0, e.span.start, e.span.end)
        if (isStandaloneDisplay(tp) && isDisplayTemplate(m.src, e)) {
            const split: RNodes = splitDisplay(m, e.span.start, e.span.end)
            return { nodes: split.nodes, mp: mAt(split.mp, m.pos) }
        }
        let mm: MP = m
        for (const t of tp.toks) {
            if (t.cls == TC.Str && t.text.substring(0, 1) == "\"" && hasLiveInterp(m.src, t.start, t.end)) {
                mm = mDiag(mm, "E-BOOTSTRAP-UNSUPPORTED", "a display-text literal carrying an interpolation (§4.18.4) inside a larger expression is not in the bootstrap — make it the whole body", t.start, t.end)
            }
        }
        const n: ANode = { nid: mm.nid, span: mkSpan(start, mm.pos), k: ANodeK.Interp(e) }
        return { nodes: [n], mp: mBump(mm) }
    }

    // How many diagnostics are not W-STRING-INTERP-LITERAL (a code-default
    // run's "did parsing add a report?" test must not count the lint, which
    // displayNodes takes back).
    fn diagsBesideLint(ds: Diag[]) -> int {
        let n = 0
        for (const d of ds) {
            if (d.code != "W-STRING-INTERP-LITERAL") n = n + 1
        }
        return n
    }

    // The W-STRING-INTERP-LITERAL diagnostics inside [start, end), removed.
    fn dropInterpLint(mp: MP, start: int, end: int) -> MP {
        let keep: Diag[] = []
        for (const d of mp.diags) {
            const inside: boolean = d.span.start >= start && d.span.end <= end
            if (d.code != "W-STRING-INTERP-LITERAL" || !inside) keep = keep.concat([d])
        }
        return { src: mp.src, pos: mp.pos, nid: mp.nid, diags: keep, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    // F9: a literal `$`+`{` in a scrml string is interpolation under impl#1 —
    // the two characters are joined at run time.
    fn interpOpen() -> string { return "$" + "{" }

    fn isDisplayTemplate(src: string, e: AExpr) -> boolean {
        if (src.substring(e.span.start, e.span.start + 1) != "\"") return false
        const v: string = strLit(e)
        return v.indexOf(interpOpen()) >= 0
    }

    fn strLit(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Str(v: x) :> x
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: o) :> ""
            .Lambda(params: ps) :> ""
            .BlockLambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
            .Template(quasis: qs) :> ""
            .HashRef(id: hr0) :> ""
            .Foreign(f: fb0) :> ""
        }
    }

    // A display-text literal's source span (quotes included) → Text segments +
    // Interp nodes. The three escapes (SPEC §4.18.3, restored S444) decode
    // here — a `\${` is literal `${` text, never an interpolation; a malformed
    // `\x` keeps both characters (E-PARSE-001 is displayEscapeDiags'). Each
    // `${`'s extent is the canonical walker's (parseInterp → lexFrom Balanced).
    fn splitDisplay(mp: MP, start: int, end: int) -> RNodes {
        let m: MP = mAt(mp, start + 1)
        let out: ANode[] = []
        let text: string = ""
        let textStart: int = m.pos
        while (m.pos < end - 1) {
            const esc: int = displayEscLen(m.src, m.pos)
            if (esc > 0) {
                if (text == "") textStart = m.pos
                text = text + displayEscText(m.src, m.pos)
                m = mAdv(m, esc)
            } else if (atInterp(m)) {
                if (text != "") {
                    out = out.concat([textNode(m, textStart, text)])
                    m = mBump(m)
                    text = ""
                }
                const ri: RNodeOne = parseInterp(m)
                out = out.concat([ri.n])
                m = ri.mp
                textStart = m.pos
            } else {
                if (text == "") textStart = m.pos
                text = text + chAt(m, 0)
                m = mAdv(m, 1)
            }
        }
        if (text != "") {
            out = out.concat([textNode(m, textStart, text)])
            m = mBump(m)
        }
        return { nodes: out, mp: m }
    }

    // SPEC §4.18.3 (RULED S444 — "A for escapes", superseding S442 B(3) /
    // B(2)): a display-text literal has exactly three escapes — `\"` (a
    // literal `"`), `\\` (a literal `\`), `\${` (a literal `${`, not an
    // interpolation) — and a `\` + any other character is malformed:
    // E-PARSE-001, the S111 catalog's rule restored exactly. The lexer (display
    // mode) decodes; these helpers are the one escape table the parser's own
    // scans (displayCloseAt, splitDisplay, displayEscapeDiags) share.

    // The length of the escape at `i` (a `\`): 2 for `\"` / `\\`, 3 for
    // `\${`, 0 when `i` is not a well-formed escape.
    fn displayEscLen(src: string, i: int) -> int {
        if (src.substring(i, i + 1) != "\\") return 0
        const n: string = src.substring(i + 1, i + 2)
        if (n == "\"" || n == "\\") return 2
        if (src.substring(i + 1, i + 3) == interpOpen()) return 3
        return 0
    }

    // The decoded text of the well-formed escape at `i`.
    fn displayEscText(src: string, i: int) -> string {
        const n: string = src.substring(i + 1, i + 2)
        if (n == "$") return interpOpen()
        return n
    }

    // E-PARSE-001 for every malformed escape in the display-text literals of a
    // code-default region's tokens (every `"` string the display-mode lexer
    // made). A `${ … }` inside the literal is the expression's own (skipped
    // whole by the canonical walker — its strings have logic escapes).
    fn displayEscapeDiags(mp: MP, toks: PTok[]) -> MP {
        let m: MP = mp
        for (const t of toks) {
            if (t.cls == TC.Str && t.text.substring(0, 1) == "\"") {
                let i: int = t.start + 1
                while (i < t.end) {
                    const c: string = m.src.substring(i, i + 1)
                    if (c == "\\") {
                        const esc: int = displayEscLen(m.src, i)
                        if (esc > 0) {
                            i = i + esc
                        } else {
                            if (i + 1 < t.end) {
                                m = mDiag(m, "E-PARSE-001", malformedEscMsg(m.src.substring(i, i + 2)), i, i + 2)
                            }
                            i = i + 2
                        }
                    } else if (m.src.substring(i, i + 2) == interpOpen()) {
                        const e: int = lexFrom(m.src, i + 1, LexStop.Balanced).end
                        i = e > i + 1 ? e : i + 2
                    } else {
                        i = i + 1
                    }
                }
            }
        }
        return m
    }

    fn malformedEscMsg(esc: string) -> string {
        return "malformed escape `" + esc + "` in a display-text literal: the escapes are `\\\"`, `\\\\` and `\\" + interpOpen() + "` — write `\\\\` for a literal backslash (§4.18.3)"
    }

    type RCook:struct = { text: string, mp: MP }

    // An UNTERMINATED literal's recovered content [from, to) (SPEC §4.18.3):
    // cooked with the same escape table, and every malformed escape in it
    // reported E-PARSE-001 — including a lone `\` right at the recovery point
    // (end of file or the body's closer). A `${` here is text: the literal
    // never closed, so its interpolations are not walked (a runaway `${` must
    // not eat the closer).
    fn cookRecovered(mp: MP, from: int, to: int) -> RCook {
        let m: MP = mp
        let out: string = ""
        let i: int = from
        while (i < to) {
            const c: string = m.src.substring(i, i + 1)
            const esc: int = displayEscLen(m.src, i)
            if (esc > 0 && i + esc <= to) {
                out = out + displayEscText(m.src, i)
                i = i + esc
            } else if (c == "\\") {
                const e: int = i + 2 <= to ? i + 2 : to
                m = mDiag(m, "E-PARSE-001", malformedEscMsg(m.src.substring(i, e)), i, e)
                out = out + m.src.substring(i, e)
                i = e
            } else {
                out = out + c
                i = i + 1
            }
        }
        return { text: out, mp: m }
    }

    // Whether the display-text literal spanning [start, end) carries a LIVE
    // interpolation — a `${` that is not the `\${` escape.
    fn hasLiveInterp(src: string, start: int, end: int) -> boolean {
        let i: int = start + 1
        while (i < end) {
            const esc: int = displayEscLen(src, i)
            if (esc > 0) {
                i = i + esc
            } else if (src.substring(i, i + 2) == interpOpen()) {
                return true
            } else {
                i = i + 1
            }
        }
        return false
    }

    // r1 F3: after the shorthand's `>`: another `>` later on the same line
    // (before any `<`) means the first one was a comparison operator.
    fn comparisonTail(mp: MP, start: int) -> MP {
        let i: int = mp.pos
        let content = false
        while (i < mp.src.length) {
            const c: string = mp.src.substring(i, i + 1)
            if (c == "\n" || c == "<") return mp
            // a `>` right after this one (only spaces between) ends an OUTER
            // opener (`<div : <p : "x">>`) — not a comparison
            if (c == ">" && !content) return mp
            if (c != " " && c != "\t") content = true
            if (c == ">") {
                const d: MP = mDiag(mp, "E-PARSE-SHORTHAND-GT", "a `>` inside a `:`-shorthand body ends the opener — this body reads as a comparison; parenthesize it: `: (a > b)` (§4.14; §66.2.4's rule for opener values)", start, i + 1)
                return mAt(d, i + 1)
            }
            i = i + 1
        }
        return mp
    }

    // nit: `<p : x></>` / `<p : x></p>` written right after the opener.
    fn closerAfterShorthand(mp: MP, tag: string) -> MP {
        let m: MP = mp
        while (chAt(m, 0) == " " || chAt(m, 0) == "\t") { m = mAdv(m, 1) }
        let n: int = 0
        if (mLooking(m, "</>")) n = 3
        if (tag != "" && mLooking(m, "</" + tag + ">")) n = tag.length + 3
        if (n == 0) return mp
        return mAdv(mDiag(m, "E-CLOSER-001", "a `:`-shorthand body has no closer — drop the `" + m.src.substring(m.pos, m.pos + n) + "` (§4.14)", m.pos, m.pos + n), n)
    }

    // ---- r1 F4: a CODE-DEFAULT body (§4.18.1) — an engine state-child body ----
    // A bare run is CODE (an expression, §4.18.2); display text is a "…"
    // literal; a nested tag is markup (a free-text body of its own); `${…}` is
    // an interpolation. A run that is not ONE valid expression is
    // E-UNQUOTED-DISPLAY-TEXT (§4.18.7), suggesting the quoted literal.
    fn parseCodeBody(mp: MP, tag: string) -> RNodes {
        return parseCodeBodyX(mp, tag, true)
    }

    // `recover`: whether the runaway-literal reading may be taken (off inside
    // runawayDisplayAt's own trials, which read the rest of the body as-is).
    fn parseCodeBodyX(mp: MP, tag: string, recover: boolean) -> RNodes {
        let m: MP = mp
        let out: ANode[] = []
        let going = true
        while (going) {
            m = skipTrivia(m)
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-UNCLOSED", "`<" + tag + ">` is never closed", mp.pos, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                going = false
            } else if (atInterp(m)) {
                const ri: RNodeOne = parseInterp(m)
                out = out.concat([ri.n])
                m = ri.mp
            } else if (chAt(m, 0) == "<") {
                const tagNode: RNodeOne = parseMarkupNode(m)
                out = out.concat([tagNode.n])
                m = tagNode.mp
            } else if (keywordTagAt(m) >= 0) {
                m = keywordNotItem(m, tag, false)
            } else if (chAt(m, 0) == "\"" && displayCloseAt(m.src, m.pos) < 0) {
                // SPEC §4.18.3 / §4.18.7 (PA ruling, s444 r3): a display-text
                // literal is UNTERMINATED only when the scan from its `"`
                // reaches end of file with no closing `"` — a closed literal's
                // content is content, never searched for closers (§4.18.1b pin
                // 3). Then: E-CTX-001 against the opening `"`, the literal's
                // content ends at the first body closer after it (or end of
                // file), and parsing goes on from that closer.
                const stop: int = firstBodyCloser(m.src, m.pos + 1, tag)
                const open: int = m.pos
                m = mDiag(m, "E-CTX-001", "unterminated display-text literal: the `\"` opened here has no closing `\"` before the end of the file (§4.18.3) — read up to " + (stop >= m.src.length ? "the end of the file" : "the `<" + tag + ">` body's closer"), open, open + 1)
                const ck: RCook = cookRecovered(mAt(m, stop), open + 1, stop)
                out = out.concat([textNode(ck.mp, open + 1, ck.text)])
                m = mBump(ck.mp)
            } else if (recover && runawayDisplayAt(m, tag)) {
                // s471 — the same recovery for a RUNAWAY literal (runawayDisplayAt)
                const stop2: int = firstBodyCloser(m.src, m.pos + 1, tag)
                const open2: int = m.pos
                m = mDiag(m, "E-CTX-001", "unterminated display-text literal: the `\"` opened here has no closing `\"` before the `<" + tag + ">` body's closer (§4.18.3, §4.18.7) — the next `\"` is past the closer, and reading up to it does not parse; read up to the closer", open2, open2 + 1)
                const ck2: RCook = cookRecovered(mAt(m, stop2), open2 + 1, stop2)
                out = out.concat([textNode(ck2.mp, open2 + 1, ck2.text)])
                m = mBump(ck2.mp)
            } else {
                const cr: RNodes = parseCodeRun(m, tag)
                out = out.concat(cr.nodes)
                m = cr.mp
            }
        }
        if (mLooking(m, "</")) m = parseCloser(m, tag)
        return { nodes: out, mp: m }
    }

    // One code run of a code-default body, at a position that is not a tag,
    // an interpolation, a keyword tag or an unterminated literal: a display
    // item (s471), one expression, or E-UNQUOTED-DISPLAY-TEXT.
    fn parseCodeRun(mp: MP, tag: string) -> RNodes {
        let m: MP = mp
        let out: ANode[] = []
        if (displayItemAt(regionTP(m, LexStop.CodeBody))) {
            const di: RNodes = parseDisplayItem(m, regionTP(m, LexStop.CodeBody))
            return { nodes: di.nodes, mp: di.mp }
        }
        const before: int = m.pos
        const tp0: TP = codeRegionTP(m, LexStop.CodeBody)
        const tp: TP = { toks: tp0.toks, i: tp0.i, nid: tp0.nid, diags: m.diags, file: tp0.file, ns: tp0.ns, inFn: tp0.inFn }
        const runEnd: int = lastEnd(tp)
        if (isStandaloneDisplay(tp)) m = displayEscapeDiags(m, tp.toks)
        const r: RExpr = parseAssign({ toks: tp.toks, i: tp.i, nid: tp.nid, diags: m.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn })
        if (msgArmAt(tp)) {
            // s469: a §51.0.S.2.3 message-arm list (`.Go :> .Loading, …`,
            // newline- or comma-separated) — refused by name, never read
            // as display text
            m = mDiag(mAt(m, runEnd), "E-BOOTSTRAP-UNSUPPORTED", "engine message arms (`.Msg :> …` in a `<" + tag + ">` state-child body, §51.0.S.2.3) are not in the bootstrap", before, runEnd)
        } else if (atEnd(r.tp) && diagsBesideLint(r.tp.diags) == diagsBesideLint(m.diags)) {
            const back: MP = backToMarkup(m, r.tp)
            // §4.18.4: a `${`-carrying display-text literal renders as its segments
            const dn: RNodes = displayNodes(back, r.e, before, tp)
            out = out.concat(dn.nodes)
            m = dn.mp
        } else {
            const text: string = m.src.substring(before, runEnd).trim()
            m = mDiag(mAt(m, runEnd), "E-UNQUOTED-DISPLAY-TEXT", "display text in a `<" + tag + ">` state-child body must be a quoted display-text literal — did you mean `\"" + text + "\"`? (a code-default body, §4.18.1 / §4.18.7)", before, runEnd)
        }
        if (m.pos == before) m = mAdv(m, 1)
        return { nodes: out, mp: m }
    }

    // s471 — a RUNAWAY display-text literal: its `"` is closed only by a `"`
    // PAST the body's closer (a one-character typo, `"C:\"` for `"C:\\"`, with a
    // later `"` anywhere in the file). SPEC §4.18.3: "A display-text literal
    // that reaches end-of-file (or the body's closer) before its closing `"` is
    // an unterminated literal — `E-CTX-001` against the opening `"`, recovered
    // per §4.18.7"; §4.18.7: "The block splitter recovers by treating the
    // captured text from the opening `"` through the body closer (or EOF) as the
    // literal's content and continuing." A closed literal's content is still
    // content (s444 r3, §4.18.1b pin 3: `"use </> here"` is a legal literal),
    // so this reading is taken ONLY when it is STRICTLY cleaner than the closed
    // one (s471 review F1). Two trials, both of the rest of this body:
    //   closed — the literal closed by the later `"`, read on as-is;
    //   cut    — E-CTX-001, the literal cut at the first body closer, then the
    //            closer.
    // The cut reading is taken only when (a) the closed reading never finds
    // this body's closer (E-PARSE-UNCLOSED — the literal swallowed it), and
    // (b) it has strictly more hard errors than the cut reading. An
    // E-BOOTSTRAP-UNSUPPORTED is not counted: a construct the bootstrap refuses
    // after a legal closed literal (`"x </> ${@y}" + "q"`) is an honest
    // refusal, never a sign of a runaway literal. It never changes what a
    // clean body means — it moves the report from the cascade
    // (E-UNQUOTED-DISPLAY-TEXT to end of file, then E-PARSE-UNCLOSED for every
    // open element) to the opening `"`, and parsing resumes at the closer.
    fn runawayDisplayAt(mp: MP, tag: string) -> boolean {
        if (chAt(mp, 0) != "\"") return false
        const close: int = displayCloseAt(mp.src, mp.pos)
        if (close < 0) return false
        const stop: int = firstBodyCloser(mp.src, mp.pos + 1, tag)
        if (stop >= close) return false
        const closed: RNodes = parseCodeBodyX(mp, tag, false)
        if (codeCount(closed.mp.diags, "E-PARSE-UNCLOSED") == codeCount(mp.diags, "E-PARSE-UNCLOSED")) return false
        const closedHard: int = runawayTrigger(closed.mp.diags) - runawayTrigger(mp.diags)
        const ck: RCook = cookRecovered(mAt(mp, stop), mp.pos + 1, stop)
        const cut: RNodes = parseCodeBodyX(ck.mp, tag, false)
        const cutHard: int = 1 + runawayTrigger(cut.mp.diags) - runawayTrigger(mp.diags)
        return closedHard > cutHard
    }

    // The hard errors that can show a runaway literal: hardErrors less
    // E-BOOTSTRAP-UNSUPPORTED (an honest refusal, s471 review F1).
    fn runawayTrigger(ds: Diag[]) -> int {
        let n: int = 0
        for (const d of ds) {
            if (d.severity == Severity.Error && !softError(d.code) && d.code != "E-BOOTSTRAP-UNSUPPORTED") n = n + 1
        }
        return n
    }

    fn codeCount(ds: Diag[], code: string) -> int {
        let n: int = 0
        for (const d of ds) {
            if (d.code == code) n = n + 1
        }
        return n
    }

    // s471 — SEVERAL display-text literals in one code-default body. SPEC
    // §4.18.3 (S444): a `"…"` is a display-text literal "only when it stands
    // alone as a body statement — the whole statement is the one `"…"` (a body
    // may hold several such statements; a `:`-shorthand body is one)"; §7.2.2
    // rule 2 lists "a standalone display-text literal" under "What takes no
    // `;`" ("an item delimited by its own closer"), and rule 4: a newline is
    // whitespace. So a run whose display-mode lex OPENS with a `"` literal
    // followed by ANOTHER `"` literal holds that literal as one item:
    // `"a"⏎"b"`, `"a" "b"`. The item is read alone (the one-literal path below,
    // so escapes, `${…}` segments and the W-lint take-back are that path's),
    // and the loop reads what follows. Anything else after the literal is not
    // an item and the run stays one expression — `"a" + @b`, `"x".length`, and
    // `"a";`: no SPEC sentence licenses a `;` after a closer-delimited item in
    // a code-default body (s471 review F2, PA: refuse — reversible), so it
    // fails closed (E-UNQUOTED-DISPLAY-TEXT), as before s471.
    fn displayItemAt(d: TP) -> boolean {
        if (d.toks.length < 3) return false
        const t0: PTok = d.toks[0]
        if (t0.cls != TC.Str || t0.text.substring(0, 1) != "\"") return false
        const t1: PTok = d.toks[1]
        return t1.cls == TC.Str && t1.text.substring(0, 1) == "\""
    }

    // At a display item (displayItemAt): its literal as a one-literal region,
    // ending where the next literal starts.
    fn parseDisplayItem(mp: MP, d: TP) -> RNodes {
        const t0: PTok = d.toks[0]
        const one: TP = { toks: [t0, endTokAt(d.toks[1])], i: 0, nid: d.nid, diags: mp.diags, file: d.file, ns: d.ns, inFn: d.inFn }
        const m: MP = displayEscapeDiags(mp, one.toks)
        const r: RExpr = parseAssign({ toks: one.toks, i: 0, nid: one.nid, diags: m.diags, file: one.file, ns: one.ns, inFn: one.inFn })
        const back: MP = backToMarkup(m, r.tp)
        return displayNodes(back, r.e, t0.start, one)
    }

    // Does a code run start with an arm head (`.V :>`, `| .V(m) :>`, `_ :>`)?
    fn msgArmAt(tp: TP) -> boolean {
        if (isP(tp, "|")) return armStartsAt(tp.toks, tp.i + 1)
        return armStartsAt(tp.toks, tp.i)
    }

    // The position of the closing `"` of the display-text literal whose
    // opening `"` is at `pos`, or -1 when it has none (it runs to end of
    // file). The scan is the lexer's display mode: an escape (§4.18.3,
    // restored S444) is stepped over whole — `\"` does not close, `\\` does
    // not escape what follows it (so `"C:\\"` closes) — and a `${…}` is skipped
    // whole by the canonical walker (token depth — a `"` or `}` inside it, e.g.
    // in a nested string, does not close the literal).
    fn displayCloseAt(src: string, pos: int) -> int {
        let i: int = pos + 1
        while (i < src.length) {
            const c: string = src.substring(i, i + 1)
            const esc: int = displayEscLen(src, i)
            if (esc > 0) {
                i = i + esc
            } else if (c == "\"") {
                return i
            } else if (src.substring(i, i + 2) == interpOpen()) {
                const e: int = lexFrom(src, i + 1, LexStop.Balanced).end
                i = e > i + 1 ? e : i + 2
            } else {
                i = i + 1
            }
        }
        return -1
    }

    // Recovery point for an unterminated literal in a `<tag>` body: the first
    // `</>` or `</tag>` at or after `from` (raw bytes — the literal never
    // closed, so there is no structure left to respect), else end of file.
    fn firstBodyCloser(src: string, from: int, tag: string) -> int {
        let i: int = from
        while (i < src.length) {
            if (src.substring(i, i + 3) == "</>") return i
            if (src.substring(i, i + tag.length + 3) == "</" + tag + ">") return i
            i = i + 1
        }
        return src.length
    }

    type RAttrScan:struct = { typed: ADeclAttr[], attrs: AAttr[], vals: AValidator[], rend: ASpan[], kws: AAttr[], mp: MP }   // kws: a bare `let` / `export` on the opener itself, judged once the opener is classified   // rend: a `renders <…>` met inside the opener

    // SPEC §66.2.2 (i): "an own value — `=` immediately after the name, or after
    // `name:Type`". A spaced `=` (`<let count:int = 0/>`) is reported, then read
    // as the value (so one diagnostic, not a cascade).
    fn checkSpacedEq(mp: MP) -> MP {
        if (!isSpaceCh(chAt(mp, 0))) return mp
        const after: MP = skipSpace(mp)
        if (chAt(after, 0) != "=") return mp
        return mDiag(after, "E-PARSE-OPENER-EQ-SPACED", "§66.2.2: an own value / default is `=` IMMEDIATELY after the name or `name:Type` — remove the space", mp.pos, after.pos + 1)
    }

    // One opener entry: `name:Type[=v]` (typed), `ns:name=v` (namespaced),
    // `name=v`, `as name` / `as=name`, or a flag. S447 (§66.2.5, §66.4 rule 6):
    // an attribute is always locked data — `let` / `export` written on one is
    // refused (still read, so the attribute keeps its grant for recovery and
    // one error is the only error), and `renders` here is refused whole.
    fn scanAttr(mp: MP) -> RAttrScan {
        const start: int = mp.pos
        let m: MP = mp
        let exported = false
        let isLet = false
        let nm: RWord = readName(m)
        if (nm.w == "renders" && rendersClauseAt(nm.mp)) return rendersInOpener(mp, nm.mp)
        if (nm.w == "export" && isSpaceCh(chAt(nm.mp, 0))) {
            exported = true
            nm = readName(skipSpace(nm.mp))
        }
        if (nm.w == "let" && isSpaceCh(chAt(nm.mp, 0))) {
            isLet = true
            nm = readName(skipSpace(nm.mp))
        }
        m = nm.mp
        if (nm.w == "" && (exported || isLet)) {
            // a keyword with nothing after it (`<x:int=0 let />`): the keyword alone
            return { typed: [], attrs: [], vals: [], rend: [], kws: [bareKw(m, exported, isLet, start)], mp: m }
        }
        if (nm.w == "") return { typed: [], attrs: [], vals: [], rend: [], kws: [], mp: mp }
        // name:…
        if (chAt(m, 0) == ":" && !isNamespace(nm.w) && !isChannelHookNs(nm.w)) {
            const rt: RMType = parseOpenerType(mAdv(m, 1))
            m = rt.mp
            // s475 — a lifecycle type on a typed ATTRIBUTE: refused by name (INTERIM — the
            // bootstrap builds `(not to T)` only as a program cell's own type, §14.12.3)
            if (isLifeAType(rt.t) && !hasDiagIn(m.diags, rt.t.span)) {
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a lifecycle type on the attribute `" + nm.w + "` is not in the bootstrap yet — it builds `(not to T)` only as a program cell's declared type, `let <x:(not to T)=not/>` (§14.12.3); write `T | not` here", rt.t.span.start, rt.t.span.end)
            }
            // s478 — a refinement on a typed ATTRIBUTE: each use site's value is a
            // boundary-zone write (§53.4.3) — refused by name (INTERIM)
            const rsp: ASpan | not = refineInside(rt.t)
            if (rsp is given) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", refBoundaryMsg(typeNameText(rt.t), "on the attribute `" + nm.w + "` — each use site's value reaches it unproven"), rsp.start, rsp.end)
            let dflt: AAttrValue = AAttrValue.NoValue
            m = checkSpacedEq(m)
            if (chAt(m, 0) == "=") {
                const rv: RValue = parseAttrValue(mAdv(m, 1), false, nm.w, true)
                dflt = rv.v
                m = rv.mp
            }
            if (exported || isLet) m = grantInOpener(m, exported, isLet, nm.w, start)
            const da: ADeclAttr = { nid: m.nid, span: mkSpan(start, m.pos), exported: exported, isLet: isLet,
                                    name: nm.w, ty: rt.t, dflt: dflt }
            return { typed: [da], attrs: [], vals: [], rend: [], kws: [], mp: mBump(m) }
        }
        let name: string = nm.w
        if (chAt(m, 0) == "(") {
            const vt: TP = regionTP(m, LexStop.Balanced)
            if (!isValidatorWord(nm.w)) {
                // a call that is not a validator (§55.1's vocabulary): skipped whole, reported
                const vm: MP = backToMarkup(m, vt)
                const d: MP = mDiag(vm, "E-PARSE-ATTR", "`" + nm.w + "(…)` in a tag — only a validator (§55.1: `req`, `length`, `pattern`, `min`, `max`, `gt`, `lt`, `gte`, `lte`, `eq`, `neq`, `oneOf`, `notIn`) takes arguments here", start, vm.pos)
                return { typed: [], attrs: [], vals: [], rend: [], kws: [], mp: d }
            }
            // s444 Phase B (dpa-058): a validator call in an opener (§55.1, §66.4 rule 3)
            const rv: RValArg = parseValArg(vt)
            const vm2: MP = backToMarkup(m, rv.tp)
            const va: AValidator = { nid: vm2.nid, span: mkSpan(start, vm2.pos), name: nm.w, arg: rv.arg }
            return { typed: [], attrs: [], vals: [va], rend: [], kws: [], mp: mBump(vm2) }
        }
        if (chAt(m, 0) == ":") {
            const sub: RWord = readName(mAdv(m, 1))
            name = nm.w + ":" + sub.w
            m = sub.mp
        }
        let v: AAttrValue = AAttrValue.NoValue
        if (chAt(m, 0) == "=") {
            const vStart: int = m.pos + 1
            const hd: boolean = isHandlerName(name)
            const rv2: RValue = parseAttrValue(mAdv(m, 1), hd, name, false)
            v = rv2.v
            m = rv2.mp
            const ab: RAfterBare = afterBareValue(m, name, v, vStart, hd)
            v = ab.v
            m = ab.mp
            if (!hd && !ab.reported) {
                // s478 r1 (#1865 F1) — the refused value is refused whole, once per
                // attribute: its parts are not judged again (`title=@last -x` is
                // E-ATTR-UNQUOTED-OPERATOR alone, not also `x` undeclared)
                const n0: int = m.diags.length
                m = unquotedOperatorDiag(m, name, v, vStart)
                if (m.diags.length > n0) v = AAttrValue.Bare(recoveredAt(m, vStart))
            }
        } else if (name == "as" && isSpaceCh(chAt(m, 0))) {
            // `<each … as name>` (§17.7): the binding name follows after a space.
            const m2: MP = skipSpace(m)
            const bn: RWord = readName(m2)
            if (bn.w != "") {
                const e: AExpr = { nid: bn.mp.nid, span: mkSpan(m2.pos, bn.mp.pos), k: AExprK.Name(bn.w) }
                v = AAttrValue.Bare(e)
                m = mBump(bn.mp)
            }
        }
        if (exported || isLet) {
            m = grantInOpener(m, exported, isLet, name, start)
        } else if (name == "let" || name == "export") {
            // a trailing flag `<x:int=0 let/>` / `<x:int=0 export/>` — the keyword written after the name
            return { typed: [], attrs: [], vals: [], rend: [], kws: [bareKw(m, name == "export", name == "let", start)], mp: m }
        }
        const a: AAttr = { nid: m.nid, span: mkSpan(start, m.pos), name: name, value: v }
        return { typed: [], attrs: [a], vals: [], rend: [], kws: [], mp: mBump(m) }
    }

    // S447: `let` / `export` inside an opener. `let` (with or without `export`)
    // is E-DECL-LET-IN-OPENER (§66.20); an `export` alone on an attribute has no
    // named code — it is the same rule (§66.4 rule 6: an attribute carries no
    // grant), reported as E-PARSE-ATTR with the same fix. `name` is the
    // attribute's name ("" when the keyword stands on the declaration itself).
    fn grantInOpener(mp: MP, exported: boolean, isLet: boolean, name: string, start: int) -> MP {
        const kw: string = exported && isLet ? "export let" : (isLet ? "let" : "export")
        const fix: string = "make `" + name + "` a child declaration in the body, `" + kw + " <" + name + ":Type=…/>` (a `:struct` opener when no typed attribute is left) — an attribute is always locked data (§66.4 rule 6, S447)"
        if (isLet) return mDiag(mp, "E-DECL-LET-IN-OPENER", "`" + kw + "` cannot stand on the attribute `" + name + "`: " + fix, start, mp.pos)
        return mDiag(mp, "E-PARSE-ATTR", "`export` cannot stand on the attribute `" + name + "`: " + fix, start, mp.pos)
    }

    type RAfterBare:struct = { v: AAttrValue, mp: MP, reported: boolean }

    // s478 — what may follow an unquoted value (§5.2 "An unquoted value is read
    // WHOLE (S457)"; the value itself was read whole by the lexer's BareValue
    // rule). `m` is just past the value.
    //   - a `;`: a BARE event-handler value "that contains a `;` outside of
    //     expression-internal contexts … is compile error
    //     `E-MULTI-STATEMENT-HANDLER`" (§5.2.3); after any other attribute "A `;`
    //     after it is `E-ATTR-MULTI-STATEMENT` (§5.2.4)". The rest of the
    //     sequence (each further `;`-separated expression, up to the tag's end or
    //     a `name=` attribute) is read into the one refused value — reported
    //     once, never turned into further attributes.
    //   - "an event-handler EXPRESSION (an assignment or operator form) followed
    //     by `>` after inline whitespace — `<button onclick=@big = @n > 1>` — is
    //     `E-ATTR-UNQUOTED-OPERATOR` too: a comparison and the end of the tag
    //     read the same there".
    //   - "text after it that cannot begin an attribute (`onclick=fn() (g)`,
    //     `title=x "y"`) is `E-ATTR-UNQUOTED-OPERATOR`" — that text (one
    //     delimited or quoted value) is read into the refused attribute.
    fn afterBareValue(mp: MP, name: string, v: AAttrValue, vStart: int, handler: boolean) -> RAfterBare {
        const x: AExpr | not = bareExprOf(v)
        if (x is not) return { v: v, mp: mp, reported: false }
        if (chAt(mp, 0) == ";") {
            const d0: Diag[] = mp.diags
            let m: MP = mp
            let going = true
            while (going && chAt(m, 0) == ";") {
                m = skipSpace(mAdv(m, 1))
                if (mEof(m) || chAt(m, 0) == ">" || mLooking(m, "/>") || nameEqAt(m)) {
                    going = false
                } else {
                    const tp: TP = regionTP(m, LexStop.BareValue)
                    if (atEnd(tp)) {
                        going = false
                    } else {
                        const r: RExpr = parseAssign(tp)
                        m = mAt(backToMarkup(m, r.tp), cur(r.tp).start)
                        if (!isP(r.tp, ";")) m = backToMarkup(m, r.tp)
                    }
                }
            }
            const text: string = mp.src.substring(vStart, m.pos).trim()
            const m0: MP = withDiagsOf(m, d0)
            let md: MP = m0
            if (handler) {
                md = mDiag(m0, "E-MULTI-STATEMENT-HANDLER", "`" + name + "=" + text + "` — a bare (unbraced) event-handler value is exactly ONE expression; this one is a `;`-separated statement sequence, whose extent cannot be told apart from the tag's further attributes (§5.2.3). Wrap the statements in braces — `" + name + "={ " + text + " }` — or name a function", vStart, m.pos)
            } else {
                md = mDiag(m0, "E-ATTR-MULTI-STATEMENT", "`" + name + "=" + text + "` — an unquoted attribute value is ONE expression, and a `;` after it makes a statement list, which only an event handler takes (§5.2.4). Write a single expression, or move the statements into a function and use its result: `function compute() { … }` then `" + name + "=compute()`", vStart, m.pos)
            }
            return { v: AAttrValue.Bare(recoveredAt(md, vStart)), mp: mBump(md), reported: true }
        }
        const sp: MP = skipInlineSpace(mp)
        if (handler && sp.pos > mp.pos && chAt(sp, 0) == ">" && chAt(sp, 1) != "=" && isOperatorForm(x)) {
            const text2: string = mp.src.substring(vStart, mp.pos)
            const m2: MP = mDiag(mp, "E-ATTR-UNQUOTED-OPERATOR", "`" + name + "=" + text2 + " >` — after an unquoted event-handler expression, a `>` after whitespace reads both as a comparison and as the end of the tag (§5.2). Write the handler as an inline block — `" + name + "={ " + text2 + " > … }` — or drop the space before the closing `>`", vStart, sp.pos + 1)
            return { v: AAttrValue.Bare(recoveredAt(m2, vStart)), mp: mBump(m2), reported: true }
        }
        const at: MP = skipSpace(mp)
        if (at.pos > mp.pos && startsDelimitedValue(at)) {
            const d1: Diag[] = mp.diags
            const tail: RValue = parseAttrValue(at, false, name, false)
            const m3: MP = withDiagsOf(tail.mp, d1)
            const text3: string = mp.src.substring(vStart, m3.pos)
            const m4: MP = mDiag(m3, "E-ATTR-UNQUOTED-OPERATOR", "`" + name + "=" + text3 + "` — an unquoted attribute value is read whole, and the text after it cannot continue it or begin an attribute (§5.2). An expression is written `(…)`, `" + dollarOpen() + "…}` or, on an event handler, an inline block `{ … }`", vStart, m3.pos)
            return { v: AAttrValue.Bare(recoveredAt(m4, vStart)), mp: mBump(m4), reported: true }
        }
        return { v: v, mp: mp, reported: false }
    }

    fn bareExprOf(v: AAttrValue) -> AExpr | not {
        return match v {
            .Bare(e: e) :> e
            .NoValue :> not
            .Paren(e: e) :> not
            .Quoted(v: s) :> not
            .Dur(text: s) :> not
            .Braced(b: b) :> not
        }
    }

    // `name=` (not `name==`) at `mp` — an attribute begins there.
    fn nameEqAt(mp: MP) -> boolean {
        const nm: RWord = readName(mp)
        if (nm.w == "") return false
        let m: MP = nm.mp
        if (chAt(m, 0) == ":") m = readName(mAdv(m, 1)).mp
        return chAt(m, 0) == "=" && chAt(m, 1) != "="
    }

    // Text no attribute begins with: a quoted string, `(`, `[`, `{`, `${`, a template.
    fn startsDelimitedValue(mp: MP) -> boolean {
        const c: string = chAt(mp, 0)
        if (c == "\"" || c == "'" || c == "(" || c == "[" || c == "{" || c == "`") return true
        return c == "$" && chAt(mp, 1) == "{"
    }

    // Spaces and tabs only (not a line break).
    fn skipInlineSpace(mp: MP) -> MP {
        let m: MP = mp
        while (!mEof(m) && (chAt(m, 0) == " " || chAt(m, 0) == "\t")) { m = mAdv(m, 1) }
        return m
    }

    // "an event-handler EXPRESSION (an assignment or operator form)" (§5.2).
    fn isOperatorForm(x: AExpr) -> boolean {
        const k: AExprK = x.k
        return match k {
            .Binary(op: o) :> true
            .Ternary(test: t) :> true
            .Assign(target: t) :> true
            .Unary(op: o) :> true
            .Name(name: n) :> false
            .Recovered :> false
            .Sql(q: q) :> false
            .Template(quasis: qs) :> false
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: s) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .BlockLambda(params: ps) :> false
            .Handled(h: h) :> false
        }
    }

    // s473 — §5.2 "Unquoted attribute CONDITIONS are atomic-only (cluster-A,
    // S188)": "A bare operator in an unquoted condition SHALL be compile error
    // `E-ATTR-UNQUOTED-OPERATOR`, fired exactly once per offending attribute,
    // naming the operator and steering to the parens/quotes form"; and "any
    // other attribute followed by an operator (`title=@a + "x"`, …) is
    // `E-ATTR-UNQUOTED-OPERATOR`" — every attribute but an event handler (whose
    // value is one expression, §5.2.3). An unspaced operator (`if=@a&&@b`,
    // `show=@n==3`) is read whole by the bare-value reader as a binary,
    // conditional or assignment expression, and was accepted.
    fn unquotedOperatorDiag(mp: MP, name: string, v: AAttrValue, start: int) -> MP {
        const x: AExpr | not = match v {
            .Bare(e: e) :> e
            .NoValue :> not
            .Paren(e: e) :> not
            .Quoted(v: s) :> not
            .Dur(text: s) :> not
            .Braced(b: b) :> not
        }
        if (x is not) return mp
        const k: AExprK = x.k
        const op: boolean = match k {
            .Binary(op: o) :> true
            .Ternary(test: t) :> true
            .Assign(target: t) :> true
            .Name(name: n) :> false
            .Recovered :> false
            .Sql(q: q) :> false
            .Template(quasis: qs) :> false
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> o == UnOp.IsGiven || o == UnOp.IsNot   // `is given` / `is not` / `is some` (§5.2: `is` continues the value)
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: s) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .BlockLambda(params: ps) :> false
            .Handled(h: h) :> false
        }
        if (!op || isHyphenWordExpr(x)) return mp   // a hyphenated word: analyze decides (review F9)
        const text: string = mp.src.substring(start, mp.pos)
        return mDiag(mp, "E-ATTR-UNQUOTED-OPERATOR", "`" + name + "=" + text + "` — an unquoted attribute value holds no operator: it is an identifier, a member chain or a call (§5.1, §5.2). Parenthesize the expression — `" + name + "=(" + text + ")` — or quote it", start, mp.pos)
    }

    // `renders` followed by whitespace and a markup element: the clause shape.
    // Any other `renders` (`renders="x"`, `renders:string`) is an ordinary
    // attribute name — §66.5.1: `renders` is not reserved outside its two
    // contextual positions.
    // `renders<p>…</p>` (no space) is the same clause (§66.5.1: never a generic
    // parse error about the `<` that follows).
    fn rendersClauseAt(afterWord: MP) -> boolean {
        const at: MP = skipSpace(afterWord)
        return chAt(at, 0) == "<" && isNameStart(chAt(at, 1))
    }

    // A bare grant keyword on the opener itself (`<x:int=0 let/>`), as data: the
    // message depends on whether the opener declares anything (parseOpener).
    fn bareKw(mp: MP, exported: boolean, isLet: boolean, start: int) -> AAttr {
        const kw: string = exported && isLet ? "export let" : (isLet ? "let" : "export")
        return { nid: mp.nid, span: mkSpan(start, mp.pos), name: kw, value: AAttrValue.NoValue }
    }

    // S447 (§66.2.5): `let` / `export` inside an opener, on the opener itself —
    // on a DECLARATION the fix is the keyword before the `<`; on a tag that
    // declares nothing (`<input let/>`) moving it would only trade this error
    // for E-PARSE-LET, so the message says to drop it instead.
    fn keywordInOpener(mp: MP, kw: string, tag: string, isDecl: boolean, sp: ASpan) -> MP {
        const shown: string = tag == "" ? "name" : tag
        if (isDecl) return mDiag(mp, "E-DECL-LET-IN-OPENER", "`" + kw + "` goes BEFORE the `<` (S447): write `" + kw + " <" + shown + "…/>`, not `<" + shown + " " + kw + "…/>` or `<" + kw + " " + shown + "…/>` — inside an opener stand only the name, `:Type`, `=value`, typed attributes and flags (§66.2.5)", sp.start, sp.end)
        return mDiag(mp, "E-DECL-LET-IN-OPENER", "`" + kw + "` is a declaration's keyword, and `<" + shown + ">` declares nothing (no own value `=…`, no `:Type`, no typed attribute — §66.2.2): drop `" + kw + "` (§66.2.5)", sp.start, sp.end)
    }

    // S447 (§66.5.1): a `renders <element>` clause written inside an opener.
    // The element is consumed (so the opener's own `/>` / `>` still ends the
    // tag) and its span returned; parseOpener reports it once the opener is
    // classified — E-DECL-RENDERS-IN-OPENER on a DECLARATION opener only.
    fn rendersInOpener(mp: MP, afterWord: MP) -> RAttrScan {
        const at: MP = skipSpace(afterWord)
        if (scriptStyleAt(at) != "") {
            // s462: refused whole (§4.17) — the misplaced-`renders` report still follows
            const rs: MP = refuseScriptStyle(at)
            return { typed: [], attrs: [], vals: [], rend: [mkSpan(mp.pos, rs.pos)], kws: [], mp: rs }
        }
        const ro: ROpener = parseOpener(at)
        const re: RElem = finishElem(ro.o, ro.mp)
        return { typed: [], attrs: [], vals: [], rend: [mkSpan(mp.pos, re.mp.pos)], kws: [], mp: re.mp }
    }

    // s444 Phase B — a validator's arguments, at its `(`: a comparison and its
    // operand (`>=5`), a regex literal (`/re/flags`), or a list of expressions.
    type RValArg:struct = { arg: AValArg, tp: TP }

    fn parseValArg(tp0: TP) -> RValArg {
        let t: TP = expectP(tp0, "(")
        if (isP(t, ")")) return { arg: AValArg.Exprs([]), tp: expectRegionEnd(adv(t)) }
        const op: string = cur(t).text
        if (cur(t).cls == TC.Punct && (op == ">=" || op == "<=" || op == ">" || op == "<" || op == "==" || op == "!=")) {
            const r: RExpr = parseTernary(adv(t))
            return { arg: AValArg.Cmp(op, r.e), tp: expectRegionEnd(expectP(r.tp, ")")) }
        }
        const rt: PTok = cur(t)
        if (rt.cls == TC.Other && rt.text.length > 1 && rt.text.substring(0, 1) == "/") {
            const last: int = rt.text.lastIndexOf("/")
            const src: string = rt.text.substring(1, last)
            const flags: string = rt.text.substring(last + 1)
            return { arg: AValArg.Regex(src, flags), tp: expectRegionEnd(expectP(adv(t), ")")) }
        }
        const rl: RExprs = parseList(t, ")")
        return { arg: AValArg.Exprs(rl.es), tp: expectRegionEnd(rl.tp) }
    }

    // s442: validators (§6.4, kickstarter §6.1's shared vocabulary) are outside
    // the bootstrap — they imply the synthesized validity surface, and whether
    // they reach a `renders` input as HTML attributes is ⚑ O25 (OPEN).
    fn isValidatorWord(w: string) -> boolean {
        return w == "req" || w == "length" || w == "pattern" || w == "min" || w == "max" || w == "gt" || w == "lt" ||
               w == "gte" || w == "lte" || w == "eq" || w == "neq" || w == "oneOf" || w == "notIn"
    }

    fn isNoValue(v: AAttrValue) -> boolean {
        return match v {
            .NoValue :> true
            .Quoted(v: x) :> false
            .Dur(text: x) :> false
            .Bare(e: x) :> false
            .Paren(e: x) :> false
            .Braced(b: x) :> false
        }
    }

    // Validators in SOURCE order (a bare word and a call interleave, §55.12).
    fn bySource(vs: AValidator[]) -> AValidator[] {
        let out: AValidator[] = []
        let rest: AValidator[] = vs
        while (rest.length > 0) {
            let k = 0
            let j = 1
            while (j < rest.length) {
                if (rest[j].span.start < rest[k].span.start) k = j
                j = j + 1
            }
            out = out.concat([rest[k]])
            let next: AValidator[] = []
            let i = 0
            for (const v of rest) {
                if (i != k) next = next.concat([v])
                i = i + 1
            }
            rest = next
        }
        return out
    }

    // =========================================================================
    // Elements, declarations, programs.
    // =========================================================================
    type RElem:struct = { e: AElem, mp: MP }
    type RDecl:struct = { d: ADecl, mp: MP }
    type RChild:struct = { c: ADeclChild, mp: MP }

    // What a tag at `<` turned out to be.
    type TagKind:enum = { IsElem, IsDecl, IsProgram }

    fn tagKind(o: Opener) -> TagKind {
        if (!o.star && o.name == "program") return TagKind.IsProgram
        if (isDeclOpener(o)) return TagKind.IsDecl
        return TagKind.IsElem
    }

    // The HTML void elements (no closer, no children): the markup-value extent's
    // list (lex.scrml isVoidName, held equal to the printer's html.scrml isVoid),
    // so the reader, the extent and the printed page agree (s478 review L2).
    fn isVoidTag(t: string) -> boolean { return isVoidName(t) }

    // At `</`: consume `</>` or `</name>`; `name` must match the open tag.
    fn parseCloser(mp: MP, tag: string) -> MP {
        const start: int = mp.pos
        let m: MP = mAdv(mp, 2)
        let nm: RWord = readName(m)
        // s475: the closer of a namespaced element `<m.card>…</m.card>`
        if (tag.indexOf(".") > 0 && chAt(nm.mp, 0) == ".") {
            const mem: RWord = readName(mAdv(nm.mp, 1))
            nm = { w: nm.w + "." + mem.w, mp: mem.mp }
        }
        m = skipSpace(nm.mp)
        if (chAt(m, 0) != ">") {
            m = mDiag(m, "E-PARSE-CLOSER", "expected `>` to end the closer", start, m.pos)
            return m
        }
        m = mAdv(m, 1)
        if (nm.w != "" && nm.w != tag) {
            m = mDiag(m, "E-PARSE-CLOSER", "`</" + nm.w + ">` closes `<" + tag + ">`", start, m.pos)
        }
        return m
    }

    fn elemFrom(o: Opener, kids: ANode[], mp: MP) -> RElem {
        const e: AElem = { nid: mp.nid, span: mkSpan(o.start, mp.pos), star: o.star, tag: o.name, attrs: o.attrs, kids: kids, binds: [], parens: false }
        return { e: e, mp: mBump(mp) }
    }

    // An element after its opener: children until its closer.
    fn finishElem(o: Opener, mp: MP) -> RElem {
        // s473 (§21.3.3 rule 1): a `<host>` is read at an item position only (parseTagItem)
        if (isHostOpener(o)) return refuseHostPlacement(o, mp, "inside another element")
        // s478 — a `<schema>` body is §39.2's declaration language, never markup
        if (isSchemaOpener(o)) return finishSchema(o, mp)
        if (o.vals.length > 0) {
            // s444 Phase B: a validator binds a DECLARATION's own value (§66.4 rule 3) — an element has none
            return finishElem(noVals(o), mDiag(mp, "E-PARSE-ATTR", "the validator `" + o.vals[0].name + "(…)` is on the element `<" + o.name + ">` — a validator belongs in a declaration's opener, binding its own value (§66.4 rule 3, §55.2)", o.vals[0].span.start, o.vals[0].span.end))
        }
        if (o.typed.length > 0 && o.star) {
            // a typed attribute on `<*x …>` is meaningless — a reference declares nothing
            return elemFrom(o, [], mDiag(mp, "E-PARSE-TAG", "a `<*" + o.name + ">` reference cannot declare typed attributes", o.start, mp.pos))
        }
        const sh: ANode[] | not = o.short
        if (sh is given) {
            // §4.14 / §24: a non-void element's `:`-shorthand body IS its one child
            if (isVoidTag(o.name)) {
                return elemFrom(o, [], mDiag(mp, "E-COLON-SHORTHAND-ON-VOID", "`<" + o.name + ">` is a void element — it has no body for a `:`-shorthand (bind a value through an attribute, §4.14)", o.start, mp.pos))
            }
            return elemFrom(o, sh, mp)
        }
        if (o.selfClosing || isVoidTag(o.name)) return elemFrom(o, [], mp)
        // s478 — a block-form `<match>` (§18.0.1): its body is a list of ARMS
        if (!o.star && o.name == "match") return finishMatch(o, mp)
        if (isRawContentOpener(o)) return finishRaw(o, mp)
        // s472 (S472 ruling Q3): a `<db>` body is a code-default ITEM body
        if (isDbOpener(o)) return finishDb(o, mp)
        const kids: RNodes = parseKids(mp, o.name)
        return elemFrom(o, kids.nodes, kids.mp)
    }

    // ---- s478: the block-form `<match for=Type on=expr>` (SPEC §18.0.1) --------
    // "State-children with variant names match enum variants"; each arm is a
    // variant-named tag (or the wildcard `<_>`) with one of "the three legitimate
    // body forms": self-closing `<Variant/>` ("no body, renders nothing for that
    // variant"), a bare body `<Variant>…</>` — "a code-default body (§4.18 — S111)"
    // — or the `:`-shorthand `<Variant : expr>` ("the `:` opens INSIDE the arm
    // opener"). So an arm is read as a declaration's state-child is (parseDeclChild:
    // the shorthand, or parseCodeBody), plus its `( … )` binders (parseOpenerB).
    // Whitespace and comments between arms are trivia. Anything else at an arm
    // position that is not a tag (text, a `${…}`) is not an arm — refused by name;
    // a tag that does not name a variant is the analyzer's (E-MATCH-INVALID-ARM).
    // `<script>` / `<style>` there is refused as everywhere (§4.17).
    fn finishMatch(o: Opener, mp: MP) -> RElem {
        let m: MP = mp
        let arms: ANode[] = []
        let going = true
        while (going) {
            m = skipTrivia(m)
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-UNCLOSED", "`<match>` is never closed", o.start, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                m = parseCloser(m, "match")
                going = false
            } else if (scriptStyleAt(m) != "") {
                m = refuseScriptStyle(m)
            } else if (chAt(m, 0) == "<") {
                const ra: RArmOpener = parseOpenerB(m, true)
                const ao: Opener = ra.o
                let am: MP = ra.mp
                // a type, an own value, a typed attribute or a validator would make
                // the tag a DECLARATION (§66.2.2) — an arm declares nothing
                if (isDeclOpener(ao) || ao.vals.length > 0) am = mDiag(am, "E-BOOTSTRAP-UNSUPPORTED", "`<" + ao.name + ">` at a `<match>` arm position carries a type, a value or a validator — an arm names a variant and declares nothing (§18.0.1); write `<" + ao.name + ">…</>`", ao.start, am.pos)
                let body: ANode[] = []
                const sh: ANode[] | not = ao.short
                if (sh is given) {
                    body = sh
                } else if (!ao.selfClosing) {
                    const kids: RNodes = parseCodeBody(am, ao.name)
                    body = kids.nodes
                    am = kids.mp
                }
                const ae: AElem = { nid: am.nid, span: mkSpan(ao.start, am.pos), star: ao.star, tag: ao.name, attrs: ao.attrs, kids: body, binds: ra.binds, parens: ra.parens }
                am = mBump(am)
                arms = arms.concat([{ nid: am.nid, span: ae.span, k: ANodeK.Elem(ae) }])
                m = mBump(am)
            } else {
                const bad: int = m.pos
                let stop: int = m.src.indexOf("<", bad + 1)
                if (stop < 0) stop = m.src.length
                if (atInterp(m)) {
                    const ri: RNodeOne = parseInterp(m)
                    stop = ri.mp.pos
                    m = ri.mp
                } else {
                    m = mAt(m, stop)
                }
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a `<match>` body holds its ARMS only — one tag per variant (`<Ready>…</>`, `<Ready(rows)>…</>`, `<Idle : \"…\">`, `<Idle/>`) or the wildcard `<_>…</>` (§18.0.1); text or a `" + interpOpen() + "…}` between the arms is not an arm — move it into an arm's body", bad, stop)
            }
        }
        return elemFrom(o, arms, m)
    }

    // ---- s468: raw-content elements — `<pre>` and `<code>` (SPEC §4.17) -------
    // "The element names `pre` and `code` (matched case-insensitively) are
    // raw-content elements. After the opening tag is parsed (including any
    // attributes per §5), the block splitter SHALL scan the body as a single
    // text run terminated only by the matching close tag." Inside it no scrml
    // token is recognized (`${…}`, a tag, `</>`, a sigil, `//`, `<!-- -->`).
    // "A raw-content body is display text: `<` and `>` are entity-encoded on
    // output (S462 Q21) … nothing in a raw-content body builds an element, so
    // nothing in it can execute" — EXCEPT "A nested `<code>…</code>` or
    // `<pre>…</pre>` pair with NO attributes stays an element … Only a
    // BALANCED pair qualifies — a closer pairs with the innermost unclosed
    // opener of the same name, ASCII case-insensitive, optional whitespace
    // before `>`; an unpaired opener or closer is text."
    // And, fail closed: "every case-insensitive `<script` / `<style` start-tag
    // text ANYWHERE in a raw-content body … SHALL be `E-SCRIPT-001` /
    // `E-STYLE-001`" — inside a comment, an attribute value, an RCDATA /
    // RAWTEXT element included; "The name is exact: `<script` / `<style`
    // followed by whitespace, `/`, `>` or the end of the body, ASCII
    // case-insensitive".
    // The bootstrap parsed the body as markup (gap
    // g-bootstrap-raw-content-not-fail-closed-s462): a `<script>` in a comment
    // or an attribute there was never refused, and tag text in the body built
    // elements. Now the body is TEXT nodes (plus the balanced attribute-less
    // `<code>` / `<pre>` elements), which lower.scrml turns into Core
    // View.RawText and html.scrml prints with `<` / `>` encoded and `&` kept
    // (escRawText) — so no tag in the body reaches the page as markup, by
    // construction, and an author entity still displays as its character.
    // Mirrors impl#1: block-splitter.js (the body runs to the first
    // case-insensitive `</pre>` / `</code>`; an uppercase-first `<Pre>` is not
    // raw content), element-refusal.ts `scanRawContentForRefusedTags`,
    // raw-content-encode.ts (the balanced pairs).
    fn isRawContentOpener(o: Opener) -> boolean {
        if (o.star || o.name.length == 0) return false
        const first: string = o.name.substring(0, 1)
        if (first >= "A" && first <= "Z") return false
        const lower: string = o.name.toLowerCase()
        return lower == "pre" || lower == "code"
    }

    fn finishRaw(o: Opener, mp: MP) -> RElem {
        const lower: string = o.name.toLowerCase()
        const start: int = mp.pos
        const close: int = rawCloseAt(mp.src, start, lower)
        let end: int = close
        if (close < 0) end = mp.src.length
        const body: string = mp.src.substring(start, end)
        let m: MP = mp
        for (const h of rawRefusedTags(body)) {
            const at: int = start + h.off
            const name: string = body.substring(h.off + 1, h.off + 1 + h.len)
            const where: string = "inside <" + o.name + "> raw content, which is display text — to DISPLAY the tag, entity-escape it: &lt;" + name + "&gt;"
            if (h.style) {
                m = mDiag(m, "E-STYLE-001", "<" + name + "> blocks are not supported in scrml (" + where + "). Use #{} for CSS (§4.17, §9.1).", at, at + 1 + h.len)
            } else {
                m = mDiag(m, "E-SCRIPT-001", "<" + name + "> elements are not supported in scrml (" + where + "). Use " + interpOpen() + "...} for scrml logic (§4.17).", at, at + 1 + h.len)
            }
        }
        const rk: RNodes = rawNodes(m, body, start, rawPairTags(body))
        m = rk.mp
        if (close < 0) {
            m = mDiag(mAt(m, end), "E-PARSE-UNCLOSED", "`<" + o.name + ">` is never closed — a raw-content body runs to its `</" + lower + ">` (§4.17)", o.start, end)
        } else {
            m = mAt(m, close + 3 + lower.length)
        }
        return elemFrom(o, rk.nodes, m)
    }

    // ---- the fail-closed `<script` / `<style` scan of a raw body --------------
    type RawHit:struct = { off: int, len: int, style: boolean }

    fn rawRefusedTags(body: string) -> RawHit[] {
        let out: RawHit[] = []
        let i: int = body.indexOf("<")
        while (i >= 0) {
            const w6: string = body.substring(i + 1, i + 7).toLowerCase()
            const w5: string = body.substring(i + 1, i + 6).toLowerCase()
            if (w6 == "script" && rawNameEnds(body, i + 7)) {
                out = out.concat([{ off: i, len: 6, style: false }])
            } else if (w5 == "style" && rawNameEnds(body, i + 6)) {
                out = out.concat([{ off: i, len: 5, style: true }])
            }
            i = body.indexOf("<", i + 1)
        }
        return out
    }

    // After the name: whitespace (tab, LF, FF, CR, space), `/`, `>` or the end.
    fn rawNameEnds(body: string, at: int) -> boolean {
        if (at >= body.length) return true
        const c: string = body.substring(at, at + 1)
        if (c == "/" || c == ">") return true
        return rawWs(c)
    }

    fn rawWs(c: string) -> boolean {
        if (c.length != 1) return false
        const k: int = c.charCodeAt(0)
        return k == 32 || k == 9 || k == 10 || k == 12 || k == 13
    }

    // ---- the balanced attribute-less `<code>` / `<pre>` pairs -----------------
    // A structural tag: `<` `/`? (`pre` | `code`, any case) whitespace* `>`.
    type RawTag:struct = { start: int, end: int, name: string, close: boolean }

    // The KEPT structural tags of `body` in order — those a stack pairs (a closer
    // pairs only with the innermost open tag of the same name); every other tag
    // is text.
    fn rawPairTags(body: string) -> RawTag[] {
        let toks: RawTag[] = []
        let i: int = body.indexOf("<")
        while (i >= 0) {
            const t: RawTag | not = rawTagAt(body, i)
            if (t is given) toks = toks.concat([t])
            i = body.indexOf("<", i + 1)
        }
        let kept: int[] = []
        let open: int[] = []
        let k: int = 0
        while (k < toks.length) {
            if (!toks[k].close) {
                open = open.concat([k])
            } else if (open.length > 0 && toks[open[open.length - 1]].name == toks[k].name) {
                kept = kept.concat([open[open.length - 1], k])
                open = open.slice(0, open.length - 1)
            }
            k = k + 1
        }
        let out: RawTag[] = []
        k = 0
        while (k < toks.length) {
            if (kept.indexOf(k) >= 0) out = out.concat([toks[k]])
            k = k + 1
        }
        return out
    }

    fn rawTagAt(body: string, i: int) -> RawTag | not {
        let p: int = i + 1
        let close = false
        if (body.substring(p, p + 1) == "/") {
            close = true
            p = p + 1
        }
        let name: string = ""
        if (body.substring(p, p + 3).toLowerCase() == "pre") {
            name = "pre"
        } else if (body.substring(p, p + 4).toLowerCase() == "code") {
            name = "code"
        }
        if (name == "") return not
        p = p + name.length
        while (p < body.length && rawWs(body.substring(p, p + 1))) { p = p + 1 }
        if (body.substring(p, p + 1) != ">") return not
        return { start: i, end: p + 1, name: name, close: close }
    }

    // The nodes of a raw body: text runs and the kept pairs as elements (their
    // own bodies text again, recursively). `base` is the body's source offset.
    type RRaw:struct = { nodes: ANode[], mp: MP, ti: int, pos: int }

    fn rawNodes(mp: MP, body: string, base: int, toks: RawTag[]) -> RNodes {
        const r: RRaw = rawLevel(mp, body, base, toks, 0, 0)
        return { nodes: r.nodes, mp: r.mp }
    }

    // One level: from `pos`, until a closer (the caller's) or the end. Returns
    // the index of that closer (or toks.length) and the position it starts at.
    fn rawLevel(mp: MP, body: string, base: int, toks: RawTag[], ti0: int, pos0: int) -> RRaw {
        let m: MP = mp
        let out: ANode[] = []
        let ti: int = ti0
        let pos: int = pos0
        let going = true
        while (going && ti < toks.length) {
            const t: RawTag = toks[ti]
            if (t.close) {
                going = false
            } else {
                if (t.start > pos) {
                    out = out.concat([{ nid: m.nid, span: mkSpan(base + pos, base + t.start), k: ANodeK.Text(body.substring(pos, t.start)) }])
                    m = mBump(m)
                }
                const inner: RRaw = rawLevel(m, body, base, toks, ti + 1, t.end)
                m = inner.mp
                let closeEnd: int = body.length
                if (inner.ti < toks.length) closeEnd = toks[inner.ti].end
                const e: AElem = { nid: m.nid, span: mkSpan(base + t.start, base + closeEnd), star: false, tag: t.name, attrs: [], kids: inner.nodes, binds: [], parens: false }
                m = mBump(m)
                out = out.concat([{ nid: m.nid, span: e.span, k: ANodeK.Elem(e) }])
                m = mBump(m)
                ti = inner.ti + 1
                pos = closeEnd
            }
        }
        let stop: int = body.length
        if (ti < toks.length) stop = toks[ti].start
        if (stop > pos) {
            out = out.concat([{ nid: m.nid, span: mkSpan(base + pos, base + stop), k: ANodeK.Text(body.substring(pos, stop)) }])
            m = mBump(m)
        }
        return { nodes: out, mp: m, ti: ti, pos: stop }
    }

    fn noVals(o: Opener) -> Opener {
        return { start: o.start, star: o.star, isLet: o.isLet, name: o.name, ty: o.ty, own: o.own,
                 typed: o.typed, attrs: o.attrs, selfClosing: o.selfClosing, short: o.short, vals: [] }
    }

    // Markup children until `</…>` (consumed).
    fn parseKids(mp: MP, tag: string) -> RNodes {
        let m: MP = mp
        let out: ANode[] = []
        let text: string = ""
        let textStart: int = m.pos
        let going = true
        while (going) {
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-UNCLOSED", "`<" + tag + ">` is never closed", mp.pos, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                going = false
            } else if (mLooking(m, "<!--")) {
                m = skipMarkupComment(m)
            } else if (mLooking(m, "//") && freeTextCommentAt(m)) {
                m = skipLineComment(m)
            } else if (atCss(m)) {
                // s469: like a comment, a `#{…}` block does NOT split the text
                // around it — it renders nothing where it stands, and two
                // adjacent text runs would print as one DOM text node (the
                // template paths count one). The pending text stays pending
                // (flushed after the Css node — order among siblings is
                // invisible for a node that renders nothing).
                const rc: RCss = parseCssNode(m)
                out = out.concat([rc.n])
                m = rc.mp
            } else if (foreignLevel(m) >= 0) {
                if (text != "") {
                    out = out.concat([textNode(m, textStart, text)])
                    m = mBump(m)
                    text = ""
                }
                m = skipForeign(m)
                textStart = m.pos
            } else if (atOtherSigil(m)) {
                if (text != "") {
                    out = out.concat([textNode(m, textStart, text)])
                    m = mBump(m)
                    text = ""
                }
                m = skipSigil(m)
                textStart = m.pos
            } else if (atInterp(m) && nestedLogicAhead(m)) {
                // s478 (C10): a logic block of declarations renders nothing where it
                // stands — like a `#{…}` block (above), it does not split the text
                // around it (the template paths count one text node). s478 r1 (H2): its
                // empty placeholder (renders nothing — lower textViews) stays in the tree,
                // spanning the block, so analyze can see WHERE the hoisted items stood
                // (nestedHoistCheck: never out of a binder scope)
                const rl: RNodeOne = parseNestedLogic(m)
                out = out.concat([rl.n])
                m = rl.mp
            } else if (atInterp(m)) {
                if (text != "") {
                    out = out.concat([textNode(m, textStart, text)])
                    m = mBump(m)
                    text = ""
                }
                // s469: a Tier-0 `${ for … }` (§17.4) — a free-text markup body's form
                const ri: RNodeOne = parseInterpOrTier0(m)
                out = out.concat([ri.n])
                m = ri.mp
                textStart = m.pos
            } else if (chAt(m, 0) == "<" && opensTag(chAt(m, 1))) {
                if (text != "") {
                    out = out.concat([textNode(m, textStart, text)])
                    m = mBump(m)
                    text = ""
                }
                const rn: RNodeOne = parseMarkupNode(m)
                out = out.concat([rn.n])
                m = rn.mp
                textStart = m.pos
            } else if (!o61Body(tag) && keywordBeforeDeclAt(m)) {
                if (text != "") {
                    out = out.concat([textNode(m, textStart, text)])
                    m = mBump(m)
                    text = ""
                }
                m = keywordNotItem(m, tag, true)
                textStart = m.pos
            } else {
                if (text == "") textStart = m.pos
                text = text + chAt(m, 0)
                m = mAdv(m, 1)
            }
        }
        if (text != "") {
            out = out.concat([textNode(m, textStart, text)])
            m = mBump(m)
        }
        if (mLooking(m, "</")) m = parseCloser(m, tag)
        return { nodes: out, mp: m }
    }

    // SPEC §4.18.1b exit (2) (RULED S444 — "yes on // revised"): in free text
    // a `//` opens a comment ONLY when the byte right before it is whitespace —
    // space, tab, LF, CR; these four and no others (a line start and a line's
    // indentation are both that). Any other `//` is content: `http://x`,
    // `a//b`, `</b>// x`. (A free-text body always follows its opener's `>`,
    // so there is always a byte before the `//`.) The comment itself is opaque
    // to end of line (skipLineComment — a `</p>` in it is comment text).
    fn freeTextCommentAt(mp: MP) -> boolean {
        const before: string = chAt(mp, -1)
        return before == " " || before == "\t" || before == "\n" || before == "\r"
    }

    // dpa-045 D (RULED S442): free text has exactly two ways out — `${` opens
    // logic, and `<` IMMEDIATELY followed by a letter, `!`, `/` or `?` opens a
    // tag. Any other `<` (`a < b`, `5 <7`) is content, not an error.
    // ⚑ `*` is admitted too: `<*x/>` is §66.6's existing-instance reference,
    // which the ruled class (HTML5-derived) does not list — flagged for the PA.
    // RULED S442 (dpa-045 follow-ups): the class is a letter, `!`, `/`, `?`,
    // `*`, `_`, `.` — `*` / `_` / `.` are scrml's own tag forms (`<*x/>`,
    // `<_ …>`, `<.Variant …>`). That list, and no others.
    fn opensTag(c: string) -> boolean {
        if (c >= "a" && c <= "z") return true
        if (c >= "A" && c <= "Z") return true
        return c == "!" || c == "/" || c == "?" || c == "*" || c == "_" || c == "."
    }

    // S447 sub-ruling 3, narrowed S449 (§66.2.5): in a CODE-DEFAULT body that
    // is not an item position (an engine state-child body — parseCodeBody)
    // `let` / `export` / `export let` followed by a tag is
    // E-DECL-KEYWORD-NOT-ITEM. In a FREE-TEXT body (parseKids — plain markup,
    // a `renders` element) the words are TEXT and this is never consulted
    // (`<p>Please let <b>me</b> know</p>`). The keyword must stand as a word
    // (not the tail of `outlet`). Returns the position of the tag's `<`, or -1.
    fn keywordTagAt(mp: MP) -> int {
        const c: string = chAt(mp, 0)
        if (c != "l" && c != "e") return -1
        // a word boundary by the markup name rule (isNameCh — `-` included):
        // `outlet`, `re-let` are not the keyword
        if (isNameCh(chAt(mp, -1))) return -1
        const w: RWord = readName(mp)
        let m: MP = w.mp
        if (w.w == "export") {
            const s: MP = skipSpace(m)
            const wl: RWord = readName(s)
            if (wl.w == "let") m = wl.mp
        } else if (w.w != "let") {
            return -1
        }
        const at: MP = skipSpace(m)
        if (chAt(at, 0) != "<") return -1
        const n: string = chAt(at, 1)
        if ((n >= "a" && n <= "z") || (n >= "A" && n <= "Z") || n == "_" || n == "*") return at.pos
        return -1
    }

    // PA reading S449 (for veto) on S449 ruling item 2: in a FREE-TEXT body the
    // words are text UNLESS the tag after them is a declaration BY ITS OPENER
    // (own value, `:Type`, typed attribute — §66.2.2): `<p>let <x:int=0/></p>`
    // is the misplaced-declaration mistake, and judging the opener is not a
    // guess. `<p>Please let <b>me</b> know</p>` stays prose.
    fn keywordBeforeDeclAt(mp: MP) -> boolean {
        const lt: int = keywordTagAt(mp)
        if (lt < 0) return false
        const ro: ROpener = parseOpener(mAt(mp, lt))
        return isDeclOpener(ro.o)
    }

    // O61 (§66.2.5, RULED S469 — "Allowed, scoped to the block (Rec)"; "Same
    // rule as channel/db (Rec)"): a `<db>`, `<channel>`, `<page>` or `<theme>`
    // body is an ITEM position, so `let <x/>` / `export <x/>` there is never
    // E-DECL-KEYWORD-NOT-ITEM. `<channel>` and `<theme>` are refused
    // whole (E-BOOTSTRAP-UNSUPPORTED — `<theme>` here, `<channel>` in
    // analyze's structural-tag check), so their own body decides nothing and
    // reports no keyword: one fail-closed code each. A `<page>` directly in a
    // `<program>` body is read as an item body (s476, pageItem); one that
    // reaches here is inside markup, refused whole by analyze (resolveElem). A `<db>` body is not a
    // free-text body at all (s472 — parseDbBody), so it never reaches here.
    fn o61Body(tag: string) -> boolean { return tag == "page" || tag == "theme" || tag == "channel" }

    // s471 — a declaration standing in a `<db>` body: `let` / `export` /
    // `export let` before a declaration opener, or a declaration opener alone
    // (a locked `<x:T=v/>`; §66.2.5 S469: "`let <x/>` / `export <x/>` (and a
    // locked `<x/>` declaration) MAY stand directly in a `<db>` body or a
    // `<channel>` body").
    fn dbDeclAt(mp: MP) -> boolean {
        if (keywordBeforeDeclAt(mp)) return true
        if (chAt(mp, 0) != "<" || !opensTag(chAt(mp, 1))) return false
        if (scriptStyleAt(mp) != "") return false
        const ro: ROpener = parseOpener(mp)
        return isDeclOpener(ro.o)
    }

    // s473 (Lane B — RULED S472 "`<db>` body + client reads", items 1, 2, 4, 5):
    // a declaration in a `<db>` body declares a per-request SERVER cell; the
    // client receives only its projection. It is read whole (keywords, opener,
    // body, `renders`) — never as text — and, in the one shape the bootstrap
    // builds, `[let] <name:Type=value/>`, DESUGARED into two hoisted items:
    //   - the program cell `[let] <name:Type/>`, with no value of its own (its
    //     client copy is the load's answer — CoreProgram.loads);
    //   - its LOAD: a parameterless function `@name` whose whole body is
    //     `return value;`, with the cell's declared type as its return type.
    //     It is recorded as this `<db>`'s function (finishDb → FileAst.dbFns,
    //     `cell` set), so its `?{}` binds to THIS `<db>` (§8.1.1) through the
    //     existing dbsPass, and it is a server function by construction (the
    //     `server` flag; analyze never warns on it) — the existing route, §57
    //     codec and CSRF path carry it. Its name `@name` is spelled by no
    //     identifier, so no program code can call it.
    // The declared type is REQUIRED: it is the wire table the server encodes the
    // value against — the allow-list of what reaches the client (§57: a key the
    // type does not declare is refused, never dropped). Every other shape — no
    // type, no value, a `{…}` value, `export`, an attribute or modifier
    // (`persist=`, `single`, …), a validator, a body or `renders` — is refused by
    // name (E-BOOTSTRAP-UNSUPPORTED, one report, fail closed); no node is kept, so
    // analyze does not report it again.
    type RDbCell:struct = { items: AItem[], cells: RDbCellPair[], mp: MP }

    fn readDbCell(mp: MP) -> RDbCell {
        const start: int = mp.pos
        let m: MP = mp
        let exported = false
        let isLet = false
        const w: RWord = readName(m)
        if (w.w == "export") {
            exported = true
            m = skipSpace(w.mp)
        }
        const wl: RWord = readName(m)
        if (wl.w == "let") {
            isLet = true
            m = skipSpace(wl.mp)
        }
        const ro: ROpener = parseOpener(m)
        const od: Opener = isLet ? withLet(ro.o) : ro.o
        const rd: RDecl = finishDecl(od, ro.mp, exported)
        const d: ADecl = rd.d
        const why: string = dbCellShapeWhy(d)
        if (why != "") {
            return { items: [], cells: [], mp: mDiag(rd.mp, "E-BOOTSTRAP-UNSUPPORTED", "a `<db>` cell is `[let] <name:Type=value/>` (§8.1.3 — a per-request server cell, S472 ruling): " + why + " is not in the bootstrap", start, rd.mp.pos) }
        }
        let k: MP = rd.mp
        let value: AExpr = { nid: k.nid, span: d.span, k: AExprK.Recovered }
        const own: AAttrValue = d.own
        const vb: AExpr | not = match own {
            .Bare(e: e) :> e
            .Paren(e: e) :> e
            .Quoted(v: x) :> not
            .Dur(text: x) :> not
            .NoValue :> not
            .Braced(b: x) :> not
        }
        if (vb is given) {
            value = vb
        } else {
            value = { nid: k.nid, span: d.span, k: AExprK.Str(quotedOwn(own)) }
            k = mBump(k)
        }
        const ret: AStmt = { nid: k.nid, span: value.span, k: AStmtK.Return(value) }
        k = mBump(k)
        const body: ABlock = { nid: k.nid, span: value.span, stmts: [ret] }
        k = mBump(k)
        const load: AFn = { nid: k.nid, span: d.span, exported: false, pure: false, name: "@" + d.name, params: [], ret: d.ty,
                            body: body, server: true, failable: false, err: not }
        k = mBump(k)
        const cell: ADecl = { nid: d.nid, span: d.span, exported: false, isLet: d.isLet, name: d.name, ty: d.ty, own: AAttrValue.NoValue,
                              attrs: [], mods: [], body: [], renders: not, validators: [] }
        const ci: AItem = { nid: k.nid, span: d.span, k: AItemK.DeclItem(cell) }
        k = mBump(k)
        const fi: AItem = { nid: k.nid, span: d.span, k: AItemK.FnItem(load) }
        k = mBump(k)
        return { items: [ci, fi], cells: [{ decl: cell.nid, fn: load.nid }], mp: k }
    }

    fn quotedOwn(v: AAttrValue) -> string {
        return match v {
            .Quoted(v: s) :> s
            .Dur(text: s) :> s
            .Bare(e: x) :> ""
            .Paren(e: x) :> ""
            .NoValue :> ""
            .Braced(b: x) :> ""
        }
    }

    // "" when `d` is the built shape `[let] <name:Type=value/>`; else what is not.
    fn dbCellShapeWhy(d: ADecl) -> string {
        if (d.exported) return "`export` of a `<db>` cell"
        if (d.ty is not) return "a `<db>` cell with no written type (its declared type is what the server sends — the allow-list of its projection)"
        const own: AAttrValue = d.own
        const vk: int = match own {
            .NoValue :> 0
            .Braced(b: x) :> 1
            .Bare(e: x) :> 2
            .Paren(e: x) :> 2
            .Quoted(v: x) :> 2
            .Dur(text: x) :> 2
        }
        if (vk == 0) return "a `<db>` cell with no value (its value is its load, evaluated on the server per request)"
        if (vk == 1) return "a `{…}` value on a `<db>` cell"
        if (d.attrs.length > 0) return "a typed attribute on a `<db>` cell"
        if (d.mods.length > 0) return "`" + d.mods[0].name + "` on a `<db>` cell"
        if (d.validators.length > 0) return "a validator on a `<db>` cell"
        if (d.body.length > 0) return "a body on a `<db>` cell"
        if (d.renders is given) return "`renders` on a `<db>` cell"
        return ""
    }

    // ---- s472: a `<db>` body (S472 ruling Q3; SPEC §4.18.1) -----------------
    // RULED S472 ("your recs on the 6", Q3): "The `<db>` body is code-default
    // and ITEM-ONLY (declarations, `function`/`fn`, `type`, markup, `"…"`
    // literals); a bare statement is refused (`E-DB-BODY-STATEMENT`), loose
    // prose is `E-UNQUOTED-DISPLAY-TEXT`." So nothing written in a `<db>` body
    // is ever page text (the free-text reading shipped a `function` there —
    // SQL included — verbatim into the page):
    //   - a markup element is markup (its own body free-text, as everywhere);
    //   - a `"…"` standing alone is a display-text literal, rendered in place;
    //   - `function` / `fn` / `type` (and `server function`, `export …`) is an
    //     item, read by the logic parser and HOISTED into the nearest item list
    //     (MP.hoist → parseMarkupItems) — the program's own function, whose
    //     `?{}` resolve to THIS `<db>` (FileAst.dbFns; analyze dbsPass, §8.1.1
    //     the nearest database scope);
    //   - a declaration is a per-request server cell (s473, readDbCell — ruling
    //     Q1): desugared into a hoisted program cell and its hoisted load;
    //   - `#{…}` is CSS, the other sigils as in markup;
    //   - anything else is a statement (E-DB-BODY-STATEMENT — a `<db>` body
    //     declares, it does not run: a `${…}`, an `<effect>`, a call, a write,
    //     control flow, `when`) or prose (E-UNQUOTED-DISPLAY-TEXT, one report
    //     per run of consecutive prose lines).
    // s473: `cells` — each db cell's (declaration nid, load function nid) pair (readDbCell).
    type RDbCellPair:struct = { decl: int, fn: int }
    type RDbBody:struct = { nodes: ANode[], items: AItem[], cells: RDbCellPair[], mp: MP }

    fn cellOfLoad(cs: RDbCellPair[], fid: int) -> int {
        for (const c of cs) { if (c.fn == fid) return c.decl }
        return -1
    }

    // ---- s478: `<schema>` (SPEC §39) ----------------------------------------
    // §39.2: "schema-block ::= '<schema>' table-declaration* closer" — its body
    // is the §39.2 declaration language, read by schema.scrml (readSchemaBody),
    // never as markup: the element keeps no children (it renders nothing; §39.1
    // "`<schema>` declares structure"). The body runs to the first closer, `</>`
    // or `</schema>`, outside a `//` comment or a quoted literal
    // (schema.scrml schemaCloseAt). Here, too: §39.3 "The `<schema>` block takes no
    // attributes" (each refused by name — the SPEC names no code), and "A file
    // SHALL NOT contain more than one `<schema>` block. A second `<schema>` block
    // in the same file SHALL be a compile error (E-SCHEMA-002)" (MP.schemaN
    // counts them). Where it stands (E-SCHEMA-003) and its database
    // (E-SCHEMA-001) are analyze's (resolveSchema).
    fn isSchemaOpener(o: Opener) -> boolean { return !o.star && o.name == "schema" }

    fn finishSchema(o: Opener, mp: MP) -> RElem {
        let m: MP = mp
        const d0: int = mp.diags.length
        const tagEnd: int = o.start + 7
        const why: string = " — §39.3: \"The `<schema>` block takes no attributes\" (its database is the enclosing `<program>`'s); the bootstrap refuses it rather than ignore it"
        for (const a of o.attrs) { m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` on `<schema>`" + why, a.span.start, a.span.end) }
        for (const v of o.vals) { m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the validator `" + v.name + "(…)` on `<schema>`" + why, v.span.start, v.span.end) }
        if (o.typed.length > 0 || hasOwn(o.own) || o.ty is given) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a typed or valued `<schema …>` opener is a declaration, not the §39 schema block" + why, o.start, tagEnd)
        if (o.short is given) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a `:`-shorthand body on `<schema>` — §39.2: the body is table declarations, between `<schema>` and its closer", o.start, tagEnd)
        if (m.schemaN > 0) m = mDiag(m, "E-SCHEMA-002", "a second `<schema>` block in this file — §39.3: \"A file SHALL NOT contain more than one `<schema>` block\"; declare every table in the first one", o.start, tagEnd)
        m = { src: m.src, pos: m.pos, nid: m.nid, diags: m.diags, file: m.file, hoist: m.hoist, dbFns: m.dbFns, hosts: m.hosts, pages: m.pages, eps: m.eps, chans: m.chans, onchs: m.onchs, schemaN: m.schemaN + 1, tables: m.tables, ns: m.ns }
        if (o.selfClosing || o.short is given) return elemFrom(o, [], m)
        const close: int = schemaCloseAt(m.src, m.pos)
        const bodyEnd: int = close < 0 ? m.src.length : close
        const rs: SchemaRead = readSchemaBody(m.src, m.pos, bodyEnd)
        for (const e of rs.errs) { m = mDiag(m, e.code, e.text, e.start, e.end) }
        if (close < 0) {
            m = mDiag(m, "E-PARSE-UNCLOSED", "`<schema>` is never closed (`</>` or `</schema>`)", o.start, tagEnd)
            return elemFrom(o, [], mAt(m, bodyEnd))
        }
        const closer: int = m.src.indexOf(">", close)
        // s478-boot-sql-row-types — the declared tables, kept for the §39.11 row types
        // ("The compiler generates struct types for each table in `<schema>` before running
        // the `<db>` type inference pass (§14.8)"). Fail closed: only the file's FIRST
        // `<schema>`, and only when reading it raised nothing above a warning (a refused or
        // broken column, an attribute) — a schema the bootstrap did not read whole types no row.
        let clean = m.schemaN == 1
        let di: int = 0
        for (const d of m.diags) {
            if (di >= d0 && d.code.substring(0, 2) != "W-") clean = false
            di = di + 1
        }
        if (clean) m = { src: m.src, pos: m.pos, nid: m.nid, diags: m.diags, file: m.file, hoist: m.hoist, dbFns: m.dbFns, hosts: m.hosts, pages: m.pages, eps: m.eps, chans: m.chans, onchs: m.onchs, schemaN: m.schemaN, tables: rs.tables, ns: m.ns }
        return elemFrom(o, [], mAt(m, closer + 1))
    }

    fn isDbOpener(o: Opener) -> boolean { return !o.star && o.name == "db" }

    // A `<db>` element after its opener: the item body, then the element; its
    // functions and types join MP.hoist, each function recorded as this
    // block's (MP.dbFns).
    fn finishDb(o: Opener, mp: MP) -> RElem {
        const rb: RDbBody = parseDbBody(mp, o.start)
        const r: RElem = elemFrom(o, rb.nodes, rb.mp)
        let fns: ADbFn[] = r.mp.dbFns
        for (const it of rb.items) {
            const fid: int = fnIdOfItem(it.k)
            if (fid >= 0) fns = fns.concat([{ fn: fid, db: r.e.nid, cell: cellOfLoad(rb.cells, fid), start: r.e.span.start, end: r.e.span.end }])
        }
        const m: MP = { src: r.mp.src, pos: r.mp.pos, nid: r.mp.nid, diags: r.mp.diags, file: r.mp.file, hoist: r.mp.hoist.concat(rb.items), dbFns: fns, hosts: r.mp.hosts, pages: r.mp.pages, eps: r.mp.eps, chans: r.mp.chans, onchs: r.mp.onchs, schemaN: r.mp.schemaN, tables: r.mp.tables, ns: r.mp.ns }
        return { e: r.e, mp: m }
    }

    fn fnIdOfItem(k: AItemK) -> int {
        return match k {
            .FnItem(f: f) :> f.nid
            .TypeItem(t: x) :> -1
            .ImportItem(i: i) :> -1
            .DeclItem(d: d) :> -1
            .MarkupItem(n: n) :> -1
            .ProgramItem(p: p) :> -1
            .ConstItem(c: c) :> -1
        }
    }

    fn parseDbBody(mp: MP, open: int) -> RDbBody {
        let m: MP = mp
        let out: ANode[] = []
        let items: AItem[] = []
        let cells: RDbCellPair[] = []
        // a pending prose run [proseStart, proseEnd), reported once
        let proseStart: int = -1
        let proseEnd: int = -1
        let going = true
        while (going) {
            m = skipTrivia(m)
            const at: int = m.pos
            const nd: int = m.diags.length
            let prose = false
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-UNCLOSED", "`<db>` is never closed", open, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                going = false
            } else if (atCss(m)) {
                const rc: RCss = parseCssNode(m)
                out = out.concat([rc.n])
                m = rc.mp
            } else if (atOtherSigil(m)) {
                m = skipSigil(m)
            } else if (atInterp(m)) {
                const tp: TP = regionTP(mAdv(m, 1), LexStop.Balanced)
                const end: int = lastEnd(tp)
                m = mDiag(mAt(m, end), "E-DB-BODY-STATEMENT", "a `" + interpOpen() + "…}` in a `<db>` body: " + dbStmtWhy() + " A value to display is a display-text literal (`\"" + interpOpen() + "…}\"`) or goes inside a markup element; a function or a type is written directly in the `<db>` body, without `" + interpOpen() + "…}`", at, end)
            } else if (dbDeclAt(m)) {
                const rc: RDbCell = readDbCell(m)
                m = rc.mp
                items = items.concat(rc.items)
                cells = cells.concat(rc.cells)
            } else if (keywordTagAt(m) >= 0) {
                m = dbKeywordOnMarkup(m)
            } else if (chAt(m, 0) == "<" && opensTag(chAt(m, 1))) {
                const ro: ROpener = parseOpener(m)
                const rn: RNodeOne = parseMarkupNode(m)
                if (isEffectOpener(ro.o)) {
                    m = mDiag(rn.mp, "E-DB-BODY-STATEMENT", "an `<effect>` in a `<db>` body: " + dbStmtWhy(), at, rn.mp.pos)
                } else {
                    out = out.concat([rn.n])
                    m = rn.mp
                }
            } else if (dbLiftMarkupAt(m)) {
                // s472 r1 (LOW-3): `lift <p>…</p>;` — a statement (§49.6.2), its operand markup
                const lw: RWord = readName(m)
                const ln: RNodeOne = parseMarkupNode(skipSpace(lw.mp))
                let lm: MP = skipSpace(ln.mp)
                if (chAt(lm, 0) == ";") lm = mAdv(lm, 1)
                m = mDiag(lm, "E-DB-BODY-STATEMENT", "`lift` in a `<db>` body: " + dbStmtWhy() + " (Markup to display stands in the `<db>` body without `lift`.)", at, lm.pos)
            } else if (dbOnBlockAt(m)) {
                // `on mount { … }` (§6.7.1a, soft-deprecated): a lifecycle statement
                const ob: TP = regionTP(m, LexStop.Statement)
                const oend: int = lastEnd(ob)
                m = mDiag(mAt(m, oend), "E-DB-BODY-STATEMENT", "`on " + ob.toks[1].text + " { … }` in a `<db>` body: " + dbStmtWhy(), at, oend)
            } else if (dbItemWordAt(m)) {
                const ri: RMItems = logicRegionItem(m, LexStop.Statement, false)
                m = ri.mp
                for (const it of ri.items) {
                    if (fnIdOfItem(it.k) >= 0 || isTypeItem(it.k)) {
                        items = items.concat([it])
                    } else {
                        m = mDiag(m, "E-DB-BODY-STATEMENT", "this is not a `function`, `fn` or `type` declaration: " + dbStmtWhy(), it.span.start, it.span.end)
                    }
                }
            } else if (chAt(m, 0) == "\"" && displayCloseAt(m.src, m.pos) < 0) {
                // §4.18.3 / §4.18.7: an unterminated literal — E-CTX-001, read to the body's closer
                const stop: int = firstBodyCloser(m.src, m.pos + 1, "db")
                m = mDiag(m, "E-CTX-001", "unterminated display-text literal: the `\"` opened here has no closing `\"` before the end of the file (§4.18.3) — read up to " + (stop >= m.src.length ? "the end of the file" : "the `<db>` body's closer"), at, at + 1)
                const ck: RCook = cookRecovered(mAt(m, stop), at + 1, stop)
                out = out.concat([textNode(ck.mp, at + 1, ck.text)])
                m = mBump(ck.mp)
            } else if (dbDisplayAt(regionTP(m, LexStop.CodeBody))) {
                const di: RNodes = parseDisplayItem(m, regionTP(m, LexStop.CodeBody))
                out = out.concat(di.nodes)
                m = di.mp
            } else {
                const end: int = dbStatementEnd(m)
                if (end > at) {
                    m = mDiag(mAt(m, end), "E-DB-BODY-STATEMENT", dbStmtWhy() + " (Display text here is a markup element, `<p>…</p>`, or a quoted display-text literal, `\"…\"`.)", at, end)
                } else {
                    prose = true
                    const pe: int = dbProseLineEnd(m)
                    if (proseStart < 0) proseStart = at
                    proseEnd = pe
                    m = mAt(m, pe)
                }
            }
            if (!prose && proseStart >= 0) {
                // the prose run's report goes BEFORE this item's (source order)
                m = dbProseDiag(m, proseStart, proseEnd, nd)
                proseStart = -1
            }
            if (going && m.pos == at) m = mAdv(m, 1)
        }
        if (proseStart >= 0) m = dbProseDiag(m, proseStart, proseEnd, m.diags.length)
        if (mLooking(m, "</")) m = parseCloser(m, "db")
        return { nodes: out, items: items, cells: cells, mp: m }
    }

    // =========================================================================
    // s473 (boot-host-block-f3) — THE `<host>` ELEMENT (DRAFT SPEC §21.3.3).
    // ruling:user-voice-scrml.md S473 "⭐ RULED — S473 PA recs, all" item 4 —
    // "F3 typed host binding Q1–Q5: a `<host>` block; `-> waiting T`; `!
    // HostError`; closed `:host` handles; checked results."
    //
    // Rule 1: "`<host>` SHALL appear at file top level or as a direct child of
    // `<program>`. A `<host>` anywhere else SHALL be `E-HOST-BINDING-PLACEMENT`.
    // It emits no HTML." An item position (parseTagItem) reads it here; any
    // other position (finishElem — an element's child, a `<db>` body, a
    // declaration body) refuses it (refuseHostPlacement).
    //
    // Rule 2: "Each body line SHALL be a blank line, a `//` comment, a
    // `host-type` line, a `host-binding` line, or a continuation line beginning
    // with `=`. Any other line SHALL be `E-HOST-BINDING-MALFORMED`."
    //
    // A line is read by THE SCRML LEXER (lexFrom, LexStop.Line) over the source
    // CUT at the line's end — no new reader, and no token of a line can run
    // past it (an unbalanced bracket ends at the cut, never in the next line or
    // past `</host>`). Its tokens are parsed by the logic parser's own pieces:
    // parseParamList (the §7.5 param-decl, as a `function`'s), parseType, and
    // parseAssign for the target (§21.3.3 "host-target ::= expression (* the
    // universal expression grammar; shapes checked, rule 4 *)").
    //
    // A binding is DESUGARED into a function item of the file (rule 9: "A
    // binding is a function bound in file scope (§7.6)") with an EMPTY body; its
    // host half is recorded in MP.hosts (FileAst.hosts). The target is never
    // resolved as scrml: it names host roots (`window`, `document`,
    // `navigator`) that are not scrml values; analyze turns the checked target
    // into Core's HostBind, which the printer emits as literal JavaScript (rule
    // 7: "SHALL NOT be built with the `Function` constructor or any other
    // run-time evaluation of source text").
    // =========================================================================
    fn isHostOpener(o: Opener) -> boolean { return !o.star && o.name == "host" }

    // Rule 1 — a `<host>` NOT at an item position: refused whole (opener to
    // `</host>`), its body never read as markup (it would render as page text).
    fn refuseHostPlacement(o: Opener, mp: MP, where: string) -> RElem {
        let end: int = mp.pos
        if (!o.selfClosing) {
            const close: int = mp.src.indexOf("</host>", mp.pos)
            if (close < 0) {
                end = mp.src.length
            } else {
                end = close + 7
            }
        }
        const m: MP = mDiag(mAt(mp, end), "E-HOST-BINDING-PLACEMENT", "`<host>` stands here " + where + " — a `<host>` block SHALL appear at file top level or as a direct child of `<program>` (§21.3.3 rule 1); move it there", o.start, end)
        return elemFrom(noVals(o), [], m)
    }

    // A `<host>` at an item position: its binding lines as hoisted items.
    fn finishHost(o: Opener, mp: MP, exported: boolean) -> RMItems {
        let m: MP = mp
        if (exported) m = mDiag(m, "E-PARSE-EXPORT", "`export` applies to a declaration, not to a `<host>` block (§21.3.3 rule 9: a binding is exported by name, §21.2)", o.start, o.start + 5)
        m = hostOpenerDiags(o, m)
        const src: string = hostSrcOf(o)
        if (o.selfClosing) return { items: [], mp: m }
        const blockTypes: string[] = hostBlockTypes(m.src, m.pos)
        let items: AItem[] = []
        let going = true
        while (going) {
            m = skipHostBlank(m)
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-UNCLOSED", "`<host>` is never closed", o.start, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                going = false
            } else {
                const before: int = m.pos
                const r: RMItems = hostLine(m, src, blockTypes)
                items = items.concat(r.items)
                m = r.mp
                if (m.pos <= before) m = mAdv(m, 1)
            }
        }
        if (mLooking(m, "</")) m = parseCloser(m, "host")
        return { items: items, mp: m }
    }

    // s473-host-allowlist-b (rule 8.6): the `type Name:host` names declared in
    // this block's body [pos, `</host>`) — a line that is exactly `type Name:host`.
    fn hostBlockTypes(src: string, pos: int) -> string[] {
        let end: int = src.indexOf("</host>", pos)
        if (end < 0) end = src.length
        let out: string[] = []
        for (const raw of src.substring(pos, end).split("\n")) {
            const l: string = raw.trim()
            if (l.startsWith("type ") && l.endsWith(":host")) {
                const n: string = l.substring(5, l.length - 5).trim()
                if (n != "" && n.indexOf(" ") < 0) out = out.concat([n])
            }
        }
        return out
    }

    // The opener carries `src="…"` and nothing else.
    fn hostOpenerDiags(o: Opener, mp: MP) -> MP {
        let m: MP = mp
        const why: string = " on `<host>` is not in the bootstrap — a `<host>` opener carries at most `src=\"./file.js\"` (§21.3.3 host-decl)"
        if (o.ty is given) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "an own type `<host:…>`" + why, o.start, o.start + 5)
        if (!isNoValue(o.own)) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "an own value `<host=…>`" + why, o.start, o.start + 5)
        for (const ta of o.typed) { m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the typed attribute `" + ta.name + ":…`" + why, ta.span.start, ta.span.end) }
        for (const v of o.vals) { m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the validator `" + v.name + "(…)`" + why, v.span.start, v.span.end) }
        if (o.short is given) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a `:`-shorthand body" + why, o.start, o.start + 5)
        for (const a of o.attrs) {
            if (a.name != "src") {
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the attribute `" + a.name + "`" + why, a.span.start, a.span.end)
            } else {
                m = hostSrcDiags(a, m)
            }
        }
        return m
    }

    fn hostSrcOf(o: Opener) -> string {
        for (const a of o.attrs) {
            if (a.name == "src") {
                const v: AAttrValue = a.value
                const q: string | not = quotedOf(v)
                if (q is given) return q
                return "?"
            }
        }
        return ""
    }

    fn quotedOf(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> s
            .Dur(text: s) :> s
            .NoValue :> not
            .Bare(e: x) :> not
            .Paren(e: x) :> not
            .Braced(b: x) :> not
        }
    }

    // Rule 3: "`src=` SHALL be a relative `.js` or `.mjs` path: a string that
    // begins with `./` or `../`, uses `/` as its only separator, contains no
    // `?`, `#` or `\`, and ends exactly in `.js` or `.mjs` (case included). Any
    // other value (… a non-string) SHALL be `E-HOST-SRC-INVALID`; a specifier
    // that names no relative path at all (`x.js`) is the §21.3 bare-specifier
    // `E-IMPORT-005`." A valid one is read by the driver (rule 3 "Exports are
    // read statically" — slice-m1/host-src.js, s473 allowlist lane A).
    fn hostSrcDiags(a: AAttr, mp: MP) -> MP {
        const q: string | not = quotedOf(a.value)
        if (q is not) return mDiag(mp, "E-HOST-SRC-INVALID", "`<host src=…>` is not a string — `src=` is a quoted relative `.js` / `.mjs` path (§21.3.3 rule 3)", a.span.start, a.span.end)
        const rel: boolean = q.startsWith("./") || q.startsWith("../")
        const looksAbs: boolean = q.startsWith("/") || q.indexOf(":") >= 0 || q.indexOf("\\") >= 0
        if (!rel && !looksAbs) return mDiag(mp, "E-IMPORT-005", "`<host src=\"" + q + "\">` names no relative path — a bare specifier; write `./" + q + "` (§21.3.3 rule 3, §21.3)", a.span.start, a.span.end)
        const extOk: boolean = q.endsWith(".js") || q.endsWith(".mjs")
        if (!rel || looksAbs || q.indexOf("?") >= 0 || q.indexOf("#") >= 0 || !extOk) {
            return mDiag(mp, "E-HOST-SRC-INVALID", "`<host src=\"" + q + "\">` is not a relative `.js` / `.mjs` path — it SHALL begin with `./` or `../`, use `/` as its only separator, contain no `?`, `#` or `\\`, and end exactly in `.js` or `.mjs` (§21.3.3 rule 3)", a.span.start, a.span.end)
        }
        // s473 (allowlist lane A): a valid `src=` is built — the file's existence, project-root and
        // copy-class checks, its static export read and its copy are the driver's (slice-m1/host-src.js,
        // over the checked Core: E-IMPORT-006 / -011 / -004), since only the driver reads files
        return mp
    }

    // Rule 2's skippable lines: blank space and `//` comments.
    fn skipHostBlank(mp: MP) -> MP {
        let m: MP = mp
        let going = true
        while (going && !mEof(m)) {
            if (isSpaceCh(chAt(m, 0))) {
                m = mAdv(m, 1)
            } else if (mLooking(m, "//")) {
                m = skipLineComment(m)
            } else {
                going = false
            }
        }
        return m
    }

    fn hostLineEnd(src: string, pos: int) -> int {
        const i: int = src.indexOf("\n", pos)
        if (i < 0) return src.length
        return i
    }

    // The `=` that begins the line after the one ending at `end` (a
    // continuation, rule 2); -1 when that line does not begin with `=`.
    fn hostContAt(src: string, end: int) -> int {
        if (end >= src.length) return -1
        let i: int = end + 1
        while (i < src.length && (src.charAt(i) == " " || src.charAt(i) == "\t" || src.charAt(i) == "\r")) { i = i + 1 }
        if (src.charAt(i) == "=" && src.charAt(i + 1) != "=") return i
        return -1
    }

    // One physical line [start, end), lexed by the scrml lexer over the source cut at `end`.
    fn hostLineToks(src: string, start: int, end: int) -> PTok[] {
        const run: LexRun = lexFrom(src.substring(0, end), start, LexStop.Line)
        return toPToks(run.tokens)
    }

    fn withoutLast(ts: PTok[]) -> PTok[] { return ts.slice(0, ts.length - 1) }

    fn hostMalformed(mp: MP, start: int, end: int, why: string) -> RMItems {
        const m: MP = mDiag(mAt(mp, end), "E-HOST-BINDING-MALFORMED", why + " — a `<host>` body line is a blank line, a `//` comment, `type Name:host`, a binding `name(params) -> Result = target`, or a continuation line beginning with `=` (§21.3.3 rule 2)", start, end)
        return { items: [], mp: m }
    }

    // s473 (#1659 review L1): the line-terminators the scrml lexer stops at that `hostLineEnd`
    // (which cuts at `\n`) does NOT — U+2028, U+2029, and a lone CR not part of a CRLF. Their
    // presence would silently drop the text after them, so a binding line containing one is
    // refused, never read as a shorter line.
    fn hostLineTermIn(src: string, start: int, end: int) -> boolean {
        let i: int = start
        while (i < end) {
            const c: string = src.charAt(i)
            if (c == " " || c == " ") return true
            if (c == "\r" && src.charAt(i + 1) != "\n") return true
            i = i + 1
        }
        return false
    }

    fn hostLine(mp: MP, src: string, blockTypes: string[]) -> RMItems {
        const at: int = mp.pos
        let end: int = hostLineEnd(mp.src, at)
        const c0: string = chAt(mp, 0)
        if (c0 == "<" || c0 == "$" || c0 == "#" || c0 == "\"" || c0 == "'" || c0 == "`" || c0 == "/" || c0 == "=") {
            return hostMalformed(mp, at, end, "this line is not a binding")
        }
        if (hostLineTermIn(mp.src, at, end)) {
            return hostMalformed(mp, at, end, "this line contains a U+2028 / U+2029 line separator or a lone CR — a binding stands on one line (its text would otherwise be silently cut there)")
        }
        let lexed: PTok[] = hostLineToks(mp.src, at, end)
        let toks: PTok[] = withoutLast(lexed)
        let going = true
        while (going) {
            const nx: int = hostContAt(mp.src, end)
            if (nx < 0) {
                going = false
            } else {
                const e2: int = hostLineEnd(mp.src, nx)
                if (hostLineTermIn(mp.src, nx, e2)) {
                    return hostMalformed(mp, at, e2, "a continuation line contains a U+2028 / U+2029 line separator or a lone CR")
                }
                lexed = hostLineToks(mp.src, nx, e2)
                toks = toks.concat(withoutLast(lexed))
                end = e2
            }
        }
        toks = toks.concat([lexed[lexed.length - 1]])
        const t0: TP = { toks: toks, i: 0, nid: mp.nid, diags: mp.diags, file: mp.file, ns: mp.ns, inFn: 0 }
        if (isWord(t0, "type")) return hostTypeLine(mp, t0, at, end, src)
        return hostBindLine(mp, t0, at, end, src, blockTypes)
    }

    // A built-in type name, or a built-in declaration's name, a `:host` handle may not reuse.
    fn hostReservedTypeName(n: string) -> boolean {
        return n == "int" || n == "number" || n == "bool" || n == "string" || n == "integer" || n == "boolean"
            || n == "void" || n == "not" || n == "struct" || n == "enum" || n == "any" || n == "asIs"
            || n == "Object" || n == "Array" || n == "Function" || n == "Error" || n == "SqlError" || n == "ServerCallError"
            || n == "map" || n == "set" || n == "Line" || n == "Openness"
    }

    // `type Name:host` (rule 15: "`type Name:host` declares a nominal, opaque host type").
    fn hostTypeLine(mp: MP, t0: TP, at: int, end: int, src: string) -> RMItems {
        const n: PTok = peekAt(t0, 1)
        const c: PTok = peekAt(t0, 2)
        const h: PTok = peekAt(t0, 3)
        const e: PTok = peekAt(t0, 4)
        const nameOk: boolean = n.cls == TC.Ident || n.cls == TC.Keyword
        if (!nameOk || !tk(c, ":") || h.cls != TC.Ident || h.v != "host" || e.cls != TC.End) {
            return hostMalformed(mp, at, end, "a type line in a `<host>` is exactly `type Name:host`")
        }
        // s473 (#1659 review L2): a `:host` handle may not take a built-in type name
        // (`type string:host`, `type Object:host`, `type void:host`) — the built-in wins in
        // decode, so the declaration would be a dead, confusing shadow. A keyword name is reserved.
        if (hostReservedTypeName(n.v) || n.cls == TC.Keyword) {
            return { items: [], mp: mAt(mDiag(mp, "E-SCOPE-010", "`type " + n.v + ":host` names the built-in type `" + n.v + "` — a `:host` handle type SHALL have a fresh name (§21.3.3 rule 15, §7.6)", at, end), end) }
        }
        // s473-host-allowlist-b (DRAFT rule 8.6, ruling Q2 — "WebIDL interface names are built-in
        // scrml types, replacing user-named handles"): an Appendix H interface name is a built-in
        // host type a user type SHALL NOT reuse (rule 8.1, E-SCOPE-010); and a user-named handle
        // has a producer only in the `src=` world, so `type Name:host` in a `<host>` without
        // `src=` is E-HOST-TYPE-NO-SRC (the item is kept, so its uses resolve).
        if (isSurfaceIface(n.v)) {
            return { items: [], mp: mAt(mDiag(mp, "E-SCOPE-010", "`type " + n.v + ":host` names the built-in host type `" + n.v + "` (Appendix H) — write `" + n.v + "` as a parameter or result type directly, with no type line (§21.3.3 rule 8.1)", at, end), end) }
        }
        let mp0: MP = mp
        if (src == "") mp0 = mDiag(mp, "E-HOST-TYPE-NO-SRC", "`type " + n.v + ":host` stands in a `<host>` without `src=` — no host-surface entry returns a user-named handle, so it has no producer here; use the Appendix H interface name as the type (`IntersectionObserver`, `HTMLElement`, `DOMRect`, …), or move the binding that returns it into a `<host src=\"./glue.js\">` (§21.3.3 rule 8.6)", at, end)
        const td: ATypeDecl = { nid: mp0.nid, span: mkSpan(at, end), exported: false, name: n.v, body: ATypeBody.HostBody }
        const m1: MP = mBump(mp0)
        const it: AItem = { nid: m1.nid, span: mkSpan(at, end), k: AItemK.TypeItem(td) }
        return { items: [it], mp: mAt(mBump(m1), end) }
    }

    // `[fn] name(params) [-> [waiting] T] [! E] [= target]` (§21.3.3 host-binding).
    fn hostBindLine(mp: MP, t0: TP, at: int, end: int, src: string, blockTypes: string[]) -> RMItems {
        let t: TP = t0
        let isFn = false
        if (isWord(t, "pure")) return hostMalformed(mp, at, end, "a binding spelled with the deprecated `pure` (a pure binding is spelled `fn`, §33)")
        if (isWord(t, "fn")) {
            isFn = true
            t = adv(t)
        }
        const nameTok: PTok = cur(t)
        if (nameTok.cls != TC.Ident || !tk(peekAt(t, 1), "(")) return hostMalformed(mp, at, end, "this line is not a binding")
        const rp: RParams = parseParamList(adv(adv(t)), false)
        if (!isP(rp.tp, ")")) return hostMalformed(mp, at, end, "a binding's parameter list does not close on its line")
        t = adv(rp.tp)
        let ret: AType | not = not
        let waiting = false
        let hasResult = false
        let failable = false
        let errTok: PTok = cur(t)
        let errName: string = ""
        const a: PTok = cur(t)
        const b: PTok = peekAt(t, 1)
        if (tk(a, "-") && tk(b, ">") && touching(a, b)) {
            hasResult = true
            t = adv(adv(t))
            if (isWord(t, "waiting")) {
                waiting = true
                t = adv(t)
            }
            const rr: RType = parseType(t)
            ret = rr.t
            t = rr.tp
        } else if (isP(t, ":")) {
            // s477 — §7: "`->` is the sole return-type annotation syntax"
            return hostMalformed(mp, at, end, "a binding's result type is written `-> T`, not `: T` — write `" + nameTok.v + "(…) -> T = target` (§21.3.3; §7)")
        }
        if (isP(t, "!")) {
            failable = true
            t = adv(t)
            errTok = cur(t)
            const re: RType = parseType(t)
            errName = typeNameText(re.t)
            t = re.tp
        }
        let target: AExpr | not = not
        let isNew = false
        if (isP(t, "=")) {
            t = adv(t)
            if (isWord(t, "new")) {
                isNew = true
                t = adv(t)
            }
            const rx: RExpr = parseAssign(t)
            target = rx.e
            t = rx.tp
        }
        if (!atEnd(t)) {
            const rest: PTok = cur(t)
            return hostMalformed(mp, at, end, "unexpected `" + rest.text + "` in a binding line")
        }
        const fnNid: int = t.nid
        t = bumpId(t)
        const body: ABlock = { nid: t.nid, span: mkSpan(at, end), stmts: [] }
        t = bumpId(t)
        const f: AFn = { nid: fnNid, span: mkSpan(at, end), exported: false, pure: isFn, name: nameTok.v, params: rp.ps,
                         ret: ret, body: body, server: false, failable: false, err: not }
        const it: AItem = { nid: t.nid, span: mkSpan(at, end), k: AItemK.FnItem(f) }
        t = bumpId(t)
        const hb: AHostBind = { fn: fnNid, span: mkSpan(at, end), target: target, isNew: isNew, waiting: waiting,
                                failable: failable, hasResult: hasResult, src: src, isFn: isFn, blockTypes: blockTypes }
        let ds: Diag[] = t.diags
        if (waiting) ds = ds.concat([newDiag("E-BOOTSTRAP-UNSUPPORTED", "`" + nameTok.v + "` is declared `-> waiting …` — a waiting `<host>` binding (§21.3.3 rule 17: \"A call of a binding declared `-> waiting T` is a waiting value (§13.8)\") is not in the bootstrap yet; its settled-value decode and §13.8 placement are not built", mp.file, mkSpan(at, end))])
        if (failable) {
            if (errName != "HostError") {
                ds = ds.concat([newDiag("E-HOST-ERROR-TYPE", "`" + nameTok.v + "` is declared `! " + errName + "` — a `<host>` binding's `!` names `HostError` (`scrml:host`) and no other type (§21.3.3 rule 18)", mp.file, mkSpan(errTok.start, errTok.end))])
            } else {
                ds = ds.concat([newDiag("E-BOOTSTRAP-UNSUPPORTED", "`" + nameTok.v + "` is declared `! HostError` — a failable `<host>` binding (§21.3.3 rule 18: a throw or rejection \"SHALL produce `HostError::Thrown(message, name)`\") is not in the bootstrap yet; `scrml:host`'s `HostError` is not built. Without `!`, a throwing target is the trap `E-HOST-THROW-RT`", mp.file, mkSpan(at, end))])
            }
        }
        ds = ds.concat(hostTargetDiags(mp.file, nameTok.v, rp.ps, target, isNew, isFn, src, mkSpan(at, end)))
        const m: MP = { src: mp.src, pos: end, nid: t.nid, diags: ds, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts.concat([hb]), pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
        return { items: [it], mp: m }
    }

    fn typeNameText(t: AType) -> string {
        return match t.k {
            .TName(name: n) :> n
            .TSeq(elem: e) :> typeNameText(e) + "[]"
            .TMaybe(inner: i) :> typeNameText(i) + " | not"
            .TLife(pre: f, post: x) :> "(" + typeNameText(f) + " to " + typeNameText(x) + ")"
            .TRefine(base: b, pred: p) :> typeNameText(b) + "(" + p + ")"
            .TFn(params: ps, ret: r, fx: x) :> fnTypeText(ps, r, x)
        }
    }

    // s478 (s478-boot-fn-type) — `(T1, T2) => R` / `() => void`; s478-ruled-fn-types: `fn (…) => R`
    // (pure), `(…)! E => R` (failable)
    fn fnTypeText(ps: AType[], ret: AType | not, fx: AFnFx) -> string {
        let parts: string[] = []
        for (const p of ps) { parts = parts.concat([typeNameText(p)]) }
        let r: string = "void"
        if (ret is given) r = typeNameText(ret)
        let lead: string = ""
        if (fx.pure) lead = "fn "
        let bang: string = ""
        if (fx.failable) bang = "!"
        const e: AType | not = fx.err
        if (e is given) bang = "! " + typeNameText(e)
        return lead + "(" + parts.join(", ") + ")" + bang + " => " + r
    }

    // ---- the target checks (rules 4, 5, 6, 8, 11) — the target's view is ast.scrml hostView / hostTargetParts ----
    fn hostParamIndex(ps: AParam[], n: string) -> int {
        let i: int = 0
        for (const p of ps) {
            if (p.name == n) return i
            i = i + 1
        }
        return -1
    }

    // Rules 4, 5, 6, 11 (the target's shape). Rule 8 — the allowlist — is NOT judged here:
    // s473-host-allowlist-b replaced #1659's INTERIM denylist (hostSinkWhy and its name tables
    // hostExecSink / hostRealmResultWord / hostWriteSinkWord, deleted once
    // slice-m4/host-allowlist-parity-s473.test.js proved the walk refuses every line they
    // refused) with the TYPED CHAIN WALK in analyze.scrml (hostWalk), which needs the
    // parameters' resolved types.
    fn hostTargetDiags(file: string, name: string, ps: AParam[], target0: AExpr | not, isNew: boolean, isFn: boolean, src: string, line: ASpan) -> Diag[] {
        let out: Diag[] = []
        for (const p of ps) {
            if (hostRootGlobal(p.name) || p.name == "globalThis") {
                out = out.concat([newDiag("E-BOOTSTRAP-UNSUPPORTED", "the parameter `" + p.name + "` of the binding `" + name + "` is named like a host root — which one a target's `" + p.name + "` names is not ruled (§21.3.3 rule 4); rename the parameter", file, p.span)])
            }
        }
        if (target0 is not) {
            if (src == "") out = out.concat([newDiag("E-HOST-NO-TARGET", "the binding `" + name + "` has no `= target`, and its `<host>` has no `src=` — in a `<host>` without `src=`, every binding SHALL have a target (§21.3.3 rule 6): `" + name + "(…) -> T = window.…`", file, line)])
            return out
        }
        const target: AExpr = target0
        const sp: ASpan = target.span
        const parts: HTargetParts = hostTargetParts(target, isNew)
        const shapeWhy: string = " — a target SHALL be exactly one call, `new` construction, property read or property write, its callee a dotted member chain rooted at a parameter, `window`, `document` or `navigator`, each argument a parameter, a string / number / bool literal, or a one-level object literal of those (§21.3.3 rule 4)"
        if (!parts.ok) return out.concat([newDiag("E-HOST-TARGET-SHAPE", "the target of `" + name + "` is not a call, `new`, property read or property write" + shapeWhy, file, sp)])
        const ch: HChain = parts.chain
        if (!ch.ok) return out.concat([newDiag("E-HOST-TARGET-SHAPE", "the target of `" + name + "` does not name a dotted member chain (a computed member `a[k]`, a call inside the chain, or another expression)" + shapeWhy, file, sp)])
        if (parts.shape >= 2 && ch.members.length == 0) return out.concat([newDiag("E-HOST-TARGET-SHAPE", "the target of `" + name + "` reads or writes `" + ch.root + "` itself, not a property of it" + shapeWhy, file, sp)])
        // s473 (#1659 review H1 (b)): a call / `new` whose callee is a bare root (a parameter,
        // so a `:host` handle, or a global) with no members — rule 4 says the callee is a dotted
        // member chain, and a callable handle is the whole fail-open. Refuse it.
        // s473 (allowlist lane A, rule 4 "an export of `src` (when `src=` is present)"): in a `<host src=>`
        // a root that is not a parameter or a host root names an export of the file — the driver reads the
        // exports statically and refuses one the file does not export (E-HOST-TARGET-UNBOUND). Calling the
        // export itself (`= mountChart(el)`) is the A-world (design §5.2 step 5): the author's JavaScript.
        const srcRoot: boolean = src != "" && hostParamIndex(ps, ch.root) < 0 && !hostRootGlobal(ch.root) && ch.root != "globalThis"
        if (parts.shape <= 1 && ch.members.length == 0 && !srcRoot) return out.concat([newDiag("E-HOST-TARGET-SHAPE", "the target of `" + name + "` calls `" + ch.root + "` directly, with no member — a binding's callee SHALL be a dotted member chain (§21.3.3 rule 4), never a bare parameter or a bare global (a callable `:host` handle is a rule 8 fail-open, S473 #1659)" + shapeWhy, file, sp)])
        for (const mb of ch.members) {
            if (mb == "constructor" || mb == "prototype" || mb == "__proto__") return out.concat([newDiag("E-HOST-TARGET-SHAPE", "the target of `" + name + "` names `" + mb + "` — a member named `constructor`, `prototype` or `__proto__` SHALL NOT appear in a target's chain (§21.3.3 rule 4)", file, sp)])
        }
        const rootParam: int = hostParamIndex(ps, ch.root)
        if (rootParam < 0 && !hostRootGlobal(ch.root) && !srcRoot) return out.concat([newDiag("E-HOST-TARGET-UNBOUND", "the target of `" + name + "` is rooted at `" + ch.root + "`, which is not a parameter of the binding, an export of `src`, or `window` / `document` / `navigator` (§21.3.3 rule 4; `globalThis` and other globals are not roots)", file, sp)])
        if (isFn && rootParam < 0 && !srcRoot) return out.concat([newDiag("E-HOST-TARGET-SHAPE", "`" + name + "` is declared `fn` (deterministic, no effect — §21.3.3 rule 11) but its target is rooted at `" + ch.root + "`: those reads are the `E-FN-004` class; drop `fn`", file, sp)])
        // the arguments (rule 4)
        let uses: string[] = []
        if (rootParam >= 0) uses = uses.concat([ch.root])
        for (const x of parts.args) {
            const av: HView = hostView(x)
            if (av.k == 0) {
                if (hostParamIndex(ps, av.name) < 0) return out.concat([newDiag("E-HOST-TARGET-SHAPE", "an argument of `" + name + "`'s target is `" + av.name + "`, which is not a parameter of the binding" + shapeWhy, file, x.span)])
                uses = uses.concat([av.name])
            } else if (av.k == 7) {
                for (const pr of av.props) {
                    if (pr.spread) return out.concat([newDiag("E-HOST-TARGET-SHAPE", "a spread in an object-literal argument of `" + name + "`'s target" + shapeWhy, file, pr.span)])
                    if (pr.name == "__proto__") return out.concat([newDiag("E-HOST-TARGET-SHAPE", "an object-literal key `__proto__` in `" + name + "`'s target (§21.3.3 rule 4)", file, pr.span)])
                    const pv: HView = hostView(pr.value)
                    if (pv.k == 0) {
                        if (hostParamIndex(ps, pv.name) < 0) return out.concat([newDiag("E-HOST-TARGET-SHAPE", "an object-literal value in `" + name + "`'s target is `" + pv.name + "`, which is not a parameter of the binding" + shapeWhy, file, pr.value.span)])
                        uses = uses.concat([pv.name])
                    } else if (pv.k < 4 || pv.k > 6) {
                        return out.concat([newDiag("E-HOST-TARGET-SHAPE", "an object-literal value in `" + name + "`'s target is not a parameter or a literal (one level only)" + shapeWhy, file, pr.value.span)])
                    }
                }
            } else if (av.k < 4 || av.k > 6) {
                return out.concat([newDiag("E-HOST-TARGET-SHAPE", "an argument of `" + name + "`'s target is not a parameter, a literal, or a one-level object literal (an operator, a lambda, a nested call, a spread, a template …)" + shapeWhy, file, x.span)])
            }
        }
        // rule 5 — each declared parameter exactly once
        for (const p of ps) {
            let n: int = 0
            for (const u of uses) {
                if (u == p.name) n = n + 1
            }
            if (n != 1) {
                let how: string = "does not use it"
                if (n > 1) how = "uses it " + n + " times"
                out = out.concat([newDiag("E-HOST-PARAM-USE", "the parameter `" + p.name + "` of `" + name + "` SHALL appear exactly once in its target, and the target " + how + " (§21.3.3 rule 5)", file, p.span)])
            }
        }
        return out
    }

    fn isTypeItem(k: AItemK) -> boolean {
        return match k {
            .TypeItem(t: t) :> true
            .FnItem(f: f) :> false
            .ImportItem(i: i) :> false
            .DeclItem(d: d) :> false
            .MarkupItem(n: n) :> false
            .ProgramItem(p: p) :> false
            .ConstItem(c: c) :> false
        }
    }

    fn dbStmtWhy() -> string {
        return "a `<db>` body declares; it does not run (S472 ruling Q3, §4.18.1). Move this into a function, or into the `<program>` body."
    }

    // `function`, `fn`, `type`, `server` (the deprecated `server function`,
    // §52.10) or `export` not before a tag: an item the logic parser reads.
    // s472 r1 (LOW-3): judged by the HEAD's shape, not the word alone — prose
    // that starts with the word (`function of this block …`, `type in your
    // name`) is prose, never handed to the logic parser (which would read it
    // to end of file): `function` / `fn` NAME `(`, `type` NAME `:` / `=`,
    // `server` before one of those, `export` before any of them.
    fn dbItemWordAt(mp: MP) -> boolean {
        const w: RWord = readName(mp)
        if (w.w == "export") {
            const after: MP = skipTrivia(w.mp)
            if (chAt(after, 0) == "<") return false
            return dbItemHeadAt(after)
        }
        return dbItemHeadAt(mp)
    }

    fn dbItemHeadAt(mp: MP) -> boolean {
        const tp: TP = regionTP(mp, LexStop.CodeBody)
        if (tp.toks.length < 4) return false
        let i: int = 0
        if (isWord(tp, "server")) i = 1
        const t0: PTok = tp.toks[i]
        if (t0.cls != TC.Ident && t0.cls != TC.Keyword) return false
        let j: int = i + 1
        // `function* name(` — a generator
        if ((t0.v == "function" || t0.v == "fn") && tk(tp.toks[j], "*")) j = j + 1
        if (j + 1 >= tp.toks.length) return false
        const t1: PTok = tp.toks[j]
        const t2: PTok = tp.toks[j + 1]
        if (t1.cls != TC.Ident || t1.line != t0.line) return false
        if (t0.v == "function" || t0.v == "fn") return tk(t2, "(") || tk(t2, "<")
        if (i == 0 && t0.v == "type") return tk(t2, ":") || tk(t2, "=") || tk(t2, "<")
        return false
    }

    // `lift` then (on its line) a tag — `lift <li>…</li>;`.
    fn dbLiftMarkupAt(mp: MP) -> boolean {
        const w: RWord = readName(mp)
        if (w.w != "lift") return false
        let m: MP = w.mp
        while (chAt(m, 0) == " " || chAt(m, 0) == "\t") { m = mAdv(m, 1) }
        return chAt(m, 0) == "<" && opensTag(chAt(m, 1)) && m.pos > w.mp.pos
    }

    // `on <word> {` — the lifecycle-statement head (`on mount { … }`, §6.7.1a).
    fn dbOnBlockAt(mp: MP) -> boolean {
        const w: RWord = readName(mp)
        if (w.w != "on") return false
        const tp: TP = regionTP(mp, LexStop.CodeBody)
        if (tp.toks.length < 4) return false
        const t1: PTok = tp.toks[1]
        return (t1.cls == TC.Ident || t1.cls == TC.Keyword) && tk(tp.toks[2], "{") && t1.line == tp.toks[0].line
    }

    // `let` / `export` before a tag that declares nothing (dbDeclAt took the
    // declarations): the program body's reports (letOnNonDecl / E-PARSE-EXPORT),
    // then the tag is read as the markup it is.
    fn dbKeywordOnMarkup(mp: MP) -> MP {
        const lt: int = keywordTagAt(mp)
        const kw: string = mp.src.substring(mp.pos, lt).trim()
        const nw: RWord = readName(mAt(mp, lt + 1))
        const name: string = nw.w
        let m: MP = mp
        if (kw.startsWith("export")) m = mDiag(m, "E-PARSE-EXPORT", "`export` applies to a declaration, not to markup", mp.pos, mp.pos + 6)
        if (kw.endsWith("let")) m = mDiag(m, "E-PARSE-LET", "`let` applies to a declaration — `<" + name + ">` declares nothing (a declaration has an own value `=…`, a `:Type`, or a typed attribute, §66.2.2; a container is `<" + name + ":struct>`)", mp.pos, mp.pos + kw.length)
        return mAt(m, lt)
    }

    // A display-text literal standing alone (§4.18.3, §7.2.2 rule 2 — it takes
    // no `;`): the run's first token is a `"…"` and what follows it is the run's
    // end, another `"…"` literal, or a later line.
    fn dbDisplayAt(d: TP) -> boolean {
        if (d.toks.length < 2) return false
        const t0: PTok = d.toks[0]
        if (t0.cls != TC.Str || t0.text.substring(0, 1) != "\"") return false
        const t1: PTok = d.toks[1]
        if (t1.cls == TC.End) return true
        if (t1.cls == TC.Str && t1.text.substring(0, 1) == "\"") return true
        return t1.line > t0.line && t0.text.indexOf("\n") < 0
    }

    // Where the ONE statement at `mp` ends, when the run there reads as a whole
    // statement (§40.8's reading of a code-default body run): it parses with no
    // error beyond a missing `;`, and ends at its `;`, the run's end, a block's
    // `}` or a line break. Otherwise `mp.pos` — the run is prose.
    fn dbStatementEnd(mp: MP) -> int {
        const tp0: TP = codeRegionTP(mp, LexStop.CodeBody)
        const tp: TP = { toks: tp0.toks, i: 0, nid: mp.nid, diags: [], file: mp.file, ns: mp.ns, inFn: 0 }
        if (atEnd(tp)) return mp.pos
        const rs: RStmt = parseStmt(tp)
        const t: TP = rs.tp
        if (t.i == 0 || hardErrors(t.diags) > 0) return mp.pos
        const last: PTok = t.toks[t.i - 1]
        const nx: PTok = cur(t)
        if (isP(t, ";")) return nx.end
        if (nx.cls == TC.End || tk(last, "}") || nx.line > last.line) return last.end
        return mp.pos
    }

    // A prose line: up to the end of the last token on the run's first line.
    fn dbProseLineEnd(mp: MP) -> int {
        const tp: TP = codeRegionTP(mp, LexStop.CodeBody)
        if (tp.toks.length < 2) return mp.pos + 1
        const line: int = tp.toks[0].line
        let end: int = tp.toks[0].end
        for (const t of tp.toks) {
            if (t.cls != TC.End && t.line == line) end = t.end
        }
        // s472 r1 (LOW-3): never past the line's end — a token that starts on
        // the line and runs on (an apostrophe read as a string: `Don't do this`)
        // does not take the rest of the file into the run
        const nl: int = mp.src.indexOf("\n", mp.pos)
        if (nl > mp.pos && nl < end) return nl
        return end
    }

    // The report of a prose run, placed at index `at` of the diagnostics.
    fn dbProseDiag(mp: MP, start: int, end: int, at: int) -> MP {
        const text: string = mp.src.substring(start, end).trim()
        // s472 r1 (LOW-3): a `"` in the run is escaped in the suggested literal (§4.18.3 `\"`)
        const quoted: string = "\"" + text.split("\\").join("\\\\").split("\"").join("\\\"") + "\""
        const d: Diag = newDiag("E-UNQUOTED-DISPLAY-TEXT", "display text in a `<db>` body is declared — a markup element (`<p>" + text + "</p>`) or a quoted display-text literal (`" + quoted + "`): a `<db>` body is a code-default item body, never page text (S472 ruling Q3, §4.18.1 / §4.18.7)", mp.file, mkSpan(start, end))
        const ds: Diag[] = mp.diags.slice(0, at).concat([d]).concat(mp.diags.slice(at, mp.diags.length))
        return { src: mp.src, pos: mp.pos, nid: mp.nid, diags: ds, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    // Report the keyword (its span) and resume at the tag, which then parses
    // as the markup node it is.
    fn keywordNotItem(mp: MP, tag: string, freeText: boolean) -> MP {
        const lt: int = keywordTagAt(mp)
        const kw: string = mp.src.substring(mp.pos, lt).trim()
        const body: string = freeText ? "free-text" : "code-default"
        const escape: string = freeText ? " — or, if you meant the word, write `" + interpOpen() + "\"" + kw + "\"}`" : " (display text here is a quoted literal, §4.18.3)"
        const d: MP = mDiag(mp, "E-DECL-KEYWORD-NOT-ITEM", "`" + kw + "` before a declaration declares an ITEM, and only a program body or a declaration body holds items — not the " + body + " body of `<" + tag + ">` (§66.2.5); move the declaration to the program body or into a declaration's body, or drop `" + kw + "`" + escape, mp.pos, mp.pos + kw.length)
        return mAt(d, lt)
    }

    // RULED S442 (dpa-045 follow-up 1): the context sigils are exits of free
    // text — `${` (an interpolation), `#{` (CSS), and `^{` (meta, §22.2), `!{`
    // (error context, §19) and `~{` (test context, §19.12 — SPEC §4.18.1b, PA
    // reading S442), which the bootstrap does not build: skipped whole by the
    // canonical walker and reported. NOT an exit: `?{` — its §3.1 parent is
    // Logic only, so in a markup body it is content (§4.18.1b, §8.1).
    fn atOtherSigil(mp: MP) -> boolean {
        if (chAt(mp, 1) != "{") return false
        const c: string = chAt(mp, 0)
        return c == "^" || c == "!" || c == "~"
    }

    // `_` + zero or more `=` + `{` (§23.2) whose `_` does not end an
    // identifier (`my_{x}` is content): the level (count of `=`), else -1.
    // s473: lex.scrml's reader (the one spelling of the grammar).
    fn foreignLevel(mp: MP) -> int { return foreignOpenAt(mp.src, mp.pos) }

    // SPEC §4.18.1b (PA reading S442): `_{` in a markup body is NEITHER an exit
    // NOR content — it stays an ERROR, E-FOREIGN-004 (§23.2.4: a markup element
    // body is not a valid foreign-code context). Its extent is §23.2's: opaque
    // up to `}` + the opener's `=` count (level 0: brace depth) — never text.
    // Unclosed → E-FOREIGN-002 (§23.2).
    fn skipForeign(mp: MP) -> MP {
        const start: int = mp.pos
        const x: ForeignExtent = foreignExtentAt(mp.src, mp.pos)    // s473: lex.scrml's reader
        const m: MP = mAt(mp, x.end)
        if (x.closer < 0) {
            return mDiag(m, "E-FOREIGN-002", "unclosed foreign code block — a `_{` / `_={` opener needs its matching `}` / `}=` closer (§23.2)", start, m.pos)
        }
        return mDiag(m, "E-FOREIGN-004", "a `_{…}` foreign code block is not valid in a markup body (§23.2.4) — bind its value with `const x = _={ … }=` in a server `function` body, or use a `use foreign:` sidecar (§23.4)", start, m.pos)
    }

    fn skipSigil(mp: MP) -> MP {
        const start: int = mp.pos
        const tp: TP = regionTP(mAdv(mp, 1), LexStop.Balanced)
        const m: MP = backToMarkup(mp, tp)
        if (chAt(mp, 0) == "!") return mDiag(mAt(m, lastEnd(tp)), "E-ERROR-014", detachedHandlerMsg(), start, lastEnd(tp))
        return mDiag(mAt(m, lastEnd(tp)), "E-BOOTSTRAP-UNSUPPORTED", "a `" + chAt(mp, 0) + "{…}` context in markup is not in the bootstrap (§3.1)", start, lastEnd(tp))
    }

    // s452 — §19.4.3: "A `!{ … }` handler written as markup content — on its
    // own, after an element, attached to no call or expression — SHALL be a
    // compile error: E-ERROR-014" (the SPEC's message). A markup body and a
    // program body are both markup content; a handler that IS attached to a
    // call is logic (`${ save() !{ … } }`, an event-handler value) and never
    // reaches here.
    fn detachedHandlerMsg() -> string {
        return "'!{}' handler attached to nothing: a '!{ … }' handler handles the failure of the call written immediately before it. Attach it to a call ('save() !{ … }'), use a '<request>' and read '<#id>.error' for a load, or wrap render-time calls in an '<errorBoundary>'."
    }

    fn textNode(mp: MP, start: int, text: string) -> ANode {
        return { nid: mp.nid, span: mkSpan(start, mp.pos), k: ANodeK.Text(text) }
    }

    type RNodeOne:struct = { n: ANode, mp: MP }

    // `${ expr }` in markup.
    fn parseInterp(mp: MP) -> RNodeOne {
        const start: int = mp.pos
        const tp: TP = regionTP(mAdv(mp, 1), LexStop.Balanced)
        let t: TP = expectP(tp, "{")
        // s449: `${ when … changes { … } }` — a logic block in markup holding a
        // keyword-spelled effect, owned by the nearest enclosing element scope
        // (§6.7.4). One effect per block in the bootstrap; anything after it is
        // refused (the canonical spelling there is an `<effect>` element).
        if (whenAhead(t)) {
            const rw: REffect = parseWhen(t)
            t = rw.tp
            if (!isP(t, "}")) {
                t = diagAt(t, "E-BOOTSTRAP-UNSUPPORTED", "a `" + interpOpen() + "…}` logic block in markup holds exactly one `when` in the bootstrap — give each statement its own block, or write `<effect deps=[…]>" + interpOpen() + " … }</>`", cur(t))
                while (!atEnd(t) && !(isP(t, "}") && atEnd(adv(t)))) { t = adv(t) }
            }
            t = expectRegionEnd(expectP(t, "}"))
            const mw: MP = backToMarkup(mp, t)
            const nw: ANode = { nid: mw.nid, span: mkSpan(start, mw.pos), k: ANodeK.Effect(rw.w) }
            return { n: nw, mp: mBump(mw) }
        }
        if (markupGivenAhead(t)) return parseMarkupGiven(mp, t, start)
        // s475 — §17.6.10: a value `if` that is the sole content of the
        // interpolation may drop its head's parentheses (`value-form-if ::= 'if'
        // condition '{' expression '}'`): `${ if @isAdmin { "Admin" } else { "User" } }`.
        // With the parentheses it is an ordinary expression (an operand too, §17.6.1).
        // s475 (#1762 review item 2): a bare condition may itself START with `(` —
        // `${ if (@ok) && @n > 0 { "y" } }` — so a `(` head is the parenthesized
        // head only when a `{` follows its `)` (bareHeadAt).
        let r: RExpr = { e: { nid: t.nid, span: mkSpan(start, start), k: AExprK.Recovered }, tp: t }
        if (isWord(t, "if") && bareHeadAt(adv(t))) {
            r = parseValueIfExpr(t, true)
        } else {
            r = parseAssign(t)
        }
        t = expectP(r.tp, "}")
        t = expectRegionEnd(t)
        const m: MP = backToMarkup(mp, t)
        const n: ANode = { nid: m.nid, span: mkSpan(start, m.pos), k: ANodeK.Interp(r.e) }
        return { n: n, mp: mBump(m) }
    }

    // s478 — at the first token inside a markup `${ … }`: the §42.2.3 guard
    // `given <head> :> { … }` — `given` followed, on its line, by a name, an
    // `@`, or a `(` that does not touch it (`given(x)` is a call, a lone
    // `${ given }` a read).
    fn markupGivenAhead(tp: TP) -> boolean {
        if (!isWord(tp, "given")) return false
        const g: PTok = cur(tp)
        const n: PTok = peekAt(tp, 1)
        if (n.line != g.line) return false
        if (n.cls == TC.Ident || n.cls == TC.At) return true
        return n.cls == TC.Punct && tk(n, "(") && !touching(g, n)
    }

    // s478 — the markup-context presence guard `${ given x :> { <p>…</p> } }`
    // (§42.2.3: the guard "inside a markup `${ … }`" is in the soft-deprecated
    // window, and its head rule holds "in logic and markup-`${}` contexts
    // alike"). A head that is not an identifier-list followed by `:>`, or a
    // body that is not a `{ … }` block, is E-SYNTAX-044 (E-SYNTAX-045 for the
    // rebind `=`) — "A refused head is the site's one diagnostic". A well-formed
    // markup guard is not built in the bootstrap (it has no markup-body guard
    // node): refused by name, INTERIM — the capable form is the guard lowered
    // as its canonical `${ if (x is given) { … } }` (gap
    // g-boot-given-guard-arm-unbuilt-s478). Either way the whole `${ … }` is
    // consumed.
    fn parseMarkupGiven(mp: MP, tp: TP, start: int) -> RNodeOne {
        const gh: GHead = givenArmHead(tp, 0, false)
        let t: TP = gh.tp
        if (!gh.bad) {
            const c: PTok = cur(t)
            if (tk(c, "=>")) {
                t = adv(t)
            } else {
                t = adv(adv(t))
            }
            if (!isP(t, "{")) {
                const bt: PTok = cur(t)
                let bfound: string = "the end of the line"
                if (bt.cls != TC.End && !(isP(t, "}") && atEnd(adv(t)))) bfound = "`" + bt.text + "`"
                t = diagAt(t, "E-SYNTAX-044", "a `given` guard must be `given <names> :> { … }` — its body is a `{ … }` block (§42.2.3); found " + bfound + " after `:>`. Without the braces the body would show whether or not the names are present.", bt)
            } else {
                const msg: string = "the markup presence guard `given " + gh.written + " :> { … }` (§42.2.3, deprecated) is not in the bootstrap — write `" + interpOpen() + " if (" + gh.names[0] + " is given) { … } }` (its canonical form), or `<p if=" + gh.names[0] + ">…</p>`."
                const d: Diag = newDiag("E-BOOTSTRAP-UNSUPPORTED", msg, t.file, mkSpan(gh.start, gh.sepEnd))
                t = { toks: t.toks, i: t.i, nid: t.nid, diags: t.diags.concat([d]), file: t.file, ns: t.ns, inFn: t.inFn }
            }
        }
        // The guard's body is markup, which the logic lexer does not read (a
        // `</p>` lexes as a regex), so the `${ … }` is skipped on the source:
        // to the `}` that balances its `{`, stepping over `"…"` strings.
        const src: string = mp.src
        let k: int = start + 2
        let depth: int = 1
        while (k < src.length && depth > 0) {
            const ch: string = src.substring(k, k + 1)
            if (ch == "\"") {
                k = k + 1
                while (k < src.length && src.substring(k, k + 1) != "\"") { k = k + 1 }
            } else if (ch == "{") {
                depth = depth + 1
            } else if (ch == "}") {
                depth = depth - 1
            }
            k = k + 1
        }
        if (depth > 0) t = diagAt(t, "E-PARSE-UNCLOSED", "`" + interpOpen() + "` is never closed", cur(tp))
        const m: MP = { src: mp.src, pos: k, nid: t.nid, diags: t.diags, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
        const n: ANode = { nid: m.nid, span: mkSpan(start, m.pos), k: ANodeK.Text("") }
        return { n: n, mp: mBump(m) }
    }

    // A tag in markup position: an element, a `<*x>` reference, or a declaration.
    fn parseMarkupNode(mp: MP) -> RNodeOne {
        if (scriptStyleAt(mp) != "") return refusedNode(refuseScriptStyle(mp), mp.pos)
        const ro: ROpener = parseOpener(mp)
        if (isThemeOpener(ro.o)) {
            const m: MP = refuseTheme(ro.o, ro.mp)
            const t: ANode = { nid: m.nid, span: mkSpan(ro.o.start, m.pos), k: ANodeK.Text("") }
            return { n: t, mp: mBump(m) }
        }
        if (isEffectOpener(ro.o)) return effectNode(finishEffect(ro.o, ro.mp))
        if (isRequestBody(ro.o, ro.mp)) return requestNode(finishRequest(ro.o, ro.mp))
        const k: TagKind = tagKind(ro.o)
        return match k {
            .IsDecl :> declNode(finishDecl(ro.o, ro.mp, false))
            .IsElem :> elemNode(finishElem(ro.o, ro.mp))
            .IsProgram :> markupProgram(ro.o, ro.mp)
        }
    }

    // s478 — a `<program>` inside markup (§4.12: "A `<program>` element MAY
    // appear as a child of another `<program>` element — directly or through
    // intervening markup"; "Wrapper markup … never changes a program's role").
    // It is read as a program (programItem, its body a nested program's) and
    // HOISTED (MP.hoist) into the item list of the body the markup stands in,
    // where the program's role is decided as for a direct child: in a
    // `<program>` / `<page>` / nested body it is a nested program (analyze
    // nestedProgramDiags: §4.12.2's attribute codes, then the refusal); at the
    // file top level (a `<div>`-wrapped top-level program, which §4.12 makes
    // THE top-level program) parseMarkupItemsIn refuses it (E-PARSE-PROGRAM,
    // as before). It renders nothing where it stands.
    fn markupProgram(o: Opener, mp: MP) -> RNodeOne {
        const rp: RMItems = programItem(o, programOpenerDiags(o, mp, false), false)
        const m: MP = rp.mp
        const mh: MP = { src: m.src, pos: m.pos, nid: m.nid, diags: m.diags, file: m.file, hoist: m.hoist.concat(rp.items), dbFns: m.dbFns, hosts: m.hosts, pages: m.pages, eps: m.eps, chans: m.chans, onchs: m.onchs, schemaN: m.schemaN, tables: m.tables, ns: m.ns }
        const n: ANode = { nid: mh.nid, span: mkSpan(o.start, mh.pos), k: ANodeK.Text("") }
        return { n: n, mp: mBump(mh) }
    }

    fn isProgramItemK(k: AItemK) -> boolean {
        return match k {
            .ProgramItem(p: p) :> true
            .ConstItem(c: c) :> false
            .DeclItem(d: d) :> false
            .ImportItem(i: i) :> false
            .TypeItem(t: t) :> false
            .FnItem(f: f) :> false
            .MarkupItem(n: n) :> false
        }
    }

    // s442: `<theme>` (§66.17) — its declarations are tokens that lower to CSS
    // custom properties (`:root { --brand: … }`, a `data-scrml-theme-mode`
    // attribute per mode). The bootstrap has no CSS emission in this slice (the
    // slice-m3 CSS files are held by another session), so the element is
    // consumed whole and REPORTED — never parsed as markup (its token
    // declarations would otherwise vanish silently).
    fn isThemeOpener(o: Opener) -> boolean { return !o.star && o.name == "theme" }

    fn refuseTheme(o: Opener, mp: MP) -> MP {
        let m: MP = mp
        if (!o.selfClosing) {
            // the refused body is consumed as free text; it reports no keyword
            // and does not decide ⚑ O61 (o61Body, §66.2.5)
            const kids: RNodes = parseKids(mp, o.name)
            m = kids.mp
        }
        return mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`<theme>` (§66.17 — tokens lower to CSS custom properties) is not in the bootstrap: it has no CSS emission in this slice", o.start, m.pos)
    }

    // ---- s462: `<script>` / `<style>` are not scrml (SPEC §4.17) -------------
    // "`<script>` and `<style>` are NOT raw-content in scrml because scrml does
    // not admit those elements at all. Both are rejected symmetrically at the
    // block-splitter level: `<style>` triggers `E-STYLE-001` (CSS lives in
    // `#{...}`), and `<script>` triggers `E-SCRIPT-001` … Each rejection
    // recovers by scanning past the matching close tag (case-insensitive) or to
    // EOF … The match on the tag name is exact, not a prefix — `<noscript>` is
    // an ordinary element and is unaffected."
    // Mirrors impl#1 compiler/src/block-splitter.js (the markup-opener path):
    // the name is read with impl#1's ident set ([A-Za-z0-9_-], so `<script$x>`
    // and `<script.x>` are `script` there too), compared case-insensitively and
    // exactly; a `<*x>` reference is not an element (impl#1 reads no name after
    // `*`). It is checked at EVERY opener — element, declaration, state-child,
    // `renders` element, in every namespace (`<svg><script>` is a script) —
    // before the opener's attributes are parsed: the attributes and the body
    // are skipped whole, so neither a bound `src=@u` nor a `${@code}` body is
    // ever read.
    fn scriptStyleAt(mp: MP) -> string {
        if (chAt(mp, 0) != "<") return ""
        let k: int = 1
        while (isSplitterIdentCh(chAt(mp, k))) { k = k + 1 }
        const w: string = mp.src.substring(mp.pos + 1, mp.pos + k).toLowerCase()
        if (w == "script" || w == "style") return w
        return ""
    }

    fn isSplitterIdentCh(c: string) -> boolean {
        if (c == "") return false
        if (c >= "a" && c <= "z") return true
        if (c >= "A" && c <= "Z") return true
        if (c >= "0" && c <= "9") return true
        return c == "_" || c == "-"
    }

    // Report the element and skip past its `</script>` / `</style>` (the name
    // matched case-insensitively, `>` immediately after it — impl#1's match),
    // or to the end of the file.
    fn refuseScriptStyle(mp: MP) -> MP {
        const which: string = scriptStyleAt(mp)
        const start: int = mp.pos
        const headEnd: int = start + 1 + which.length
        const close: int = rawCloseAt(mp.src, headEnd, which)
        const end: int = close < 0 ? mp.src.length : close + which.length + 3
        if (which == "style") {
            return mDiag(mAt(mp, end), "E-STYLE-001", "<style> blocks are not supported in scrml. Use #{} for CSS (§4.17, §9.1).", start, headEnd)
        }
        return mDiag(mAt(mp, end), "E-SCRIPT-001", "<script> elements are not supported in scrml. Use " + interpOpen() + "...} for scrml logic; for genuine foreign JS, use the `_{...}` foreign-code block (§4.17, §23).", start, headEnd)
    }

    fn rawCloseAt(src: string, from: int, name: string) -> int {
        let i: int = src.indexOf("</", from)
        while (i >= 0) {
            const after: int = i + 2 + name.length
            if (src.substring(i + 2, after).toLowerCase() == name && src.substring(after, after + 1) == ">") return i
            i = src.indexOf("</", i + 1)
        }
        return -1
    }

    fn refusedNode(mp: MP, start: int) -> RNodeOne {
        const t: ANode = { nid: mp.nid, span: mkSpan(start, mp.pos), k: ANodeK.Text("") }
        return { n: t, mp: mBump(mp) }
    }

    // ---- s449: `<effect deps=[…]>${ … }</>` (SPEC §6.7.4) ---------------------
    //   effect-decl ::= '<effect' deps-attr '>' effect-body '</' 'effect'? '>'
    //                 | '<effect' deps-attr '/>'          (empty — W-LIFECYCLE-010)
    //   deps-attr   ::= 'deps=' '[' dep-item (',' dep-item)* ']'
    //   effect-body ::= '$' '{' logic-content '}'
    // A lifecycle element (the family of `<request>`): it renders nothing; its
    // trigger is `deps=`, its body ONE `${ }` logic block, its lifetime its
    // position in the tree. The entries are kept as written — analyze decides
    // what each names (a non-`@` entry is E-LIFECYCLE-007, §6.7.4); a missing
    // `deps=` or `deps=[]` is analyze's E-EFFECT-NO-DEPS.
    type REffectNode:struct = { w: AEffect, mp: MP }

    fn isEffectOpener(o: Opener) -> boolean { return !o.star && o.name == "effect" }

    fn finishEffect(o: Opener, mp: MP) -> REffectNode {
        let m: MP = mp
        let deps: AExpr[] = []
        for (const a of o.attrs) {
            if (a.name == "deps") {
                const es: AExpr[] | not = depsList(a.value)
                if (es is given) {
                    deps = es
                } else {
                    m = mDiag(m, "E-PARSE-EFFECT", "`deps=` takes a bracketed list of cells, `deps=[@a, @b]` (§6.7.4)", a.span.start, a.span.end)
                }
            } else {
                m = mDiag(m, "E-PARSE-EFFECT", "`<effect>` takes one attribute, `deps=[…]` — `" + a.name + "` is not one (§6.7.4)", a.span.start, a.span.end)
            }
        }
        const ownTy: AType | not = o.ty
        if (o.typed.length > 0 || o.vals.length > 0 || hasOwn(o.own) || ownTy is given || o.isLet) {
            m = mDiag(m, "E-PARSE-EFFECT", "`<effect>` declares nothing — it takes only `deps=[…]` (§6.7.4)", o.start, m.pos)
        }
        let body: ABlock = { nid: m.nid, span: mkSpan(m.pos, m.pos), stmts: [] }
        m = mBump(m)
        const sh: ANode[] | not = o.short
        if (sh is given) {
            m = mDiag(m, "E-PARSE-EFFECT", "an `<effect>` body is a `" + interpOpen() + " … }` logic block, not a `:`-shorthand (§6.7.4)", o.start, m.pos)
        } else if (!o.selfClosing) {
            const rb: RBodyBlock = effectBody(m)
            body = rb.b
            m = rb.mp
        }
        const w: AEffect = { nid: m.nid, span: mkSpan(o.start, m.pos), deps: deps, body: body, keyword: false }
        return { w: w, mp: mBump(m) }
    }

    // `deps=[…]`: the list's entries, or `not` when the value is not a bracketed list.
    fn depsList(v: AAttrValue) -> AExpr[] | not {
        return match v {
            .Bare(e: e) :> arrayEntries(e)
            .NoValue :> not
            .Quoted(v: s) :> not
            .Dur(text: s) :> not
            .Paren(e: e) :> not
            .Braced(b: b) :> not
        }
    }

    fn arrayEntries(e: AExpr) -> AExpr[] | not {
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: es) :> es
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .BlockLambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Template(quasis: qs) :> not
            .HashRef(id: hr0) :> not
            .Foreign(f: fb0) :> not
        }
    }

    type RBodyBlock:struct = { b: ABlock, mp: MP }

    // After `<effect …>`: whitespace, ONE `${ … }` block (statements), whitespace,
    // the closer. Any other content is E-PARSE-EFFECT (consumed to the closer,
    // never rendered — an effect renders nothing).
    fn effectBody(mp: MP) -> RBodyBlock {
        let m: MP = skipTrivia(mp)
        let body: ABlock = { nid: m.nid, span: mkSpan(m.pos, m.pos), stmts: [] }
        m = mBump(m)
        if (atInterp(m)) {
            const tp: TP = regionTP(mAdv(m, 1), LexStop.Balanced)
            const b: RBlock = parseBlock(tp)
            body = b.b
            m = skipTrivia(backToMarkup(m, expectRegionEnd(b.tp)))
        }
        if (!mLooking(m, "</")) {
            const from: int = m.pos
            const rest: RNodes = parseKids(m, "effect")
            return { b: body, mp: mDiag(rest.mp, "E-PARSE-EFFECT", "an `<effect>` body is exactly one `" + interpOpen() + " … }` logic block (§6.7.4) — it renders nothing, so markup or text in it is an error", from, rest.mp.pos) }
        }
        return { b: body, mp: parseCloser(m, "effect") }
    }

    // ---- s475 (slice S3a): `<request id="…" deps=[…]>${ lin* @x = e }</>` (SPEC §6.7.7) ----
    //   request-decl ::= '<request' id-attr (deps-attr)? (cache-attr)? '>' request-body '</' 'request'? '>'
    //   request-body ::= '$' '{' lin-declaration* assignment-expression '}'
    // A `<request>` whose body is a `${ … }` logic block. Every other shape —
    // self-closing (E-LIFECYCLE-019, or the §60 `url=` / `api=` form), a markup
    // body, an opener that declares (a user declaration named `request`) —
    // stays an element and analyze judges it. The attributes are kept as
    // written (analyze reads `id=`, `deps=`, `cache`); the body is parsed as
    // statements (analyze classifies them).
    type RRequestNode:struct = { r: ARequest, mp: MP }

    fn isRequestBody(o: Opener, mp: MP) -> boolean {
        if (o.star || o.name != "request" || o.selfClosing) return false
        if (tagKind(o) != TagKind.IsElem) return false
        const sh: ANode[] | not = o.short
        if (sh is given) return false
        return atInterp(skipTrivia(mp))
    }

    fn finishRequest(o: Opener, mp: MP) -> RRequestNode {
        let m: MP = mp
        const opener: ASpan = mkSpan(o.start, m.pos)
        const rb: RBodyBlock = requestBody(mBump(m))
        m = rb.mp
        const r: ARequest = { nid: m.nid, span: mkSpan(o.start, m.pos), attrs: o.attrs, body: rb.b, opener: opener, pend: -1 }
        return { r: r, mp: mBump(m) }
    }

    // After `<request …>`: ONE `${ … }` block (statements), then the closer. Any
    // other content is E-PARSE-ITEM (consumed to the closer, never rendered —
    // a request renders nothing; §6.7.7 "and by nothing else").
    fn requestBody(mp: MP) -> RBodyBlock {
        let m: MP = skipTrivia(mp)
        const tp: TP = regionTP(mAdv(m, 1), LexStop.Balanced)
        const b: RBlock = parseBlock(tp)
        m = skipTrivia(backToMarkup(m, expectRegionEnd(b.tp)))
        if (!mLooking(m, "</")) {
            const from: int = m.pos
            const rest: RNodes = parseKids(m, "request")
            return { b: b.b, mp: mDiag(rest.mp, "E-PARSE-ITEM", "a `<request>` body is exactly one `" + interpOpen() + " … }` logic block (§6.7.7) — it renders nothing, so markup or text after it is an error", from, rest.mp.pos) }
        }
        return { b: b.b, mp: parseCloser(m, "request") }
    }

    fn requestNode(r: RRequestNode) -> RNodeOne {
        const n: ANode = { nid: r.mp.nid, span: r.r.span, k: ANodeK.Request(r.r) }
        return { n: n, mp: mBump(r.mp) }
    }

    fn effectNode(r: REffectNode) -> RNodeOne {
        const n: ANode = { nid: r.mp.nid, span: r.w.span, k: ANodeK.Effect(r.w) }
        return { n: n, mp: mBump(r.mp) }
    }

    fn declNode(r: RDecl) -> RNodeOne {
        const n: ANode = { nid: r.mp.nid, span: r.d.span, k: ANodeK.DeclNode(r.d) }
        return { n: n, mp: mBump(r.mp) }
    }

    fn elemNode(r: RElem) -> RNodeOne {
        const n: ANode = { nid: r.mp.nid, span: r.e.span, k: ANodeK.Elem(r.e) }
        return { n: n, mp: mBump(r.mp) }
    }

    // ---- declarations -------------------------------------------------------
    // After the opener: the body (child fields + state-children), the closer,
    // then an optional `renders <element>`.
    fn finishDecl(o: Opener, mp: MP, exported: boolean) -> RDecl {
        return finishDeclIn(o, mp, exported, false)
    }

    // s478 — the zone of a declaration's own refinement (§53.4). A fixed
    // (no `let`), self-closing, attribute-free TOP-LEVEL cell whose own value is a
    // literal is the static zone (§53.4.2 rules 1-2): judged now, E-CONTRACT-001 on
    // a literal that fails. Every other refined declaration is reached by values the
    // bootstrap does not check (a later write to a `let` cell; a field a use site
    // seeds, §66.9 rule 8; a non-literal value) — the boundary zone, refused by name
    // (INTERIM). A refinement inside the type (`number(>0)[]`, `number(>0) | not`)
    // is refused the same way.
    type RDeclRefine:struct = { ty: AType | not, mp: MP }

    fn declRefine(mp: MP, o: Opener, child: boolean, mods: AAttr[]) -> RDeclRefine {
        const ty: AType | not = o.ty
        if (ty is not) return { ty: ty, mp: mp }
        const shown: string = typeNameText(ty)
        if (!standingRefine(ty)) {
            const sp: ASpan | not = refineInside(ty)
            if (sp is not) return { ty: ty, mp: mp }
            return { ty: ty, mp: mDiag(mp, "E-BOOTSTRAP-UNSUPPORTED", refBoundaryMsg(shown, "inside the type of `<" + o.name + ">`"), sp.start, sp.end) }
        }
        let why: string = ""
        if (child) {
            why = "on the field `" + o.name + "` of a declaration — a use site's value seeds it (§66.9 rule 8) unproven"
        } else if (o.isLet) {
            why = "on the `let` cell `@" + o.name + "` — each later write to it is a boundary-zone write"
        } else if (!o.selfClosing || mods.length > 0 || o.typed.length > 0) {
            why = "on `<" + o.name + ">`, a declaration with a body or attributes"
        }
        let z: RefZone = { code: "", msg: "", reported: false }
        if (why != "") {
            z = { code: "E-BOOTSTRAP-UNSUPPORTED", msg: refBoundaryMsg(shown, why), reported: false }
        } else {
            z = refineFixedZone(ty, ownLit(o.own), "`@" + o.name + "`")
        }
        if (z.code == "") return { ty: ty, mp: mp }
        const m: MP = mDiag(mp, z.code, z.msg, ty.span.start, ty.span.end)
        if (z.reported) return { ty: reportedRefine(ty), mp: m }
        return { ty: ty, mp: m }
    }

    // An own value as a literal (§53.4.2), or not.
    fn ownLit(v: AAttrValue) -> RefLit | not {
        return match v {
            .Bare(e: e) :> refLitOf(e)
            .Paren(e: e) :> refLitOf(e)
            .Quoted(v: s) :> { isStr: true, n: 0, s: s, raw: "\"" + s + "\"" }
            .NoValue :> not
            .Dur(text: s) :> not
            .Braced(b: b) :> not
        }
    }

    fn finishDeclIn(o: Opener, mp: MP, exported: boolean, child: boolean) -> RDecl {
        let m: MP = mp
        if (isNamespace(o.name)) {
            m = mDiag(m, "E-DECL-ILLEGAL-FIELD-NAME", "`" + o.name + "` cannot name a declaration or field — it is reserved for namespaced attributes (`" + o.name + ":…`, §66.2.3)", o.start, m.pos)
        }
        for (const ta of o.typed) {
            if (isNamespace(ta.name)) {
                m = mDiag(m, "E-DECL-ILLEGAL-FIELD-NAME", "`" + ta.name + "` cannot name an attribute of a declaration (§66.2.3)", ta.span.start, ta.span.end)
            }
            m = checkOpenerValue(m, ta.dflt)
        }
        m = checkOpenerValue(m, o.own)
        // s444 Phase B: a BARE validator word (`req`) is a validator, not a modifier
        let mods: AAttr[] = []
        let bare: AValidator[] = []
        for (const a of o.attrs) {
            if (isValidatorWord(a.name) && isNoValue(a.value)) {
                bare = bare.concat([{ nid: a.nid, span: a.span, name: a.name, arg: AValArg.NoArgs }])
            } else {
                mods = mods.concat([a])
            }
            if (a.name.indexOf(":") >= 0) {
                m = mDiag(m, "E-DECL-ILLEGAL-FIELD-NAME", "a declaration opener cannot carry `" + a.name + "` — `bind:` / `class:` / `style:` / `internal:` / `on…` are markup attributes; a declaration's markup is its `renders` (§66.2.3, §66.4)", a.span.start, a.span.end)
            }
        }
        const rz: RDeclRefine = declRefine(m, o, child, mods)
        m = rz.mp
        const dty: AType | not = rz.ty
        let body: ADeclChild[] = []
        if (o.short is given) {
            m = mDiag(m, "E-PARSE-SHORTHAND", "a declaration has no `:`-shorthand body — its markup is its `renders` (§66.5); a `:`-shorthand body belongs to an element or a state-child (§4.14)", o.start, m.pos)
        } else if (!o.selfClosing) {
            const rb: RChildren = parseDeclBody(m, o.name)
            body = rb.cs
            m = rb.mp
        }
        const declEnd: int = m.pos
        // `renders` follows the closer (§66.5.1).
        let renders: AElem | not = not
        const after: MP = skipTrivia(m)
        const rw: RWord = readName(after)
        if (rw.w == "renders") {
            const at: MP = skipTrivia(rw.mp)
            if (scriptStyleAt(at) != "") {
                // s462: a `<script>` / `<style>` is no element (§4.17) — refused whole
                m = refuseScriptStyle(at)
            } else if (chAt(at, 0) == "<" && !mLooking(at, "</")) {
                const ro: ROpener = parseOpener(at)
                const re: RElem = finishElem(ro.o, ro.mp)
                renders = re.e
                m = re.mp
            } else {
                m = mDiag(at, "E-PARSE-RENDERS", "`renders` must be followed by one markup element (§66.5.1)", rw.mp.pos - 7, rw.mp.pos)
            }
        }
        const d: ADecl = {
            nid: m.nid, span: mkSpan(o.start, declEnd), exported: exported, isLet: o.isLet,
            name: o.name, ty: dty, own: o.own, attrs: o.typed, mods: mods, body: body, renders: renders,
            validators: bySource(bare.concat(o.vals)),
        }
        return { d: d, mp: mBump(m) }
    }

    // §66.2.4: an own value / attribute default is a literal or a plain `@ref`
    // written bare — anything else must be parenthesized.
    fn checkOpenerValue(mp: MP, v: AAttrValue) -> MP {
        return match v {
            .Bare(e: e) :> checkBareOpenerExpr(mp, e)
            .NoValue :> mp
            .Quoted(v: s) :> mp
            .Dur(text: s) :> mp
            .Paren(e: e) :> mp
            .Braced(b: b) :> mDiag(mp, "E-DECL-OPENER-EXPR-UNPARENTHESIZED", "a declaration's value cannot be a braced block — write an expression, parenthesized (§66.2.4)", b.span.start, b.span.end)
        }
    }

    fn checkBareOpenerExpr(mp: MP, e: AExpr) -> MP {
        if (isBareOpenerExpr(e)) return mp
        return mDiag(mp, "E-DECL-OPENER-EXPR-UNPARENTHESIZED", "an opener value that is not a literal or a plain `@ref` must be parenthesized (§66.2.4)", e.span.start, e.span.end)
    }

    fn isBareOpenerExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> true
            .Str(v: s) :> true
            .Bool(v: b) :> true
            .NotLit :> true
            .Recovered :> true
            .Variant(name: n) :> true
            .At(name: n) :> true
            .ArrayLit(elems: es) :> es.length == 0
            .Unary(op: o, e: inner) :> isNegNum(o, inner)
            .Name(name: n) :> false
            .AtItem :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .BlockLambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> false
        }
    }

    fn isNegNum(o: UnOp, inner: AExpr) -> boolean {
        const k: AExprK = inner.k
        const isNeg: boolean = o == UnOp.Neg
        return match k {
            .Num(raw: r) :> isNeg
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: x) :> false
            .Call(callee: x) :> false
            .Unary(op: x) :> false
            .Binary(op: x) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: x) :> false
            .ObjectLit(props: x) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .BlockLambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Template(quasis: qs) :> false
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> false
        }
    }

    type RChildren:struct = { cs: ADeclChild[], mp: MP }

    // A declaration body: child declarations and state-children (O52), up to
    // the closer (consumed). A body holds no uses and no text.
    fn parseDeclBody(mp: MP, tag: string) -> RChildren {
        let m: MP = mp
        let out: ADeclChild[] = []
        let going = true
        while (going) {
            m = skipTrivia(m)
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-UNCLOSED", "`<" + tag + ">` is never closed", mp.pos, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                m = parseCloser(m, tag)
                going = false
            } else {
                // a declaration body is an item position (§66.2.5): `export` /
                // `let` before a child's `<`, in that order
                let exported = false
                let isLet = false
                const w: RWord = readName(m)
                if (w.w == "export") {
                    exported = true
                    m = skipTrivia(w.mp)
                }
                const wl: RWord = readName(m)
                if (wl.w == "let") {
                    isLet = true
                    m = skipTrivia(wl.mp)
                }
                if (scriptStyleAt(m) != "") {
                    // s462: §4.17 — no child of a declaration either
                    m = refuseScriptStyle(m)
                } else if (chAt(m, 0) == "<") {
                    const rc: RChild = parseDeclChild(m, exported, isLet)
                    out = out.concat([rc.c])
                    m = rc.mp
                } else {
                    const bad: int = m.pos
                    m = mDiag(m, "E-PARSE-DECL-BODY", "a declaration body holds child declarations and state-children only (§66.4 rule 4, O52)", bad, bad + 1)
                    m = skipLineComment(mAdv(m, 1))
                }
            }
        }
        return { cs: out, mp: m }
    }

    fn parseDeclChild(mp: MP, exported: boolean, isLet: boolean) -> RChild {
        const ro: ROpener = parseOpener(mp)
        const o: Opener = ro.o
        if (isDeclOpener(o)) {
            const od: Opener = isLet ? withLet(o) : o
            const rd: RDecl = finishDeclIn(od, ro.mp, exported, true)
            return { c: ADeclChild.ChildField(rd.d), mp: rd.mp }
        }
        let m: MP = keywordOnUse(ro.mp, o, exported, isLet)
        // O5 RULED (1i): a state-child's body is that variant's markup — a
        // `:`-shorthand expression (§4.14) or a bare body up to its closer.
        let body: ANode[] = []
        const sh: ANode[] | not = o.short
        if (sh is given) {
            body = sh
        } else if (!o.selfClosing) {
            // r1 F4: a state-child body is CODE-DEFAULT (§4.18.1)
            const kids: RNodes = parseCodeBody(m, o.name)
            body = kids.nodes
            m = kids.mp
        }
        const sc: AStateChild = { nid: m.nid, span: mkSpan(o.start, m.pos), name: o.name, attrs: o.attrs, body: body }
        // s478 — `<onIdle …/>` (§51.0.R) is the value's watchdog, not a state-child
        if (o.name == "onIdle") return { c: ADeclChild.Idle(sc), mp: mBump(m) }
        return { c: ADeclChild.StateChild(sc), mp: mBump(m) }
    }

    // ---- items: a file or `<program>` body ----------------------------------
    // Items until EOF or a closer (consumed when `tag` != "").
    fn parseMarkupItems(mp: MP, tag: string) -> RMItems {
        return parseMarkupItemsIn(mp, tag, tag)
    }

    // s476 — `ctx`: whose body this is. "" the file top level, "program" the
    // top-level `<program>`'s body, "nested" a nested `<program>`'s body
    // (§4.12.2), "page" a `<page>` body (§40.8). Only a direct child of a
    // body decides anything by it (parseTagItem: where a `<page>` / a
    // `<channel>` may stand).
    fn parseMarkupItemsIn(mp: MP, tag: string, ctx: string) -> RMItems {
        let m: MP = mp
        let out: AItem[] = []
        let going = true
        while (going) {
            m = skipTrivia(m)
            if (mEof(m)) {
                if (tag != "") m = mDiag(m, "E-PARSE-UNCLOSED", "`<" + tag + ">` is never closed", mp.pos, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                if (tag == "") {
                    m = mDiag(m, "E-PARSE-CLOSER", "a closer with nothing open", m.pos, m.pos + 2)
                    m = mAdv(m, 2)
                } else {
                    m = parseCloser(m, tag)
                    going = false
                }
            } else {
                const before: int = m.pos
                const r: RMItems = parseMarkupItem(m, ctx)
                // s472: the `<db>`-body items read inside this item (MP.hoist)
                // join this item list, right after it
                out = out.concat(r.items)
                m = noHoist(r.mp)
                for (const h of r.mp.hoist) {
                    // s478: a markup-wrapped `<program>` (markupProgram) at the file top
                    // level is the file's top-level program (§4.12), which the bootstrap
                    // reads only unwrapped — refused, as before
                    if (ctx == "" && isProgramItemK(h.k)) {
                        m = mDiag(m, "E-PARSE-PROGRAM", "`<program>` inside markup", h.span.start, h.span.end)
                    } else {
                        out = out.concat([h])
                    }
                }
                if (m.pos == before) m = mAdv(m, 1)
            }
        }
        return { items: out, mp: m }
    }

    fn noHoist(mp: MP) -> MP {
        return { src: mp.src, pos: mp.pos, nid: mp.nid, diags: mp.diags, file: mp.file, hoist: [], dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    fn mItem(mp: MP, start: int, k: AItemK) -> RMItems {
        const it: AItem = { nid: mp.nid, span: mkSpan(start, mp.pos), k: k }
        return { items: [it], mp: mBump(mp) }
    }

    // `ctx` (parseMarkupItemsIn): "" = this item stands at file top level (not
    // in a `<program>` body).
    fn parseMarkupItem(mp: MP, ctx: string) -> RMItems {
        const fileTop: boolean = ctx == ""
        const start: int = mp.pos
        if (atCss(mp)) {
            const rc: RCss = parseCssNode(mp)
            return mItem(rc.mp, start, AItemK.MarkupItem(rc.n))
        }
        // s452: a `!{ … }` standing in a program body (E-ERROR-014, skipSigil)
        if (chAt(mp, 0) == "!" && chAt(mp, 1) == "{") return { items: [], mp: skipSigil(mp) }
        if (atInterp(mp)) {
            // s478 — markup in the block is read as markup (logicBlockTP)
            const lr: RLogicRegion = logicBlockTP(mp, true)
            const inner: RItems = parseLogicItems(expectP(lr.tp, "{"), "}", false)
            const t2: TP = expectRegionEnd(expectP(inner.tp, "}"))
            return { items: inner.items, mp: backToMarkup(lr.mp, t2) }
        }
        if (chAt(mp, 0) == "<") return parseTagItem(mp, false, false, ctx)
        const w: RWord = readName(mp)
        // a program body is an item position (§66.2.5): `export` / `let` before
        // a tag's `<`, in JS order. `let` followed by a name stays the logic
        // binding (no statements at program level in the slice).
        if (w.w == "let") {
            const afterLet: MP = skipTrivia(w.mp)
            if (chAt(afterLet, 0) == "<") return parseTagItem(afterLet, false, true, ctx)
        }
        if (w.w == "export") {
            const after: MP = skipTrivia(w.mp)
            if (chAt(after, 0) == "<") return parseTagItem(after, true, false, ctx)
            const wl: RWord = readName(after)
            if (wl.w == "let") {
                const after2: MP = skipTrivia(wl.mp)
                if (chAt(after2, 0) == "<") return parseTagItem(after2, true, true, ctx)
            }
            // s478: an export list (`export { … } [from "…"];`, `export * from "…";`, §21.4) is a
            // statement like an `import`: its region ends at the line, not after its `}`
            if (chAt(after, 0) == "{" || chAt(after, 0) == "*") return logicRegionItem(mp, LexStop.Line, fileTop)
            // s478: `export const NAME = …;` ends at its `;` (LexStop.Decl), not at a later `}`
            if (!fileTop && (wl.w == "const" || wl.w == "let" || wl.w == "type")) return logicRegionItem(mp, LexStop.Decl, false)
            return logicRegionItem(mp, LexStop.Statement, false)
        }
        // s479 — a `type` declaration at a body top is ONE declaration (LexStop.Decl):
        // a braceless alias `type N = number;` has no `}` for LexStop.Statement to
        // stop after, so its region ran on past its `;` (g-boot-body-top-type-alias-region-s478)
        if (!fileTop && w.w == "type") return logicRegionItem(mp, LexStop.Decl, false)
        if (w.w == "function" || w.w == "fn" || w.w == "type") return logicRegionItem(mp, LexStop.Statement, false)
        // s451 (U1a): `server function …` (the deprecated modifier, §52.10)
        if (w.w == "server") return logicRegionItem(mp, LexStop.Statement, false)
        // s449: the keyword `when … changes { … }` at the program body top (§40.8: code)
        if (w.w == "when" && ctx == "nested" && readName(skipTrivia(w.mp)).w == "message") return nestedWhenMessage(mp)
        if (w.w == "when") return logicRegionItem(mp, LexStop.Statement, false)
        if (w.w == "import") return logicRegionItem(mp, LexStop.Line, fileTop)
        // s478 — a `const NAME = …;` / `let NAME …` at a body top is the same item
        // as at the top level of a `${ … }` there (§40.8: the auto-lift covers
        // "`let`/`const` local declarations"): a file-scope constant (§7.6,
        // parseConstItem) / a file-scope `let` (s479, parseLetItem)
        if (!fileTop && (w.w == "const" || w.w == "let")) return logicRegionItem(mp, LexStop.Decl, false)
        // s478 r1 (MED-1) — a keywordless declaration analysis proved (PNs.kw) is that same item
        // (§50.8.5: it "declares `x` exactly as `const x = 1` does"; parseKwConstItem)
        if (!fileTop && w.w != "" && mp.ns.kw.indexOf(start) >= 0) return logicRegionItem(mp, LexStop.Decl, false)
        // s478 — any other bare run at a `<program>` / `<page>` body top is code (§40.8 S441)
        if (!fileTop) return bodyTopRun(mp, ctx)
        const d: MP = mDiag(mp, "E-PARSE-ITEM", "unexpected text at program level", start, start + 1)
        return { items: [], mp: skipLineComment(d) }
    }

    // =========================================================================
    // s478-boot-semicolon-residue — `when message(data) { … }` in a NESTED
    // `<program>` body. SPEC §4.12.4: "`when message(data) { ... }` is a
    // lifecycle hook valid inside worker `<program>` elements"; and it is kept
    // ("Not retired: the worker / nested-program event hooks `when message(data)
    // { }`" — §6.7.4 "The retiring keyword form"). Before this it fell to the
    // logic-item reader as E-PARSE-ITEM ("other statements at logic-block level are not in the bootstrap") — a
    // parse rejection of valid code.
    // The bootstrap builds no nested program: analyze (nestedProgramDiags)
    // reports an error on EVERY nested `<program>` — its §4.12.2 attribute
    // errors, or else E-BOOTSTRAP-UNSUPPORTED — so the hook is read here (its
    // binding and its `{ … }` body, whose own syntax errors report) and keeps
    // no item: nothing of a nested program is ever lowered. Fail-closed by
    // that analyze rule, not by this reader. Only `ctx == "nested"` reads it;
    // at a top-level `<program>` body it stays the logic-item reader's (no
    // SPEC meaning there).
    // =========================================================================
    fn nestedWhenMessage(mp: MP) -> RMItems {
        let t: TP = adv(adv(regionTP(mp, LexStop.Statement)))   // `when` `message`
        t = expectP(t, "(")
        if (cur(t).cls == TC.Ident) {
            t = adv(t)
            // an annotated binding `data: Job` (a parameter's spelling; §4.12.4 shows only the
            // bare name, and the hook is never built, so the annotation is read, not judged)
            if (isP(t, ":")) t = parseType(adv(t)).tp
        } else {
            t = diagAt(t, "E-PARSE-EXPECTED", "expected the message binding name in `when message(data) { … }` (§4.12.4)", cur(t))
        }
        t = expectP(t, ")")
        const rb: RBlock = parseBlock(t)
        return { items: [], mp: backToMarkup(mp, expectRegionEnd(rb.tp)) }
    }

    // =========================================================================
    // s478 (S478 triage C3) — a BARE RUN at a `<program>` / `<page>` body top.
    // SPEC §40.8 S441: "A bare run — a run of non-whitespace source characters
    // written directly among the body's children, not inside a markup element and
    // not a `"..."` display-text literal — is **code**. It SHALL be parsed and
    // checked as logic at its position, exactly as the content of the declaration
    // auto-lift above is, and it SHALL NOT ship as page text." Display text is
    // declared: a markup element, or "(b) a `"..."` display-text literal …, which
    // renders as a text node at its position". "A bare run that is not valid code
    // is `E-UNQUOTED-DISPLAY-TEXT` (§4.18.7)." §4.18.7: "One diagnostic covers each
    // maximal run of consecutive statements that are not valid code, and the
    // statements it covers raise no other diagnostic"; the diagnostic "SHALL also
    // name the markup-element form (`<p>…</p>`) as a fix, alongside the `"..."`
    // literal".
    //
    // The run is the code-default region up to the next tag or `${` (LexStop.
    // CodeBody), lexed as logic. It is read statement by statement, stopping
    // before an item (bodyTopItemAhead — the item reader takes it):
    //  - a standalone `"…"` (bodyTopDisplayAt) is a display-text literal → its
    //    Text / Interp nodes (§4.18.3 / §4.18.4);
    //  - a statement the reader parses with no E-PARSE-* error is code: kept, in
    //    a Run with the statements around it (its own diagnostics — a missing `;`
    //    (§7.2.2 rule 1), E-STMT-NO-EFFECT, a named refusal — stand);
    //  - a statement that does not parse (an E-PARSE-* error, or a token the
    //    lexer could not read), or one built only from literals and operators
    //    (§40.8: "`404`, `-1`, `true`, `[1, 2]`, `"a" + 1` … it is
    //    `E-UNQUOTED-DISPLAY-TEXT`"), is not valid code: it and the statements
    //    before it ON ITS LINE that lacked their `;` (`Welcome to the dashboard.`
    //    reads `Welcome`, `to`, `the`, then fails) are dropped with their
    //    diagnostics, and the run of display text runs to the end of that line.
    //    Consecutive such lines are ONE E-UNQUOTED-DISPLAY-TEXT.
    // INTERIM (⚑ dpa-073 R7, OPEN): two readings here are by line — the
    // display-literal test (§40.8: "it opens a line (or directly follows a markup
    // element) … and nothing but whitespace, `;` or a `//` comment follows its
    // closing `"` on that line"; §7.2.2 "Remaining newline-sensitive readings":
    // INTERIM), and where a run of display text ends (the end of the failing
    // statement's line — §40.8 round 5: "The tokens after the end, on the
    // statement's own line, are E-UNQUOTED-DISPLAY-TEXT; tokens it consumed from
    // later lines are parsed as the statements that follow it").
    // =========================================================================
    fn bodyTopRun(mp: MP, ctx: string) -> RMItems {
        const run: LexRun = lexFromMode(mp.src, mp.pos, LexStop.CodeBody, false)
        let t: TP = { toks: nsToks(mp.ns, toPToks(run.tokens)), i: 0, nid: mp.nid, diags: mp.diags, file: mp.file, ns: mp.ns, inFn: 0 }
        let items: AItem[] = []
        let stmts: AStmt[] = []
        let runStart: int = -1
        // the chain: the statements on one line since the last one that ended with its `;`
        let chain: TP = t
        let chainLen: int = 0
        let chainLine: int = -1
        // the pending run of display text, [badStart, badEnd)
        let badStart: int = -1
        let badEnd: int = -1
        let resume: int = -1
        let going = true
        while (going) {
            const tok: PTok = cur(t)
            if (atEnd(t) || bodyTopItemAhead(t)) {
                going = false
            } else if (isP(t, ";")) {
                // §7.2.2 rule 6: "`;` is never text": the terminator (an empty statement)
                if (chainLine >= 0 && stmts.length > chainLen) {
                    t = proseDiag(t, mp.src, ctx, badStart, badEnd)
                    badStart = -1
                }
                t = adv(t)
                chainLine = -1
            } else if (bodyTopDisplayAt(mp.src, t)) {
                const fr: RItems = runItem(t, runStart, stmts)
                const fb: TP = proseDiag(fr.tp, mp.src, ctx, badStart, badEnd)
                items = items.concat(fr.items)
                stmts = []
                runStart = -1
                badStart = -1
                const rd: RItems = bodyTopDisplay(mp, fb)
                items = items.concat(rd.items)
                t = rd.tp
                chainLine = -1
            } else {
                if (chainLine != tok.line) {
                    // the open chain on the line before is settled (its statements stand):
                    // the display run before it is final
                    if (chainLine >= 0 && stmts.length > chainLen) {
                        t = proseDiag(t, mp.src, ctx, badStart, badEnd)
                        badStart = -1
                    }
                    chain = t
                    chainLen = stmts.length
                    chainLine = tok.line
                }
                const before: TP = t
                const r: RStmt = parseTermStmt(t, hardErrors(t.diags))
                if (notCode(before, r) && closedLiteralStmt(before, r)) {
                    // s478 r1 (LOW-2) — a literal-only statement that ended with its own `;`
                    // (`"a"; @n = 5;` — §40.8: the `"a"` is a code string, since more than `;`
                    // follows it on its line) is display text up to that `;`; what follows it
                    // on the line is read as the statements it is
                    const from2: int = cur(chain).start
                    stmts = stmts.slice(0, chainLen)
                    if (stmts.length == 0) runStart = -1
                    if (badStart < 0) badStart = from2
                    badEnd = r.tp.toks[r.tp.i - 1].end
                    t = { toks: r.tp.toks, i: r.tp.i, nid: r.tp.nid, diags: chain.diags, file: r.tp.file, ns: r.tp.ns, inFn: r.tp.inFn }
                    chainLine = -1
                } else if (notCode(before, r)) {
                    // not valid code: drop the chain and read its line as display text
                    const from: int = cur(chain).start
                    stmts = stmts.slice(0, chainLen)
                    if (stmts.length == 0) runStart = -1
                    t = chain
                    let last: int = from
                    while (!atEnd(t) && cur(t).line <= tok.line) {
                        last = cur(t).end
                        t = adv(t)
                    }
                    const nl: int = mp.src.indexOf("\n", from)
                    if (nl > from && nl < last) {
                        // s478 r1 (LOW-1) — a token of this line runs past its end (the `'` of
                        // `Don't panic.` opens a string the lexer reads to the end of the run):
                        // the display text ends at the line (§4.18.7: "the statements it covers
                        // raise no other diagnostic"), and the body is read again from the next line
                        last = nl
                        resume = nl
                        going = false
                    }
                    if (badStart < 0) badStart = from
                    badEnd = last
                    chainLine = -1
                } else {
                    t = bodyTopNoEffect(r.tp, before.diags.length, ctx)
                    if (runStart < 0) runStart = tok.start
                    stmts = stmts.concat([r.s])
                    // a statement that ended with its `;` (or is block-like) closes the
                    // chain: it can no longer be read back as display text
                    if ((t.i > 0 && tk(t.toks[t.i - 1], ";")) || !needsSemi(r.s)) {
                        t = proseDiag(t, mp.src, ctx, badStart, badEnd)
                        badStart = -1
                        chainLine = -1
                    }
                    if (t.i == before.i) t = adv(t)
                }
            }
        }
        const fr2: RItems = runItem(t, runStart, stmts)
        const fb2: TP = proseDiag(fr2.tp, mp.src, ctx, badStart, badEnd)
        const back: MP = backToMarkup(mp, fb2)
        if (resume >= 0) return { items: items.concat(fr2.items), mp: mAt(back, resume) }
        return { items: items.concat(fr2.items), mp: mAt(back, cur(fb2).start) }
    }

    // s478 r1 (owner ruling 4) — §4.18.7 (S445): "a lone identifier or cell read
    // standing as a statement has no effect, so at a `<program>` / `<page>` /
    // `<channel>` body top it is `E-STMT-NO-EFFECT` (§40.8), whose message names
    // the declared forms". A body-top E-STMT-NO-EFFECT names them, and is kept
    // beside a later scope refusal (withoutRefusedNoEffect keeps one carrying
    // bodyTopForms()): `Counter;` is E-STMT-NO-EFFECT + E-SCOPE-001 there only.
    fn bodyTopForms() -> string {
        return " At a body top, displayed text is declared: a markup element (`<p>…</p>`) or a quoted display-text literal (`\"…\"`) (§4.18.7, §40.8)."
    }

    fn bodyTopNoEffect(tp: TP, from: int, ctx: string) -> TP {
        let ds: Diag[] = tp.diags.slice(0, from)
        let i: int = from
        while (i < tp.diags.length) {
            const d: Diag = tp.diags[i]
            if (d.code == "E-STMT-NO-EFFECT" && d.message.indexOf(bodyTopForms()) < 0) {
                ds = ds.concat([newDiag(d.code, d.message + bodyTopForms(), d.file, d.span)])
            } else {
                ds = ds.concat([d])
            }
            i = i + 1
        }
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: ds, file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // s478 r1 — the statement just read is literal-only (§40.8), parsed with no
    // E-PARSE-* error, and ended with its own `;`.
    fn closedLiteralStmt(before: TP, r: RStmt) -> boolean {
        if (r.tp.i <= before.i) return false
        if (!tk(r.tp.toks[r.tp.i - 1], ";")) return false
        let i: int = before.diags.length
        while (i < r.tp.diags.length) {
            if (r.tp.diags[i].code.startsWith("E-PARSE-")) return false
            i = i + 1
        }
        const x: AExpr | not = stmtExpr(r.s)
        if (x is given) return literalOnly(x)
        return false
    }

    // An item starts at the token (the program-body item reader takes it,
    // parseMarkupItem): a declaration keyword. A tag or `${` already ended the region.
    fn bodyTopItemAhead(tp: TP) -> boolean {
        return logicItemAhead(tp)
    }

    // Is the statement just read (from `before` to `r`) not valid code at a body top?
    // A statement a recognizer NAMED (an E- code other than a generic E-PARSE-* /
    // a terminator one — `throw` E-THROW-NOT-IN-SCRML, a by-name
    // E-BOOTSTRAP-UNSUPPORTED) is code, written wrong or not built: it keeps its
    // diagnostics, never read as display text.
    // s479 r1 (MED-1) — a statement that OPENS with a prefix `not` (notPrimary's
    // E-TYPE-045 at its first token: `not a clue`, the `not need a validator.` of
    // `It does not need a validator.`) is read as `not` + its operand only to name
    // the §42.10 refusal; as a statement it is the absence value followed by more
    // words — before notPrimary, the literal `not` (literalOnly) that made the line
    // display text. So that E-TYPE-045 does not make it code: §4.18.7 "One diagnostic
    // covers each maximal run of consecutive statements that are not valid code, and
    // the statements it covers raise no other diagnostic". A `not` inside code that
    // is otherwise valid (`@a = not @b;`, `if (not (x))`) keeps its E-TYPE-045.
    // s479 r2 (MED-A) — and so does a `not` statement that is code (notStmtIsCode:
    // `not @x;`, `not (@x)` at its line's end): only a prose-shaped one is display text.
    fn notCode(before: TP, r: RStmt) -> boolean {
        if (r.tp.i == before.i) return true
        let generic = false
        let i: int = before.diags.length
        const lead: PTok = before.toks[before.i]
        while (i < r.tp.diags.length) {
            const d: Diag = r.tp.diags[i]
            if (d.severity == Severity.Error) {
                if (d.code.startsWith("E-PARSE-")) {
                    generic = true
                } else if (d.code == "E-TYPE-045" && d.span.start == lead.start && lead.text == "not" && !notStmtIsCode(before, r)) {
                    generic = true
                } else if (!softError(d.code)) {
                    return false
                }
            }
            i = i + 1
        }
        if (generic) return true
        // a token the lexer could not read (`©`, `★`)
        let k: int = before.i
        while (k < r.tp.i) {
            if (before.toks[k].cls == TC.Other && before.toks[k].text.substring(0, 1) != "/") return true
            k = k + 1
        }
        const x: AExpr | not = stmtExpr(r.s)
        if (x is given) return literalOnly(x)
        return false
    }

    // s479 r2 (MED-A) — is a body-top statement that opens with a prefix `not` (its only
    // error notPrimary's E-TYPE-045) CODE, so its E-TYPE-045 stands? §42.10: "`not` SHALL
    // NOT appear in prefix position before a boolean expression … The compiler SHALL emit
    // E-TYPE-045 in all such positions" — and the more specific code wins (D29) over
    // §4.18.7's E-UNQUOTED-DISPLAY-TEXT, which covers "statements that are not valid code".
    // The rule (structural — the statement's own tokens, never a word list):
    //  - it ended with its own `;` → code (`not @x;`, `not (@x);`, `not done;`, `not 5;`):
    //    §7.2.2 rule 6 "`;` is never text" — the `;` closed it as a statement, as a lone
    //    `done;` at a body top is code (E-STMT-NO-EFFECT, §4.18.7), not display text;
    //  - else, nothing follows it on its line (it ends at the line's end or the region's)
    //    and its operand opens with a token no prose word does — a cell `@x`, a `(`, a
    //    `[`, a number or a string literal (`not @x⏎`, `not (@x)⏎`) → code;
    //  - else → prose: more words follow it on its line (`not a clue`, the `not need a
    //    validator.` of `It does not need a validator.`), or its operand is a bare word
    //    with no `;` (`not done⏎`) — a sentence fragment, never a statement written as one.
    fn notStmtIsCode(before: TP, r: RStmt) -> boolean {
        if (r.tp.i <= before.i + 1) return false
        const last: PTok = r.tp.toks[r.tp.i - 1]
        if (tk(last, ";")) return true
        if (!atEnd(r.tp) && cur(r.tp).line == last.line) return false
        const op: PTok = before.toks[before.i + 1]
        if (op.cls == TC.At || op.cls == TC.Num || op.cls == TC.Str || op.cls == TC.TChunk || op.cls == TC.TIStart) return true
        return op.cls == TC.Punct && (op.text == "(" || op.text == "[")
    }

    // §40.8: "A bare expression statement at this body-top built only from
    // literals and operators — `404`, `-1`, `true`, `[1, 2]`, `"a" + 1` —
    // computes nothing observable, so it compiles nothing: it is
    // `E-UNQUOTED-DISPLAY-TEXT`".
    fn literalOnly(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> true
            .Str(v: s) :> true
            .Bool(v: b) :> true
            .NotLit :> true
            .Unary(op: o, e: x) :> literalOnly(x)
            .Binary(op: o, l: l, r: r) :> literalOnly(l) && literalOnly(r)
            .Ternary(test: c, yes: y, no: n) :> literalOnly(c) && literalOnly(y) && literalOnly(n)
            .ArrayLit(elems: es) :> allLiteral(es)
            .Template(quasis: qs, slots: ss) :> allLiteral(ss)
            .Call(callee: c) :> false
            .Assign(target: t) :> false
            .Sql(q: q) :> false
            .Handled(h: h) :> false
            .Recovered :> false
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Variant(name: n) :> false
            .Lambda(params: ps) :> false
            .BlockLambda(params: ps) :> false
            .Member(obj: o) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o, idx: i) :> false
            .HashRef(id: hr0) :> false
            .Foreign(f: fb0) :> false
        }
    }

    fn allLiteral(es: AExpr[]) -> boolean {
        for (const x of es) { if (!literalOnly(x)) return false }
        return true
    }

    // The pending run of display text [start, end) as ONE E-UNQUOTED-DISPLAY-TEXT
    // (nothing when start < 0).
    fn proseDiag(tp: TP, src: string, ctx: string, start: int, end: int) -> TP {
        if (start < 0) return tp
        const tag: string = ctx == "page" ? "page" : "program"
        const text: string = src.substring(start, end).trim()
        const quoted: string = "\"" + text.split("\\").join("\\\\").split("\"").join("\\\"") + "\""
        const d: Diag = newDiag("E-UNQUOTED-DISPLAY-TEXT", "display text in a `<" + tag + ">` body is declared — a markup element (`<p>" + text + "</p>`) or a quoted display-text literal (`" + quoted + "`): a bare run there is code, and this one is not valid code (§40.8, §4.18.7)", tp.file, mkSpan(start, end))
        return { toks: tp.toks, i: tp.i, nid: tp.nid, diags: tp.diags.concat([d]), file: tp.file, ns: tp.ns, inFn: tp.inFn }
    }

    // §40.8: "A `"..."` is a display-text literal here only when it stands as its
    // OWN statement: it opens a line (or directly follows a markup element), is
    // not the operand of a preceding operator …, and nothing but whitespace, `;`
    // or a `//` comment follows its closing `"` on that line" (INTERIM, above).
    // At a statement start, so never an operand.
    fn bodyTopDisplayAt(src: string, tp: TP) -> boolean {
        const t: PTok = cur(tp)
        if (t.cls != TC.Str || t.text.substring(0, 1) != "\"") return false
        if (tp.i > 0 && !opensLine(src, t.start)) return false
        let n: PTok = peekAt(tp, 1)
        if (n.cls != TC.End && tk(n, ";")) n = peekAt(tp, 2)
        if (n.cls == TC.End) return true
        return opensLine(src, n.start) && lineBreakBetween(src, t.end, n.start)
    }

    // Only spaces / tabs between the line's start (or the source's) and `pos`.
    fn opensLine(src: string, pos: int) -> boolean {
        let i: int = pos - 1
        while (i >= 0) {
            const c: string = src.substring(i, i + 1)
            if (c == "\n" || c == "\r") return true
            if (c != " " && c != "\t") return false
            i = i - 1
        }
        return true
    }

    fn lineBreakBetween(src: string, from: int, to: int) -> boolean {
        const s: string = src.substring(from, to)
        return s.indexOf("\n") >= 0 || s.indexOf("\r") >= 0
    }

    // The display-text literal at the cursor (bodyTopDisplayAt) — re-read in the
    // display mode (§4.18.3 escapes, §4.18.4 `${…}` segments, the code-default
    // body's own reader parseDisplayItem) — as markup items, and its `;`.
    fn bodyTopDisplay(mp: MP, tp: TP) -> RItems {
        const lit: PTok = cur(tp)
        const at: MP = { src: mp.src, pos: lit.start, nid: tp.nid, diags: tp.diags, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
        const d: TP = regionTP(at, LexStop.Line)
        let nodes: ANode[] = []
        let m: MP = at
        if (d.toks.length >= 2 && d.toks[0].end == lit.end) {
            const rn: RNodes = parseDisplayItem(at, d)
            nodes = rn.nodes
            m = rn.mp
        } else {
            m = mDiag(at, "E-BOOTSTRAP-UNSUPPORTED", "this display-text literal reads differently as display text and as code (an escape) — not in the bootstrap; write it in a markup element", lit.start, lit.end)
        }
        let items: AItem[] = []
        let nid: int = m.nid
        for (const n of nodes) {
            items = items.concat([{ nid: nid, span: n.span, k: AItemK.MarkupItem(n) }])
            nid = nid + 1
        }
        let t: TP = adv({ toks: tp.toks, i: tp.i, nid: nid, diags: m.diags, file: tp.file, ns: tp.ns, inFn: tp.inFn })
        if (isP(t, ";")) t = adv(t)
        return { items: items, tp: t }
    }

    fn logicRegionItem(mp: MP, stop: LexStop, top: boolean) -> RMItems {
        const tp: TP = regionTP(mp, stop)
        if (stop == LexStop.Decl) {
            // s478 — ONE declaration; what its region holds after it (a statement
            // its missing `;` let the region run on into) goes back to the
            // body-top reader, which reads it as what it is
            const r1: RItems = parseLogicItem(tp, top)
            let t: TP = r1.tp
            while (isP(t, ";")) { t = adv(t) }
            const back: MP = backToMarkup(mp, t)
            if (atEnd(t)) return { items: r1.items, mp: back }
            return { items: r1.items, mp: mAt(back, cur(t).start) }
        }
        const r: RItems = parseLogicItems(tp, "", top)
        return { items: r.items, mp: backToMarkup(mp, r.tp) }
    }

    fn parseTagItem(mp: MP, exported: boolean, isLet: boolean, ctx: string) -> RMItems {
        // s462: §4.17 — refused whole, before its attributes or body are read
        if (scriptStyleAt(mp) != "") return { items: [], mp: refuseScriptStyle(mp) }
        const ro: ROpener = parseOpener(mp)
        const o: Opener = ro.o
        if (isThemeOpener(o)) return { items: [], mp: refuseTheme(o, ro.mp) }
        // s473 (§21.3.3 rule 1): a `<host>` at file top or a direct child of `<program>`
        // s477 fix round 1 — a `<page>` body is read by the program body's reader
        // (pageItem), but a `<host>` there is no direct child of `<program>`. §21.3.3
        // rule 1: "`<host>` SHALL appear at file top level or as a direct child of
        // `<program>`. A `<host>` anywhere else SHALL be `E-HOST-BINDING-PLACEMENT`".
        if (isHostOpener(o) && ctx == "page") return elemItem(refuseHostPlacement(o, letOnNonDecl(ro.mp, o, isLet), "inside a `<page>`"), exported)
        if (isHostOpener(o) && ctx == "channel") return elemItem(refuseHostPlacement(o, letOnNonDecl(ro.mp, o, isLet), "inside a `<channel>`"), exported)
        if (isHostOpener(o)) return finishHost(o, letOnNonDecl(ro.mp, o, isLet), exported)
        if (isEffectOpener(o)) {
            // s449: an `<effect>` at the program body top — owned by the program scope
            const re: REffectNode = finishEffect(o, letOnNonDecl(ro.mp, o, isLet))
            let em: MP = re.mp
            if (exported) em = mDiag(em, "E-PARSE-EXPORT", "`export` applies to a declaration, not to an `<effect>`", re.w.span.start, re.w.span.end)
            const n: ANode = { nid: em.nid, span: re.w.span, k: ANodeK.Effect(re.w) }
            return mItem(mBump(em), re.w.span.start, AItemK.MarkupItem(n))
        }
        if (isRequestBody(o, ro.mp)) {
            // s475 (S3a): a `<request>` at the program body top — owned by the program scope
            const rr: RRequestNode = finishRequest(o, letOnNonDecl(ro.mp, o, isLet))
            let rm: MP = rr.mp
            if (exported) rm = mDiag(rm, "E-PARSE-EXPORT", "`export` applies to a declaration, not to a `<request>`", rr.r.span.start, rr.r.span.end)
            const rn: ANode = { nid: rm.nid, span: rr.r.span, k: ANodeK.Request(rr.r) }
            return mItem(mBump(rm), rr.r.span.start, AItemK.MarkupItem(rn))
        }
        // s476 — a `<page>` standing directly in a `<program>` / `<page>` body
        // (§40.8, §4.15); at the file top level it stays an element, for
        // analyze's outsideProgramDiag (a route file's `<page>` root, or one out
        // of place), and inside markup it is an element (resolveElem). A
        // DECLARATION opener named `page` (`let <page:int=1/>` — an own value, a
        // `:Type`, a typed attribute, §66.2.2) is a declaration, as before: a
        // user cell is judged by its own rules (E-NAME-COLLIDES-RESERVED for a
        // user declaration so named, §4.15).
        if (!o.star && o.name == "page" && ctx != "" && !isDeclOpener(o)) return pageItem(o, pageOpenerDiags(o, ro.mp, exported, isLet), ctx)
        // §38.1 / §34: "A `<channel>` inside `<page>` SHALL emit `E-CHANNEL-INSIDE-PAGE`"
        // — one report: the element is read (so its closer is found) and dropped.
        if (!o.star && o.name == "channel" && ctx == "page") return channelInPage(o, letOnNonDecl(ro.mp, o, isLet))
        // s478 (s478-boot-channel) — §38.1: a `<channel>` in a `<program>` body (channelItem)
        if (!o.star && o.name == "channel" && ctx != "" && !isDeclOpener(o)) return channelItem(o, letOnNonDecl(ro.mp, o, isLet), exported, ctx)
        // §38.13.3: an `<onchange>` standing in a channel body (onchangeItem)
        if (!o.star && o.name == "onchange" && ctx == "channel" && !isDeclOpener(o)) return onchangeItem(o, letOnNonDecl(ro.mp, o, isLet), exported)
        // s478 (s478-boot-endpoint) — §61 `<endpoint>` at an item position (endpointItem)
        if (!o.star && o.name == "endpoint" && !isDeclOpener(o)) return endpointItem(o, letOnNonDecl(ro.mp, o, isLet), exported, ctx)
        const k: TagKind = tagKind(o)
        const od: Opener = isLet ? withLet(o) : o
        return match k {
            .IsProgram :> programItem(o, programOpenerDiags(o, letOnNonDecl(ro.mp, o, isLet), exported), ctx == "")
            .IsDecl :> declItem(finishDecl(od, ro.mp, exported))
            .IsElem :> elemItem(finishElem(o, letOnNonDecl(ro.mp, o, isLet)), exported)
        }
    }

    // A `let` before a tag that declares nothing (§66.2.2 — no own value, no
    // typed attribute, no `:Type`): `let` is a declaration's `replace` grant.
    fn letOnNonDecl(mp: MP, o: Opener, isLet: boolean) -> MP {
        if (!isLet) return mp
        return mDiag(mp, "E-PARSE-LET", "`let` applies to a declaration — `<" + o.name + ">` declares nothing (a declaration has an own value `=…`, a `:Type`, or a typed attribute, §66.2.2; a container is `<" + o.name + ":struct>`)", o.start, o.start + o.name.length + 1)
    }

    // `export` / `let` before a state-child in a declaration body (O52): a
    // state-child names a variant; it is not a declaration and takes neither.
    fn keywordOnUse(mp: MP, o: Opener, exported: boolean, isLet: boolean) -> MP {
        let m: MP = letOnNonDecl(mp, o, isLet)
        if (exported) m = mDiag(m, "E-PARSE-EXPORT", "`export` applies to a declaration — `<" + o.name + ">` in a declaration body is a state-child (§66.2.2, O52)", o.start, o.start + o.name.length + 1)
        return m
    }

    fn declItem(r: RDecl) -> RMItems {
        return mItem(r.mp, r.d.span.start, AItemK.DeclItem(r.d))
    }

    fn elemItem(r: RElem, exported: boolean) -> RMItems {
        let m: MP = r.mp
        if (exported) m = mDiag(m, "E-PARSE-EXPORT", "`export` applies to a declaration, not to markup", r.e.span.start, r.e.span.end)
        const n: ANode = { nid: m.nid, span: r.e.span, k: ANodeK.Elem(r.e) }
        return mItem(mBump(m), r.e.span.start, AItemK.MarkupItem(n))
    }

    // s451 (S239 review MED-1): a `<program>` opener carries plain attributes
    // only — AProgram keeps `o.attrs` and nothing else, so anything else the
    // opener parsed (a typed attribute `auth:x="…"`, a validator call, an own
    // type `<program:int>`, an own value `<program=5>`, a `:`-shorthand body,
    // `export`) would be dropped silently. No SPEC sentence gives such a
    // `<program>` a meaning or a code (searched §4.12, §40.8, §66.2), so each
    // is refused here, by construction, rather than discarded.
    fn programOpenerDiags(o: Opener, mp: MP, exported: boolean) -> MP {
        let m: MP = mp
        const why: string = " on `<program>` is not in the bootstrap — a `<program>` opener carries plain attributes only (`name=\"…\"`); it is not a declaration"
        if (exported) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`export`" + why, o.start, o.start + 8)
        if (o.ty is given) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "an own type `<program:…>`" + why, o.start, o.start + 8)
        if (!isNoValue(o.own)) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "an own value `<program=…>`" + why, o.start, o.start + 8)
        for (const ta of o.typed) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the typed attribute `" + ta.name + ":…`" + why, ta.span.start, ta.span.end)
        }
        for (const v of o.vals) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the validator `" + v.name + "(…)`" + why, v.span.start, v.span.end)
        }
        if (o.short is given) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a `:`-shorthand body" + why, o.start, o.start + 8)
        return m
    }

    fn programItem(o: Opener, mp: MP, top: boolean) -> RMItems {
        let items: AItem[] = []
        let m: MP = mp
        if (!o.selfClosing) {
            const r: RMItems = parseMarkupItemsIn(mp, "program", top ? "program" : "nested")
            items = r.items
            m = r.mp
        }
        const p: AProgram = { nid: m.nid, span: mkSpan(o.start, m.pos), attrs: o.attrs, items: items }
        return mItem(mBump(m), o.start, AItemK.ProgramItem(p))
    }

    // s476 — `<page>` (§40.8 "Multi-page apps", §4.15). A `<page>` written
    // directly in the top-level `<program>`'s body is that program's page: its
    // body is a code-default body exactly like the program's (§40.8 S441 bullet:
    // "A `<program>`, `<page>` or `<channel>` body is a code-default body"; "A
    // `<page>` body … and a `<channel>` body … are the same locus and follow the
    // same rule"), so it is read by the program body's own reader, and its items
    // stand in the program's item list in place — it "shares the application
    // `<program>` scope" (§58.8) and renders where it is written. The `<page>`
    // itself is no DOM element (impl#1 behaviour, emit-html: "it does NOT
    // correspond to a DOM element"). Its opener and attributes are recorded
    // (MP.pages → FileAst.pages) for analyze's per-route attribute check.
    //   `ctx` "page": a `<page>` in a `<page>` body — §4.15: "`<page>` is
    //     grammatical only as a child of `<program>` … Use outside the owning
    //     locus is `E-STRUCTURAL-ELEMENT-MISPLACED`".
    //   `ctx` "nested": in a nested `<program>` (§4.12.2: a worker / sidecar /
    //     scoped-db context) — E-STRUCTURAL-ELEMENT-MISPLACED (§40.8 amended
    //     S478, open-Qs ruling item 60).
    // In either refused place the body is still read (to find its closer); the
    // error stops the build.
    fn pageItem(o: Opener, mp: MP, ctx: string) -> RMItems {
        let m: MP = mp
        const tagEnd: int = o.start + 5
        if (ctx == "page") {
            m = mDiag(m, "E-STRUCTURAL-ELEMENT-MISPLACED", "`<page>` inside a `<page>` — a `<page>` is grammatical only as a direct child of `<program>` (§4.15, §40.8); close the first `<page>` before opening the next", o.start, tagEnd)
        } else if (ctx == "nested") {
            // S478 open-Qs ruling item 60 — §40.8 (amended S478): "A `<page>` inside a nested
            // `<program>` … is `E-STRUCTURAL-ELEMENT-MISPLACED` (§4.15): a nested program is an
            // execution context, not a route container."
            m = mDiag(m, "E-STRUCTURAL-ELEMENT-MISPLACED", "`<page>` inside a nested `<program>` — a nested program is an execution context (a worker, sidecar or scoped-db program, §4.12), not a route container: a `<page>` is grammatical only as a direct child of the top-level `<program>` (§4.15, §40.8)", o.start, tagEnd)
        } else if (ctx == "channel") {
            // s478 (s478-boot-channel) — §4.15: "`<page>` is grammatical only as a child of `<program>`"
            m = mDiag(m, "E-STRUCTURAL-ELEMENT-MISPLACED", "`<page>` inside a `<channel>` — a `<page>` is grammatical only as a direct child of `<program>` (§4.15, §40.8); a channel is app-scope shared state and emits no markup (§38.2)", o.start, tagEnd)
        }
        let items: AItem[] = []
        if (!o.selfClosing) {
            const r: RMItems = parseMarkupItemsIn(m, "page", "page")
            items = r.items
            m = r.mp
        }
        if (ctx == "program") m = withPage(m, { span: mkSpan(o.start, tagEnd), attrs: o.attrs, body: mkSpan(o.start, m.pos) })
        return { items: items, mp: m }
    }

    fn withPage(mp: MP, pg: APage) -> MP {
        return { src: mp.src, pos: mp.pos, nid: mp.nid, diags: mp.diags, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages.concat([pg]), eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    // A `<page>` opener carries plain attributes only (the §40.8 per-route set —
    // analyze checks the names and values). It is no declaration opener (no own
    // value, `:Type` or typed attribute — parseTagItem reads those as a
    // declaration named `page`). Anything else the opener parsed would be
    // dropped by APage, so each is refused here: a validator call is an
    // attribute outside the per-route set (§40.8: "any other attribute on
    // `<page>` fires `E-PAGE-INVALID-ATTR`"); a `:`-shorthand body has no SPEC
    // meaning on `<page>` (searched §4.15, §40.8, §4.14 — as for `<program>`,
    // programOpenerDiags); `export` / `let` apply to declarations only.
    fn pageOpenerDiags(o: Opener, mp: MP, exported: boolean, isLet: boolean) -> MP {
        let m: MP = letOnNonDecl(mp, o, isLet)
        const at: int = o.start
        const why: string = " on `<page>` is not in the bootstrap — a `<page>` opener carries plain per-route attributes only (§40.8); it is not a declaration"
        if (exported) m = mDiag(m, "E-PARSE-EXPORT", "`export` applies to a declaration, not to a `<page>`", at, at + 5)
        for (const v of o.vals) {
            m = mDiag(m, "E-PAGE-INVALID-ATTR", "the validator `" + v.name + "(…)` on `<page>` — a `<page>` takes only the per-route attributes `db=`, `auth=`, `csrf=`, `ratelimit=`, `keep-alive` (§40.8)", v.span.start, v.span.end)
        }
        if (o.short is given) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a `:`-shorthand body" + why, at, at + 5)
        return m
    }

    // §38.1: "A `<channel>` inside `<page>` SHALL emit `E-CHANNEL-INSIDE-PAGE`"
    // (§34). Read whole, so its closer is found, and not kept: the error stops
    // the build, and analyze does not also report it as an unbuilt `<channel>`.
    fn channelInPage(o: Opener, mp: MP) -> RMItems {
        const r: RElem = finishElem(o, mp)
        const m: MP = mDiag(r.mp, "E-CHANNEL-INSIDE-PAGE", "`<channel>` inside `<page>` — a channel is app-scope shared state, not a per-route declaration (§38.1, §40.8); move it up into the `<program>`, beside the `<page>`", o.start, o.start + 8)
        return { items: [], mp: m }
    }

    // =========================================================================
    // s478 (s478-boot-channel) — §38 `<channel>` in a `<program>` body.
    // §38.1: "A `.scrml` file's `<program>` element MAY contain zero or more
    // `<channel>` declarations alongside its `<page>` declarations and other body
    // content. Channel state lives at the file scope established by `<program>`
    // and is reachable from inside any `<page>` via canonical `@` access." §40.8
    // S441: "A `<program>`, `<page>` or `<channel>` body is a code-default body";
    // "A `<page>` body … and a `<channel>` body … are the same locus and follow the
    // same rule". So the body is read by the program body's reader (ctx "channel")
    // and its items stand in the program's item list in place, as a `<page>`'s do;
    // the channel itself is recorded (MP.chans → FileAst.chans) with its opener,
    // attributes and extent, for analyze.scrml channelPass. §38.2: "A channel
    // body … SHALL NOT contain markup that emits HTML" — judged there, by extent.
    // `ctx` "nested" (a nested `<program>`) / "channel" (another channel's body):
    // recorded and refused by channelPass (INTERIM — g-boot-channel-s478).
    // =========================================================================
    fn channelItem(o: Opener, mp: MP, exported: boolean, ctx: string) -> RMItems {
        let m: MP = chTemplateQuiet(mp, o)
        const tagEnd: int = o.start + 8
        // §38.12.7: `export <channel …>` is the cross-file Form-1 declaration "at the top level
        // of a `.scrml` file" — the bootstrap has no CHX (§38.12.2) cross-file expansion
        if (exported) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`export <channel>` is not in the bootstrap — a cross-file channel (§38.12, the CHX inline expansion) is not built; declare the channel in the program that uses it (INTERIM, g-boot-channel-s478)", o.start, tagEnd)
        for (const v of o.vals) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the validator `" + v.name + "(…)` on `<channel>` — a `<channel>` opener carries the §38.3 attributes only", v.span.start, v.span.end)
        }
        let items: AItem[] = []
        const sh: ANode[] | not = o.short
        if (sh is given) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a `:`-shorthand body on `<channel>` — a channel body is a code-default body of declarations and functions (§38.2), written between `<channel …>` and `</channel>`", o.start, tagEnd)
        } else if (!o.selfClosing) {
            const r: RMItems = parseMarkupItemsIn(m, "channel", "channel")
            items = r.items
            m = r.mp
        }
        const ch: AChannel = { nid: m.nid, span: mkSpan(o.start, m.pos), opener: mkSpan(o.start, tagEnd), attrs: o.attrs, body: mkSpan(o.start, m.pos), ctx: ctx }
        const out: MP = { src: m.src, pos: m.pos, nid: m.nid + 1, diags: m.diags, file: m.file, hoist: m.hoist, dbFns: m.dbFns, hosts: m.hosts, pages: m.pages, eps: m.eps, chans: m.chans.concat([ch]), onchs: m.onchs, schemaN: m.schemaN, tables: m.tables, ns: m.ns }
        return { items: items, mp: out }
    }

    // §38.11: "`${...}` interpolation in these values is NOT supported and SHALL emit
    // `E-CHANNEL-007`" — channelPass reports it for `name=` / `topic=`; the attribute
    // reader's general refusal of a quoted `${…}` template (§5.5.3) is not a second report.
    fn chTemplateQuiet(mp: MP, o: Opener) -> MP {
        let spans: ASpan[] = []
        for (const a of o.attrs) {
            if (a.name == "name" || a.name == "topic") spans = spans.concat([a.span])
        }
        if (spans.length == 0) return mp
        let keep: Diag[] = []
        for (const d of mp.diags) {
            let drop = false
            if (d.code == "E-BOOTSTRAP-UNSUPPORTED") {
                for (const s of spans) { if (d.span.start >= s.start && d.span.end <= s.end) drop = true }
            }
            if (!drop) keep = keep.concat([d])
        }
        return { src: mp.src, pos: mp.pos, nid: mp.nid, diags: keep, file: mp.file, hoist: mp.hoist, dbFns: mp.dbFns, hosts: mp.hosts, pages: mp.pages, eps: mp.eps, chans: mp.chans, onchs: mp.onchs, schemaN: mp.schemaN, tables: mp.tables, ns: mp.ns }
    }

    // §38.13.3: "A `watches=` channel body contains exactly one `<onchange>`
    // element: a typed dispatch over the synthesized `RowChange` (§38.13.2),
    // reusing the match-block arm grammar (§18.0.1) + payload binding (§51.0.B.1)".
    // The arms are read (onchangeArms) and recorded (MP.onchs → FileAst.onchs);
    // channelPass judges them against the channel that holds the element (by
    // extent): exhaustiveness, misplacement (a non-`watches=` channel). The arm
    // bodies are read for their syntax only — the bootstrap emits no `watches=`
    // feed (print-server refuses it by name), so they are never lowered.
    fn onchangeItem(o: Opener, mp: MP, exported: boolean) -> RMItems {
        let m: MP = mp
        const tagEnd: int = o.start + 9
        if (exported) m = mDiag(m, "E-PARSE-EXPORT", "`export` applies to a declaration, not to an `<onchange>`", o.start, tagEnd)
        if (o.attrs.length > 0 || o.vals.length > 0 || o.typed.length > 0) m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "an attribute on `<onchange>` — §38.13.3 gives the element its arms only", o.start, tagEnd)
        let arms: AEpArm[] = []
        const sh: ANode[] | not = o.short
        if (sh is given) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a `:`-shorthand body on `<onchange>` — its body is its per-variant arms (§38.13.3)", o.start, tagEnd)
        } else if (!o.selfClosing) {
            const ra: REpArms = onchangeArms(m)
            arms = ra.arms
            m = ra.mp
        }
        const oc: AOnchange = { nid: m.nid, span: mkSpan(o.start, m.pos), arms: arms }
        const out: MP = { src: m.src, pos: m.pos, nid: m.nid + 1, diags: m.diags, file: m.file, hoist: m.hoist, dbFns: m.dbFns, hosts: m.hosts, pages: m.pages, eps: m.eps, chans: m.chans, onchs: m.onchs.concat([oc]), schemaN: m.schemaN, tables: m.tables, ns: m.ns }
        return { items: [], mp: out }
    }

    // The `<onchange>` arms to its closer: `<V : e>`, `<V(a) : e>`, `<V/>`, `<V(a)>…</>`,
    // `<_ : e>`, and the deprecated after-`>` placement `<V(a)> : e` (§18.0.1: "The
    // legacy after-`>` placement (`<Variant> : expr`) is DEPRECATED
    // (`W-COLON-SHORTHAND-LEGACY-PLACEMENT`, §34) — it parses identically during the
    // window").
    fn onchangeArms(mp: MP) -> REpArms {
        let m: MP = mp
        let out: AEpArm[] = []
        let going = true
        while (going) {
            m = skipTrivia(m)
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-UNCLOSED", "`<onchange>` is never closed", mp.pos, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                m = parseCloser(m, "onchange")
                going = false
            } else if (chAt(m, 0) == "<" && (isNameStart(chAt(m, 1)) || chAt(m, 1) == "_")) {
                const before: int = m.pos
                const r: REpArm = onchangeArm(m)
                out = out.concat([r.arm])
                m = r.mp
                if (m.pos == before) m = mAdv(m, 1)
            } else {
                const from: int = m.pos
                let to: int = m.src.indexOf("<", from + 1)
                if (to < 0) to = m.src.length
                m = mAt(mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "an `<onchange>` body holds its per-variant arms only (`<Inserted(row) : …>`, `<Updated(row) : …>`, `<Deleted(key) : …>`, `<_ : …>` — §38.13.3); this content is not an arm", from, to), to)
            }
        }
        return { arms: out, mp: m }
    }

    fn onchangeArm(mp: MP) -> REpArm {
        const start: int = mp.pos
        const nm: RWord = readName(mAdv(mp, 1))
        let m: MP = nm.mp
        let binds: ABind[] = []
        let parens = false
        if (chAt(m, 0) == "(") {
            parens = true
            m = mAdv(m, 1)
            let more = true
            while (more) {
                m = skipSpace(m)
                if (chAt(m, 0) == ")") {
                    m = mAdv(m, 1)
                    more = false
                } else if (isNameStart(chAt(m, 0))) {
                    const bw: RWord = readName(m)
                    binds = binds.concat([{ nid: m.nid, span: mkSpan(m.pos, bw.mp.pos), name: bw.w }])
                    m = skipSpace(mBump(bw.mp))
                    if (chAt(m, 0) == ",") m = mAdv(m, 1)
                } else {
                    const bad: int = m.pos
                    let to: int = m.src.indexOf(")", bad)
                    if (to < bad) to = bad
                    m = mAt(mDiag(m, "E-PARSE-TAG", "an `<onchange>` arm binds its variant's payload positionally (`<" + nm.w + "(row) …>`, §38.13.3 / §51.0.B.1)", bad, to + 1), to + 1)
                    more = false
                }
            }
        }
        const atBody: MP = skipSpace(m)
        let body: AExpr | not = not
        let selfClosing = false
        if (chAt(atBody, 0) == ":" && atBody.pos > m.pos) {
            const rs: RNodes = parseShorthand(atBody, nm.w)
            m = rs.mp
            body = soleInterp(rs.nodes)
        } else if (mLooking(atBody, "/>")) {
            selfClosing = true
            m = mAdv(atBody, 2)
        } else if (chAt(atBody, 0) == ">") {
            const after: MP = skipSpace(mAdv(atBody, 1))
            if (chAt(after, 0) == ":") {
                // the deprecated after-`>` placement: the expression runs to the end of the line
                m = mDiag(after, "W-COLON-SHORTHAND-LEGACY-PLACEMENT", "the `:`-shorthand body of the arm `<" + nm.w + ">` follows its `>` — the legacy placement; move `: expr` inside the opener, `<" + nm.w + " : expr>` (§18.0.1, §4.14)", start, after.pos + 1)
                const tp0: TP = codeRegionTP(mAdv(m, 1), LexStop.Line)
                const one: RExpr = parseAssign(tp0)
                body = one.e
                m = backToMarkup(mAdv(m, 1), one.tp)
            } else {
                const rk: RNodes = parseKids(mAdv(atBody, 1), nm.w)
                m = rk.mp
            }
        } else {
            const bad2: int = atBody.pos
            let to2: int = atBody.src.indexOf(">", bad2)
            if (to2 < 0) to2 = atBody.src.length - 1
            m = mAt(mDiag(atBody, "E-PARSE-TAG", "unexpected `" + chAt(atBody, 0) + "` in the `<onchange>` arm `<" + nm.w + "` — an arm is `<Variant(row) : expr>`, `<Variant(row)>…</>` or `<Variant/>` (§38.13.3, §18.0.1)", bad2, bad2 + 1), to2 + 1)
        }
        const arm: AEpArm = { nid: m.nid, span: mkSpan(start, m.pos), variant: nm.w, parens: parens, binds: binds, body: body, selfClosing: selfClosing, fn: "" }
        return { arm: arm, mp: mBump(m) }
    }

    // =========================================================================
    // s478 (s478-boot-endpoint) — §61 `<endpoint>`, the typed inbound route.
    // §61.2: "endpoint-decl ::= '<endpoint' endpoint-attrs '>' endpoint-arm+
    // '</endpoint>'" — "An `<endpoint>` declaration SHALL carry a `path=` (a
    // string-literal URL), a `method=` (a recognized HTTP method literal), and an
    // `accepts=` (a §14 / §53 `:enum` type-ref). A missing `path=` is
    // `E-ENDPOINT-PATH-MISSING`; a `method=` that is not a recognized HTTP method
    // is `E-ENDPOINT-METHOD-INVALID`". §34's E-ENDPOINT-METHOD-INVALID row: "— or
    // omits `method=` entirely (a missing method literal is reported here too) …
    // The value may be a quoted string-literal or a bareword"; E-ENDPOINT-ACCEPTS-
    // MISSING: "An `<endpoint>` declaration (SPEC §61.3) has no `accepts=` enum
    // type". The opener and its arms are read here and recorded (MP.eps →
    // FileAst.eps); the item list gets a placeholder that endpointDesugar replaces
    // with the arms' server functions once the whole file — and so the `accepts=`
    // enum, which may be declared after the endpoint — has been read.
    // =========================================================================
    fn endpointItem(o: Opener, mp: MP, exported: boolean, ctx: string) -> RMItems {
        let m: MP = mp
        const tagEnd: int = o.start + 9
        if (exported) m = mDiag(m, "E-PARSE-EXPORT", "`export` applies to a declaration, not to an `<endpoint>`", o.start, tagEnd)
        // §61.2 (S478 open-Qs ruling (user-voice), item 36): "An `<endpoint>`
        // declaration SHALL be a direct child of the top-level `<program>` … An
        // `<endpoint>` anywhere else … is `E-STRUCTURAL-ELEMENT-MISPLACED` (§4.15)".
        // A non-entry file's `<program>` is judged in analyze (endpointPass).
        if (ctx != "program") m = mDiag(m, "E-STRUCTURAL-ELEMENT-MISPLACED", "`<endpoint>` " + endpointPlaceWhy(ctx) + " — an `<endpoint>` is grammatical only as a direct child of the top-level `<program>` (§61.2, §4.15): a route belongs to the served program, not to a page, a channel or a nested program; move it into the `<program>` body", o.start, tagEnd)
        for (const v of o.vals) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the validator `" + v.name + "(…)` on `<endpoint>` — an `<endpoint>` opener carries `path=`, `method=` and `accepts=` only (§61.2)", v.span.start, v.span.end)
        }
        for (const ta of o.typed) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "the typed attribute `" + ta.name + ":…` on `<endpoint>` — an `<endpoint>` opener carries `path=`, `method=` and `accepts=` only (§61.2)", ta.span.start, ta.span.end)
        }
        let path: string = ""
        let method: string = ""
        let accepts: string = ""
        let acceptsSpan: ASpan = mkSpan(o.start, tagEnd)
        let sawPath = false
        let sawMethod = false
        let sawAccepts = false
        for (const a of o.attrs) {
            if (a.name == "path") {
                sawPath = true
                const pv: string | not = epQuotedOf(a.value)
                if (pv is given) {
                    path = pv
                } else {
                    // §61.2: `path-attr ::= 'path=' string-literal`
                    m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`path=` on `<endpoint>` is a string literal (§61.2 `path-attr ::= 'path=' string-literal` — the author-stable contract URL, §61.7); write it quoted, `path=\"/…\"`", a.span.start, a.span.end)
                }
            } else if (a.name == "method") {
                sawMethod = true
                const mv: string = methodWordOf(a.value)
                if (isEndpointMethod(mv)) {
                    method = mv
                } else {
                    m = mDiag(m, "E-ENDPOINT-METHOD-INVALID", "`method=` on `<endpoint>` is not a recognized HTTP method — it is one of GET, POST, PUT, PATCH, DELETE (§61.7, the §60.2 set)", a.span.start, a.span.end)
                }
            } else if (a.name == "accepts") {
                sawAccepts = true
                acceptsSpan = a.span
                const nv: string = bareNameOf(a.value)
                if (nv != "") {
                    accepts = nv
                } else {
                    m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`accepts=` on `<endpoint>` names an `:enum` type (§61.2 `accepts-attr ::= 'accepts=' enum-type-ref`) — write the bare type name, `accepts=MyEnum`", a.span.start, a.span.end)
                }
            } else if (a.name == "csrf") {
                // §61.7: "`<endpoint>` SHALL NOT carry a `csrf=` attribute" (no code named)
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`csrf=` on `<endpoint>` — §61.7: \"`<endpoint>` SHALL NOT carry a `csrf=` attribute and SHALL NOT be routed through the §12 CSRF gate\" (a JSON + bearer endpoint is CSRF-exempt by construction); remove it", a.span.start, a.span.end)
            } else {
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` on `<endpoint>` — an `<endpoint>` opener carries `path=`, `method=` and `accepts=` only (§61.2)", a.span.start, a.span.end)
            }
        }
        if (!sawPath) m = mDiag(m, "E-ENDPOINT-PATH-MISSING", "`<endpoint>` has no `path=` — the author-stable URL a foreign client connects to is required (§61.7)", o.start, tagEnd)
        if (!sawMethod) m = mDiag(m, "E-ENDPOINT-METHOD-INVALID", "`<endpoint>` has no `method=` — it is one of GET, POST, PUT, PATCH, DELETE (§61.7)", o.start, tagEnd)
        if (!sawAccepts) m = mDiag(m, "E-ENDPOINT-ACCEPTS-MISSING", "`<endpoint>` has no `accepts=` — the request body decodes into that `:enum` type (§61.3); without it there is nothing to decode or dispatch", o.start, tagEnd)
        const opener: ASpan = mkSpan(o.start, m.pos)
        let arms: AEpArm[] = []
        const sh: ANode[] | not = o.short
        if (sh is given) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a `:`-shorthand body on `<endpoint>` — its body is its per-variant arms (§61.2)", o.start, tagEnd)
        } else if (o.selfClosing) {
            m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "a self-closing `<endpoint/>` has no arms — §61.2: `endpoint-arm+` (one per variant of the `accepts=` enum)", o.start, tagEnd)
        } else {
            const ra: REpArms = endpointArms(m)
            arms = ra.arms
            m = ra.mp
        }
        const ep: AEndpoint = { nid: m.nid, span: mkSpan(o.start, m.pos), opener: opener, path: path, method: method, accepts: accepts, acceptsSpan: acceptsSpan,
                                arms: arms, top: ctx == "program", lowered: false }
        // the placeholder item endpointDesugar replaces (an empty text run renders nothing)
        const n: ANode = { nid: m.nid, span: ep.span, k: ANodeK.Text("") }
        const withEp: MP = { src: m.src, pos: m.pos, nid: m.nid, diags: m.diags, file: m.file, hoist: m.hoist, dbFns: m.dbFns, hosts: m.hosts, pages: m.pages, eps: m.eps.concat([ep]), chans: m.chans, onchs: m.onchs, schemaN: m.schemaN, tables: m.tables, ns: m.ns }
        return mItem(mBump(withEp), o.start, AItemK.MarkupItem(n))
    }

    fn endpointPlaceWhy(ctx: string) -> string {
        if (ctx == "page") return "inside a `<page>`"
        if (ctx == "nested") return "inside a nested `<program>`"
        if (ctx == "channel") return "inside a `<channel>`"
        return "outside a `<program>`"
    }

    fn epQuotedOf(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> s
            .NoValue :> not
            .Dur(text: s) :> not
            .Bare(e: e) :> not
            .Paren(e: e) :> not
            .Braced(b: b) :> not
        }
    }

    fn bareNameOf(v: AAttrValue) -> string {
        return match v {
            .Bare(e: e) :> exprNameOf(e)
            .Quoted(v: s) :> ""
            .NoValue :> ""
            .Dur(text: s) :> ""
            .Paren(e: e) :> ""
            .Braced(b: b) :> ""
        }
    }

    fn exprNameOf(e: AExpr) -> string {
        return match e.k {
            .Name(name: n) :> n
            // no-default-arm: one question of an expression — is it a bare name
            _ :> ""
        }
    }

    // §34 E-ENDPOINT-METHOD-INVALID: "The value may be a quoted string-literal or a bareword"
    fn methodWordOf(v: AAttrValue) -> string {
        const q: string | not = epQuotedOf(v)
        if (q is given) return q
        return bareNameOf(v)
    }

    // §61.7: "`method=` declares the HTTP method (`GET` / `POST` / `PUT` / `PATCH` / `DELETE`)"
    export fn isEndpointMethod(w: string) -> boolean {
        return w == "GET" || w == "POST" || w == "PUT" || w == "PATCH" || w == "DELETE"
    }

    type REpArms:struct = { arms: AEpArm[], mp: MP }
    type REpArm:struct = { arm: AEpArm, mp: MP }

    // The arms, to the `</endpoint>` (or `</>`) closer. §61.2: "each arm is a
    // state-child named for a variant of the `accepts=` enum". Anything else in the
    // body is refused by name and skipped to the next tag.
    fn endpointArms(mp: MP) -> REpArms {
        let m: MP = mp
        let out: AEpArm[] = []
        let going = true
        while (going) {
            m = skipTrivia(m)
            if (mEof(m)) {
                m = mDiag(m, "E-PARSE-UNCLOSED", "`<endpoint>` is never closed", mp.pos, m.pos)
                going = false
            } else if (mLooking(m, "</")) {
                m = parseCloser(m, "endpoint")
                going = false
            } else if (chAt(m, 0) == "<" && isNameStart(chAt(m, 1))) {
                const before: int = m.pos
                const r: REpArm = endpointArm(m)
                out = out.concat([r.arm])
                m = r.mp
                if (m.pos == before) m = mAdv(m, 1)
            } else {
                const from: int = m.pos
                let to: int = m.src.indexOf("<", from + 1)
                if (to < 0) to = m.src.length
                m = mAt(mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "an `<endpoint>` body holds its per-variant arms only (`<Variant : expr>`, `<Variant(a, b) : expr>`, `<Variant/>`, `<_ : expr>` — §61.2); this content is not an arm", from, to), to)
            }
        }
        return { arms: out, mp: m }
    }

    // One arm: `<V : expr>`, `<V(a, b) : expr>`, `<V/>`, `<V(a)>expr</>`, `<_ : expr>`
    // (§61.2 — the `:`-shorthand, the bare body and the self-closing no-op).
    fn endpointArm(mp: MP) -> REpArm {
        const start: int = mp.pos
        const nm: RWord = readName(mAdv(mp, 1))
        let m: MP = nm.mp
        let binds: ABind[] = []
        let parens = false
        if (chAt(m, 0) == "(") {
            parens = true
            m = mAdv(m, 1)
            let more = true
            while (more) {
                m = skipSpace(m)
                if (chAt(m, 0) == ")") {
                    m = mAdv(m, 1)
                    more = false
                } else if (isNameStart(chAt(m, 0))) {
                    const bw: RWord = readName(m)
                    binds = binds.concat([{ nid: m.nid, span: mkSpan(m.pos, bw.mp.pos), name: bw.w }])
                    m = skipSpace(mBump(bw.mp))
                    if (chAt(m, 0) == ",") m = mAdv(m, 1)
                } else {
                    const bad: int = m.pos
                    let to: int = m.src.indexOf(")", bad)
                    const gt: int = m.src.indexOf(">", bad)
                    if (to < 0 || (gt >= 0 && gt < to)) to = gt - 1
                    if (to < bad) to = bad
                    m = mAt(mDiag(m, "E-PARSE-TAG", "an `<endpoint>` arm binds its variant's payload positionally, one name per field (`<" + nm.w + "(a, b) …>`, §61.2 / §51.0.B.1)", bad, to + 1), to + 1)
                    more = false
                }
            }
        }
        const atBody: MP = skipSpace(m)
        let body: AExpr | not = not
        let selfClosing = false
        if (chAt(atBody, 0) == ":" && atBody.pos > m.pos) {
            const rs: RNodes = parseShorthand(atBody, nm.w)
            m = rs.mp
            const one: AExpr | not = soleInterp(rs.nodes)
            if (one is given) {
                body = one
            } else {
                m = mDiag(m, "E-BOOTSTRAP-UNSUPPORTED", "this `<endpoint>` arm's body is display text or markup — an arm body is the value the compiler envelopes as the JSON response (§61.5), and the bootstrap builds a value expression only", start, m.pos)
            }
        } else if (mLooking(atBody, "/>")) {
            selfClosing = true
            m = mAdv(atBody, 2)
        } else if (chAt(atBody, 0) == ">") {
            const rb: REpBody = endpointBareBody(mAdv(atBody, 1), nm.w, start)
            body = rb.e
            m = rb.mp
        } else {
            const bad2: int = atBody.pos
            let to2: int = atBody.src.indexOf(">", bad2)
            if (to2 < 0) to2 = atBody.src.length - 1
            m = mAt(mDiag(atBody, "E-PARSE-TAG", "unexpected `" + chAt(atBody, 0) + "` in the `<endpoint>` arm `<" + nm.w + "` — an arm is `<Variant : expr>`, `<Variant(a, b) : expr>`, `<Variant/>` or `<Variant>expr</>` (§61.2)", bad2, bad2 + 1), to2 + 1)
        }
        const arm: AEpArm = { nid: m.nid, span: mkSpan(start, m.pos), variant: nm.w, parens: parens, binds: binds, body: body, selfClosing: selfClosing, fn: "" }
        return { arm: arm, mp: mBump(m) }
    }

    fn soleInterp(ns: ANode[]) -> AExpr | not {
        if (ns.length != 1) return not
        return match ns[0].k {
            .Interp(e: e) :> e
            // no-default-arm: one question of a node — is it one value expression
            _ :> not
        }
    }

    type REpBody:struct = { e: AExpr | not, mp: MP }

    // A bare arm body `<V>…</>` (§61.2 "a code-default body, for a multi-statement
    // handler"). §61.10: "A MULTI-statement bare body … is NOT yet lowered … → the
    // clean `E-ENDPOINT-MULTI-STATEMENT-ARM` Error". ONE expression is the arm's
    // value; two or more statements is that Error (the statements are read only to
    // count them — their own diagnostics are not kept: the arm is refused whole); a
    // single non-expression statement, an empty body or markup in the body has no
    // value to envelope and is refused by name.
    fn endpointBareBody(mp: MP, name: string, armStart: int) -> REpBody {
        let m: MP = mp
        let body: AExpr | not = not
        const at: MP = skipTrivia(m)
        if (mLooking(at, "</") || (chAt(at, 0) == "<" && isNameStart(chAt(at, 1))) || atInterp(at)) {
            m = mDiag(at, "E-BOOTSTRAP-UNSUPPORTED", "this `<endpoint>` arm's bare body holds no value expression (empty, markup, or a `${…}` block) — an arm body is the one value the compiler envelopes as the JSON response (§61.5); write `<" + name + " : expr>`, or `<" + name + "/>` for the 204 no-op arm", armStart, at.pos)
        } else {
            const tp0: TP = codeRegionTP(at, LexStop.CodeBody)
            const one: RExpr = parseAssign(tp0)
            let t1: TP = one.tp
            while (isP(t1, ";")) { t1 = adv(t1) }
            if (atEnd(t1) && t1.diags.length == tp0.diags.length) {
                body = one.e
                m = backToMarkup(at, t1)
            } else {
                // count the statements (on a scratch read)
                let t: TP = tp0
                let n: int = 0
                while (!atEnd(t) && n < 64) {
                    const i0: int = t.i
                    const rs: RStmt = parseStmt(t)
                    t = rs.tp
                    while (isP(t, ";")) { t = adv(t) }
                    if (t.i == i0) t = adv(t)
                    n = n + 1
                }
                const back: MP = backToMarkup(at, t)
                const ended: MP = { src: back.src, pos: back.pos, nid: back.nid, diags: at.diags, file: back.file, hoist: back.hoist, dbFns: back.dbFns, hosts: back.hosts, pages: back.pages, eps: back.eps, chans: back.chans, onchs: back.onchs, schemaN: back.schemaN, tables: back.tables, ns: back.ns }
                if (n >= 2) {
                    m = mDiag(ended, "E-ENDPOINT-MULTI-STATEMENT-ARM", "the `<" + name + ">` arm of this `<endpoint>` has a multi-statement body — an arm body is a single value-expression (the value the compiler envelopes as the JSON response, §61.5); multi-statement handler bodies are a future wave (§61.10). Reduce the arm to one expression, or move the logic into a function and call it: `<" + name + " : compute(…)>`", armStart, ended.pos)
                } else {
                    m = mDiag(ended, "E-BOOTSTRAP-UNSUPPORTED", "this `<endpoint>` arm's bare body is one statement that is not an expression — an arm body is the one value the compiler envelopes as the JSON response (§61.5); write `<" + name + " : expr>`", armStart, ended.pos)
                }
            }
        }
        m = skipTrivia(m)
        if (mLooking(m, "</")) return { e: body, mp: parseCloser(m, name) }
        // markup (or anything else) after the value: refused, read to the arm's closer
        const from: int = m.pos
        const rest: RNodes = parseKids(m, name)
        return { e: not, mp: mDiag(rest.mp, "E-BOOTSTRAP-UNSUPPORTED", "an `<endpoint>` arm's bare body is ONE value expression (§61.2, §61.5) — this content follows it", from, rest.mp.pos) }
    }

    // ---- the desugar (after the whole file is read) --------------------------
    // §61.2: "The arm form **reuses** the `<match>` block-form arm grammar (§18.0.1)
    // and the §51.0.B.1 payload-binding surface — each arm is a state-child named
    // for a variant of the `accepts=` enum, with the variant's payload destructured
    // into per-arm locals"; §61.6: "An `<endpoint>` declaration SHALL emit a server
    // route-handler mounted at `path=` for `method=`". Each arm with a body becomes
    //   server function endpoint#<k>#<Variant>(<binder>: <field type>, …) { return <body> }
    // in place of the endpoint (the program's scope): its binders are its
    // parameters in declaration order, typed by the enum's payload fields (each type
    // copied with fresh node ids), so the arm's scope, typing, placement and
    // lowering are a server function's. Only when `accepts=` names an `:enum`
    // declared in THIS file (the parser cannot see another file's types); analyze
    // judges every other case (endpointPass). An arm naming no variant, a repeated
    // variant, or binders that do not match the payload is not desugared —
    // analyze reports it. A `_` binder is a parameter no source can name.
    type RDesugar:struct = { items: AItem[], eps: AEndpoint[], nid: int }

    fn endpointDesugar(items: AItem[], eps: AEndpoint[], nid0: int) -> RDesugar {
        if (eps.length == 0) return { items: items, eps: eps, nid: nid0 }
        let nid: int = nid0
        let outEps: AEndpoint[] = []
        let repl: EpRepl[] = []
        let k: int = 0
        for (const ep of eps) {
            const vs: AVariant[] | not = enumVariantsNamed(items, ep.accepts)
            let fns: AItem[] = []
            let arms: AEpArm[] = []
            let lowered = false
            if (vs is given && ep.top) {
                lowered = true
                let seen: string[] = []
                for (const a of ep.arms) {
                    let fnName: string = ""
                    const v: AVariant | not = variantNamed(vs, a.variant)
                    const fresh: boolean = seen.indexOf(a.variant) < 0
                    seen = seen.concat([a.variant])
                    const body: AExpr | not = a.body
                    let fields: ATypeField[] = []
                    let known = a.variant == "_"
                    if (v is given) {
                        fields = v.fields
                        known = true
                    }
                    const fits: boolean = !a.parens || (a.variant != "_" && a.binds.length == fields.length)
                    if (known && fresh && fits && body is given) {
                        fnName = "endpoint#" + k + "#" + a.variant
                        let params: AParam[] = []
                        let j: int = 0
                        for (const b of a.binds) {
                            const ct: RClone = cloneType(fields[j].ty, nid)
                            nid = ct.nid
                            let pn: string = b.name
                            if (pn == "_") pn = "_#" + j
                            params = params.concat([{ nid: nid, span: b.span, name: pn, ty: ct.t, lin: false }])
                            nid = nid + 1
                            j = j + 1
                        }
                        const ret: AStmt = { nid: nid, span: body.span, k: AStmtK.Return(body) }
                        const blk: ABlock = { nid: nid + 1, span: body.span, stmts: [ret] }
                        const f: AFn = { nid: nid + 2, span: a.span, exported: false, pure: false, name: fnName, params: params, ret: not, body: blk,
                                         server: true, failable: false, err: not }
                        fns = fns.concat([{ nid: nid + 3, span: a.span, k: AItemK.FnItem(f) }])
                        nid = nid + 4
                    }
                    arms = arms.concat([{ nid: a.nid, span: a.span, variant: a.variant, parens: a.parens, binds: a.binds, body: a.body, selfClosing: a.selfClosing, fn: fnName }])
                }
            } else {
                arms = ep.arms
            }
            outEps = outEps.concat([{ nid: ep.nid, span: ep.span, opener: ep.opener, path: ep.path, method: ep.method, accepts: ep.accepts, acceptsSpan: ep.acceptsSpan,
                                      arms: arms, top: ep.top, lowered: lowered }])
            repl = repl.concat([{ at: ep.nid, items: fns }])
            k = k + 1
        }
        return { items: replaceEpItems(items, repl), eps: outEps, nid: nid }
    }

    type EpRepl:struct = { at: int, items: AItem[] }

    // ---- the `<onchange>` desugar (S478 open-Qs ruling item 47) ---------------
    // Ruling (user-voice S478 item 47, g-boot-channel-s478 owner question 7): "desugar the
    // arms into client functions typed by the synthesized `RowChange`". §38.13.2: "`RowChange:enum
    // = { Inserted(row: <RowT>), Updated(row: <RowT>), Deleted(key: <PKT>) }` where `<RowT>` is
    // the struct of `T`'s columns and `<PKT>` is the type of `T`'s primary key"; §38.13.3: "`<onchange>`
    // arm bodies run CLIENT-side … via canonical `@` access to program-scope cells". So, for an
    // `<onchange>` in a `watches=<T>` channel of the top-level `<program>` whose table `T` this
    // file's `<schema>` declares, every column of a typed column type:
    //   type onchange#<k>#Row:struct = { <column>: <its type>, … }      (read-only fields)
    //   function onchange#<k>#<Variant>(<binder>: onchange#<k>#Row) { <body>; }   (Inserted / Updated)
    //   function onchange#<k>#Deleted(<binder>: <the key column's type>) { <body>; }
    //   function onchange#<k>#_() { <body>; }                             (the wildcard)
    // are added to the program's items, so each arm's scope and typing are a client function's
    // (an unknown name in an arm is E-SCOPE-001). `#` keeps every synthesized name out of source.
    // The column types mirror analyze.scrml colType (§14.8.3: INTEGER / REAL → `number`, TEXT
    // and TIMESTAMP → `string`; a nullable column `T | not`). FAILS CLOSED to no desugar (the
    // arms are judged for shape only, as before): a table not declared here or with an untyped
    // column, an arm with no `:` body (a block arm's markup body is not kept), an arm naming
    // no variant / repeating one / binding the wrong count (onchangeArmDiags reports those),
    // and a feed with no key column for a `Deleted` arm. The feed itself is still refused at
    // emit (print.scrml — the §38.13.7 capture is not built), so nothing here is printed.
    type ROnchDesugar:struct = { items: AItem[], nid: int }

    fn onchangeDesugar(items: AItem[], chans: AChannel[], onchs: AOnchange[], tables: SchemaTable[], nid0: int) -> ROnchDesugar {
        if (onchs.length == 0 || tables.length == 0) return { items: items, nid: nid0 }
        let nid: int = nid0
        let add: AItem[] = []
        let k: int = 0
        for (const oc of onchs) {
            let table: string = ""
            let keyCol: string = ""
            let top = false
            for (const ch of chans) {
                if (oc.span.start >= ch.body.start && oc.span.end <= ch.body.end) {
                    top = ch.ctx == "program"
                    for (const a of ch.attrs) {
                        if (a.name == "watches") table = attrBareName(a.value)
                        if (a.name == "key") keyCol = attrBareName(a.value)
                    }
                }
            }
            let tbl: SchemaTable | not = not
            for (const t of tables) { if (t.name == table) tbl = t }
            if (top && tbl is given && onchAllTyped(tbl.cols)) {
                const rowName: string = "onchange#" + k + "#Row"
                let fields: ATypeField[] = []
                for (const c of tbl.cols) {
                    const ct: RClone = onchColType(c, oc.span, nid)
                    nid = ct.nid
                    fields = fields.concat([{ nid: nid, span: oc.span, isLet: false, name: c.name, ty: ct.t, vals: [] }])
                    nid = nid + 1
                }
                add = add.concat([{ nid: nid, span: oc.span, k: AItemK.TypeItem({ nid: nid + 1, span: oc.span, exported: false, name: rowName, body: ATypeBody.StructBody(fields) }) }])
                nid = nid + 2
                // §38.13.2: "The primary key is derived by the `id`-field convention …; an explicit
                // `key=<column>` attribute … overrides it"
                let pkc: SchemaCol | not = not
                for (const c2 of tbl.cols) {
                    if (keyCol != "" && c2.name == keyCol) pkc = c2
                }
                if (keyCol == "") {
                    for (const c3 of tbl.cols) { if (pkc is not && c3.pk) pkc = c3 }
                    for (const c4 of tbl.cols) { if (pkc is not && c4.name == "id") pkc = c4 }
                }
                let seen: string[] = []
                let wild = false
                for (const a of oc.arms) {
                    const fresh: boolean = seen.indexOf(a.variant) < 0 && !wild
                    seen = seen.concat([a.variant])
                    if (a.variant == "_") wild = true
                    const body: AExpr | not = a.body
                    let pty: AType | not = not
                    let known = false
                    if (a.variant == "Inserted" || a.variant == "Updated") {
                        pty = { nid: nid, span: a.span, k: ATypeK.TName(rowName) }
                        nid = nid + 1
                        known = true
                    } else if (a.variant == "Deleted" && pkc is given) {
                        const kt: RClone = onchColType(pkc, a.span, nid)
                        nid = kt.nid
                        pty = kt.t
                        known = true
                    } else if (a.variant == "_") {
                        known = true
                    }
                    const fits: boolean = !a.parens || (a.variant != "_" && a.binds.length == 1)
                    if (known && fresh && fits && body is given) {
                        let params: AParam[] = []
                        if (a.parens && a.binds.length == 1) {
                            let pn: string = a.binds[0].name
                            if (pn == "_") pn = "_#0"
                            params = [{ nid: nid, span: a.binds[0].span, name: pn, ty: pty, lin: false }]
                            nid = nid + 1
                        }
                        const st: AStmt = { nid: nid, span: body.span, k: AStmtK.Eval(body) }
                        const blk: ABlock = { nid: nid + 1, span: body.span, stmts: [st] }
                        const f: AFn = { nid: nid + 2, span: a.span, exported: false, pure: false, name: "onchange#" + k + "#" + a.variant, params: params, ret: not, body: blk,
                                         server: false, failable: false, err: not }
                        add = add.concat([{ nid: nid + 3, span: a.span, k: AItemK.FnItem(f) }])
                        nid = nid + 4
                    }
                }
            }
            k = k + 1
        }
        if (add.length == 0) return { items: items, nid: nid }
        return { items: appendToProgram(items, add), nid: nid }
    }

    // `items` with `add` appended to the body of its (first) top-level `<program>`.
    fn appendToProgram(items: AItem[], add: AItem[]) -> AItem[] {
        let out: AItem[] = []
        let done = false
        for (const it of items) {
            const p: AProgram | not = programOfItem(it.k)
            if (p is given && !done) {
                out = out.concat([{ nid: it.nid, span: it.span, k: AItemK.ProgramItem({ nid: p.nid, span: p.span, attrs: p.attrs, items: p.items.concat(add) }) }])
                done = true
            } else {
                out = out.concat([it])
            }
        }
        return out
    }

    fn onchAllTyped(cs: SchemaCol[]) -> boolean {
        if (cs.length == 0) return false
        for (const c of cs) {
            if (c.ty != "integer" && c.ty != "real" && c.ty != "text" && c.ty != "timestamp") return false
        }
        return true
    }

    // A column's type (analyze.scrml colType's mapping, §14.8.3), with fresh node ids.
    fn onchColType(c: SchemaCol, at: ASpan, nid: int) -> RClone {
        let base: string = "string"
        if (c.ty == "integer" || c.ty == "real") base = "number"
        const t: AType = { nid: nid, span: at, k: ATypeK.TName(base) }
        if (c.nn || (c.pk && c.ty == "integer")) return { t: t, nid: nid + 1 }
        return { t: { nid: nid + 1, span: at, k: ATypeK.TMaybe(t) }, nid: nid + 2 }
    }

    // A bare-name attribute value (`watches=orders`), else "".
    fn attrBareName(v: AAttrValue) -> string {
        const e: AExpr | not = match v {
            .Bare(e: x) :> x
            // no-default-arm: one question of an attribute value — is it bare
            _ :> not
        }
        if (e is not) return ""
        return match e.k {
            .Name(name: n) :> n
            // no-default-arm: one question of an expression — is it a bare name
            _ :> ""
        }
    }

    // The placeholder MarkupItem of each endpoint (its node id is the endpoint's) → its functions.
    fn replaceEpItems(items: AItem[], repl: EpRepl[]) -> AItem[] {
        let out: AItem[] = []
        for (const it of items) {
            const k: AItemK = it.k
            const p: AProgram | not = programOfItem(k)
            const at: int = epPlaceholderAt(k)
            let done = false
            if (p is given) {
                out = out.concat([{ nid: it.nid, span: it.span, k: AItemK.ProgramItem({ nid: p.nid, span: p.span, attrs: p.attrs, items: replaceEpItems(p.items, repl) }) }])
                done = true
            }
            if (!done && at >= 0) {
                for (const r of repl) {
                    if (r.at == at) {
                        out = out.concat(r.items)
                        done = true
                    }
                }
            }
            if (!done) out = out.concat([it])
        }
        return out
    }

    fn programOfItem(k: AItemK) -> AProgram | not {
        return match k {
            .ProgramItem(p: p) :> p
            // no-default-arm: one question of an item — is it a program
            _ :> not
        }
    }

    // The node id of an endpoint placeholder item (an empty Text MarkupItem), -1 otherwise.
    fn epPlaceholderAt(k: AItemK) -> int {
        return match k {
            .MarkupItem(n: n) :> textPlaceholderNid(n)
            // no-default-arm: one question of an item — is it a markup placeholder
            _ :> -1
        }
    }

    fn textPlaceholderNid(n: ANode) -> int {
        return match n.k {
            .Text(text: t) :> emptyTextNid(t, n.nid)
            // no-default-arm: one question of a node — is it an empty text run
            _ :> -1
        }
    }

    fn emptyTextNid(t: string, nid: int) -> int {
        if (t == "") return nid
        return -1
    }

    // The variants of the `:enum` named `name` declared in `items` (a program's
    // items included); `not` when no such enum is declared here.
    fn enumVariantsNamed(items: AItem[], name: string) -> AVariant[] | not {
        if (name == "") return not
        for (const it of items) {
            const k: AItemK = it.k
            const p: AProgram | not = programOfItem(k)
            if (p is given) {
                const inner: AVariant[] | not = enumVariantsNamed(p.items, name)
                if (inner is given) return inner
            }
            const td: ATypeDecl | not = typeDeclOfItem(k)
            if (td is given && td.name == name) return enumBodyOf(td.body)
        }
        return not
    }

    fn typeDeclOfItem(k: AItemK) -> ATypeDecl | not {
        return match k {
            .TypeItem(t: t) :> t
            // no-default-arm: one question of an item — is it a type declaration
            _ :> not
        }
    }

    fn enumBodyOf(b: ATypeBody) -> AVariant[] | not {
        return match b {
            .EnumBody(variants: vs) :> vs
            // no-default-arm: one question of a type body — is it an enum's
            _ :> not
        }
    }

    fn variantNamed(vs: AVariant[], name: string) -> AVariant | not {
        for (const v of vs) {
            if (v.name == name) return v
        }
        return not
    }

    type RClone:struct = { t: AType, nid: int }

    // `t` with fresh node ids (the payload field's type, written again as a parameter's).
    fn cloneType(t: AType, nid0: int) -> RClone {
        const k: ATypeK = t.k
        return match k {
            .TName(name: n) :> { t: { nid: nid0, span: t.span, k: ATypeK.TName(n) }, nid: nid0 + 1 }
            .TSeq(elem: e, grants: g) :> cloneSeq(t.span, e, g, nid0)
            .TMaybe(inner: i) :> cloneMaybe(t.span, i, nid0)
            .TLife(pre: a, post: b) :> cloneLife(t.span, a, b, nid0)
            .TRefine(base: b, pred: p) :> cloneRefine(t.span, b, p, nid0)
            .TFn(params: ps, ret: r, fx: x) :> cloneFnType(t.span, ps, r, x, nid0)
        }
    }

    fn cloneSeq(sp: ASpan, e: AType, g: string[], nid0: int) -> RClone {
        const r: RClone = cloneType(e, nid0)
        return { t: { nid: r.nid, span: sp, k: ATypeK.TSeq(r.t, g) }, nid: r.nid + 1 }
    }

    fn cloneMaybe(sp: ASpan, i: AType, nid0: int) -> RClone {
        const r: RClone = cloneType(i, nid0)
        return { t: { nid: r.nid, span: sp, k: ATypeK.TMaybe(r.t) }, nid: r.nid + 1 }
    }

    fn cloneLife(sp: ASpan, a: AType, b: AType, nid0: int) -> RClone {
        const ra: RClone = cloneType(a, nid0)
        const rb: RClone = cloneType(b, ra.nid)
        return { t: { nid: rb.nid, span: sp, k: ATypeK.TLife(ra.t, rb.t) }, nid: rb.nid + 1 }
    }

    fn cloneRefine(sp: ASpan, b: AType, p: string, nid0: int) -> RClone {
        const r: RClone = cloneType(b, nid0)
        return { t: { nid: r.nid, span: sp, k: ATypeK.TRefine(r.t, p) }, nid: r.nid + 1 }
    }

    // s478 (s478-boot-fn-type)
    fn cloneFnType(sp: ASpan, ps: AType[], ret: AType | not, fx: AFnFx, nid0: int) -> RClone {
        let nid: int = nid0
        let out: AType[] = []
        for (const p of ps) {
            const r: RClone = cloneType(p, nid)
            out = out.concat([r.t])
            nid = r.nid
        }
        if (ret is not) return { t: { nid: nid, span: sp, k: ATypeK.TFn(out, not, fx) }, nid: nid + 1 }
        const rr: RClone = cloneType(ret, nid)
        return { t: { nid: rr.nid, span: sp, k: ATypeK.TFn(out, rr.t, fx) }, nid: rr.nid + 1 }
    }

    // =========================================================================
    // Entry.
    // =========================================================================
    export type Parsed:struct = { ast: FileAst, diags: Diag[], nextId: int }

    // Parse one file. NodeIds start at `firstId`; `nextId` is the first unused.
    // s475 r1: a file with namespace imports is read twice — the second time knowing their names
    // (from the first read's import items, nsOfItems), so its dotted types, `fail` heads, qualified
    // arms and tags name module members. Its VALUE members are analysis's (PNs).
    export fn parseFile(path: string, src: string, firstId: int) -> Parsed {
        const p1: Parsed = parseFileNs(path, src, firstId, { names: [], at: [], kw: [] })
        const names: string[] = nsOfItems(p1.ast.items)
        if (names.length == 0) return p1
        return parseFileNs(path, src, firstId, { names: names, at: [], kw: [] })
    }

    // Parse one file in the namespace context `ns` (analyze.scrml re-parses with the value
    // offsets its first analysis proved, PNs.at).
    export fn parseFileNs(path: string, src: string, firstId: int, ns: PNs) -> Parsed {
        const m0: MP = { src: src, pos: 0, nid: firstId, diags: [], file: path, hoist: [], dbFns: [], hosts: [], pages: [], eps: [], chans: [], onchs: [], schemaN: 0, tables: [], ns: ns }
        const r0: RMItems = parseMarkupItems(m0, "")
        const r1: RMItems = { items: r0.items, mp: withDiagsOf(r0.mp, markupValueDiags(r0.mp.diags, src)) }
        // s478 (s478-boot-endpoint): each `<endpoint>`'s arms, as server functions (endpointDesugar)
        const dz0: RDesugar = endpointDesugar(r1.items, r1.mp.eps, r1.mp.nid)
        // s478 (S478 open-Qs ruling item 47): each `<onchange>` arm, as a client function (onchangeDesugar)
        const oz: ROnchDesugar = onchangeDesugar(dz0.items, r1.mp.chans, r1.mp.onchs, r1.mp.tables, dz0.nid)
        const dz: RDesugar = { items: oz.items, eps: dz0.eps, nid: oz.nid }
        const m1: MP = r1.mp
        const r: RMItems = { items: dz.items, mp: { src: m1.src, pos: m1.pos, nid: dz.nid, diags: m1.diags, file: m1.file, hoist: m1.hoist, dbFns: m1.dbFns, hosts: m1.hosts, pages: m1.pages, eps: dz.eps, chans: m1.chans, onchs: m1.onchs, schemaN: m1.schemaN, tables: m1.tables, ns: m1.ns } }
        // `errs`: the ERROR spans only (s451) — §34: Warning and Info codes "do
        // not fail the compile", so a parse warning neither untrusts a declaration
        // nor closes the diagnostics gate.
        let errs: ASpan[] = []
        // (s469: not E-STMT-NO-EFFECT — a whole, well-formed statement: the body around
        // it IS what was written, so analyze still judges it, e.g. E-TYPE-043)
        for (const d of r.mp.diags) { if (d.severity == Severity.Error && d.code != "E-STMT-NO-EFFECT") errs = errs.concat([d.span]) }
        return { ast: { path: path, items: r.items, errs: errs, lines: lineStarts(src), dbFns: r.mp.dbFns, hosts: r.mp.hosts, pages: r.mp.pages, eps: r.mp.eps, first: firstId, tables: r.mp.tables, chans: r.mp.chans, onchs: r.mp.onchs }, diags: r.mp.diags, nextId: r.mp.nid }
    }

    // The offset where each line of `src` starts (s454 — FileAst.lines).
    fn lineStarts(src: string) -> int[] {
        let out: int[] = []
        let at: int = 0
        for (const ln of src.split("\n")) {
            out = out.concat([at])
            at = at + ln.length + 1
        }
        return out
    }
}
