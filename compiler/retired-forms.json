      ],
      "spec": "§4.4; Appendix E (\"Any source file using bare `/` or trailing content`/` closers SHALL be rejected\")",
      "ruling": "scrml-support/user-voice-scrml.md S14 \"man, self closer hasnt been / for a while. the closer is </>\"; scrml-support/user-voice-scrml.md S482 \"⭐ RULED — the `/}` \\\"terse closer\\\" is the retired trailing-slash closer; Appendix E governs\"",
      "retired": "2026-04-09",
