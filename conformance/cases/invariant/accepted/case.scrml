// §66.13.5 (S482 / S483) — the accepted forms; a function named `invariant` is still called.
<program>
    type Range:struct = { lo: int, hi: int } invariant (lo <= hi) [ordered]
    fn invariant(x: int) -> bool { return x > 0; }
    <band:struct>
        let <low:int=18/>
        let <mid:int=21/>
        let <high:int=24/>
    </>
    invariant (low <= mid) [lowBelowMid]
    renders <span class="band">${low}-${high}</span>
    invariant (mid <= high)
    let <r:Range=({ lo: 1, hi: 2 })/>
    <main>
        <p id="lo">${@band.low}</p>
        <p id="r">${@r.hi}</p>
        <p id="call">${invariant(3)}</p>
    </main>
</program>
