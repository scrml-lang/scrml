// §66.13.5 (S483 item 2) — the grouped write is the spread: one snapshot, all or nothing, checked once. A
// spread that keeps the invariant moves both fields; one that breaks it traps before either is written.
<program>
    <dateRange:struct>
        let <start:int=0/>
        let <end:int=10/>
    </>
    invariant (start <= end) [ordered]
    function shift(k: int) { @dateRange = { ...@dateRange, start: @dateRange.start + k, end: @dateRange.end + k }; }
    function squeeze(a: int, b: int) { @dateRange = { ...@dateRange, start: a, end: b }; }
    <main>
        <button id="sh" onclick=shift(15)>shift</button>
        <button id="bad" onclick=squeeze(30, 3)>squeeze</button>
        <p id="s">${@dateRange.start}</p>
        <p id="e">${@dateRange.end}</p>
    </main>
</program>
