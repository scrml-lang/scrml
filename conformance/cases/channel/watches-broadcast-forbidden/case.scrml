<program db="postgres://localhost/app">

  <schema>
    orders {
      id: integer primary key
      status: text
      total: real
    }
  </schema>

  <channel name="orders-feed" watches=orders>
    ${ function ping() { broadcast({ x: 1 }); } }
    <onchange>
      <Inserted(row) : print(row.id)>
      <Updated(row) : print(row.id)>
      <Deleted(key) : print(key)>
    </onchange>
  </channel>

</program>
