<program db="postgres://localhost/app">

  <schema>
    events {
      label: text
      ts: real
    }
  </schema>

  <channel name="events-feed" watches=events key=label>
    <onchange>
      <Inserted(row) : print("inserted")>
      <Updated(row) : print("updated")>
      <Deleted(key) : print("deleted")>
    </onchange>
  </channel>

</program>
