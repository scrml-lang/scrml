<program db="postgres://localhost/app">

  <schema>
    events {
      label: text
      ts: real
    }
  </schema>

  <channel name="events-feed" watches=events>
    <onchange>
      <Inserted(row) : print("inserted")>
      <Updated(row) : print("updated")>
      <Deleted(key) : print(key)>
    </onchange>
  </channel>

</program>
