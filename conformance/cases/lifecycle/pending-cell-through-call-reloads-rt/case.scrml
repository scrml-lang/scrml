// §13.9.1 S475 / §13.9.2 — a `let` pending cell whose initializer reads `@userId` THROUGH a called client function re-runs on it.
<program db="./app.db">
    type User:struct = { id: int, name: string }
    function loadName(id: int) -> string {
        const u: User = ?{`SELECT id, name FROM users WHERE id = ${id}`}.get() !{ _ :> { return "?"; } };
        return u.name;
    }
    function cur() -> string {
        const n = loadName(@userId) !{ _ :> "?" };
        return n;
    }
    let <userId:int=1/>
    let <who:(not to string)=(cur())/>
    <main>
        <button id="u2" onclick={ @userId = 2; }>2</button>
        <p id="who" if=@who>${@who}</p>
        <p id="wait" else>loading</p>
    </main>
</program>
