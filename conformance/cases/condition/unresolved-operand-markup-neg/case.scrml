// §42.4 statement 10 (S460 "a on F2, go") / §17.1 — `if=!g()` over a call whose return type is unresolved.
<program>
    // `g` returns an `asIs` value (§42.4 statement 5): its return type is neither declared nor inferred.
    function g() { const v: asIs = true; return v; }
    <main>
        <p if=!g()>x</p>
    </main>
</program>
