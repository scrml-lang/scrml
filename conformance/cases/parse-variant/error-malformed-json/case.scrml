${
    import { parseVariant } from 'scrml:data';

    type LoadResult:enum = {
        Success(rows: int)
        Empty
        Failed(reason: string)
    }

    <parseError> = "none"

    function decode() {
        parseVariant('not valid json', LoadResult) !{
            ::MissingDiscriminator          :> { @parseError = "missing-discriminator"; },
            ::UnknownVariant(_)             :> { @parseError = "unknown-variant"; },
            ::InvalidPayload(field, _)      :> { @parseError = "invalid-payload:" + field; },
            ::Malformed(_)                  :> { @parseError = "malformed"; }
        };
    }
}
<program>
    <button id="decode" onclick=decode()>Decode</>
    <p id="status">Parse status: ${@parseError}</p>
</program>
