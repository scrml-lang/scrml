${
    import { parseVariant } from 'scrml:data';

    type LoadResult:enum = {
        Success(rows: int)
        Empty
        Failed(reason: string)
    }

    type Row = UserRow;
    type UserRow:struct = { id: int }

    <parseError> = "none"

    function decode() {
        parseVariant('{"tag":"Empty"}', Row) !{
            .MissingDiscriminator          :> { @parseError = "missing-discriminator"; return; },
            .UnknownVariant(tag)           :> { @parseError = "unknown-variant"; return; },
            .InvalidPayload(field, reason) :> { @parseError = "invalid-payload:" + field; return; },
            .Malformed(reason)             :> { @parseError = "malformed"; return; }
        };
    }
}
<program>
    <button id="decode" onclick=decode()>Decode</>
</program>
