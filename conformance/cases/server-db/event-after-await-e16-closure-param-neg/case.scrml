<program>
<verdict> = "unset"
server function isOk(n: int) { return n > 100; }
<form id="f" onsubmit=${(event) => { const stop = (e) => e.preventDefault(); const ok: bool = isOk(1) !{ _ :> false }; @verdict = ok ? "a" : "r"; stop(event); }}><button>s</button></form>
<p id="out">${@verdict}</p>
</program>
