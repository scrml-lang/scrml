<program>
<verdict> = "unset"
<flag> = false
server function isOk(n: int) { return n > 100; }
<p id="out">${@verdict}</p>
<form id="f" onsubmit=${(event) => { const ev = event; const ok: bool = isOk(1) !{ _ :> false }; @verdict = ok ? "accepted" : "rejected"; ev.preventDefault(); }}><button>s</button></form>
</program>
