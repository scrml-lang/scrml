// §51.0.R / §6.13.5 (S480) — a `throttled=` engine with an `<onIdle>` watchdog: the fire inside an
// open throttle window applies immediately and drops the held trailing write.
<program>
    type Phase:enum = { Active, Busy, Idle }
    <phase:Phase=.Active single throttled=10s>
        <Active rule=(.Busy | .Idle)/>
        <Busy rule=(.Active | .Idle)/>
        <Idle rule=(.Active | .Busy)/>
        <onIdle after=5s to=.Idle/>
    </>
    function busy() { @phase = .Busy; }
    function active() { @phase = .Active; }
    <main>
        <p id="s">${@phase}</p>
        <button id="busy" onclick=busy()>Busy</button>
        <button id="active" onclick=active()>Active</button>
    </main>
</program>
