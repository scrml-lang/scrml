// §6.13.5 (S479) — the static check of a LITERAL held write: `.Archived` is reachable from no
// state the timed engine can hold (its only incoming edge is from `.Purged`, itself unreachable),
// so `@doc = .Archived` could never commit.
<program>
    type Doc:enum = { Draft, Review, Published, Purged, Archived }
    <doc:Doc=.Draft single debounced=500ms>
        <Draft rule=.Review/>
        <Review rule=(.Draft | .Published)/>
        <Published rule=.Draft/>
        <Purged rule=.Archived/>
        <Archived rule=.Draft/>
    </>
    function archive() { @doc = .Archived; }
    <main>
        <p>${@doc}</p>
        <button onclick=archive()>Archive</button>
    </main>
</program>
