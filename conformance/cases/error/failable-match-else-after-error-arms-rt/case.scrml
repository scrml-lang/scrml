${
    type AuthErr:enum = {
        Denied
        Locked
    }

    function check(pw: string)! AuthErr {
        if (pw == "locked") fail AuthErr.Locked;
        if (pw != "secret") fail AuthErr.Denied;
        return true;
    }
}

<wrong> = ""
<right> = ""

${
    // Every error variant has its own arm, so `else` takes only the success value.
    function attempt(pw: string) -> string {
        return match check(pw) {
            ::Locked :> "locked",
            ::Denied :> "denied",
            else     :> "LOGGED IN"
        };
    }
    function login() {
        @wrong = attempt("hunter3");
        @right = attempt("secret");
    }
}

<button id="go" onclick=login()>go</>
<p id="wrong">${@wrong}</>
<p id="right">${@right}</>
