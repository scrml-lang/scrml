<program db="./app.db">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost }
    function save(a: int)! E {
        ?{`INSERT INTO log (a) VALUES (${a})`}.run();
        return 1;
    }
    function onClient(a: int)! E {
        transaction {
            const x: int = save(a)?;
            @r = x;
        }
        return 1;
    }
    let <r:int=0/>
    <button onclick={ @r = onClient(1) !{ _ :> 0, }; }>x</button>
</program>
