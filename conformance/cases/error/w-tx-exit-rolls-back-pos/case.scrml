<program db="./app.db">
    type E:enum = { Bad, QueryFailed(message: string), ConstraintViolation(field: string), ConnectionLost }
    function returnsOut(a: int)! E {
        const n = ?{`SELECT a FROM log`}.all();
        transaction {
            ?{`INSERT INTO log (a) VALUES (${a})`}.run();
            if (a > 0) { return 7; }
            ?{`INSERT INTO log (a) VALUES (${a + 1})`}.run();
        }
        return 1;
    }
    let <r:int=0/>
    <button onclick={ @r = returnsOut(1) !{ _ :> 0, }; }>x</button>
</program>
