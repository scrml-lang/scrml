${
    type E:enum = {
        Bad
    }

    <n> = 0

    function risky(k: int)! -> E {
        if (k < 0) { fail E.Bad; }
        return k;
    }

    function a() {
        defer return;
    }

    function b()! -> E {
        defer fail E.Bad;
        @n = 1;
    }

    function c()! -> E {
        defer {
            let v = risky(1)?;
            @n = v;
        }
        @n = 2;
    }

    function d() {
        for (const i of [1, 2]) {
            defer {
                if (i == 1) {
                    break;
                }
            }
            @n = i;
        }
    }
}
<program>
    <button onclick=a()>a</>
    <button onclick={ b() !{ .Bad :> @n = -1 }; }>b</>
    <button onclick={ c() !{ .Bad :> @n = -1 }; }>c</>
    <button onclick=d()>d</>
    <p>${@n}</p>
</program>
