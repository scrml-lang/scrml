// §7.6 rule (b) (S482) — a file-scope initializer that acts, written inside a `<match>` arm (in an element of the arm), is a value position that writes a file-scope `let`: E-VALUE-WRITES-STATE (S482, s482-value-no-write; was E-FILE-SCOPE-INIT-IN-CONSTRUCT).
<program>
${
    let log: string = "";
    function note(s: string) -> int { log = log + s; return 7; }
}
${ type Phase:enum = { Idle, Ready } }
<phase:Phase=.Ready/>
<match for=Phase on=@phase>
  <Idle><div><p>${ const a: int = note("a"); }idle</p></div></>
  <Ready><p>ready</p></>
</match>
<p id="r">${log}</p>
</program>
