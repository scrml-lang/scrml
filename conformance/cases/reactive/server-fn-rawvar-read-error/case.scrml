<program db="./app.db">
${
    <price> = 10
    function saveOrder() -> number {
        const p = @price;
        const row = ?{`INSERT INTO orders (amount) VALUES (${p}) RETURNING id`}.get() !{ _ :> { return 0; } };
        return 1;
    }
}
<button id="save" onclick={ @price = saveOrder() !{ .Transport(_) :> return }; }>Save</>
<p id="p">Price: ${@price}</>
</program>
