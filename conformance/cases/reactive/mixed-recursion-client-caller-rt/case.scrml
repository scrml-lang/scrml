// §31.2 + §12.2 Trigger 5 — mutual recursion between a plain `step` and a db-touching `down` where `step` ALSO has a client caller (the pending cell's initializer): `step` stays client-placed, its call of `down` is a client call (handled, §19.9.10), and `down`'s call of `step` runs `step` in place on the server, where its call of `down` is server→server.
<program db="./app.db">
    type User:struct = { id: int, name: string }
    function step(n: int) -> int {
        if (n <= 0) { return 0; }
        const d = down(n - 1) !{ _ :> 0 };
        return 1 + d;
    }
    function down(n: int) -> int {
        const u: User = ?{`SELECT id, name FROM users WHERE id = 1`}.get() !{ _ :> { return 0; } };
        if (n <= 0) { return u.id; }
        return step(n - 1);
    }
    <v:(not to int)=(step(5))/>
    <main>
        <p id="v" if=@v>${@v}</p>
        <p id="wait" else>loading</p>
    </main>
</program>
