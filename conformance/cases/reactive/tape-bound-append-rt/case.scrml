// §66.12.2 — a bounded length `1..=3` lets the tape grow within the bound (O36 RULED S477).
<program>
    <xs:int[1..=3, append]=([1, 2])/>
    let <n:int=2/>
    function grow() {
        @xs.append(3);
        @n = @xs.length;
    }
    <main>
        <button id="go" onclick=grow()>go</button>
        <p id="n">${@n}</p>
    </main>
</program>
