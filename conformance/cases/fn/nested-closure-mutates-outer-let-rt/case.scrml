${
    <trace> = ""

    function f(n: int) -> int {
        let pos = 0;
        function advance() {
            pos = pos + 1;
        }
        advance();
        advance();
        return pos + n;
    }

    function go() {
        @trace = `${f(1)};${f(10)};`;
    }
}
<program>
    <button id="go" onclick=go()>Go</>
    <p id="out">${@trace}</p>
</program>
