// ---------------------------------------------------------------------------
// scrml:math — pure scalar / numeric vocabulary (SPEC §41.18)
//
// Every member is PURE: deterministic, no side effects, no capability — so
// every member is a `fn`, callable inside a pure `fn` body. The host
// `Math.*` / `Number.*` reach lives in ONE thin host file beside this module,
// ./host.js, reached through `import:host` (§21.3.1; S471 option A). A host
// binding is used only as the whole body of a fully typed wrapper — `return
// h(params);` — whose signature IS the host function's type; the value the
// host returns is decoded against it there (the S472 wrapper rule; a wrong
// value is the trap E-HOST-VALUE-MISMATCH-RT). The wrappers of host functions
// that are not part of the API (`roundHalfEven`, `roundHalfUp`) are private:
// importing one is E-IMPORT-004.
//
// The API is S469's (§41.18): number → int conversions are named and lossy by
// name (`floor` / `ceil` / `trunc`, and `round` with a REQUIRED `Rounding`
// mode — `round(x)` alone is E-CALL-ARITY); NaN, ±∞ or a result outside
// ±(2^53−1) is the trap E-INT-CONVERSION-RT; parses read the WHOLE string and
// return `T | not`. `min` / `max` take two numbers; `minOf` / `maxOf` take a
// tape and return `not` for an empty one (S472).
//
// NOT here (deliberately): `random()` — non-deterministic, so it lives in the
// capability-scoped `scrml:random` (§41.20).
//
// Usage:
//   ${ import { round, Rounding, floor, minOf, parseInt } from "scrml:math"; }
//   ${ const cents: int = round(dollars * 100.0, .HalfEven); }
// ---------------------------------------------------------------------------
import:host { floor as hostFloor, ceil as hostCeil, trunc as hostTrunc,
              roundHalfEven as hostRoundHalfEven, roundHalfUp as hostRoundHalfUp,
              abs as hostAbs, min as hostMin, max as hostMax, isNaN as hostIsNaN,
              parseInt as hostParseInt } from "./host.js";
${
    // How `round` resolves a value exactly halfway between two integers, and
    // the direction of the three directed modes (§41.18, S440 dpa-054 #4):
    // `.HalfEven` the even neighbour (`2.5` → `2`, `-2.5` → `-2`, `3.5` → `4`);
    // `.HalfUp` AWAY FROM ZERO (`2.5` → `3`, `-2.5` → `-3`); `.Floor` toward
    // −∞, `.Ceil` toward +∞, `.Trunc` toward zero. There is no default mode.
    export type Rounding:enum = { HalfEven, HalfUp, Floor, Ceil, Trunc }

    // number → int, toward −∞: `floor(2.9)` → `2`, `floor(-2.1)` → `-3`.
    export fn floor(x: number) -> int {
        return hostFloor(x);
    }

    // number → int, toward +∞: `ceil(2.1)` → `3`, `ceil(-2.9)` → `-2`.
    export fn ceil(x: number) -> int {
        return hostCeil(x);
    }

    // number → int, toward zero: `trunc(2.9)` → `2`, `trunc(-2.9)` → `-2`.
    export fn trunc(x: number) -> int {
        return hostTrunc(x);
    }

    fn roundHalfEven(x: number) -> int {
        return hostRoundHalfEven(x);
    }

    fn roundHalfUp(x: number) -> int {
        return hostRoundHalfUp(x);
    }

    // number → int by `mode` (REQUIRED): `round(2.5, .HalfEven)` → `2`,
    // `round(2.5, .HalfUp)` → `3`, `round(-2.5, .HalfUp)` → `-3`.
    export fn round(x: number, mode: Rounding) -> int {
        return match mode {
            .HalfEven :> roundHalfEven(x),
            .HalfUp :> roundHalfUp(x),
            .Floor :> floor(x),
            .Ceil :> ceil(x),
            .Trunc :> trunc(x)
        };
    }

    // Absolute value: `abs(-5.0)` → `5`.
    export fn abs(x: number) -> number {
        return hostAbs(x);
    }

    // The smaller of two numbers: `min(3.0, 1.0)` → `1`.
    export fn min(a: number, b: number) -> number {
        return hostMin(a, b);
    }

    // The larger of two numbers: `max(3.0, 1.0)` → `3`.
    export fn max(a: number, b: number) -> number {
        return hostMax(a, b);
    }

    // `value` constrained to the inclusive range [minimum, maximum]:
    // `clamp(-3.0, 0.0, 10.0)` → `0`, `clamp(99.0, 0.0, 10.0)` → `10`.
    export fn clamp(value: number, minimum: number, maximum: number) -> number {
        return min(max(value, minimum), maximum);
    }

    // The smallest element of a tape; `not` for an empty tape (S472).
    export fn minOf(xs: number[]) -> number | not {
        if (xs.length == 0) {
            return not;
        }
        let m: number = xs[0];
        for (const x of xs) {
            m = min(m, x);
        }
        return m;
    }

    // The largest element of a tape; `not` for an empty tape (S472).
    export fn maxOf(xs: number[]) -> number | not {
        if (xs.length == 0) {
            return not;
        }
        let m: number = xs[0];
        for (const x of xs) {
            m = max(m, x);
        }
        return m;
    }

    // The WHOLE of `s` in base `radix` (2–36): an optional leading `-`, then
    // digits of that base in either letter case, and nothing else (no
    // trimming, no `+`, no `0x`); `not` otherwise, or outside ±(2^53−1).
    // `parseInt("ff", 16)` → `255`; `parseInt("10px", 10)` → `not`.
    export fn parseInt(s: string, radix: int) -> int | not {
        return hostParseInt(s, radix);
    }

    // `number.parse(s)` (§14.13.4): the whole string; `not` otherwise.
    export fn parseFloat(s: string) -> number | not {
        return number.parse(s);
    }

    // `number.parse(s)` (§14.13.4): the whole string; `toNumber("")` → `not`.
    export fn toNumber(s: string) -> number | not {
        return number.parse(s);
    }

    // True when `x` is NaN (`Number.isNaN` — no coercion).
    export fn isNaN(x: number) -> bool {
        return hostIsNaN(x);
    }
}
