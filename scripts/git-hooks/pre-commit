#!/bin/bash
# scrml pre-commit hook
# Checks:
#   1. Branch is not main (warning — only PA should commit to main)
#   2. Test suite passes (unit + integration + conformance, excluding browser)

set -e

BRANCH=$(git branch --show-current)
if [ "$BRANCH" = "main" ]; then
  echo "⚠  WARNING: Committing directly to 'main'." >&2
  echo "   Agents must use feature branches. Only the PA merges into main." >&2
  echo "   If you are the PA making an intentional main commit, this is fine." >&2
fi

# S469 (s469-hook-slices) — the native bootstrap's own slice suite (compiler/self-host-v2/slice-m1..m4 +
# slice-codec, incl. slice-m4's acceptance cases, + slice-m1 again on the LOWERED programs, + the no-default-arm
# and duplicate-fn lints): exactly CI's `slices` bootstrap step. It runs HERE only when the staged diff touches something the
# slices read. The list below is the set of tracked files a full slice run OPENS (measured with inotify, S469),
# by prefix, plus the gate's own code:
#   compiler/self-host-v2/   the bootstrap + its tests + compiler/self-host-v2/acceptance
#   compiler/SPEC.md         §34 severity table, §66.19 drift tables, parse/typer tables
#   compiler/src/ compiler/runtime/ compiler/native-parser/   impl#1 COMPILES the bootstrap (harness.js -> api.js)
#   conformance/             the adapter, run.ts / driver / normalize, and the case corpus the gate tests grade
#   docs/known-gaps.md       conformance/run.ts's carried-gap ledger (xfail status)
#   scripts/{scrml-boot,gen-bootstrap-severity,s34-catalog,bootstrap-conformance,hybrid,state}.ts,
#   scripts/lint-no-default-arm.js, scripts/lint-duplicate-fn.js, compiler/tests/integration/security-await-pack/,
#   compiler/tests/helpers/tmp-root-preload.js, bunfig.toml, package.json, bun.lock, scrml.toml
#   stdlib/                  slice-m2/lowered.js STDLIB_ROOT: the bootstrap resolves `scrml:<mod>` imports against the
#                            REAL stdlib (acceptance case imports/stdlib-format-refused). S472: missing from this list
#                            until then (g-hook-slice-trigger-list-misses-stdlib-s472); the literal repo-root reads in
#                            the slice sources are asserted against this list by hook-slice-trigger-list-s472.test.js
#   scripts/test-sharded.ts, scripts/git-hooks/pre-commit   (the runner / this hook: a change to either must
#                            exercise the step it would otherwise skip)
# SCRML_HOOK_SLICES=1 forces the step on (there is deliberately no off switch). See README.md.
RUN_SLICES=0
if [ "${SCRML_HOOK_SLICES:-}" = "1" ]; then
  RUN_SLICES=1
elif [ -d compiler/self-host-v2 ]; then
  while IFS= read -r path; do
    case "$path" in
      compiler/self-host-v2/*|compiler/SPEC.md|compiler/src/*|compiler/runtime/*|compiler/native-parser/*|conformance/*|\
      docs/known-gaps.md|scripts/scrml-boot.ts|scripts/gen-bootstrap-severity.ts|scripts/s34-catalog.ts|\
      scripts/bootstrap-conformance.ts|scripts/hybrid.ts|scripts/state.ts|scripts/lint-no-default-arm.js|scripts/lint-duplicate-fn.js|\
      compiler/tests/integration/security-await-pack/*|compiler/tests/helpers/tmp-root-preload.js|\
      stdlib/*|bunfig.toml|package.json|bun.lock|scrml.toml|scripts/test-sharded.ts|scripts/git-hooks/pre-commit)
        RUN_SLICES=1; SLICE_TRIGGER="$path"; break ;;
    esac
  # --no-renames: a rename lists BOTH paths, so moving a file out of (or into) a watched prefix counts.
  done < <(git diff --cached --name-only --no-renames)
fi
SLICE_DIRS="./compiler/self-host-v2/slice-m1 ./compiler/self-host-v2/slice-m2 ./compiler/self-host-v2/slice-m3 ./compiler/self-host-v2/slice-m4 ./compiler/self-host-v2/slice-codec"
if [ "$RUN_SLICES" = "1" ]; then
  echo "Bootstrap slices: ON (staged: ${SLICE_TRIGGER:-SCRML_HOOK_SLICES=1}) — no-default-arm + duplicate-fn lints..."
  if ! bun scripts/lint-no-default-arm.js 2>&1; then
    echo "✗ no-default-arm lint failed (compiler/self-host-v2). Fix before committing." >&2
    exit 1
  fi
  if ! bun scripts/lint-duplicate-fn.js 2>&1; then
    echo "✗ duplicate-fn lint failed (compiler/self-host-v2): impl#1 binds every call of a duplicated name to the LAST definition. Rename one before committing." >&2
    exit 1
  fi
else
  echo "Bootstrap slices: skipped (the staged diff touches nothing they read)."
fi

echo "Running tests (unit + integration + conformance, excluding browser)..."
# S468 (s468-hook-sharding): the SAME file set, split across parallel `bun test` processes by
# scripts/test-sharded.ts (balanced by measured per-file time; --bail stops every shard on the first
# failure; totals equal the single-process run). ~11-14 min -> ~2-3 min on the 32-core box.
# Every shard is BOUNDED: past its timeout or its RSS ceiling it is killed and the commit FAILS,
# naming the shard and its files — the hook cannot hang or eat the machine. Only the shard's own
# process group is ever signalled.
#   SCRML_HOOK_SHARDS=1   the original single-process command, exactly as before
#   SCRML_HOOK_SHARDS=N   N shards (default min(cores/2, slots*3/4, (MemAvailable - reserve) / budget))
#   SCRML_HOOK_SHARD_TIMEOUT_S (1200) · SCRML_HOOK_SHARD_MEM_MB (3072, the kill ceiling) ·
#   SCRML_HOOK_SHARD_BUDGET_MB (1536, expected per-shard RSS) · SCRML_HOOK_MEM_RESERVE_MB (2048)
# Machine-wide: every shard of every concurrent hook holds a flock'd slot (~/.cache/scrml/hook-slots/,
# min(cores/2, MemTotal*0.8/budget) slots, SCRML_HOOK_SLOTS) and starts only if MemAvailable - reserve >= budget;
# otherwise the shard waits, bounded by SCRML_HOOK_SLOT_WAIT_S (1800), then FAILS. Ten agents committing at once
# cannot oversubscribe the box. S469 (s469-hook-shard-tuning): 32-core box -> 16 slots (was 8), 12 per hook (was 8).
# A branch cut before the runner existed has no scripts/test-sharded.ts and runs single-process.
#   Bootstrap slices (when RUN_SLICES=1, above): the SAME runner, as two more PATH GROUPS (--group): their shards
#   never share a process with compiler/tests files (CI runs them in a job of its own too), and the second group
#   re-runs slice-m1 with SLICE_CORE=lowered. Slots, memory admission, timeouts, --bail and the fail-loud report
#   all apply to them unchanged. Single-process mode runs them as two more `bun test` commands.
if [ "${SCRML_HOOK_SHARDS:-}" = "1" ] || [ ! -f scripts/test-sharded.ts ]; then
  if ! bun test compiler/tests/unit compiler/tests/integration compiler/tests/conformance compiler/tests/*.test.js --bail 2>&1; then
    echo "✗ Tests failed. Fix before committing." >&2
    exit 1
  fi
  # shellcheck disable=SC2086  # SLICE_DIRS is a fixed, space-free word list
  if [ "$RUN_SLICES" = "1" ] && ! { bun test $SLICE_DIRS --bail 2>&1 && SLICE_CORE=lowered bun test ./compiler/self-host-v2/slice-m1 --bail 2>&1; }; then
    echo "✗ Bootstrap slice tests failed. Fix before committing." >&2
    exit 1
  fi
else
  SLICE_ARGS=""
  if [ "$RUN_SLICES" = "1" ]; then
    SLICE_ARGS="--group $SLICE_DIRS --group=SLICE_CORE=lowered ./compiler/self-host-v2/slice-m1"
  fi
  # shellcheck disable=SC2086  # SLICE_ARGS is a fixed, space-free word list
  if ! bun scripts/test-sharded.ts --bail compiler/tests/unit compiler/tests/integration compiler/tests/conformance compiler/tests/*.test.js $SLICE_ARGS 2>&1; then
    echo "✗ Tests failed. Fix before committing. (SCRML_HOOK_SHARDS=1 reruns single-process.)" >&2
    exit 1
  fi
fi

# S462 md phase 1 — compiler/runtime/stdlib/md.js is GENERATED from stdlib/md/index.scrml
# (SPEC §67.8: one md reader). Byte-for-byte: a reader edit, or a codegen change that alters the
# compiled reader, must be followed by `bun scripts/gen-md-shim.ts`. (~2s)
# Guarded: a branch cut before the reader landed has no generator and must not be blocked.
if [ -f scripts/gen-md-shim.ts ] && ! bun scripts/gen-md-shim.ts --check 2>&1; then
  echo "✗ compiler/runtime/stdlib/md.js is stale — run: bun scripts/gen-md-shim.ts" >&2
  exit 1
fi

# S473 — the bootstrap SPEC-coverage gate (CI `checks` runs it on every push). Here it runs only when the
# staged diff touches what it reads: a new SPEC section (via SPEC.md / SPEC-INDEX.md) needs a row in
# docs/bootstrap-spec-coverage.md, and a gap renamed or deleted in known-gaps.md must not orphan a row.
# ~0.1s. Guarded: a branch cut before the gate landed has no script and must not be blocked.
# S474 (owner ruling: generated blocks regenerate post-merge — .github/workflows/generated-regen.yml):
# exit 4 = NO violation, only the @generated:coverage-totals block is stale → a warning, never a block (do not
# commit a regen; main is regenerated after merge). Any other non-zero still blocks: a § with no row, a SILENT
# row with no gap, a cited gap that does not exist, a bad status/token, missing anchors (1), unreadable inputs (2).
# VERSION SKEW: this hook runs from the main checkout against the worktree's script; a branch cut before S474
# still exits 1 for stale totals and is still blocked by them (fail-closed; merging main cures it).
# (The block between the BEGIN/END markers is run verbatim by generated-stale-exit-codes-s474.test.js.)
if [ -f scripts/spec-coverage-check.ts ] && git diff --cached --name-only --no-renames | grep -qE '^(compiler/SPEC\.md|compiler/SPEC-INDEX\.md|docs/bootstrap-spec-coverage\.md|docs/known-gaps\.md|scripts/spec-coverage-check\.ts)$'; then
  # BEGIN spec-coverage
  COV_RC=0
  bun scripts/spec-coverage-check.ts 2>&1 || COV_RC=$?   # `|| …` — this hook runs under set -e
  if [ "$COV_RC" = "4" ]; then
    echo "⚠ SPEC-coverage totals block is stale (non-blocking — regenerated on main after merge; do not commit a regen)." >&2
  elif [ "$COV_RC" != "0" ]; then
    echo "✗ SPEC-coverage gate failed (docs/bootstrap-spec-coverage.md, rc $COV_RC). Add the missing row / gap id named above." >&2
    exit 1
  fi
  # END spec-coverage
fi

echo "✓ Pre-commit checks passed."
exit 0
