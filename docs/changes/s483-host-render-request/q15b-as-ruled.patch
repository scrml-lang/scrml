+describe("s483 Q15 (b) — a render expression or derived formula reaching unproven host code is E-VALUE-WRITE-UNPROVEN", () => {
+  test("probe F9: an interpolation through a wrapper is refused, naming the position, the chain and the fix", () => {
+    refused("E-VALUE-WRITE-UNPROVEN", P(`<p id="o">\${ck() + @n}</p>`),
+      "the interpolation: it calls `clickB()`, a `<host>`-backed function (§21.3.1), through `ck() → clickB()`",
+      "a value position fails closed (§6.15)",
+      "Call the host function from an event handler and keep its result in a cell, or compute the value in scrml");
+  });
+
+  test("a direct call, and a wrapper at depth two", () => {
+    refused("E-VALUE-WRITE-UNPROVEN", P(`<p id="o">\${clickB() + @n}</p>`), "the interpolation: it calls `clickB()`, a `<host>`-backed function (§21.3.1) —");
+    refused("E-VALUE-WRITE-UNPROVEN", P(`<p id="o">\${ck2() + @n}</p>`, "function ck2() -> int { return ck(); }"), "through `ck2() → ck() → clickB()`");
+  });
+
+  test("an attribute expression (`title=`, `if=`) is refused", () => {
+    refused("E-VALUE-WRITE-UNPROVEN", P(`<p id="o" title=\${ck() + @n}>t</p>`), "the `title=` value on `<p>`: it calls `clickB()`");
+    refused("E-VALUE-WRITE-UNPROVEN", P(`<p id="o" if=(ck() == @n)>t</p>`), "the `if=` condition on `<p>`: it calls `clickB()`");
+  });
+
+  test("a derived formula is refused at its declaration, once — its readers are not reported again", () => {
+    refused("E-VALUE-WRITE-UNPROVEN", P(`<d:int=(ck() + @n)/>\n<p id="o" title=\${@d}>\${@d}</p>`),
+      "the formula of derived `@d`: it calls `clickB()`", "is recomputed without end");
+  });
+
+  test("not judged (the ruling covers interpolations / attributes and derived formulas): a `let` seed, a locked value reading no cell, a handler", () => {
