<program>
    type Phase:enum = { Idle, Loading, Done }
    <phase:Phase=.Idle single>
        <Idle rule=.Loading : "i">
        <Loading rule=.Done : "l">
        <Done rule=.Idle : "d">
    </>
    function go() { @phase = .Loading; @phase = .Idle; }
    <main><p><*phase/></p><button onclick=go()>g</button></main>
</program>
