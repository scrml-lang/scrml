<program>
    type Phase:enum = { Idle, Loading, Done }
    <phase:Phase=.Idle single>
        <Idle rule=.Loading>
            <onTransition to=.Loading>${ log("x"); }</onTransition>
            "i"
        </>
        <Loading rule=.Done : "l">
        <Done rule=.Idle : "d">
    </>
    <main><p><*phase/></p></main>
</program>
