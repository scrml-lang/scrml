<program>
    type E:enum = { Bad(why: string), Worse }
    type F:enum = { Other }
    function f(n: int)! E { if (n < 0) { fail .Bad("neg"); } return n; }
    function g(n: int)! F { const v = f(n)?; return v; }
    function h(n: int)! string { fail .X; }
    function p(n: int) -> int { const v = f(n) !{ | .Bad w :> 0, | .Worse :> 1, }; return v; }
    pure function q(n: int)! E { return n; }
    <main><p>${p(1)}</p></main>
</program>
