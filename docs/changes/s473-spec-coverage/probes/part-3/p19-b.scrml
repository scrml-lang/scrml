<program>
    type E:enum = { Bad(why: string), Worse }
    function f(n: int)! E { if (n < 0) { fail .Bad("neg"); } if (n == 0) { fail .Nope; } if (n == 1) { fail .Bad; } return n; }
    function k(n: int)! E { const v = f(n)?; return v; }
    function m(n: int) -> int { const v = f(n) !{ .Bad(w) :> 0, }; return v; }
    function m2(n: int) -> int { const v = f(n) !{ .Bad(w) :> { @x = 1; }, _ :> 1, }; return v; }
    function m3(n: int) -> int { const v = match f(n) { .Ok(x) :> x, .Bad(w) :> 0, .Worse :> 1, }; return v; }
    function m4(n: int)! { fail .Generic("x"); }
    function m5(n: int) -> int { const v = f(n) !{ _ e :> 0, }; return v; }
    let <x:int=0/>
    <main><p>${m3(1)}</p></main>
</program>
