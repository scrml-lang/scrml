<program>
    type Note:struct = { id: int, body: string }
    function cnt() -> int {
        ?{`DELETE FROM notes`}.run() !{ _ :> { return 0; } };
        return 1;
    }
    function go() { const r: int = cnt() !{ .Transport(t) :> return }; }
    <main><button onclick=go()>a</button></main>
</program>
