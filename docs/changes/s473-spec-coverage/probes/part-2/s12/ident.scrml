<program>
    <db src="./app.db">
        type Row:struct = { id: int }
    </db>
    let <c:int=0/>
    function srv(uid: string) -> int { const r = ?{`SELECT 1 AS id`}.all() !{ _ :> [] }; return 1; }
    function go() { @c = srv(@session.userId) !{ _ :> 0 }; }
    <main><button onclick=go()>${@c}</button></main>
</program>
