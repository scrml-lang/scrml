<program>
    let <email:string="" req length(>=5)/>
    let <calls:int=0/>
    function register() { @calls = @calls + 1; }
    <main>
        <form id="f" onsubmit=register()>
            <input id="email" type="email" bind:value=@email/>
            <errors of=@email/>
            <errors of=@email all/>
            <button id="go" type="submit">Go</button>
            <button id="b2" type="submit" formnovalidate>Draft</button>
        </form>
        <p>${@email.isValid}|${@email.touched}|${@email.submitted}</p>
        <button onclick={ reset(@email); }>r</button>
    </main>
</program>
