// g-bootstrap-gate-reach-live-dom-reading P12: a bind through an `as=` handle inside the form, in a closed `if=` region.
<program>
    let <show:bool=false/>
    let <calls:int=0/>
    <f:struct>
        let <v:string="" req/>
    </>
    renders <span>${v}</span>
    function register() { @calls = @calls + 1; }
    <main>
        <f as=h/>
        <form id="fm" onsubmit=register()>
            <div if=@show><input bind:value=@h.v/></div>
            <button type="submit">go</button>
        </form>
        <p id="calls">${@calls}</p>
    </main>
</program>
