// g-bootstrap-loop-codes-owed-s469: `for (… ; …)` and `for ()` heads.
<program>
    function f() -> int {
        let s = 0;
        for (s < 3; s = s + 1) { s = s + 1; }
        return s;
    }
    function g() -> int {
        for () { return 1; }
        return 0;
    }
    <main>
        <p id="o">${f()}</p>
    </main>
</program>
